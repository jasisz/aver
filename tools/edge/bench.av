module Bench
    intent = "Local timing harness for Fractal.render — predicts whether the live /fractal endpoint will fit under Cloudflare Workers' free-plan 10 ms CPU budget. Not deployed."
    depends [Fractal]
    exposes [main]
    effects [Console.print, Time.unixMs]

fn main() -> Unit
    ! [Console.print, Time.unixMs]
    t0 = Time.unixMs()
    full = Fractal.render(60, 14, 60, Fractal.fullView())
    t1 = Time.unixMs()
    zoom = Fractal.render(60, 14, 80, Fractal.seahorseView())
    t2 = Time.unixMs()
    Console.print("full(60, 14, 60):     {Int.toString(t1 - t0)} ms, {Int.toString(String.len(full))} chars")
    Console.print("seahorse(60, 14, 80):  {Int.toString(t2 - t1)} ms, {Int.toString(String.len(zoom))} chars")
    Console.print("total:                 {Int.toString(t2 - t0)} ms")
