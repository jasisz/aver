module Looper
    intent = "A library helper exposes its source call shape for yielding importers and its generated protocol for explicit drivers."
    depends [Pool, Pooled]
    effects [Pool.claim, yield]
    exposes [loop]

fn loop(id: Int, seen: Int) -> Int
    ? "Claims the handle of id, adds it to seen, and loops until id runs down to zero."
    ! [Pool.claim, yield]
    handle = Pool.claim(id)
    match id
        0 -> seen + handle
        _ -> loop(id - 1, seen + handle)
