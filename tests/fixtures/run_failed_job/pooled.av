module Pooled
    intent = "Fixture answer module: each score is a Validation job this module begins itself. This one cancels the job the moment it begins, so the take after the wait reports it answers why it never will, and the module records that rejection and answers the request rather than failing the turn."
    depends [Pool, Validation, Wait, Work]
    exposes [State, fresh, scored, score]
    effects [Validation.begin, Validation.take, Work.cancel]
    answers [Pool]

record State
    jobs: Map<Int, Work.Job>
    rejected: List<String>

fn fresh() -> State
    ? "No job running and nothing rejected."
    State(jobs = {}, rejected = [])

fn scored(state: State, task: Int) -> Tuple<State, Result<Result<Int, String>, Run.Wake>>
    ? "The first ask begins the job, cancels it and waits on it; an ask after the wait reported it takes it."
    ! [Validation.begin, Validation.take, Work.cancel]
    match Map.get(state.jobs, task)
        Option.Some(job) -> taken(state, task, job)
        Option.None -> begun(state, task)

fn begun(state: State, task: Int) -> Tuple<State, Result<Result<Int, String>, Run.Wake>>
    ? "Begins the job and cancels it before anything takes it: a cancelled job has no result to give and never will."
    ! [Validation.begin, Work.cancel]
    match Validation.begin(task)
        Result.Err(reason) -> (state, Result.Ok(Result.Err(reason)))
        Result.Ok(job) -> cancelled(State.update(state, jobs = Map.set(state.jobs, task, job)), job)

fn cancelled(state: State, job: Work.Job) -> Tuple<State, Result<Result<Int, String>, Run.Wake>>
    ? "The job is cancelled, and the request waits on it all the same: a cancelled job is ready for the wait."
    ! [Work.cancel]
    _stopped = Work.cancel(job)
    (state, Result.Err(Run.Wake.Until([Wait.Item.Job(job)], Option.None)))

fn taken(state: State, task: Int, job: Work.Job) -> Tuple<State, Result<Result<Int, String>, Run.Wake>>
    ? "One take: nothing yet waits on the job again, a score answers, and a job that will never finish is recorded as a rejection and answered with its reason."
    ! [Validation.take]
    match Validation.take(job)
        Result.Err(reason) -> (rejectedFor(state, task, reason), Result.Ok(Result.Err(reason)))
        Result.Ok(found) -> match found
            Option.None -> (state, Result.Err(Run.Wake.Until([Wait.Item.Job(job)], Option.None)))
            Option.Some(points) -> (State.update(state, jobs = Map.remove(state.jobs, task)), Result.Ok(Result.Ok(points)))

fn rejectedFor(state: State, task: Int, reason: String) -> State
    ? "A job that will never finish: its handle goes and its reason is recorded."
    State.update(state, jobs = Map.remove(state.jobs, task), rejected = List.concat(state.rejected, [reason]))

verify rejectedFor law aFailedTakeIsRecorded
    given state: State = [fresh(), State.update(fresh(), rejected = ["earlier"])]
    given task: Int = [1, 2]
    given reason: String = ["work: job cancelled"]
    List.len(rejectedFor(state, task, reason).rejected) => List.len(state.rejected) + 1

fn score(task: Int) -> Int
    ? "What one job computes off the turn."
    task + 1

verify score
    score(1) => 2
