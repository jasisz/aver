module MapKeys
    intent =
        "Builds a map in place and reads it in iteration order, for a caller in another module."
    effects []

fn builtValues(v: Int) -> List<Int>
    ? "Values of a two-key map built in place, in iteration order."
    m = Map.set(Map.set({}, "b", v), "a", 3)
    Map.values(m)
