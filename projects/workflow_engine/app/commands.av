fn planRemoveTag(taskId: String, tag: String) -> Result<CommandPlan, String>
    ? "Decides a tag-remove event and derives follow-up rule effects."
    ! [Disk.readText, Time.now]
    context = loadActiveTaskContext(taskId)?
    now = Infra.Clock.now()
    primaryEvent = Domain.Tasks.removeTag(context.task, context.nextSeq, tag, now)?
    planTaskCommand("Removed tag '{tag}' from task '{taskId}'", context.project, context.persistedEvents, primaryEvent, now)

fn planAddComment(taskId: String, author: String, body: String) -> Result<CommandPlan, String>
    ? "Canonical showcase flow: decide a comment event, replay post-state, then derive review follow-ups."
    ! [Disk.readText, Time.now]
    context = loadActiveTaskContext(taskId)?
    now = Infra.Clock.now()
    primaryEvent = Domain.Tasks.addComment(context.task, context.nextSeq, author, body, now)?
    planTaskCommand("Added comment to task '{taskId}'", context.project, context.persistedEvents, primaryEvent, now)

fn planSetDeadline(taskId: String, deadline: String) -> Result<CommandPlan, String>
    ? "Decides a deadline change event and derives follow-up rule effects."
    ! [Disk.readText, Time.now]
    context = loadActiveTaskContext(taskId)?
    now = Infra.Clock.now()
    primaryEvent = Domain.Tasks.setDeadline(context.task, context.nextSeq, deadline, now)?
    planTaskCommand("Set deadline for task '{taskId}'", context.project, context.persistedEvents, primaryEvent, now)

fn planClearDeadline(taskId: String) -> Result<CommandPlan, String>
    ? "Decides a deadline clear event and derives follow-up rule effects."
    ! [Disk.readText, Time.now]
    context = loadActiveTaskContext(taskId)?
    now = Infra.Clock.now()
    primaryEvent = Domain.Tasks.clearDeadline(context.task, context.nextSeq, now)?
    planTaskCommand("Cleared deadline for task '{taskId}'", context.project, context.persistedEvents, primaryEvent, now)

fn planArchiveTask(taskId: String) -> Result<CommandPlan, String>
    ? "Decides an archive event and derives follow-up rule effects."
    ! [Disk.readText, Time.now]
    context = loadActiveTaskContext(taskId)?
    now = Infra.Clock.now()
    primaryEvent = Domain.Tasks.archiveTask(context.task, context.nextSeq, now)?
    planTaskCommand("Archived task '{taskId}'", context.project, context.persistedEvents, primaryEvent, now)

fn planRunRules(scope: Option<String>) -> Result<CommandPlan, String>
    ? "Decides explicit rule execution either for one task or all current tasks."
    ! [Disk.readText, Time.now]
    match scope
        Option.Some(taskId) -> planRulesForTask(taskId)
        Option.None -> planRulesForAll()

fn planRulesForTask(taskId: String) -> Result<CommandPlan, String>
    ? "Builds a rule-only event plan for one task."
    ! [Disk.readText, Time.now]
    context = loadTaskContext(taskId)?
    now = Infra.Clock.now()
    ruleResult = Domain.Rules.runRules(context.project, context.task, context.latestPersistedEvent, now, context.nextSeq)?
    Result.Ok(CommandPlan.AppendEvents(ruleOnlyPlan("Ran rules for task '{taskId}'", taskId, ruleResult)))

fn planRulesForAll() -> Result<CommandPlan, String>
    ? "Builds one combined rule-only plan for all replayed tasks."
    ! [Disk.readText, Time.now]
    projects = Infra.Store.loadProjects()?
    events = Infra.Store.loadTaskEvents()?
    states = Domain.Events.replayAllStates(events)?
    now = Infra.Clock.now()
    plan = deriveRulesForAllPlan(states, projects, now, emptyEventPlan("Ran rules for all tasks", "all"))?
    Result.Ok(CommandPlan.AppendEvents(plan))

fn planTaskCommand(summary: String, project: Project, persistedEvents: List<TaskEventRecord>, primaryEvent: TaskEventRecord, now: String) -> Result<CommandPlan, String>
    ? "Packages one primary user event plus one explicit rule pass into the append-events plan."
    ruleResult = deriveRuleEffectsAfterPrimaryEvent(project, persistedEvents, primaryEvent, now)?
    Result.Ok(CommandPlan.AppendEvents(primaryEventPlan(summary, primaryEvent, ruleResult)))

verify planTaskCommand
    planTaskCommand(
        "Added comment to task 't1'",
        sampleProject(),
        [
            TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 1, event = Domain.Types.TaskEvent.TaskCreated("Plan release", Domain.Types.Priority.Normal, ["waiting"], Option.None, "2026-03-08T12:00:00Z")),
            TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 2, event = Domain.Types.TaskEvent.TaskStarted("2026-03-08T13:00:00Z"))
        ],
        TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 3, event = Domain.Types.TaskEvent.CommentAdded(Comment(id = "t1-c3", body = "Ping", author = "alice", createdAt = "2026-03-09T12:00:00Z"))),
        "2026-03-09T12:00:00Z"
    ) => Result.Ok(CommandPlan.AppendEvents(
        EventPlan(
            summary = "Added comment to task 't1'",
            subjectId = "t1",
            events = [
                TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 3, event = Domain.Types.TaskEvent.CommentAdded(Comment(id = "t1-c3", body = "Ping", author = "alice", createdAt = "2026-03-09T12:00:00Z"))),
                TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 4, event = Domain.Types.TaskEvent.TagAdded("needs_review", "2026-03-09T12:00:00Z"))
            ],
            notifications = [
                Notification(key = "needs-review:t1:3", taskId = "t1", kind = "needs_review", message = "Task 't1' moved from waiting to needs_review after a new comment", createdAt = "2026-03-09T12:00:00Z")
            ],
            audits = [
                AuditEntry(key = "task:t1:3:CommentAdded", taskId = "t1", action = "task.comment_added", message = "Task 't1' received a comment from alice", createdAt = "2026-03-09T12:00:00Z")
            ]
        )
    ))

fn deriveRuleEffectsAfterPrimaryEvent(project: Project, persistedEvents: List<TaskEventRecord>, primaryEvent: TaskEventRecord, now: String) -> Result<RuleResult, String>
    ? "Replays post-primary state before one rule pass so follow-ups stay explainable."
    postCommandEvents = List.concat(persistedEvents, [primaryEvent])
    postCommandTask = Domain.Events.replayTask(postCommandEvents)?
    Domain.Rules.runRules(project, postCommandTask, Option.Some(primaryEvent), now, Domain.Tasks.nextSeq(postCommandEvents))

verify deriveRuleEffectsAfterPrimaryEvent
    deriveRuleEffectsAfterPrimaryEvent(
        sampleProject(),
        [
            TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 1, event = Domain.Types.TaskEvent.TaskCreated("Plan release", Domain.Types.Priority.Normal, ["waiting"], Option.None, "2026-03-08T12:00:00Z")),
            TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 2, event = Domain.Types.TaskEvent.TaskStarted("2026-03-08T13:00:00Z"))
        ],
        TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 3, event = Domain.Types.TaskEvent.CommentAdded(Comment(id = "t1-c3", body = "Ping", author = "alice", createdAt = "2026-03-09T12:00:00Z"))),
        "2026-03-09T12:00:00Z"
    ) => Result.Ok(
        RuleResult(
            taskId = "t1",
            events = [
                TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 4, event = Domain.Types.TaskEvent.TagAdded("needs_review", "2026-03-09T12:00:00Z"))
            ],
            notifications = [
                Notification(key = "needs-review:t1:3", taskId = "t1", kind = "needs_review", message = "Task 't1' moved from waiting to needs_review after a new comment", createdAt = "2026-03-09T12:00:00Z")
            ],
            audits = [],
            notes = ["added needs_review tag to task 't1'"]
        )
    )

fn primaryEventPlan(summary: String, primaryEvent: TaskEventRecord, ruleResult: RuleResult) -> EventPlan
    ? "Builds the write plan while keeping the primary event visibly separate from derived events."
    EventPlan(summary = summary, subjectId = primaryEvent.taskId, events = List.prepend(primaryEvent, ruleResult.events), notifications = ruleResult.notifications, audits = List.prepend(taskAuditForEvent(primaryEvent), ruleResult.audits))

verify primaryEventPlan
    primaryEventPlan(
        "Added comment to task 't1'",
        TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 3, event = Domain.Types.TaskEvent.CommentAdded(Comment(id = "t1-c3", body = "Ping", author = "alice", createdAt = "2026-03-09T12:00:00Z"))),
        RuleResult(taskId = "t1", events = [TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 4, event = Domain.Types.TaskEvent.TagAdded("needs_review", "2026-03-09T12:00:00Z"))], notifications = [Notification(key = "needs-review:t1:3", taskId = "t1", kind = "needs_review", message = "Task 't1' moved from waiting to needs_review after a new comment", createdAt = "2026-03-09T12:00:00Z")], audits = [], notes = ["added needs_review tag to task 't1'"])
    ) => EventPlan(
        summary = "Added comment to task 't1'",
        subjectId = "t1",
        events = [
            TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 3, event = Domain.Types.TaskEvent.CommentAdded(Comment(id = "t1-c3", body = "Ping", author = "alice", createdAt = "2026-03-09T12:00:00Z"))),
            TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 4, event = Domain.Types.TaskEvent.TagAdded("needs_review", "2026-03-09T12:00:00Z"))
        ],
        notifications = [
            Notification(key = "needs-review:t1:3", taskId = "t1", kind = "needs_review", message = "Task 't1' moved from waiting to needs_review after a new comment", createdAt = "2026-03-09T12:00:00Z")
        ],
        audits = [
            AuditEntry(key = "task:t1:3:CommentAdded", taskId = "t1", action = "task.comment_added", message = "Task 't1' received a comment from alice", createdAt = "2026-03-09T12:00:00Z")
        ]
    )

fn deriveRulesForAllPlan(states: List<TaskReplayState>, projects: List<Project>, now: String, acc: EventPlan) -> Result<EventPlan, String>
    ? "Pure fold that turns manual `run_rules` over all tasks into one combined event plan."
    match states
        [] -> Result.Ok(acc)
        [state, ..rest] -> deriveRulesForAllStep(state, rest, projects, now, acc)

verify deriveRulesForAllPlan
    deriveRulesForAllPlan(
        [TaskReplayState(task = Task(id = "t1", projectId = "alpha", title = "Plan release", status = Domain.Types.TaskStatus.Blocked, priority = Domain.Types.Priority.Normal, tags = [], deadline = Option.None, comments = [], createdAt = "2026-03-01T12:00:00Z", updatedAt = "2026-03-01T12:00:00Z", statusChangedAt = "2026-03-01T12:00:00Z"), latestEvent = TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 2, event = Domain.Types.TaskEvent.TaskBlocked("Waiting on vendor", "2026-03-01T12:00:00Z")), nextSeq = 3)],
        [sampleProject()],
        "2026-03-05T12:00:00Z",
        emptyEventPlan("Ran rules for all tasks", "all")
    ) => Result.Ok(
        EventPlan(
            summary = "Ran rules for all tasks",
            subjectId = "all",
            events = [
                TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 3, event = Domain.Types.TaskEvent.TagAdded("stalled", "2026-03-05T12:00:00Z"))
            ],
            notifications = [
                Notification(key = "stalled:t1:2026-03-01T12:00:00Z", taskId = "t1", kind = "stalled", message = "Task 't1' has been blocked for more than 3 days", createdAt = "2026-03-05T12:00:00Z")
            ],
            audits = []
        )
    )

fn deriveRulesForAllStep(state: TaskReplayState, rest: List<TaskReplayState>, projects: List<Project>, now: String, acc: EventPlan) -> Result<EventPlan, String>
    ? "Evaluates one task's rules and merges the result into the accumulated plan."
    project = requireProject(projects, state.task.projectId)?
    ruleResult = Domain.Rules.runRules(project, state.task, Option.Some(state.latestEvent), now, state.nextSeq)?
    combined = mergeEventPlans(acc, ruleOnlyPlan("Ran rules for task '{state.task.id}'", state.task.id, ruleResult))
    deriveRulesForAllPlan(rest, projects, now, combined)

verify deriveRulesForAllStep
    deriveRulesForAllStep(
        TaskReplayState(task = Task(id = "t1", projectId = "alpha", title = "Plan release", status = Domain.Types.TaskStatus.Blocked, priority = Domain.Types.Priority.Normal, tags = [], deadline = Option.None, comments = [], createdAt = "2026-03-01T12:00:00Z", updatedAt = "2026-03-01T12:00:00Z", statusChangedAt = "2026-03-01T12:00:00Z"), latestEvent = TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 2, event = Domain.Types.TaskEvent.TaskBlocked("Waiting on vendor", "2026-03-01T12:00:00Z")), nextSeq = 3),
        [],
        [sampleProject()],
        "2026-03-05T12:00:00Z",
        emptyEventPlan("Ran rules for all tasks", "all")
    ) => Result.Ok(
        EventPlan(
            summary = "Ran rules for all tasks",
            subjectId = "all",
            events = [
                TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 3, event = Domain.Types.TaskEvent.TagAdded("stalled", "2026-03-05T12:00:00Z"))
            ],
            notifications = [
                Notification(key = "stalled:t1:2026-03-01T12:00:00Z", taskId = "t1", kind = "stalled", message = "Task 't1' has been blocked for more than 3 days", createdAt = "2026-03-05T12:00:00Z")
            ],
            audits = []
        )
    )

fn emptyEventPlan(summary: String, subjectId: String) -> EventPlan
    ? "Neutral accumulator for combined event plans."
    EventPlan(summary = summary, subjectId = subjectId, events = [], notifications = [], audits = [])

verify emptyEventPlan
    emptyEventPlan("all", "all") => EventPlan(summary = "all", subjectId = "all", events = [], notifications = [], audits = [])

fn ruleOnlyPlan(summary: String, subjectId: String, ruleResult: RuleResult) -> EventPlan
    ? "Turns pure rule output into the same write-plan shape as user mutations, but without a primary event."
    EventPlan(summary = summary, subjectId = subjectId, events = ruleResult.events, notifications = ruleResult.notifications, audits = ruleResult.audits)

verify ruleOnlyPlan
    ruleOnlyPlan("Ran rules for task 't1'", "t1", RuleResult(taskId = "t1", events = [], notifications = [Notification(key = "n1", taskId = "t1", kind = "deadline_soon", message = "x", createdAt = "2026-03-08T12:00:00Z")], audits = [], notes = ["x"])) => EventPlan(summary = "Ran rules for task 't1'", subjectId = "t1", events = [], notifications = [Notification(key = "n1", taskId = "t1", kind = "deadline_soon", message = "x", createdAt = "2026-03-08T12:00:00Z")], audits = [])

fn mergeEventPlans(left: EventPlan, right: EventPlan) -> EventPlan
    ? "Combines task-local plans while keeping the outer summary and subject."
    EventPlan(summary = left.summary, subjectId = left.subjectId, events = List.concat(left.events, right.events), notifications = List.concat(left.notifications, right.notifications), audits = List.concat(left.audits, right.audits))

verify mergeEventPlans
    mergeEventPlans(
        EventPlan(summary = "all", subjectId = "all", events = [TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 1, event = Domain.Types.TaskEvent.TaskStarted("2026-03-08T12:00:00Z"))], notifications = [], audits = []),
        EventPlan(summary = "one", subjectId = "t2", events = [TaskEventRecord(taskId = "t2", projectId = "alpha", seq = 1, event = Domain.Types.TaskEvent.TaskStarted("2026-03-08T13:00:00Z"))], notifications = [], audits = [])
    ) => EventPlan(summary = "all", subjectId = "all", events = [TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 1, event = Domain.Types.TaskEvent.TaskStarted("2026-03-08T12:00:00Z")), TaskEventRecord(taskId = "t2", projectId = "alpha", seq = 1, event = Domain.Types.TaskEvent.TaskStarted("2026-03-08T13:00:00Z"))], notifications = [], audits = [])

fn commitProjectPlan(plan: ProjectPlan) -> Result<CommandReport, String>
    ? "Persists project state and project-scoped audits."
    ! [Disk.appendText, Disk.readText, Disk.writeText]
    _saved = Infra.Store.saveProjects(plan.projects)?
    _audited = Infra.Audit.recordEntries(plan.audits)?
    Result.Ok(report(plan.summary, plan.subjectId, [], [], plan.audits))

fn commitEventPlan(plan: EventPlan) -> Result<CommandReport, String>
    ? "Persists event log writes and audits, leaving notifications for dispatch."
    ! [Disk.appendText, Disk.readText]
    _saved = Infra.Store.appendTaskEvents(plan.events)?
    _audited = Infra.Audit.recordEntries(plan.audits)?
    Result.Ok(report(plan.summary, plan.subjectId, plan.events, plan.notifications, plan.audits))

fn loadTaskContext(taskId: String) -> Result<TaskContext, String>
    ? "Loads replay context for one task without applying project-active policy."
    ! [Disk.readText]
    projects = Infra.Store.loadProjects()?
    events = Infra.Store.loadTaskEvents()?
    taskEvents = Domain.Events.eventsForTask(events, taskId)
    task = Domain.Events.replayTask(taskEvents)?
    project = requireProject(projects, task.projectId)?
    Result.Ok(TaskContext(project = project, task = task, persistedEvents = taskEvents, latestPersistedEvent = Domain.Events.latestEvent(taskEvents), nextSeq = Domain.Tasks.nextSeq(taskEvents)))

fn loadActiveTaskContext(taskId: String) -> Result<TaskContext, String>
    ? "Loads replay context and enforces that mutations only target active projects."
    ! [Disk.readText]
    context = loadTaskContext(taskId)?
    _active = Domain.Validation.ensureProjectActive(context.project)?
    Result.Ok(context)

fn requireProject(projects: List<Project>, projectId: String) -> Result<Project, String>
    ? "Finds one project or returns a reviewer-friendly error."
    match Domain.Projects.findProject(projects, projectId)
        Option.Some(project) -> Result.Ok(project)
        Option.None -> Result.Err("Project '{projectId}' was not found")

verify requireProject
    requireProject([Project(id = "alpha", name = "Alpha", archived = false, createdAt = "2026-03-08T12:00:00Z", updatedAt = "2026-03-08T12:00:00Z")], "alpha") => Result.Ok(Project(id = "alpha", name = "Alpha", archived = false, createdAt = "2026-03-08T12:00:00Z", updatedAt = "2026-03-08T12:00:00Z"))
    requireProject([], "alpha") => Result.Err("Project 'alpha' was not found")

fn ensureProjectMissing(projects: List<Project>, projectId: String) -> Result<Bool, String>
    ? "Rejects duplicate project creation."
    match Domain.Projects.findProject(projects, projectId)
        Option.Some(_) -> Result.Err("Project '{projectId}' already exists")
        Option.None -> Result.Ok(true)

verify ensureProjectMissing
    ensureProjectMissing([], "alpha") => Result.Ok(true)
    ensureProjectMissing([Project(id = "alpha", name = "Alpha", archived = false, createdAt = "2026-03-08T12:00:00Z", updatedAt = "2026-03-08T12:00:00Z")], "alpha") => Result.Err("Project 'alpha' already exists")

fn ensureTaskMissing(events: List<TaskEventRecord>, taskId: String) -> Result<Bool, String>
    ? "Rejects duplicate task creation."
    match Domain.Events.hasTaskEvents(events, taskId)
        true -> Result.Err("Task '{taskId}' already exists")
        false -> Result.Ok(true)

verify ensureTaskMissing
    ensureTaskMissing([], "t1") => Result.Ok(true)
    ensureTaskMissing([TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 1, event = Domain.Types.TaskEvent.TaskStarted("2026-03-08T12:00:00Z"))], "t1") => Result.Err("Task 't1' already exists")

fn projectSubject(projectId: String) -> String
    ? "Synthetic audit subject for project actions."
    "project:" + projectId

verify projectSubject
    projectSubject("alpha") => "project:alpha"

fn report(summary: String, subjectId: String, events: List<TaskEventRecord>, notifications: List<Notification>, audits: List<AuditEntry>) -> CommandReport
    ? "Constructor helper for command results."
    CommandReport(summary = summary, subjectId = subjectId, events = events, notifications = notifications, audits = audits)

verify report
    report("ok", "t1", [], [], []) => CommandReport(summary = "ok", subjectId = "t1", events = [], notifications = [], audits = [])

fn projectAudit(projectId: String, action: String, message: String, createdAt: String) -> AuditEntry
    ? "Project-scoped audit entry helper."
    AuditEntry(key = "{action}:{projectId}:{createdAt}", taskId = projectSubject(projectId), action = action, message = message, createdAt = createdAt)

verify projectAudit
    projectAudit("alpha", "project.created", "Created project 'alpha'", "2026-03-08T12:00:00Z") => AuditEntry(key = "project.created:alpha:2026-03-08T12:00:00Z", taskId = "project:alpha", action = "project.created", message = "Created project 'alpha'", createdAt = "2026-03-08T12:00:00Z")

fn taskAuditForEvent(event: TaskEventRecord) -> AuditEntry
    ? "Builds a deterministic audit entry from one typed task event."
    kind = Domain.Events.eventName(event.event)
    AuditEntry(key = "task:{event.taskId}:{event.seq}:{kind}", taskId = event.taskId, action = auditAction(kind), message = auditMessage(event.taskId, event.event), createdAt = Domain.Events.recordedAt(event.event))

verify taskAuditForEvent
    taskAuditForEvent(TaskEventRecord(taskId = "t1", projectId = "alpha", seq = 2, event = Domain.Types.TaskEvent.TagAdded("waiting", "2026-03-09T12:00:00Z"))) => AuditEntry(key = "task:t1:2:TagAdded", taskId = "t1", action = "task.tag_added", message = "Task 't1' added tag 'waiting'", createdAt = "2026-03-09T12:00:00Z")

fn auditAction(kind: String) -> String
    ? "Stable audit action name for one task event kind."
    match kind
        "TaskCreated" -> "task.created"
        "TaskRenamed" -> "task.renamed"
        "TaskStarted" -> "task.started"
        "TaskBlocked" -> "task.blocked"
        "TaskCompleted" -> "task.completed"
        "TaskReopened" -> "task.reopened"
        "PriorityChanged" -> "task.priority_changed"
        "TagAdded" -> "task.tag_added"
        "TagRemoved" -> "task.tag_removed"
        "CommentAdded" -> "task.comment_added"
        "DeadlineSet" -> "task.deadline_set"
        "DeadlineCleared" -> "task.deadline_cleared"
        "TaskArchived" -> "task.archived"
        _ -> "task.unknown"

verify auditAction
    auditAction("TaskCompleted") => "task.completed"
    auditAction("TagAdded") => "task.tag_added"

fn auditMessage(taskId: String, event: TaskEvent) -> String
    ? "Reviewer-facing audit message for one typed task event."
    match event
        TaskEvent.TaskCreated(title, _, _, _, _) -> createdAuditMessage(taskId, title)
        TaskEvent.TaskRenamed(title, _) -> renamedAuditMessage(taskId, title)
        TaskEvent.TaskStarted(_) -> "Task '{taskId}' started"
        TaskEvent.TaskBlocked(reason, _) -> blockedAuditMessage(taskId, reason)
        TaskEvent.TaskCompleted(_) -> "Task '{taskId}' completed"
        TaskEvent.TaskReopened(reason, _) -> reopenedAuditMessage(taskId, reason)
        TaskEvent.PriorityChanged(priority, _) -> priorityAuditMessage(taskId, priority)
        TaskEvent.TagAdded(tag, _) -> tagAddedAuditMessage(taskId, tag)
        TaskEvent.TagRemoved(tag, _) -> tagRemovedAuditMessage(taskId, tag)
        TaskEvent.CommentAdded(comment) -> commentAuditMessage(taskId, comment.author)
        TaskEvent.DeadlineSet(deadline, _) -> deadlineSetAuditMessage(taskId, deadline)
        TaskEvent.DeadlineCleared(_) -> "Task '{taskId}' cleared its deadline"
        TaskEvent.TaskArchived(_) -> "Task '{taskId}' archived"

verify auditMessage
    auditMessage("t1", Domain.Types.TaskEvent.TaskStarted("2026-03-08T12:00:00Z")) => "Task 't1' started"
    auditMessage("t1", Domain.Types.TaskEvent.TagAdded("waiting", "2026-03-08T12:00:00Z")) => "Task 't1' added tag 'waiting'"

fn createdAuditMessage(taskId: String, title: String) -> String
    ? "TaskCreated audit message."
    "Task '{taskId}' created: {title}"

verify createdAuditMessage
    createdAuditMessage("t1", "Plan release") => "Task 't1' created: Plan release"

fn renamedAuditMessage(taskId: String, title: String) -> String
    ? "TaskRenamed audit message."
    "Task '{taskId}' renamed to '{title}'"

verify renamedAuditMessage
    renamedAuditMessage("t1", "Updated") => "Task 't1' renamed to 'Updated'"

fn blockedAuditMessage(taskId: String, reason: String) -> String
    ? "TaskBlocked audit message."
    "Task '{taskId}' blocked: {reason}"

verify blockedAuditMessage
    blockedAuditMessage("t1", "Waiting on vendor") => "Task 't1' blocked: Waiting on vendor"

fn reopenedAuditMessage(taskId: String, reason: String) -> String
    ? "TaskReopened audit message."
    "Task '{taskId}' reopened: {reason}"

verify reopenedAuditMessage
    reopenedAuditMessage("t1", "Regression found") => "Task 't1' reopened: Regression found"

fn priorityAuditMessage(taskId: String, priority: Priority) -> String
    ? "PriorityChanged audit message."
    "Task '{taskId}' priority changed to {priorityText(priority)}"

verify priorityAuditMessage
    priorityAuditMessage("t1", Domain.Types.Priority.Urgent) => "Task 't1' priority changed to urgent"

fn tagAddedAuditMessage(taskId: String, tag: String) -> String
    ? "TagAdded audit message."
    "Task '{taskId}' added tag '{tag}'"

verify tagAddedAuditMessage
    tagAddedAuditMessage("t1", "waiting") => "Task 't1' added tag 'waiting'"

fn tagRemovedAuditMessage(taskId: String, tag: String) -> String
    ? "TagRemoved audit message."
    "Task '{taskId}' removed tag '{tag}'"

verify tagRemovedAuditMessage
    tagRemovedAuditMessage("t1", "waiting") => "Task 't1' removed tag 'waiting'"

fn commentAuditMessage(taskId: String, author: String) -> String
    ? "CommentAdded audit message."
    "Task '{taskId}' received a comment from {author}"

verify commentAuditMessage
    commentAuditMessage("t1", "alice") => "Task 't1' received a comment from alice"

fn deadlineSetAuditMessage(taskId: String, deadline: String) -> String
    ? "DeadlineSet audit message."
    "Task '{taskId}' deadline set to {deadline}"

verify deadlineSetAuditMessage
    deadlineSetAuditMessage("t1", "2026-03-10T12:00:00Z") => "Task 't1' deadline set to 2026-03-10T12:00:00Z"

fn priorityText(priority: Priority) -> String
    ? "Lower-case priority spelling for audit messages."
    match priority
        Priority.Low -> "low"
        Priority.Normal -> "normal"
        Priority.High -> "high"
        Priority.Urgent -> "urgent"

verify priorityText
    priorityText(Domain.Types.Priority.High) => "high"
    priorityText(Domain.Types.Priority.Urgent) => "urgent"

fn sampleProject() -> Project
    ? "Reusable active project fixture for planner verifies."
    Project(id = "alpha", name = "Alpha", archived = false, createdAt = "2026-03-08T12:00:00Z", updatedAt = "2026-03-08T12:00:00Z")

verify sampleProject
    sampleProject() => Project(id = "alpha", name = "Alpha", archived = false, createdAt = "2026-03-08T12:00:00Z", updatedAt = "2026-03-08T12:00:00Z")
