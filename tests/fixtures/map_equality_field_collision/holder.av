module Holder
    intent =
        "A record named Holder.Scored that DOES carry a float-keyed map."
        "The entry module reaches it only through a field annotation, which is a bare piece of text — the module the annotation was written in is what says which Scored it means."

record Scored
    label: String
    scores: Map<Float, Int>

fn scoredOf(scores: Map<Float, Int>) -> Scored
    ? "Builds a scored record around the given map."
    Scored(label = "x", scores = scores)
