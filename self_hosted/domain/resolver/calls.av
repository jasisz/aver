module Calls
    depends [Domain.Ast]
    intent =
        "Direct-call linking for the self-hosted resolver."
        "Turns known user calls into ExprCallDirect and routes builtin namespaces to ExprCallBuiltin."
    exposes [buildFnMap, resolveCallsInFns]
    effects []

fn buildFnMap(fns: List<FnDef>, acc: Map<String, Int>, idx: Int) -> Map<String, Int>
    ? "Build name→fnId map from resolved function list."
    match fns
        [] -> acc
        [f, ..rest] -> buildFnMap(rest, Map.set(acc, f.name, idx), idx + 1)

verify buildFnMap
    buildFnMap([], {}, 0) => {}
    buildFnMap([FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)], {}, 0) => Map.set({}, "f", 0)

fn resolveCallsInFns(fns: List<FnDef>, fnMap: Map<String, Int>, acc: List<FnDef>) -> List<FnDef>
    ? "Transform ExprCall→ExprCallDirect for known functions in all fn bodies."
    match fns
        [] -> List.reverse(acc)
        [f, ..rest] -> resolveCallsInFns(rest, fnMap, List.prepend(resolveCallsInFn(f, fnMap), acc))

verify resolveCallsInFns
    resolveCallsInFns([], {}, []) => []
    List.len(resolveCallsInFns([FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)], {}, [])) => 1

fn resolveCallsInFn(fd: FnDef, fnMap: Map<String, Int>) -> FnDef
    ? "Transform calls in one function body."
    FnDef(name = fd.name, params = fd.params, body = resolveCallsInStmts(fd.body, fnMap, []), slotCount = fd.slotCount, slotMap = fd.slotMap, fastPath = fd.fastPath, tailLoop = fd.tailLoop)

fn resolveCallsInStmts(stmts: List<Stmt>, fnMap: Map<String, Int>, acc: List<Stmt>) -> List<Stmt>
    ? "Resolve calls in a list of statements."
    match stmts
        [] -> List.reverse(acc)
        [s, ..rest] -> resolveCallsInStmts(rest, fnMap, List.prepend(resolveCallsInStmt(s, fnMap), acc))

verify resolveCallsInStmts
    resolveCallsInStmts([], {}, []) => []
    resolveCallsInStmts([Stmt.StmtExpr(Expr.ExprInt(1))], {}, []) => [Stmt.StmtExpr(Expr.ExprInt(1))]

fn resolveCallsInStmt(s: Stmt, fnMap: Map<String, Int>) -> Stmt
    ? "Resolve calls in a single statement."
    match s
        Stmt.StmtBind(name, expr) -> Stmt.StmtBind(name, resolveCallsInExpr(expr, fnMap))
        Stmt.StmtBindSlot(slot, expr) -> Stmt.StmtBindSlot(slot, resolveCallsInExpr(expr, fnMap))
        Stmt.StmtExpr(expr) -> Stmt.StmtExpr(resolveCallsInExpr(expr, fnMap))

verify resolveCallsInStmt
    resolveCallsInStmt(Stmt.StmtExpr(Expr.ExprInt(1)), {}) => Stmt.StmtExpr(Expr.ExprInt(1))
    resolveCallsInStmt(Stmt.StmtBindSlot(0, Expr.ExprInt(2)), {}) => Stmt.StmtBindSlot(0, Expr.ExprInt(2))
    resolveCallsInStmt(Stmt.StmtBind("x", Expr.ExprInt(3)), {}) => Stmt.StmtBind("x", Expr.ExprInt(3))

fn resolveCallsInExpr(expr: Expr, fnMap: Map<String, Int>) -> Expr
    ? "Replace ExprCall with ExprCallDirect for known user functions."
    match expr
        Expr.ExprBoolBranch(cond, thenExpr, elseExpr) -> Expr.ExprBoolBranch(resolveCallsInExpr(cond, fnMap), resolveCallsInExpr(thenExpr, fnMap), resolveCallsInExpr(elseExpr, fnMap))
        Expr.ExprCall(name, args) -> resolveOneCall(name, args, fnMap)
        Expr.ExprCallDirect(fnId, args) -> Expr.ExprCallDirect(fnId, resolveCallsInExprs(args, fnMap, []))
        Expr.ExprCallBuiltin(name, args) -> match Domain.Ast.builtinNameToId(name)
            Option.Some(id) -> Expr.ExprCallBuiltinId(id, resolveCallsInExprs(args, fnMap, []))
            Option.None -> Expr.ExprCallBuiltin(name, resolveCallsInExprs(args, fnMap, []))
        Expr.ExprCallBuiltinId(id, args) -> Expr.ExprCallBuiltinId(id, resolveCallsInExprs(args, fnMap, []))
        _ -> resolveCallsInExprInternal(expr, fnMap)

fn resolveCallsInExprInternal(expr: Expr, fnMap: Map<String, Int>) -> Expr
    ? "Continue direct-call linking for specialized internal and arithmetic forms."
    match expr
        Expr.ExprBinopSlotInt(_, _, _) -> expr
        Expr.ExprBinopSlots(_, _, _) -> expr
        Expr.ExprCmpSlotInt(_, _, _) -> expr
        Expr.ExprCmpSlots(_, _, _) -> expr
        Expr.ExprVectorGetOrInt(vecExpr, idxExpr, defaultValue) -> Expr.ExprVectorGetOrInt(resolveCallsInExpr(vecExpr, fnMap), resolveCallsInExpr(idxExpr, fnMap), defaultValue)
        Expr.ExprIntModOrInt(a, b, defaultValue) -> Expr.ExprIntModOrInt(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap), defaultValue)
        Expr.ExprAdd(a, b) -> Expr.ExprAdd(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprSub(a, b) -> Expr.ExprSub(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprMul(a, b) -> Expr.ExprMul(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprDiv(a, b) -> Expr.ExprDiv(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprNeg(inner) -> Expr.ExprNeg(resolveCallsInExpr(inner, fnMap))
        _ -> resolveCallsInExprTail(expr, fnMap)

fn resolveCallsInExprTail(expr: Expr, fnMap: Map<String, Int>) -> Expr
    ? "Finish direct-call linking for comparisons, aggregates, and product forms."
    match expr
        Expr.ExprEq(a, b) -> Expr.ExprEq(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprNeq(a, b) -> Expr.ExprNeq(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprLt(a, b) -> Expr.ExprLt(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprGt(a, b) -> Expr.ExprGt(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprLte(a, b) -> Expr.ExprLte(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprGte(a, b) -> Expr.ExprGte(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprMatch(subj, arms) -> Expr.ExprMatch(resolveCallsInExpr(subj, fnMap), resolveCallsInArms(arms, fnMap, []))
        Expr.ExprPropagate(inner) -> Expr.ExprPropagate(resolveCallsInExpr(inner, fnMap))
        Expr.ExprConcat(parts) -> Expr.ExprConcat(resolveCallsInExprs(parts, fnMap, []))
        Expr.ExprTuple(exprs) -> Expr.ExprTuple(resolveCallsInExprs(exprs, fnMap, []))
        Expr.ExprIndependentProduct(exprs, unwrap) -> Expr.ExprIndependentProduct(resolveCallsInExprs(exprs, fnMap, []), unwrap)
        Expr.ExprList(exprs) -> Expr.ExprList(resolveCallsInExprs(exprs, fnMap, []))
        Expr.ExprRecord(name, fields) -> Expr.ExprRecord(name, resolveCallsInFields(fields, fnMap, []))
        Expr.ExprFieldAccess(obj, field) -> Expr.ExprFieldAccess(resolveCallsInExpr(obj, fnMap), field)
        _ -> expr

verify resolveCallsInExpr
    resolveCallsInExpr(Expr.ExprInt(42), {}) => Expr.ExprInt(42)
    resolveCallsInExpr(Expr.ExprCall("foo", []), Map.set({}, "foo", 0)) => Expr.ExprCallDirect(0, [])
    resolveCallsInExpr(Expr.ExprStr("hi"), {}) => Expr.ExprStr("hi")
    resolveCallsInExpr(Expr.ExprBool(true), {}) => Expr.ExprBool(true)
    resolveCallsInExpr(Expr.ExprFloat(1.0), {}) => Expr.ExprFloat(1.0)
    resolveCallsInExpr(Expr.ExprSlot(0), {}) => Expr.ExprSlot(0)
    resolveCallsInExpr(Expr.ExprVar("x"), {}) => Expr.ExprVar("x")
    resolveCallsInExpr(Expr.ExprBinopSlotInt(BinOp.OpAdd, 0, 1), {}) => Expr.ExprBinopSlotInt(BinOp.OpAdd, 0, 1)
    resolveCallsInExpr(Expr.ExprBinopSlots(BinOp.OpAdd, 0, 1), {}) => Expr.ExprBinopSlots(BinOp.OpAdd, 0, 1)
    resolveCallsInExpr(Expr.ExprCmpSlotInt(CmpOp.CmpEq, 0, 1), {}) => Expr.ExprCmpSlotInt(CmpOp.CmpEq, 0, 1)
    resolveCallsInExpr(Expr.ExprCmpSlots(CmpOp.CmpEq, 0, 1), {}) => Expr.ExprCmpSlots(CmpOp.CmpEq, 0, 1)
    resolveCallsInExpr(Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprSub(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprSub(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprMul(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprMul(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprDiv(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprDiv(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprEq(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprEq(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprNeq(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprNeq(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprLt(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprLt(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprGt(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprGt(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprLte(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprLte(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprGte(Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprGte(Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprCallDirect(0, []), {}) => Expr.ExprCallDirect(0, [])
    resolveCallsInExpr(Expr.ExprCallBuiltin("Map.get", []), {}) => Expr.ExprCallBuiltinId(2, [])
    resolveCallsInExpr(Expr.ExprCallBuiltinId(0, []), {}) => Expr.ExprCallBuiltinId(0, [])
    resolveCallsInExpr(Expr.ExprMatch(Expr.ExprInt(1), []), {}) => Expr.ExprMatch(Expr.ExprInt(1), [])
    resolveCallsInExpr(Expr.ExprPropagate(Expr.ExprInt(1)), {}) => Expr.ExprPropagate(Expr.ExprInt(1))
    resolveCallsInExpr(Expr.ExprConcat([]), {}) => Expr.ExprConcat([])
    resolveCallsInExpr(Expr.ExprTuple([]), {}) => Expr.ExprTuple([])
    resolveCallsInExpr(Expr.ExprList([]), {}) => Expr.ExprList([])
    resolveCallsInExpr(Expr.ExprRecord("Foo", []), {}) => Expr.ExprRecord("Foo", [])
    resolveCallsInExpr(Expr.ExprFieldAccess(Expr.ExprInt(1), "x"), {}) => Expr.ExprFieldAccess(Expr.ExprInt(1), "x")
    resolveCallsInExpr(Expr.ExprBoolBranch(Expr.ExprBool(true), Expr.ExprInt(1), Expr.ExprInt(2)), {}) => Expr.ExprBoolBranch(Expr.ExprBool(true), Expr.ExprInt(1), Expr.ExprInt(2))
    resolveCallsInExpr(Expr.ExprVectorGetOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0), {}) => Expr.ExprVectorGetOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0)
    resolveCallsInExpr(Expr.ExprIntModOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0), {}) => Expr.ExprIntModOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0)

fn resolveOneCall(name: String, args: List<Expr>, fnMap: Map<String, Int>) -> Expr
    ? "User fn → ExprCallDirect, builtin → ExprCallBuiltin, record update → ExprCall."
    resolvedArgs = resolveCallsInExprs(args, fnMap, [])
    match Map.get(fnMap, name)
        Option.Some(fnId) -> Expr.ExprCallDirect(fnId, resolvedArgs)
        Option.None -> match String.endsWith(name, ".update")
            true -> Expr.ExprCall(name, resolvedArgs)
            false -> match isBuiltinCallName(name)
                true -> resolveBuiltinCall(name, resolvedArgs)
                false -> Expr.ExprCall(name, resolvedArgs)

verify resolveOneCall
    resolveOneCall("foo", [], Map.set({}, "foo", 5)) => Expr.ExprCallDirect(5, [])
    resolveOneCall("Map.get", [Expr.ExprInt(1)], {}) => Expr.ExprCallBuiltin("Map.get", [Expr.ExprInt(1)])
    resolveOneCall("Int.div", [Expr.ExprSlot(0), Expr.ExprInt(2)], {}) => Expr.ExprCallBuiltin("Result.withDefault", [Expr.ExprCallBuiltin("Int.div", [Expr.ExprSlot(0), Expr.ExprInt(2)]), Expr.ExprInt(0)])

fn resolveBuiltinCall(name: String, resolvedArgs: List<Expr>) -> Expr
    ? "Link a builtin call, discharging a literal-divisor Int.div/Int.mod to a plain Int."
    match isLiteralDivisorCall(name, resolvedArgs)
        true -> Expr.ExprCallBuiltin("Result.withDefault", [Expr.ExprCallBuiltin(name, resolvedArgs), Expr.ExprInt(0)])
        false -> Expr.ExprCallBuiltin(name, resolvedArgs)

verify resolveBuiltinCall
    resolveBuiltinCall("Map.get", [Expr.ExprInt(1)]) => Expr.ExprCallBuiltin("Map.get", [Expr.ExprInt(1)])
    resolveBuiltinCall("Int.mod", [Expr.ExprSlot(0), Expr.ExprInt(2)]) => Expr.ExprCallBuiltin("Result.withDefault", [Expr.ExprCallBuiltin("Int.mod", [Expr.ExprSlot(0), Expr.ExprInt(2)]), Expr.ExprInt(0)])
    resolveBuiltinCall("Int.mod", [Expr.ExprSlot(0), Expr.ExprSlot(1)]) => Expr.ExprCallBuiltin("Int.mod", [Expr.ExprSlot(0), Expr.ExprSlot(1)])

fn isLiteralDivisorCall(name: String, args: List<Expr>) -> Bool
    ? "Whether this is Int.div/Int.mod over a syntactic nonzero integer literal divisor."
    match Bool.and(Bool.or(name == "Int.div", name == "Int.mod"), List.len(args) == 2)
        false -> false
        true -> isNonzeroIntLiteralDivisor(args)

verify isLiteralDivisorCall
    isLiteralDivisorCall("Int.div", [Expr.ExprSlot(0), Expr.ExprInt(2)]) => true
    isLiteralDivisorCall("Int.mod", [Expr.ExprSlot(0), Expr.ExprNeg(Expr.ExprInt(3))]) => true
    isLiteralDivisorCall("Int.div", [Expr.ExprSlot(0), Expr.ExprInt(0)]) => false
    isLiteralDivisorCall("Int.div", [Expr.ExprSlot(0), Expr.ExprSlot(1)]) => false
    isLiteralDivisorCall("Int.max", [Expr.ExprSlot(0), Expr.ExprInt(2)]) => false
    isLiteralDivisorCall("Int.div", [Expr.ExprInt(2)]) => false

fn isNonzeroIntLiteralDivisor(args: List<Expr>) -> Bool
    ? "Whether the second of exactly two arguments is a nonzero integer literal."
    match args
        [_, ..rest] -> match rest
            [divisor, ..ignored] -> isNonzeroIntLiteral(divisor)
            _ -> false
        _ -> false

verify isNonzeroIntLiteralDivisor
    isNonzeroIntLiteralDivisor([Expr.ExprSlot(0), Expr.ExprInt(4)]) => true
    isNonzeroIntLiteralDivisor([Expr.ExprSlot(0)]) => false
    isNonzeroIntLiteralDivisor([]) => false

fn isNonzeroIntLiteral(expr: Expr) -> Bool
    ? "Whether an expression is a nonzero integer literal under at most one unary minus."
    match expr
        Expr.ExprInt(k) -> k != 0
        Expr.ExprNeg(inner) -> isBareNonzeroIntLiteral(inner)
        _ -> false

verify isNonzeroIntLiteral
    isNonzeroIntLiteral(Expr.ExprInt(2)) => true
    isNonzeroIntLiteral(Expr.ExprInt(0)) => false
    isNonzeroIntLiteral(Expr.ExprNeg(Expr.ExprInt(3))) => true
    isNonzeroIntLiteral(Expr.ExprNeg(Expr.ExprNeg(Expr.ExprInt(5)))) => false
    isNonzeroIntLiteral(Expr.ExprSlot(0)) => false

fn isBareNonzeroIntLiteral(expr: Expr) -> Bool
    ? "Whether an expression is a bare nonzero integer literal, with no unary minus of its own."
    match expr
        Expr.ExprInt(k) -> k != 0
        _ -> false

verify isBareNonzeroIntLiteral
    isBareNonzeroIntLiteral(Expr.ExprInt(3)) => true
    isBareNonzeroIntLiteral(Expr.ExprInt(0)) => false
    isBareNonzeroIntLiteral(Expr.ExprNeg(Expr.ExprInt(3))) => false

fn isBuiltinCallName(name: String) -> Bool
    ? "Return whether a call name is one of the exact builtin/service entrypoints."
    isBuiltinCallNameFrom(name, [
        "Args.get",
        "Bool.and",
        "Bool.not",
        "Bool.or",
        "String.fromCodePoint",
        "String.firstCodePoint",
        "Console.error",
        "Console.print",
        "Console.readLine",
        "Console.warn",
        "Disk.appendText",
        "Disk.delete",
        "Disk.deleteDir",
        "Disk.exists",
        "Disk.listDir",
        "Disk.makeDir",
        "Disk.readText",
        "Disk.writeText",
        "Env.get",
        "Env.set",
        "Float.abs",
        "Float.atan2",
        "Float.ceil",
        "Float.cos",
        "Float.floor",
        "Float.fromInt",
        "Float.fromString",
        "Float.max",
        "Float.min",
        "Float.pi",
        "Float.pow",
        "Float.round",
        "Float.sin",
        "Float.sqrt",
        "String.fromFloat",
        "Http.delete",
        "Http.get",
        "Http.head",
        "Http.patch",
        "Http.post",
        "Http.put",
        "Int.abs",
        "Int.div",
        "Int.fromString",
        "Int.max",
        "Int.min",
        "Int.mod",
        "Float.fromInt",
        "String.fromInt",
        "List.concat",
        "List.contains",
        "List.drop",
        "List.head",
        "List.len",
        "List.prepend",
        "List.reverse",
        "List.take",
        "List.tail",
        "List.zip",
        "Map.entries",
        "Map.fromList",
        "Map.get",
        "Map.has",
        "Map.keys",
        "Map.remove",
        "Map.set",
        "Map.size",
        "Map.values",
        "Option.None",
        "Option.Some",
        "Result.fromOption",
        "Option.withDefault",
        "Random.int",
        "Result.Err",
        "Result.Ok",
        "Result.withDefault",
        "String.charAt",
        "String.chars",
        "String.contains",
        "String.endsWith",
        "String.fromBool",
        "String.fromFloat",
        "String.fromInt",
        "String.join",
        "String.len",
        "String.repeat",
        "String.replace",
        "String.slice",
        "String.split",
        "String.startsWith",
        "String.toLower",
        "String.toUpper",
        "String.trim",
        "Tcp.close",
        "Tcp.closeDial",
        "Tcp.closeListener",
        "Tcp.connect",
        "Tcp.beginConnect",
        "Tcp.dialled",
        "Tcp.listen",
        "Tcp.accept",
        "Tcp.peerAddress",
        "Tcp.ping",
        "Tcp.poll",
        "Tcp.readLine",
        "Tcp.send",
        "Tcp.writeLine",
        "Terminal.clear",
        "Terminal.disableRawMode",
        "Terminal.enableRawMode",
        "Terminal.flush",
        "Terminal.hideCursor",
        "Terminal.moveTo",
        "Terminal.print",
        "Terminal.readKey",
        "Terminal.resetColor",
        "Terminal.setColor",
        "Terminal.showCursor",
        "Terminal.size",
        "Time.now",
        "Time.sleep",
        "Time.unixMs",
        "Vector.fromList",
        "Vector.get",
        "Vector.len",
        "Vector.new",
        "Vector.set",
        "List.fromVector",
    ])

verify isBuiltinCallName
    isBuiltinCallName("Map.get") => true
    isBuiltinCallName("Map.buildRowAcc") => false
    isBuiltinCallName("Main.initGame") => false

fn isBuiltinCallNameFrom(name: String, knownNames: List<String>) -> Bool
    ? "Check builtin/service call names recursively by exact match."
    match knownNames
        [] -> false
        [knownName, ..rest] -> match name == knownName
            true -> true
            false -> isBuiltinCallNameFrom(name, rest)

verify isBuiltinCallNameFrom
    isBuiltinCallNameFrom("Map.get", ["Map.get", "Map.set"]) => true
    isBuiltinCallNameFrom("foo", ["Map.get"]) => false
    isBuiltinCallNameFrom("x", []) => false

fn resolveCallsInExprs(exprs: List<Expr>, fnMap: Map<String, Int>, acc: List<Expr>) -> List<Expr>
    ? "Resolve calls in a list of expressions."
    match exprs
        [] -> List.reverse(acc)
        [e, ..rest] -> resolveCallsInExprs(rest, fnMap, List.prepend(resolveCallsInExpr(e, fnMap), acc))

verify resolveCallsInExprs
    resolveCallsInExprs([], {}, []) => []
    resolveCallsInExprs([Expr.ExprInt(1)], {}, []) => [Expr.ExprInt(1)]

fn resolveCallsInArms(arms: List<MatchArm>, fnMap: Map<String, Int>, acc: List<MatchArm>) -> List<MatchArm>
    ? "Resolve calls in match arm bodies."
    match arms
        [] -> List.reverse(acc)
        [arm, ..rest] -> resolveCallsInArms(rest, fnMap, List.prepend(MatchArm(pattern = arm.pattern, body = resolveCallsInExpr(arm.body, fnMap), bindingSlots = arm.bindingSlots), acc))

verify resolveCallsInArms
    resolveCallsInArms([], {}, []) => []
    resolveCallsInArms([MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = {})], {}, []) => [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = {})]

fn resolveCallsInFields(fields: List<Tuple<String, Expr>>, fnMap: Map<String, Int>, acc: List<Tuple<String, Expr>>) -> List<Tuple<String, Expr>>
    ? "Resolve calls in record field expressions."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (name, expr) -> resolveCallsInFields(rest, fnMap, List.prepend((name, resolveCallsInExpr(expr, fnMap)), acc))

verify resolveCallsInFields
    resolveCallsInFields([], {}, []) => []
    resolveCallsInFields([("x", Expr.ExprInt(1))], {}, []) => [("x", Expr.ExprInt(1))]
