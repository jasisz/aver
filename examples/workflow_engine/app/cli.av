    ? "Parses show_task."
    taskId = field(parts, 1, "task_id")?
    Result.Ok(Input.RunQuery(Query.ShowTask(taskId)))

verify parseShowTask
    parseShowTask(["show_task", "t1"]) => Result.Ok(Input.RunQuery(Query.ShowTask("t1")))

