module Pooled
    intent = "Fixture answer module: every score is a job of one of two kinds this module begins itself, alpha for a task below ten and beta for the rest. Both kinds share one engine and one limit."
    depends [Alpha, Beta, Pool, Wait, Work]
    exposes [State, fresh, tasks, scored, total, scoreAlpha, scoreBeta]
    effects [Alpha.begin, Alpha.take, Beta.begin, Beta.take]
    answers [Pool]

record State
    jobs: Map<Int, Work.Job>
    scored: Int
    landed: Int

fn fresh() -> State
    ? "No job running, nothing scored and nothing landed."
    State(jobs = {}, scored = 0, landed = 0)

fn tasks(state: State) -> List<Int>
    ? "The tasks the loop seats one scorer for each of: two alpha tasks and two beta tasks."
    [1, 2, 10, 20]

verify tasks
    tasks(fresh()) => [1, 2, 10, 20]

fn scored(state: State, task: Int) -> Tuple<State, Result<Int, Run.Wake>>
    ? "The first ask for a task begins its job and waits on it; an ask after the wait reported it takes it."
    ! [Alpha.begin, Alpha.take, Beta.begin, Beta.take]
    match Map.get(state.jobs, task)
        Option.Some(job) -> match task < 10
            true -> takeAlpha(state, task, job)
            false -> takeBeta(state, task, job)
        Option.None -> match task < 10
            true -> beginAlpha(state, task)
            false -> beginBeta(state, task)

fn beginAlpha(state: State, task: Int) -> Tuple<State, Result<Int, Run.Wake>>
    ? "Begins an alpha job and waits on it; a job that could not begin lands at once, scoring 0."
    ! [Alpha.begin]
    match Alpha.begin(task)
        Result.Err(_) -> (landedWith(state, task, 0), Result.Ok(0))
        Result.Ok(job) -> (State.update(state, jobs = Map.set(state.jobs, task, job)), Result.Err(Run.Wake.Until([Wait.Item.Job(job)], Option.None)))

fn beginBeta(state: State, task: Int) -> Tuple<State, Result<Int, Run.Wake>>
    ? "Begins a beta job and waits on it; a job that could not begin lands at once, scoring 0."
    ! [Beta.begin]
    match Beta.begin(task)
        Result.Err(_) -> (landedWith(state, task, 0), Result.Ok(0))
        Result.Ok(job) -> (State.update(state, jobs = Map.set(state.jobs, task, job)), Result.Err(Run.Wake.Until([Wait.Item.Job(job)], Option.None)))

fn takeAlpha(state: State, task: Int, job: Work.Job) -> Tuple<State, Result<Int, Run.Wake>>
    ? "Takes an alpha job."
    ! [Alpha.take]
    takenWith(state, task, Run.Wake.Until([Wait.Item.Job(job)], Option.None), Alpha.take(job))

fn takeBeta(state: State, task: Int, job: Work.Job) -> Tuple<State, Result<Int, Run.Wake>>
    ? "Takes a beta job."
    ! [Beta.take]
    takenWith(state, task, Run.Wake.Until([Wait.Item.Job(job)], Option.None), Beta.take(job))

fn takenWith(state: State, task: Int, again: Run.Wake, outcome: Result<Option<Int>, String>) -> Tuple<State, Result<Int, Run.Wake>>
    ? "What one take answered: nothing yet waits again, a score lands, and a job that will never finish lands scoring 0."
    match outcome
        Result.Err(_) -> (landedWith(state, task, 0), Result.Ok(0))
        Result.Ok(found) -> match found
            Option.None -> (state, Result.Err(again))
            Option.Some(points) -> (landedWith(state, task, points), Result.Ok(points))

verify takenWith
    takenWith(fresh(), 1, Run.Wake.Settled(Option.None), Result.Ok(Option.None)) => (fresh(), Result.Err(Run.Wake.Settled(Option.None)))
    takenWith(fresh(), 1, Run.Wake.Settled(Option.None), Result.Ok(Option.Some(2))) => (State.update(fresh(), scored = 2, landed = 1), Result.Ok(2))
    takenWith(fresh(), 1, Run.Wake.Settled(Option.None), Result.Err("work: job cancelled")) => (State.update(fresh(), landed = 1), Result.Ok(0))

fn landedWith(state: State, task: Int, points: Int) -> State
    ? "One task has landed: its handle goes, and its score counts."
    State.update(state, jobs = Map.remove(state.jobs, task), scored = state.scored + points, landed = state.landed + 1)

verify landedWith
    landedWith(fresh(), 1, 3) => State.update(fresh(), scored = 3, landed = 1)

fn total(state: State) -> Tuple<State, Result<Int, Run.Wake>>
    ? "The sum once every task has landed; until then the request waits for this module's state to move."
    match state.landed == 4
        true -> (state, Result.Ok(state.scored))
        false -> (state, Result.Err(Run.Wake.Settled(Option.None)))

verify total
    total(fresh()) => (fresh(), Result.Err(Run.Wake.Settled(Option.None)))
    total(State.update(fresh(), landed = 4, scored = 65)) => (State.update(fresh(), landed = 4, scored = 65), Result.Ok(65))

fn scoreAlpha(task: Int) -> Int
    ? "What one alpha job computes off the turn."
    task + 1

verify scoreAlpha
    scoreAlpha(1) => 2

fn scoreBeta(task: Int) -> Int
    ? "What one beta job computes off the turn."
    task * 2

verify scoreBeta
    scoreBeta(10) => 20
