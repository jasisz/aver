module Ledger
    intent = "An answer module answering gone through nothing: Pool declares no GoneReply."
    depends [Pool]
    exposes [State, claim, gone]
    effects []

record State
    free: List<Int>
    stopping: Bool

fn claim(state: State, key: Int) -> Tuple<State, Pool.ClaimReply>
    ? "The next height for this peer."
    (state, Pool.ClaimReply.Now(Pool.Assignment.Idle))

fn gone(state: State, key: Int) -> Tuple<State, Unit>
    ? "A peer that left gives its height back."
    (state, Unit)
