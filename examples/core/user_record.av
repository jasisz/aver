module UserRecord
    intent =
        "Record example with simple user operations."
    exposes [User, greet, is_adult]
    effects [Console]

record User
  name: String
  age: Int

fn greet(u: User) -> String
  ? "Greet a user by name"
  u.name

verify greet
    greet(User(name = "Alice", age = 30)) => "Alice"
    greet(User(name = "Bob", age = 15)) => "Bob"

fn is_adult(u: User) -> Bool
  ? "Check if a user is an adult (18+)"
  u.age >= 18

verify is_adult
    is_adult(User(name = "Alice", age = 30)) => true
    is_adult(User(name = "Bob", age = 15)) => false

fn main()
  ! [Console.print]
  alice = User(name = "Alice", age = 30)
  bob = User(name = "Bob", age = 15)
  Console.print(greet(alice))
  Console.print(greet(bob))
  Console.print(is_adult(alice))
  Console.print(is_adult(bob))
