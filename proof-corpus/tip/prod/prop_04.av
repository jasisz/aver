module Prop04
    intent =
        "TIP prod prop_04: length(x ++ x) = double(length x)."
    effects []

type Nat
    Z
    S(Nat)

fn length(x: List<Int>) -> Nat
    match x
        [] -> Nat.Z
        [y, ..xs] -> Nat.S(length(xs))

fn double(x: Nat) -> Nat
    match x
        Nat.Z -> Nat.Z
        Nat.S(y) -> Nat.S(Nat.S(double(y)))

fn append(x: List<Int>, y: List<Int>) -> List<Int>
    match x
        [] -> y
        [z, ..xs] -> List.concat([z], append(xs, y))

verify length law lengthAppendDouble
    given x: List<Int> = [[], [1], [1, 2], [1, 2, 3]]
    length(append(x, x)) => double(length(x))
