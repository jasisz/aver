module Induct
    intent =
        "The termination gate for a definition that calls itself, and the pieces of an induction"
        "that follows a function's own recursion: its recursive calls, the parameter it recurses on,"
        "and the givens that vary with it. The gate returns what it checked, which opening a"
        "definition and an induction along it both read: a match on a parameter whose calls pass"
        "a part of the value matched, or a match on `n <= 0` or `n > 0` whose calls pass n - 1 or"
        "n / k (k a literal of at least 2) where n > 0. See src/ir/proof_steps/induct.rs."
    exposes [Call, Place, Varied, ArmCalls, Recursion, selfCalls, recursion, openGate, refuseMutualRecursion, varied, nthTerm]
    depends [Kernel.Term, Kernel.Subst, Kernel.Proof]
    effects []

record Call
    args: List<Term>
    inner: List<String>

record ArmCalls
    arm: Arm
    calls: List<Call>

record Recursion
    at: Int
    guard: Option<Term>
    arms: List<ArmCalls>

record Place
    at: Int
    name: String

record Varied
    v: String
    general: List<Place>

fn selfCalls(t: Term, f: String, bound: List<String>) -> List<Call>
    ? "The calls of f in t, a call before the calls in its arguments, a match's subject before its arms, each with the names inner arms bind around it."
    match t
        Term.TCall(g, xs) -> match g == f
            true -> List.prepend(Call(args = xs, inner = bound), callsAll(xs, f, bound))
            false -> callsAll(xs, f, bound)
        Term.TMatch(s, arms) -> List.concat(selfCalls(s, f, bound), callsArms(arms, f, bound))
        Term.TGet(o, n) -> selfCalls(o, f, bound)
        Term.TBi(n, xs) -> callsAll(xs, f, bound)
        Term.TOp(o, a, b) -> List.concat(selfCalls(a, f, bound), selfCalls(b, f, bound))
        Term.TNeg(a) -> selfCalls(a, f, bound)
        Term.TCtor(c, xs) -> callsAll(xs, f, bound)
        Term.TParts(xs) -> callsAll(xs, f, bound)
        Term.TList(xs) -> callsAll(xs, f, bound)
        Term.TTuple(xs) -> callsAll(xs, f, bound)
        Term.TRec(n, fs) -> callsFields(fs, f, bound)
        Term.TUpd(n, b, fs) -> List.concat(selfCalls(b, f, bound), callsFields(fs, f, bound))
        _ -> []

verify selfCalls
    selfCalls(Term.TCall("f", [Term.TCall("f", [Term.TVar("t")])]), "f", []) => [Call(args = [Term.TCall("f", [Term.TVar("t")])], inner = []), Call(args = [Term.TVar("t")], inner = [])]
    selfCalls(Term.TMatch(Term.TVar("x"), [Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("f", [Term.TVar("t")]))]), "f", []) => [Call(args = [Term.TVar("t")], inner = ["h", "t"])]
    selfCalls(Term.TCall("g", [Term.TInt(1)]), "f", []) => []

fn callsAll(xs: List<Term>, f: String, bound: List<String>) -> List<Call>
    ? "Calls of f in several terms, in order."
    match xs
        [] -> []
        [x, ..rest] -> List.concat(selfCalls(x, f, bound), callsAll(rest, f, bound))

verify callsAll
    callsAll([], "f", []) => []

fn callsFields(fs: List<Field>, f: String, bound: List<String>) -> List<Call>
    ? "Calls of f in record fields, in order."
    match fs
        [] -> []
        [x, ..rest] -> List.concat(selfCalls(x.value, f, bound), callsFields(rest, f, bound))

verify callsFields
    callsFields([], "f", []) => []

fn callsArms(arms: List<Arm>, f: String, bound: List<String>) -> List<Call>
    ? "Calls of f in match arms, each arm's pattern names added to what is bound."
    match arms
        [] -> []
        [a, ..rest] -> List.concat(selfCalls(a.body, f, List.concat(bound, Kernel.Subst.patNames(a.pattern))), callsArms(rest, f, bound))

verify callsArms
    callsArms([], "f", []) => []

fn letCalls(ls: List<Binding>, f: String) -> Int
    ? "How many calls of f the local bindings make."
    match ls
        [] -> 0
        [b, ..rest] -> List.len(selfCalls(b.value, f, [])) + letCalls(rest, f)

verify letCalls
    letCalls([Kernel.Term.bind("y", Term.TCall("f", []))], "f") => 1

fn recursion(d: Def) -> Result<Option<Recursion>, String>
    ? "None when d does not call itself. Otherwise what the gate checked, which opening d and an induction along it both read: the place of the parameter d recurses on, the comparison its match splits on when it counts that Int toward zero (none when it matches the value itself), and each arm with its recursive calls, every one of them checked to descend. A refusal when one does not."
    match (letCalls(d.lets, d.name) == 0, selfCalls(d.body, d.name, []))
        (true, []) -> Result.Ok(Option.None)
        _ -> Result.Ok(Option.Some(recursive(d)?))

verify recursion
    recursion(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TVar("x"))) => Result.Ok(Option.None)
    recursion(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TMatch(Term.TVar("x"), [Arm(pattern = Pat.PNil, body = Term.TInt(0)), Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("f", [Term.TVar("t")]))]))) => Result.Ok(Option.Some(Recursion(at = 0, guard = Option.None, arms = [ArmCalls(arm = Arm(pattern = Pat.PNil, body = Term.TInt(0)), calls = []), ArmCalls(arm = Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("f", [Term.TVar("t")])), calls = [Call(args = [Term.TVar("t")], inner = [])])])))
    recursion(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TMatch(Term.TVar("x"), [Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("f", [Term.TVar("x")]))]))) => Result.Err("f recurses on something that is not a part of the value it matches")
    recursion(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TCall("f", [Term.TVar("x")]))) => Result.Err("f recurses outside a match on a parameter")
    recursion(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TMatch(Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(1)), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))]))) => Result.Ok(Option.Some(Recursion(at = 0, guard = Option.Some(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))), arms = [ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(1)), calls = []), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))])), calls = [Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])])])))
    recursion(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TMatch(Term.TOp("<=", Term.TVar("n"), Term.TInt(1)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(1)), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))]))) => Result.Err("f recurses outside a match on a parameter")
    recursion(Def(name = "f", returnsBool = false, params = [], lets = [Kernel.Term.bind("y", Term.TInt(1))], body = Term.TCall("f", []))) => Result.Err("f recurses from a local binding")

fn recursive(d: Def) -> Result<Recursion, String>
    ? "The gate for a definition that does call itself: no local bindings, and a body that matches a parameter or compares one with zero."
    match (d.lets, d.body)
        ([], Term.TMatch(Term.TVar(p), arms)) -> onParts(d, indexOf(d.params, p, 0), arms)
        ([], Term.TMatch(Term.TOp(op, Term.TVar(p), Term.TInt(0)), arms)) -> towardZero(d, Term.TOp(op, Term.TVar(p), Term.TInt(0)), p, indexOf(d.params, p, 0), arms)
        ([], _) -> Result.Err("{d.name} recurses outside a match on a parameter")
        _ -> Result.Err("{d.name} recurses from a local binding")

verify recursive
    recursive(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TMatch(Term.TVar("y"), []))) => Result.Err("f recurses on a match whose subject is not a parameter")
    recursive(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TMatch(Term.TOp("<=", Term.TVar("y"), Term.TInt(0)), []))) => Result.Err("f recurses on a match whose subject is not a parameter")

fn onParts(d: Def, j: Int, arms: List<Arm>) -> Result<Recursion, String>
    ? "Every recursive call passes, at place j, a name its arm's pattern binds and no inner arm rebinds: a strict part of the value matched."
    match j < 0
        true -> Result.Err("{d.name} recurses on a match whose subject is not a parameter")
        false -> match armsShrink(arms, d.name, j, List.len(d.params))
            true -> Result.Ok(Recursion(at = j, guard = Option.None, arms = armCalls(arms, d.name)))
            false -> Result.Err("{d.name} recurses on something that is not a part of the value it matches")

verify onParts
    onParts(Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), 0 - 1, []) => Result.Err("f recurses on a match whose subject is not a parameter")

fn armCalls(arms: List<Arm>, f: String) -> List<ArmCalls>
    ? "Each arm with the recursive calls in it, as selfCalls lists them."
    match arms
        [] -> []
        [a, ..rest] -> List.prepend(ArmCalls(arm = a, calls = selfCalls(a.body, f, [])), armCalls(rest, f))

verify armCalls
    armCalls([Arm(pattern = Pat.PWild, body = Term.TCall("f", []))], "f") => [ArmCalls(arm = Arm(pattern = Pat.PWild, body = Term.TCall("f", [])), calls = [Call(args = [], inner = [])])]

fn towardZero(d: Def, guard: Term, p: String, j: Int, arms: List<Arm>) -> Result<Recursion, String>
    ? "match p <= 0 or match p > 0, one arm per truth value: the arm where the comparison says p is at most 0 makes no recursive call, and every call in the other passes p - 1 or p / k at p's place, for a literal k of at least 2, p not rebound around it. Where p > 0 both are at least 0 and below p, so the recursion stops for every Int."
    match (j < 0, stopsAt(guard), arms)
        (true, _, _) -> Result.Err("{d.name} recurses on a match whose subject is not a parameter")
        (false, Option.Some(stop), [a, b]) -> match Bool.and(oneEach(a.pattern, b.pattern), Bool.and(armDescends(a, stop, d, p, j), armDescends(b, stop, d, p, j)))
            true -> Result.Ok(Recursion(at = j, guard = Option.Some(guard), arms = armCalls(arms, d.name)))
            false -> Result.Err("{d.name} does not count {p} down to zero")
        _ -> Result.Err("{d.name} does not count {p} down to zero")

verify towardZero
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), Term.TOp(">", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TOp("+", Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])]), Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0))]) => Result.Ok(Recursion(at = 0, guard = Option.Some(Term.TOp(">", Term.TVar("n"), Term.TInt(0))), arms = [ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TOp("+", Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])]), Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))), calls = [Call(args = [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])], inner = []), Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])]), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0)), calls = [])]))
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), Term.TOp(">", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])])), Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(0))]) => Result.Err("f does not count n down to zero")
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(1))]) => Result.Err("f does not count n down to zero")
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), Term.TOp(">=", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(1))]) => Result.Err("f does not count n down to zero")
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(1))]) => Result.Err("f does not count n down to zero")
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), "n", 0 - 1, []) => Result.Err("f recurses on a match whose subject is not a parameter")

fn stopsAt(guard: Term) -> Option<Bool>
    ? "The value of the comparison where p is at most 0: true for p <= 0, false for p > 0; none for any other comparison."
    match guard
        Term.TOp("<=", _, _) -> Option.Some(true)
        Term.TOp(">", _, _) -> Option.Some(false)
        _ -> Option.None

verify stopsAt
    stopsAt(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))) => Option.Some(true)
    stopsAt(Term.TOp(">", Term.TVar("n"), Term.TInt(0))) => Option.Some(false)
    stopsAt(Term.TOp("<", Term.TVar("n"), Term.TInt(0))) => Option.None

fn oneEach(a: Pat, b: Pat) -> Bool
    ? "One arm true, the other false."
    match (a, b)
        (Pat.PLit(Term.TBool(x)), Pat.PLit(Term.TBool(y))) -> x != y
        _ -> false

verify oneEach
    oneEach(Pat.PLit(Term.TBool(false)), Pat.PLit(Term.TBool(true))) => true
    oneEach(Pat.PLit(Term.TBool(true)), Pat.PLit(Term.TBool(true))) => false
    oneEach(Pat.PLit(Term.TBool(true)), Pat.PWild) => false

fn armDescends(a: Arm, stop: Bool, d: Def, p: String, j: Int) -> Bool
    ? "The arm where p is at most 0 makes no recursive call; each call in the other descends at place j."
    match a.pattern == Pat.PLit(Term.TBool(stop))
        true -> List.len(selfCalls(a.body, d.name, [])) == 0
        false -> callsDescend(selfCalls(a.body, d.name, []), p, j, List.len(d.params))

verify armDescends
    armDescends(Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TInt(0)])), true, Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), "n", 0) => false
    armDescends(Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TMatch(Term.TVar("x"), [Arm(pattern = Pat.PVar("n"), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))])), true, Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), "n", 0) => false

fn callsDescend(cs: List<Call>, p: String, j: Int, n: Int) -> Bool
    ? "Each call has every argument and passes p - 1 or p / k at place j, p not rebound around it."
    match cs
        [] -> true
        [c, ..rest] -> Bool.and(Bool.and(List.len(c.args) == n, Bool.and(descends(nthTerm(c.args, j), p), Bool.not(List.contains(c.inner, p)))), callsDescend(rest, p, j, n))

verify callsDescend
    callsDescend([Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = ["n"])], "n", 0, 1) => false
    callsDescend([Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])], "n", 0, 1) => true
    callsDescend([Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])], "n", 0, 2) => false

fn descends(t: Option<Term>, p: String) -> Bool
    ? "Whether t is p - 1, or p / k for a literal k of at least 2: for p > 0 each is at least 0 and below p."
    match t
        Option.Some(Term.TOp("-", Term.TVar(q), Term.TInt(1))) -> q == p
        Option.Some(Term.TBi("__int_div_euclid", [Term.TVar(q), Term.TInt(k)])) -> Bool.and(q == p, k >= 2)
        _ -> false

verify descends
    descends(Option.Some(Term.TOp("-", Term.TVar("n"), Term.TInt(1))), "n") => true
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])), "n") => true
    descends(Option.Some(Term.TOp("-", Term.TVar("n"), Term.TInt(0))), "n") => false
    descends(Option.Some(Term.TOp("-", Term.TVar("n"), Term.TInt(2))), "n") => false
    descends(Option.Some(Term.TOp("+", Term.TVar("n"), Term.TInt(1))), "n") => false
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(1)])), "n") => false
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(0 - 2)])), "n") => false
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TVar("k")])), "n") => false
    descends(Option.Some(Term.TBi("__int_mod_euclid", [Term.TVar("n"), Term.TInt(2)])), "n") => false
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("m"), Term.TInt(2)])), "n") => false
    descends(Option.None, "n") => false

fn openGate(d: Def) -> Result<Unit, String>
    ? "Whether steps may open d: it does not call itself, or its recursion passes the gate."
    match recursion(d)
        Result.Ok(_) -> Result.Ok(Unit)
        Result.Err(why) -> Result.Err(why)

verify openGate
    openGate(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TMatch(Term.TOp(">", Term.TVar("n"), Term.TInt(0)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(256)])])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0))]))) => Result.Ok(Unit)
    openGate(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TMatch(Term.TOp(">", Term.TVar("n"), Term.TInt(0)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(1)])])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0))]))) => Result.Err("f does not count n down to zero")
    openGate(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TCall("f", [Term.TVar("n")]))) => Result.Err("f recurses outside a match on a parameter")

fn armsShrink(arms: List<Arm>, f: String, j: Int, n: Int) -> Bool
    ? "Every arm passes, at place j of each recursive call, a name its pattern binds and no inner arm rebinds."
    match arms
        [] -> true
        [a, ..rest] -> Bool.and(callsShrink(selfCalls(a.body, f, []), Kernel.Subst.patNames(a.pattern), j, n), armsShrink(rest, f, j, n))

verify armsShrink
    armsShrink([], "f", 0, 1) => true

fn callsShrink(cs: List<Call>, parts: List<String>, j: Int, n: Int) -> Bool
    ? "Each call passes one of the parts at place j."
    match cs
        [] -> true
        [c, ..rest] -> Bool.and(Bool.and(List.len(c.args) == n, smaller(nthTerm(c.args, j), parts, c.inner)), callsShrink(rest, parts, j, n))

verify callsShrink
    callsShrink([Call(args = [Term.TVar("t")], inner = [])], ["h", "t"], 0, 1) => true
    callsShrink([Call(args = [Term.TVar("t")], inner = ["t"])], ["h", "t"], 0, 1) => false

fn smaller(t: Option<Term>, parts: List<String>, inner: List<String>) -> Bool
    ? "A name the arm's pattern binds, not rebound inside."
    match t
        Option.Some(Term.TVar(b)) -> Bool.and(List.contains(parts, b), Bool.not(List.contains(inner, b)))
        _ -> false

verify smaller
    smaller(Option.Some(Term.TVar("t")), ["t"], []) => true
    smaller(Option.Some(Term.TInt(1)), ["t"], []) => false

fn indexOf(xs: List<String>, x: String, i: Int) -> Int
    ? "Where x is in xs, from i; -1 when it is not."
    match xs
        [] -> 0 - 1
        [y, ..rest] -> match y == x
            true -> i
            false -> indexOf(rest, x, i + 1)

verify indexOf
    indexOf(["a", "b"], "b", 0) => 1
    indexOf(["a"], "c", 0) => 0 - 1

fn nthTerm(xs: List<Term>, i: Int) -> Option<Term>
    ? "The term at place i."
    match xs
        [] -> Option.None
        [x, ..rest] -> match i == 0
            true -> Option.Some(x)
            false -> nthTerm(rest, i - 1)

verify nthTerm
    nthTerm([Term.TInt(1), Term.TInt(2)], 1) => Option.Some(Term.TInt(2))
    nthTerm([], 0) => Option.None

fn refuseMutualRecursion(ds: List<Def>) -> Result<Unit, String>
    ? "No definition reaches itself through another definition of the script."
    match ds
        [] -> Result.Ok(Unit)
        _ -> eachNotMutual(ds, ds)

verify refuseMutualRecursion
    refuseMutualRecursion([Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TCall("g", [])), Def(name = "g", returnsBool = false, params = [], lets = [], body = Term.TCall("f", []))]) => Result.Err("f is part of a mutual recursion")
    refuseMutualRecursion([Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TCall("f", [])), Def(name = "g", returnsBool = false, params = [], lets = [], body = Term.TCall("f", []))]) => Result.Ok(Unit)

fn eachNotMutual(todo: List<Def>, ds: List<Def>) -> Result<Unit, String>
    ? "Check each definition in turn."
    match todo
        [] -> Result.Ok(Unit)
        [d, ..rest] -> match reaches(callees(d, ds), d.name, ds, [], List.len(ds))
            true -> Result.Err("{d.name} is part of a mutual recursion")
            false -> eachNotMutual(rest, ds)

verify eachNotMutual
    eachNotMutual([], []) => Result.Ok(Unit)

fn reaches(frontier: List<String>, target: String, ds: List<Def>, seen: List<String>, fuel: Int) -> Bool
    ? "Whether target is among the definitions reachable from the frontier; fuel is the number of definitions, enough for any path that does not repeat."
    match (frontier, fuel > 0)
        ([], _) -> false
        (_, false) -> false
        ([g, ..rest], true) -> match g == target
            true -> true
            false -> match List.contains(seen, g)
                true -> reaches(rest, target, ds, seen, fuel)
                false -> reaches(List.concat(rest, calleesOf(g, ds, ds)), target, ds, List.prepend(g, seen), fuel - 1)

verify reaches
    reaches([], "f", [], [], 1) => false

fn calleesOf(name: String, todo: List<Def>, ds: List<Def>) -> List<String>
    ? "The definitions of ds that the one named name calls."
    match todo
        [] -> []
        [d, ..rest] -> match d.name == name
            true -> callees(d, ds)
            false -> calleesOf(name, rest, ds)

verify calleesOf
    calleesOf("f", [], []) => []
    calleesOf("g", [Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), Def(name = "g", returnsBool = false, params = [], lets = [], body = Term.TCall("f", []))], [Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), Def(name = "g", returnsBool = false, params = [], lets = [], body = Term.TCall("f", []))]) => ["f"]

fn callees(d: Def, ds: List<Def>) -> List<String>
    ? "The other definitions of the script d calls."
    onlyDefs(List.concat(namesCalled(d.body), letNames(d.lets)), ds, d.name)

verify callees
    callees(Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TCall("f", [])), []) => []

fn letNames(ls: List<Binding>) -> List<String>
    ? "Functions the local bindings call."
    match ls
        [] -> []
        [b, ..rest] -> List.concat(namesCalled(b.value), letNames(rest))

verify letNames
    letNames([]) => []

fn onlyDefs(ns: List<String>, ds: List<Def>, own: String) -> List<String>
    ? "The names that are other definitions of the script."
    match ns
        [] -> []
        [n, ..rest] -> match Bool.and(n != own, isDef(n, ds))
            true -> List.prepend(n, onlyDefs(rest, ds, own))
            false -> onlyDefs(rest, ds, own)

verify onlyDefs
    onlyDefs(["g"], [], "f") => []

fn isDef(n: String, ds: List<Def>) -> Bool
    ? "Whether the script defines n."
    match ds
        [] -> false
        [d, ..rest] -> Bool.or(d.name == n, isDef(n, rest))

verify isDef
    isDef("f", []) => false

fn namesCalled(t: Term) -> List<String>
    ? "Every function a term calls."
    match t
        Term.TCall(g, xs) -> List.prepend(g, namesAll(xs))
        Term.TMatch(s, arms) -> List.concat(namesCalled(s), namesArms(arms))
        Term.TGet(o, n) -> namesCalled(o)
        Term.TBi(n, xs) -> namesAll(xs)
        Term.TOp(o, a, b) -> List.concat(namesCalled(a), namesCalled(b))
        Term.TNeg(a) -> namesCalled(a)
        Term.TCtor(c, xs) -> namesAll(xs)
        Term.TParts(xs) -> namesAll(xs)
        Term.TList(xs) -> namesAll(xs)
        Term.TTuple(xs) -> namesAll(xs)
        Term.TRec(n, fs) -> namesFields(fs)
        Term.TUpd(n, b, fs) -> List.concat(namesCalled(b), namesFields(fs))
        _ -> []

verify namesCalled
    namesCalled(Term.TOp("+", Term.TCall("g", []), Term.TCall("h", []))) => ["g", "h"]

fn namesAll(xs: List<Term>) -> List<String>
    ? "Functions several terms call."
    match xs
        [] -> []
        [x, ..rest] -> List.concat(namesCalled(x), namesAll(rest))

verify namesAll
    namesAll([]) => []

fn namesFields(fs: List<Field>) -> List<String>
    ? "Functions record fields call."
    match fs
        [] -> []
        [x, ..rest] -> List.concat(namesCalled(x.value), namesFields(rest))

verify namesFields
    namesFields([]) => []

fn namesArms(arms: List<Arm>) -> List<String>
    ? "Functions match arms call."
    match arms
        [] -> []
        [a, ..rest] -> List.concat(namesCalled(a.body), namesArms(rest))

verify namesArms
    namesArms([]) => []

fn varied(xs: List<Term>, j: Int, givens: List<String>) -> Result<Varied, String>
    ? "The given at the matched place, and the other givens among the arguments that vary with it, each at the first place it appears."
    match nthTerm(xs, j)
        Option.Some(Term.TVar(v)) -> match List.contains(givens, v)
            true -> Result.Ok(Varied(v = v, general = generalised(xs, 0, j, v, givens, [])))
            false -> Result.Err("the argument at the matched place must be a given")
        _ -> Result.Err("the argument at the matched place must be a given")

verify varied
    varied([Term.TVar("xs"), Term.TVar("acc")], 0, ["xs", "acc"]) => Result.Ok(Varied(v = "xs", general = [Place(at = 1, name = "acc")]))
    varied([Term.TVar("xs"), Term.TInt(0)], 0, ["xs"]) => Result.Ok(Varied(v = "xs", general = []))
    varied([Term.TInt(0)], 0, []) => Result.Err("the argument at the matched place must be a given")

fn generalised(xs: List<Term>, k: Int, j: Int, v: String, givens: List<String>, seen: List<String>) -> List<Place>
    ? "Places other than j holding a given other than v not seen before."
    match xs
        [] -> []
        [Term.TVar(n), ..rest] -> match Bool.and(Bool.and(k != j, n != v), Bool.and(List.contains(givens, n), Bool.not(List.contains(seen, n))))
            true -> List.prepend(Place(at = k, name = n), generalised(rest, k + 1, j, v, givens, List.prepend(n, seen)))
            false -> generalised(rest, k + 1, j, v, givens, seen)
        [x, ..rest] -> generalised(rest, k + 1, j, v, givens, seen)

verify generalised
    generalised([Term.TVar("a"), Term.TVar("a")], 0, 2, "v", ["a"], []) => [Place(at = 0, name = "a")]
