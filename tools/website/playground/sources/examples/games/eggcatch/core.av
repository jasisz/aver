module Core
    intent =
        "Egg Catch — deterministic pure engine of a four-position catching game"
        "in the manner of a pocket game with a fixed-segment display. Four hens"
        "sit on perches, two on the left and two on the right, one above the"
        "other. Each lays eggs onto a chute that slopes towards the middle,"
        "where a robot holds a basket at the end of one chute at a time. An egg"
        "that rolls off a chute with no basket under it breaks on the ground;"
        "three broken eggs end the run. The eggs roll faster the more of them"
        "are caught, and the hard mode starts where the easy one is already quick."
        "Everything here is a pure function of state: no effects, no clock, no"
        "I/O. `step` is the one transition and `replay` folds it over a seed and"
        "an input list. How a state looks is the View module's business."
        "The title screen, the pause and the end of a run are state variants,"
        "never a flag, an exception or null."
        "Boundary: the shell (main.av) owns the only effects — key polling,"
        "painting, and the frame clock. This module owns none."
    depends []
    effects []

decision EndOfGameIsAVariant
    date = "2026-07-06"
    author = "szymon"
    reason =
        "Losing the last life ends the run. Modelling that as a GameState.Over"
        "variant keeps step total and closed: no sentinel score, no null, no"
        "exception. Over absorbs every input except the ones that start the"
        "next run, so the fold in replay is total and a session of several runs"
        "is still one input list."
    chosen = "SumTypeGameState"
    rejected = ["NullableBoard", "GameOverException"]
    impacts = [step, replay]

decision CatchIsDecidedByPositionAlone
    date = "2026-11-24"
    author = "szymon"
    reason =
        "The basket has four places and an egg leaves one of four chutes."
        "Whether it is caught is the equality of two values of one sum type at"
        "the tick the egg reaches the end of its chute. A key press moves the"
        "basket at once, so the controls answer in the frame they are pressed,"
        "and the rule is a one-line function with a law, not a collision test."
        "The mistakes left to make are the player's: being at the wrong chute."
    chosen = "ChuteEquality"
    rejected = ["PixelOverlap", "BasketTravelTime"]
    impacts = [under, land]

decision TimeIsAnInput
    date = "2026-11-24"
    author = "szymon"
    reason =
        "Keys and the frame clock reach the engine the same way, as Input"
        "values: a move places the basket without advancing the world, Tick"
        "advances it by one frame. The shell can poll several keys inside one"
        "frame and the run is still a single list, so replay needs no"
        "timestamps. The seed of a run is mixed with the ticks spent on the"
        "title screen, which makes runs differ without a randomness effect."
    chosen = "TickAsInput"
    rejected = ["StepTakesElapsedMs", "KeysAppliedOutsideTheFold"]
    impacts = [step, stepAll, startSeed]

decision OneSpeedForAllEggs
    date = "2026-11-24"
    author = "szymon"
    reason =
        "Every egg on the board rolls at the speed of the current level, so"
        "eggs reach the ends of their chutes in the order they were laid and"
        "never closer together than the pause between two layings. The basket"
        "moves in no time, so every egg can be caught at every level: the game"
        "gets hard by leaving less time to see where the next one lands, never"
        "by asking for two places at once."
    chosen = "SharedSpeedOrderedLandings"
    rejected = ["SpeedPerEgg", "SpeedPerChute"]
    impacts = [speed, interval, sweep]

type Chute
    LeftUp
    LeftDown
    RightUp
    RightDown

type Mode
    Easy
    Hard

type Input
    Go(Chute)
    Left
    Right
    Up
    Down
    Start(Mode)
    Action
    Pause
    Tick

record Egg
    chute: Chute
    roll: Int

record Lobby
    seed: Int
    tick: Int
    best: Int
    mode: Mode

record Board
    eggs: List<Egg>
    at: Chute
    mode: Mode
    score: Int
    lives: Int
    streak: Int
    bestStreak: Int
    best: Int
    seed: Int
    tick: Int
    cooldown: Int
    nextChute: Chute
    flash: Int
    splat: Int
    splatChute: Chute
    spawned: Int
    caught: Int
    missed: Int

type GameState
    Title(Lobby)
    Playing(Board)
    Paused(Board)
    Over(Board)

fn lip() -> Int
    ? "How far an egg rolls before it leaves its chute: 18 Braille dots, in"
      "thirty-seconds of a dot."
    576

verify lip
    lip() => 576

fn frameMs() -> Int
    ? "Length of one Tick in milliseconds. The shell's clock reads it; the"
      "engine itself never measures time."
    40

verify frameMs
    frameMs() => 40

fn chuteIndex(c: Chute) -> Int
    ? "A chute as a number: LeftUp=0, LeftDown=1, RightUp=2, RightDown=3."
    match c
        Chute.LeftUp -> 0
        Chute.LeftDown -> 1
        Chute.RightUp -> 2
        Chute.RightDown -> 3

verify chuteIndex
    chuteIndex(Chute.LeftUp) => 0
    chuteIndex(Chute.LeftDown) => 1
    chuteIndex(Chute.RightUp) => 2
    chuteIndex(Chute.RightDown) => 3

verify chuteIndex law inRange
    given c: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    Bool.and(chuteIndex(c) >= 0, chuteIndex(c) <= 3) => true

fn chuteOf(i: Int) -> Chute
    ? "The chute with a number; anything past 2 is RightDown."
    match i
        0 -> Chute.LeftUp
        1 -> Chute.LeftDown
        2 -> Chute.RightUp
        _ -> Chute.RightDown

verify chuteOf
    chuteOf(0) => Chute.LeftUp
    chuteOf(1) => Chute.LeftDown
    chuteOf(2) => Chute.RightUp
    chuteOf(3) => Chute.RightDown

verify chuteOf law undoesIndex
    given c: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    chuteOf(chuteIndex(c)) => c

fn isLeft(c: Chute) -> Bool
    ? "Whether a chute is on the left side."
    match c
        Chute.LeftUp -> true
        Chute.LeftDown -> true
        Chute.RightUp -> false
        Chute.RightDown -> false

verify isLeft
    isLeft(Chute.LeftUp) => true
    isLeft(Chute.LeftDown) => true
    isLeft(Chute.RightUp) => false
    isLeft(Chute.RightDown) => false

fn isUpper(c: Chute) -> Bool
    ? "Whether a chute is one of the two upper ones."
    match c
        Chute.LeftUp -> true
        Chute.LeftDown -> false
        Chute.RightUp -> true
        Chute.RightDown -> false

verify isUpper
    isUpper(Chute.LeftUp) => true
    isUpper(Chute.LeftDown) => false
    isUpper(Chute.RightUp) => true
    isUpper(Chute.RightDown) => false

fn onLeft(upper: Bool) -> Chute
    ? "The left chute at a height."
    match upper
        true -> Chute.LeftUp
        false -> Chute.LeftDown

verify onLeft
    onLeft(true) => Chute.LeftUp
    onLeft(false) => Chute.LeftDown

fn onRight(upper: Bool) -> Chute
    ? "The right chute at a height."
    match upper
        true -> Chute.RightUp
        false -> Chute.RightDown

verify onRight
    onRight(true) => Chute.RightUp
    onRight(false) => Chute.RightDown

fn place(left: Bool, upper: Bool) -> Chute
    ? "The chute on a side at a height."
    match left
        true -> onLeft(upper)
        false -> onRight(upper)

verify place
    place(true, true) => Chute.LeftUp
    place(true, false) => Chute.LeftDown
    place(false, true) => Chute.RightUp
    place(false, false) => Chute.RightDown

verify place law rebuildsChute
    given c: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    place(isLeft(c), isUpper(c)) => c

fn lcg(seed: Int) -> Int
    ? "One linear-congruential step (glibc constants) mod 2^31. Int is ℤ, so no"
      "overflow: the modulo is explicit and keeps the state in [0, 2147483648)."
    Int.mod(1103515245 * seed + 12345, 2147483648)

verify lcg
    lcg(0) => 12345
    lcg(1) => 1103527590

fn pickChute(seed: Int) -> Chute
    ? "The chute a seed picks, read from its high bits, which are the"
      "well-mixed ones in a linear-congruential state."
    chuteOf(Int.mod(Int.div(seed, 65536), 4))

verify pickChute
    pickChute(0) => Chute.LeftUp
    pickChute(65536) => Chute.LeftDown
    pickChute(65536 * 2) => Chute.RightUp
    pickChute(65536 * 7) => Chute.RightDown

fn level(caught: Int) -> Int
    ? "Difficulty level, 0 to 14: one level for every six eggs caught."
    Int.min(14, Int.max(0, Int.div(caught, 6)))

verify level
    level(0) => 0
    level(5) => 0
    level(6) => 1
    level(1000) => 14

verify level law inRange
    given caught: Int = [0, 1, 6, 50, 84, 1000]
    Bool.and(level(caught) >= 0, level(caught) <= 14) => true

fn startSpeed(mode: Mode) -> Int
    ? "How far an egg rolls in one tick on the first level of a mode, in"
      "thirty-seconds of a dot. The hard mode starts half as fast again."
    match mode
        Mode.Easy -> 6
        Mode.Hard -> 9

verify startSpeed
    startSpeed(Mode.Easy) => 6
    startSpeed(Mode.Hard) => 9

fn speed(mode: Mode, lv: Int) -> Int
    ? "How far an egg rolls in one tick at a level: the mode's start speed and"
      "one more for every level. On the easy mode a chute takes just under"
      "four seconds at first and a little over one at the top level."
    startSpeed(mode) + lv

verify speed
    speed(Mode.Easy, 0) => 6
    speed(Mode.Easy, 14) => 20
    speed(Mode.Hard, 0) => 9
    speed(Mode.Hard, 14) => 23

verify speed law alwaysRolls
    given mode: Mode = [Mode.Easy, Mode.Hard]
    given lv: Int = [0, 1, 5, 14]
    when lv >= 0
    speed(mode, lv) > 0 => true

verify speed law hardIsFaster
    given lv: Int = [0, 1, 5, 14]
    speed(Mode.Hard, lv) > speed(Mode.Easy, lv) => true

fn startInterval(mode: Mode) -> Int
    ? "Ticks between two eggs on the first level of a mode."
    match mode
        Mode.Easy -> 36
        Mode.Hard -> 30

verify startInterval
    startInterval(Mode.Easy) => 36
    startInterval(Mode.Hard) => 30

fn shortest(mode: Mode) -> Int
    ? "The fewest ticks between two eggs a mode ever comes down to: about"
      "half a second on the easy mode, less on the hard one."
    match mode
        Mode.Easy -> 13
        Mode.Hard -> 10

verify shortest
    shortest(Mode.Easy) => 13
    shortest(Mode.Hard) => 10

fn interval(mode: Mode, lv: Int) -> Int
    ? "Ticks between two eggs at a level, before the jitter: two fewer for"
      "every level, down to the mode's shortest. Ten ticks at the top speed"
      "still leave more than an egg's width between two eggs on one chute."
    Int.max(shortest(mode), startInterval(mode) - 2 * lv)

verify interval
    interval(Mode.Easy, 0) => 36
    interval(Mode.Easy, 5) => 26
    interval(Mode.Easy, 14) => 13
    interval(Mode.Hard, 0) => 30
    interval(Mode.Hard, 14) => 10

verify interval law keepsApart
    given mode: Mode = [Mode.Easy, Mode.Hard]
    given lv: Int = [0, 1, 5, 14, 40]
    interval(mode, lv) >= 10 => true

fn jitter(seed: Int) -> Int
    ? "Zero to five extra ticks before the next egg, so the rhythm is not a"
      "metronome."
    Int.mod(Int.div(seed, 4096), 6)

verify jitter
    jitter(0) => 0
    jitter(4096 * 8) => 2

fn worth(mode: Mode) -> Int
    ? "Points for one egg: one on the easy mode, two on the hard one."
    match mode
        Mode.Easy -> 1
        Mode.Hard -> 2

verify worth
    worth(Mode.Easy) => 1
    worth(Mode.Hard) => 2

verify worth law alwaysPays
    given mode: Mode = [Mode.Easy, Mode.Hard]
    worth(mode) > 0 => true

fn capScore(x: Int) -> Int
    ? "Clamp a score into the six digits the frame shows."
    Int.min(999999, Int.max(0, x))

verify capScore
    capScore(-5) => 0
    capScore(500) => 500
    capScore(1200000) => 999999

verify capScore law inRange
    given x: Int = [-5, 0, 1, 500, 999999, 1000000, 5000000]
    Bool.and(capScore(x) >= 0, capScore(x) <= 999999) => true

fn earn(score: Int, points: Int) -> Int
    ? "Score after a catch worth `points`. Points are only ever added, so a"
      "score inside the six-digit window never goes down."
    capScore(score + points)

verify earn
    earn(10, 1) => 11
    earn(10, 2) => 12
    earn(999999, 2) => 999999

verify earn law neverDrops
    given score: Int = [0, 1, 198, 500, 999999]
    given points: Int = [0, 1, 2]
    when Bool.and(points >= 0, Bool.and(score >= 0, score <= 999999))
    earn(score, points) >= score => true

fn loseLife(lives: Int) -> Int
    ? "Lives after a broken egg: one fewer, never below zero."
    Int.max(0, lives - 1)

verify loseLife
    loseLife(3) => 2
    loseLife(1) => 0
    loseLife(0) => 0

verify loseLife law neverNegative
    given lives: Int = [0, 1, 2, 3]
    loseLife(lives) >= 0 => true

fn mend(lives: Int, streak: Int) -> Int
    ? "Lives after a catch: every fifteenth catch in a row gives one back, up"
      "to the three a run starts with."
    match Int.mod(streak, 15) == 0
        true -> Int.min(3, lives + 1)
        false -> lives

verify mend
    mend(1, 15) => 2
    mend(3, 15) => 3
    mend(1, 14) => 1
    mend(2, 30) => 3

verify mend law neverTakes
    given lives: Int = [1, 2, 3]
    given streak: Int = [1, 14, 15, 16, 30]
    when lives <= 3
    mend(lives, streak) >= lives => true

fn under(basket: Chute, chute: Chute) -> Bool
    ? "Whether the basket is at the end of a chute: the two are the same."
    chuteIndex(basket) == chuteIndex(chute)

verify under
    under(Chute.LeftUp, Chute.LeftUp) => true
    under(Chute.LeftUp, Chute.RightDown) => false

verify under law basketAtItsOwnChute
    given c: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    under(c, c) => true

fn startBoard(seed: Int, mode: Mode, best: Int) -> Board
    ? "Fresh run: no eggs on the chutes, the basket at the upper left, three"
      "lives, and the first hen already chosen so she can be seen getting"
      "ready. The three ledger totals (spawned, caught, missed) start at zero;"
      "together with the eggs on the chutes they state conservation."
    Board(eggs = [], at = Chute.LeftUp, mode = mode, score = 0, lives = 3, streak = 0, bestStreak = 0, best = best, seed = lcg(seed), tick = 0, cooldown = 25, nextChute = pickChute(lcg(seed)), flash = 0, splat = 0, splatChute = Chute.LeftUp, spawned = 0, caught = 0, missed = 0)

verify startBoard
    startBoard(7, Mode.Easy, 0).lives => 3
    startBoard(7, Mode.Hard, 120).best => 120
    startBoard(7, Mode.Hard, 0).mode => Mode.Hard
    startBoard(7, Mode.Easy, 0).eggs => []

verify startBoard law conserves
    given seed: Int = [0, 1, 7, 42, 100]
    given mode: Mode = [Mode.Easy, Mode.Hard]
    conservationDelta(startBoard(seed, mode, 0)) => 0

fn conservationDelta(b: Board) -> Int
    ? "The bookkeeping residual: eggs laid minus the eggs still on the chutes"
      "and the ones caught and missed. Zero exactly when every egg is"
      "accounted for once."
    b.spawned - List.len(b.eggs) - b.caught - b.missed

verify conservationDelta
    conservationDelta(startBoard(7, Mode.Easy, 0)) => 0
    conservationDelta(Board.update(startBoard(7, Mode.Easy, 0), spawned = 3, caught = 1, missed = 1, eggs = [Egg(chute = Chute.RightUp, roll = 40)])) => 0
    conservationDelta(Board.update(startBoard(7, Mode.Easy, 0), spawned = 5, caught = 2, missed = 1)) => 2

fn stateDelta(gs: GameState) -> Int
    ? "The conservation residual of a state: its board's, or zero on the"
      "title screen, where no egg has been laid yet."
    match gs
        GameState.Title(_) -> 0
        GameState.Playing(b) -> conservationDelta(b)
        GameState.Paused(b) -> conservationDelta(b)
        GameState.Over(b) -> conservationDelta(b)

verify stateDelta
    stateDelta(lobby(7)) => 0
    stateDelta(GameState.Playing(startBoard(7, Mode.Easy, 0))) => 0
    stateDelta(GameState.Over(Board.update(startBoard(7, Mode.Easy, 0), spawned = 2, caught = 2))) => 0
    stateDelta(GameState.Paused(Board.update(startBoard(7, Mode.Easy, 0), spawned = 2, caught = 1))) => 1

fn hasLeft(roll: Int) -> Bool
    ? "Whether an egg that has rolled this far has left its chute."
    roll >= lip()

verify hasLeft
    hasLeft(575) => false
    hasLeft(576) => true

fn catchEgg(b: Board) -> Board
    ? "An egg drops into the basket: the streak grows, the score rises by"
      "the mode's worth, a fifteenth catch in a row mends a life, and the"
      "basket shows the egg for a few ticks."
    streak = b.streak + 1
    Board.update(b, score = earn(b.score, worth(b.mode)), streak = streak, bestStreak = Int.max(b.bestStreak, streak), lives = mend(b.lives, streak), caught = b.caught + 1, flash = 6)

verify catchEgg
    catchEgg(startBoard(7, Mode.Easy, 0)).score => 1
    catchEgg(startBoard(7, Mode.Hard, 0)).score => 2
    catchEgg(Board.update(startBoard(7, Mode.Easy, 0), streak = 14, lives = 1)).lives => 2
    catchEgg(startBoard(7, Mode.Easy, 0)).caught => 1
    catchEgg(Board.update(startBoard(7, Mode.Easy, 0), streak = 3, bestStreak = 3)).bestStreak => 4

verify catchEgg law settlesOneEgg
    given seed: Int = [0, 7, 42]
    given mode: Mode = [Mode.Easy, Mode.Hard]
    conservationDelta(catchEgg(startBoard(seed, mode, 0))) => -1

fn missEgg(b: Board, chute: Chute) -> Board
    ? "An egg rolls off a chute with no basket under it and breaks: a life is"
      "lost, the streak ends, and the ground under that chute shows it."
    Board.update(b, lives = loseLife(b.lives), streak = 0, missed = b.missed + 1, splat = 12, splatChute = chute)

verify missEgg
    missEgg(startBoard(7, Mode.Easy, 0), Chute.RightUp).lives => 2
    missEgg(Board.update(startBoard(7, Mode.Easy, 0), streak = 9), Chute.RightUp).streak => 0
    missEgg(startBoard(7, Mode.Easy, 0), Chute.RightUp).splatChute => Chute.RightUp

verify missEgg law settlesOneEgg
    given chute: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    conservationDelta(missEgg(startBoard(7, Mode.Easy, 0), chute)) => -1

fn land(b: Board, chute: Chute) -> Board
    ? "Resolve one egg that has left a chute: caught when the basket is at"
      "that chute, broken otherwise. Nothing else is asked."
    match under(b.at, chute)
        true -> catchEgg(b)
        false -> missEgg(b, chute)

verify land
    land(startBoard(7, Mode.Easy, 0), Chute.LeftUp).score => 1
    land(startBoard(7, Mode.Easy, 0), Chute.LeftUp).lives => 3
    land(startBoard(7, Mode.Easy, 0), Chute.RightDown).score => 0
    land(startBoard(7, Mode.Easy, 0), Chute.RightDown).lives => 2

verify land law settlesOneEgg
    given seed: Int = [0, 7, 42]
    given chute: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    conservationDelta(land(startBoard(seed, Mode.Easy, 0), chute)) => -1

verify land law noFalseMiss
    given chute: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    land(Board.update(startBoard(7, Mode.Easy, 0), at = chute), chute).lives => 3

fn sweep(b: Board, eggs: List<Egg>, by: Int, rolling: List<Egg>) -> Board
    ? "Walk the eggs oldest first and let each roll `by` thirty-seconds of a"
      "dot: one that has left its chute is resolved onto the board, the"
      "others stay on their chutes in their order."
    match eggs
        [] -> Board.update(b, eggs = List.reverse(rolling))
        [e, ..rest] -> sweepEgg(b, Egg.update(e, roll = e.roll + by), rest, by, rolling)

verify sweep
    sweep(startBoard(7, Mode.Easy, 0), [], 6, []).eggs => []
    sweep(startBoard(7, Mode.Easy, 0), [Egg(chute = Chute.LeftUp, roll = 572), Egg(chute = Chute.RightUp, roll = 80)], 6, []).eggs => [Egg(chute = Chute.RightUp, roll = 86)]
    sweep(startBoard(7, Mode.Easy, 0), [Egg(chute = Chute.LeftUp, roll = 572), Egg(chute = Chute.RightUp, roll = 80)], 6, []).score => 1
    sweep(startBoard(7, Mode.Easy, 0), [Egg(chute = Chute.LeftDown, roll = 10), Egg(chute = Chute.RightUp, roll = 0)], 20, []).eggs => [Egg(chute = Chute.LeftDown, roll = 30), Egg(chute = Chute.RightUp, roll = 20)]

verify sweep law conserves
    given b: Board = [startBoard(7, Mode.Easy, 0), Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 572)]), Board.update(startBoard(7, Mode.Hard, 0), spawned = 2, eggs = [Egg(chute = Chute.RightDown, roll = 574), Egg(chute = Chute.LeftUp, roll = 90)])]
    given by: Int = [6, 23]
    conservationDelta(sweep(b, b.eggs, by, [])) => conservationDelta(b)

fn sweepEgg(b: Board, e: Egg, rest: List<Egg>, by: Int, rolling: List<Egg>) -> Board
    ? "One egg of the walk, already moved: resolve it if it has left its"
      "chute, keep it rolling if not, and go on with the rest."
    match hasLeft(e.roll)
        true -> sweep(land(b, e.chute), rest, by, rolling)
        false -> sweep(b, rest, by, List.prepend(e, rolling))

verify sweepEgg
    sweepEgg(startBoard(7, Mode.Easy, 0), Egg(chute = Chute.LeftUp, roll = 576), [], 6, []).score => 1
    sweepEgg(startBoard(7, Mode.Easy, 0), Egg(chute = Chute.LeftUp, roll = 100), [], 6, []).eggs => [Egg(chute = Chute.LeftUp, roll = 100)]

fn settle(b: Board) -> Board
    ? "Let every egg roll one tick at the board's mode and level and resolve"
      "the ones that left their chutes."
    sweep(b, b.eggs, speed(b.mode, level(b.caught)), [])

verify settle
    settle(startBoard(7, Mode.Easy, 0)).eggs => []
    settle(Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.RightUp, roll = 100)])).eggs => [Egg(chute = Chute.RightUp, roll = 106)]
    settle(Board.update(startBoard(7, Mode.Hard, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 570)])).score => 2

verify settle law conserves
    given b: Board = [startBoard(7, Mode.Easy, 0), Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 572)]), Board.update(startBoard(7, Mode.Hard, 0), spawned = 2, eggs = [Egg(chute = Chute.RightDown, roll = 574), Egg(chute = Chute.LeftUp, roll = 90)]), Board.update(startBoard(4, Mode.Easy, 0), spawned = 3, caught = 1, eggs = [Egg(chute = Chute.LeftDown, roll = 575), Egg(chute = Chute.RightUp, roll = 571)])]
    when conservationDelta(b) == 0
    conservationDelta(settle(b)) => 0

fn hatch(b: Board) -> Board
    ? "The hen that was getting ready lays her egg at the top of her chute,"
      "and the next hen is chosen: the seed advances once, and gives both the"
      "next chute and the jitter of the pause before it."
    seed = lcg(b.seed)
    Board.update(b, eggs = List.concat(b.eggs, [Egg(chute = b.nextChute, roll = 0)]), spawned = b.spawned + 1, nextChute = pickChute(seed), cooldown = interval(b.mode, level(b.caught)) + jitter(seed), seed = seed)

verify hatch
    hatch(startBoard(7, Mode.Easy, 0)).eggs => [Egg(chute = startBoard(7, Mode.Easy, 0).nextChute, roll = 0)]
    hatch(startBoard(7, Mode.Easy, 0)).spawned => 1
    hatch(startBoard(7, Mode.Easy, 0)).cooldown >= 36 => true

verify hatch law conserves
    given b: Board = [startBoard(7, Mode.Easy, 0), startBoard(42, Mode.Hard, 0), Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 572)])]
    when conservationDelta(b) == 0
    conservationDelta(hatch(b)) => 0

fn spawn(b: Board) -> Board
    ? "Count the pause down by one tick; when it runs out, the hen lays."
    match b.cooldown <= 1
        true -> hatch(b)
        false -> Board.update(b, cooldown = b.cooldown - 1)

verify spawn
    spawn(startBoard(7, Mode.Easy, 0)).cooldown => 24
    spawn(startBoard(7, Mode.Easy, 0)).eggs => []
    spawn(Board.update(startBoard(7, Mode.Easy, 0), cooldown = 1)).spawned => 1

fn fade(ttl: Int) -> Int
    ? "A countdown one tick later, stopping at zero."
    Int.max(0, ttl - 1)

verify fade
    fade(6) => 5
    fade(0) => 0

fn animate(b: Board) -> Board
    ? "Advance what is only paint: the egg shown in the basket, the broken"
      "egg on the ground, and the tick counter."
    Board.update(b, flash = fade(b.flash), splat = fade(b.splat), tick = b.tick + 1)

verify animate
    animate(startBoard(7, Mode.Easy, 0)).tick => 1
    animate(Board.update(startBoard(7, Mode.Easy, 0), flash = 6)).flash => 5
    animate(Board.update(startBoard(7, Mode.Easy, 0), splat = 1)).splat => 0

fn endOrPlay(b: Board) -> GameState
    ? "No lives left ends the run (Over); otherwise the board keeps Playing."
    match b.lives <= 0
        true -> GameState.Over(b)
        false -> GameState.Playing(b)

verify endOrPlay
    endOrPlay(startBoard(7, Mode.Easy, 0)) => GameState.Playing(startBoard(7, Mode.Easy, 0))
    endOrPlay(Board.update(startBoard(7, Mode.Easy, 0), lives = 0)) => GameState.Over(Board.update(startBoard(7, Mode.Easy, 0), lives = 0))

fn tickBoard(b: Board) -> GameState
    ? "Advance the world one tick: fade the paint, let the eggs roll and"
      "land, let the hen lay when the pause is over, and end the run on the"
      "last life."
    endOrPlay(spawn(settle(animate(b))))

verify tickBoard
    tickBoard(startBoard(7, Mode.Easy, 0)) => GameState.Playing(spawn(settle(animate(startBoard(7, Mode.Easy, 0)))))
    tickBoard(Board.update(startBoard(7, Mode.Easy, 0), lives = 0)) => GameState.Over(spawn(settle(animate(Board.update(startBoard(7, Mode.Easy, 0), lives = 0)))))
    isOver(tickBoard(Board.update(startBoard(7, Mode.Easy, 0), lives = 1, spawned = 1, eggs = [Egg(chute = Chute.RightDown, roll = 575)]))) => true
    isOver(tickBoard(Board.update(startBoard(7, Mode.Easy, 0), lives = 1, spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 575)]))) => false

verify tickBoard law conserves
    given b: Board = [startBoard(7, Mode.Easy, 0), Board.update(startBoard(7, Mode.Easy, 0), cooldown = 1), Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 572)]), Board.update(startBoard(4, Mode.Hard, 0), spawned = 3, caught = 1, lives = 1, eggs = [Egg(chute = Chute.LeftDown, roll = 575), Egg(chute = Chute.RightUp, roll = 571)])]
    when conservationDelta(b) == 0
    stateDelta(tickBoard(b)) => 0

fn lobby(seed: Int) -> GameState
    ? "The title screen a session starts on: the easy mode, no best score yet."
    GameState.Title(Lobby(seed = seed, tick = 0, best = 0, mode = Mode.Easy))

verify lobby
    lobby(7) => GameState.Title(Lobby(seed = 7, tick = 0, best = 0, mode = Mode.Easy))

fn startSeed(l: Lobby) -> Int
    ? "Seed of the run started from a title screen: the session seed mixed"
      "with how many ticks the player waited there."
    l.seed + 7919 * l.tick

verify startSeed
    startSeed(Lobby(seed = 7, tick = 0, best = 0, mode = Mode.Easy)) => 7
    startSeed(Lobby(seed = 7, tick = 2, best = 0, mode = Mode.Easy)) => 15845

fn bestOf(b: Board) -> Int
    ? "Best score of the session once this board's run is counted in."
    Int.max(b.best, b.score)

verify bestOf
    bestOf(Board.update(startBoard(7, Mode.Easy, 40), score = 12)) => 40
    bestOf(Board.update(startBoard(7, Mode.Easy, 40), score = 90)) => 90

verify bestOf law neverBelowScore
    given best: Int = [0, 40, 999999]
    given points: Int = [0, 12, 90]
    bestOf(Board.update(startBoard(7, Mode.Easy, best), score = points)) >= points => true

fn stepTitle(l: Lobby, i: Input) -> GameState
    ? "Title screen: Start begins a run in the mode it names, Action in the"
      "mode shown, Tick counts the wait, and the basket keys do nothing yet."
    match i
        Input.Start(mode) -> GameState.Playing(startBoard(startSeed(l), mode, l.best))
        Input.Action -> GameState.Playing(startBoard(startSeed(l), l.mode, l.best))
        Input.Tick -> GameState.Title(Lobby.update(l, tick = l.tick + 1))
        _ -> GameState.Title(l)

verify stepTitle
    stepTitle(Lobby(seed = 7, tick = 0, best = 0, mode = Mode.Easy), Input.Tick) => GameState.Title(Lobby(seed = 7, tick = 1, best = 0, mode = Mode.Easy))
    stepTitle(Lobby(seed = 7, tick = 3, best = 50, mode = Mode.Easy), Input.Action) => GameState.Playing(startBoard(23764, Mode.Easy, 50))
    stepTitle(Lobby(seed = 7, tick = 3, best = 50, mode = Mode.Easy), Input.Start(Mode.Hard)) => GameState.Playing(startBoard(23764, Mode.Hard, 50))
    stepTitle(Lobby(seed = 7, tick = 3, best = 50, mode = Mode.Easy), Input.Left) => GameState.Title(Lobby(seed = 7, tick = 3, best = 50, mode = Mode.Easy))
    stepTitle(Lobby(seed = 7, tick = 3, best = 50, mode = Mode.Easy), Input.Go(Chute.RightUp)) => GameState.Title(Lobby(seed = 7, tick = 3, best = 50, mode = Mode.Easy))

fn moveBasket(at: Chute, i: Input) -> Chute
    ? "Where the basket is after a key. Go names the chute outright; Left and"
      "Right change the side and keep the height, Up and Down change the"
      "height and keep the side. The other inputs leave it where it is."
    match i
        Input.Go(c) -> c
        Input.Left -> place(true, isUpper(at))
        Input.Right -> place(false, isUpper(at))
        Input.Up -> place(isLeft(at), true)
        Input.Down -> place(isLeft(at), false)
        _ -> at

verify moveBasket
    moveBasket(Chute.LeftUp, Input.Go(Chute.RightDown)) => Chute.RightDown
    moveBasket(Chute.RightDown, Input.Left) => Chute.LeftDown
    moveBasket(Chute.LeftUp, Input.Right) => Chute.RightUp
    moveBasket(Chute.RightDown, Input.Up) => Chute.RightUp
    moveBasket(Chute.LeftUp, Input.Down) => Chute.LeftDown
    moveBasket(Chute.LeftUp, Input.Tick) => Chute.LeftUp
    moveBasket(Chute.LeftUp, Input.Pause) => Chute.LeftUp
    moveBasket(Chute.LeftUp, Input.Action) => Chute.LeftUp
    moveBasket(Chute.LeftUp, Input.Start(Mode.Hard)) => Chute.LeftUp

verify moveBasket law sideKeysKeepTheHeight
    given at: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    given i: Input = [Input.Left, Input.Right]
    isUpper(moveBasket(at, i)) => isUpper(at)

verify moveBasket law heightKeysKeepTheSide
    given at: Chute = [Chute.LeftUp, Chute.LeftDown, Chute.RightUp, Chute.RightDown]
    given i: Input = [Input.Up, Input.Down]
    isLeft(moveBasket(at, i)) => isLeft(at)

fn stepPlaying(b: Board, i: Input) -> GameState
    ? "A run in progress: Tick advances the world, Pause freezes it, and"
      "every other input is a basket key that takes effect at once and leaves"
      "the world where it is."
    match i
        Input.Tick -> tickBoard(b)
        Input.Pause -> GameState.Paused(b)
        _ -> GameState.Playing(Board.update(b, at = moveBasket(b.at, i)))

verify stepPlaying
    stepPlaying(startBoard(7, Mode.Easy, 0), Input.Tick) => tickBoard(startBoard(7, Mode.Easy, 0))
    stepPlaying(startBoard(7, Mode.Easy, 0), Input.Pause) => GameState.Paused(startBoard(7, Mode.Easy, 0))
    stepPlaying(startBoard(7, Mode.Easy, 0), Input.Go(Chute.RightDown)) => GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), at = Chute.RightDown))
    stepPlaying(startBoard(7, Mode.Easy, 0), Input.Right) => GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), at = Chute.RightUp))
    stepPlaying(startBoard(7, Mode.Easy, 0), Input.Action) => GameState.Playing(startBoard(7, Mode.Easy, 0))
    stepPlaying(Board.update(startBoard(7, Mode.Easy, 0), lives = 0), Input.Tick) => GameState.Over(spawn(settle(animate(Board.update(startBoard(7, Mode.Easy, 0), lives = 0)))))

fn stepPaused(b: Board, i: Input) -> GameState
    ? "A frozen run: Pause or Action resumes it, nothing else gets through —"
      "not even the clock."
    match i
        Input.Pause -> GameState.Playing(b)
        Input.Action -> GameState.Playing(b)
        _ -> GameState.Paused(b)

verify stepPaused
    stepPaused(startBoard(7, Mode.Easy, 0), Input.Pause) => GameState.Playing(startBoard(7, Mode.Easy, 0))
    stepPaused(startBoard(7, Mode.Easy, 0), Input.Action) => GameState.Playing(startBoard(7, Mode.Easy, 0))
    stepPaused(startBoard(7, Mode.Easy, 0), Input.Tick) => GameState.Paused(startBoard(7, Mode.Easy, 0))
    stepPaused(startBoard(7, Mode.Easy, 0), Input.Go(Chute.RightUp)) => GameState.Paused(startBoard(7, Mode.Easy, 0))

fn stepOver(b: Board, i: Input) -> GameState
    ? "A finished run absorbs everything except Start and Action, which"
      "begin the next run from the board's own seed — Start in the mode it"
      "names, Action in the same mode — and carry the best score over."
    match i
        Input.Start(mode) -> GameState.Playing(startBoard(b.seed, mode, bestOf(b)))
        Input.Action -> GameState.Playing(startBoard(b.seed, b.mode, bestOf(b)))
        _ -> GameState.Over(b)

verify stepOver
    stepOver(startBoard(7, Mode.Easy, 0), Input.Tick) => GameState.Over(startBoard(7, Mode.Easy, 0))
    stepOver(startBoard(7, Mode.Easy, 0), Input.Go(Chute.RightUp)) => GameState.Over(startBoard(7, Mode.Easy, 0))
    stepOver(Board.update(startBoard(7, Mode.Easy, 10), score = 55), Input.Action) => GameState.Playing(startBoard(startBoard(7, Mode.Easy, 10).seed, Mode.Easy, 55))
    stepOver(Board.update(startBoard(7, Mode.Easy, 10), score = 55), Input.Start(Mode.Hard)) => GameState.Playing(startBoard(startBoard(7, Mode.Easy, 10).seed, Mode.Hard, 55))

verify stepOver law absorbs
    given b: Board = [startBoard(7, Mode.Easy, 0), Board.update(startBoard(3, Mode.Hard, 40), lives = 0, score = 12)]
    given i: Input = [Input.Left, Input.Right, Input.Up, Input.Down, Input.Go(Chute.RightUp), Input.Pause, Input.Tick]
    stepOver(b, i) => GameState.Over(b)

fn step(gs: GameState, i: Input) -> GameState
    ? "The one pure transition. Keys and the clock both arrive as inputs, so"
      "a whole session — title, runs, pauses, restarts — is one input list."
    match gs
        GameState.Title(l) -> stepTitle(l, i)
        GameState.Playing(b) -> stepPlaying(b, i)
        GameState.Paused(b) -> stepPaused(b, i)
        GameState.Over(b) -> stepOver(b, i)

verify step
    step(lobby(7), Input.Tick) => stepTitle(Lobby(seed = 7, tick = 0, best = 0, mode = Mode.Easy), Input.Tick)
    step(lobby(7), Input.Left) => GameState.Title(Lobby(seed = 7, tick = 0, best = 0, mode = Mode.Easy))
    step(GameState.Playing(startBoard(7, Mode.Easy, 0)), Input.Go(Chute.RightUp)) => GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), at = Chute.RightUp))
    step(GameState.Paused(startBoard(7, Mode.Easy, 0)), Input.Tick) => GameState.Paused(startBoard(7, Mode.Easy, 0))
    step(GameState.Over(startBoard(7, Mode.Easy, 0)), Input.Tick) => GameState.Over(startBoard(7, Mode.Easy, 0))
    scoreOf(step(GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 575)])), Input.Tick)) => 1
    livesOf(step(GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 575)])), Input.Tick)) => 3
    livesOf(step(GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.RightDown, roll = 575)])), Input.Tick)) => 2

verify step law preserves
    given gs: GameState = [lobby(7), GameState.Playing(startBoard(7, Mode.Easy, 0)), GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), cooldown = 1)), GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 572)])), GameState.Paused(Board.update(startBoard(4, Mode.Hard, 0), spawned = 1, eggs = [Egg(chute = Chute.LeftDown, roll = 575)])), GameState.Over(Board.update(startBoard(3, Mode.Easy, 0), spawned = 2, caught = 1, missed = 1, lives = 0))]
    given i: Input = [Input.Go(Chute.RightDown), Input.Left, Input.Up, Input.Start(Mode.Hard), Input.Action, Input.Pause, Input.Tick]
    when stateDelta(gs) == 0
    stateDelta(step(gs, i)) => 0

verify step law scoreNeverDrops
    given gs: GameState = [GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), score = 40)), GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), score = 40, spawned = 1, eggs = [Egg(chute = Chute.LeftUp, roll = 572)])), GameState.Playing(Board.update(startBoard(7, Mode.Hard, 0), score = 40, spawned = 1, eggs = [Egg(chute = Chute.RightDown, roll = 572)])), GameState.Paused(Board.update(startBoard(4, Mode.Easy, 0), score = 9))]
    given i: Input = [Input.Go(Chute.RightDown), Input.Right, Input.Down, Input.Pause, Input.Tick]
    when Bool.and(scoreOf(gs) >= 0, scoreOf(gs) <= 999999)
    scoreOf(step(gs, i)) >= scoreOf(gs) => true

fn stepAll(gs: GameState, inputs: List<Input>) -> GameState
    ? "Left fold of step over an input list — the whole session as one function."
    match inputs
        [] -> gs
        [i, ..rest] -> stepAll(step(gs, i), rest)

verify stepAll
    stepAll(lobby(7), []) => lobby(7)
    stepAll(lobby(7), [Input.Tick]) => step(lobby(7), Input.Tick)

verify stepAll law leftFold
    given gs: GameState = [lobby(7), GameState.Playing(startBoard(7, Mode.Easy, 0)), GameState.Over(startBoard(3, Mode.Hard, 0))]
    given i: Input = [Input.Tick, Input.Go(Chute.RightUp), Input.Action]
    given rest: List<Input> = [[], [Input.Tick], [Input.Tick, Input.Right]]
    stepAll(gs, List.prepend(i, rest)) => stepAll(step(gs, i), rest)

fn replay(seed: Int, inputs: List<Input>) -> GameState
    ? "Replay a recorded session: fold step over the inputs from the title"
      "screen. Same seed and inputs always reproduce the same final state."
    stepAll(lobby(seed), inputs)

verify replay
    replay(7, []) => lobby(7)
    replay(7, [Input.Tick, Input.Action]) => GameState.Playing(startBoard(7926, Mode.Easy, 0))
    replay(7, [Input.Start(Mode.Hard), Input.Tick, Input.Tick]) => stepAll(lobby(7), [Input.Start(Mode.Hard), Input.Tick, Input.Tick])

fn isOver(gs: GameState) -> Bool
    ? "Whether the run has ended."
    match gs
        GameState.Over(_) -> true
        GameState.Title(_) -> false
        GameState.Playing(_) -> false
        GameState.Paused(_) -> false

verify isOver
    isOver(GameState.Playing(startBoard(7, Mode.Easy, 0))) => false
    isOver(GameState.Over(startBoard(7, Mode.Easy, 0))) => true
    isOver(lobby(7)) => false
    isOver(GameState.Paused(startBoard(7, Mode.Easy, 0))) => false

fn scoreOf(gs: GameState) -> Int
    ? "Current score; zero on the title screen."
    match gs
        GameState.Title(_) -> 0
        GameState.Playing(b) -> b.score
        GameState.Paused(b) -> b.score
        GameState.Over(b) -> b.score

verify scoreOf
    scoreOf(GameState.Over(Board.update(startBoard(7, Mode.Easy, 0), score = 42))) => 42
    scoreOf(lobby(7)) => 0
    scoreOf(GameState.Playing(Board.update(startBoard(7, Mode.Easy, 0), score = 3))) => 3
    scoreOf(GameState.Paused(Board.update(startBoard(7, Mode.Easy, 0), score = 4))) => 4

fn livesOf(gs: GameState) -> Int
    ? "Lives left; the full three on the title screen."
    match gs
        GameState.Title(_) -> 3
        GameState.Playing(b) -> b.lives
        GameState.Paused(b) -> b.lives
        GameState.Over(b) -> b.lives

verify livesOf
    livesOf(GameState.Playing(startBoard(7, Mode.Easy, 0))) => 3
    livesOf(GameState.Over(Board.update(startBoard(7, Mode.Easy, 0), lives = 0))) => 0
    livesOf(lobby(7)) => 3
    livesOf(GameState.Paused(Board.update(startBoard(7, Mode.Easy, 0), lives = 2))) => 2

fn sessionBest(gs: GameState) -> Int
    ? "Best score of the session so far, the current run included."
    match gs
        GameState.Title(l) -> l.best
        GameState.Playing(b) -> bestOf(b)
        GameState.Paused(b) -> bestOf(b)
        GameState.Over(b) -> bestOf(b)

verify sessionBest
    sessionBest(lobby(7)) => 0
    sessionBest(GameState.Over(Board.update(startBoard(7, Mode.Easy, 40), score = 90))) => 90
    sessionBest(GameState.Playing(startBoard(7, Mode.Easy, 40))) => 40
    sessionBest(GameState.Paused(Board.update(startBoard(7, Mode.Easy, 40), score = 41))) => 41

fn parseSeed(s: String) -> Int
    ? "Session seed from a command-line argument; 1 when it is not a number."
    match Int.fromString(s)
        Result.Ok(n) -> n
        Result.Err(_) -> 1

verify parseSeed
    parseSeed("42") => 42
    parseSeed("abc") => 1

fn keyToInput(key: String) -> Option<Input>
    ? "Which input a key means. Q, A, P and L put the basket at the chute in"
      "the same corner of the keyboard; the arrows change its side or its"
      "height. Space or enter is Action, 1 and 2 start the easy and the hard"
      "mode, and Z pauses (P is a basket key). Any other key means"
      "nothing."
    match key
        "q" -> Option.Some(Input.Go(Chute.LeftUp))
        "a" -> Option.Some(Input.Go(Chute.LeftDown))
        "p" -> Option.Some(Input.Go(Chute.RightUp))
        "l" -> Option.Some(Input.Go(Chute.RightDown))
        "left" -> Option.Some(Input.Left)
        "right" -> Option.Some(Input.Right)
        "up" -> Option.Some(Input.Up)
        "down" -> Option.Some(Input.Down)
        "1" -> Option.Some(Input.Start(Mode.Easy))
        "2" -> Option.Some(Input.Start(Mode.Hard))
        " " -> Option.Some(Input.Action)
        "enter" -> Option.Some(Input.Action)
        "z" -> Option.Some(Input.Pause)
        _ -> Option.None

verify keyToInput
    keyToInput("q") => Option.Some(Input.Go(Chute.LeftUp))
    keyToInput("l") => Option.Some(Input.Go(Chute.RightDown))
    keyToInput("up") => Option.Some(Input.Up)
    keyToInput("2") => Option.Some(Input.Start(Mode.Hard))
    keyToInput(" ") => Option.Some(Input.Action)
    keyToInput("z") => Option.Some(Input.Pause)
    keyToInput("x") => Option.None

fn press(gs: GameState, key: String) -> GameState
    ? "The state after a key: one step with the input the key means, or the"
      "same state for a key that means nothing."
    match keyToInput(key)
        Option.Some(i) -> step(gs, i)
        Option.None -> gs

verify press
    press(GameState.Playing(startBoard(7, Mode.Easy, 0)), "l") => step(GameState.Playing(startBoard(7, Mode.Easy, 0)), Input.Go(Chute.RightDown))
    press(lobby(7), "x") => lobby(7)

fn isQuit(key: String) -> Bool
    ? "Whether a key asks to leave the game: Esc."
    match key
        "esc" -> true
        _ -> false

verify isQuit
    isQuit("esc") => true
    isQuit("q") => false

fn nextDue(due: Int, now: Int) -> Int
    ? "When the tick after the one due at `due` is due. A shell that fell"
      "more than one frame behind starts over from `now` and does not run a"
      "burst of ticks to catch up."
    frame = frameMs()
    Int.max(due, now - frame) + frame

verify nextDue
    nextDue(1000, 1000) => 1040
    nextDue(1000, 1012) => 1040
    nextDue(1000, 1500) => 1500

fn napMs(due: Int, now: Int) -> Int
    ? "How long the shell sleeps before the tick due at `due`: the time left,"
      "between zero and one frame."
    Int.min(frameMs(), Int.max(0, due - now))

verify napMs
    napMs(1040, 1010) => 30
    napMs(1040, 1100) => 0
    napMs(5000, 1000) => 40

verify napMs law withinOneFrame
    given due: Int = [0, 1000, 1040, 5000]
    given now: Int = [0, 1010, 1100]
    Bool.and(napMs(due, now) >= 0, napMs(due, now) <= 40) => true
