import SchemaCore
import WasmSlice

set_option linter.unusedVariables false
set_option maxRecDepth 200000
set_option maxHeartbeats 4000000

open AverCert
open AverCert.Schema
open CertPrelude

/-!
# Record field-read beachhead — `isMember(p: Person) -> Bool = p.isMember`

Target witness: the two-field flat scalar record `Person = { age: Int,
isMember: Bool }` and the projection `isMember(p) = p.isMember`
(`person.av`, compiled to `person.wasm`). The record declaration is a member of
the certified Plan (`SchemaCore.TypeDecl`); the wall LOWERS it to its wasm-gc
type-section entry (`lowerTypeDecl`) and pins the module's type index 0 to that
entry by EQUALITY over the real compiled bytes. Representation is the single
generic wall relation `ReprOf`; the template-implies-model theorem is the wall's
`recordParam_simulates_model`, which this fixture REUSES — it never re-proves the
interpreter semantics.

Empirically verified layout (`wasm-tools print person.wasm`):
`(type (;0;) (struct (field (ref null 3)) (field i32)))` — Person is type index
0, field 0 (`age`) is a nullable reference to the Int carrier at type index 3,
field 1 (`isMember`) is `i32`, both non-mutable, `.plain` (not a `.sub`/
`.subFinal` supertype). The carrier struct sits at index 3.
-/

namespace PersonDev

/-- The two source-order fields of `Person`: an Int carrier then a Bool. -/
def personFields : List TypeDecl := [.intCarrier, .boolScalar]

/-- `Person` as a member of the certified Plan: a record at wasm struct index 0. -/
def personDecl : TypeDecl := .record 0 personFields

/-- The wasm-gc type-section entry the wall derives for `Person` over carrier
    index 3: a `.plain` struct of `(ref null 3)` then `i32`, both immutable. -/
def personEntry : CertDecode.TypeEntry :=
  ⟨.plain, .structType [⟨.val (.ref 0x63 (Int.ofNat 3)), 0⟩,
                       ⟨.val (.numeric 0x7f), 0⟩]⟩

/-- The wall lowers the Plan declaration to exactly the empirically-verified
    layout — checked here by `rfl`, so the layout is derived, never trusted. -/
example : lowerTypeDecl 3 8 personDecl = some personEntry := by rfl

/-! ## The real compiled module bytes (`person.wasm`, 6539 bytes) -/

def modBytes : Nat := 
def modLen : Nat := 6539

/-- THE EQUALITY PIN over the REAL bytes: decoding `person.wasm`'s type section,
    the entry at index 0 is exactly the wall's lowering of the Plan declaration.
    A type index whose real bytes differed from the derived layout would fail
    this `decide`, so the certificate could not ride a trusted layout. -/
example :
    AverCert.WasmSlice.typeSectionMatches
      (fun e => decide (lowerTypeDecl 3 8 personDecl = some e)) modBytes modLen 0
      = true := by native_decide

/-- The Int carrier really sits at type index 3 (the reference field 0 points to
    it), confirming the carrier index the pin binds against. -/
example :
    AverCert.WasmSlice.typeSectionMatches (fun e => e.isCarrier) modBytes modLen 3
      = true := by native_decide

/-! ## Doppelganger rejection (the class-0A defense, at the pin)

The equality pin lowers to a `.plain` struct in source field order. Every shape
that a subtyping / permutation / width attack would substitute fails the exact
equality, so the pin cannot be satisfied by a type-index doppelganger. -/

/-- Same fields but declared as a `.sub` supertype — the 0A subtyping doppelganger. -/
def hostileSub : CertDecode.TypeEntry :=
  ⟨.sub [7], .structType [⟨.val (.ref 0x63 (Int.ofNat 3)), 0⟩,
                         ⟨.val (.numeric 0x7f), 0⟩]⟩

/-- Fields permuted (Bool before Int). -/
def hostilePermuted : CertDecode.TypeEntry :=
  ⟨.plain, .structType [⟨.val (.numeric 0x7f), 0⟩,
                       ⟨.val (.ref 0x63 (Int.ofNat 3)), 0⟩]⟩

/-- An extra trailing field. -/
def hostileExtra : CertDecode.TypeEntry :=
  ⟨.plain, .structType [⟨.val (.ref 0x63 (Int.ofNat 3)), 0⟩,
                       ⟨.val (.numeric 0x7f), 0⟩,
                       ⟨.val (.numeric 0x7f), 0⟩]⟩

-- The real entry is accepted; every doppelganger shape is rejected.
example : decide (lowerTypeDecl 3 8 personDecl = some personEntry) = true := by decide
example : decide (lowerTypeDecl 3 8 personDecl = some hostileSub) = false := by decide
example : decide (lowerTypeDecl 3 8 personDecl = some hostilePermuted) = false := by decide
example : decide (lowerTypeDecl 3 8 personDecl = some hostileExtra) = false := by decide

/-! ## The semantic bridge (reuses the wall's generic template-implies-model) -/

/-- The emitted `isMember` body: `local.get 0; struct.get 0 1` over a single
    scratch local, at self function index 1 (as compiled in `person.wasm`). -/
def isMemberCode : CodeTbl :=
  fun i => if i = 1 then some ⟨1, 1, recordProjTemplate 0 1⟩ else none

/-- SEMANTIC BRIDGE for `isMember(p) = p.isMember`: under any representation `S`,
    if the emitted body runs to `w` on a represented `Person`, then `w`
    represents the boolean `isMember` field (the second record component). The
    unread `age` field passes through the field-list induction inside the generic
    wall bridge `recordParam_simulates_model`; this fixture only instantiates it. -/
theorem isMember_recordSemanticBridge
    (S : CarrierSpec 3) (host : HostTbl) (fuel : Nat)
    (v : RecordFields personFields) (ws : List WVal) (w : WVal)
    (hrepr : ReprFields S personFields ws v)
    (hRun : wFuncN isMemberCode host fuel 1 [.structv 0 ws] = some w) :
    boolRepr S v.2 w :=
  recordParam_simulates_model S 0 1 1 personFields (by decide)
    host isMemberCode 1 (by rfl) fuel v ws w hrepr hRun

/-! ## Anti-vacuity

The bridge is a partial-correctness statement, vacuous if the body always
trapped. These executable runs pin a concrete Person (age 42, each membership
bit) on the real emitted body and check — decoded to the raw i32 and evaluated
by `native_decide`, outside the proof budget — that the template actually
produces the modelled bit. -/

def i32Of : WVal → Option Int
  | .i32v n => some n
  | _ => none

def demoPerson (isMem : Bool) : WVal := .structv 0 [carrierSmall 3 42, b32 isMem]

def demoRun (isMem : Bool) : Option WVal :=
  wFuncN isMemberCode (fun _ => none) 1 1 [demoPerson isMem]

example : (demoRun true).bind i32Of = some 1 := by native_decide
example : (demoRun false).bind i32Of = some 0 := by native_decide

#print axioms AverCert.Schema.recordParam_simulates_model
#print axioms AverCert.Schema.readField_repr
#print axioms isMember_recordSemanticBridge

end PersonDev
