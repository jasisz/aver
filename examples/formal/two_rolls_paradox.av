module TwoRollsParadox
    intent =
        "Demonstrates the difference between sample-based verify and universal proof."
        "Same verify block: aver verify passes, aver proof + lake build fails."
        "Reason: verify samples laws against the given stubs (here: distinctStub returns n+1)."
        "Proof exports a universal theorem quantified over every oracle — including const oracles."

fn distinctStub(path: BranchPath, n: Int, lo: Int, hi: Int) -> Int
    ? "Stub returning n+1 — different value per call counter."
    n + 1

verify distinctStub
    distinctStub(BranchPath.Root, 0, 1, 6) => 1
    distinctStub(BranchPath.Root, 1, 1, 6) => 2

fn twoRollsDistinct() -> Bool
    ? "Roll a die twice; return whether the two rolls were different."
    ! [Random.int]
    a = Random.int(1, 6)
    b = Random.int(1, 6)
    a != b

verify twoRollsDistinct law alwaysDistinct
    given rnd: Random.int = [distinctStub]
    twoRollsDistinct() => true

fn main() -> Unit
    ! [Console.print]
    Console.print("aver verify: passes (sample under distinctStub: 1 != 2)")
    Console.print("aver proof:  exports forall-quantified theorem")
    Console.print("lake build:  fails — const oracle counter-example invalidates the law")
