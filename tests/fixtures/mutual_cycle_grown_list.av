module MutualCycleGrownList
    intent =
        "A growing-list cycle that is bounded by a two-phase counter."
        "The worker spends the counter without its own guard, but its shifted measure makes direct calls outside the boundary total too."
    exposes [settle]
    depends []
    effects []

fn settle(xs: List<Int>, n: Int) -> Int
    ? "The length of the list after it has been padded n times."
    match n <= 0
        true -> List.len(xs)
        false -> pad(xs, n)

fn pad(ys: List<Int>, n: Int) -> Int
    ? "Pads the list with one zero and settles it with one padding fewer to go."
    settle(List.prepend(0, ys), n - 1)

verify settle
    settle([], 0) => 0
    settle([1], 2) => 3
