module Prop33
    intent =
        "TIP prod prop_33: fac x = qfac x one, where one = S Z."
    effects []

type Nat
    Z
    S(Nat)

fn plus(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> y
        Nat.S(z) -> Nat.S(plus(z, y))

fn mult(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> Nat.Z
        Nat.S(z) -> plus(y, mult(z, y))

fn fac(x: Nat) -> Nat
    match x
        Nat.Z -> Nat.S(Nat.Z)
        Nat.S(y) -> mult(x, fac(y))

fn qfac(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> y
        Nat.S(z) -> qfac(z, mult(x, y))

verify fac law facQfac
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    fac(x) => qfac(x, Nat.S(Nat.Z))
