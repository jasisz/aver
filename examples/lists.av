module Lists
    intent =
        "Demonstrates list values and higher-order functions."
        "Aver has no loops — iteration happens through List.map, List.filter, and List.fold."

fn double(n: Int) -> Int
    ? "Doubles an integer."
    = n * 2

verify double
    double(3) => 6
    double(0) => 0
    double(-2) => -4

fn isPositive(n: Int) -> Bool
    ? "Returns true if n is greater than zero."
    = n > 0

verify isPositive
    isPositive(1)  => true
    isPositive(0)  => false
    isPositive(-5) => false

fn add(a: Int, b: Int) -> Int
    ? "Adds two integers. Used as fold accumulator."
    = a + b

verify add
    add(1, 2) => 3
    add(-2, 5) => 3

verify add law commutative
    given a: Int = -3..3
    given b: Int = -3..3
    add(a, b) => add(b, a)

verify add law identity_zero
    given a: Int = -5..5
    add(a, 0) => a

fn main() -> Unit
    ! [Console]
    numbers = [1, 2, 3, 4, 5]
    doubled = List.map(numbers, double)
    Console.print(doubled)
    positives = List.filter([-1, 0, 2, 3], isPositive)
    Console.print(positives)
    total = List.fold(numbers, 0, add)
    Console.print(total)
    first = List.get(numbers, 0)
    match first
        Option.Some(v) -> Console.print("First: {v}")
        Option.None -> Console.print("No element")
    oob = List.get(numbers, 99)
    match oob
        Option.Some(v) -> Console.print("Got: {v}")
        Option.None -> Console.print("Out of bounds")
