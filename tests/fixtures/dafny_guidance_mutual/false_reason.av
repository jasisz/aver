module MutualAccumulatorFalse
    intent = "Alternating scan and accept states consume one input list while growing a separate accumulator."
    effects []

fn collect(items: List<Int>, acc: List<Int>) -> List<Int>
    match items
        [] -> acc
        [head, ..tail] -> accept(head, tail, acc)

fn accept(head: Int, rest: List<Int>, acc: List<Int>) -> List<Int>
    match head >= 0
        true -> collect(rest, List.prepend(head, acc))
        false -> collect(rest, acc)

fn collectReason(items: List<Int>, acc: List<Int>) -> Bool
    match items
        [] -> List.len(collect(items, acc)) >= List.len(acc)
        [head, ..tail] -> Bool.and(acceptReason(head, tail, acc), List.len(collect(items, acc)) >= List.len(acc))

fn acceptReason(head: Int, rest: List<Int>, acc: List<Int>) -> Bool
    match head >= 0
        true -> Bool.and(collectReason(rest, List.prepend(head, acc)), Bool.and(head == 0, List.len(accept(head, rest, acc)) >= List.len(acc)))
        false -> Bool.and(collectReason(rest, acc), Bool.and(head == 0, List.len(accept(head, rest, acc)) >= List.len(acc)))

verify collect law falseIntermediate
    given items: List<Int> = [[], [0]]
    given acc: List<Int> = [[], [8, 9]]
    because collectReason(items, acc)
    using []
    collect(items, acc) => collect(items, acc)
