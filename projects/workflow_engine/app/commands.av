module Commands
    intent =
        "Effectful command handlers for workflow mutations."
        "The app layer is intentionally small: it decides a plan from persisted state,"
        "derives follow-up rule effects as data, then commits and dispatches that plan."
    exposes [Command, CommandReport, execute]
    depends [Domain.Types, Domain.Projects, Domain.Tasks, Domain.Events, Domain.Rules, Domain.Validation, Infra.Store, Infra.Clock, Infra.Notify, Infra.Audit]
    effects [Console, Disk, Time]

decision OneRulePassPerCommand
    date = "2026-03-08"
    author = "Codex"
    reason =
        "Workflow rules should stay reviewable, not turn into an implicit fixpoint engine."
        "A single pass after each user mutation keeps command flow explicit even if it leaves"
        "some second-order derivations for a later manual `run_rules` call."
    chosen = "SingleExplicitRulePass"
    rejected = ["LoopUntilNoRulesFire", "HideRulesInsideStoreWrites"]
    impacts = [execute, decide, planTaskCommand, deriveRuleEffectsAfterPrimaryEvent, commit, dispatch]

type Command
    CreateProject(String, String)
    ArchiveProject(String)
    CreateTask(String, String, String, Priority, List<String>, Option<String>)
    RenameTask(String, String)
    StartTask(String)
    BlockTask(String, String)
    CompleteTask(String)
    ReopenTask(String, String)
    ChangePriority(String, Priority)
    AddTag(String, String)
    RemoveTag(String, String)
    AddComment(String, String, String)
    SetDeadline(String, String)
    ClearDeadline(String)
    ArchiveTask(String)
    RunRules(Option<String>)

record CommandReport
    summary: String
    subjectId: String
    events: List<TaskEventRecord>
    notifications: List<Notification>
    audits: List<AuditEntry>

record TaskContext
    project: Project
    task: Task
    persistedEvents: List<TaskEventRecord>
    latestPersistedEvent: Option<TaskEventRecord>
    nextSeq: Int

record ProjectPlan
    summary: String
    subjectId: String
    projects: List<Project>
    audits: List<AuditEntry>

record EventPlan
    summary: String
    subjectId: String
    events: List<TaskEventRecord>
    notifications: List<Notification>
    audits: List<AuditEntry>

type CommandPlan
    SaveProjects(ProjectPlan)
    AppendEvents(EventPlan)

fn execute(command: Command) -> Result<CommandReport, String>
    ? "Executes one workflow command through decide, commit, and dispatch."
    ! [
        Console.warn,
        Disk.appendText, Disk.readText, Disk.writeText,
        Time.now,
    ]
    plan = decide(command)?
    committed = commit(plan)?
    _sent = dispatch(committed)?
    Result.Ok(committed)

fn decide(command: Command) -> Result<CommandPlan, String>
    ? "Loads only the read-side context needed to turn a command into a write plan."
    ! [Disk.readText, Time.now]
    match command
        Command.CreateProject(projectId, name) -> planCreateProject(projectId, name)
        Command.ArchiveProject(projectId) -> planArchiveProject(projectId)
        Command.CreateTask(projectId, taskId, title, priority, tags, deadline) -> planCreateTask(projectId, taskId, title, priority, tags, deadline)
        Command.RenameTask(taskId, title) -> planRenameTask(taskId, title)
        Command.StartTask(taskId) -> planStartTask(taskId)
        Command.BlockTask(taskId, reason) -> planBlockTask(taskId, reason)
        Command.CompleteTask(taskId) -> planCompleteTask(taskId)
        Command.ReopenTask(taskId, reason) -> planReopenTask(taskId, reason)
        Command.ChangePriority(taskId, priority) -> planChangePriority(taskId, priority)
        Command.AddTag(taskId, tag) -> planAddTag(taskId, tag)
        Command.RemoveTag(taskId, tag) -> planRemoveTag(taskId, tag)
        Command.AddComment(taskId, author, body) -> planAddComment(taskId, author, body)
        Command.SetDeadline(taskId, deadline) -> planSetDeadline(taskId, deadline)
        Command.ClearDeadline(taskId) -> planClearDeadline(taskId)
        Command.ArchiveTask(taskId) -> planArchiveTask(taskId)
        Command.RunRules(scope) -> planRunRules(scope)

fn commit(plan: CommandPlan) -> Result<CommandReport, String>
    ? "Persists the chosen plan without performing side-effect dispatch."
    ! [Disk.appendText, Disk.readText, Disk.writeText]
    match plan
        CommandPlan.SaveProjects(projectPlan) -> commitProjectPlan(projectPlan)
        CommandPlan.AppendEvents(eventPlan) -> commitEventPlan(eventPlan)

fn dispatch(outcome: CommandReport) -> Result<Unit, String>
    ? "Sends already-decided side effects after commit succeeds."
    ! [Console.warn, Disk.appendText, Disk.readText]
    Infra.Notify.emitNotifications(outcome.notifications)

fn planCreateProject(projectId: String, name: String) -> Result<CommandPlan, String>
    ? "Decides a project creation as a state-write plan plus audit."
    ! [Disk.readText, Time.now]
    now = Infra.Clock.now()
    projects = Infra.Store.loadProjects()?
    _missing = ensureProjectMissing(projects, projectId)?
    project = Domain.Projects.createProject(projectId, name, now)?
    audit = projectAudit(projectId, "project.created", "Created project '{projectId}'", now)
    Result.Ok(CommandPlan.SaveProjects(ProjectPlan(summary = "Created project '{projectId}'", subjectId = projectSubject(projectId), projects = Domain.Projects.putProject(projects, project), audits = [audit])))

fn planArchiveProject(projectId: String) -> Result<CommandPlan, String>
    ? "Decides a project archival as a state-write plan plus audit."
    ! [Disk.readText, Time.now]
    now = Infra.Clock.now()
    projects = Infra.Store.loadProjects()?
    current = requireProject(projects, projectId)?
    archived = Domain.Projects.archiveProject(current, now)?
    audit = projectAudit(projectId, "project.archived", "Archived project '{projectId}'", now)
    Result.Ok(CommandPlan.SaveProjects(ProjectPlan(summary = "Archived project '{projectId}'", subjectId = projectSubject(projectId), projects = Domain.Projects.putProject(projects, archived), audits = [audit])))

fn planCreateTask(projectId: String, taskId: String, title: String, priority: Priority, tags: List<String>, deadline: Option<String>) -> Result<CommandPlan, String>
    ? "Decides the first user event for a new task, then derives rule follow-ups."
    ! [Disk.readText, Time.now]
    now = Infra.Clock.now()
    projects = Infra.Store.loadProjects()?
    events = Infra.Store.loadTaskEvents()?
    project = requireProject(projects, projectId)?
    _active = Domain.Validation.ensureProjectActive(project)?
    _absent = ensureTaskMissing(events, taskId)?
    primaryEvent = Domain.Tasks.createTask(taskId, projectId, title, priority, tags, deadline, now)?
    planTaskCommand("Created task '{taskId}'", project, [], primaryEvent, now)

fn planRenameTask(taskId: String, title: String) -> Result<CommandPlan, String>
    ? "Decides a rename event and derives follow-up rule effects."
    ! [Disk.readText, Time.now]
    context = loadActiveTaskContext(taskId)?
    now = Infra.Clock.now()
    primaryEvent = Domain.Tasks.renameTask(context.task, context.nextSeq, title, now)?
    planTaskCommand("Renamed task '{taskId}'", context.project, context.persistedEvents, primaryEvent, now)

fn planStartTask(taskId: String) -> Result<CommandPlan, String>
    ? "Decides a start event and derives follow-up rule effects."
    ! [Disk.readText, Time.now]
    context = loadActiveTaskContext(taskId)?
    now = Infra.Clock.now()
    primaryEvent = Domain.Tasks.startTask(context.task, context.nextSeq, now)?
    planTaskCommand("Started task '{taskId}'", context.project, context.persistedEvents, primaryEvent, now)

