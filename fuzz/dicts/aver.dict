# AFL++ dictionary for the Aver language. Each entry is a token shape
# the lexer/parser cares about; the fuzzer splices them into mutations
# instead of trying to discover them from random bytes.
#
# Keywords
"fn"
"type"
"record"
"module"
"verify"
"law"
"given"
"when"
"match"
"intent"
"effects"
"exposes"
"depends"
"opaque"
"decision"
"date"
"reason"
"chosen"
"rejected"
"impacts"
"author"
"trace"
"name"
# Literals / built-in idents
"true"
"false"
"Unit"
"None"
"Some"
"Ok"
"Err"
"Result"
"Option"
"List"
"Vector"
"Map"
# Operators / punctuation
"->"
"=>"
".."
"=="
"!="
"<="
">="
"?!"
"::"
":="
"+"
"-"
"*"
"/"
"<"
">"
"="
"."
","
":"
"("
")"
"["
"]"
"{"
"}"
"!"
"?"
"|"
"&"
"@"
# Common dotted names
"List.prepend"
"List.empty"
"Vector.new"
"Vector.get"
"Vector.set"
"Vector.len"
"Map.set"
"Map.get"
"Map.has"
"String.len"
"Console.print"
"Result.Ok"
"Result.Err"
"Option.Some"
"Option.None"
# Interpolation
"\"{"
"}\""
"\""
# Newline / whitespace shapes the lexer indents on
"\n"
"\n    "
"\n        "
