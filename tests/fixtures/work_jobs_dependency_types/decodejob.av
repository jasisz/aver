module DecodeJob
    kind = capability
    semantics = effectful
    depends [Work, Ledger]
    intent = "One job kind whose task and reply are types the program already has."
    exposes [begin, take]

operation begin(task: Ledger.Request) -> Result<Work.Job, String>
    ? "Starts one decode job off the turn and returns its job handle at once."
    oracle = generativeOutput
    replay = recorded

operation take(job: Work.Job) -> Result<Option<List<Ledger.Tx>>, String>
    ? "Collects one finished decode job: None while it runs, Some(transactions) once it finished."
    oracle = generativeOutput
    replay = recorded
