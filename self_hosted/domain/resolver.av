module Resolver
    depends [Domain.Ast]
    intent =
        "Compile-time variable resolution: ExprVar to ExprSlot, StmtBind to StmtBindSlot."
        "Assigns slot indices to params and local bindings inside each FnDef."
        "Globals and dotted names (builtins, constructors) are left as ExprVar."
    exposes [resolveProgram]

fn resolveProgram(prog: Program) -> Program
    ? "Resolve all functions: slots, direct calls, then attach narrow fast-path tags."
    resolvedFns = resolveFns(prog.fns, [])
    fnMap = buildFnMap(resolvedFns, Map.empty())
    calledFns = resolveCallsInFns(resolvedFns, fnMap, [])
    annotatedFns = annotateFastFns(calledFns, [])
    Program(deps = prog.deps, fns = rewriteInternalFns(annotatedFns, []), stmts = rewriteInternalStmts(prog.stmts, []))

verify resolveProgram
    resolveProgram(Program(deps = [], fns = [], stmts = [Stmt.StmtExpr(Expr.ExprInt(1))])) => Program(deps = [], fns = [], stmts = [Stmt.StmtExpr(Expr.ExprInt(1))])

fn resolveFns(fns: List<FnDef>, acc: List<FnDef>) -> List<FnDef>
    ? "Resolve each function definition."
    match fns
        [] -> List.reverse(acc)
        [f, ..rest] -> resolveFns(rest, List.prepend(resolveFn(f), acc))

fn resolveFn(fd: FnDef) -> FnDef
    ? "Resolve one function: assign slots to params and locals."
    paramResult = buildParamSlots(fd.params, Map.empty(), 0)
    match paramResult
        (slotMap, nextSlot) -> resolveBody(fd, slotMap, nextSlot)

fn buildParamSlots(params: List<String>, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slot indices 0..n-1 to parameters."
    match params
        [] -> (slots, next)
        [p, ..rest] -> buildParamSlots(rest, Map.set(slots, p, next), next + 1)

verify buildParamSlots
    buildParamSlots([], Map.empty(), 0) => (Map.empty(), 0)
    buildParamSlots(["a", "b"], Map.empty(), 0) => (Map.set(Map.set(Map.empty(), "a", 0), "b", 1), 2)

fn resolveBody(fd: FnDef, slots: Map<String, Int>, nextSlot: Int) -> FnDef
    ? "Walk body stmts, resolve vars, track new bindings. slotCount = max slot + 1 from body scan."
    resolved = resolveStmts(fd.body, slots, nextSlot, [])
    match resolved
        (newBody, finalSlot, finalSlotMap) -> computeSlotCount(fd, newBody, finalSlot, finalSlotMap)

fn computeSlotCount(fd: FnDef, body: List<Stmt>, baseSlot: Int, slotMap: Map<String, Int>) -> FnDef
    ? "Compute slotCount as max slot index found in body + 1."
    maxFromBody = maxSlotInStmts(body, baseSlot - 1)
    FnDef(name = fd.name, params = fd.params, body = body, slotCount = maxFromBody + 1, slotMap = slotMap, fastPath = FnFastPath.FastNone)

fn maxSlotInStmts(stmts: List<Stmt>, acc: Int) -> Int
    ? "Find highest slot index in a list of statements."
    match stmts
        [] -> acc
        [s, ..rest] -> maxSlotInStmts(rest, maxSlotInStmt(s, acc))

fn maxSlotInStmt(s: Stmt, acc: Int) -> Int
    ? "Find highest slot index in a statement."
    match s
        Stmt.StmtBindSlot(slot, expr) -> maxSlotInExpr(expr, maxInt(slot, acc))
        Stmt.StmtExpr(expr) -> maxSlotInExpr(expr, acc)
        Stmt.StmtBind(_, expr) -> maxSlotInExpr(expr, acc)

fn maxSlotInExpr(expr: Expr, acc: Int) -> Int
    ? "Find highest slot index in an expression tree."
    match expr
        Expr.ExprBoolBranch(cond, thenExpr, elseExpr) -> maxSlotInExpr(elseExpr, maxSlotInExpr(thenExpr, maxSlotInExpr(cond, acc)))
        Expr.ExprSlot(slot) -> maxInt(slot, acc)
        Expr.ExprBinopSlotInt(_, slot, _) -> maxInt(slot, acc)
        Expr.ExprBinopSlots(_, lhs, rhs) -> maxInt(rhs, maxInt(lhs, acc))
        Expr.ExprCmpSlotInt(_, slot, _) -> maxInt(slot, acc)
        Expr.ExprCmpSlots(_, lhs, rhs) -> maxInt(rhs, maxInt(lhs, acc))
        Expr.ExprVectorGetOrInt(vecExpr, idxExpr, _) -> maxSlotInExpr(idxExpr, maxSlotInExpr(vecExpr, acc))
        Expr.ExprIntModOrInt(a, b, _) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprAdd(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprSub(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprMul(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprDiv(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprEq(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprNeq(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprLt(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprGt(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprLte(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprGte(a, b) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprCall(_, args) -> maxSlotInExprs(args, acc)
        Expr.ExprCallDirect(_, args) -> maxSlotInExprs(args, acc)
        Expr.ExprCallBuiltin(_, args) -> maxSlotInExprs(args, acc)
        Expr.ExprMatch(subj, arms) -> maxSlotInArms(arms, maxSlotInExpr(subj, acc))
        Expr.ExprPropagate(inner) -> maxSlotInExpr(inner, acc)
        Expr.ExprConcat(parts) -> maxSlotInExprs(parts, acc)
        Expr.ExprTuple(exprs) -> maxSlotInExprs(exprs, acc)
        Expr.ExprList(exprs) -> maxSlotInExprs(exprs, acc)
        Expr.ExprRecord(_, fields) -> maxSlotInFields(fields, acc)
        Expr.ExprFieldAccess(obj, _) -> maxSlotInExpr(obj, acc)
        _ -> acc

fn maxSlotInExprs(exprs: List<Expr>, acc: Int) -> Int
    ? "Find highest slot index in a list of expressions."
    match exprs
        [] -> acc
        [e, ..rest] -> maxSlotInExprs(rest, maxSlotInExpr(e, acc))

fn maxSlotInFields(fields: List<(String, Expr)>, acc: Int) -> Int
    ? "Find highest slot index in record fields."
    match fields
        [] -> acc
        [pair, ..rest] -> match pair
            (_, expr) -> maxSlotInFields(rest, maxSlotInExpr(expr, acc))

fn maxSlotInArms(arms: List<MatchArm>, acc: Int) -> Int
    ? "Find highest slot index in match arms."
    match arms
        [] -> acc
        [arm, ..rest] -> maxSlotInArms(rest, maxSlotInExpr(arm.body, acc))

fn maxInt(a: Int, b: Int) -> Int
    ? "Return the larger of two integers."
    match a > b
        true -> a
        false -> b

fn resolveStmts(stmts: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Resolve statements, threading slot assignments."
    match stmts
        [] -> (List.reverse(acc), next, slots)
        [s, ..rest] -> resolveOneStmt(s, rest, slots, next, acc)

fn resolveOneStmt(s: Stmt, rest: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Resolve a single statement and continue."
    match s
        Stmt.StmtBind(name, expr) -> resolveStmtBind(name, expr, rest, slots, next, acc)
        Stmt.StmtExpr(expr) -> resolveStmtExpr(expr, rest, slots, next, acc)
        Stmt.StmtBindSlot(_, _) -> resolveStmts(rest, slots, next, List.prepend(s, acc))

fn resolveStmtExpr(expr: Expr, rest: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Resolve an expression statement, collecting pattern slots."
    match resolveExpr(expr, slots)
        (re, newSlots) -> resolveStmts(rest, newSlots, maxInt(next, mapMaxVal(newSlots) + 1), List.prepend(Stmt.StmtExpr(re), acc))

fn resolveStmtBind(name: String, expr: Expr, rest: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Resolve a binding: assign a new slot, replace with StmtBindSlot."
    match resolveExpr(expr, slots)
        (newExpr, exprSlots) -> resolveStmtBindFinish(name, newExpr, rest, exprSlots, next, acc)

fn resolveStmtBindFinish(name: String, newExpr: Expr, rest: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Finish resolving a binding after expr is resolved."
    newSlots = Map.set(slots, name, next)
    resolveStmts(rest, newSlots, next + 1, List.prepend(Stmt.StmtBindSlot(next, newExpr), acc))

fn resolveExpr(expr: Expr, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve an expression. Returns (resolved expr, slots with any new pattern bindings)."
    match expr
        Expr.ExprBoolBranch(cond, thenExpr, elseExpr) -> (Expr.ExprBoolBranch(resolveExprSimple(cond, slots), resolveExprSimple(thenExpr, slots), resolveExprSimple(elseExpr, slots)), slots)
        Expr.ExprVar(name) -> (resolveVar(name, slots), slots)
        Expr.ExprInt(_) -> (expr, slots)
        Expr.ExprFloat(_) -> (expr, slots)
        Expr.ExprStr(_) -> (expr, slots)
        Expr.ExprBool(_) -> (expr, slots)
        Expr.ExprSlot(_) -> (expr, slots)
        Expr.ExprBinopSlotInt(_, _, _) -> (expr, slots)
        Expr.ExprBinopSlots(_, _, _) -> (expr, slots)
        Expr.ExprCmpSlotInt(_, _, _) -> (expr, slots)
        Expr.ExprCmpSlots(_, _, _) -> (expr, slots)
        Expr.ExprVectorGetOrInt(vecExpr, idxExpr, defaultValue) -> (Expr.ExprVectorGetOrInt(resolveExprSimple(vecExpr, slots), resolveExprSimple(idxExpr, slots), defaultValue), slots)
        Expr.ExprIntModOrInt(a, b, defaultValue) -> (Expr.ExprIntModOrInt(resolveExprSimple(a, slots), resolveExprSimple(b, slots), defaultValue), slots)
        Expr.ExprAdd(a, b) -> resolveBinExpr(a, b, slots, "add")
        Expr.ExprSub(a, b) -> resolveBinExpr(a, b, slots, "sub")
        Expr.ExprMul(a, b) -> resolveBinExpr(a, b, slots, "mul")
        Expr.ExprDiv(a, b) -> resolveBinExpr(a, b, slots, "div")
        Expr.ExprEq(a, b) -> resolveBinExpr(a, b, slots, "eq")
        Expr.ExprNeq(a, b) -> resolveBinExpr(a, b, slots, "neq")
        Expr.ExprLt(a, b) -> resolveBinExpr(a, b, slots, "lt")
        Expr.ExprGt(a, b) -> resolveBinExpr(a, b, slots, "gt")
        Expr.ExprLte(a, b) -> resolveBinExpr(a, b, slots, "lte")
        Expr.ExprGte(a, b) -> resolveBinExpr(a, b, slots, "gte")
        Expr.ExprCall(name, args) -> resolveCallExpr(name, args, slots)
        Expr.ExprCallDirect(fd, args) -> (Expr.ExprCallDirect(fd, resolveExprs(args, slots, [])), slots)
        Expr.ExprCallBuiltin(name, args) -> (Expr.ExprCallBuiltin(name, resolveExprs(args, slots, [])), slots)
        Expr.ExprMatch(subj, arms) -> resolveMatchExpr(subj, arms, slots)
        Expr.ExprPropagate(inner) -> resolvePropExpr(inner, slots)
        Expr.ExprConcat(parts) -> resolveConcatExpr(parts, slots)
        Expr.ExprTuple(exprs) -> resolveTupleExpr(exprs, slots)
        Expr.ExprList(exprs) -> resolveListExpr(exprs, slots)
        Expr.ExprRecord(name, fields) -> resolveRecordExpr(name, fields, slots)
        Expr.ExprFieldAccess(obj, field) -> resolveFieldExpr(obj, field, slots)

fn resolveBinExpr(a: Expr, b: Expr, slots: Map<String, Int>, op: String) -> (Expr, Map<String, Int>)
    ? "Resolve binary expression and rebuild."
    ra = resolveExprSimple(a, slots)
    rb = resolveExprSimple(b, slots)
    match op
        "add" -> (Expr.ExprAdd(ra, rb), slots)
        "sub" -> (Expr.ExprSub(ra, rb), slots)
        "mul" -> (Expr.ExprMul(ra, rb), slots)
        "div" -> (Expr.ExprDiv(ra, rb), slots)
        "eq" -> (Expr.ExprEq(ra, rb), slots)
        "neq" -> (Expr.ExprNeq(ra, rb), slots)
        "lt" -> (Expr.ExprLt(ra, rb), slots)
        "gt" -> (Expr.ExprGt(ra, rb), slots)
        "lte" -> (Expr.ExprLte(ra, rb), slots)
        "gte" -> (Expr.ExprGte(ra, rb), slots)
        _ -> (Expr.ExprAdd(ra, rb), slots)

fn resolveExprSimple(expr: Expr, slots: Map<String, Int>) -> Expr
    ? "Resolve expression, discarding slots update (for non-match contexts)."
    match resolveExpr(expr, slots)
        (e, _) -> e

fn resolveCallExpr(name: String, args: List<Expr>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve function call arguments."
    (Expr.ExprCall(name, resolveExprs(args, slots, [])), slots)

fn resolveMatchExpr(subj: Expr, arms: List<MatchArm>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve match expression, collecting pattern slots."
    rs = resolveExprSimple(subj, slots)
    armsResult = resolveArms(arms, slots, [])
    match armsResult
        (resolvedArms, mergedSlots) -> (Expr.ExprMatch(rs, resolvedArms), mergedSlots)

fn resolvePropExpr(inner: Expr, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve ? propagation."
    (Expr.ExprPropagate(resolveExprSimple(inner, slots)), slots)

fn resolveConcatExpr(parts: List<Expr>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve string concatenation parts."
    (Expr.ExprConcat(resolveExprs(parts, slots, [])), slots)

fn resolveTupleExpr(exprs: List<Expr>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve tuple expressions."
    (Expr.ExprTuple(resolveExprs(exprs, slots, [])), slots)

fn resolveListExpr(exprs: List<Expr>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve list expressions."
    (Expr.ExprList(resolveExprs(exprs, slots, [])), slots)

fn resolveRecordExpr(name: String, fields: List<(String, Expr)>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve record expressions."
    (Expr.ExprRecord(name, resolveFields(fields, slots, [])), slots)

fn resolveFieldExpr(obj: Expr, field: String, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve field access."
    (Expr.ExprFieldAccess(resolveExprSimple(obj, slots), field), slots)

fn resolveVar(name: String, slots: Map<String, Int>) -> Expr
    ? "Resolve a variable: local vars become ExprSlot, others stay ExprVar."
    match Map.get(slots, name)
        Option.Some(slot) -> Expr.ExprSlot(slot)
        Option.None -> Expr.ExprVar(name)

verify resolveVar
    resolveVar("x", Map.set(Map.empty(), "x", 0)) => Expr.ExprSlot(0)
    resolveVar("Option.None", Map.empty()) => Expr.ExprVar("Option.None")
    resolveVar("y", Map.empty()) => Expr.ExprVar("y")

fn resolveExprs(exprs: List<Expr>, slots: Map<String, Int>, acc: List<Expr>) -> List<Expr>
    ? "Resolve a list of expressions."
    match exprs
        [] -> List.reverse(acc)
        [e, ..rest] -> resolveExprs(rest, slots, List.prepend(resolveExprSimple(e, slots), acc))

fn resolveFields(fields: List<(String, Expr)>, slots: Map<String, Int>, acc: List<(String, Expr)>) -> List<(String, Expr)>
    ? "Resolve record field expressions."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (name, expr) -> resolveFields(rest, slots, List.prepend((name, resolveExprSimple(expr, slots)), acc))

fn resolveArms(arms: List<MatchArm>, slots: Map<String, Int>, acc: List<MatchArm>) -> (List<MatchArm>, Map<String, Int>)
    ? "Resolve match arms, collecting all pattern slots."
    match arms
        [] -> (List.reverse(acc), slots)
        [arm, ..rest] -> resolveOneArm(arm, rest, slots, acc)

fn resolveOneArm(arm: MatchArm, rest: List<MatchArm>, slots: Map<String, Int>, acc: List<MatchArm>) -> (List<MatchArm>, Map<String, Int>)
    ? "Resolve one match arm and continue."
    match resolveArm(arm, slots)
        (resolvedArm, mergedSlots) -> resolveArms(rest, mergedSlots, List.prepend(resolvedArm, acc))

fn resolveArm(arm: MatchArm, slots: Map<String, Int>) -> (MatchArm, Map<String, Int>)
    ? "Resolve a match arm: extend slots with pattern bindings, then resolve body."
    armSlotResult = addPatternSlots(arm.pattern, slots)
    match armSlotResult
        (newSlots, _) -> resolveArmBody(arm, newSlots, patternBindingSlots(arm.pattern, slots))

fn resolveArmBody(arm: MatchArm, newSlots: Map<String, Int>, bindingSlots: Map<String, Int>) -> (MatchArm, Map<String, Int>)
    ? "Resolve arm body with extended slots."
    match resolveExpr(arm.body, newSlots)
        (re, finalSlots) -> (MatchArm(pattern = arm.pattern, body = re, bindingSlots = bindingSlots), finalSlots)

fn patternBindingSlots(pat: Pattern, slots: Map<String, Int>) -> Map<String, Int>
    ? "Compute only the slots introduced by one pattern, using the same numbering as addPatternSlots."
    nextSlot = mapMaxVal(slots) + 1
    match patternBindingSlotsInner(pat, Map.empty(), nextSlot)
        (bindingSlots, _) -> bindingSlots

fn patternBindingSlotsInner(pat: Pattern, bindingSlots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slots to pattern binders without carrying the outer slot map."
    match pat
        Pattern.PatVar(name) -> (Map.set(bindingSlots, name, next), next + 1)
        Pattern.PatCons(h, t) -> patternBindingSlotsCons(h, t, bindingSlots, next)
        Pattern.PatConstructor(_, bindings) -> patternBindingSlotsConstructor(bindings, bindingSlots, next)
        Pattern.PatTuple(pats) -> patternBindingSlotsTuple(pats, bindingSlots, next)
        _ -> (bindingSlots, next)

fn patternBindingSlotsCons(h: String, t: String, bindingSlots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slots for cons-pattern binders."
    bindingSlots2 = Map.set(bindingSlots, h, next)
    (Map.set(bindingSlots2, t, next + 1), next + 2)

fn patternBindingSlotsConstructor(bindings: List<String>, bindingSlots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slots for constructor-pattern binders."
    match bindings
        [] -> (bindingSlots, next)
        [name, ..rest] -> patternBindingSlotsConstructor(rest, Map.set(bindingSlots, name, next), next + 1)

fn patternBindingSlotsTuple(pats: List<Pattern>, bindingSlots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slots for tuple sub-patterns."
    match pats
        [] -> (bindingSlots, next)
        [p, ..rest] -> match patternBindingSlotsInner(p, bindingSlots, next)
            (newBindingSlots, newNext) -> patternBindingSlotsTuple(rest, newBindingSlots, newNext)

fn addPatternSlots(pat: Pattern, slots: Map<String, Int>) -> (Map<String, Int>, Int)
    ? "Find the next available slot and add pattern bindings."
    nextSlot = mapMaxVal(slots) + 1
    addPatternSlotsInner(pat, slots, nextSlot)

fn mapMaxVal(m: Map<String, Int>) -> Int
    ? "Get maximum value in a map, or -1 if empty."
    vals = Map.values(m)
    maxInList(vals, 0 - 1)

fn maxInList(vals: List<Int>, acc: Int) -> Int
    ? "Find maximum value in a list."
    match vals
        [] -> acc
        [v, ..rest] -> match v > acc
            true -> maxInList(rest, v)
            false -> maxInList(rest, acc)

verify maxInList
    maxInList([], 0 - 1) => 0 - 1
    maxInList([0, 2, 1], 0 - 1) => 2
    maxInList([5], 0 - 1) => 5

fn addPatternSlotsInner(pat: Pattern, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Add slots for pattern bindings."
    match pat
        Pattern.PatVar(name) -> (Map.set(slots, name, next), next + 1)
        Pattern.PatCons(h, t) -> addConsSlots(h, t, slots, next)
        Pattern.PatConstructor(_, bindings) -> addConstructorSlots(bindings, slots, next)
        Pattern.PatTuple(pats) -> addTuplePatternSlots(pats, slots, next)
        _ -> (slots, next)

fn addConsSlots(h: String, t: String, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Add slots for cons pattern [h, ..t]."
    slots2 = Map.set(slots, h, next)
    (Map.set(slots2, t, next + 1), next + 2)

fn addConstructorSlots(bindings: List<String>, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Add slots for constructor pattern bindings."
    match bindings
        [] -> (slots, next)
        [name, ..rest] -> addConstructorSlots(rest, Map.set(slots, name, next), next + 1)

fn addTuplePatternSlots(pats: List<Pattern>, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Add slots for tuple sub-patterns."
    match pats
        [] -> (slots, next)
        [p, ..rest] -> match addPatternSlotsInner(p, slots, next)
            (newSlots, newNext) -> addTuplePatternSlots(rest, newSlots, newNext)

// ─── Pass 2: pre-resolve function calls ─────────────────

fn buildFnMap(fns: List<FnDef>, acc: Map<String, FnDef>) -> Map<String, FnDef>
    ? "Build name→FnDef map from resolved function list."
    match fns
        [] -> acc
        [f, ..rest] -> buildFnMap(rest, Map.set(acc, f.name, f))

fn resolveCallsInFns(fns: List<FnDef>, fnMap: Map<String, FnDef>, acc: List<FnDef>) -> List<FnDef>
    ? "Transform ExprCall→ExprCallDirect for known functions in all fn bodies."
    match fns
        [] -> List.reverse(acc)
        [f, ..rest] -> resolveCallsInFns(rest, fnMap, List.prepend(resolveCallsInFn(f, fnMap), acc))

fn resolveCallsInFn(fd: FnDef, fnMap: Map<String, FnDef>) -> FnDef
    ? "Transform calls in one function body."
    FnDef(name = fd.name, params = fd.params, body = resolveCallsInStmts(fd.body, fnMap, []), slotCount = fd.slotCount, slotMap = fd.slotMap, fastPath = fd.fastPath)

fn resolveCallsInStmts(stmts: List<Stmt>, fnMap: Map<String, FnDef>, acc: List<Stmt>) -> List<Stmt>
    match stmts
        [] -> List.reverse(acc)
        [s, ..rest] -> resolveCallsInStmts(rest, fnMap, List.prepend(resolveCallsInStmt(s, fnMap), acc))

fn resolveCallsInStmt(s: Stmt, fnMap: Map<String, FnDef>) -> Stmt
    match s
        Stmt.StmtBind(name, expr) -> Stmt.StmtBind(name, resolveCallsInExpr(expr, fnMap))
        Stmt.StmtBindSlot(slot, expr) -> Stmt.StmtBindSlot(slot, resolveCallsInExpr(expr, fnMap))
        Stmt.StmtExpr(expr) -> Stmt.StmtExpr(resolveCallsInExpr(expr, fnMap))

fn resolveCallsInExpr(expr: Expr, fnMap: Map<String, FnDef>) -> Expr
    ? "Replace ExprCall with ExprCallDirect for known user functions."
    match expr
        Expr.ExprBoolBranch(cond, thenExpr, elseExpr) -> Expr.ExprBoolBranch(resolveCallsInExpr(cond, fnMap), resolveCallsInExpr(thenExpr, fnMap), resolveCallsInExpr(elseExpr, fnMap))
        Expr.ExprCall(name, args) -> resolveOneCall(name, args, fnMap)
        Expr.ExprCallDirect(name, args) -> Expr.ExprCallDirect(name, resolveCallsInExprs(args, fnMap, []))
        Expr.ExprBinopSlotInt(_, _, _) -> expr
        Expr.ExprBinopSlots(_, _, _) -> expr
        Expr.ExprCmpSlotInt(_, _, _) -> expr
        Expr.ExprCmpSlots(_, _, _) -> expr
        Expr.ExprVectorGetOrInt(vecExpr, idxExpr, defaultValue) -> Expr.ExprVectorGetOrInt(resolveCallsInExpr(vecExpr, fnMap), resolveCallsInExpr(idxExpr, fnMap), defaultValue)
        Expr.ExprIntModOrInt(a, b, defaultValue) -> Expr.ExprIntModOrInt(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap), defaultValue)
        Expr.ExprAdd(a, b) -> Expr.ExprAdd(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprSub(a, b) -> Expr.ExprSub(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprMul(a, b) -> Expr.ExprMul(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprDiv(a, b) -> Expr.ExprDiv(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprEq(a, b) -> Expr.ExprEq(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprNeq(a, b) -> Expr.ExprNeq(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprLt(a, b) -> Expr.ExprLt(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprGt(a, b) -> Expr.ExprGt(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprLte(a, b) -> Expr.ExprLte(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprGte(a, b) -> Expr.ExprGte(resolveCallsInExpr(a, fnMap), resolveCallsInExpr(b, fnMap))
        Expr.ExprMatch(subj, arms) -> Expr.ExprMatch(resolveCallsInExpr(subj, fnMap), resolveCallsInArms(arms, fnMap, []))
        Expr.ExprPropagate(inner) -> Expr.ExprPropagate(resolveCallsInExpr(inner, fnMap))
        Expr.ExprConcat(parts) -> Expr.ExprConcat(resolveCallsInExprs(parts, fnMap, []))
        Expr.ExprTuple(exprs) -> Expr.ExprTuple(resolveCallsInExprs(exprs, fnMap, []))
        Expr.ExprList(exprs) -> Expr.ExprList(resolveCallsInExprs(exprs, fnMap, []))
        Expr.ExprRecord(name, fields) -> Expr.ExprRecord(name, resolveCallsInFields(fields, fnMap, []))
        Expr.ExprFieldAccess(obj, field) -> Expr.ExprFieldAccess(resolveCallsInExpr(obj, fnMap), field)
        _ -> expr

fn resolveOneCall(name: String, args: List<Expr>, fnMap: Map<String, FnDef>) -> Expr
    ? "User fn → ExprCallDirect, builtin → ExprCallBuiltin, record update → ExprCall."
    resolvedArgs = resolveCallsInExprs(args, fnMap, [])
    match Map.get(fnMap, name)
        Option.Some(fd) -> Expr.ExprCallDirect(fd.name, resolvedArgs)
        Option.None -> match String.endsWith(name, ".update")
            true -> Expr.ExprCall(name, resolvedArgs)
            false -> match isBuiltinCallName(name)
                true -> Expr.ExprCallBuiltin(name, resolvedArgs)
                false -> Expr.ExprCall(name, resolvedArgs)

fn isBuiltinCallName(name: String) -> Bool
    ? "Return whether a call name is one of the exact builtin/service entrypoints."
    isBuiltinCallNameFrom(name, [
        "Args.get",
        "Bool.and",
        "Bool.not",
        "Bool.or",
        "Byte.fromHex",
        "Byte.toHex",
        "Char.fromCode",
        "Char.toCode",
        "Console.error",
        "Console.print",
        "Console.readLine",
        "Console.warn",
        "Disk.appendText",
        "Disk.delete",
        "Disk.deleteDir",
        "Disk.exists",
        "Disk.listDir",
        "Disk.makeDir",
        "Disk.readText",
        "Disk.writeText",
        "Env.get",
        "Env.set",
        "Float.abs",
        "Float.atan2",
        "Float.ceil",
        "Float.cos",
        "Float.floor",
        "Float.fromInt",
        "Float.fromString",
        "Float.max",
        "Float.min",
        "Float.pi",
        "Float.pow",
        "Float.round",
        "Float.sin",
        "Float.sqrt",
        "Float.toString",
        "Http.delete",
        "Http.get",
        "Http.head",
        "Http.patch",
        "Http.post",
        "Http.put",
        "HttpServer.listen",
        "HttpServer.listenWith",
        "Int.abs",
        "Int.fromString",
        "Int.max",
        "Int.min",
        "Int.mod",
        "Int.toFloat",
        "Int.toString",
        "List.concat",
        "List.contains",
        "List.head",
        "List.len",
        "List.prepend",
        "List.reverse",
        "List.tail",
        "List.zip",
        "Map.empty",
        "Map.entries",
        "Map.fromList",
        "Map.get",
        "Map.has",
        "Map.keys",
        "Map.remove",
        "Map.set",
        "Map.size",
        "Map.values",
        "Option.None",
        "Option.Some",
        "Option.toResult",
        "Option.withDefault",
        "Random.int",
        "Result.Err",
        "Result.Ok",
        "Result.withDefault",
        "SelfHostRuntime.httpServerListen",
        "SelfHostRuntime.httpServerListenWith",
        "String.charAt",
        "String.chars",
        "String.contains",
        "String.endsWith",
        "String.fromBool",
        "String.fromFloat",
        "String.fromInt",
        "String.join",
        "String.len",
        "String.repeat",
        "String.replace",
        "String.slice",
        "String.split",
        "String.startsWith",
        "String.toLower",
        "String.toUpper",
        "String.trim",
        "Tcp.close",
        "Tcp.connect",
        "Tcp.ping",
        "Tcp.readLine",
        "Tcp.send",
        "Tcp.writeLine",
        "Terminal.clear",
        "Terminal.disableRawMode",
        "Terminal.enableRawMode",
        "Terminal.flush",
        "Terminal.hideCursor",
        "Terminal.moveTo",
        "Terminal.print",
        "Terminal.readKey",
        "Terminal.resetColor",
        "Terminal.setColor",
        "Terminal.showCursor",
        "Terminal.size",
        "Time.now",
        "Time.sleep",
        "Time.unixMs",
        "Vector.fromList",
        "Vector.get",
        "Vector.len",
        "Vector.new",
        "Vector.set",
        "Vector.toList",
    ])

verify isBuiltinCallName
    isBuiltinCallName("Map.get") => true
    isBuiltinCallName("Map.buildRowAcc") => false
    isBuiltinCallName("Main.initGame") => false

fn isBuiltinCallNameFrom(name: String, knownNames: List<String>) -> Bool
    ? "Check builtin/service call names recursively by exact match."
    match knownNames
        [] -> false
        [knownName, ..rest] -> match name == knownName
            true -> true
            false -> isBuiltinCallNameFrom(name, rest)

fn resolveCallsInExprs(exprs: List<Expr>, fnMap: Map<String, FnDef>, acc: List<Expr>) -> List<Expr>
    match exprs
        [] -> List.reverse(acc)
        [e, ..rest] -> resolveCallsInExprs(rest, fnMap, List.prepend(resolveCallsInExpr(e, fnMap), acc))

fn resolveCallsInArms(arms: List<MatchArm>, fnMap: Map<String, FnDef>, acc: List<MatchArm>) -> List<MatchArm>
    match arms
        [] -> List.reverse(acc)
        [arm, ..rest] -> resolveCallsInArms(rest, fnMap, List.prepend(MatchArm(pattern = arm.pattern, body = resolveCallsInExpr(arm.body, fnMap), bindingSlots = arm.bindingSlots), acc))

fn resolveCallsInFields(fields: List<(String, Expr)>, fnMap: Map<String, FnDef>, acc: List<(String, Expr)>) -> List<(String, Expr)>
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (name, expr) -> resolveCallsInFields(rest, fnMap, List.prepend((name, resolveCallsInExpr(expr, fnMap)), acc))

fn annotateFastFns(fns: List<FnDef>, acc: List<FnDef>) -> List<FnDef>
    ? "Tag simple single-expression functions so eval can skip the stmt walker."
    match fns
        [] -> List.reverse(acc)
        [f, ..rest] -> annotateFastFns(rest, List.prepend(annotateFastFn(f), acc))

fn annotateFastFn(fd: FnDef) -> FnDef
    ? "Attach a narrow fast-path tag to a function definition."
    FnDef(name = fd.name, params = fd.params, body = fd.body, slotCount = fd.slotCount, slotMap = fd.slotMap, fastPath = classifyFastPath(fd.body))

fn rewriteInternalFns(fns: List<FnDef>, acc: List<FnDef>) -> List<FnDef>
    ? "Rewrite resolved AST into lighter internal expression shapes without changing semantics."
    match fns
        [] -> List.reverse(acc)
        [f, ..rest] -> rewriteInternalFns(rest, List.prepend(rewriteInternalFn(f), acc))

fn rewriteInternalFn(fd: FnDef) -> FnDef
    ? "Rewrite the body of one resolved function into lighter internal expression shapes."
    FnDef(name = fd.name, params = fd.params, body = rewriteInternalStmts(fd.body, []), slotCount = fd.slotCount, slotMap = fd.slotMap, fastPath = fd.fastPath)

fn rewriteInternalStmts(stmts: List<Stmt>, acc: List<Stmt>) -> List<Stmt>
    ? "Rewrite statements recursively into lighter internal expression shapes."
    match stmts
        [] -> List.reverse(acc)
        [stmt, ..rest] -> rewriteInternalStmts(rest, List.prepend(rewriteInternalStmt(stmt), acc))

fn rewriteInternalStmt(stmt: Stmt) -> Stmt
    ? "Rewrite one statement recursively into lighter internal expression shapes."
    match stmt
        Stmt.StmtBind(name, expr) -> Stmt.StmtBind(name, rewriteInternalExpr(expr))
        Stmt.StmtBindSlot(slot, expr) -> Stmt.StmtBindSlot(slot, rewriteInternalExpr(expr))
        Stmt.StmtExpr(expr) -> Stmt.StmtExpr(rewriteInternalExpr(expr))

fn rewriteInternalExpr(expr: Expr) -> Expr
    ? "Rewrite one expression into lighter internal forms after resolve and direct-call linking."
    match expr
        Expr.ExprBoolBranch(cond, thenExpr, elseExpr) -> Expr.ExprBoolBranch(rewriteInternalExpr(cond), rewriteInternalExpr(thenExpr), rewriteInternalExpr(elseExpr))
        Expr.ExprBinopSlotInt(_, _, _) -> expr
        Expr.ExprBinopSlots(_, _, _) -> expr
        Expr.ExprCmpSlotInt(_, _, _) -> expr
        Expr.ExprCmpSlots(_, _, _) -> expr
        Expr.ExprVectorGetOrInt(vecExpr, idxExpr, defaultValue) -> Expr.ExprVectorGetOrInt(rewriteInternalExpr(vecExpr), rewriteInternalExpr(idxExpr), defaultValue)
        Expr.ExprIntModOrInt(a, b, defaultValue) -> Expr.ExprIntModOrInt(rewriteInternalExpr(a), rewriteInternalExpr(b), defaultValue)
        Expr.ExprAdd(a, b) -> rewriteInternalBinop(BinOp.OpAdd, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprSub(a, b) -> rewriteInternalBinop(BinOp.OpSub, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprMul(a, b) -> rewriteInternalBinop(BinOp.OpMul, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprDiv(a, b) -> rewriteInternalBinop(BinOp.OpDiv, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprEq(a, b) -> rewriteInternalCmp(CmpOp.CmpEq, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprNeq(a, b) -> rewriteInternalCmp(CmpOp.CmpNeq, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprLt(a, b) -> rewriteInternalCmp(CmpOp.CmpLt, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprGt(a, b) -> rewriteInternalCmp(CmpOp.CmpGt, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprLte(a, b) -> rewriteInternalCmp(CmpOp.CmpLte, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprGte(a, b) -> rewriteInternalCmp(CmpOp.CmpGte, rewriteInternalExpr(a), rewriteInternalExpr(b))
        Expr.ExprMatch(scrutinee, arms) -> rewriteInternalMatch(rewriteInternalExpr(scrutinee), rewriteInternalArms(arms, []))
        Expr.ExprPropagate(inner) -> Expr.ExprPropagate(rewriteInternalExpr(inner))
        Expr.ExprConcat(parts) -> Expr.ExprConcat(rewriteInternalExprs(parts, []))
        Expr.ExprTuple(exprs) -> Expr.ExprTuple(rewriteInternalExprs(exprs, []))
        Expr.ExprList(exprs) -> Expr.ExprList(rewriteInternalExprs(exprs, []))
        Expr.ExprRecord(name, fields) -> Expr.ExprRecord(name, rewriteInternalFields(fields, []))
        Expr.ExprFieldAccess(obj, field) -> Expr.ExprFieldAccess(rewriteInternalExpr(obj), field)
        Expr.ExprCall(name, args) -> Expr.ExprCall(name, rewriteInternalExprs(args, []))
        Expr.ExprCallDirect(name, args) -> Expr.ExprCallDirect(name, rewriteInternalExprs(args, []))
        Expr.ExprCallBuiltin(name, args) -> rewriteInternalBuiltin(name, rewriteInternalExprs(args, []))
        _ -> expr

fn rewriteInternalExprs(exprs: List<Expr>, acc: List<Expr>) -> List<Expr>
    ? "Rewrite a list of expressions recursively."
    match exprs
        [] -> List.reverse(acc)
        [expr, ..rest] -> rewriteInternalExprs(rest, List.prepend(rewriteInternalExpr(expr), acc))

fn rewriteInternalFields(fields: List<(String, Expr)>, acc: List<(String, Expr)>) -> List<(String, Expr)>
    ? "Rewrite record field expressions recursively."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (name, expr) -> rewriteInternalFields(rest, List.prepend((name, rewriteInternalExpr(expr)), acc))

fn rewriteInternalArms(arms: List<MatchArm>, acc: List<MatchArm>) -> List<MatchArm>
    ? "Rewrite match arm bodies recursively."
    match arms
        [] -> List.reverse(acc)
        [arm, ..rest] -> rewriteInternalArms(rest, List.prepend(MatchArm(pattern = arm.pattern, body = rewriteInternalExpr(arm.body), bindingSlots = arm.bindingSlots), acc))

fn rewriteInternalBinop(op: BinOp, left: Expr, right: Expr) -> Expr
    ? "Compress simple resolved arithmetic into slot-based internal nodes."
    match left
        Expr.ExprSlot(slot) -> rewriteInternalBinopSlotLeft(op, slot, right)
        _ -> match right
            Expr.ExprSlot(slot) -> rewriteInternalBinopSlotRight(op, left, slot)
            _ -> rebuildInternalBinop(op, left, right)

fn rewriteInternalBinopSlotLeft(op: BinOp, slot: Int, right: Expr) -> Expr
    ? "Rewrite arithmetic with a slot on the left when the right side is simple."
    match right
        Expr.ExprInt(n) -> Expr.ExprBinopSlotInt(op, slot, n)
        Expr.ExprSlot(rhs) -> Expr.ExprBinopSlots(op, slot, rhs)
        _ -> rebuildInternalBinop(op, Expr.ExprSlot(slot), right)

fn rewriteInternalBinopSlotRight(op: BinOp, left: Expr, slot: Int) -> Expr
    ? "Rewrite commutative arithmetic when the slot appears on the right."
    match left
        Expr.ExprSlot(lhs) -> Expr.ExprBinopSlots(op, lhs, slot)
        Expr.ExprInt(n) -> match binopCanFlip(op)
            true -> Expr.ExprBinopSlotInt(op, slot, n)
            false -> rebuildInternalBinop(op, left, Expr.ExprSlot(slot))
        _ -> rebuildInternalBinop(op, left, Expr.ExprSlot(slot))

fn rebuildInternalBinop(op: BinOp, left: Expr, right: Expr) -> Expr
    ? "Rebuild a generic arithmetic expression when no narrower internal form applies."
    match op
        BinOp.OpAdd -> Expr.ExprAdd(left, right)
        BinOp.OpSub -> Expr.ExprSub(left, right)
        BinOp.OpMul -> Expr.ExprMul(left, right)
        BinOp.OpDiv -> Expr.ExprDiv(left, right)

fn binopCanFlip(op: BinOp) -> Bool
    ? "Return whether swapping operand order preserves arithmetic semantics."
    match op
        BinOp.OpAdd -> true
        BinOp.OpMul -> true
        _ -> false

fn rewriteInternalBuiltin(name: String, args: List<Expr>) -> Expr
    ? "Recognize fused builtin wrapper patterns after children have already been rewritten."
    match name
        "Option.withDefault" -> rewriteInternalOptionWithDefault(args)
        "Result.withDefault" -> rewriteInternalResultWithDefault(args)
        _ -> Expr.ExprCallBuiltin(name, args)

fn rewriteInternalOptionWithDefault(args: List<Expr>) -> Expr
    ? "Rewrite Option.withDefault(Vector.get(...), int) into one internal node."
    match args
        [optionExpr, ..rest] -> match rest
            [defaultExpr, ..ignored] -> rewriteInternalOptionWithDefaultArgs(optionExpr, defaultExpr)
            _ -> Expr.ExprCallBuiltin("Option.withDefault", args)
        _ -> Expr.ExprCallBuiltin("Option.withDefault", args)

fn rewriteInternalOptionWithDefaultArgs(optionExpr: Expr, defaultExpr: Expr) -> Expr
    ? "Recognize a fused Vector.get-with-default shape."
    match defaultExpr
        Expr.ExprInt(defaultValue) -> match optionExpr
            Expr.ExprCallBuiltin(name, innerArgs) -> match name == "Vector.get"
                true -> rewriteInternalVectorGetOrInt(innerArgs, defaultValue)
                false -> Expr.ExprCallBuiltin("Option.withDefault", [optionExpr, defaultExpr])
            _ -> Expr.ExprCallBuiltin("Option.withDefault", [optionExpr, defaultExpr])
        _ -> Expr.ExprCallBuiltin("Option.withDefault", [optionExpr, defaultExpr])

fn rewriteInternalVectorGetOrInt(args: List<Expr>, defaultValue: Int) -> Expr
    ? "Fuse Vector.get(vec, idx) with an integer fallback."
    match args
        [vecExpr, ..rest] -> match rest
            [idxExpr, ..ignored] -> rewriteInternalVectorGetOrIntArgs(vecExpr, idxExpr, defaultValue)
            _ -> Expr.ExprCallBuiltin("Option.withDefault", [Expr.ExprCallBuiltin("Vector.get", args), Expr.ExprInt(defaultValue)])
        _ -> Expr.ExprCallBuiltin("Option.withDefault", [Expr.ExprCallBuiltin("Vector.get", args), Expr.ExprInt(defaultValue)])

fn rewriteInternalVectorGetOrIntArgs(vecExpr: Expr, idxExpr: Expr, defaultValue: Int) -> Expr
    ? "Only fuse Vector.get-with-default when at least one operand is already slot-shaped."
    match exprHasSlotShape(vecExpr)
        true -> Expr.ExprVectorGetOrInt(vecExpr, idxExpr, defaultValue)
        false -> match exprHasSlotShape(idxExpr)
            true -> Expr.ExprVectorGetOrInt(vecExpr, idxExpr, defaultValue)
            false -> Expr.ExprCallBuiltin("Option.withDefault", [Expr.ExprCallBuiltin("Vector.get", [vecExpr, idxExpr]), Expr.ExprInt(defaultValue)])

fn rewriteInternalResultWithDefault(args: List<Expr>) -> Expr
    ? "Rewrite Result.withDefault(Int.mod(...), int) into one internal node."
    match args
        [resultExpr, ..rest] -> match rest
            [defaultExpr, ..ignored] -> rewriteInternalResultWithDefaultArgs(resultExpr, defaultExpr)
            _ -> Expr.ExprCallBuiltin("Result.withDefault", args)
        _ -> Expr.ExprCallBuiltin("Result.withDefault", args)

fn rewriteInternalResultWithDefaultArgs(resultExpr: Expr, defaultExpr: Expr) -> Expr
    ? "Recognize a fused Int.mod-with-default shape."
    match defaultExpr
        Expr.ExprInt(defaultValue) -> match resultExpr
            Expr.ExprCallBuiltin(name, innerArgs) -> match name == "Int.mod"
                true -> rewriteInternalIntModOrInt(innerArgs, defaultValue)
                false -> Expr.ExprCallBuiltin("Result.withDefault", [resultExpr, defaultExpr])
            _ -> Expr.ExprCallBuiltin("Result.withDefault", [resultExpr, defaultExpr])
        _ -> Expr.ExprCallBuiltin("Result.withDefault", [resultExpr, defaultExpr])

fn rewriteInternalIntModOrInt(args: List<Expr>, defaultValue: Int) -> Expr
    ? "Fuse Int.mod(a, b) with an integer fallback when the operands are slot-shaped."
    match args
        [a, ..rest] -> match rest
            [b, ..ignored] -> rewriteInternalIntModOrIntArgs(a, b, defaultValue)
            _ -> Expr.ExprCallBuiltin("Result.withDefault", [Expr.ExprCallBuiltin("Int.mod", args), Expr.ExprInt(defaultValue)])
        _ -> Expr.ExprCallBuiltin("Result.withDefault", [Expr.ExprCallBuiltin("Int.mod", args), Expr.ExprInt(defaultValue)])

fn rewriteInternalIntModOrIntArgs(a: Expr, b: Expr, defaultValue: Int) -> Expr
    ? "Only fuse Int.mod-with-default when at least one operand is already slot-shaped."
    match exprHasSlotShape(a)
        true -> Expr.ExprIntModOrInt(a, b, defaultValue)
        false -> match exprHasSlotShape(b)
            true -> Expr.ExprIntModOrInt(a, b, defaultValue)
            false -> Expr.ExprCallBuiltin("Result.withDefault", [Expr.ExprCallBuiltin("Int.mod", [a, b]), Expr.ExprInt(defaultValue)])

fn exprHasSlotShape(expr: Expr) -> Bool
    ? "Return whether an expression is already in a slot-based internal shape worth fusing around."
    match expr
        Expr.ExprSlot(_) -> true
        Expr.ExprBinopSlotInt(_, _, _) -> true
        Expr.ExprBinopSlots(_, _, _) -> true
        Expr.ExprCmpSlotInt(_, _, _) -> true
        Expr.ExprCmpSlots(_, _, _) -> true
        Expr.ExprVectorGetOrInt(_, _, _) -> true
        Expr.ExprIntModOrInt(_, _, _) -> true
        _ -> false

fn rewriteInternalCmp(op: CmpOp, left: Expr, right: Expr) -> Expr
    ? "Compress simple resolved comparisons into slot-based internal nodes."
    match left
        Expr.ExprSlot(slot) -> rewriteInternalCmpSlotLeft(op, slot, right)
        _ -> match right
            Expr.ExprSlot(slot) -> rewriteInternalCmpSlotRight(op, left, slot)
            _ -> rebuildInternalCmp(op, left, right)

fn rewriteInternalCmpSlotLeft(op: CmpOp, slot: Int, right: Expr) -> Expr
    ? "Rewrite comparisons with a slot on the left when the right side is simple."
    match right
        Expr.ExprInt(n) -> Expr.ExprCmpSlotInt(op, slot, n)
        Expr.ExprSlot(rhs) -> Expr.ExprCmpSlots(op, slot, rhs)
        _ -> rebuildInternalCmp(op, Expr.ExprSlot(slot), right)

fn rewriteInternalCmpSlotRight(op: CmpOp, left: Expr, slot: Int) -> Expr
    ? "Rewrite comparisons with a slot on the right when the left side is a simple integer."
    match left
        Expr.ExprInt(n) -> Expr.ExprCmpSlotInt(flipCmp(op), slot, n)
        Expr.ExprSlot(lhs) -> Expr.ExprCmpSlots(op, lhs, slot)
        _ -> rebuildInternalCmp(op, left, Expr.ExprSlot(slot))

fn rebuildInternalCmp(op: CmpOp, left: Expr, right: Expr) -> Expr
    ? "Rebuild a generic comparison expression when no narrower internal form applies."
    match op
        CmpOp.CmpEq -> Expr.ExprEq(left, right)
        CmpOp.CmpNeq -> Expr.ExprNeq(left, right)
        CmpOp.CmpLt -> Expr.ExprLt(left, right)
        CmpOp.CmpGt -> Expr.ExprGt(left, right)
        CmpOp.CmpLte -> Expr.ExprLte(left, right)
        CmpOp.CmpGte -> Expr.ExprGte(left, right)

fn flipCmp(op: CmpOp) -> CmpOp
    ? "Flip a comparison when swapping operand order."
    match op
        CmpOp.CmpEq -> CmpOp.CmpEq
        CmpOp.CmpNeq -> CmpOp.CmpNeq
        CmpOp.CmpLt -> CmpOp.CmpGt
        CmpOp.CmpGt -> CmpOp.CmpLt
        CmpOp.CmpLte -> CmpOp.CmpGte
        CmpOp.CmpGte -> CmpOp.CmpLte

fn rewriteInternalMatch(scrutinee: Expr, arms: List<MatchArm>) -> Expr
    ? "Rewrite simple bool matches into a direct branch node."
    match rewriteBoolMatchArms(arms)
        Option.Some(pair) -> match pair
            (thenExpr, elseExpr) -> Expr.ExprBoolBranch(scrutinee, thenExpr, elseExpr)
        Option.None -> Expr.ExprMatch(scrutinee, arms)

fn rewriteBoolMatchArms(arms: List<MatchArm>) -> Option<(Expr, Expr)>
    ? "Extract (thenExpr, elseExpr) from a two-arm bool match regardless of arm order."
    match arms
        [arm1, ..rest] -> match rest
            [arm2, ..tail] -> match tail == []
                true -> rewriteBoolMatchArmPair(arm1, arm2)
                false -> Option.None
            _ -> Option.None
        _ -> Option.None

fn rewriteBoolMatchArmPair(arm1: MatchArm, arm2: MatchArm) -> Option<(Expr, Expr)>
    ? "Order two complementary bool arms into (trueExpr, falseExpr)."
    match arm1.pattern
        Pattern.PatBool(b1) -> rewriteBoolMatchArmPairInner(b1, arm1.body, arm2.pattern, arm2.body)
        _ -> Option.None

fn rewriteBoolMatchArmPairInner(b1: Bool, body1: Expr, p2: Pattern, body2: Expr) -> Option<(Expr, Expr)>
    ? "Finish ordering bool arms once the first pattern bool is known."
    match p2
        Pattern.PatBool(b2) -> rewriteBoolMatchArmPairBools(b1, body1, b2, body2)
        _ -> Option.None

fn rewriteBoolMatchArmPairBools(b1: Bool, body1: Expr, b2: Bool, body2: Expr) -> Option<(Expr, Expr)>
    ? "Return ordered bool branch bodies when the pair is exactly true/false or false/true."
    match b1 == true
        true -> match b2 == false
            true -> Option.Some((body1, body2))
            false -> Option.None
        false -> match b1 == false
            true -> match b2 == true
                true -> Option.Some((body2, body1))
                false -> Option.None
            false -> Option.None

fn classifyFastPath(body: List<Stmt>) -> FnFastPath
    ? "Single expression bodies can bypass evalStmts* and evaluate the expr directly."
    match body
        [stmt, ..rest] -> match rest == []
            true -> classifyFastStmt(stmt)
            false -> FnFastPath.FastNone
        _ -> FnFastPath.FastNone

fn classifyFastStmt(stmt: Stmt) -> FnFastPath
    ? "Only plain expression bodies get a fast expr tag."
    match stmt
        Stmt.StmtExpr(expr) -> classifyFastExpr(expr)
        _ -> FnFastPath.FastNone

fn classifyFastExpr(expr: Expr) -> FnFastPath
    ? "Recognize a few leaf-like and branch-like expr shapes worth running without the full stmt walker."
    match classifyFastLeafExpr(expr)
        Option.Some(leaf) -> FnFastPath.FastLeaf(leaf)
        Option.None -> match expr
            Expr.ExprMatch(scrutinee, arms) -> classifyFastMatch(scrutinee, arms)
            _ -> FnFastPath.FastSingleExpr

fn classifyFastLeafExpr(expr: Expr) -> Option<FastLeaf>
    ? "Recognize a leaf-like expr that can be executed without descending the AST."
    match expr
        Expr.ExprInt(n) -> Option.Some(FastLeaf.LeafConstInt(n))
        Expr.ExprFloat(f) -> Option.Some(FastLeaf.LeafConstFloat(f))
        Expr.ExprStr(s) -> Option.Some(FastLeaf.LeafConstStr(s))
        Expr.ExprBool(b) -> Option.Some(FastLeaf.LeafConstBool(b))
        Expr.ExprSlot(slot) -> Option.Some(FastLeaf.LeafSlot(slot))
        Expr.ExprCallBuiltin(name, args) -> classifyFastBuiltinLeaf(name, args)
        _ -> Option.None

fn classifyFastBuiltinLeaf(name: String, args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize tiny builtin wrappers that only shuffle slots and integer constants."
    match name == "Vector.new"
        true -> classifyFastVectorNew(args)
        false -> match name == "Option.withDefault"
            true -> classifyFastOptionWithDefault(args)
            false -> Option.None

fn classifyFastVectorNew(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Vector.new(slot, int) wrappers."
    match args
        [sizeExpr, ..rest] -> match rest
            [fillExpr, ..ignored] -> classifyFastVectorNewArgs(sizeExpr, fillExpr)
            _ -> Option.None
        _ -> Option.None

fn classifyFastVectorNewArgs(sizeExpr: Expr, fillExpr: Expr) -> Option<FastLeaf>
    ? "Encode Vector.new(slot, int) without keeping the whole AST around."
    match sizeExpr
        Expr.ExprSlot(sizeSlot) -> match fillExpr
            Expr.ExprInt(fill) -> Option.Some(FastLeaf.LeafVectorNew(sizeSlot, fill))
            _ -> Option.None
        _ -> Option.None

fn classifyFastOptionWithDefault(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Option.withDefault(Vector.get(slot, slot), int)."
    match args
        [optionExpr, ..rest] -> match rest
            [defaultExpr, ..ignored] -> classifyFastOptionWithDefaultArgs(optionExpr, defaultExpr)
            _ -> Option.None
        _ -> Option.None

fn classifyFastOptionWithDefaultArgs(optionExpr: Expr, defaultExpr: Expr) -> Option<FastLeaf>
    ? "Encode the common Vector.get-with-default wrapper used in tiny helpers like cellAt."
    match optionExpr
        Expr.ExprCallBuiltin(name, innerArgs) -> match name == "Vector.get"
            true -> classifyFastVectorGet(innerArgs, defaultExpr)
            false -> Option.None
        _ -> Option.None

fn classifyFastVectorGet(args: List<Expr>, defaultExpr: Expr) -> Option<FastLeaf>
    ? "Recognize Vector.get(slotVec, slotIdx) with an integer default."
    match args
        [vecExpr, ..rest] -> match rest
            [idxExpr, ..ignored] -> classifyFastVectorGetArgs(vecExpr, idxExpr, defaultExpr)
            _ -> Option.None
        _ -> Option.None

fn classifyFastVectorGetArgs(vecExpr: Expr, idxExpr: Expr, defaultExpr: Expr) -> Option<FastLeaf>
    ? "Encode Vector.get(slotVec, slotIdx) with an integer fallback."
    match vecExpr
        Expr.ExprSlot(vecSlot) -> match idxExpr
            Expr.ExprSlot(idxSlot) -> match defaultExpr
                Expr.ExprInt(defaultValue) -> Option.Some(FastLeaf.LeafVectorGetOrInt(vecSlot, idxSlot, defaultValue))
                _ -> Option.None
            _ -> Option.None
        _ -> Option.None

fn classifyFastMatch(scrutinee: Expr, arms: List<MatchArm>) -> FnFastPath
    ? "Recognize a small fixed-shape branch over bools or slot-based comparisons."
    match classifyBoolArms(arms)
        Option.Some(pair) -> match pair
            (thenLeaf, elseLeaf) -> classifyFastMatchScrutinee(scrutinee, thenLeaf, elseLeaf)
        Option.None -> FnFastPath.FastSingleExpr

fn classifyBoolArms(arms: List<MatchArm>) -> Option<(FastLeaf, FastLeaf)>
    ? "Extract (then, else) leaves from a two-arm bool match, regardless of arm order."
    match arms
        [arm1, ..rest] -> match rest
            [arm2, ..tail] -> match tail == []
                true -> classifyBoolArmPair(arm1, arm2)
                false -> Option.None
            _ -> Option.None
        _ -> Option.None

fn classifyBoolArmPair(arm1: MatchArm, arm2: MatchArm) -> Option<(FastLeaf, FastLeaf)>
    ? "Convert two bool-pattern arms into ordered leaves."
    leaf1 = classifyFastLeafExpr(arm1.body)
    leaf2 = classifyFastLeafExpr(arm2.body)
    match leaf1
        Option.Some(v1) -> match leaf2
            Option.Some(v2) -> classifyBoolArmPatterns(arm1.pattern, v1, arm2.pattern, v2)
            Option.None -> Option.None
        Option.None -> Option.None

fn classifyBoolArmPatterns(p1: Pattern, leaf1: FastLeaf, p2: Pattern, leaf2: FastLeaf) -> Option<(FastLeaf, FastLeaf)>
    ? "Order bool match arms into (trueLeaf, falseLeaf)."
    match p1
        Pattern.PatBool(b1) -> classifyBoolArmPatternsInner(b1, leaf1, p2, leaf2)
        _ -> Option.None

fn classifyBoolArmPatternsInner(b1: Bool, leaf1: FastLeaf, p2: Pattern, leaf2: FastLeaf) -> Option<(FastLeaf, FastLeaf)>
    ? "Finish ordering bool match arms once the first arm bool is extracted."
    match p2
        Pattern.PatBool(b2) -> classifyBoolArmPatternsPair(b1, leaf1, b2, leaf2)
        _ -> Option.None

fn classifyBoolArmPatternsPair(b1: Bool, leaf1: FastLeaf, b2: Bool, leaf2: FastLeaf) -> Option<(FastLeaf, FastLeaf)>
    ? "Return (trueLeaf, falseLeaf) when the two bool arms are complementary."
    match b1 == true
        true -> match b2 == false
            true -> Option.Some((leaf1, leaf2))
            false -> Option.None
        false -> match b1 == false
            true -> match b2 == true
                true -> Option.Some((leaf2, leaf1))
                false -> Option.None
            false -> Option.None

fn classifyFastMatchScrutinee(scrutinee: Expr, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> FnFastPath
    ? "Encode a recognized branch scrutinee with preclassified leaves."
    match scrutinee
        Expr.ExprSlot(slot) -> FnFastPath.FastBoolSlotBranch(slot, thenLeaf, elseLeaf)
        Expr.ExprEq(a, b) -> classifyFastEqScrutinee(a, b, thenLeaf, elseLeaf)
        Expr.ExprLt(a, b) -> classifyFastLtScrutinee(a, b, thenLeaf, elseLeaf)
        Expr.ExprGt(a, b) -> classifyFastLtScrutinee(b, a, thenLeaf, elseLeaf)
        _ -> FnFastPath.FastSingleExpr

fn classifyFastEqScrutinee(a: Expr, b: Expr, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> FnFastPath
    ? "Recognize slot == int/string in either operand order."
    match a
        Expr.ExprSlot(slot) -> classifyFastEqOther(slot, b, thenLeaf, elseLeaf)
        _ -> match b
            Expr.ExprSlot(slot) -> classifyFastEqOther(slot, a, thenLeaf, elseLeaf)
            _ -> FnFastPath.FastSingleExpr

fn classifyFastEqOther(slot: Int, other: Expr, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> FnFastPath
    ? "Encode equality against a constant once the slot side is known."
    match other
        Expr.ExprInt(n) -> FnFastPath.FastEqIntBranch(slot, n, thenLeaf, elseLeaf)
        Expr.ExprStr(s) -> FnFastPath.FastEqStringBranch(slot, s, thenLeaf, elseLeaf)
        _ -> FnFastPath.FastSingleExpr

fn classifyFastLtScrutinee(a: Expr, b: Expr, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> FnFastPath
    ? "Recognize slot < slot branches like minInt."
    match a
        Expr.ExprSlot(lhs) -> match b
            Expr.ExprSlot(rhs) -> FnFastPath.FastLtIntSlotsBranch(lhs, rhs, thenLeaf, elseLeaf)
            _ -> FnFastPath.FastSingleExpr
        _ -> FnFastPath.FastSingleExpr
