module Node
    intent = "Fixture: a process reads frames; another dependency also declares Heard."
    depends [Wire, Other, Sockets]
    effects [Console.print, Wire.frame, yield]

fn reader() -> Unit
    ? "Reads until the wire is gone."
    ! [Console.print, Wire.frame, yield]
    _quiet = Other.quiet()
    match Wire.frame()
        Wire.Heard.Message(text) -> reader()
        Wire.Heard.Gone(why) -> Console.print("gone {why}")
