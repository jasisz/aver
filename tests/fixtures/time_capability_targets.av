module TimeCapabilityTargets
    intent = "Exercises the one standard Time contract on every shipped execution target."
    effects [Time.now, Time.unixMs, Time.sleep]

fn main() -> Int
    ! [Time.now, Time.unixMs, Time.sleep]
    stamp = Time.now()
    _epoch = Time.unixMs()
    Time.sleep(0)
    String.len(stamp)
