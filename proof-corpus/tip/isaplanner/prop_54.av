module Prop54
    intent =
        "TIP isaplanner prop_54: (m + n) - n = m for Peano addition and truncated subtraction."
    effects []

type Nat
    Z
    S(Nat)

fn minus(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> Nat.Z
        Nat.S(z) -> match y
            Nat.Z -> x
            Nat.S(x2) -> minus(z, x2)

fn plus(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> y
        Nat.S(z) -> Nat.S(plus(z, y))

verify minus law plusMinusCancel
    given m: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given n: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    minus(plus(m, n), n) => m
