module Node
    intent = "The follow slice as processes: a peer, a walk, an accepting process, a dialling process and a ticker, with three policies over one view. The loop between them is generated."
    depends [Bytes, Wait, Work, Wire, Pool, Blocks, Chain, Clock, Validation, Sockets, Ledger, Clocked]
    effects [Wire.accept, Wire.dialled, Wire.read, Wire.write, Wire.writes, Pool.claim, Pool.gone, Pool.joined, Pool.swept, Blocks.deliver, Blocks.body, Chain.nextTarget, Chain.commit, Clock.tick, Console.print, yield]
    exposes [Pending, View, order, admit, stop]

type Pending
    Accepting(Int, Wait.Wake)
    Dialling(Int, Wait.Wake)
    Ticker(Int, Wait.Wake)
    Peer(Int, Wait.Wake)
    Walk(Int, Wait.Wake)

record View
    pending: Map<Int, Pending>
    ready: List<Int>
    askable: List<Int>
    jobs: Int
    room: Int
    stopping: Bool

fn accepting() -> Unit
    ? "Every peer the listener hands over, seated in the pool, until the listener closes."
    ! [Wire.accept, Pool.joined, yield]
    match Wire.accept()
        Wire.Arrival.Closed -> Unit
        Wire.Arrival.Peer(key) -> match Pool.joined(key)
            Pool.Welcome.Seated -> accepting()
            Pool.Welcome.Refused -> accepting()

fn dialling() -> Unit
    ? "Every dial that settles, seated in the pool, until no dial is outstanding."
    ! [Wire.dialled, Pool.joined, yield]
    match Wire.dialled()
        Wire.Arrival.Closed -> Unit
        Wire.Arrival.Peer(key) -> match Pool.joined(key)
            Pool.Welcome.Seated -> dialling()
            Pool.Welcome.Refused -> dialling()

fn ticker() -> Unit
    ? "One sweep of the pool per tick, until the clock closes, which is when it says how often the deadline let it be asked."
    ! [Clock.tick, Pool.swept, Console.print, yield]
    match Clock.tick()
        Clock.Tick.Closed(asks) -> reported(asks)
        Clock.Tick.Tock -> match Pool.swept()
            Pool.Sweep.Swept(_) -> ticker()

fn reported(asks: Int) -> Unit
    ? "What the clock did over this run, once it has closed."
    ! [Console.print]
    Console.print("ticker: asked {asks} times")

fn peer() -> Unit
    ? "Ask the pool what to fetch, let the helper fetch it, go round; a peer the helper could not finish with is handed back. It is the process that used the wire, so it is the one that says what the wire did once there is nothing left to fetch."
    ! [Pool.claim, Pool.gone, Wire.write, Wire.read, Wire.writes, Blocks.deliver, Console.print, yield]
    Console.print("peer: asking the pool for work")
    match Pool.claim()
        Pool.Assignment.Stop -> reportWire(Wire.writes())
        Pool.Assignment.Work(key, height) -> match fetchBody(key, height)
            true -> peer()
            false -> Pool.gone(key)

fn fetchBody(key: Int, height: Int) -> Bool
    ? "One body from one peer: the write, the read and the hand-over. True when the body landed, false when anything on the way said this peer is finished."
    ! [Wire.write, Wire.read, Blocks.deliver, yield]
    match Wire.write(key, Ledger.blockOf(height))
        Result.Err(_) -> false
        Result.Ok(_) -> match Wire.read(key, 4000000, 30000)
            Wire.Heard.EndOfStream -> false
            Wire.Heard.Failed(_) -> false
            Wire.Heard.TimedOut -> false
            Wire.Heard.Data(raw) -> match Blocks.deliver(key, height, raw)
                Blocks.Receipt.Accepted -> true
                Blocks.Receipt.Refused(_) -> false

fn reportWire(tally: Wire.Tally) -> Unit
    ? "What the wire did over this run: how many payloads it wrote, how many asks the writes took, and how many asks the reads took."
    ! [Console.print]
    match tally
        Wire.Tally.Counted(payloads, writeAsks, readAsks) -> counted(payloads, writeAsks, readAsks)

fn counted(payloads: Int, writeAsks: Int, readAsks: Int) -> Unit
    ? "The one line the wire's own process ends with."
    ! [Console.print]
    Console.print("sockets: {payloads} payloads took {writeAsks} asks and {readAsks} reads")

fn walk() -> Unit
    ? "One connected block per turn: the next target, its validated body, the commit."
    ! [Chain.nextTarget, Blocks.body, Chain.commit, Console.print, yield]
    Console.print("walk: looking for the next block to connect")
    match Chain.nextTarget()
        Option.None -> Unit
        Option.Some(height) -> match Chain.commit(height, summary(Blocks.body(height)))
            Chain.Landed.Connected -> walk()
            Chain.Landed.Rejected(_) -> walk()

fn summary(block: Bytes) -> String
    ? "What a connected block is recorded as."
    "{Bytes.len(block)}"

fn order(view: View) -> List<Int>
    ? "Every seated process, in slot order. The loop asks admit about each one in turn."
    Map.keys(view.pending)

fn admit(view: View, id: Int) -> Bool
    ? "Whether to serve this id in this turn."
    match Map.get(view.pending, id)
        Option.None -> false
        Option.Some(marker) -> admitted(view, marker)

fn admitted(view: View, marker: Pending) -> Bool
    ? "A peer request is always admitted, whatever the job table looks like: the turn serves before it starts another job, so a ready peer is served first. Everything else steps aside once the run is stopping."
    match marker
        Pending.Peer(_, _) -> true
        Pending.Accepting(_, _) -> true
        Pending.Dialling(_, _) -> true
        Pending.Ticker(_, _) -> Bool.not(view.stopping)
        Pending.Walk(_, _) -> Bool.not(view.stopping)

fn stop(view: View) -> Bool
    ? "The run ends when the process asked us to, and not before: the flag was read by the turn and reaches here as data."
    view.stopping

fn isPeer(view: View, id: Int) -> Bool
    ? "Whether the slot under this id holds the peer process."
    match Map.get(view.pending, id)
        Option.None -> false
        Option.Some(marker) -> isPeerMarker(marker)

fn isPeerMarker(marker: Pending) -> Bool
    ? "Whether one marker stands for the peer process."
    match marker
        Pending.Peer(_, _) -> true
        Pending.Accepting(_, _) -> false
        Pending.Dialling(_, _) -> false
        Pending.Ticker(_, _) -> false
        Pending.Walk(_, _) -> false

fn busyView() -> View
    ? "One view with every process seated, a job running and no room for another."
    View(pending = Map.set(Map.set({}, 1, Pending.Peer(3, Wait.Wake.NextTurn)), 2, Pending.Walk(1, Wait.Wake.After(2))), ready = [2], askable = [1, 2], jobs = 1, room = 0, stopping = false)

fn quietView() -> View
    ? "One view with room for another job and nothing ready."
    View(pending = Map.set(Map.set({}, 1, Pending.Peer(1, Wait.Wake.NextTurn)), 3, Pending.Ticker(1, Wait.Wake.NextTurn)), ready = [], askable = [1, 3], jobs = 0, room = 1, stopping = false)

fn stoppingView() -> View
    ? "One view with a job running, no room for another and the run already stopping: what a peer is admitted against at the worst moment of a turn."
    View(pending = Map.set(Map.set({}, 1, Pending.Peer(5, Wait.Wake.NextTurn)), 2, Pending.Walk(2, Wait.Wake.NextTurn)), ready = [1], askable = [1, 2], jobs = 1, room = 0, stopping = true)

verify admit law readyPeerBeforeNewJob
    given view: View = [busyView(), quietView(), stoppingView()]
    given id: Int = [1, 2, 3]
    when isPeer(view, id)
    because isPeer(view, id)
    admit(view, id) => true

verify admitted
    admitted(busyView(), Pending.Peer(1, Wait.Wake.NextTurn)) => true
    admitted(busyView(), Pending.Accepting(1, Wait.Wake.NextTurn)) => true
    admitted(busyView(), Pending.Dialling(1, Wait.Wake.NextTurn)) => true
    admitted(busyView(), Pending.Ticker(1, Wait.Wake.NextTurn)) => true
    admitted(busyView(), Pending.Walk(1, Wait.Wake.NextTurn)) => true
    admitted(View(pending = {}, ready = [], askable = [], jobs = 0, room = 1, stopping = true), Pending.Walk(1, Wait.Wake.NextTurn)) => false
    admitted(View(pending = {}, ready = [], askable = [], jobs = 0, room = 1, stopping = true), Pending.Ticker(1, Wait.Wake.NextTurn)) => false

verify isPeer
    isPeer(busyView(), 1) => true
    isPeer(busyView(), 2) => false
    isPeer(busyView(), 9) => false

verify isPeerMarker
    isPeerMarker(Pending.Peer(1, Wait.Wake.NextTurn)) => true
    isPeerMarker(Pending.Accepting(1, Wait.Wake.NextTurn)) => false
    isPeerMarker(Pending.Dialling(1, Wait.Wake.NextTurn)) => false
    isPeerMarker(Pending.Ticker(1, Wait.Wake.NextTurn)) => false
    isPeerMarker(Pending.Walk(1, Wait.Wake.NextTurn)) => false
