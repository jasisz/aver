module Bench
    intent = "Bench Mandelbrot at various sizes."
    depends [Fractal]
    exposes [main]
    effects [Console.print, Time.unixMs]

fn main() -> Unit
    ! [Console.print, Time.unixMs]
    t0 = Time.unixMs()
    full = Fractal.render(100, 24, 80, Fractal.fullView())
    t1 = Time.unixMs()
    zoom = Fractal.render(100, 24, 200, Fractal.seahorseView())
    t2 = Time.unixMs()
    Console.print("full(100x24,80)={Int.toString(t1 - t0)}ms sea(100x24,200)={Int.toString(t2 - t1)}ms total={Int.toString(t2 - t0)}ms")
