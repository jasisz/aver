module SharedRecursiveSumApp
    intent =
        "Fixture: a record inside a recursive sum, recursion through Option,"
        "one value used as both fields of a node, two sums on one cycle, and"
        "equality of such values built apart, as deep as the first argument says."
    effects [Console.print, Args.get]

record E
    node: Node
    hash: Int

type Node
    Leaf(Int)
    App(E, E)

type T
    Tip(Int)
    Pair(T, T)
    Wrap(Option<T>)

type Even
    Zero
    Succ(Odd, Odd)

type Odd
    One(Even, Even)

fn size(e: E) -> Int
    ? "Counts the leaves under e."
    match e.node
        Node.Leaf(_) -> 1
        Node.App(f, a) -> size(f) + size(a)

verify size
    size(E(node = Node.App(E(node = Node.Leaf(1), hash = 1), E(node = Node.Leaf(2), hash = 2)), hash = 3)) => 2

fn nest(e: E, n: Int) -> E
    ? "Puts e under n applications that hold it on both sides."
    match n <= 0
        true -> e
        false -> nest(E(node = Node.App(e, e), hash = n), n - 1)

verify nest
    size(nest(E(node = Node.Leaf(1), hash = 0), 3)) => 8

fn sides(t: T) -> Int
    ? "Adds the tips of a pair, or reads through a wrapper."
    match t
        T.Tip(n) -> n
        T.Pair(a, b) -> sides(a) + sides(b)
        T.Wrap(Option.Some(inner)) -> sides(inner)
        T.Wrap(Option.None) -> 0

verify sides
    sides(T.Pair(T.Tip(1), T.Wrap(Option.Some(T.Tip(2))))) => 3

fn tips(a: T, b: T) -> Int
    ? "Reads two tips at once."
    match (a, b)
        (T.Tip(x), T.Tip(y)) -> x * 10 + y
        _ -> 0

verify tips
    tips(T.Tip(1), T.Tip(2)) => 12

fn twice(t: T, n: Int) -> T
    ? "Puts t under n pairs that hold it on both sides."
    match n <= 0
        true -> t
        false -> twice(T.Pair(t, t), n - 1)

verify twice
    sides(twice(T.Tip(1), 3)) => 8

fn spine(n: Int, last: Int) -> T
    ? "twice(T.Tip(1), n) with its rightmost tip last, built level by level."
    match n <= 0
        true -> T.Tip(last)
        false -> T.Pair(twice(T.Tip(1), n - 1), spine(n - 1, last))

verify spine
    sides(spine(3, 1)) => 8

fn even(n: Int) -> Even
    ? "n levels of Even and Odd in turn, each holding the level below twice."
    match n <= 0
        true -> Even.Zero
        false -> succ(odd(n - 1))

fn succ(o: Odd) -> Even
    ? "An Even holding o on both sides."
    Even.Succ(o, o)

fn odd(n: Int) -> Odd
    ? "An Odd over even(n) on both sides."
    one(even(n))

fn one(e: Even) -> Odd
    ? "An Odd holding e on both sides."
    Odd.One(e, e)

fn depth() -> Int
    ? "The first argument as a number, 12 without one."
    ! [Args.get]
    match Vector.get(Vector.fromList(Args.get()), 0)
        Option.Some(text) -> Result.withDefault(Int.fromString(text), 12)
        Option.None -> 12

fn main() -> Unit
    ! [Console.print, Args.get]
    big = nest(E(node = Node.Leaf(7), hash = 0), 18)
    Console.print("size {size(big)} hash {big.hash}")
    t = T.Pair(T.Tip(4), T.Wrap(Option.Some(T.Tip(5))))
    Console.print("sides {sides(t)} tips {tips(T.Tip(3), T.Tip(8))}")
    Console.print("equal {T.Pair(t, t) == T.Pair(t, T.Pair(T.Tip(4), T.Wrap(Option.Some(T.Tip(5)))))}")
    Console.print("differ {T.Pair(t, t) == T.Pair(t, T.Tip(4))}")
    n = depth()
    Console.print("dag {twice(T.Tip(1), n) == spine(n, 1)} {twice(T.Tip(1), n) == spine(n, 2)}")
    Console.print("record {nest(E(node = Node.Leaf(7), hash = 0), n) == nest(E(node = Node.Leaf(7), hash = 0), n)}")
    Console.print("mutual {even(n) == succ(odd(n - 1))} {even(n) == even(n + 1)}")
