module NativeProviderWasmGc
    intent = "Round-trip every custom provider boundary shape through embedded Wasmtime."
    depends [Shapes]
    effects []

fn main() -> Result<Unit, String>
    ? "Require the configured provider to decode and encode the complete Bundle."
    bundle = Shapes.Bundle(number = 7, ratio = 1.5, text = "hello", flag = true, nothing = Unit, pair = (3, "three"), items = [1, 2], vector = Vector.fromList(["v"]), index = {"z" => 9, "a" => 2}, maybe = Option.Some(false), outcome = Result.Err("declared"), state = Shapes.State.Ready(9))
    echoed = Shapes.echo(bundle)?
    match echoed.flag
        true -> Result.Ok(Unit)
        false -> Result.Err("provider changed the Bundle")
