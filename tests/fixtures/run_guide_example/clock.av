module Clock
    kind = capability
    semantics = effectful
    intent = "The tick the ticker waits on."
    exposes [Tick, TickReply, tick]

type Tick
    Tock
    Closed(Int)

type TickReply
    Now(Clock.Tick)
    Later(Wait.Wake)

operation tick() -> Clock.Tick
    ? "The next tick, or Closed once every job has landed, carrying what they scored together."
    oracle = generative
    replay = recorded
