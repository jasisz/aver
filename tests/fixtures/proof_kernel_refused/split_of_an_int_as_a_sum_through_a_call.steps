(steps 16
 (obligation zero.isOne ((n int)) (none) (call zero (v n)) (i 1))
 (defs
  (def zero ((n int)) int () (i 0))
  (def pick ((x (named One))) int () (match (v x) (arm (pc One.Only) (i 7)))))
 (consts)
 (sums
  (sum One (One.Only)))
 (recs)
 (sigs)
 (laws)
 (proof (trans ((call zero (v n)) (i 0) (i 1)) (unfold zero 0 ((v n)) ()) (split pick ((i 0)) (i 0) h0 (case One.Only () (split pick ((i 1)) (i 1) h1 (case One.Only () (trans ((i 0) (ctor One.Only) (i 1)) (hyp h0) (symm (hyp h1))))))))))
