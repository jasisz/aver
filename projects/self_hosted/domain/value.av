module Value
    intent =
        "Runtime values for the mini interpreter."
    exposes [Val, valRepr]

type Val
    ValInt(Int)
    ValFloat(Float)
    ValStr(String)
    ValBool(Bool)
    ValList(List<Val>)
    ValVector(Vector<Val>)
    ValOk(Val)
    ValErr(Val)
    ValSome(Val)
    ValNone
    ValTuple(List<Val>)
    ValRecord(String, List<(String, Val)>)
    ValVariant(String, String, List<Val>)
    ValMap(Map<String, Val>)
    ValUnit

fn valListRepr(items: List<Val>, acc: String, first: Bool) -> String
    ? "Build list repr recursively."
    match items
        [] -> "[{acc}]"
        [v, ..rest] -> match first
            true -> valListRepr(rest, valRepr(v), false)
            false -> valListRepr(rest, acc + ", " + valRepr(v), false)

verify valListRepr
    valListRepr([], "", true) => "[]"
    valListRepr([Val.ValInt(1), Val.ValInt(2)], "", true) => "[1, 2]"
    valListRepr([Val.ValStr("a")], "", true) => "[a]"

fn valRepr(v: Val) -> String
    ? "Display representation of a runtime value."
    match v
        Val.ValInt(n) -> Int.toString(n)
        Val.ValFloat(f) -> Float.toString(f)
        Val.ValStr(s) -> s
        Val.ValBool(b) -> String.fromBool(b)
        Val.ValList(items) -> valListRepr(items, "", true)
        Val.ValVector(vec) -> "Vector" + valListRepr(Vector.toList(vec), "", true)
        Val.ValOk(inner) -> "Result.Ok({valRepr(inner)})"
        Val.ValErr(inner) -> "Result.Err({valRepr(inner)})"
        Val.ValTuple(items) -> "({valFieldsRepr(items, "", true)})"
        Val.ValSome(inner) -> "Option.Some({valRepr(inner)})"
        Val.ValNone -> "Option.None"
        Val.ValRecord(name, _) -> "{name}(...)"
        Val.ValMap(_) -> "Map(...)"
        Val.ValVariant(typeName, ctorName, fields) -> valVariantRepr(typeName, ctorName, fields)
        Val.ValUnit -> "()"

verify valRepr
    valRepr(Val.ValInt(42)) => "42"
    valRepr(Val.ValStr("hello")) => "hello"
    valRepr(Val.ValBool(true)) => "true"
    valRepr(Val.ValUnit) => "()"
    valRepr(Val.ValList([Val.ValInt(1)])) => "[1]"
    valRepr(Val.ValOk(Val.ValInt(5))) => "Result.Ok(5)"
    valRepr(Val.ValErr(Val.ValStr("e"))) => "Result.Err(e)"
    valRepr(Val.ValNone) => "Option.None"
    valRepr(Val.ValSome(Val.ValInt(3))) => "Option.Some(3)"
    valRepr(Val.ValTuple([Val.ValInt(1), Val.ValInt(2)])) => "(1, 2)"
    valRepr(Val.ValFloat(3.14)) => "3.14"
    valRepr(Val.ValRecord("User", [("name", Val.ValStr("Alice"))])) => "User(...)"
    valRepr(Val.ValVariant("Token", "TkPlus", [])) => "Token.TkPlus"

fn valVariantRepr(typeName: String, ctorName: String, fields: List<Val>) -> String
    ? "Display a variant value."
    match fields
        [] -> "{typeName}.{ctorName}"
        _ -> "{typeName}.{ctorName}({valFieldsRepr(fields, "", true)})"

verify valVariantRepr
    valVariantRepr("Token", "TkPlus", []) => "Token.TkPlus"
    valVariantRepr("Expr", "ExprInt", [Val.ValInt(5)]) => "Expr.ExprInt(5)"

fn valFieldsRepr(items: List<Val>, acc: String, first: Bool) -> String
    ? "Build comma-separated repr of variant fields."
    match items
        [] -> acc
        [v, ..rest] -> match first
            true -> valFieldsRepr(rest, valRepr(v), false)
            false -> valFieldsRepr(rest, acc + ", " + valRepr(v), false)

verify valFieldsRepr
    valFieldsRepr([], "", true) => ""
    valFieldsRepr([Val.ValInt(1), Val.ValStr("hi")], "", true) => "1, hi"
