module StandardCapabilityTargets
    intent = "Exercises standard capability bindings on every shipped execution target."
    effects [Disk.exists, Random.int, Random.float, Tcp.ping, Time.now, Time.unixMs, Time.sleep]

fn tcpProbe() -> Result<Unit, String>
    ? "Keep Tcp in target accounting without opening a socket during the canary run."
    ! [Tcp.ping]
    Tcp.ping("127.0.0.1", 1)

fn main() -> Int
    ! [Disk.exists, Random.int, Random.float, Time.now, Time.unixMs, Time.sleep]
    stamp = Time.now()
    _epoch = Time.unixMs()
    Time.sleep(0)
    roll = Random.int(1, 6)
    _fraction = Random.float()
    diskProbe = match Disk.exists("aver-target-disk-probe.absent")
        true -> 1
        _ -> 0
    String.len(stamp) + roll + diskProbe
