module Main
    intent =
        "Egg Catch shell. Every effect the game performs lives in this file and"
        "is named in a signature: a non-blocking key read (Terminal.readKey), the"
        "cursor moves, colours and prints that paint a frame, and the frame"
        "clock (Time.unixMs, Time.sleep). All game logic is the pure Core engine"
        "and all drawing decisions are the pure View — this shell only threads a"
        "GameState through the frame loop: paint what changed, wait for the"
        "frame to be due, feed the keys and one Tick to Core.step."
        "Deterministic replay needs no shell code: the toolchain's"
        "`aver run --record` / `aver replay` cover runs, and the engine-level"
        "property is Core.replay (a left fold of the pure step, with a proven"
        "law). The pure/effectful boundary is exactly the module boundary:"
        "Core and View have effects [], Main owns them all."
    depends [Core, View]
    effects [Args, Console, Terminal, Time]

decision RepaintOnlyChangedRows
    date = "2026-11-24"
    author = "szymon"
    reason =
        "Clearing the screen for every frame flickers and prints the whole"
        "picture twenty-five times a second. The shell keeps the frame it last"
        "painted and asks View.changedFrom which rows differ; in play that is"
        "the few rows an egg or the basket crosses. The screen is cleared once,"
        "when the game starts."
    chosen = "RowDiffAgainstShownFrame"
    rejected = ["ClearAndRedrawEveryFrame", "CellLevelDiff"]
    impacts = [loop, paint]

fn main() -> Result<Unit, String>
    ? "Entry point. The first argument, when it is a number, is the session"
      "seed; the default is 1. The run of a session still differs from play to"
      "play, because Core mixes the seed with the time spent on the title."
    ! [
        Args.get,
        Console.print,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor, Terminal.showCursor,
        Time.sleep, Time.unixMs,
    ]
    play(Core.parseSeed(firstArg(Args.get())))

fn firstArg(args: List<String>) -> String
    ? "The first command-line argument, or empty when there is none."
    match args
        [] -> ""
        [head, ..rest] -> head

verify firstArg
    firstArg([]) => ""
    firstArg(["42", "x"]) => "42"

fn play(seed: Int) -> Result<Unit, String>
    ? "Set the terminal up, run the frame loop until the player quits, and"
      "put the terminal back whether the loop ended well or with an error."
    ! [
        Console.print,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor, Terminal.showCursor,
        Time.sleep, Time.unixMs,
    ]
    Terminal.enableRawMode()?
    Terminal.hideCursor()?
    Terminal.clear()?
    ended = loop(Core.lobby(seed), [], Time.unixMs())
    Terminal.resetColor()?
    Terminal.showCursor()?
    Terminal.disableRawMode()?
    Terminal.clear()?
    farewell(ended)

fn farewell(ended: Result<GameState, String>) -> Result<Unit, String>
    ? "Say goodbye on the restored terminal: the best score of the session,"
      "or the error that stopped the loop."
    ! [Console.print]
    match ended
        Result.Ok(gs) -> Result.Ok(Console.print("Egg Catch — best score this session: {String.fromInt(Core.sessionBest(gs))}"))
        Result.Err(problem) -> Result.Err(problem)

fn loop(gs: GameState, shown: List<List<Span>>, due: Int) -> Result<GameState, String>
    ? "One frame: paint the rows that changed, sleep until the frame is due,"
      "then take the keys. `shown` is the frame on the terminal, empty before"
      "the first one; `due` is the clock reading the next Tick belongs to."
    ! [
        Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor,
        Time.sleep, Time.unixMs,
    ]
    frame = View.render(gs)
    paint(View.changedFrom(shown, frame, 0, []))?
    Terminal.flush()?
    Time.sleep(Core.napMs(due, Time.unixMs()))?
    poll(gs, frame, Core.nextDue(due, Time.unixMs()))

fn poll(gs: GameState, shown: List<List<Span>>, due: Int) -> Result<GameState, String>
    ? "Take every key waiting in the terminal, each as one Core.step, so a"
      "burst of presses never lags behind the picture; when none is left,"
      "advance the world one Tick and draw the next frame. Esc ends the loop"
      "with the state as it stands."
    ! [
        Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor,
        Time.sleep, Time.unixMs,
    ]
    match Terminal.readKey()?
        Option.None -> loop(Core.step(gs, Input.Tick), shown, due)
        Option.Some(key) -> match Core.isQuit(key)
            true -> Result.Ok(gs)
            false -> poll(Core.press(gs, key), shown, due)

fn paint(lines: List<Line>) -> Result<Unit, String>
    ? "Paint each changed row at its own terminal line."
    ! [Terminal.moveTo, Terminal.print, Terminal.resetColor, Terminal.setColor]
    match lines
        [] -> Result.Ok(Unit)
        [line, ..rest] -> paintLine(line, rest)

fn paintLine(line: Line, rest: List<Line>) -> Result<Unit, String>
    ? "Move to the start of one row, print its spans, go on with the rest."
    ! [Terminal.moveTo, Terminal.print, Terminal.resetColor, Terminal.setColor]
    Terminal.moveTo(0, line.y)?
    paintSpans(line.spans)?
    paint(rest)

fn paintSpans(spans: List<Span>) -> Result<Unit, String>
    ? "Print the spans of a row left to right, each in its ink."
    ! [Terminal.print, Terminal.resetColor, Terminal.setColor]
    match spans
        [] -> Terminal.resetColor()
        [s, ..rest] -> paintSpan(s, rest)

fn paintSpan(s: Span, rest: List<Span>) -> Result<Unit, String>
    ? "Switch to a span's colour — or back to the terminal's own for an ink"
      "without one — print its text, and go on with the rest of the row."
    ! [Terminal.print, Terminal.resetColor, Terminal.setColor]
    dip(View.colour(s.ink))?
    Terminal.print(s.text)?
    paintSpans(rest)

fn dip(colour: Option<String>) -> Result<Unit, String>
    ? "Set the terminal's foreground to a colour, or reset it for None."
    ! [Terminal.resetColor, Terminal.setColor]
    match colour
        Option.Some(name) -> Terminal.setColor(name)
        Option.None -> Terminal.resetColor()
