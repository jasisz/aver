module Lists
    intent =
        "Demonstrates the core List API without callbacks."
        "Aver prefers recursion, pattern matching, and first-order helpers."

fn main() -> Unit
    ! [Console.print]
    numbers = [1, 2, 3]
    Console.print("len:")
    Console.print(List.len(numbers))
    Console.print("prepend 0:")
    Console.print(List.prepend(0, numbers))
    Console.print("take 2:")
    Console.print(List.take(numbers, 2))
    Console.print("drop 1:")
    Console.print(List.drop(numbers, 1))
    Console.print("concat:")
    Console.print(List.concat(numbers, [4, 5]))
    Console.print("reverse:")
    Console.print(List.reverse(numbers))
    Console.print("contains 2:")
    Console.print(List.contains(numbers, 2))
    Console.print("zip:")
    Console.print(List.zip(["a", "b", "c"], numbers))
