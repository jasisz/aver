module Main
    intent =
        "Hunt the Wumpus — classic cave exploration game."
        "Demonstrates match-driven control flow, recursive game loop,"
        "pure logic separated from effectful I/O, and record-based state."
    depends []

fn caveMap() -> List<List<Int>>
    ? "Adjacency list. Index i holds neighbors of room i+1."
    [[2,5,8],[1,3,10],[2,4,12],[3,5,14],[1,4,6],
     [5,7,15],[6,8,17],[1,7,9],[8,10,18],[2,9,11],
     [10,12,19],[3,11,13],[12,14,20],[4,13,15],[6,14,16],
     [15,17,20],[7,16,18],[9,17,19],[11,18,20],[13,16,19]]

verify caveMap
    List.len(caveMap()) => 20

fn neighbors(room: Int) -> List<Int>
    ? "Three adjacent rooms for a given room (1-20)."
    match List.get(caveMap(), room - 1)
        Option.Some(ns) -> ns
        Option.None -> []

verify neighbors
    neighbors(1) => [2, 5, 8]
    neighbors(20) => [13, 16, 19]

fn containsInt(xs: List<Int>, n: Int) -> Bool
    ? "True when n appears in xs."
    match xs
        [] -> false
        [x, ..rest] -> match x == n
            true -> true
            false -> containsInt(rest, n)

verify containsInt
    containsInt([1, 2, 3], 2) => true
    containsInt([1, 2, 3], 4) => false
    containsInt([], 1) => false

fn isAdjacent(from: Int, to: Int) -> Bool
    ? "True when two rooms are directly connected."
    containsInt(neighbors(from), to)

verify isAdjacent
    isAdjacent(1, 2) => true
    isAdjacent(1, 3) => false

fn validRoom(room: Int) -> Bool
    ? "True when room is in the 1-20 range."
    match room >= 1
        true -> room <= 20
        false -> false

verify validRoom
    validRoom(0) => false
    validRoom(1) => true
    validRoom(20) => true
    validRoom(21) => false

fn roomList(rooms: List<Int>) -> String
    ? "Comma-separated room numbers."
    match rooms
        [] -> ""
        [r, ..rest] -> match rest
            [] -> Int.toString(r)
            _ -> "{Int.toString(r)}, {roomList(rest)}"

verify roomList
    roomList([1, 2, 3]) => "1, 2, 3"
    roomList([7]) => "7"

fn randRoom() -> Int
    ? "Pick a random room number 1-20."
    ! [Random.int]
    Random.int(1, 20)

fn distinctRooms(n: Int, taken: List<Int>) -> List<Int>
    ? "Generate n distinct random rooms not in taken."
    ! [Random.int]
    match n <= 0
        true -> taken
        false -> pickDistinct(n, taken)

fn pickDistinct(n: Int, taken: List<Int>) -> List<Int>
    ? "Pick one room, reject if duplicate, recurse."
    ! [Random.int]
    r = randRoom()
    match containsInt(taken, r)
        true -> pickDistinct(n, taken)
        false -> distinctRooms(n - 1, List.append(taken, r))

record Game
    player: Int
    wumpus: Int
    pit1: Int
    pit2: Int
    bat1: Int
    bat2: Int
    arrows: Int

type Outcome
    Continue(Game)
    Win(String)
    Lose(String)
    Bats(Game)

fn newGame() -> Game
    ? "Place player and hazards at distinct random positions."
    ! [Random.int]
    rooms = distinctRooms(6, [])
    Game(player = Result.withDefault(List.get(rooms, 0), 1),
         wumpus = Result.withDefault(List.get(rooms, 1), 2),
         pit1 = Result.withDefault(List.get(rooms, 2), 3),
         pit2 = Result.withDefault(List.get(rooms, 3), 4),
         bat1 = Result.withDefault(List.get(rooms, 4), 5),
         bat2 = Result.withDefault(List.get(rooms, 5), 6),
         arrows = 5)

fn checkRoom(game: Game) -> Outcome
    ? "Check hazards after entering a room."
    match game.player == game.wumpus
        true -> Outcome.Lose("The Wumpus devours you!")
        false -> match game.player == game.pit1
            true -> Outcome.Lose("You fall into a bottomless pit!")
            false -> match game.player == game.pit2
                true -> Outcome.Lose("You fall into a bottomless pit!")
                false -> checkBats(game)

verify checkRoom
    checkRoom(Game(player = 5, wumpus = 5, pit1 = 1, pit2 = 2, bat1 = 3, bat2 = 4, arrows = 5)) => Outcome.Lose("The Wumpus devours you!")
    checkRoom(Game(player = 1, wumpus = 5, pit1 = 1, pit2 = 2, bat1 = 3, bat2 = 4, arrows = 5)) => Outcome.Lose("You fall into a bottomless pit!")
    checkRoom(Game(player = 3, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 5)) => Outcome.Continue(Game(player = 3, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 5))

fn checkBats(game: Game) -> Outcome
    ? "Super bats signal a teleport; the I/O layer handles the random move."
    match game.player == game.bat1
        true -> Outcome.Bats(game)
        false -> match game.player == game.bat2
            true -> Outcome.Bats(game)
            false -> Outcome.Continue(game)

verify checkBats
    checkBats(Game(player = 3, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 5)) => Outcome.Continue(Game(player = 3, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 5))
    checkBats(Game(player = 3, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 3, bat2 = 14, arrows = 5)) => Outcome.Bats(Game(player = 3, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 3, bat2 = 14, arrows = 5))

fn movePlayer(game: Game, room: Int) -> Result<Outcome, String>
    ? "Move to an adjacent room and check hazards."
    match validRoom(room)
        false -> Result.Err("Room must be between 1 and 20!")
        true -> match isAdjacent(game.player, room)
            true -> Result.Ok(checkRoom(Game.update(game, player = room)))
            false -> Result.Err("That room is not adjacent!")

verify movePlayer
    movePlayer(Game(player = 1, wumpus = 10, pit1 = 15, pit2 = 16, bat1 = 18, bat2 = 19, arrows = 5), 2) => Result.Ok(Outcome.Continue(Game(player = 2, wumpus = 10, pit1 = 15, pit2 = 16, bat1 = 18, bat2 = 19, arrows = 5)))
    movePlayer(Game(player = 1, wumpus = 10, pit1 = 15, pit2 = 16, bat1 = 18, bat2 = 19, arrows = 5), 3) => Result.Err("That room is not adjacent!")
    movePlayer(Game(player = 1, wumpus = 10, pit1 = 15, pit2 = 16, bat1 = 18, bat2 = 19, arrows = 5), 0) => Result.Err("Room must be between 1 and 20!")
    movePlayer(Game(player = 1, wumpus = 10, pit1 = 15, pit2 = 16, bat1 = 18, bat2 = 19, arrows = 5), 99) => Result.Err("Room must be between 1 and 20!")

fn shootArrow(game: Game, room: Int) -> Result<Outcome, String>
    ? "Shoot an arrow into an adjacent room."
    match validRoom(room)
        false -> Result.Err("Room must be between 1 and 20!")
        true -> match isAdjacent(game.player, room)
            false -> Result.Err("You can't shoot there!")
            true -> match room == game.wumpus
                true -> Result.Ok(Outcome.Win("Your arrow strikes the Wumpus! You win!"))
                false -> arrowMissed(game)

verify shootArrow
    shootArrow(Game(player = 1, wumpus = 2, pit1 = 10, pit2 = 11, bat1 = 12, bat2 = 13, arrows = 5), 2) => Result.Ok(Outcome.Win("Your arrow strikes the Wumpus! You win!"))
    shootArrow(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 1), 5) => Result.Ok(Outcome.Lose("Out of arrows. The Wumpus finds you."))
    shootArrow(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 5), 3) => Result.Err("You can't shoot there!")
    shootArrow(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 5), 0) => Result.Err("Room must be between 1 and 20!")

fn arrowMissed(game: Game) -> Result<Outcome, String>
    ? "Handle a missed arrow shot — check remaining arrows."
    match game.arrows == 1
        true -> Result.Ok(Outcome.Lose("Out of arrows. The Wumpus finds you."))
        false -> Result.Ok(Outcome.Continue(Game.update(game, arrows = game.arrows - 1)))

verify arrowMissed
    arrowMissed(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 1)) => Result.Ok(Outcome.Lose("Out of arrows. The Wumpus finds you."))
    arrowMissed(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 3)) => Result.Ok(Outcome.Continue(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 2)))

fn wumpusNearby(game: Game) -> Bool
    ? "True when the Wumpus is in an adjacent room."
    containsInt(neighbors(game.player), game.wumpus)

verify wumpusNearby
    wumpusNearby(Game(player = 1, wumpus = 2, pit1 = 10, pit2 = 11, bat1 = 12, bat2 = 13, arrows = 5)) => true
    wumpusNearby(Game(player = 1, wumpus = 3, pit1 = 10, pit2 = 11, bat1 = 12, bat2 = 13, arrows = 5)) => false

fn pitNearby(game: Game) -> Bool
    ? "True when a bottomless pit is in an adjacent room."
    match containsInt(neighbors(game.player), game.pit1)
        true -> true
        false -> containsInt(neighbors(game.player), game.pit2)

verify pitNearby
    pitNearby(Game(player = 1, wumpus = 10, pit1 = 5, pit2 = 11, bat1 = 12, bat2 = 13, arrows = 5)) => true
    pitNearby(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 5)) => false

fn batsNearby(game: Game) -> Bool
    ? "True when super bats are in an adjacent room."
    match containsInt(neighbors(game.player), game.bat1)
        true -> true
        false -> containsInt(neighbors(game.player), game.bat2)

verify batsNearby
    batsNearby(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 2, bat2 = 13, arrows = 5)) => true
    batsNearby(Game(player = 1, wumpus = 10, pit1 = 11, pit2 = 12, bat1 = 13, bat2 = 14, arrows = 5)) => false

fn warningText(game: Game) -> String
    ? "Combined hazard warnings as a single string."
    w = match wumpusNearby(game)
        true -> "You smell something terrible nearby.\n"
        false -> ""
    p = match pitNearby(game)
        true -> "You feel a cold draft.\n"
        false -> ""
    b = match batsNearby(game)
        true -> "You hear flapping wings.\n"
        false -> ""
    "{w}{p}{b}"

verify warningText
    warningText(Game(player = 1, wumpus = 3, pit1 = 10, pit2 = 11, bat1 = 12, bat2 = 13, arrows = 5)) => ""
    warningText(Game(player = 1, wumpus = 2, pit1 = 10, pit2 = 11, bat1 = 12, bat2 = 13, arrows = 5)) => "You smell something terrible nearby.\n"

fn showRoom(game: Game) -> Unit
    ? "Display current room, tunnels, and hazard warnings."
    ! [Console.print]
    Console.print("")
    Console.print("You are in room {Int.toString(game.player)}.")
    Console.print("Tunnels lead to: {roomList(neighbors(game.player))}")
    Console.print(warningText(game))
    Console.print("Arrows: {Int.toString(game.arrows)}")

fn gameLoop(game: Game) -> Result<String, String>
    ? "Main game loop — one turn per recursive call."
    ! [Console.print, Console.readLine, Random.int]
    showRoom(game)
    Console.print("(m)ove or (s)hoot?")
    action = Console.readLine()?
    Console.print("Which room?")
    roomStr = Console.readLine()?
    dispatchInput(game, String.trim(action), String.trim(roomStr))

fn dispatchInput(game: Game, action: String, roomStr: String) -> Result<String, String>
    ? "Parse room number from input string."
    ! [Console.print, Console.readLine, Random.int]
    match Int.fromString(roomStr)
        Result.Err(_) -> retry(game, "Enter a room number.")
        Result.Ok(room) -> dispatchAction(game, action, room)

fn dispatchAction(game: Game, action: String, room: Int) -> Result<String, String>
    ? "Route m/s action to move or shoot."
    ! [Console.print, Console.readLine, Random.int]
    match action
        "m" -> handleResult(game, movePlayer(game, room))
        "s" -> handleResult(game, shootArrow(game, room))
        _ -> retry(game, "Type 'm' or 's'.")

fn handleResult(game: Game, result: Result<Outcome, String>) -> Result<String, String>
    ? "Unwrap action result: retry on error, resolve on outcome."
    ! [Console.print, Console.readLine, Random.int]
    match result
        Result.Err(msg) -> retry(game, msg)
        Result.Ok(outcome) -> resolveOutcome(outcome)

fn resolveOutcome(outcome: Outcome) -> Result<String, String>
    ? "Win/Lose ends the game, Bats teleport, Continue loops."
    ! [Console.print, Console.readLine, Random.int]
    match outcome
        Outcome.Win(msg) -> Result.Ok(msg)
        Outcome.Lose(msg) -> Result.Ok(msg)
        Outcome.Bats(game) -> teleportAndCheck(game)
        Outcome.Continue(game) -> gameLoop(game)

fn teleportAndCheck(game: Game) -> Result<String, String>
    ? "Bats carry you to a random room; check hazards there."
    ! [Console.print, Console.readLine, Random.int]
    dest = randRoom()
    Console.print("Super bats carry you to room {Int.toString(dest)}!")
    resolveOutcome(checkRoom(Game.update(game, player = dest)))

fn retry(game: Game, msg: String) -> Result<String, String>
    ? "Print an error message and re-enter the game loop."
    ! [Console.print, Console.readLine, Random.int]
    Console.print(msg)
    gameLoop(game)

fn main() -> Unit
    ? "Starts Hunt the Wumpus."
    ! [Console.print, Console.readLine, Random.int]
    Console.print("=== HUNT THE WUMPUS ===")
    Console.print("A wumpus lurks in a cave of 20 rooms.")
    Console.print("Each room connects to 3 others.")
    Console.print("Hazards: 2 bottomless pits, 2 bat colonies.")
    match gameLoop(newGame())
        Result.Ok(msg) -> Console.print(msg)
        Result.Err(msg) -> Console.print("Error: {msg}")
