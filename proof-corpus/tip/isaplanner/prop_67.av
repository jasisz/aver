module Prop67
    intent =
        "TIP isaplanner prop_67: len(butlast xs) = len xs - S Z."
    effects []

type Nat
    Z
    S(Nat)

fn len(xs: List<Int>) -> Nat
    match xs
        [] -> Nat.Z
        [y, ..ys] -> Nat.S(len(ys))

fn butlast(xs: List<Int>) -> List<Int>
    match xs
        [] -> []
        [y, ..z] -> match z
            [] -> []
            [x2, ..x3] -> List.concat([y], butlast(z))

fn sub(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> Nat.Z
        Nat.S(z) -> match y
            Nat.Z -> x
            Nat.S(x2) -> sub(z, x2)

verify len law lenButlastSub
    given xs: List<Int> = [[], [1], [1, 2], [1, 2, 3]]
    len(butlast(xs)) => sub(len(xs), Nat.S(Nat.Z))
