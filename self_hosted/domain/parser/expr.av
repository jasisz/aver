module Expr
    depends [Domain.Token, Domain.Ast, Domain.ParserMatch]
    intent =
        "Expression parsing for the Aver parser."
        "Handles precedence climbing: comparison > additive > multiplicative > atom."
        "Also handles string interpolation, list/tuple/record literals, field access, function calls, and match expressions."
    exposes [parseExpr, parsePostfixQuestion, parseCmpExprTail, parseAddExprTail, parseMulExprTail, parseIdentOrCall]
    effects []

fn parseExpr(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse an expression: comparison level, then optional ? postfix."
    r = parseCmpExpr(tokens, pos)?
    match r
        (expr, pos2) -> Result.Ok(parsePostfixQuestion(tokens, pos2, expr))

verify parseExpr
    parseExpr([Token.TkInt(42), Token.TkEof], 0) => Result.Ok((Expr.ExprInt(42), 1))
    parseExpr([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parsePostfixQuestion(tokens: List<Token>, pos: Int, expr: Expr) -> Tuple<Expr, Int>
    ? "Check for postfix ? (error propagation)."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkQuestion -> (Expr.ExprPropagate(expr), pos + 1)
        _ -> (expr, pos)

verify parsePostfixQuestion
    parsePostfixQuestion([Token.TkEof], 0, Expr.ExprInt(1)) => (Expr.ExprInt(1), 0)
    parsePostfixQuestion([Token.TkQuestion, Token.TkEof], 0, Expr.ExprInt(1)) => (Expr.ExprPropagate(Expr.ExprInt(1)), 1)

fn parseCmpExpr(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse comparison: addExpr (('==' | '<' | '>') addExpr)?"
    r = parseAddExpr(tokens, pos)?
    match r
        (left, pos2) -> parseCmpExprTail(tokens, pos2, left)

verify parseCmpExpr
    parseCmpExpr([Token.TkInt(1), Token.TkEof], 0) => Result.Ok((Expr.ExprInt(1), 1))
    parseCmpExpr([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseCmpExprTail(tokens: List<Token>, pos: Int, left: Expr) -> Result<Tuple<Expr, Int>, String>
    ? "Check for comparison operator."
    nextPos = pos + 1
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkEqEq -> parseCmpExprRight(tokens, nextPos, left, 0)
        Token.TkNeq -> parseCmpExprRight(tokens, nextPos, left, 1)
        Token.TkLt -> parseCmpExprRight(tokens, nextPos, left, 2)
        Token.TkGt -> parseCmpExprRight(tokens, nextPos, left, 3)
        Token.TkLte -> parseCmpExprRight(tokens, nextPos, left, 4)
        Token.TkGte -> parseCmpExprRight(tokens, nextPos, left, 5)
        _ -> Result.Ok((left, pos))

verify parseCmpExprTail
    parseCmpExprTail([Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Expr.ExprInt(1), 0))
    parseCmpExprTail([Token.TkEqEq, Token.TkInt(2), Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Expr.ExprEq(Expr.ExprInt(1), Expr.ExprInt(2)), 2))
    parseCmpExprTail([Token.TkEqEq, Token.TkEof], 0, Expr.ExprInt(1)) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseCmpExprRight(tokens: List<Token>, pos: Int, left: Expr, op: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse right side of comparison."
    r = parseAddExpr(tokens, pos)?
    match r
        (right, pos2) -> buildCmpExpr(left, right, pos2, op)

verify parseCmpExprRight
    parseCmpExprRight([Token.TkInt(2), Token.TkEof], 0, Expr.ExprInt(1), 0) => Result.Ok((Expr.ExprEq(Expr.ExprInt(1), Expr.ExprInt(2)), 1))
    parseCmpExprRight([Token.TkEof], 0, Expr.ExprInt(1), 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn buildCmpExpr(left: Expr, right: Expr, pos: Int, op: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Build comparison AST node from op code."
    match op
        0 -> Result.Ok((Expr.ExprEq(left, right), pos))
        1 -> Result.Ok((Expr.ExprNeq(left, right), pos))
        2 -> Result.Ok((Expr.ExprLt(left, right), pos))
        3 -> Result.Ok((Expr.ExprGt(left, right), pos))
        4 -> Result.Ok((Expr.ExprLte(left, right), pos))
        5 -> Result.Ok((Expr.ExprGte(left, right), pos))
        _ -> Result.Err("unknown cmp operator")

verify buildCmpExpr
    buildCmpExpr(Expr.ExprInt(1), Expr.ExprInt(2), 3, 0) => Result.Ok((Expr.ExprEq(Expr.ExprInt(1), Expr.ExprInt(2)), 3))
    buildCmpExpr(Expr.ExprInt(1), Expr.ExprInt(2), 3, 99) => Result.Err("unknown cmp operator")

fn parseAddExpr(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse additive: mulExpr (('+' | '-') mulExpr)*"
    r = parseMulExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseAddExprTail(tokens, pos2, expr)

verify parseAddExpr
    parseAddExpr([Token.TkInt(1), Token.TkEof], 0) => Result.Ok((Expr.ExprInt(1), 1))
    parseAddExpr([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseAddExprTail(tokens: List<Token>, pos: Int, left: Expr) -> Result<Tuple<Expr, Int>, String>
    ? "Continue parsing additive operators."
    nextPos = pos + 1
    t = Domain.ParserMatch.tokenAt(tokens, pos)
    match t
        Token.TkPlus -> parseAddExprRight(tokens, nextPos, left, 0)
        Token.TkMinus -> parseAddExprRight(tokens, nextPos, left, 1)
        _ -> Result.Ok((left, pos))

verify parseAddExprTail
    parseAddExprTail([Token.TkPlus, Token.TkInt(2), Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)), 2))
    parseAddExprTail([Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Expr.ExprInt(1), 0))
    parseAddExprTail([Token.TkPlus, Token.TkEof], 0, Expr.ExprInt(1)) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseAddExprRight(tokens: List<Token>, pos: Int, left: Expr, op: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse right side of additive op."
    r = parseMulExpr(tokens, pos)?
    match r
        (right, pos2) -> match op == 0
            true -> parseAddExprTail(tokens, pos2, Expr.ExprAdd(left, right))
            false -> parseAddExprTail(tokens, pos2, Expr.ExprSub(left, right))

verify parseAddExprRight
    parseAddExprRight([Token.TkInt(2), Token.TkEof], 0, Expr.ExprInt(1), 0) => Result.Ok((Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)), 1))
    parseAddExprRight([Token.TkEof], 0, Expr.ExprInt(1), 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseMulExpr(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse multiplicative: atom ('*' atom)*"
    r = parseAtom(tokens, pos)?
    match r
        (expr, pos2) -> parseMulExprTail(tokens, pos2, expr)

verify parseMulExpr
    parseMulExpr([Token.TkInt(3), Token.TkEof], 0) => Result.Ok((Expr.ExprInt(3), 1))
    parseMulExpr([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseMulExprTail(tokens: List<Token>, pos: Int, left: Expr) -> Result<Tuple<Expr, Int>, String>
    ? "Continue parsing multiplicative operators."
    nextPos = pos + 1
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkStar -> parseMulExprRight(tokens, nextPos, left, 0)
        Token.TkSlash -> parseMulExprRight(tokens, nextPos, left, 1)
        _ -> Result.Ok((left, pos))

verify parseMulExprTail
    parseMulExprTail([Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Expr.ExprInt(1), 0))
    parseMulExprTail([Token.TkStar, Token.TkEof], 0, Expr.ExprInt(1)) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseMulExprRight(tokens: List<Token>, pos: Int, left: Expr, op: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse right side of mul/div op."
    r = parseAtom(tokens, pos)?
    match r
        (right, pos2) -> match op == 0
            true -> parseMulExprTail(tokens, pos2, Expr.ExprMul(left, right))
            false -> parseMulExprTail(tokens, pos2, Expr.ExprDiv(left, right))

verify parseMulExprRight
    parseMulExprRight([Token.TkInt(2), Token.TkEof], 0, Expr.ExprInt(3), 0) => Result.Ok((Expr.ExprMul(Expr.ExprInt(3), Expr.ExprInt(2)), 1))
    parseMulExprRight([Token.TkEof], 0, Expr.ExprInt(3), 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseAtom(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse atomic expression: literal, variable, call, match, or parenthesized."
    nextPos = pos + 1
    t = Domain.ParserMatch.tokenAt(tokens, pos)
    match t
        Token.TkMinus -> parseNegAtom(tokens, nextPos)
        Token.TkInt(n) -> Result.Ok((Expr.ExprInt(n), nextPos))
        Token.TkFloat(f) -> Result.Ok((Expr.ExprFloat(f), nextPos))
        Token.TkStr(s) -> parseStringOrInterp(tokens, nextPos, s)
        Token.TkTrue -> Result.Ok((Expr.ExprBool(true), nextPos))
        Token.TkFalse -> Result.Ok((Expr.ExprBool(false), nextPos))
        Token.TkLBracket -> parseListExpr(tokens, nextPos)
        Token.TkLBrace -> parseMapLiteral(tokens, nextPos)
        Token.TkLParen -> parseParenExpr(tokens, nextPos)
        Token.TkMatch -> parseMatchExpr(tokens, nextPos)
        Token.TkIdent(name) -> parseIdentOrCall(tokens, nextPos, name)
        _ -> Result.Err("Expected expression, got {Domain.Token.tokenRepr(t)}")

verify parseAtom
    parseAtom([Token.TkInt(42), Token.TkEof], 0) => Result.Ok((Expr.ExprInt(42), 1))
    parseAtom([Token.TkFloat(3.14), Token.TkEof], 0) => Result.Ok((Expr.ExprFloat(3.14), 1))
    parseAtom([Token.TkTrue, Token.TkEof], 0) => Result.Ok((Expr.ExprBool(true), 1))
    parseAtom([Token.TkStr("hi"), Token.TkEof], 0) => Result.Ok((Expr.ExprStr("hi"), 1))
    parseAtom([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseMapLiteral(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse map literal into Map.fromList call."
    pos2 = skipNl(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkRBrace -> Result.Ok((Expr.ExprCall("Map.fromList", [Expr.ExprList([])]), pos2 + 1))
        _ -> parseMapEntries(tokens, pos2, [])

verify parseMapLiteral
    parseMapLiteral([Token.TkRBrace, Token.TkEof], 0) => Result.Ok((Expr.ExprCall("Map.fromList", [Expr.ExprList([])]), 1))
    parseMapLiteral([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseMapEntries(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse key => value pairs."
    kr = parseExpr(tokens, pos)?
    match kr
        (keyExpr, pos2) -> parseMapAfterKey(tokens, pos2, acc, keyExpr)

verify parseMapEntries
    parseMapEntries([Token.TkStr("a"), Token.TkFatArrow, Token.TkInt(1), Token.TkRBrace, Token.TkEof], 0, []) => Result.Ok((Expr.ExprCall("Map.fromList", [Expr.ExprList([Expr.ExprTuple([Expr.ExprStr("a"), Expr.ExprInt(1)])])]), 4))
    parseMapEntries([Token.TkEof], 0, []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseMapAfterKey(tokens: List<Token>, pos: Int, acc: List<Expr>, keyExpr: Expr) -> Result<Tuple<Expr, Int>, String>
    ? "After key, expect => then value."
    pos2 = Domain.ParserMatch.expect(tokens, pos, Token.TkFatArrow)?
    vr = parseExpr(tokens, pos2)?
    match vr
        (valExpr, pos3) -> parseMapEntryTail(tokens, pos3, List.prepend(Expr.ExprTuple([keyExpr, valExpr]), acc))

verify parseMapAfterKey
    parseMapAfterKey([Token.TkFatArrow, Token.TkInt(1), Token.TkRBrace, Token.TkEof], 0, [], Expr.ExprStr("k")) => Result.Ok((Expr.ExprCall("Map.fromList", [Expr.ExprList([Expr.ExprTuple([Expr.ExprStr("k"), Expr.ExprInt(1)])])]), 3))
    parseMapAfterKey([Token.TkEof], 0, [], Expr.ExprStr("k")) => Result.Err("Expected tokenRepr(TkFatArrow), got tokenRepr(TkEof)")

fn parseMapEntryTail(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After entry: , for more or } to end."
    pos2 = skipNl(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkComma -> parseMapEntries(tokens, skipNl(tokens, pos2 + 1), acc)
        Token.TkRBrace -> Result.Ok((Expr.ExprCall("Map.fromList", [Expr.ExprList(List.reverse(acc))]), pos2 + 1))
        _ -> Result.Err("Expected ',' or '}' in map literal")

verify parseMapEntryTail
    parseMapEntryTail([Token.TkRBrace, Token.TkEof], 0, [Expr.ExprTuple([Expr.ExprStr("a"), Expr.ExprInt(1)])]) => Result.Ok((Expr.ExprCall("Map.fromList", [Expr.ExprList([Expr.ExprTuple([Expr.ExprStr("a"), Expr.ExprInt(1)])])]), 1))
    parseMapEntryTail([Token.TkEof], 0, []) => Result.Err("Expected ',' or '}' in map literal")

fn parseNegAtom(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse unary minus: -expr -> 0 - expr."
    r = parseAtom(tokens, pos)?
    match r
        (expr, pos2) -> Result.Ok((Expr.ExprSub(Expr.ExprInt(0), expr), pos2))

verify parseNegAtom
    parseNegAtom([Token.TkInt(5), Token.TkEof], 0) => Result.Ok((Expr.ExprSub(Expr.ExprInt(0), Expr.ExprInt(5)), 1))
    parseNegAtom([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseStringOrInterp(tokens: List<Token>, pos: Int, prefix: String) -> Result<Tuple<Expr, Int>, String>
    ? "After TkStr: check for interpolation (TkInterpStart) or plain string."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkInterpStart -> parseInterpParts(tokens, pos + 1, [Expr.ExprStr(prefix)])
        _ -> Result.Ok((Expr.ExprStr(prefix), pos))

verify parseStringOrInterp
    parseStringOrInterp([Token.TkEof], 0, "hello") => Result.Ok((Expr.ExprStr("hello"), 0))
    parseStringOrInterp([Token.TkInterpStart, Token.TkEof], 0, "hi") => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseInterpParts(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse interpolation parts: expressions between TkInterpStart/TkInterpEnd and TkStr segments."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseInterpAfterExpr(tokens, pos2, List.prepend(expr, acc))

verify parseInterpParts
    parseInterpParts([Token.TkInt(1), Token.TkInterpEnd, Token.TkEof], 0, [Expr.ExprStr("x=")]) => Result.Ok((Expr.ExprConcat([Expr.ExprStr("x="), Expr.ExprInt(1)]), 2))
    parseInterpParts([Token.TkEof], 0, []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseInterpAfterExpr(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After interpolation expr: expect TkInterpEnd, then maybe more string."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkInterpEnd -> parseInterpContinue(tokens, pos + 1, acc)
        _ -> Result.Err("Expected } in string interpolation")

verify parseInterpAfterExpr
    parseInterpAfterExpr([Token.TkInterpEnd, Token.TkEof], 0, [Expr.ExprStr("a")]) => Result.Ok((Expr.ExprConcat([Expr.ExprStr("a")]), 1))
    parseInterpAfterExpr([Token.TkEof], 0, []) => Result.Err("Expected } in string interpolation")

fn parseInterpContinue(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After }: next TkStr continues, or end of string."
    nextPos = pos + 1
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkStr(s) -> parseInterpAfterStr(tokens, nextPos, List.prepend(Expr.ExprStr(s), acc))
        Token.TkInterpStart -> parseInterpParts(tokens, nextPos, acc)
        _ -> Result.Ok((Expr.ExprConcat(List.reverse(acc)), pos))

verify parseInterpContinue
    parseInterpContinue([Token.TkEof], 0, [Expr.ExprStr("a")]) => Result.Ok((Expr.ExprConcat([Expr.ExprStr("a")]), 0))
    parseInterpContinue([Token.TkStr("b"), Token.TkEof], 0, [Expr.ExprStr("a")]) => Result.Ok((Expr.ExprConcat([Expr.ExprStr("a"), Expr.ExprStr("b")]), 1))
    parseInterpContinue([Token.TkInterpStart, Token.TkEof], 0, []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseInterpAfterStr(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After string segment: more interpolation or end."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkInterpStart -> parseInterpParts(tokens, pos + 1, acc)
        _ -> Result.Ok((Expr.ExprConcat(List.reverse(acc)), pos))

verify parseInterpAfterStr
    parseInterpAfterStr([Token.TkEof], 0, [Expr.ExprStr("a"), Expr.ExprStr("b")]) => Result.Ok((Expr.ExprConcat([Expr.ExprStr("a"), Expr.ExprStr("b")]), 0))
    parseInterpAfterStr([Token.TkInterpStart, Token.TkEof], 0, []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseListExpr(tokens: List<Token>, pos0: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse list literal: [expr, expr, ...] or []."
    pos = skipNl(tokens, pos0)
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkRBracket -> Result.Ok((Expr.ExprList([]), pos + 1))
        _ -> parseListItems(tokens, pos, [])

verify parseListExpr
    parseListExpr([Token.TkRBracket, Token.TkEof], 0) => Result.Ok((Expr.ExprList([]), 1))
    parseListExpr([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseListItems(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse comma-separated list items."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseListItemsTail(tokens, pos2, List.prepend(expr, acc))

verify parseListItems
    parseListItems([Token.TkInt(1), Token.TkRBracket, Token.TkEof], 0, []) => Result.Ok((Expr.ExprList([Expr.ExprInt(1)]), 2))
    parseListItems([Token.TkEof], 0, []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseListItemsTail(tokens: List<Token>, pos0: Int, items: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After a list item: ',' for more or ']' to end."
    pos = skipNl(tokens, pos0)
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkComma -> parseListAfterComma(tokens, skipNl(tokens, pos + 1), items)
        Token.TkRBracket -> Result.Ok((Expr.ExprList(List.reverse(items)), pos + 1))
        _ -> Result.Err("Expected ',' or ']' in list literal")

verify parseListItemsTail
    parseListItemsTail([Token.TkRBracket, Token.TkEof], 0, [Expr.ExprInt(1)]) => Result.Ok((Expr.ExprList([Expr.ExprInt(1)]), 1))
    parseListItemsTail([Token.TkComma, Token.TkInt(2), Token.TkRBracket, Token.TkEof], 0, [Expr.ExprInt(1)]) => Result.Ok((Expr.ExprList([Expr.ExprInt(1), Expr.ExprInt(2)]), 3))
    parseListItemsTail([Token.TkEof], 0, []) => Result.Err("Expected ',' or ']' in list literal")

fn parseListAfterComma(tokens: List<Token>, pos: Int, items: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "Allow a trailing comma before ']' in list literals."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkRBracket -> Result.Ok((Expr.ExprList(items), pos + 1))
        _ -> parseListItems(tokens, pos, items)

verify parseListAfterComma
    parseListAfterComma([Token.TkRBracket, Token.TkEof], 0, [Expr.ExprInt(1)]) => Result.Ok((Expr.ExprList([Expr.ExprInt(1)]), 1))
    parseListAfterComma([Token.TkInt(2), Token.TkRBracket, Token.TkEof], 0, [Expr.ExprInt(1)]) => Result.Ok((Expr.ExprList([Expr.ExprInt(1), Expr.ExprInt(2)]), 2))
    parseListAfterComma([Token.TkEof], 0, []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseParenExpr(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse parenthesized expression or tuple."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> match Domain.ParserMatch.tokenAt(tokens, pos2)
            Token.TkComma -> parseTupleRest(tokens, pos2 + 1, [expr])
            Token.TkRParen -> Result.Ok((expr, pos2 + 1))
            _ -> Result.Err("Expected ')' or ',' after expression")

verify parseParenExpr
    parseParenExpr([Token.TkInt(1), Token.TkRParen, Token.TkEof], 0) => Result.Ok((Expr.ExprInt(1), 2))
    parseParenExpr([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseTupleRest(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse remaining tuple elements after first comma."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseTupleRestTail(tokens, pos2, List.prepend(expr, acc))

verify parseTupleRest
    parseTupleRest([Token.TkInt(2), Token.TkRParen, Token.TkEof], 0, [Expr.ExprInt(1)]) => Result.Ok((Expr.ExprTuple([Expr.ExprInt(1), Expr.ExprInt(2)]), 2))
    parseTupleRest([Token.TkEof], 0, []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn finishTupleOrProduct(tokens: List<Token>, pos: Int, items: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After tuple closing ')': check for ?! or ! postfix to form independent product."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkQuestion -> match Domain.ParserMatch.tokenAt(tokens, pos + 1)
            Token.TkBang -> Result.Ok((Expr.ExprIndependentProduct(items, true), pos + 2))
            _ -> Result.Ok((Expr.ExprTuple(items), pos))
        Token.TkBang -> match Domain.ParserMatch.tokenAt(tokens, pos + 1)
            Token.TkLBracket -> Result.Ok((Expr.ExprTuple(items), pos))
            _ -> Result.Ok((Expr.ExprIndependentProduct(items, false), pos + 1))
        _ -> Result.Ok((Expr.ExprTuple(items), pos))

verify finishTupleOrProduct
    finishTupleOrProduct([Token.TkEof], 0, [Expr.ExprInt(1), Expr.ExprInt(2)]) => Result.Ok((Expr.ExprTuple([Expr.ExprInt(1), Expr.ExprInt(2)]), 0))
    finishTupleOrProduct([Token.TkBang, Token.TkEof], 0, [Expr.ExprInt(1), Expr.ExprInt(2)]) => Result.Ok((Expr.ExprIndependentProduct([Expr.ExprInt(1), Expr.ExprInt(2)], false), 1))
    finishTupleOrProduct([Token.TkBang, Token.TkLBracket, Token.TkEof], 0, [Expr.ExprInt(1), Expr.ExprInt(2)]) => Result.Ok((Expr.ExprTuple([Expr.ExprInt(1), Expr.ExprInt(2)]), 0))
    finishTupleOrProduct([Token.TkQuestion, Token.TkBang, Token.TkEof], 0, [Expr.ExprInt(1), Expr.ExprInt(2)]) => Result.Ok((Expr.ExprIndependentProduct([Expr.ExprInt(1), Expr.ExprInt(2)], true), 2))
    finishTupleOrProduct([Token.TkQuestion, Token.TkEof], 0, [Expr.ExprInt(1), Expr.ExprInt(2)]) => Result.Ok((Expr.ExprTuple([Expr.ExprInt(1), Expr.ExprInt(2)]), 0))

fn parseTupleRestTail(tokens: List<Token>, pos0: Int, items: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After tuple element: ',' for more or ')' to end."
    pos = skipNl(tokens, pos0)
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkComma -> parseTupleAfterComma(tokens, skipNl(tokens, pos + 1), items)
        Token.TkRParen -> finishTupleOrProduct(tokens, pos + 1, List.reverse(items))
        _ -> Result.Err("Expected ')' or ',' in tuple")

verify parseTupleRestTail
    parseTupleRestTail([Token.TkRParen, Token.TkEof], 0, [Expr.ExprInt(2), Expr.ExprInt(1)]) => Result.Ok((Expr.ExprTuple([Expr.ExprInt(1), Expr.ExprInt(2)]), 1))
    parseTupleRestTail([Token.TkRParen, Token.TkQuestion, Token.TkBang, Token.TkEof], 0, [Expr.ExprInt(2), Expr.ExprInt(1)]) => Result.Ok((Expr.ExprIndependentProduct([Expr.ExprInt(1), Expr.ExprInt(2)], true), 3))
    parseTupleRestTail([Token.TkRParen, Token.TkBang, Token.TkEof], 0, [Expr.ExprInt(2), Expr.ExprInt(1)]) => Result.Ok((Expr.ExprIndependentProduct([Expr.ExprInt(1), Expr.ExprInt(2)], false), 2))
    parseTupleRestTail([Token.TkEof], 0, []) => Result.Err("Expected ')' or ',' in tuple")

fn parseTupleAfterComma(tokens: List<Token>, pos: Int, items: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "Allow a trailing comma before ')' in tuples."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkRParen -> finishTupleOrProduct(tokens, pos + 1, items)
        _ -> parseTupleRest(tokens, pos, items)

verify parseTupleAfterComma
    parseTupleAfterComma([Token.TkRParen, Token.TkEof], 0, [Expr.ExprInt(2), Expr.ExprInt(1)]) => Result.Ok((Expr.ExprTuple([Expr.ExprInt(1), Expr.ExprInt(2)]), 1))
    parseTupleAfterComma([Token.TkInt(3), Token.TkRParen, Token.TkEof], 0, [Expr.ExprInt(2), Expr.ExprInt(1)]) => Result.Ok((Expr.ExprTuple([Expr.ExprInt(1), Expr.ExprInt(2), Expr.ExprInt(3)]), 2))
    parseTupleAfterComma([Token.TkEof], 0, []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseIdentOrCall(tokens: List<Token>, pos: Int, name: String) -> Result<Tuple<Expr, Int>, String>
    ? "After reading an identifier: call, record constructor, field access, or variable?"
    nextPos = pos + 1
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkLParen -> chainFieldAccess(tokens, nextPos, name)
        Token.TkDot -> parseFieldAccess(tokens, nextPos, Expr.ExprVar(name))
        _ -> Result.Ok((Expr.ExprVar(name), pos))

verify parseIdentOrCall
    parseIdentOrCall([Token.TkEof], 0, "x") => Result.Ok((Expr.ExprVar("x"), 0))
    parseIdentOrCall([Token.TkLParen, Token.TkRParen, Token.TkEof], 0, "f") => Result.Ok((Expr.ExprCall("f", []), 2))
    parseIdentOrCall([Token.TkDot, Token.TkEof], 0, "x") => Result.Err("Expected field name after '.'")

fn chainFieldAccess(tokens: List<Token>, pos: Int, name: String) -> Result<Tuple<Expr, Int>, String>
    ? "Parse call/record then chain .field access if present."
    r = parseCallOrRecord(tokens, pos, name)?
    match r
        (expr, pos2) -> parseFieldAccessTail(tokens, pos2, expr)

verify chainFieldAccess
    chainFieldAccess([Token.TkRParen, Token.TkEof], 0, "f") => Result.Ok((Expr.ExprCall("f", []), 1))
    chainFieldAccess([Token.TkEof], 0, "f") => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseFieldAccess(tokens: List<Token>, pos: Int, obj: Expr) -> Result<Tuple<Expr, Int>, String>
    ? "Parse .field after an expression."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkIdent(field) -> parseFieldAccessTail(tokens, pos + 1, Expr.ExprFieldAccess(obj, field))
        _ -> Result.Err("Expected field name after '.'")

verify parseFieldAccess
    parseFieldAccess([Token.TkIdent("x"), Token.TkEof], 0, Expr.ExprVar("a")) => Result.Ok((Expr.ExprFieldAccess(Expr.ExprVar("a"), "x"), 1))
    parseFieldAccess([Token.TkEof], 0, Expr.ExprVar("a")) => Result.Err("Expected field name after '.'")

fn parseFieldAccessTail(tokens: List<Token>, pos: Int, expr: Expr) -> Result<Tuple<Expr, Int>, String>
    ? "Check for chained field access."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkDot -> parseFieldAccess(tokens, pos + 1, expr)
        _ -> Result.Ok((expr, pos))

verify parseFieldAccessTail
    parseFieldAccessTail([Token.TkEof], 0, Expr.ExprFieldAccess(Expr.ExprVar("a"), "x")) => Result.Ok((Expr.ExprFieldAccess(Expr.ExprVar("a"), "x"), 0))
    parseFieldAccessTail([Token.TkDot, Token.TkEof], 0, Expr.ExprVar("a")) => Result.Err("Expected field name after '.'")

fn skipNl(tokens: List<Token>, pos: Int) -> Int
    ? "Skip newlines and indents inside parenthesized expressions."
    nextPos = pos + 1
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkNewline -> skipNl(tokens, nextPos)
        Token.TkIndent -> skipNl(tokens, nextPos)
        Token.TkDedent -> skipNl(tokens, nextPos)
        _ -> pos

verify skipNl
    skipNl([Token.TkNewline, Token.TkIndent, Token.TkInt(1), Token.TkEof], 0) => 2
    skipNl([Token.TkInt(1), Token.TkEof], 0) => 0

fn parseCallOrRecord(tokens: List<Token>, pos: Int, name: String) -> Result<Tuple<Expr, Int>, String>
    ? "After '(': is this a function call f(args) or record Foo(field = val)?"
    pos2 = skipNl(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkRParen -> Result.Ok((Expr.ExprCall(name, []), pos2 + 1))
        Token.TkIdent(first) -> parseCallOrRecordLookahead(tokens, pos2, name, first)
        _ -> parseCallArgsList(tokens, pos2, name, [])

verify parseCallOrRecord
    parseCallOrRecord([Token.TkRParen, Token.TkEof], 0, "f") => Result.Ok((Expr.ExprCall("f", []), 1))
    parseCallOrRecord([Token.TkEof], 0, "f") => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseCallOrRecordLookahead(tokens: List<Token>, pos: Int, name: String, first: String) -> Result<Tuple<Expr, Int>, String>
    ? "Lookahead after first ident in parens: '=' means record, otherwise call."
    match Domain.ParserMatch.tokenAt(tokens, pos + 1)
        Token.TkEq -> parseRecordFields(tokens, pos, name, [])
        _ -> parseCallArgsList(tokens, pos, name, [])

verify parseCallOrRecordLookahead
    parseCallOrRecordLookahead([Token.TkIdent("a"), Token.TkEq, Token.TkInt(1), Token.TkRParen, Token.TkEof], 0, "Foo", "a") => Result.Ok((Expr.ExprRecord("Foo", [("a", Expr.ExprInt(1))]), 4))
    parseCallOrRecordLookahead([Token.TkIdent("a"), Token.TkEof], 0, "f", "a") => Result.Err("Expected ',' or ')' in argument list")

fn parseRecordFields(tokens: List<Token>, pos: Int, name: String, acc: List<Tuple<String, Expr>>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse record fields: field = expr, ..."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkIdent(field) -> parseRecordField(tokens, pos + 1, name, acc, field)
        _ -> Result.Err("Expected field name in record constructor")

verify parseRecordFields
    parseRecordFields([Token.TkIdent("x"), Token.TkEq, Token.TkInt(1), Token.TkRParen, Token.TkEof], 0, "R", []) => Result.Ok((Expr.ExprRecord("R", [("x", Expr.ExprInt(1))]), 4))
    parseRecordFields([Token.TkEof], 0, "R", []) => Result.Err("Expected field name in record constructor")

fn parseRecordField(tokens: List<Token>, pos: Int, name: String, acc: List<Tuple<String, Expr>>, field: String) -> Result<Tuple<Expr, Int>, String>
    ? "Parse = expr after field name."
    pos2 = Domain.ParserMatch.expect(tokens, pos, Token.TkEq)?
    r = parseExpr(tokens, pos2)?
    match r
        (expr, pos3) -> parseRecordFieldsTail(tokens, pos3, name, List.prepend((field, expr), acc))

verify parseRecordField
    parseRecordField([Token.TkEq, Token.TkInt(1), Token.TkRParen, Token.TkEof], 0, "R", [], "x") => Result.Ok((Expr.ExprRecord("R", [("x", Expr.ExprInt(1))]), 3))
    parseRecordField([Token.TkEof], 0, "R", [], "x") => Result.Err("Expected tokenRepr(TkEq), got tokenRepr(TkEof)")

fn parseRecordFieldsTail(tokens: List<Token>, pos: Int, name: String, fields: List<Tuple<String, Expr>>) -> Result<Tuple<Expr, Int>, String>
    ? "After a field: ',' for more or ')' to end."
    pos2 = skipNl(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkComma -> parseRecordAfterComma(tokens, skipNl(tokens, pos2 + 1), name, fields)
        Token.TkRParen -> Result.Ok((Expr.ExprRecord(name, List.reverse(fields)), pos2 + 1))
        _ -> Result.Err("Expected ',' or ')' in record constructor")

verify parseRecordFieldsTail
    parseRecordFieldsTail([Token.TkRParen, Token.TkEof], 0, "R", [("x", Expr.ExprInt(1))]) => Result.Ok((Expr.ExprRecord("R", [("x", Expr.ExprInt(1))]), 1))
    parseRecordFieldsTail([Token.TkEof], 0, "R", []) => Result.Err("Expected ',' or ')' in record constructor")

fn parseRecordAfterComma(tokens: List<Token>, pos: Int, name: String, fields: List<Tuple<String, Expr>>) -> Result<Tuple<Expr, Int>, String>
    ? "Allow a trailing comma before ')' in record constructors."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkRParen -> Result.Ok((Expr.ExprRecord(name, fields), pos + 1))
        _ -> parseRecordFields(tokens, pos, name, fields)

verify parseRecordAfterComma
    parseRecordAfterComma([Token.TkRParen, Token.TkEof], 0, "R", [("x", Expr.ExprInt(1))]) => Result.Ok((Expr.ExprRecord("R", [("x", Expr.ExprInt(1))]), 1))
    parseRecordAfterComma([Token.TkIdent("y"), Token.TkEq, Token.TkInt(2), Token.TkRParen, Token.TkEof], 0, "R", [("x", Expr.ExprInt(1))]) => Result.Ok((Expr.ExprRecord("R", [("x", Expr.ExprInt(1)), ("y", Expr.ExprInt(2))]), 4))
    parseRecordAfterComma([Token.TkEof], 0, "R", []) => Result.Err("Expected field name in record constructor")

fn parseCallArgsList(tokens: List<Token>, pos: Int, name: String, acc: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse comma-separated argument list."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseCallArgsListTail(tokens, pos2, name, List.prepend(expr, acc))

verify parseCallArgsList
    parseCallArgsList([Token.TkInt(1), Token.TkRParen, Token.TkEof], 0, "f", []) => Result.Ok((Expr.ExprCall("f", [Expr.ExprInt(1)]), 2))
    parseCallArgsList([Token.TkEof], 0, "f", []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseCallArgsListTail(tokens: List<Token>, pos0: Int, name: String, args: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After an argument: ',' for more or ')' to end. Detects named args (field = expr)."
    pos = skipNl(tokens, pos0)
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkComma -> parseCallArgsAfterComma(tokens, skipNl(tokens, pos + 1), name, args)
        Token.TkRParen -> Result.Ok((Expr.ExprCall(name, List.reverse(args)), pos + 1))
        _ -> Result.Err("Expected ',' or ')' in argument list")

verify parseCallArgsListTail
    parseCallArgsListTail([Token.TkRParen, Token.TkEof], 0, "f", [Expr.ExprInt(1)]) => Result.Ok((Expr.ExprCall("f", [Expr.ExprInt(1)]), 1))
    parseCallArgsListTail([Token.TkEof], 0, "f", []) => Result.Err("Expected ',' or ')' in argument list")

fn parseCallArgsAfterComma(tokens: List<Token>, pos: Int, name: String, args: List<Expr>) -> Result<Tuple<Expr, Int>, String>
    ? "After comma in call args: check if next is ident = (named arg) or regular expr."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkRParen -> Result.Ok((Expr.ExprCall(name, List.reverse(args)), pos + 1))
        Token.TkIdent(field) -> parseCallArgsCheckNamed(tokens, pos, name, args, field)
        _ -> parseCallArgsList(tokens, pos, name, args)

verify parseCallArgsAfterComma
    parseCallArgsAfterComma([Token.TkRParen, Token.TkEof], 0, "f", [Expr.ExprInt(1)]) => Result.Ok((Expr.ExprCall("f", [Expr.ExprInt(1)]), 1))
    parseCallArgsAfterComma([Token.TkInt(2), Token.TkRParen, Token.TkEof], 0, "f", [Expr.ExprInt(1)]) => Result.Ok((Expr.ExprCall("f", [Expr.ExprInt(1), Expr.ExprInt(2)]), 2))
    parseCallArgsAfterComma([Token.TkEof], 0, "f", []) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseCallArgsCheckNamed(tokens: List<Token>, pos: Int, name: String, args: List<Expr>, field: String) -> Result<Tuple<Expr, Int>, String>
    ? "Lookahead: if next token after ident is =, switch to named args mode."
    match Domain.ParserMatch.tokenAt(tokens, pos + 1)
        Token.TkEq -> parseNamedArgs(tokens, pos, name, args, [])
        _ -> parseCallArgsList(tokens, pos, name, args)

verify parseCallArgsCheckNamed
    parseCallArgsCheckNamed([Token.TkIdent("x"), Token.TkRParen, Token.TkEof], 0, "f", [], "x") => Result.Ok((Expr.ExprCall("f", [Expr.ExprVar("x")]), 2))
    parseCallArgsCheckNamed([Token.TkIdent("x"), Token.TkEq, Token.TkEof], 0, "f", [], "x") => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseNamedArgs(tokens: List<Token>, pos: Int, name: String, positionalArgs: List<Expr>, namedAcc: List<Tuple<String, Expr>>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse field = expr pairs for named/record-update args."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkIdent(field) -> parseNamedArgField(tokens, pos + 1, name, positionalArgs, namedAcc, field)
        Token.TkRParen -> Result.Ok((Expr.ExprCall(name, List.concat(List.reverse(positionalArgs), [Expr.ExprRecord("_named", List.reverse(namedAcc))])), pos + 1))
        _ -> Result.Err("Expected field name or ')' in named arguments")

verify parseNamedArgs
    parseNamedArgs([Token.TkRParen, Token.TkEof], 0, "f", [Expr.ExprInt(1)], []) => Result.Ok((Expr.ExprCall("f", [Expr.ExprInt(1), Expr.ExprRecord("_named", [])]), 1))
    parseNamedArgs([Token.TkEof], 0, "f", [], []) => Result.Err("Expected field name or ')' in named arguments")

fn parseNamedArgField(tokens: List<Token>, pos: Int, name: String, positionalArgs: List<Expr>, namedAcc: List<Tuple<String, Expr>>, field: String) -> Result<Tuple<Expr, Int>, String>
    ? "Parse = expr after field name in named args."
    pos2 = Domain.ParserMatch.expect(tokens, pos, Token.TkEq)?
    r = parseExpr(tokens, pos2)?
    match r
        (expr, pos3) -> parseNamedArgsTail(tokens, pos3, name, positionalArgs, List.prepend((field, expr), namedAcc))

verify parseNamedArgField
    parseNamedArgField([Token.TkEq, Token.TkInt(1), Token.TkRParen, Token.TkEof], 0, "f", [], [], "x") => Result.Ok((Expr.ExprCall("f", [Expr.ExprRecord("_named", [("x", Expr.ExprInt(1))])]), 3))
    parseNamedArgField([Token.TkEof], 0, "f", [], [], "x") => Result.Err("Expected tokenRepr(TkEq), got tokenRepr(TkEof)")

fn parseNamedArgsTail(tokens: List<Token>, pos0: Int, name: String, positionalArgs: List<Expr>, namedAcc: List<Tuple<String, Expr>>) -> Result<Tuple<Expr, Int>, String>
    ? "After named arg: ',' for more or ')' to end."
    pos = skipNl(tokens, pos0)
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkComma -> parseNamedArgs(tokens, skipNl(tokens, pos + 1), name, positionalArgs, namedAcc)
        Token.TkRParen -> Result.Ok((Expr.ExprCall(name, List.concat(List.reverse(positionalArgs), [Expr.ExprRecord("_named", List.reverse(namedAcc))])), pos + 1))
        _ -> Result.Err("Expected ',' or ')' in named arguments")

verify parseNamedArgsTail
    parseNamedArgsTail([Token.TkRParen, Token.TkEof], 0, "f", [], [("x", Expr.ExprInt(1))]) => Result.Ok((Expr.ExprCall("f", [Expr.ExprRecord("_named", [("x", Expr.ExprInt(1))])]), 1))
    parseNamedArgsTail([Token.TkEof], 0, "f", [], []) => Result.Err("Expected ',' or ')' in named arguments")

fn parseMatchExpr(tokens: List<Token>, pos: Int) -> Result<Tuple<Expr, Int>, String>
    ? "Parse: match expr NEWLINE INDENT arms DEDENT. Called after TkMatch is consumed."
    r = parseExpr(tokens, pos)?
    match r
        (subject, pos2) -> parseMatchAfterSubject(tokens, pos2, subject)

verify parseMatchExpr
    parseMatchExpr([Token.TkInt(1), Token.TkNewline, Token.TkIndent, Token.TkInt(1), Token.TkArrow, Token.TkTrue, Token.TkNewline, Token.TkDedent, Token.TkEof], 0) => Result.Ok((Expr.ExprMatch(Expr.ExprInt(1), [MatchArm(pattern = Pattern.PatInt(1), body = Expr.ExprBool(true), bindingSlots = {})]), 8))
    parseMatchExpr([Token.TkEof], 0) => Result.Err("Expected expression, got tokenRepr(TkEof)")

fn parseMatchAfterSubject(tokens: List<Token>, pos: Int, subject: Expr) -> Result<Tuple<Expr, Int>, String>
    ? "Skip newlines, consume INDENT, then parse arms."
    pos2 = Domain.ParserMatch.skipNewlines(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkIndent -> parseMatchArms(tokens, pos2 + 1, subject, [])
        _ -> parseMatchArmsFlat(tokens, pos2, subject, [])

verify parseMatchAfterSubject
    parseMatchAfterSubject([Token.TkNewline, Token.TkIndent, Token.TkIdent("_"), Token.TkArrow, Token.TkInt(0), Token.TkNewline, Token.TkDedent, Token.TkEof], 0, Expr.ExprVar("x")) => Result.Ok((Expr.ExprMatch(Expr.ExprVar("x"), [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(0), bindingSlots = {})]), 7))
    parseMatchAfterSubject([Token.TkEof], 0, Expr.ExprVar("x")) => Result.Err("Expected at least one match arm")

fn parseMatchArms(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse match arms until DEDENT."
    pos2 = Domain.ParserMatch.skipNewlines(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkDedent -> match acc
            [] -> Result.Err("Expected at least one match arm")
            _ -> Result.Ok((Expr.ExprMatch(subject, List.reverse(acc)), pos2 + 1))
        Token.TkEof -> match acc
            [] -> Result.Err("Expected at least one match arm")
            _ -> Result.Ok((Expr.ExprMatch(subject, List.reverse(acc)), pos2))
        _ -> parseOneArm(tokens, pos2, subject, acc)

verify parseMatchArms
    parseMatchArms([Token.TkIdent("_"), Token.TkArrow, Token.TkInt(0), Token.TkNewline, Token.TkDedent, Token.TkEof], 0, Expr.ExprVar("x"), []) => Result.Ok((Expr.ExprMatch(Expr.ExprVar("x"), [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(0), bindingSlots = {})]), 5))
    parseMatchArms([Token.TkDedent, Token.TkEof], 0, Expr.ExprVar("x"), []) => Result.Err("Expected at least one match arm")

fn parseMatchArmsFlat(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse match arms without INDENT/DEDENT (fallback for flat token streams)."
    match Domain.ParserMatch.isArmStart(tokens, pos)
        true -> parseOneArmFlat(tokens, pos, subject, acc)
        false -> match acc
            [] -> Result.Err("Expected at least one match arm")
            _ -> Result.Ok((Expr.ExprMatch(subject, List.reverse(acc)), pos))

verify parseMatchArmsFlat
    parseMatchArmsFlat([Token.TkIdent("_"), Token.TkArrow, Token.TkInt(0), Token.TkEof], 0, Expr.ExprVar("x"), []) => Result.Ok((Expr.ExprMatch(Expr.ExprVar("x"), [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(0), bindingSlots = {})]), 3))
    parseMatchArmsFlat([Token.TkEof], 0, Expr.ExprVar("x"), []) => Result.Err("Expected at least one match arm")

fn parseOneArmFlat(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse one arm and continue in flat mode."
    pr = Domain.ParserMatch.parsePattern(tokens, pos)?
    match pr
        (pat, pos2) -> parseOneArmFlatBody(tokens, pos2, subject, acc, pat)

verify parseOneArmFlat
    parseOneArmFlat([Token.TkIdent("_"), Token.TkArrow, Token.TkInt(0), Token.TkEof], 0, Expr.ExprVar("x"), []) => Result.Ok((Expr.ExprMatch(Expr.ExprVar("x"), [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(0), bindingSlots = {})]), 3))
    parseOneArmFlat([Token.TkIdent("_"), Token.TkEof], 0, Expr.ExprVar("x"), []) => Result.Err("Expected tokenRepr(TkArrow), got tokenRepr(TkEof)")

fn parseOneArmFlatBody(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>, pat: Pattern) -> Result<Tuple<Expr, Int>, String>
    ? "Parse arrow and body, then continue flat."
    pos2 = Domain.ParserMatch.expect(tokens, pos, Token.TkArrow)?
    er = parseExpr(tokens, pos2)?
    match er
        (body, pos3) -> parseMatchArmsFlat(tokens, Domain.ParserMatch.skipNewlines(tokens, pos3), subject, List.prepend(MatchArm(pattern = pat, body = body, bindingSlots = {}), acc))

verify parseOneArmFlatBody
    parseOneArmFlatBody([Token.TkArrow, Token.TkInt(0), Token.TkEof], 0, Expr.ExprVar("x"), [], Pattern.PatWild) => Result.Ok((Expr.ExprMatch(Expr.ExprVar("x"), [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(0), bindingSlots = {})]), 2))
    parseOneArmFlatBody([Token.TkEof], 0, Expr.ExprVar("x"), [], Pattern.PatWild) => Result.Err("Expected tokenRepr(TkArrow), got tokenRepr(TkEof)")

fn parseOneArm(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>) -> Result<Tuple<Expr, Int>, String>
    ? "Parse one match arm: pattern '->' expr NEWLINE"
    pr = Domain.ParserMatch.parsePattern(tokens, pos)?
    match pr
        (pat, pos2) -> parseOneArmBody(tokens, pos2, subject, acc, pat)

verify parseOneArm
    parseOneArm([Token.TkIdent("_"), Token.TkArrow, Token.TkInt(0), Token.TkNewline, Token.TkDedent, Token.TkEof], 0, Expr.ExprVar("x"), []) => Result.Ok((Expr.ExprMatch(Expr.ExprVar("x"), [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(0), bindingSlots = {})]), 5))
    parseOneArm([Token.TkIdent("_"), Token.TkEof], 0, Expr.ExprVar("x"), []) => Result.Err("Expected tokenRepr(TkArrow), got tokenRepr(TkEof)")

fn parseOneArmBody(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>, pat: Pattern) -> Result<Tuple<Expr, Int>, String>
    ? "Parse arrow and body of a match arm."
    pos2 = Domain.ParserMatch.expect(tokens, pos, Token.TkArrow)?
    er = parseExpr(tokens, pos2)?
    match er
        (body, pos3) -> parseMatchArms(tokens, Domain.ParserMatch.skipNewlines(tokens, pos3), subject, List.prepend(MatchArm(pattern = pat, body = body, bindingSlots = {}), acc))

verify parseOneArmBody
    parseOneArmBody([Token.TkArrow, Token.TkInt(0), Token.TkNewline, Token.TkDedent, Token.TkEof], 0, Expr.ExprVar("x"), [], Pattern.PatWild) => Result.Ok((Expr.ExprMatch(Expr.ExprVar("x"), [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(0), bindingSlots = {})]), 4))
    parseOneArmBody([Token.TkEof], 0, Expr.ExprVar("x"), [], Pattern.PatWild) => Result.Err("Expected tokenRepr(TkArrow), got tokenRepr(TkEof)")
