module Core
    depends [Domain.Ast]
    intent =
        "Core variable and pattern-slot resolution for the self-hosted resolver."
        "Turns ExprVar into ExprSlot and StmtBind into StmtBindSlot."
    exposes [resolveFns]

fn resolveFns(fns: List<FnDef>, acc: List<FnDef>) -> List<FnDef>
    ? "Resolve each function definition."
    match fns
        [] -> List.reverse(acc)
        [f, ..rest] -> resolveFns(rest, List.prepend(resolveFn(f), acc))

fn resolveFn(fd: FnDef) -> FnDef
    ? "Resolve one function: assign slots to params and locals."
    paramResult = buildParamSlots(fd.params, Map.empty(), 0)
    match paramResult
        (slotMap, nextSlot) -> resolveBody(fd, slotMap, nextSlot)

verify resolveFns
    resolveFns([], []) => []
    List.len(resolveFns([FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = Map.empty(), fastPath = FnFastPath.FastNone, tailLoop = false)], [])) => 1

verify resolveFn
    resolveFn(FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = Map.empty(), fastPath = FnFastPath.FastNone, tailLoop = false)).name => "f"

fn buildParamSlots(params: List<String>, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slot indices 0..n-1 to parameters."
    match params
        [] -> (slots, next)
        [p, ..rest] -> buildParamSlots(rest, Map.set(slots, p, next), next + 1)

verify buildParamSlots
    buildParamSlots([], Map.empty(), 0) => (Map.empty(), 0)
    buildParamSlots(["a", "b"], Map.empty(), 0) => (Map.set(Map.set(Map.empty(), "a", 0), "b", 1), 2)

fn resolveBody(fd: FnDef, slots: Map<String, Int>, nextSlot: Int) -> FnDef
    ? "Walk body stmts, resolve vars, track new bindings. slotCount = max slot + 1 from body scan."
    resolved = resolveStmts(fd.body, slots, nextSlot, [])
    match resolved
        (newBody, finalSlot, finalSlotMap) -> computeSlotCount(fd, newBody, finalSlot, finalSlotMap)

verify resolveBody
    resolveBody(FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = Map.empty(), fastPath = FnFastPath.FastNone, tailLoop = false), Map.empty(), 0).body => []

fn computeSlotCount(fd: FnDef, body: List<Stmt>, baseSlot: Int, slotMap: Map<String, Int>) -> FnDef
    ? "Compute slotCount as max slot index found in body + 1."
    maxFromBody = maxSlotInStmts(body, baseSlot - 1)
    FnDef(name = fd.name, params = fd.params, body = body, slotCount = maxFromBody + 1, slotMap = slotMap, fastPath = FnFastPath.FastNone, tailLoop = false)

verify computeSlotCount
    computeSlotCount(FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = Map.empty(), fastPath = FnFastPath.FastNone, tailLoop = false), [Stmt.StmtExpr(Expr.ExprInt(1))], 0, Map.empty()).slotCount => 0

fn maxSlotInStmts(stmts: List<Stmt>, acc: Int) -> Int
    ? "Find highest slot index in a list of statements."
    match stmts
        [] -> acc
        [s, ..rest] -> maxSlotInStmts(rest, maxSlotInStmt(s, acc))

verify maxSlotInStmts
    maxSlotInStmts([], 0 - 1) => 0 - 1
    maxSlotInStmts([Stmt.StmtExpr(Expr.ExprInt(1))], 0 - 1) => 0 - 1

fn maxSlotInStmt(s: Stmt, acc: Int) -> Int
    ? "Find highest slot index in a statement."
    match s
        Stmt.StmtBindSlot(slot, expr) -> maxSlotInExpr(expr, maxInt(slot, acc))
        Stmt.StmtExpr(expr) -> maxSlotInExpr(expr, acc)
        Stmt.StmtBind(_, expr) -> maxSlotInExpr(expr, acc)

verify maxSlotInStmt
    maxSlotInStmt(Stmt.StmtExpr(Expr.ExprInt(1)), 0 - 1) => 0 - 1
    maxSlotInStmt(Stmt.StmtBindSlot(3, Expr.ExprInt(1)), 0 - 1) => 3
    maxSlotInStmt(Stmt.StmtBind("x", Expr.ExprInt(1)), 0 - 1) => 0 - 1

fn maxSlotInExpr(expr: Expr, acc: Int) -> Int
    ? "Find highest slot index in an expression tree."
    match expr
        Expr.ExprBoolBranch(cond, thenExpr, elseExpr) -> maxSlotInExpr(elseExpr, maxSlotInExpr(thenExpr, maxSlotInExpr(cond, acc)))
        Expr.ExprSlot(slot) -> maxInt(slot, acc)
        Expr.ExprBinopSlotInt(_, slot, _) -> maxInt(slot, acc)
        Expr.ExprBinopSlots(_, lhs, rhs) -> maxInt(rhs, maxInt(lhs, acc))
        Expr.ExprCmpSlotInt(_, slot, _) -> maxInt(slot, acc)
        Expr.ExprCmpSlots(_, lhs, rhs) -> maxInt(rhs, maxInt(lhs, acc))
        _ -> maxSlotInExprComposite(expr, acc)

fn maxSlotInExprComposite(expr: Expr, acc: Int) -> Int
    ? "Continue max-slot traversal for composite expression forms."
    match expr
        Expr.ExprVectorGetOrInt(vecExpr, idxExpr, _) -> maxSlotInExpr(idxExpr, maxSlotInExpr(vecExpr, acc))
        Expr.ExprIntModOrInt(a, b, _) -> maxSlotInExpr(b, maxSlotInExpr(a, acc))
        Expr.ExprAdd(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprSub(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprMul(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprDiv(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprEq(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprNeq(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprLt(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprGt(a, b) -> maxSlotInExprPair(a, b, acc)
        _ -> maxSlotInExprAggregate(expr, acc)

fn maxSlotInExprAggregate(expr: Expr, acc: Int) -> Int
    ? "Finish max-slot traversal for aggregate and call expression forms."
    match expr
        Expr.ExprLte(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprGte(a, b) -> maxSlotInExprPair(a, b, acc)
        Expr.ExprCall(_, args) -> maxSlotInExprs(args, acc)
        Expr.ExprCallDirect(_, args) -> maxSlotInExprs(args, acc)
        Expr.ExprCallBuiltin(_, args) -> maxSlotInExprs(args, acc)
        Expr.ExprCallBuiltinId(_, args) -> maxSlotInExprs(args, acc)
        Expr.ExprMatch(subj, arms) -> maxSlotInArms(arms, maxSlotInExpr(subj, acc))
        Expr.ExprPropagate(inner) -> maxSlotInExpr(inner, acc)
        Expr.ExprConcat(parts) -> maxSlotInExprs(parts, acc)
        Expr.ExprTuple(exprs) -> maxSlotInExprs(exprs, acc)
        Expr.ExprIndependentProduct(exprs, _) -> maxSlotInExprs(exprs, acc)
        Expr.ExprList(exprs) -> maxSlotInExprs(exprs, acc)
        Expr.ExprRecord(_, fields) -> maxSlotInFields(fields, acc)
        Expr.ExprFieldAccess(obj, _) -> maxSlotInExpr(obj, acc)
        _ -> acc

fn maxSlotInExprPair(a: Expr, b: Expr, acc: Int) -> Int
    ? "Visit both sides of a binary expression."
    maxSlotInExpr(b, maxSlotInExpr(a, acc))

verify maxSlotInExpr
    maxSlotInExpr(Expr.ExprInt(42), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprSlot(5), 0 - 1) => 5
    maxSlotInExpr(Expr.ExprSlot(2), 7) => 7
    maxSlotInExpr(Expr.ExprFloat(1.0), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprStr("hi"), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprBool(true), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprVar("x"), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprSub(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprMul(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprDiv(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprEq(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprNeq(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprLt(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprGt(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprLte(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprGte(Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprCall("f", []), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprCallDirect(0, []), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprCallBuiltin("Map.get", []), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprCallBuiltinId(0, []), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprMatch(Expr.ExprInt(1), []), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprPropagate(Expr.ExprInt(1)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprConcat([]), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprTuple([]), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprList([]), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprRecord("Foo", []), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprFieldAccess(Expr.ExprInt(1), "x"), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprBoolBranch(Expr.ExprBool(true), Expr.ExprInt(1), Expr.ExprInt(2)), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprBinopSlotInt(BinOp.OpAdd, 3, 1), 0 - 1) => 3
    maxSlotInExpr(Expr.ExprBinopSlots(BinOp.OpAdd, 2, 4), 0 - 1) => 4
    maxSlotInExpr(Expr.ExprCmpSlotInt(CmpOp.CmpEq, 3, 1), 0 - 1) => 3
    maxSlotInExpr(Expr.ExprCmpSlots(CmpOp.CmpEq, 2, 4), 0 - 1) => 4
    maxSlotInExpr(Expr.ExprVectorGetOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0), 0 - 1) => 0 - 1
    maxSlotInExpr(Expr.ExprIntModOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0), 0 - 1) => 0 - 1

fn maxSlotInExprs(exprs: List<Expr>, acc: Int) -> Int
    ? "Find highest slot index in a list of expressions."
    match exprs
        [] -> acc
        [e, ..rest] -> maxSlotInExprs(rest, maxSlotInExpr(e, acc))

verify maxSlotInExprs
    maxSlotInExprs([], 0 - 1) => 0 - 1
    maxSlotInExprs([Expr.ExprSlot(3), Expr.ExprSlot(1)], 0 - 1) => 3

fn maxSlotInFields(fields: List<(String, Expr)>, acc: Int) -> Int
    ? "Find highest slot index in record fields."
    match fields
        [] -> acc
        [pair, ..rest] -> match pair
            (_, expr) -> maxSlotInFields(rest, maxSlotInExpr(expr, acc))

verify maxSlotInFields
    maxSlotInFields([], 0 - 1) => 0 - 1
    maxSlotInFields([("x", Expr.ExprSlot(2))], 0 - 1) => 2

fn maxSlotInArms(arms: List<MatchArm>, acc: Int) -> Int
    ? "Find highest slot index in match arms."
    match arms
        [] -> acc
        [arm, ..rest] -> maxSlotInArms(rest, maxSlotInExpr(arm.body, acc))

verify maxSlotInArms
    maxSlotInArms([], 0 - 1) => 0 - 1
    maxSlotInArms([MatchArm(pattern = Pattern.PatWild, body = Expr.ExprSlot(3), bindingSlots = Map.empty())], 0 - 1) => 3

fn maxInt(a: Int, b: Int) -> Int
    ? "Return the larger of two integers."
    match a > b
        true -> a
        false -> b

verify maxInt
    maxInt(3, 5) => 5
    maxInt(7, 2) => 7
    maxInt(4, 4) => 4

fn resolveStmts(stmts: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Resolve statements, threading slot assignments."
    match stmts
        [] -> (List.reverse(acc), next, slots)
        [s, ..rest] -> resolveOneStmt(s, rest, slots, next, acc)

verify resolveStmts
    resolveStmts([], Map.empty(), 0, []) => ([], 0, Map.empty())
    resolveStmts([Stmt.StmtExpr(Expr.ExprInt(1))], Map.empty(), 0, []) => ([Stmt.StmtExpr(Expr.ExprInt(1))], 0, Map.empty())

fn resolveOneStmt(s: Stmt, rest: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Resolve a single statement and continue."
    match s
        Stmt.StmtBind(name, expr) -> resolveStmtBind(name, expr, rest, slots, next, acc)
        Stmt.StmtExpr(expr) -> resolveStmtExpr(expr, rest, slots, next, acc)
        Stmt.StmtBindSlot(_, _) -> resolveStmts(rest, slots, next, List.prepend(s, acc))

verify resolveOneStmt
    resolveOneStmt(Stmt.StmtExpr(Expr.ExprInt(1)), [], Map.empty(), 0, []) => ([Stmt.StmtExpr(Expr.ExprInt(1))], 0, Map.empty())
    resolveOneStmt(Stmt.StmtBind("x", Expr.ExprInt(1)), [], Map.empty(), 0, []) => ([Stmt.StmtBindSlot(0, Expr.ExprInt(1))], 1, Map.set(Map.empty(), "x", 0))
    resolveOneStmt(Stmt.StmtBindSlot(0, Expr.ExprInt(1)), [], Map.empty(), 0, []) => ([Stmt.StmtBindSlot(0, Expr.ExprInt(1))], 0, Map.empty())

fn resolveStmtExpr(expr: Expr, rest: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Resolve an expression statement, collecting pattern slots."
    match resolveExpr(expr, slots)
        (re, newSlots) -> resolveStmts(rest, newSlots, maxInt(next, mapMaxVal(newSlots) + 1), List.prepend(Stmt.StmtExpr(re), acc))

verify resolveStmtExpr
    resolveStmtExpr(Expr.ExprInt(1), [], Map.empty(), 0, []) => ([Stmt.StmtExpr(Expr.ExprInt(1))], 0, Map.empty())

fn resolveStmtBind(name: String, expr: Expr, rest: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Resolve a binding: assign a new slot, replace with StmtBindSlot."
    match resolveExpr(expr, slots)
        (newExpr, exprSlots) -> resolveStmtBindFinish(name, newExpr, rest, exprSlots, next, acc)

verify resolveStmtBind
    resolveStmtBind("x", Expr.ExprInt(1), [], Map.empty(), 0, []) => ([Stmt.StmtBindSlot(0, Expr.ExprInt(1))], 1, Map.set(Map.empty(), "x", 0))

fn resolveStmtBindFinish(name: String, newExpr: Expr, rest: List<Stmt>, slots: Map<String, Int>, next: Int, acc: List<Stmt>) -> (List<Stmt>, Int, Map<String, Int>)
    ? "Finish resolving a binding after expr is resolved."
    newSlots = Map.set(slots, name, next)
    resolveStmts(rest, newSlots, next + 1, List.prepend(Stmt.StmtBindSlot(next, newExpr), acc))

verify resolveStmtBindFinish
    resolveStmtBindFinish("x", Expr.ExprInt(1), [], Map.empty(), 0, []) => ([Stmt.StmtBindSlot(0, Expr.ExprInt(1))], 1, Map.set(Map.empty(), "x", 0))

fn resolveExpr(expr: Expr, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve an expression. Returns (resolved expr, slots with any new pattern bindings)."
    match expr
        Expr.ExprBoolBranch(cond, thenExpr, elseExpr) -> (Expr.ExprBoolBranch(resolveExprSimple(cond, slots), resolveExprSimple(thenExpr, slots), resolveExprSimple(elseExpr, slots)), slots)
        Expr.ExprVar(name) -> (resolveVar(name, slots), slots)
        Expr.ExprInt(_) -> (expr, slots)
        Expr.ExprFloat(_) -> (expr, slots)
        Expr.ExprStr(_) -> (expr, slots)
        Expr.ExprBool(_) -> (expr, slots)
        Expr.ExprSlot(_) -> (expr, slots)
        _ -> resolveExprAfterLeaf(expr, slots)

fn resolveExprAfterLeaf(expr: Expr, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Continue expression resolution after simple leaf forms."
    match expr
        Expr.ExprBinopSlotInt(_, _, _) -> (expr, slots)
        Expr.ExprBinopSlots(_, _, _) -> (expr, slots)
        Expr.ExprCmpSlotInt(_, _, _) -> (expr, slots)
        Expr.ExprCmpSlots(_, _, _) -> (expr, slots)
        Expr.ExprVectorGetOrInt(vecExpr, idxExpr, defaultValue) -> (Expr.ExprVectorGetOrInt(resolveExprSimple(vecExpr, slots), resolveExprSimple(idxExpr, slots), defaultValue), slots)
        Expr.ExprIntModOrInt(a, b, defaultValue) -> (Expr.ExprIntModOrInt(resolveExprSimple(a, slots), resolveExprSimple(b, slots), defaultValue), slots)
        Expr.ExprAdd(a, b) -> resolveBinExpr(a, b, slots, "add")
        Expr.ExprSub(a, b) -> resolveBinExpr(a, b, slots, "sub")
        Expr.ExprMul(a, b) -> resolveBinExpr(a, b, slots, "mul")
        Expr.ExprDiv(a, b) -> resolveBinExpr(a, b, slots, "div")
        Expr.ExprEq(a, b) -> resolveBinExpr(a, b, slots, "eq")
        Expr.ExprNeq(a, b) -> resolveBinExpr(a, b, slots, "neq")
        _ -> resolveExprAfterArith(expr, slots)

fn resolveExprAfterArith(expr: Expr, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Continue expression resolution after arithmetic forms."
    match expr
        Expr.ExprLt(a, b) -> resolveBinExpr(a, b, slots, "lt")
        Expr.ExprGt(a, b) -> resolveBinExpr(a, b, slots, "gt")
        Expr.ExprLte(a, b) -> resolveBinExpr(a, b, slots, "lte")
        Expr.ExprGte(a, b) -> resolveBinExpr(a, b, slots, "gte")
        Expr.ExprCall(name, args) -> resolveCallExpr(name, args, slots)
        Expr.ExprCallDirect(fnId, args) -> (Expr.ExprCallDirect(fnId, resolveExprs(args, slots, [])), slots)
        Expr.ExprCallBuiltin(name, args) -> (Expr.ExprCallBuiltin(name, resolveExprs(args, slots, [])), slots)
        Expr.ExprCallBuiltinId(id, args) -> (Expr.ExprCallBuiltinId(id, resolveExprs(args, slots, [])), slots)
        Expr.ExprMatch(subj, arms) -> resolveMatchExpr(subj, arms, slots)
        Expr.ExprPropagate(inner) -> resolvePropExpr(inner, slots)
        Expr.ExprConcat(parts) -> resolveConcatExpr(parts, slots)
        Expr.ExprTuple(exprs) -> resolveTupleExpr(exprs, slots)
        _ -> resolveExprAfterAggregate(expr, slots)

fn resolveExprAfterAggregate(expr: Expr, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Finish expression resolution for aggregate forms."
    match expr
        Expr.ExprIndependentProduct(exprs, unwrap) -> resolveIndependentProductExpr(exprs, unwrap, slots)
        Expr.ExprList(exprs) -> resolveListExpr(exprs, slots)
        Expr.ExprRecord(name, fields) -> resolveRecordExpr(name, fields, slots)
        Expr.ExprFieldAccess(obj, field) -> resolveFieldExpr(obj, field, slots)
        _ -> (expr, slots)

verify resolveExpr
    resolveExpr(Expr.ExprInt(42), Map.empty()) => (Expr.ExprInt(42), Map.empty())
    resolveExpr(Expr.ExprStr("hi"), Map.empty()) => (Expr.ExprStr("hi"), Map.empty())
    resolveExpr(Expr.ExprBool(true), Map.empty()) => (Expr.ExprBool(true), Map.empty())
    resolveExpr(Expr.ExprFloat(1.0), Map.empty()) => (Expr.ExprFloat(1.0), Map.empty())
    resolveExpr(Expr.ExprVar("x"), Map.set(Map.empty(), "x", 0)) => (Expr.ExprSlot(0), Map.set(Map.empty(), "x", 0))
    resolveExpr(Expr.ExprVar("y"), Map.empty()) => (Expr.ExprVar("y"), Map.empty())
    resolveExpr(Expr.ExprSlot(3), Map.empty()) => (Expr.ExprSlot(3), Map.empty())
    resolveExpr(Expr.ExprBinopSlotInt(BinOp.OpAdd, 0, 1), Map.empty()) => (Expr.ExprBinopSlotInt(BinOp.OpAdd, 0, 1), Map.empty())
    resolveExpr(Expr.ExprBinopSlots(BinOp.OpAdd, 0, 1), Map.empty()) => (Expr.ExprBinopSlots(BinOp.OpAdd, 0, 1), Map.empty())
    resolveExpr(Expr.ExprCmpSlotInt(CmpOp.CmpEq, 0, 1), Map.empty()) => (Expr.ExprCmpSlotInt(CmpOp.CmpEq, 0, 1), Map.empty())
    resolveExpr(Expr.ExprCmpSlots(CmpOp.CmpEq, 0, 1), Map.empty()) => (Expr.ExprCmpSlots(CmpOp.CmpEq, 0, 1), Map.empty())
    resolveExpr(Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprSub(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprSub(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprMul(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprMul(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprDiv(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprDiv(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprEq(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprEq(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprNeq(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprNeq(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprLt(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprLt(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprGt(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprGt(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprLte(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprLte(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprGte(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprGte(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprCall("f", []), Map.empty()) => (Expr.ExprCall("f", []), Map.empty())
    resolveExpr(Expr.ExprCallDirect(0, []), Map.empty()) => (Expr.ExprCallDirect(0, []), Map.empty())
    resolveExpr(Expr.ExprCallBuiltin("Map.get", []), Map.empty()) => (Expr.ExprCallBuiltin("Map.get", []), Map.empty())
    resolveExpr(Expr.ExprCallBuiltinId(0, []), Map.empty()) => (Expr.ExprCallBuiltinId(0, []), Map.empty())
    resolveExpr(Expr.ExprMatch(Expr.ExprInt(1), []), Map.empty()) => (Expr.ExprMatch(Expr.ExprInt(1), []), Map.empty())
    resolveExpr(Expr.ExprPropagate(Expr.ExprInt(1)), Map.empty()) => (Expr.ExprPropagate(Expr.ExprInt(1)), Map.empty())
    resolveExpr(Expr.ExprConcat([]), Map.empty()) => (Expr.ExprConcat([]), Map.empty())
    resolveExpr(Expr.ExprTuple([]), Map.empty()) => (Expr.ExprTuple([]), Map.empty())
    resolveExpr(Expr.ExprList([]), Map.empty()) => (Expr.ExprList([]), Map.empty())
    resolveExpr(Expr.ExprRecord("Foo", []), Map.empty()) => (Expr.ExprRecord("Foo", []), Map.empty())
    resolveExpr(Expr.ExprFieldAccess(Expr.ExprInt(1), "x"), Map.empty()) => (Expr.ExprFieldAccess(Expr.ExprInt(1), "x"), Map.empty())
    resolveExpr(Expr.ExprBoolBranch(Expr.ExprBool(true), Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty()) => (Expr.ExprBoolBranch(Expr.ExprBool(true), Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveExpr(Expr.ExprVectorGetOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0), Map.empty()) => (Expr.ExprVectorGetOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0), Map.empty())
    resolveExpr(Expr.ExprIntModOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0), Map.empty()) => (Expr.ExprIntModOrInt(Expr.ExprInt(1), Expr.ExprInt(2), 0), Map.empty())

fn resolveBinExpr(a: Expr, b: Expr, slots: Map<String, Int>, op: String) -> (Expr, Map<String, Int>)
    ? "Resolve binary expression and rebuild."
    ra = resolveExprSimple(a, slots)
    rb = resolveExprSimple(b, slots)
    match op
        "add" -> (Expr.ExprAdd(ra, rb), slots)
        "sub" -> (Expr.ExprSub(ra, rb), slots)
        "mul" -> (Expr.ExprMul(ra, rb), slots)
        "div" -> (Expr.ExprDiv(ra, rb), slots)
        "eq" -> (Expr.ExprEq(ra, rb), slots)
        "neq" -> (Expr.ExprNeq(ra, rb), slots)
        "lt" -> (Expr.ExprLt(ra, rb), slots)
        "gt" -> (Expr.ExprGt(ra, rb), slots)
        "lte" -> (Expr.ExprLte(ra, rb), slots)
        "gte" -> (Expr.ExprGte(ra, rb), slots)
        _ -> (Expr.ExprAdd(ra, rb), slots)

verify resolveBinExpr
    resolveBinExpr(Expr.ExprInt(1), Expr.ExprInt(2), Map.empty(), "add") => (Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)), Map.empty())
    resolveBinExpr(Expr.ExprInt(3), Expr.ExprInt(4), Map.empty(), "sub") => (Expr.ExprSub(Expr.ExprInt(3), Expr.ExprInt(4)), Map.empty())

fn resolveExprSimple(expr: Expr, slots: Map<String, Int>) -> Expr
    ? "Resolve expression, discarding slots update (for non-match contexts)."
    match resolveExpr(expr, slots)
        (e, _) -> e

verify resolveExprSimple
    resolveExprSimple(Expr.ExprInt(1), Map.empty()) => Expr.ExprInt(1)
    resolveExprSimple(Expr.ExprVar("x"), Map.set(Map.empty(), "x", 0)) => Expr.ExprSlot(0)

fn resolveCallExpr(name: String, args: List<Expr>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve function call arguments."
    (Expr.ExprCall(name, resolveExprs(args, slots, [])), slots)

verify resolveCallExpr
    resolveCallExpr("foo", [], Map.empty()) => (Expr.ExprCall("foo", []), Map.empty())
    resolveCallExpr("bar", [Expr.ExprVar("x")], Map.set(Map.empty(), "x", 0)) => (Expr.ExprCall("bar", [Expr.ExprSlot(0)]), Map.set(Map.empty(), "x", 0))

fn resolveMatchExpr(subj: Expr, arms: List<MatchArm>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve match expression, collecting pattern slots."
    rs = resolveExprSimple(subj, slots)
    armsResult = resolveArms(arms, slots, [])
    match armsResult
        (resolvedArms, mergedSlots) -> (Expr.ExprMatch(rs, resolvedArms), mergedSlots)

verify resolveMatchExpr
    resolveMatchExpr(Expr.ExprInt(1), [], Map.empty()) => (Expr.ExprMatch(Expr.ExprInt(1), []), Map.empty())

fn resolvePropExpr(inner: Expr, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve ? propagation."
    (Expr.ExprPropagate(resolveExprSimple(inner, slots)), slots)

verify resolvePropExpr
    resolvePropExpr(Expr.ExprInt(1), Map.empty()) => (Expr.ExprPropagate(Expr.ExprInt(1)), Map.empty())

fn resolveConcatExpr(parts: List<Expr>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve string concatenation parts."
    (Expr.ExprConcat(resolveExprs(parts, slots, [])), slots)

verify resolveConcatExpr
    resolveConcatExpr([], Map.empty()) => (Expr.ExprConcat([]), Map.empty())

fn resolveTupleExpr(exprs: List<Expr>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve tuple expressions."
    (Expr.ExprTuple(resolveExprs(exprs, slots, [])), slots)

verify resolveTupleExpr
    resolveTupleExpr([], Map.empty()) => (Expr.ExprTuple([]), Map.empty())

fn resolveIndependentProductExpr(exprs: List<Expr>, unwrap: Bool, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve independent product expressions."
    (Expr.ExprIndependentProduct(resolveExprs(exprs, slots, []), unwrap), slots)

fn resolveListExpr(exprs: List<Expr>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve list expressions."
    (Expr.ExprList(resolveExprs(exprs, slots, [])), slots)

verify resolveListExpr
    resolveListExpr([], Map.empty()) => (Expr.ExprList([]), Map.empty())

fn resolveRecordExpr(name: String, fields: List<(String, Expr)>, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve record expressions."
    (Expr.ExprRecord(name, resolveFields(fields, slots, [])), slots)

verify resolveRecordExpr
    resolveRecordExpr("Foo", [], Map.empty()) => (Expr.ExprRecord("Foo", []), Map.empty())

fn resolveFieldExpr(obj: Expr, field: String, slots: Map<String, Int>) -> (Expr, Map<String, Int>)
    ? "Resolve field access."
    (Expr.ExprFieldAccess(resolveExprSimple(obj, slots), field), slots)

verify resolveFieldExpr
    resolveFieldExpr(Expr.ExprInt(1), "x", Map.empty()) => (Expr.ExprFieldAccess(Expr.ExprInt(1), "x"), Map.empty())

fn resolveVar(name: String, slots: Map<String, Int>) -> Expr
    ? "Resolve a variable: local vars become ExprSlot, others stay ExprVar."
    match Map.get(slots, name)
        Option.Some(slot) -> Expr.ExprSlot(slot)
        Option.None -> Expr.ExprVar(name)

verify resolveVar
    resolveVar("x", Map.set(Map.empty(), "x", 0)) => Expr.ExprSlot(0)
    resolveVar("Option.None", Map.empty()) => Expr.ExprVar("Option.None")
    resolveVar("y", Map.empty()) => Expr.ExprVar("y")

fn resolveExprs(exprs: List<Expr>, slots: Map<String, Int>, acc: List<Expr>) -> List<Expr>
    ? "Resolve a list of expressions."
    match exprs
        [] -> List.reverse(acc)
        [e, ..rest] -> resolveExprs(rest, slots, List.prepend(resolveExprSimple(e, slots), acc))

verify resolveExprs
    resolveExprs([], Map.empty(), []) => []
    resolveExprs([Expr.ExprInt(1)], Map.empty(), []) => [Expr.ExprInt(1)]

fn resolveFields(fields: List<(String, Expr)>, slots: Map<String, Int>, acc: List<(String, Expr)>) -> List<(String, Expr)>
    ? "Resolve record field expressions."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (name, expr) -> resolveFields(rest, slots, List.prepend((name, resolveExprSimple(expr, slots)), acc))

verify resolveFields
    resolveFields([], Map.empty(), []) => []
    resolveFields([("x", Expr.ExprInt(1))], Map.empty(), []) => [("x", Expr.ExprInt(1))]

fn resolveArms(arms: List<MatchArm>, slots: Map<String, Int>, acc: List<MatchArm>) -> (List<MatchArm>, Map<String, Int>)
    ? "Resolve match arms, collecting all pattern slots."
    match arms
        [] -> (List.reverse(acc), slots)
        [arm, ..rest] -> resolveOneArm(arm, rest, slots, acc)

verify resolveArms
    resolveArms([], Map.empty(), []) => ([], Map.empty())
    resolveArms([MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty())], Map.empty(), []) => ([MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty())], Map.empty())

fn resolveOneArm(arm: MatchArm, rest: List<MatchArm>, slots: Map<String, Int>, acc: List<MatchArm>) -> (List<MatchArm>, Map<String, Int>)
    ? "Resolve one match arm and continue."
    match resolveArm(arm, slots)
        (resolvedArm, mergedSlots) -> resolveArms(rest, mergedSlots, List.prepend(resolvedArm, acc))

verify resolveOneArm
    resolveOneArm(MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty()), [], Map.empty(), []) => ([MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty())], Map.empty())

fn resolveArm(arm: MatchArm, slots: Map<String, Int>) -> (MatchArm, Map<String, Int>)
    ? "Resolve a match arm: extend slots with pattern bindings, then resolve body."
    armSlotResult = addPatternSlots(arm.pattern, slots)
    match armSlotResult
        (newSlots, _) -> resolveArmBody(arm, newSlots, patternBindingSlots(arm.pattern, slots))

verify resolveArm
    resolveArm(MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty()), Map.empty()) => (MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty()), Map.empty())

fn resolveArmBody(arm: MatchArm, newSlots: Map<String, Int>, bindingSlots: Map<String, Int>) -> (MatchArm, Map<String, Int>)
    ? "Resolve arm body with extended slots."
    match resolveExpr(arm.body, newSlots)
        (re, finalSlots) -> (MatchArm(pattern = arm.pattern, body = re, bindingSlots = bindingSlots), finalSlots)

verify resolveArmBody
    resolveArmBody(MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty()), Map.empty(), Map.empty()) => (MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty()), Map.empty())

fn patternBindingSlots(pat: Pattern, slots: Map<String, Int>) -> Map<String, Int>
    ? "Compute only the slots introduced by one pattern, using the same numbering as addPatternSlots."
    nextSlot = mapMaxVal(slots) + 1
    match patternBindingSlotsInner(pat, Map.empty(), nextSlot)
        (bindingSlots, _) -> bindingSlots

verify patternBindingSlots
    patternBindingSlots(Pattern.PatWild, Map.empty()) => Map.empty()
    patternBindingSlots(Pattern.PatVar("x"), Map.empty()) => Map.set(Map.empty(), "x", 0)

fn patternBindingSlotsInner(pat: Pattern, bindingSlots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slots to pattern binders without carrying the outer slot map."
    match pat
        Pattern.PatVar(name) -> (Map.set(bindingSlots, name, next), next + 1)
        Pattern.PatCons(h, t) -> patternBindingSlotsCons(h, t, bindingSlots, next)
        Pattern.PatConstructor(_, bindings) -> patternBindingSlotsConstructor(bindings, bindingSlots, next)
        Pattern.PatConstructorId(_, _, bindings) -> patternBindingSlotsConstructor(bindings, bindingSlots, next)
        Pattern.PatTuple(pats) -> patternBindingSlotsTuple(pats, bindingSlots, next)
        _ -> (bindingSlots, next)

verify patternBindingSlotsInner
    patternBindingSlotsInner(Pattern.PatWild, Map.empty(), 0) => (Map.empty(), 0)
    patternBindingSlotsInner(Pattern.PatVar("x"), Map.empty(), 5) => (Map.set(Map.empty(), "x", 5), 6)
    patternBindingSlotsInner(Pattern.PatCons("h", "t"), Map.empty(), 0) => (Map.set(Map.set(Map.empty(), "h", 0), "t", 1), 2)
    patternBindingSlotsInner(Pattern.PatConstructor("Result.Ok", ["v"]), Map.empty(), 0) => (Map.set(Map.empty(), "v", 0), 1)
    patternBindingSlotsInner(Pattern.PatConstructorId(1, "Result.Ok", ["v"]), Map.empty(), 0) => (Map.set(Map.empty(), "v", 0), 1)
    patternBindingSlotsInner(Pattern.PatTuple([Pattern.PatVar("a")]), Map.empty(), 0) => (Map.set(Map.empty(), "a", 0), 1)

fn patternBindingSlotsCons(h: String, t: String, bindingSlots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slots for cons-pattern binders."
    bindingSlots2 = Map.set(bindingSlots, h, next)
    (Map.set(bindingSlots2, t, next + 1), next + 2)

verify patternBindingSlotsCons
    patternBindingSlotsCons("h", "t", Map.empty(), 0) => (Map.set(Map.set(Map.empty(), "h", 0), "t", 1), 2)

fn patternBindingSlotsConstructor(bindings: List<String>, bindingSlots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slots for constructor-pattern binders."
    match bindings
        [] -> (bindingSlots, next)
        [name, ..rest] -> patternBindingSlotsConstructor(rest, Map.set(bindingSlots, name, next), next + 1)

verify patternBindingSlotsConstructor
    patternBindingSlotsConstructor([], Map.empty(), 0) => (Map.empty(), 0)
    patternBindingSlotsConstructor(["a"], Map.empty(), 3) => (Map.set(Map.empty(), "a", 3), 4)

fn patternBindingSlotsTuple(pats: List<Pattern>, bindingSlots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Assign slots for tuple sub-patterns."
    match pats
        [] -> (bindingSlots, next)
        [p, ..rest] -> match patternBindingSlotsInner(p, bindingSlots, next)
            (newBindingSlots, newNext) -> patternBindingSlotsTuple(rest, newBindingSlots, newNext)

verify patternBindingSlotsTuple
    patternBindingSlotsTuple([], Map.empty(), 0) => (Map.empty(), 0)
    patternBindingSlotsTuple([Pattern.PatVar("a")], Map.empty(), 0) => (Map.set(Map.empty(), "a", 0), 1)

fn addPatternSlots(pat: Pattern, slots: Map<String, Int>) -> (Map<String, Int>, Int)
    ? "Find the next available slot and add pattern bindings."
    nextSlot = mapMaxVal(slots) + 1
    addPatternSlotsInner(pat, slots, nextSlot)

verify addPatternSlots
    addPatternSlots(Pattern.PatWild, Map.empty()) => (Map.empty(), 0)
    addPatternSlots(Pattern.PatVar("x"), Map.empty()) => (Map.set(Map.empty(), "x", 0), 1)

fn mapMaxVal(m: Map<String, Int>) -> Int
    ? "Get maximum value in a map, or -1 if empty."
    vals = Map.values(m)
    maxInList(vals, 0 - 1)

verify mapMaxVal
    mapMaxVal(Map.empty()) => 0 - 1
    mapMaxVal(Map.set(Map.empty(), "a", 3)) => 3

fn maxInList(vals: List<Int>, acc: Int) -> Int
    ? "Find maximum value in a list."
    match vals
        [] -> acc
        [v, ..rest] -> match v > acc
            true -> maxInList(rest, v)
            false -> maxInList(rest, acc)

verify maxInList
    maxInList([], 0 - 1) => 0 - 1
    maxInList([0, 2, 1], 0 - 1) => 2
    maxInList([5], 0 - 1) => 5

verify addPatternSlotsInner
    addPatternSlotsInner(Pattern.PatWild, Map.empty(), 0) => (Map.empty(), 0)
    addPatternSlotsInner(Pattern.PatVar("x"), Map.empty(), 2) => (Map.set(Map.empty(), "x", 2), 3)
    addPatternSlotsInner(Pattern.PatInt(5), Map.empty(), 0) => (Map.empty(), 0)
    addPatternSlotsInner(Pattern.PatCons("h", "t"), Map.empty(), 0) => (Map.set(Map.set(Map.empty(), "h", 0), "t", 1), 2)
    addPatternSlotsInner(Pattern.PatConstructor("Result.Ok", ["v"]), Map.empty(), 0) => (Map.set(Map.empty(), "v", 0), 1)
    addPatternSlotsInner(Pattern.PatConstructorId(1, "Result.Ok", ["v"]), Map.empty(), 0) => (Map.set(Map.empty(), "v", 0), 1)
    addPatternSlotsInner(Pattern.PatTuple([Pattern.PatVar("a")]), Map.empty(), 0) => (Map.set(Map.empty(), "a", 0), 1)

fn addPatternSlotsInner(pat: Pattern, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Add slots for pattern bindings."
    match pat
        Pattern.PatVar(name) -> (Map.set(slots, name, next), next + 1)
        Pattern.PatCons(h, t) -> addConsSlots(h, t, slots, next)
        Pattern.PatConstructor(_, bindings) -> addConstructorSlots(bindings, slots, next)
        Pattern.PatConstructorId(_, _, bindings) -> addConstructorSlots(bindings, slots, next)
        Pattern.PatTuple(pats) -> addTuplePatternSlots(pats, slots, next)
        _ -> (slots, next)

fn addConsSlots(h: String, t: String, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Add slots for cons pattern [h, ..t]."
    slots2 = Map.set(slots, h, next)
    (Map.set(slots2, t, next + 1), next + 2)

verify addConsSlots
    addConsSlots("h", "t", Map.empty(), 0) => (Map.set(Map.set(Map.empty(), "h", 0), "t", 1), 2)

fn addConstructorSlots(bindings: List<String>, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Add slots for constructor pattern bindings."
    match bindings
        [] -> (slots, next)
        [name, ..rest] -> addConstructorSlots(rest, Map.set(slots, name, next), next + 1)

verify addConstructorSlots
    addConstructorSlots([], Map.empty(), 0) => (Map.empty(), 0)
    addConstructorSlots(["a", "b"], Map.empty(), 0) => (Map.set(Map.set(Map.empty(), "a", 0), "b", 1), 2)

fn addTuplePatternSlots(pats: List<Pattern>, slots: Map<String, Int>, next: Int) -> (Map<String, Int>, Int)
    ? "Add slots for tuple sub-patterns."
    match pats
        [] -> (slots, next)
        [p, ..rest] -> match addPatternSlotsInner(p, slots, next)
            (newSlots, newNext) -> addTuplePatternSlots(rest, newSlots, newNext)

verify addTuplePatternSlots
    addTuplePatternSlots([], Map.empty(), 0) => (Map.empty(), 0)
    addTuplePatternSlots([Pattern.PatVar("a")], Map.empty(), 0) => (Map.set(Map.empty(), "a", 0), 1)
