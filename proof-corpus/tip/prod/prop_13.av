module Prop13
    intent =
        "TIP prod prop_13: half (x + x) = x."
    effects []

type Nat
    Z
    S(Nat)

fn half(x: Nat) -> Nat
    match x
        Nat.Z -> Nat.Z
        Nat.S(y) -> match y
            Nat.Z -> Nat.Z
            Nat.S(z) -> Nat.S(half(z))

fn plus(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> y
        Nat.S(z) -> Nat.S(plus(z, y))

verify half law halfDouble
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    half(plus(x, x)) => x
