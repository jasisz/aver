module Prop23
    intent =
        "TIP isaplanner prop_23: max a b = max b a (commutativity of max on Nat)."
    effects []

type Nat
    Z
    S(Nat)

fn max(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> y
        Nat.S(z) -> match y
            Nat.Z -> x
            Nat.S(x2) -> Nat.S(max(z, x2))

verify max law maxComm
    given a: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given b: Nat = [Nat.S(Nat.Z), Nat.Z, Nat.S(Nat.S(Nat.Z))]
    max(a, b) => max(b, a)
