module RemaindersRefused
    intent =
        "Laws about Euclidean division that hold on their samples but not for every Int: none may"
        "close by steps. A remainder by 32 can be 31, and a quotient of a negative number rounds"
        "down, not toward zero."
    exposes [rest, half]
    effects []

fn rest(x: Int) -> Int
    ? "x modulo 32."
    Int.mod(x, 32)

verify rest law belowThirtyOne
    given x: Int = [0, 1, 30]
    rest(x) < 31 => true

fn half(x: Int) -> Int
    ? "x divided by 2, rounded down."
    Int.div(x, 2)

verify half law roundsTowardZero
    given x: Int = [-4, -2]
    when x < 0
    half(x) * 2 >= x => true
