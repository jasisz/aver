module Main
    intent =
        "Payment operations argv entrypoint."
        "Keeps the top-level module thin so the CLI and application core stay in their own"
        "modules and `aver context` has a stable root to resume from."
    depends [App.Cli]

fn main() -> Unit
    ? "Starts the payment_ops CLI."
    ! [
        Args.get,
        Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText,
        Time.now,
    ]
    App.Cli.runCli()
