module Sockets
    intent = "Fixture answer module for Wire."
    depends [Wire, Wait]
    exposes [State, fresh, frame]
    effects []

record State
    left: Int

fn fresh() -> State
    ? "Two frames."
    State(left = 2)

fn frame(state: State) -> Tuple<State, Wire.FrameReply>
    ? "A message until none are left."
    match state.left == 0
        true -> (state, Wire.FrameReply.Now(Wire.Heard.Gone("done")))
        false -> (State.update(state, left = state.left - 1), Wire.FrameReply.Now(Wire.Heard.Message("hi")))

verify frame
    frame(fresh()) => (State(left = 1), Wire.FrameReply.Now(Wire.Heard.Message("hi")))
