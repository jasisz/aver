module Commands
    intent =
        "Effectful command handlers for workflow mutations."
        "Each command loads persisted state, calls pure domain functions, runs one explicit"
        "rule pass, then persists audit and notification side effects."
    exposes [Command, CommandReport, execute, runCreateProject, runArchiveProject, runCreateTask, runRenameTask, runStartTask, runBlockTask, runCompleteTask, runReopenTask, runChangePriority, runAddTag, runRemoveTag, runAddComment, runSetDeadline, runClearDeadline, runArchiveTask, runRules]
    depends [Domain.Types, Domain.Projects, Domain.Tasks, Domain.Events, Domain.Rules, Domain.Validation, Infra.Store, Infra.Clock, Infra.Notify, Infra.Audit]

effects Store = [Disk.readText, Disk.writeText, Disk.appendText]
effects StoreRead = [Disk.readText]
effects StoreWrite = [Disk.writeText]
effects StoreAppend = [Disk.appendText]
effects Clock = [Time.now]
effects Notify = [Console.warn, Disk.readText, Disk.appendText]
effects Audit = [Disk.readText, Disk.appendText]

decision OneRulePassPerCommand
    date = "2026-03-08"
    author = "Codex"
    reason =
        "Workflow rules should stay reviewable, not turn into an implicit fixpoint engine."
        "A single pass after each user mutation keeps command flow explicit even if it leaves"
        "some second-order derivations for a later manual `run_rules` call."
    chosen = "SingleExplicitRulePass"
    rejected = ["LoopUntilNoRulesFire", "HideRulesInsideStoreWrites"]
    impacts = [execute, persistTaskMutation, persistRuleOnly]

type Command
    CreateProject(String, String)
    ArchiveProject(String)
    CreateTask(String, String, String, Priority, List<String>, Option<String>)
    RenameTask(String, String)
    StartTask(String)
    BlockTask(String, String)
    CompleteTask(String)
    ReopenTask(String, String)
    ChangePriority(String, Priority)
    AddTag(String, String)
    RemoveTag(String, String)
    AddComment(String, String, String)
    SetDeadline(String, String)
    ClearDeadline(String)
    ArchiveTask(String)
    RunRules(Option<String>)

record CommandReport
    summary: String
    subjectId: String
    events: List<TaskEventRecord>
    notifications: List<Notification>
    audits: List<AuditEntry>

record TaskContext
    project: Project
    task: Task
    allEvents: List<TaskEventRecord>
    taskEvents: List<TaskEventRecord>
    latest: Option<TaskEventRecord>

fn execute(command: Command) -> Result<CommandReport, String>
    ? "Executes one workflow command."
    ! [Store, Clock, Notify, Audit]
    match command
        Command.CreateProject(projectId, name) -> runCreateProject(projectId, name)
        Command.ArchiveProject(projectId) -> runArchiveProject(projectId)
        Command.CreateTask(projectId, taskId, title, priority, tags, deadline) -> runCreateTask(projectId, taskId, title, priority, tags, deadline)
        Command.RenameTask(taskId, title) -> runRenameTask(taskId, title)
        Command.StartTask(taskId) -> runStartTask(taskId)
        Command.BlockTask(taskId, reason) -> runBlockTask(taskId, reason)
        Command.CompleteTask(taskId) -> runCompleteTask(taskId)
        Command.ReopenTask(taskId, reason) -> runReopenTask(taskId, reason)
        Command.ChangePriority(taskId, priority) -> runChangePriority(taskId, priority)
        Command.AddTag(taskId, tag) -> runAddTag(taskId, tag)
        Command.RemoveTag(taskId, tag) -> runRemoveTag(taskId, tag)
        Command.AddComment(taskId, author, body) -> runAddComment(taskId, author, body)
        Command.SetDeadline(taskId, deadline) -> runSetDeadline(taskId, deadline)
        Command.ClearDeadline(taskId) -> runClearDeadline(taskId)
        Command.ArchiveTask(taskId) -> runArchiveTask(taskId)
        Command.RunRules(scope) -> runRulesCommand(scope)

fn runCreateProject(projectId: String, name: String) -> Result<CommandReport, String>
    ? "Creates a project and records a project-scoped audit entry."
    ! [StoreRead, StoreWrite, Clock, Audit]
    now = Infra.Clock.now()
    projects = Infra.Store.loadProjects()?
    _missing = ensureProjectMissing(projects, projectId)?
    project = Domain.Projects.createProject(projectId, name, now)?
    _saved = Infra.Store.saveProjects(Domain.Projects.putProject(projects, project))?
    audit = projectAudit(projectId, "project.created", "Created project '{projectId}'", now)
    _recorded = Infra.Audit.recordEntry(audit)?
    Result.Ok(report("Created project '{projectId}'", projectSubject(projectId), [], [], [audit]))

fn runArchiveProject(projectId: String) -> Result<CommandReport, String>
    ? "Archives a project and records a project-scoped audit entry."
    ! [StoreRead, StoreWrite, Clock, Audit]
    now = Infra.Clock.now()
    projects = Infra.Store.loadProjects()?
    current = requireProject(projects, projectId)?
    archived = Domain.Projects.archiveProject(current, now)?
    _saved = Infra.Store.saveProjects(Domain.Projects.putProject(projects, archived))?
    audit = projectAudit(projectId, "project.archived", "Archived project '{projectId}'", now)
    _recorded = Infra.Audit.recordEntry(audit)?
    Result.Ok(report("Archived project '{projectId}'", projectSubject(projectId), [], [], [audit]))

fn runCreateTask(projectId: String, taskId: String, title: String, priority: Priority, tags: List<String>, deadline: Option<String>) -> Result<CommandReport, String>
    ? "Creates a new task inside an active project."
    ! [StoreRead, StoreAppend, Clock, Notify, Audit]
    now = Infra.Clock.now()
    projects = Infra.Store.loadProjects()?
    events = Infra.Store.loadTaskEvents()?
    project = requireProject(projects, projectId)?
    _active = Domain.Validation.ensureProjectActive(project)?
    _absent = ensureTaskMissing(events, taskId)?
    event = Domain.Tasks.createTask(taskId, projectId, title, priority, tags, deadline, now)?
    persistTaskMutation(project, events, [], event, now, "Created task '{taskId}'")

fn runRenameTask(taskId: String, title: String) -> Result<CommandReport, String>
    ? "Renames a task in an active project."
    ! [StoreRead, StoreAppend, Clock, Notify, Audit]
    context = loadTaskContext(taskId)?
    now = Infra.Clock.now()
    _active = Domain.Validation.ensureProjectActive(context.project)?
    event = Domain.Tasks.renameTask(context.task, Domain.Tasks.nextSeq(context.taskEvents), title, now)?
    persistTaskMutation(context.project, context.allEvents, context.taskEvents, event, now, "Renamed task '{taskId}'")

fn runStartTask(taskId: String) -> Result<CommandReport, String>
    ? "Moves a task into active work."
    ! [StoreRead, StoreAppend, Clock, Notify, Audit]
    context = loadTaskContext(taskId)?
    now = Infra.Clock.now()
    _active = Domain.Validation.ensureProjectActive(context.project)?
    event = Domain.Tasks.startTask(context.task, Domain.Tasks.nextSeq(context.taskEvents), now)?
    persistTaskMutation(context.project, context.allEvents, context.taskEvents, event, now, "Started task '{taskId}'")

