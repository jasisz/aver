module Render
    intent =
        "The effectful half of the renderer: prints the viewport rows, enemy sprites,"
        "crosshair, status panel, minimap and messages, laid out for an 80 x 24 terminal."
    depends [Types, Tiles, Ray, Enemy, View, Texture]
    effects [
        Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.resetColor, Terminal.setColor,
    ]

decision RowsPrintedAsRuns
    date = "2026-11-24"
    author = "Claude"
    reason =
        "The frame was printed cell by cell, column by column: a color change, a cursor move,"
        "a print and a color reset for each of 1200 cells, about 4800 terminal operations per frame."
        "Rows are now built as runs of equal color and printed with one cursor move per row"
        "and one color change per run."
        "The rows are data made by pure code in View, so verify can check a frame; printing is a thin loop."
    chosen = "RunsPerRow"
    rejected = ["CellByCell"]
    impacts = [printRuns, renderView, renderMinimap]

decision LayoutFor80x24
    date = "2026-11-24"
    author = "Claude"
    reason =
        "The minimap was drawn in rows 15 to 30, below the bottom of a 24-row terminal"
        "and of the playground's screen, and overlapped the place meant for messages."
        "Messages about hits and damage were collected but never printed."
        "The panel right of the viewport now holds title, health and the minimap in rows 0 to 19;"
        "controls and the last three messages take rows 20 to 23 under the viewport."
    chosen = "PanelRightMessagesBelow"
    rejected = ["MinimapBelowControls"]
    impacts = [renderHud, renderMinimap, renderMessages, panelX]

decision MinimapShowsOnlySeenEnemies
    date = "2026-11-24"
    author = "Claude"
    reason =
        "The minimap marked every enemy within eight tiles, through any wall,"
        "so it answered what the 3D view is there to make the player find out."
        "An enemy is marked only while there is line of sight from the player to it,"
        "the same test the enemy uses to notice the player."
    chosen = "LineOfSight"
    rejected = ["AllNearbyEnemies"]
    impacts = [seenEnemyAt, minimapCell]

fn moveToChecked(x: Int, y: Int) -> Result<Unit, String>
    ? "Move the cursor and propagate a terminal error to the render caller."
    ! [Terminal.moveTo]
    Terminal.moveTo(x, y)

fn panelX() -> Int
    ? "First terminal column of the panel right of the viewport"
    View.screenW() + 2

verify panelX
    panelX() => 62

fn printRuns(runs: List<Run>) -> Result<Unit, String>
    ? "Print runs at the cursor, one color change per run"
    ! [Terminal.print, Terminal.setColor]
    match runs
        [] -> Result.Ok(Unit)
        [run, ..rest] -> printRun(run, rest)

fn printRun(run: Run, rest: List<Run>) -> Result<Unit, String>
    ? "Print one run, then the rest"
    ! [Terminal.print, Terminal.setColor]
    Terminal.setColor(run.color)?
    Terminal.print(run.text)?
    printRuns(rest)

// ─── Viewport ──────────────────────────────────────────────────────────────

fn renderView(cols: Vector<Column>, row: Int) -> Result<Unit, String>
    ? "Print the walls, floor and ceiling of the viewport from row down"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    match row >= View.screenH()
        true -> Result.Ok(Unit)
        false -> renderViewRow(cols, row)

fn renderViewRow(cols: Vector<Column>, row: Int) -> Result<Unit, String>
    ? "Print one viewport row, then the rows below"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    moveToChecked(0, row)?
    printRuns(View.viewRow(cols, row, 0, []))?
    renderView(cols, row + 1)

fn renderSprites(sprites: List<Sprite>, cols: Vector<Column>) -> Result<Unit, String>
    ? "Paint enemy sprites in the order given: farthest first"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    match sprites
        [] -> Result.Ok(Unit)
        [s, ..rest] -> renderSprite(s, rest, cols)

fn renderSprite(s: Sprite, rest: List<Sprite>, cols: Vector<Column>) -> Result<Unit, String>
    ? "Paint one sprite, then the nearer ones"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    Terminal.setColor(Types.enemyColor(s.kind))?
    renderSpriteCells(s, cols, Int.max(0, s.top), Int.max(0, s.left))?
    renderSprites(rest, cols)

fn renderSpriteCells(s: Sprite, cols: Vector<Column>, cy: Int, cx: Int) -> Result<Unit, String>
    ? "Walk the on-screen part of a sprite's rectangle from cell (cx, cy)"
    ! [Terminal.moveTo, Terminal.print]
    match cy >= Int.min(View.screenH(), s.top + s.rows)
        true -> Result.Ok(Unit)
        false -> match cx >= Int.min(View.screenW(), s.left + s.cols)
            true -> renderSpriteCells(s, cols, cy + 1, Int.max(0, s.left))
            false -> renderSpriteCell(s, cols, cy, cx)

fn renderSpriteCell(s: Sprite, cols: Vector<Column>, cy: Int, cx: Int) -> Result<Unit, String>
    ? "Paint one sprite cell when the sprite shows there"
    ! [Terminal.moveTo, Terminal.print]
    match View.spriteShows(s, cols, cx, cy)
        true -> paintSpriteCell(s, cols, cy, cx)
        false -> renderSpriteCells(s, cols, cy, cx + 1)

fn paintSpriteCell(s: Sprite, cols: Vector<Column>, cy: Int, cx: Int) -> Result<Unit, String>
    ? "Print a full block at a sprite cell and go on"
    ! [Terminal.moveTo, Terminal.print]
    moveToChecked(cx, cy)?
    Terminal.print(Texture.fullBlock())?
    renderSpriteCells(s, cols, cy, cx + 1)

fn crosshairColor(state: GameState) -> String
    ? "Yellow while a shot would hit an enemy, white otherwise"
    match Enemy.aimedAt(state.enemies, state.player, state.grid)
        Option.Some(_) -> "yellow"
        Option.None -> "white"

verify crosshairColor
    crosshairColor(GameState(grid = Tiles.gridOf(["....."]), player = Types.mkPlayer(0.5, 0.5), enemies = [Types.mkEnemy(3.5, 0.5, EnemyKind.Imp, 3)], seed = 0, messages = [], status = Status.Playing, turnCount = 0)) => "yellow"
    crosshairColor(GameState(grid = Tiles.gridOf(["....."]), player = Types.mkPlayer(0.5, 0.5), enemies = [], seed = 0, messages = [], status = Status.Playing, turnCount = 0)) => "white"

fn renderCrosshair(state: GameState) -> Result<Unit, String>
    ? "Draw the crosshair at the centre of the viewport"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    Terminal.setColor(crosshairColor(state))?
    moveToChecked(Int.div(View.screenW(), 2), Int.div(View.screenH(), 2))?
    Terminal.print("+")

// ─── Status panel ──────────────────────────────────────────────────────────

fn repeat(s: String, n: Int, acc: String) -> String
    ? "acc followed by n copies of s"
    match n <= 0
        true -> acc
        false -> repeat(s, n - 1, acc + s)

verify repeat
    repeat("ab", 2, "x") => "xabab"
    repeat("ab", 0, "x") => "x"
    repeat("ab", 0 - 1, "x") => "x"

fn hpBar(hp: Int) -> String
    ? "Ten-cell health bar; any health above zero shows at least one cell"
    full = Int.max(0, Int.min(10, Int.div(hp + 9, 10)))
    repeat("░", 10 - full, repeat("█", full, ""))

verify hpBar
    hpBar(100) => "██████████"
    hpBar(55) => "██████░░░░"
    hpBar(1) => "█░░░░░░░░░"
    hpBar(0) => "░░░░░░░░░░"
    hpBar(0 - 5) => "░░░░░░░░░░"
    hpBar(250) => "██████████"

fn hpColor(hp: Int) -> String
    ? "Health color: green, then yellow below half, red below a quarter"
    match hp > 50
        true -> "green"
        false -> match hp > 25
            true -> "yellow"
            false -> "red"

verify hpColor
    hpColor(100) => "green"
    hpColor(50) => "yellow"
    hpColor(25) => "red"

fn renderHud(state: GameState) -> Result<Unit, String>
    ? "Draw title, health and enemy count in the panel, and the controls under the viewport"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    hp = Int.max(0, state.player.hp)
    Terminal.setColor("yellow")?
    moveToChecked(panelX(), 0)?
    Terminal.print("BRAILLE DOOM")?
    Terminal.setColor(hpColor(hp))?
    moveToChecked(panelX(), 1)?
    Terminal.print("HP {hpBar(hp)} {hp}")?
    Terminal.setColor("white")?
    moveToChecked(panelX(), 2)?
    Terminal.print("enemies: {List.len(state.enemies)}")?
    Terminal.setColor("cyan")?
    moveToChecked(0, View.screenH())?
    Terminal.print("W/S move  A/D strafe  ←/→ turn  Q/E turn+walk  SPACE fire  X quit")

fn renderMessages(msgs: List<String>, i: Int) -> Result<Unit, String>
    ? "Show the recent messages under the controls, oldest first"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    match msgs
        [] -> Result.Ok(Unit)
        [msg, ..rest] -> renderMessage(msg, rest, i)

fn renderMessage(msg: String, rest: List<String>, i: Int) -> Result<Unit, String>
    ? "Print message i on its own line, then the later ones"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    Terminal.setColor("yellow")?
    moveToChecked(0, View.screenH() + 1 + i)?
    Terminal.print(msg)?
    renderMessages(rest, i + 1)

// ─── Minimap ───────────────────────────────────────────────────────────────

fn mapSize() -> Int
    ? "Width and height of the minimap in tiles, centred on the player"
    16

verify mapSize
    mapSize() => 16

fn seenEnemyAt(enemies: List<Enemy>, player: Player, grid: Grid, mx: Int, my: Int) -> Option<EnemyKind>
    ? "Kind of an enemy standing on tile (mx, my) that the player has line of sight to"
    match enemies
        [] -> Option.None
        [e, ..rest] -> match Bool.and(Float.floor(e.x) == mx, Float.floor(e.y) == my)
            false -> seenEnemyAt(rest, player, grid, mx, my)
            true -> match Ray.lineOfSight(grid, player.x, player.y, e.x, e.y)
                true -> Option.Some(e.kind)
                false -> seenEnemyAt(rest, player, grid, mx, my)

verify seenEnemyAt
    seenEnemyAt([], Types.mkPlayer(0.5, 0.5), Tiles.gridOf(["....."]), 3, 0) => Option.None
    seenEnemyAt([Types.mkEnemy(3.5, 0.5, EnemyKind.Ghost, 4)], Types.mkPlayer(0.5, 0.5), Tiles.gridOf(["....."]), 3, 0) => Option.Some(EnemyKind.Ghost)
    seenEnemyAt([Types.mkEnemy(3.5, 0.5, EnemyKind.Ghost, 4)], Types.mkPlayer(0.5, 0.5), Tiles.gridOf(["....."]), 2, 0) => Option.None
    seenEnemyAt([Types.mkEnemy(3.5, 0.5, EnemyKind.Ghost, 4)], Types.mkPlayer(0.5, 0.5), Tiles.gridOf(["..#.."]), 3, 0) => Option.None

fn minimapCell(state: GameState, mx: Int, my: Int) -> Run
    ? "One minimap tile: the player's arrow, a seen enemy, wall, or open floor"
    isPlayer = Bool.and(Float.floor(state.player.x) == mx, Float.floor(state.player.y) == my)
    match isPlayer
        true -> Run(color = "yellow", text = Types.dirArrow(state.player.angle))
        false -> match seenEnemyAt(state.enemies, state.player, state.grid, mx, my)
            Option.Some(kind) -> Run(color = Types.enemyColor(kind), text = "*")
            Option.None -> match Tiles.solid(state.grid, mx, my)
                true -> Run(color = "green", text = "#")
                false -> Run(color = "green", text = " ")

verify minimapCell
    minimapCell(GameState(grid = Tiles.gridOf(["...#."]), player = Types.mkPlayer(0.5, 0.5), enemies = [Types.mkEnemy(2.5, 0.5, EnemyKind.Imp, 3), Types.mkEnemy(4.5, 0.5, EnemyKind.Imp, 3)], seed = 0, messages = [], status = Status.Playing, turnCount = 0), 0, 0) => Run(color = "yellow", text = "→")
    minimapCell(GameState(grid = Tiles.gridOf(["...#."]), player = Types.mkPlayer(0.5, 0.5), enemies = [Types.mkEnemy(2.5, 0.5, EnemyKind.Imp, 3), Types.mkEnemy(4.5, 0.5, EnemyKind.Imp, 3)], seed = 0, messages = [], status = Status.Playing, turnCount = 0), 2, 0) => Run(color = "red", text = "*")
    minimapCell(GameState(grid = Tiles.gridOf(["...#."]), player = Types.mkPlayer(0.5, 0.5), enemies = [Types.mkEnemy(2.5, 0.5, EnemyKind.Imp, 3), Types.mkEnemy(4.5, 0.5, EnemyKind.Imp, 3)], seed = 0, messages = [], status = Status.Playing, turnCount = 0), 3, 0) => Run(color = "green", text = "#")
    minimapCell(GameState(grid = Tiles.gridOf(["...#."]), player = Types.mkPlayer(0.5, 0.5), enemies = [Types.mkEnemy(2.5, 0.5, EnemyKind.Imp, 3), Types.mkEnemy(4.5, 0.5, EnemyKind.Imp, 3)], seed = 0, messages = [], status = Status.Playing, turnCount = 0), 4, 0) => Run(color = "green", text = " ")

fn minimapRow(state: GameState, my: Int, mx: Int, endX: Int, acc: List<Run>) -> List<Run>
    ? "Minimap tiles mx..endX-1 of map row my as runs"
    cell = minimapCell(state, mx, my)
    match mx >= endX
        true -> List.reverse(acc)
        false -> minimapRow(state, my, mx + 1, endX, View.pushCell(acc, cell.color, cell.text))

verify minimapRow
    minimapRow(GameState(grid = Tiles.gridOf(["...#."]), player = Types.mkPlayer(0.5, 0.5), enemies = [], seed = 0, messages = [], status = Status.Playing, turnCount = 0), 0, 0, 5, []) => [Run(color = "yellow", text = "→  "), Run(color = "green", text = "# ")]
    minimapRow(GameState(grid = Tiles.gridOf(["...#."]), player = Types.mkPlayer(0.5, 0.5), enemies = [], seed = 0, messages = [], status = Status.Playing, turnCount = 0), 0, 5, 5, []) => []

fn renderMinimap(state: GameState, row: Int) -> Result<Unit, String>
    ? "Draw the minimap in the panel from row down"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    match row >= mapSize()
        true -> Result.Ok(Unit)
        false -> renderMinimapRow(state, row)

fn renderMinimapRow(state: GameState, row: Int) -> Result<Unit, String>
    ? "Draw one minimap row, then the rows below"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    half = Int.div(mapSize(), 2)
    left = Float.floor(state.player.x) - half
    moveToChecked(panelX(), 4 + row)?
    printRuns(minimapRow(state, Float.floor(state.player.y) - half + row, left, left + mapSize(), []))?
    renderMinimap(state, row + 1)

// ─── End of game ───────────────────────────────────────────────────────────

fn bannerText(status: Status) -> String
    ? "Headline shown over the viewport when the game has ended"
    match status
        Status.Playing -> ""
        Status.Dead -> "YOU DIED"
        Status.Cleared -> "AREA CLEAR"

verify bannerText
    bannerText(Status.Playing) => ""
    bannerText(Status.Dead) => "YOU DIED"
    bannerText(Status.Cleared) => "AREA CLEAR"

fn bannerColor(status: Status) -> String
    ? "Color of the end-of-game headline"
    match status
        Status.Dead -> "red"
        _ -> "green"

verify bannerColor
    bannerColor(Status.Dead) => "red"
    bannerColor(Status.Cleared) => "green"

fn centred(text: String) -> Int
    ? "Terminal column at which text is centred in the viewport"
    Int.div(View.screenW() - String.len(text), 2)

verify centred
    centred("YOU DIED") => 26
    centred("") => 30

fn renderBanner(status: Status) -> Result<Unit, String>
    ? "Draw the end-of-game headline and what to press, or nothing while playing"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    match status
        Status.Playing -> Result.Ok(Unit)
        _ -> renderBannerLines(status)

fn renderBannerLines(status: Status) -> Result<Unit, String>
    ? "Draw the two lines of the end-of-game banner"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor]
    title = "  {bannerText(status)}  "
    prompt = "  R new level   X quit  "
    Terminal.setColor(bannerColor(status))?
    moveToChecked(centred(title), 8)?
    Terminal.print(title)?
    Terminal.setColor("white")?
    moveToChecked(centred(prompt), 10)?
    Terminal.print(prompt)

// ─── Full frame ────────────────────────────────────────────────────────────

fn renderFrame(state: GameState) -> Result<Unit, String>
    ? "Render viewport, enemies, crosshair, panel, minimap and messages"
    ! [Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.resetColor, Terminal.setColor]
    cols = View.columns(state.grid, state.player, 0, [])
    renderView(cols, 0)?
    renderSprites(View.sprites(state.player, state.enemies, []), cols)?
    renderCrosshair(state)?
    renderHud(state)?
    renderMinimap(state, 0)?
    renderMessages(state.messages, 0)?
    renderBanner(state.status)?
    Terminal.resetColor()?
    Terminal.flush()
