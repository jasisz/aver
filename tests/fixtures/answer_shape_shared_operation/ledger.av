module Ledger
    intent = "An answer module asked to answer two operations with one function."
    depends [Chain, Pool]
    exposes [State, claim, gone]
    effects []
    answers [Pool, Chain]

record State
    free: List<Int>
    stopping: Bool

fn claim(state: State, key: Int) -> Pool.Assignment
    ? "The next height for this peer."
    Pool.Assignment.Idle

fn gone(state: State, key: Int) -> Tuple<State, Result<Unit, Run.Wake>>
    ? "A peer that left gives its height back."
    (state, Result.Ok(Unit))
