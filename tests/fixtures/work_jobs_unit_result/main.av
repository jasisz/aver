module Main
    depends [Node, Tick, Work, Wait]
    intent = "Starts one job whose task carries nothing and says what it answered."
    exposes [main]
    effects [Console.print, Tick.begin, Tick.take, Wait.poll]

fn main() -> Result<Unit, String>
    ? "Starts one tick, waits for its completion and says what it answered."
    ! [Console.print, Tick.begin, Tick.take, Wait.poll]
    job = Tick.begin(Unit)?
    ready = Wait.poll({1 => Wait.Item.Job(job)}, 1000)?
    said(Tick.take(job)?)
    Result.Ok(Unit)

fn said(answer: Option<Unit>) -> Unit
    ? "Says what one take carried: a completed Unit, or nothing yet."
    ! [Console.print]
    match answer
        Option.Some(_) -> Console.print("unit-work-ok")
        Option.None -> Console.print("nothing yet")
