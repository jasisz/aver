module Pooled
    intent = "Fixture answer module: the answers this program gives to Pool's two operations, from one state."
    depends [Pool, Wait]
    effects []
    answers [Pool]

record State
    left: Int

fn claim(state: State, peer: Int) -> Tuple<State, Result<Option<Int>, Run.Wake>>
    ? "Hands the peer its own number back as a handle."
    (state, Result.Ok(Option.Some(peer)))

fn release(state: State, handle: Int) -> Tuple<State, Result<Bool, Run.Wake>>
    ? "Takes a handle back and says it was one this state had handed out."
    (state, Result.Ok(true))
