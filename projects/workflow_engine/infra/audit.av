module Audit
    intent =
        "Audit trail persistence for workflow actions and rule follow-ups."
        "Audit entries stay outside the task event log because some audit records explain"
        "why a decision happened rather than representing state reconstruction inputs."
    exposes [initAudit, loadEntries, recordEntries, forSubject]
    depends [Domain.Types, Infra.Codec, Infra.Store]
    effects [Disk]

decision AuditsStayAdjacentToEventsNotInsideThem
    date = "2026-03-08"
    author = "Codex"
    reason =
        "Reopen reasons and command traces are valuable to reviewers, but they should not"
        "change replay semantics for task state."
    chosen = "SeparateAuditLog"
    rejected = ["EncodeAllAuditNarrativeAsTaskEvents", "NoAuditTrail"]
    impacts = [recordEntries, loadEntries]

fn auditPath() -> String
    ? "Path for persisted audit entries."
    "{Infra.Store.dataDir()}/audits.txt"

verify auditPath
    auditPath() => "/tmp/aver_workflow_engine/audits.txt"

fn initFileIfMissing(path: String) -> Result<Unit, String>
    ? "Creates an empty audit file only when needed."
    ! [Disk.appendText, Disk.exists, Disk.writeText]
    match Disk.exists(path)
        true -> Disk.appendText(path, "")
        false -> Disk.writeText(path, "")

fn initAudit() -> Result<Unit, String>
    ? "Ensures the audit file exists."
    ! [Disk.appendText, Disk.exists, Disk.makeDir, Disk.writeText]
    _ = Disk.makeDir(Infra.Store.dataDir())?
    initFileIfMissing(auditPath())

fn renderLines(lines: List<String>) -> String
    ? "Turns serialized audit lines into file text."
    match List.len(lines) == 0
        true -> ""
        false -> "{String.join(lines, "\n")}\n"

verify renderLines
    renderLines([]) => ""
    renderLines(["a", "b"]) => "a\nb\n"

fn serializeAudit(entry: AuditEntry) -> String
    ? "Encodes one audit entry as a flat-file line."
    String.join([entry.key, entry.taskId, entry.action, Infra.Codec.escapeField(entry.message), entry.createdAt], "|")

verify serializeAudit
    serializeAudit(AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "Task | closed", createdAt = "2026-03-08T12:00:00Z")) => "k1|t1|task.completed|Task %7C closed|2026-03-08T12:00:00Z"

fn deserializeAudit(line: String) -> Result<AuditEntry, String>
    ? "Decodes one audit entry line."
    parts = String.split(line, "|")
    key = Infra.Codec.fieldAt(parts, 0, "audit")?
    taskId = Infra.Codec.fieldAt(parts, 1, "audit")?
    action = Infra.Codec.fieldAt(parts, 2, "audit")?
    message = Infra.Codec.fieldAt(parts, 3, "audit")?
    createdAt = Infra.Codec.fieldAt(parts, 4, "audit")?
    Result.Ok(AuditEntry(key = key, taskId = taskId, action = action, message = message, createdAt = createdAt))

verify deserializeAudit
    deserializeAudit("k1|t1|task.completed|Task %7C closed|2026-03-08T12:00:00Z") => Result.Ok(AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "Task | closed", createdAt = "2026-03-08T12:00:00Z"))

fn parseAuditLines(lines: List<String>, acc: List<AuditEntry>) -> Result<List<AuditEntry>, String>
    ? "Tail-recursive parser for the audit log."
    match lines
        [] -> Result.Ok(List.reverse(acc))
        [line, ..rest] -> match deserializeAudit(line)
            Result.Err(msg) -> Result.Err(msg)
            Result.Ok(entry) -> parseAuditLines(rest, List.prepend(entry, acc))

verify parseAuditLines
    parseAuditLines([], []) => Result.Ok([])
    parseAuditLines(["k1|t1|task.completed|Task closed|2026-03-08T12:00:00Z"], []) => Result.Ok([AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "Task closed", createdAt = "2026-03-08T12:00:00Z")])

fn parseAudits(content: String) -> Result<List<AuditEntry>, String>
    ? "Parses the full audit log."
    parseAuditLines(Infra.Codec.splitNonEmptyLines(content), [])

verify parseAudits
    parseAudits("") => Result.Ok([])
    parseAudits("k1|t1|task.completed|Task closed|2026-03-08T12:00:00Z\n") => Result.Ok([AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "Task closed", createdAt = "2026-03-08T12:00:00Z")])

fn loadEntries() -> Result<List<AuditEntry>, String>
    ? "Reads all persisted audit entries."
    ! [Disk.readText]
    content = Disk.readText(auditPath())?
    parseAudits(content)

fn forSubject(entries: List<AuditEntry>, subjectId: Option<String>) -> List<AuditEntry>
    ? "Optional subject filter for audit queries."
    match subjectId
        Option.None -> entries
        Option.Some(value) -> List.reverse(forSubjectInto(entries, value, []))

verify forSubject
    forSubject([AuditEntry(key = "k1", taskId = "t1", action = "task.created", message = "x", createdAt = "2026-03-08T12:00:00Z"), AuditEntry(key = "k2", taskId = "t2", action = "task.completed", message = "y", createdAt = "2026-03-08T12:01:00Z")], Option.Some("t1")) => [AuditEntry(key = "k1", taskId = "t1", action = "task.created", message = "x", createdAt = "2026-03-08T12:00:00Z")]
    forSubject([AuditEntry(key = "k1", taskId = "t1", action = "task.created", message = "x", createdAt = "2026-03-08T12:00:00Z")], Option.None) => [AuditEntry(key = "k1", taskId = "t1", action = "task.created", message = "x", createdAt = "2026-03-08T12:00:00Z")]

fn forSubjectInto(entries: List<AuditEntry>, subjectId: String, matching: List<AuditEntry>) -> List<AuditEntry>
    ? "Tail-recursive audit filter that preserves original order."
    match entries
        [] -> matching
        [entry, ..rest] -> match entry.taskId == subjectId
            true -> forSubjectInto(rest, subjectId, List.prepend(entry, matching))
            false -> forSubjectInto(rest, subjectId, matching)

verify forSubjectInto
    forSubjectInto([], "t1", [AuditEntry(key = "k1", taskId = "t1", action = "task.created", message = "x", createdAt = "2026-03-08T12:00:00Z")]) => [AuditEntry(key = "k1", taskId = "t1", action = "task.created", message = "x", createdAt = "2026-03-08T12:00:00Z")]

fn containsKey(entries: List<AuditEntry>, key: String) -> Bool
    ? "True when the audit log already contains the given key."
    match entries
        [] -> false
        [entry, ..rest] -> match entry.key == key
            true -> true
            false -> containsKey(rest, key)

verify containsKey
    containsKey([AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "x", createdAt = "2026-03-08T12:00:00Z")], "k1") => true
    containsKey([], "k1") => false

fn newEntries(existing: List<AuditEntry>, candidates: List<AuditEntry>) -> List<AuditEntry>
    ? "Keeps only audit entries whose keys are not already persisted or repeated in this batch."
    newEntriesInto(existing, candidates, [])

verify newEntries
    newEntries([], [AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "x", createdAt = "2026-03-08T12:00:00Z"), AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "x", createdAt = "2026-03-08T12:00:00Z")]) => [AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "x", createdAt = "2026-03-08T12:00:00Z")]

fn newEntriesInto(existing: List<AuditEntry>, candidates: List<AuditEntry>, fresh: List<AuditEntry>) -> List<AuditEntry>
    ? "Tail-recursive helper for audit deduplication."
    match candidates
        [] -> fresh
        [entry, ..rest] -> match containsKey(existing, entry.key)
            true -> newEntriesInto(existing, rest, fresh)
            false -> match containsKey(fresh, entry.key)
                true -> newEntriesInto(existing, rest, fresh)
                false -> newEntriesInto(existing, rest, List.concat(fresh, [entry]))

verify newEntriesInto
    newEntriesInto([AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "x", createdAt = "2026-03-08T12:00:00Z")], [AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "x", createdAt = "2026-03-08T12:00:00Z"), AuditEntry(key = "k2", taskId = "t2", action = "task.created", message = "y", createdAt = "2026-03-08T12:01:00Z")], []) => [AuditEntry(key = "k2", taskId = "t2", action = "task.created", message = "y", createdAt = "2026-03-08T12:01:00Z")]

fn recordEntries(entries: List<AuditEntry>) -> Result<Unit, String>
    ? "Appends only new audit entries, preserving the existing log."
    ! [Disk.appendText, Disk.readText]
    existing = loadEntries()?
    fresh = newEntries(existing, entries)
    Disk.appendText(auditPath(), renderLines(serializeAuditLines(fresh)))

fn serializeAuditLines(entries: List<AuditEntry>) -> List<String>
    ? "Serializes audit entries for batch append."
    match entries
        [] -> []
        [entry, ..rest] -> List.prepend(serializeAudit(entry), serializeAuditLines(rest))

verify serializeAuditLines
    serializeAuditLines([]) => []
    serializeAuditLines([AuditEntry(key = "k1", taskId = "t1", action = "task.completed", message = "x", createdAt = "2026-03-08T12:00:00Z")]) => ["k1|t1|task.completed|x|2026-03-08T12:00:00Z"]
