module Ledger
    intent = "Explicit control state: the order ids are served in is observable, and the member keys the loop seats a member for are a plain list."
    depends [Inbox]
    exposes [State, fresh, arrive, members]
    effects []
    answers [Inbox]

record State
    served: List<Int>
    keys: List<Int>

fn fresh() -> State
    ? "Nothing served yet, and two member keys."
    State(served = [], keys = [7, 8])

fn arrive(state: State, id: Int) -> Tuple<State, Result<Unit, Run.Wake>>
    ? "Append this id; reversing service order must reverse this observation."
    (State.update(state, served = List.concat(state.served, [id])), Result.Ok(Unit))

verify arrive
    arrive(fresh(), 1) => (State.update(fresh(), served = [1]), Result.Ok(Unit))

fn members(state: State) -> List<Int>
    ? "The keys the loop seats one member for each of."
    state.keys

verify members
    members(fresh()) => [7, 8]
