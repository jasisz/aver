module Bench
    intent = "Local timing harness for Fractal.render — predicts whether the live /fractal endpoint will fit under Cloudflare Workers' free-plan 10 ms CPU budget. Not deployed."
    depends [Fractal]
    exposes [main]
    effects [Console.print, Time.unixMs]

fn main() -> Unit
    ! [Console.print, Time.unixMs]
    t0 = Time.unixMs()
    full = Fractal.render(80, 18, 80, Fractal.fullView())
    t1 = Time.unixMs()
    zoom = Fractal.render(80, 18, 150, Fractal.seahorseView())
    t2 = Time.unixMs()
    Console.print("full(80x18,80)={Int.toString(t1 - t0)}ms sea(80x18,150)={Int.toString(t2 - t1)}ms total={Int.toString(t2 - t0)}ms")
