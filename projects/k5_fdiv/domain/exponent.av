module Exponent
    intent =
        "Stage 3 of the K5 division proof: the Section 9 exponent-unreachability"
        "bounds, as pure linear integer laws. The paper (Section 9.3, p.31-32)"
        "argues that with the input operands' exponents in the extended-format"
        "range and the reciprocal/digit estimate adding at most a fixed constant,"
        "the divide! result exponent can never reach the overflow threshold 2^16"
        "or fall below the underflow threshold 1 - 2^16 -- so the wide intermediate"
        "exponent path of the divider is never exercised."
        "These are ordinary linear integer inequalities: the result exponent is"
        "bracketed by the input-exponent range plus a constant offset, and the"
        "bracket lands strictly inside the representable window. They prove"
        "universally on Z3/Dafny push-button and on the Lean kernel by one generic"
        "decision step (the linear-Int analog of the nonlinear estimate.av rung):"
        "bridge the Bool comparisons to Prop and discharge the linear arithmetic"
        "with omega -- not a per-figure tactic."
        "The two unreachability brackets above are DEDUCED (paper p.32) from the"
        "Table-3 chaining, whose building blocks are the elementary sum-exponent"
        "lemmas of the same Section 9.3: Lemma 9.3.1 (p.31-32), the LOWER bound"
        "1 - max(n, m) + min(ex, ey) <= e(x + y) for x, y of precisions n, m, and"
        "Lemma 9.3.2 (p.32), the UPPER bound e(x + y) <= 1 + max(ex, ey). Both are"
        "the magnitude-bracket / exponent-placement class (like Lemma 8.2.1 digit"
        "separation): the paper's magnitude floor / ceiling on |x + y| is the"
        "premise, and the already-universal fundamental-exponent bridge"
        "Domain.Fprep.fracExpoFromMagnitude (2^e <= |v| < 2^k ==> e <= k - 1) turns"
        "it into the exponent inequality, with linear arithmetic landing the exact"
        "paper offset. Stated over abstract exponents (eSum = e(x + y), ex, ey, n, m"
        "as Int givens), never by computing the opaque fracExpo -- the same"
        "discipline as remainder.av's reciprocalMagnitudeBound_8_2_4 and"
        "digitSeparation_8_2_1."
    depends [Domain.Rational, Domain.Fprep]
    exposes [divideExponentNoOverflow, divideExponentNoUnderflow, maxInt, minInt, sumExponentLower_9_3_1, sumExponentUpper_9_3_2, exponentDh, exponentP0, exponentPh0, exponentQ0, exponentQdh0, exponentQdl0, exponentPt1, exponentP1, exponentPh1, exponentQ1, exponentQdh1, exponentQdl1, exponentPt2, exponentP2, exponentPh2, exponentQ2, exponentQdh2, exponentQdl2, exponentPt3, exponentP3, exponentPh3, exponentQ3, exponentQq2, exponentQq1, exponentDivide]
    effects []

fn divideExponentNoOverflow(ep: Int, ed: Int, eDivide: Int) -> Bool
    ? "Section 9.3 (p.31-32): the divide! result exponent stays at or below 2^16 (no-overflow half of the unreachability bound)."
    eDivide <= 65536

verify divideExponentNoOverflow
    divideExponentNoOverflow(0, 0, 25) => true
    divideExponentNoOverflow(16384, -16446, 32855) => true

verify divideExponentNoOverflow law section_9_3_no_overflow
    given ep: Int = [-16446, 0, 16384]
    given ed: Int = [-16446, 0, 16384]
    given eDivide: Int = [0, 25, 32855]
    when -16446 <= ep
    when ep <= 16384
    when -16446 <= ed
    when ed <= 16384
    when eDivide <= ep - ed + 25
    divideExponentNoOverflow(ep, ed, eDivide) holds

fn divideExponentNoUnderflow(ep: Int, ed: Int, eDivide: Int) -> Bool
    ? "Section 9.3 (p.31-32): the divide! result exponent stays at or above 1 - 2^16 (no-underflow half of the unreachability bound)."
    eDivide >= 1 - 65536

verify divideExponentNoUnderflow
    divideExponentNoUnderflow(0, 0, 25) => true
    divideExponentNoUnderflow(-16446, 16384, -33365) => true

verify divideExponentNoUnderflow law section_9_3_no_underflow
    given ep: Int = [-16446, 0, 16384]
    given ed: Int = [-16446, 0, 16384]
    given eDivide: Int = [-33365, 0, 25]
    when -16446 <= ep
    when ep <= 16384
    when -16446 <= ed
    when ed <= 16384
    when ep - ed - 535 <= eDivide
    divideExponentNoUnderflow(ep, ed, eDivide) holds

// ---------------------------------------------------------------------------
// The elementary sum-exponent lemmas of Section 9.3 (p.31-32), the building
// blocks the Table-3 chaining (and so the unreachability brackets above)
// rest on. min/max of integers -- the paper's min(ex, ey) and max(n, m).
// ---------------------------------------------------------------------------

fn maxInt(a: Int, b: Int) -> Int
    ? "The larger of two integers -- the max(n, m) of Lemma 9.3.1 and the max(ex, ey) of Lemma 9.3.2 (Section 9.3, p.31-32)."
    match a >= b
        true -> a
        false -> b

verify maxInt
    maxInt(2, 3) => 3
    maxInt(5, 1) => 5
    maxInt(-2, -2) => -2

fn minInt(a: Int, b: Int) -> Int
    ? "The smaller of two integers -- the min(ex, ey) of Lemma 9.3.1 (Section 9.3, p.31-32)."
    match a <= b
        true -> a
        false -> b

verify minInt
    minInt(2, 3) => 2
    minInt(5, 1) => 1
    minInt(-2, -2) => -2

// ---------------------------------------------------------------------------
// Lemma 9.3.1 (Section 9.3, p.31-32), the sum-exponent LOWER bound.
// "If x and y are rationals such that x + y != 0, n and m are positive
//  integers, trunc(x; n) = x and trunc(y; m) = y, then
//  1 - max(n, m) + min(ex, ey) <= e(x + y)."
// Proof (paper): trunc(x; n) = x makes x an integer multiple of its ulp
// 2^(ex - n + 1), and y a multiple of 2^(ey - m + 1), so x + y is a multiple
// of 2^(min(ex - n + 1, ey - m + 1)); being non-0 it has magnitude at least
// that power, and min(ex - n + 1, ey - m + 1) >= 1 - max(n, m) + min(ex, ey).
// Hence the magnitude FLOOR 2^(1 - max(n, m) + min(ex, ey)) <= |x + y| -- the
// premise here, exactly the bound feeding the conclusion (the n, m > 0 / trunc
// hypotheses are what the paper uses to derive this floor, folded into it, as
// remainder.av's 8.2.4 folds p0 != 0). With the binary-exponent ceiling
// |x + y| < 2^(e(x+y)+1), the fundamental-exponent bridge fracExpoFromMagnitude
// turns 2^(1 - max + min) <= |x + y| < 2^(eSum + 1) into
// 1 - max(n, m) + min(ex, ey) <= (eSum + 1) - 1 = eSum -- the exact paper
// offset, by the same magnitude-bracket rung as digitSeparation_8_2_1.
// ---------------------------------------------------------------------------

fn sumExponentLower_9_3_1(eSum: Int, n: Int, m: Int, ex: Int, ey: Int) -> Bool
    ? "Lemma 9.3.1 (Section 9.3, p.31-32): for rationals x, y with x + y != 0 and positive precisions n, m such that trunc(x, n) = x and trunc(y, m) = y, the exponent of the sum satisfies 1 - max(n, m) + min(ex, ey) <= e(x + y). eSum = e(x + y), ex/ey the binary exponents of x/y, n/m their precisions -- abstract Int givens, never the opaque fracExpo."
    1 - maxInt(n, m) + minInt(ex, ey) <= eSum

verify sumExponentLower_9_3_1
    sumExponentLower_9_3_1(4, 2, 2, 5, 5) => true
    sumExponentLower_9_3_1(3, 1, 1, 3, 3) => true

verify sumExponentLower_9_3_1 law section_9_3_1
    given sumMag: Fraction = [Domain.Rational.Fraction(top = 20, bottom = 1), Domain.Rational.Fraction(top = 10, bottom = 1), Domain.Rational.Fraction(top = 8, bottom = 1)]
    given eSum: Int = [4, 3, 3]
    given n: Int = [2, 3, 1]
    given m: Int = [2, 1, 1]
    given ex: Int = [5, 4, 3]
    given ey: Int = [5, 6, 3]
    when 0 < sumMag.bottom
    when Domain.Rational.isNonNeg(Domain.Rational.minus(sumMag, Domain.Fprep.pow2Signed(1 - maxInt(n, m) + minInt(ex, ey))))
    when Domain.Rational.lessThan(sumMag, Domain.Fprep.pow2Signed(eSum + 1))
    sumExponentLower_9_3_1(eSum, n, m, ex, ey) holds

// ---------------------------------------------------------------------------
// Lemma 9.3.2 (Section 9.3, p.32), the sum-exponent UPPER bound.
// "If x and y are non-0 rationals whose sum is non-0, then
//  e(x + y) <= 1 + max(ex, ey)."
// Proof (paper, the sloppy-but-sufficient bound):
//  |x + y| <= |x| + |y| < 2^(ex + 1) + 2^(ey + 1) <= 2^(max(ex, ey) + 2).
// So the magnitude CEILING 2^(max(ex, ey) + 2) on |x + y| is the premise; with
// the binary-exponent floor 2^eSum <= |x + y|, the fundamental-exponent bridge
// fracExpoFromMagnitude turns 2^eSum <= |x + y| < 2^(max(ex, ey) + 2) into
// eSum <= (max(ex, ey) + 2) - 1 = 1 + max(ex, ey) -- the exact paper offset,
// by the same magnitude-bracket rung as digitSeparation_8_2_1.
// ---------------------------------------------------------------------------

fn sumExponentUpper_9_3_2(eSum: Int, ex: Int, ey: Int) -> Bool
    ? "Lemma 9.3.2 (Section 9.3, p.32): for non-0 rationals x, y whose sum is non-0, the exponent of the sum satisfies e(x + y) <= 1 + max(ex, ey). eSum = e(x + y), ex/ey the binary exponents of x/y -- abstract Int givens, never the opaque fracExpo."
    eSum <= 1 + maxInt(ex, ey)

verify sumExponentUpper_9_3_2
    sumExponentUpper_9_3_2(3, 2, 3) => true
    sumExponentUpper_9_3_2(1, 0, 0) => true

verify sumExponentUpper_9_3_2 law section_9_3_2
    given sumMag: Fraction = [Domain.Rational.Fraction(top = 12, bottom = 1), Domain.Rational.Fraction(top = 3, bottom = 1), Domain.Rational.Fraction(top = 3, bottom = 2)]
    given eSum: Int = [3, 1, 0]
    given ex: Int = [2, 0, -1]
    given ey: Int = [3, 0, -2]
    when 0 < sumMag.bottom
    when Domain.Rational.isNonNeg(Domain.Rational.minus(sumMag, Domain.Fprep.pow2Signed(eSum)))
    when Domain.Rational.lessThan(sumMag, Domain.Fprep.pow2Signed(maxInt(ex, ey) + 2))
    sumExponentUpper_9_3_2(eSum, ex, ey) holds

// ===========================================================================
// Section 9.3, Table 3 (p.32): the per-variable exponent brackets for the
// divider's straight-line steps (lines 7-32 of Figure 4, p.17). Each row is a
// variable's binary-exponent bracket in terms of ep = e(p) and ed = e(d),
// DEDUCED (paper p.32) by chaining the elementary per-operation exponent rules
// through the sum-exponent Lemmas 9.3.1/9.3.2 above and the product-exponent
// range Lemma 7.1.7 (Domain.Fprep.productExpInRange). Each law states the row's
// bracket VERBATIM as its conclusion and takes the input variables' brackets
// plus the operation's exponent rule as premises; it closes by linear-integer
// composition (omega, case-splitting min/max) -- the linear analog of the
// estimate.av order rung, not a per-figure tactic.
//
// The operation rules (the "elementary lemmas" the paper composes):
//   * product  x*y  : 7.1.7   ex + ey <= e(x*y) <= ex + ey + 1
//   * sum/diff x+-y : 9.3.1/9.3.2 with both operands of precision P:
//                     min(ex,ey) - (P-1) <= e(x+-y) <= max(ex,ey) + 1
//                     (P = max(n,m); P = 64 for the 64-bit remainders/products,
//                      P = 24 for the two 24-bit quotient digits q2 + q3, row 30)
//   * trunc to n    : 7.2.6   e(trunc(x,n)) = ex            (exponent preserved)
//   * round/away n  : e(round(x,n)) in [ex, ex+1]           (rounding may carry +1)
//   * sticky to 64  : e(sticky(x,64)) = ex on the digit sums (which fit in 64
//                     bits, so sticky is exact and preserves the exponent --
//                     matching Table 3, where the two sticky steps add no +1)
//
// The chain consumes elementary base brackets that are NOT 9.3.x chains
// (established by the paper's elementary trunc / low-part lemmas and the §8.1
// reciprocal estimate, p.31, "the first six lines are straightforward"):
//   * e(dh) = ed                   (row 7,  dh = trunc(d,32), 7.2.6) -- modelled below
//   * ed - 63 <= e(dl) <= ed - 31  (row 8,  dl = d - dh, the low 32 bits of d;
//        the cancellation makes this far tighter than the generic 9.3.2 bound
//        ed + 1, so it is the paper's elementary low-part lemma -- consumed as a
//        premise in rows 13/19/25, NOT derivable from the 9.3.x sum rule, so it
//        is not stated as a standalone law here)
//   * e(p0) = ep                   (row 9,  p0 = p)                  -- modelled below
//   * e(ph0) = ep                  (row 10, ph0 = trunc(p0,32), 7.2.6) -- modelled below
//   * -ed - 2 <= e(sd2) <= -ed + 1 (the §8.1 reciprocal estimate, p.31; the base
//        for the four quotient digits q0/q1/q2/q3)
// ===========================================================================

fn exponentDh(ed: Int, eDh: Int) -> Bool
    ? "Table 3 row 7 (p.32): e(dh) = ed. dh = trunc(d,32) is the high 32 bits of d; truncation preserves the binary exponent (Lemma 7.2.6)."
    Bool.and(ed <= eDh, eDh <= ed)

verify exponentDh
    exponentDh(0, 0) => true
    exponentDh(16384, 16384) => true

verify exponentDh law table3_row7
    given ed: Int = [0]
    given eDh: Int = [0]
    when eDh == ed
    exponentDh(ed, eDh) holds

fn exponentP0(ep: Int, eP0: Int) -> Bool
    ? "Table 3 row 9 (p.32): e(p0) = ep. p0 = p, so its exponent is ep identically."
    Bool.and(ep <= eP0, eP0 <= ep)

verify exponentP0
    exponentP0(0, 0) => true
    exponentP0(16384, 16384) => true

verify exponentP0 law table3_row9
    given ep: Int = [0]
    given eP0: Int = [0]
    when eP0 == ep
    exponentP0(ep, eP0) holds

fn exponentPh0(ep: Int, ePh0: Int) -> Bool
    ? "Table 3 row 10 (p.32): e(ph0) = ep. ph0 = trunc(p0,32); truncation preserves the binary exponent (Lemma 7.2.6)."
    Bool.and(ep <= ePh0, ePh0 <= ep)

verify exponentPh0
    exponentPh0(0, 0) => true
    exponentPh0(16384, 16384) => true

verify exponentPh0 law table3_row10
    given ep: Int = [0]
    given ePh0: Int = [0]
    when ePh0 == ep
    exponentPh0(ep, ePh0) holds

fn exponentQ0(ep: Int, ed: Int, eQ0: Int) -> Bool
    ? "Table 3 row 11 (p.32): p != 0 implies ep - ed - 2 <= e(q0) <= ep - ed + 3. q0 = away(sd2*ph0, 24): the §8.1 reciprocal estimate e(sd2) in [-ed-2, -ed+1] times e(ph0) = ep (7.1.7 product), then rounded to 24 bits (round adds 0 or 1)."
    Bool.and(ep - ed - 2 <= eQ0, eQ0 <= ep - ed + 3)

verify exponentQ0
    exponentQ0(0, 0, 0) => true
    exponentQ0(0, 0, 3) => true

verify exponentQ0 law table3_row11
    given ep: Int = [0]
    given ed: Int = [0]
    given eSd2: Int = [0]
    given ePh0: Int = [0]
    given eProd0: Int = [0]
    given eQ0: Int = [0]
    when 0 - ed - 2 <= eSd2
    when eSd2 <= 0 - ed + 1
    when ePh0 == ep
    when eSd2 + ePh0 <= eProd0
    when eProd0 <= eSd2 + ePh0 + 1
    when eProd0 <= eQ0
    when eQ0 <= eProd0 + 1
    exponentQ0(ep, ed, eQ0) holds

fn exponentQdh0(ep: Int, eQdh0: Int) -> Bool
    ? "Table 3 row 12 (p.32): qdh0 != 0 implies ep - 2 <= e(qdh0) <= ep + 4. qdh0 = q0*dh: the 7.1.7 product of e(q0) in [ep-ed-2, ep-ed+3] (row 11) and e(dh) = ed (row 7)."
    Bool.and(ep - 2 <= eQdh0, eQdh0 <= ep + 4)

verify exponentQdh0
    exponentQdh0(0, 0) => true
    exponentQdh0(0, 4) => true

verify exponentQdh0 law table3_row12
    given ep: Int = [0]
    given ed: Int = [0]
    given eQ0: Int = [0]
    given eDh: Int = [0]
    given eQdh0: Int = [0]
    when ep - ed - 2 <= eQ0
    when eQ0 <= ep - ed + 3
    when eDh == ed
    when eQ0 + eDh <= eQdh0
    when eQdh0 <= eQ0 + eDh + 1
    exponentQdh0(ep, eQdh0) holds

fn exponentQdl0(ep: Int, eQdl0: Int) -> Bool
    ? "Table 3 row 13 (p.32): qdl0 != 0 implies ep - 65 <= e(qdl0) <= ep - 27. qdl0 = q0*dl: the 7.1.7 product of e(q0) in [ep-ed-2, ep-ed+3] (row 11) and e(dl) in [ed-63, ed-31] (row 8, the low-part lemma)."
    Bool.and(ep - 65 <= eQdl0, eQdl0 <= ep - 27)

verify exponentQdl0
    exponentQdl0(0, -31) => true
    exponentQdl0(0, -65) => true

verify exponentQdl0 law table3_row13
    given ep: Int = [0]
    given ed: Int = [0]
    given eQ0: Int = [0]
    given eDl: Int = [-31]
    given eQdl0: Int = [-31]
    when ep - ed - 2 <= eQ0
    when eQ0 <= ep - ed + 3
    when ed - 63 <= eDl
    when eDl <= ed - 31
    when eQ0 + eDl <= eQdl0
    when eQdl0 <= eQ0 + eDl + 1
    exponentQdl0(ep, eQdl0) holds

fn exponentPt1(ep: Int, ePt1: Int) -> Bool
    ? "Table 3 row 14 (p.32): pt1 != 0 implies ep - 65 <= e(pt1) <= ep + 5. pt1 = p0 - qdh0: the 9.3.1/9.3.2 sum of two 64-bit values (P=64), e(p0) = ep (row 9) and e(qdh0) in [ep-2, ep+4] (row 12)."
    Bool.and(ep - 65 <= ePt1, ePt1 <= ep + 5)

verify exponentPt1
    exponentPt1(0, 0) => true
    exponentPt1(0, 5) => true

verify exponentPt1 law table3_row14
    given ep: Int = [0]
    given eP0: Int = [0]
    given eQdh0: Int = [0]
    given ePt1: Int = [0]
    when eP0 == ep
    when ep - 2 <= eQdh0
    when eQdh0 <= ep + 4
    when 1 - maxInt(64, 64) + minInt(eP0, eQdh0) <= ePt1
    when ePt1 <= 1 + maxInt(eP0, eQdh0)
    exponentPt1(ep, ePt1) holds

fn exponentP1(ep: Int, eP1: Int) -> Bool
    ? "Table 3 row 15 (p.32): p1 != 0 implies ep - 128 <= e(p1) <= ep + 6. p1 = pt1 - qdl0: the 9.3.1/9.3.2 sum of two 64-bit values (P=64), e(pt1) in [ep-65, ep+5] (row 14) and e(qdl0) in [ep-65, ep-27] (row 13)."
    Bool.and(ep - 128 <= eP1, eP1 <= ep + 6)

verify exponentP1
    exponentP1(0, 0) => true
    exponentP1(0, 6) => true

verify exponentP1 law table3_row15
    given ep: Int = [0]
    given ePt1: Int = [0]
    given eQdl0: Int = [0]
    given eP1: Int = [0]
    when ep - 65 <= ePt1
    when ePt1 <= ep + 5
    when ep - 65 <= eQdl0
    when eQdl0 <= ep - 27
    when 1 - maxInt(64, 64) + minInt(ePt1, eQdl0) <= eP1
    when eP1 <= 1 + maxInt(ePt1, eQdl0)
    exponentP1(ep, eP1) holds

fn exponentPh1(ep: Int, ePh1: Int) -> Bool
    ? "Table 3 row 16 (p.32): p1 != 0 implies ep - 128 <= e(ph1) <= ep + 6. ph1 = trunc(p1,32); truncation preserves the exponent (Lemma 7.2.6), so the row-15 bracket of p1 carries over."
    Bool.and(ep - 128 <= ePh1, ePh1 <= ep + 6)

verify exponentPh1
    exponentPh1(0, 0) => true
    exponentPh1(0, 6) => true

verify exponentPh1 law table3_row16
    given ep: Int = [0]
    given eP1: Int = [0]
    given ePh1: Int = [0]
    when ep - 128 <= eP1
    when eP1 <= ep + 6
    when ePh1 == eP1
    exponentPh1(ep, ePh1) holds

fn exponentQ1(ep: Int, ed: Int, eQ1: Int) -> Bool
    ? "Table 3 row 17 (p.32): q1 != 0 implies ep - ed - 130 <= e(q1) <= ep - ed + 9. q1 = away(sd2*ph1, 24): the §8.1 estimate e(sd2) in [-ed-2, -ed+1] times e(ph1) in [ep-128, ep+6] (row 16) by 7.1.7, then rounded to 24 bits (round adds 0 or 1)."
    Bool.and(ep - ed - 130 <= eQ1, eQ1 <= ep - ed + 9)

verify exponentQ1
    exponentQ1(0, 0, 0) => true
    exponentQ1(0, 0, 9) => true

verify exponentQ1 law table3_row17
    given ep: Int = [0]
    given ed: Int = [0]
    given eSd2: Int = [0]
    given ePh1: Int = [0]
    given eProd1: Int = [0]
    given eQ1: Int = [0]
    when 0 - ed - 2 <= eSd2
    when eSd2 <= 0 - ed + 1
    when ep - 128 <= ePh1
    when ePh1 <= ep + 6
    when eSd2 + ePh1 <= eProd1
    when eProd1 <= eSd2 + ePh1 + 1
    when eProd1 <= eQ1
    when eQ1 <= eProd1 + 1
    exponentQ1(ep, ed, eQ1) holds

fn exponentQdh1(ep: Int, eQdh1: Int) -> Bool
    ? "Table 3 row 18 (p.32): qdh1 != 0 implies ep - 130 <= e(qdh1) <= ep + 10. qdh1 = q1*dh: the 7.1.7 product of e(q1) in [ep-ed-130, ep-ed+9] (row 17) and e(dh) = ed (row 7)."
    Bool.and(ep - 130 <= eQdh1, eQdh1 <= ep + 10)

verify exponentQdh1
    exponentQdh1(0, 0) => true
    exponentQdh1(0, 10) => true

verify exponentQdh1 law table3_row18
    given ep: Int = [0]
    given ed: Int = [0]
    given eQ1: Int = [0]
    given eDh: Int = [0]
    given eQdh1: Int = [0]
    when ep - ed - 130 <= eQ1
    when eQ1 <= ep - ed + 9
    when eDh == ed
    when eQ1 + eDh <= eQdh1
    when eQdh1 <= eQ1 + eDh + 1
    exponentQdh1(ep, eQdh1) holds

fn exponentQdl1(ep: Int, eQdl1: Int) -> Bool
    ? "Table 3 row 19 (p.32): qdl1 != 0 implies ep - 193 <= e(qdl1) <= ep - 21. qdl1 = q1*dl: the 7.1.7 product of e(q1) in [ep-ed-130, ep-ed+9] (row 17) and e(dl) in [ed-63, ed-31] (row 8)."
    Bool.and(ep - 193 <= eQdl1, eQdl1 <= ep - 21)

verify exponentQdl1
    exponentQdl1(0, -100) => true
    exponentQdl1(0, -193) => true

verify exponentQdl1 law table3_row19
    given ep: Int = [0]
    given ed: Int = [0]
    given eQ1: Int = [0]
    given eDl: Int = [-31]
    given eQdl1: Int = [-31]
    when ep - ed - 130 <= eQ1
    when eQ1 <= ep - ed + 9
    when ed - 63 <= eDl
    when eDl <= ed - 31
    when eQ1 + eDl <= eQdl1
    when eQdl1 <= eQ1 + eDl + 1
    exponentQdl1(ep, eQdl1) holds

fn exponentPt2(ep: Int, ePt2: Int) -> Bool
    ? "Table 3 row 20 (p.32): pt2 != 0 implies ep - 193 <= e(pt2) <= ep + 11. pt2 = p1 - qdh1: the 9.3.1/9.3.2 sum of two 64-bit values (P=64), e(p1) in [ep-128, ep+6] (row 15) and e(qdh1) in [ep-130, ep+10] (row 18)."
    Bool.and(ep - 193 <= ePt2, ePt2 <= ep + 11)

verify exponentPt2
    exponentPt2(0, 0) => true
    exponentPt2(0, 11) => true

verify exponentPt2 law table3_row20
    given ep: Int = [0]
    given eP1: Int = [0]
    given eQdh1: Int = [0]
    given ePt2: Int = [0]
    when ep - 128 <= eP1
    when eP1 <= ep + 6
    when ep - 130 <= eQdh1
    when eQdh1 <= ep + 10
    when 1 - maxInt(64, 64) + minInt(eP1, eQdh1) <= ePt2
    when ePt2 <= 1 + maxInt(eP1, eQdh1)
    exponentPt2(ep, ePt2) holds

fn exponentP2(ep: Int, eP2: Int) -> Bool
    ? "Table 3 row 21 (p.32): p2 != 0 implies ep - 256 <= e(p2) <= ep + 12. p2 = pt2 - qdl1: the 9.3.1/9.3.2 sum of two 64-bit values (P=64), e(pt2) in [ep-193, ep+11] (row 20) and e(qdl1) in [ep-193, ep-21] (row 19)."
    Bool.and(ep - 256 <= eP2, eP2 <= ep + 12)

verify exponentP2
    exponentP2(0, 0) => true
    exponentP2(0, 12) => true

verify exponentP2 law table3_row21
    given ep: Int = [0]
    given ePt2: Int = [0]
    given eQdl1: Int = [0]
    given eP2: Int = [0]
    when ep - 193 <= ePt2
    when ePt2 <= ep + 11
    when ep - 193 <= eQdl1
    when eQdl1 <= ep - 21
    when 1 - maxInt(64, 64) + minInt(ePt2, eQdl1) <= eP2
    when eP2 <= 1 + maxInt(ePt2, eQdl1)
    exponentP2(ep, eP2) holds

fn exponentPh2(ep: Int, ePh2: Int) -> Bool
    ? "Table 3 row 22 (p.32): p2 != 0 implies ep - 256 <= e(ph2) <= ep + 12. ph2 = trunc(p2,32); truncation preserves the exponent (Lemma 7.2.6), so the row-21 bracket of p2 carries over."
    Bool.and(ep - 256 <= ePh2, ePh2 <= ep + 12)

verify exponentPh2
    exponentPh2(0, 0) => true
    exponentPh2(0, 12) => true

verify exponentPh2 law table3_row22
    given ep: Int = [0]
    given eP2: Int = [0]
    given ePh2: Int = [0]
    when ep - 256 <= eP2
    when eP2 <= ep + 12
    when ePh2 == eP2
    exponentPh2(ep, ePh2) holds

fn exponentQ2(ep: Int, ed: Int, eQ2: Int) -> Bool
    ? "Table 3 row 23 (p.32): q2 != 0 implies ep - ed - 258 <= e(q2) <= ep - ed + 15. q2 = away(sd2*ph2, 24): the §8.1 estimate e(sd2) in [-ed-2, -ed+1] times e(ph2) in [ep-256, ep+12] (row 22) by 7.1.7, then rounded to 24 bits (round adds 0 or 1)."
    Bool.and(ep - ed - 258 <= eQ2, eQ2 <= ep - ed + 15)

verify exponentQ2
    exponentQ2(0, 0, 0) => true
    exponentQ2(0, 0, 15) => true

verify exponentQ2 law table3_row23
    given ep: Int = [0]
    given ed: Int = [0]
    given eSd2: Int = [0]
    given ePh2: Int = [0]
    given eProd2: Int = [0]
    given eQ2: Int = [0]
    when 0 - ed - 2 <= eSd2
    when eSd2 <= 0 - ed + 1
    when ep - 256 <= ePh2
    when ePh2 <= ep + 12
    when eSd2 + ePh2 <= eProd2
    when eProd2 <= eSd2 + ePh2 + 1
    when eProd2 <= eQ2
    when eQ2 <= eProd2 + 1
    exponentQ2(ep, ed, eQ2) holds

fn exponentQdh2(ep: Int, eQdh2: Int) -> Bool
    ? "Table 3 row 24 (p.32): qdh2 != 0 implies ep - 258 <= e(qdh2) <= ep + 16. qdh2 = q2*dh: the 7.1.7 product of e(q2) in [ep-ed-258, ep-ed+15] (row 23) and e(dh) = ed (row 7)."
    Bool.and(ep - 258 <= eQdh2, eQdh2 <= ep + 16)

verify exponentQdh2
    exponentQdh2(0, 0) => true
    exponentQdh2(0, 16) => true

verify exponentQdh2 law table3_row24
    given ep: Int = [0]
    given ed: Int = [0]
    given eQ2: Int = [0]
    given eDh: Int = [0]
    given eQdh2: Int = [0]
    when ep - ed - 258 <= eQ2
    when eQ2 <= ep - ed + 15
    when eDh == ed
    when eQ2 + eDh <= eQdh2
    when eQdh2 <= eQ2 + eDh + 1
    exponentQdh2(ep, eQdh2) holds

fn exponentQdl2(ep: Int, eQdl2: Int) -> Bool
    ? "Table 3 row 25 (p.32): qdl2 != 0 implies ep - 321 <= e(qdl2) <= ep - 15. qdl2 = q2*dl: the 7.1.7 product of e(q2) in [ep-ed-258, ep-ed+15] (row 23) and e(dl) in [ed-63, ed-31] (row 8)."
    Bool.and(ep - 321 <= eQdl2, eQdl2 <= ep - 15)

verify exponentQdl2
    exponentQdl2(0, -100) => true
    exponentQdl2(0, -321) => true

verify exponentQdl2 law table3_row25
    given ep: Int = [0]
    given ed: Int = [0]
    given eQ2: Int = [0]
    given eDl: Int = [-31]
    given eQdl2: Int = [-31]
    when ep - ed - 258 <= eQ2
    when eQ2 <= ep - ed + 15
    when ed - 63 <= eDl
    when eDl <= ed - 31
    when eQ2 + eDl <= eQdl2
    when eQdl2 <= eQ2 + eDl + 1
    exponentQdl2(ep, eQdl2) holds

fn exponentPt3(ep: Int, ePt3: Int) -> Bool
    ? "Table 3 row 26 (p.32): pt3 != 0 implies ep - 321 <= e(pt3) <= ep + 17. pt3 = p2 - qdh2: the 9.3.1/9.3.2 sum of two 64-bit values (P=64), e(p2) in [ep-256, ep+12] (row 21) and e(qdh2) in [ep-258, ep+16] (row 24)."
    Bool.and(ep - 321 <= ePt3, ePt3 <= ep + 17)

verify exponentPt3
    exponentPt3(0, 0) => true
    exponentPt3(0, 17) => true

verify exponentPt3 law table3_row26
    given ep: Int = [0]
    given eP2: Int = [0]
    given eQdh2: Int = [0]
    given ePt3: Int = [0]
    when ep - 256 <= eP2
    when eP2 <= ep + 12
    when ep - 258 <= eQdh2
    when eQdh2 <= ep + 16
    when 1 - maxInt(64, 64) + minInt(eP2, eQdh2) <= ePt3
    when ePt3 <= 1 + maxInt(eP2, eQdh2)
    exponentPt3(ep, ePt3) holds

fn exponentP3(ep: Int, eP3: Int) -> Bool
    ? "Table 3 row 27 (p.32): p3 != 0 implies ep - 384 <= e(p3) <= ep + 18. p3 = pt3 - qdl2: the 9.3.1/9.3.2 sum of two 64-bit values (P=64), e(pt3) in [ep-321, ep+17] (row 26) and e(qdl2) in [ep-321, ep-15] (row 25)."
    Bool.and(ep - 384 <= eP3, eP3 <= ep + 18)

verify exponentP3
    exponentP3(0, 0) => true
    exponentP3(0, 18) => true

verify exponentP3 law table3_row27
    given ep: Int = [0]
    given ePt3: Int = [0]
    given eQdl2: Int = [0]
    given eP3: Int = [0]
    when ep - 321 <= ePt3
    when ePt3 <= ep + 17
    when ep - 321 <= eQdl2
    when eQdl2 <= ep - 15
    when 1 - maxInt(64, 64) + minInt(ePt3, eQdl2) <= eP3
    when eP3 <= 1 + maxInt(ePt3, eQdl2)
