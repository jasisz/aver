module Scheduled
    intent = "Fixture answer module: the tick this program hands back when a process offers to step aside."
    depends [Sched, Wait]
    effects []
    answers [Sched]

record State
    tick: Int

fn yield(state: State, slot: Int) -> Tuple<State, Result<Int, Run.Wake>>
    ? "Answers with the tick the process resumes at."
    (state, Result.Ok(state.tick))
