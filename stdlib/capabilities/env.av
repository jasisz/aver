module Env
    kind = capability
    semantics = effectful
    exposes [get, set]

operation get(key: String) -> Option<String>
    ? "Reads one environment variable from the process-start snapshot model."
    oracle = snapshot
    replay = recorded
    hostile = [envNormal, envMissing, envEmpty]

operation set(key: String, value: String) -> Result<Unit, String>
    ? "Writes one process environment variable when the host supports mutation."
    oracle = generativeOutput
    replay = recorded
    hostile = [setNormal, setAlwaysErr]

fn envNormal(key: String) -> Option<String>
    ? "Honest profile: the requested variable has a plausible value."
    Option.Some("value")

fn envMissing(key: String) -> Option<String>
    ? "Hostile profile: every requested variable is absent."
    Option.None

fn envEmpty(key: String) -> Option<String>
    ? "Hostile boundary: the requested variable exists but is empty."
    Option.Some("")

fn setNormal(path: BranchPath, call: Int, key: String, value: String) -> Result<Unit, String>
    ? "Honest profile: the environment accepts the write."
    Result.Ok(Unit)

fn setAlwaysErr(path: BranchPath, call: Int, key: String, value: String) -> Result<Unit, String>
    ? "Hostile profile: the environment rejects every write."
    Result.Err("hostile: environment write rejected")
