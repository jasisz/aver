module Tmp

fn dv(a: Int, b: Int) -> String
    match Int.div(a, b)
        Result.Ok(q) -> String.fromInt(q)
        Result.Err(e) -> e

fn md(a: Int, b: Int) -> String
    match Int.mod(a, b)
        Result.Ok(r) -> String.fromInt(r)
        Result.Err(e) -> e

fn lawq(a: Int, b: Int, q: Int) -> Bool
    match Int.mod(a, b)
        Result.Ok(r) -> Bool.and(((q * b) + r) == a, Bool.and((0 - 1) < r, r < Int.abs(b)))
        Result.Err(_) -> false

fn law(a: Int, b: Int) -> Bool
    match Int.div(a, b)
        Result.Ok(q) -> lawq(a, b, q)
        Result.Err(_) -> true

