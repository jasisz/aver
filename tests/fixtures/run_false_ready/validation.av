module Validation
    kind = capability
    semantics = effectful
    depends [Work]
    intent = "The job kind of this fixture: scoring one handle off the turn, slowly."
    exposes [begin, take]

operation begin(task: Int) -> Result<Work.Job, String>
    ? "Starts one scoring off the turn and returns its job handle at once."
    oracle = generativeOutput
    replay = recorded

operation take(job: Work.Job) -> Result<Option<Int>, String>
    ? "Collects one finished scoring: None while it runs, Some(score) once it finished."
    oracle = generativeOutput
    replay = recorded
