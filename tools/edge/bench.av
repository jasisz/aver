module Bench
    intent = "Local timing harness for Fractal.render — predicts whether the live /fractal endpoint will fit under Cloudflare Workers' free-plan 10 ms CPU budget. Not deployed."
    depends [Fractal]
    exposes [main]
    effects [Console.print, Time.unixMs]

fn main() -> Unit
    ! [Console.print, Time.unixMs]
    t0 = Time.unixMs()
    full = Fractal.render(200, 120, 100, Fractal.fullView())
    t1 = Time.unixMs()
    seahorse = Fractal.viewFromQuery("cx=-0.7463&cy=0.1102&w=0.012")
    zoom = Fractal.render(200, 120, 220, seahorse)
    t2 = Time.unixMs()
    Console.print("full(200x120,100)={Int.toString(t1 - t0)}ms[{Int.toString(String.len(full))}B] zoom(200x120,220)={Int.toString(t2 - t1)}ms[{Int.toString(String.len(zoom))}B] total={Int.toString(t2 - t0)}ms")
