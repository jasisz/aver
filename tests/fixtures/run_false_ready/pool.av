module Pool
    kind = capability
    semantics = effectful
    intent = "Fixture capability: the score of one task, computed off the turn by whoever answers."
    exposes [scored, early]

operation scored(task: Int) -> Result<Int, String>
    ? "What one task scores, or why it never will."
    oracle = generative
    replay = recorded

operation early() -> Int
    ? "How many takes found their job still running."
    oracle = generative
    replay = recorded
