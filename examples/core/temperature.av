module Temperature
    intent =
        "Converts temperatures between Celsius, Fahrenheit, and Kelvin."
        "Demonstrates Result types, recursive list processing, and co-located verification."
    effects [Console]

decision NoLoops
    date = "2026-02-24"
    reason =
        "Temperature conversion is a pure mapping problem."
        "Each conversion is a single expression — no iteration needed."
    chosen = "PureFunctions"
    rejected = ["ImperativeLoop"]
    impacts = ["convertBatch"]

fn celsiusToFahr(c: Float) -> Float
    ? "Converts Celsius to Fahrenheit using the standard formula."
    c * 1.8 + 32.0

verify celsiusToFahr
    celsiusToFahr(0.0)   => 32.0
    celsiusToFahr(100.0) => 212.0
    celsiusToFahr(-40.0) => -40.0

fn fahrToCelsius(f: Float) -> Float
    ? "Converts Fahrenheit to Celsius."
    (f - 32.0) / 1.8

verify fahrToCelsius
    fahrToCelsius(32.0)  => 0.0
    fahrToCelsius(212.0) => 100.0
    fahrToCelsius(-40.0) => -40.0

fn celsiusToKelvin(c: Float) -> Result<Float, String>
    ? "Converts Celsius to Kelvin. Returns Err if result would be below absolute zero."
    match c < -273.15
        true  -> Result.Err("Below absolute zero")
        false -> Result.Ok(c + 273.15)

verify celsiusToKelvin
    celsiusToKelvin(0.0)    => Result.Ok(273.15)
    celsiusToKelvin(100.0)  => Result.Ok(373.15)
    celsiusToKelvin(-300.0) => Result.Err("Below absolute zero")

fn isBoiling(c: Float) -> Bool
    ? "Returns true if a Celsius temperature is at or above the boiling point of water."
    c >= 100.0

verify isBoiling
    isBoiling(100.0) => true
    isBoiling(99.9)  => false
    isBoiling(150.0) => true

fn isFreezing(c: Float) -> Bool
    ? "Returns true if a Celsius temperature is at or below the freezing point of water."
    c <= 0.0

verify isFreezing
    isFreezing(0.0)  => true
    isFreezing(-10.0) => true
    isFreezing(1.0)  => false

fn classify(c: Float) -> String
    ? "Classifies a Celsius temperature into a human-readable category."
    match c <= 0.0
        true  -> "freezing"
        false -> match c < 20.0
            true  -> "cold"
            false -> match c < 35.0
                true  -> "comfortable"
                false -> "hot"

verify classify
    classify(-5.0) => "freezing"
    classify(10.0) => "cold"
    classify(25.0) => "comfortable"
    classify(40.0) => "hot"

fn collectBoilingTemps(temps: List<Float>) -> List<Float>
    ? "Collects boiling temperatures from a list."
    match temps
        [] -> []
        [temp, ..rest] -> match isBoiling(temp)
            true -> List.prepend(temp, collectBoilingTemps(rest))
            false -> collectBoilingTemps(rest)

verify collectBoilingTemps
    collectBoilingTemps([0.0, 100.0, 110.0]) => [100.0, 110.0]
    collectBoilingTemps([10.0, 20.0]) => []

fn collectFreezingTemps(temps: List<Float>) -> List<Float>
    ? "Collects freezing temperatures from a list."
    match temps
        [] -> []
        [temp, ..rest] -> match isFreezing(temp)
            true -> List.prepend(temp, collectFreezingTemps(rest))
            false -> collectFreezingTemps(rest)

verify collectFreezingTemps
    collectFreezingTemps([0.0, -10.0, 4.0]) => [0.0, -10.0]
    collectFreezingTemps([5.0, 10.0]) => []

fn showKelvin(r: Result<Float, String>) -> String
    ? "Render a Kelvin Result as `K(N)` or `Err(\"...\")`."
    match r
        Result.Ok(k)    -> "K({k})"
        Result.Err(msg) -> "Err(\"{msg}\")"

verify showKelvin
    showKelvin(Result.Err("Below absolute zero")) => "Err(\"Below absolute zero\")"
    String.startsWith(showKelvin(Result.Ok(273.15)), "K(") => true
    String.endsWith(showKelvin(Result.Ok(273.15)), ")") => true

fn showListFloatInner(xs: List<Float>) -> String
    ? "Comma-separated body of a List<Float> render."
    match xs
        [] -> ""
        [head, ..tail] -> match tail
            [] -> "{head}"
            _  -> "{head}, {showListFloatInner(tail)}"

verify showListFloatInner
    showListFloatInner([]) => ""
    String.contains(showListFloatInner([1.5]), ", ") => false
    String.contains(showListFloatInner([0.0, -10.0]), ", ") => true

fn showListFloat(xs: List<Float>) -> String
    ? "Render List<Float> as `[1.0, 2.0]`."
    "[{showListFloatInner(xs)}]"

fn main() -> Unit
    ! [Console.print]
    Console.print("100 C in Fahrenheit: {celsiusToFahr(100.0)}")
    Console.print("98.6 F in Celsius: {fahrToCelsius(98.6)}")
    Console.print("0 C in Kelvin: {showKelvin(celsiusToKelvin(0.0))}")
    Console.print("-300 C in Kelvin: {showKelvin(celsiusToKelvin(-300.0))}")

    temps = [0.0, 15.0, 25.0, 37.0, 100.0]
    Console.print("Boiling: {showListFloat(collectBoilingTemps(temps))}")
    Console.print("Freezing: {showListFloat(collectFreezingTemps(temps))}")
