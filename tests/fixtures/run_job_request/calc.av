module Calc
    kind = capability
    semantics = effectful
    intent = "What the process asks for: a square, computed off the turn by whoever answers."
    exposes [SquareReply, square]

type SquareReply
    Now(Result<Int, String>)
    Later(Wait.Wake)
    Then(Wait.Wake, Result<Int, String>)

operation square(n: Int) -> Result<Int, String>
    ? "The square of n, or why it could not be computed."
    oracle = generative
    replay = recorded
