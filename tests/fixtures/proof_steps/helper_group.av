        _ -> a13(xs, k)

fn a13(xs: List<Int>, k: Int) -> Int
    ? "Step 13 of the chain back to walk."
    match k
        0 -> walk(xs)
        1 -> walk(xs)
        2 -> walk(xs)
        _ -> walk(xs)

fn total(xs: List<Int>) -> Int
    ? "The items, each counted again through the chain."
    match xs
        [] -> 0
        [h, ..t] -> h + b1(t, 0)

verify total law nonNegative
    given a: Int = [0, 1, 5]
    given b: Int = [2, 7]
    total([a, b]) >= 0 => true

fn b1(xs: List<Int>, k: Int) -> Int
    ? "Step 1 of the chain back to total."
    match k
        0 -> b2(xs, k)
        1 -> b2(xs, k)
        2 -> b2(xs, k)
        _ -> b2(xs, k)

fn b2(xs: List<Int>, k: Int) -> Int
    ? "Step 2 of the chain back to total."
    match k
        0 -> b3(xs, k)
        1 -> b3(xs, k)
        2 -> b3(xs, k)
        _ -> b3(xs, k)

