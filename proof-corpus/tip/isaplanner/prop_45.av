module Prop45
    intent =
        "TIP isaplanner prop_45: zip (cons x xs) (cons y ys) = cons (pair2 x y) (zip xs ys)."
    effects []

fn zip(x: List<Int>, y: List<Int>) -> List<Tuple<Int, Int>>
    match x
        [] -> []
        [z, ..x2] -> match y
            [] -> []
            [x3, ..x4] -> List.concat([(z, x3)], zip(x2, x4))

verify zip law zipConsCons
    given x: Int = [1, 2, 3]
    given y: Int = [4, 5, 6]
    given xs: List<Int> = [[], [1], [1, 2]]
    given ys: List<Int> = [[], [4], [4, 5]]
    zip(List.concat([x], xs), List.concat([y], ys)) => List.concat([(x, y)], zip(xs, ys))
