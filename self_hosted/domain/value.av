module Value
    intent =
        "Runtime values for the mini interpreter."
    exposes [Val, valRepr, mapKeyRepr, mapPairs, valEq]
    effects []

fn quoteString(s: String) -> String
    ? "Render a string key or nested string value with quotes."
    "\"" + s + "\""

verify quoteString
    quoteString("hello") => "\"hello\""
    quoteString("") => "\"\""

type Val
    ValInt(Int)
    ValFloat(Float)
    ValStr(String)
    ValBool(Bool)
    ValFnRef(String)
    ValList(List<Val>)
    ValVector(Vector<Val>)
    ValOk(Val)
    ValErr(Val)
    ValSome(Val)
    ValNone
    ValTuple(List<Val>)
    ValRecord(String, List<Tuple<String, Val>>)
    ValTcpConnection(Tcp.Connection)
    ValTcpDial(Tcp.Dial)
    ValTcpListener(Tcp.Listener)
    ValVariant(Int, String, List<Val>)
    ValMap(Map<String, Tuple<Val, Val>>)
    ValUnit

fn valListRepr(items: List<Val>, acc: String, first: Bool) -> String
    ? "Build list repr recursively."
    match items
        [] -> "[{acc}]"
        [v, ..rest] -> match first
            true -> valListRepr(rest, valReprInner(v), false)
            false -> valListRepr(rest, acc + ", " + valReprInner(v), false)

verify valListRepr
    valListRepr([], "", true) => "[]"
    valListRepr([Val.ValInt(1), Val.ValInt(2)], "", true) => "[1, 2]"
    valListRepr([Val.ValStr("a")], "", true) => "[\"a\"]"

fn valRepr(v: Val) -> String
    ? "Display representation of a runtime value."
    match v
        Val.ValInt(n) -> String.fromInt(n)
        Val.ValFloat(f) -> String.fromFloat(f)
        Val.ValStr(s) -> s
        Val.ValBool(b) -> String.fromBool(b)
        Val.ValFnRef(name) -> "<fn {name}>"
        Val.ValList(items) -> valListRepr(items, "", true)
        Val.ValVector(vec) -> "Vector" + valListRepr(List.fromVector(vec), "", true)
        Val.ValOk(inner) -> "Result.Ok({valReprInner(inner)})"
        Val.ValErr(inner) -> "Result.Err({valReprInner(inner)})"
        Val.ValTuple(items) -> "({valFieldsRepr(items, "", true)})"
        Val.ValSome(inner) -> "Option.Some({valReprInner(inner)})"
        Val.ValNone -> "Option.None"
        Val.ValRecord(name, _) -> "{name}(...)"
        Val.ValTcpConnection(_) -> "Tcp.Connection(<resource>)"
        Val.ValTcpDial(_) -> "Tcp.Dial(<resource>)"
        Val.ValTcpListener(_) -> "Tcp.Listener(<resource>)"
        Val.ValMap(m) -> valMapRepr(mapPairs(m), "", true)
        Val.ValVariant(_, fullName, fields) -> valVariantReprTagged(fullName, fields)
        Val.ValUnit -> "()"

verify valRepr
    valRepr(Val.ValInt(42)) => "42"
    valRepr(Val.ValStr("hello")) => "hello"
    valRepr(Val.ValBool(true)) => "true"
    valRepr(Val.ValUnit) => "()"
    valRepr(Val.ValList([Val.ValInt(1)])) => "[1]"
    valRepr(Val.ValOk(Val.ValInt(5))) => "Result.Ok(5)"
    valRepr(Val.ValErr(Val.ValStr("e"))) => "Result.Err(\"e\")"
    valRepr(Val.ValNone) => "Option.None"
    valRepr(Val.ValSome(Val.ValInt(3))) => "Option.Some(3)"
    valRepr(Val.ValTuple([Val.ValInt(1), Val.ValInt(2)])) => "(1, 2)"
    valRepr(Val.ValFloat(3.14)) => "3.14"
    valRepr(Val.ValRecord("User", [("name", Val.ValStr("Alice"))])) => "User(...)"
    valRepr(Val.ValVariant(0, "Token.TkPlus", [])) => "Token.TkPlus"
    valRepr(Val.ValFnRef("foo")) => "<fn foo>"
    valRepr(Val.ValMap({})) => "{{}}"
    valRepr(Val.ValVector(Vector.fromList([]))) => "Vector[]"

fn valReprInner(v: Val) -> String
    ? "Display representation for nested values. Strings are quoted inside containers and wrappers."
    match v
        Val.ValStr(s) -> "\"" + s + "\""
        Val.ValFnRef(name) -> "<fn {name}>"
        Val.ValTuple(items) -> "({valFieldsRepr(items, "", true)})"
        Val.ValVector(vec) -> "Vector" + valListRepr(List.fromVector(vec), "", true)
        Val.ValList(items) -> valListRepr(items, "", true)
        _ -> valRepr(v)

verify valReprInner
    valReprInner(Val.ValStr("hi")) => "\"hi\""
    valReprInner(Val.ValInt(7)) => "7"
    valReprInner(Val.ValBool(false)) => "false"
    valReprInner(Val.ValFnRef("f")) => "<fn f>"
    valReprInner(Val.ValTuple([Val.ValInt(1)])) => "(1)"
    valReprInner(Val.ValList([Val.ValInt(1)])) => "[1]"
    valReprInner(Val.ValVector(Vector.fromList([]))) => "Vector[]"

fn valMapRepr(entries: List<Tuple<Val, Val>>, acc: String, first: Bool) -> String
    ? "Build a stable map repr close to the host interpreter output."
    match entries
        [] -> "{{{acc}}}"
        [pair, ..rest] -> match pair
            (k, v) -> match first
                true -> valMapRepr(rest, valReprInner(k) + ": " + valReprInner(v), false)
                false -> valMapRepr(rest, acc + ", " + valReprInner(k) + ": " + valReprInner(v), false)

verify valMapRepr
    valMapRepr([], "", true) => "{{}}"
    valMapRepr([(Val.ValStr("alice"), Val.ValInt(2))], "", true) => "{{" + quoteString("alice") + ": 2}"

fn mapKeyRepr(v: Val) -> String
    ? "The text a map files a key under: two keys of one type get the same text exactly when they are equal. A String, Int or Bool key is its own text. A key with parts writes each part with its length in front, so no part can pass for a separator, and a record takes its fields in name order."
    match v
        Val.ValInt(n) -> String.fromInt(n)
        Val.ValStr(s) -> s
        Val.ValBool(b) -> String.fromBool(b)
        Val.ValList(items) -> partsKey("[", items)
        Val.ValTuple(items) -> partsKey("(", items)
        Val.ValSome(inner) -> partsKey("S", [inner])
        Val.ValOk(inner) -> partsKey("O", [inner])
        Val.ValErr(inner) -> partsKey("E", [inner])
        Val.ValRecord(_, fields) -> partsKey("R", Map.values(Map.fromList(fields)))
        Val.ValVariant(_, fullName, fields) -> partsKey(fullName + ":", fields)
        _ -> valRepr(v)

verify mapKeyRepr
    mapKeyRepr(Val.ValInt(42)) => "42"
    mapKeyRepr(Val.ValStr("hello")) => "hello"
    mapKeyRepr(Val.ValBool(true)) => "true"
    mapKeyRepr(Val.ValTuple([Val.ValStr("a, b"), Val.ValInt(1)])) => "(4:a, b1:1"
    mapKeyRepr(Val.ValRecord("P", [("y", Val.ValInt(2)), ("x", Val.ValInt(1))])) => "R1:11:2"
    mapKeyRepr(Val.ValVariant(1, "S.B", [Val.ValInt(1)])) => "S.B:1:1"

fn partsKey(tag: String, items: List<Val>) -> String
    ? "A tag followed by each part's key text, each with its length in front."
    match items
        [] -> tag
        [item, ..rest] -> partsKey(tag + String.fromInt(String.len(mapKeyRepr(item))) + ":" + mapKeyRepr(item), rest)

verify partsKey
    partsKey("[", []) => "["
    partsKey("[", [Val.ValStr("ab"), Val.ValStr("")]) => "[2:ab0:"

fn mapPairs(m: Map<String, Tuple<Val, Val>>) -> List<Tuple<Val, Val>>
    ? "A map's (key, value) pairs in key order, the order every backend iterates a map in. The text a String or Bool key is filed under already sorts that way; any other key is sorted."
    pairs = Map.values(m)
    match pairs
        [] -> pairs
        [pair, .._] -> match pair
            (Val.ValStr(_), _) -> pairs
            (Val.ValBool(_), _) -> pairs
            _ -> sortPairs(pairs)

verify mapPairs
    mapPairs({}) => []
    mapPairs({"10" => (Val.ValInt(10), Val.ValStr("a")), "9" => (Val.ValInt(9), Val.ValStr("b"))}) => [(Val.ValInt(9), Val.ValStr("b")), (Val.ValInt(10), Val.ValStr("a"))]

fn sortPairs(pairs: List<Tuple<Val, Val>>) -> List<Tuple<Val, Val>>
    ? "Merge sort of (key, value) pairs by key."
    match pairs
        [] -> pairs
        [_, ..rest] -> match rest
            [] -> pairs
            _ -> sortHalves(splitPairs(pairs, [], []))

verify sortPairs
    sortPairs([(Val.ValInt(2), Val.ValUnit), (Val.ValInt(-1), Val.ValUnit), (Val.ValInt(1), Val.ValUnit)]) => [(Val.ValInt(-1), Val.ValUnit), (Val.ValInt(1), Val.ValUnit), (Val.ValInt(2), Val.ValUnit)]

fn sortHalves(halves: Tuple<List<Tuple<Val, Val>>, List<Tuple<Val, Val>>>) -> List<Tuple<Val, Val>>
    ? "Sort both halves and merge them."
    match halves
        (left, right) -> mergePairs(sortPairs(left), sortPairs(right), [])

verify sortHalves
    sortHalves(([(Val.ValInt(2), Val.ValUnit)], [(Val.ValInt(1), Val.ValUnit)])) => [(Val.ValInt(1), Val.ValUnit), (Val.ValInt(2), Val.ValUnit)]

fn splitPairs(pairs: List<Tuple<Val, Val>>, left: List<Tuple<Val, Val>>, right: List<Tuple<Val, Val>>) -> Tuple<List<Tuple<Val, Val>>, List<Tuple<Val, Val>>>
    ? "Deal pairs into two halves alternately."
    match pairs
        [] -> (left, right)
        [pair, ..rest] -> splitPairs(rest, right, List.prepend(pair, left))

verify splitPairs
    splitPairs([(Val.ValInt(1), Val.ValUnit), (Val.ValInt(2), Val.ValUnit)], [], []) => ([(Val.ValInt(1), Val.ValUnit)], [(Val.ValInt(2), Val.ValUnit)])

fn mergePairs(xs: List<Tuple<Val, Val>>, ys: List<Tuple<Val, Val>>, acc: List<Tuple<Val, Val>>) -> List<Tuple<Val, Val>>
    ? "Merge two key-sorted lists of pairs."
    match xs
        [] -> List.concat(List.reverse(acc), ys)
        [x, ..xr] -> match ys
            [] -> List.concat(List.reverse(acc), xs)
            [y, ..yr] -> match pairBefore(x, y)
                true -> mergePairs(xr, ys, List.prepend(x, acc))
                false -> mergePairs(xs, yr, List.prepend(y, acc))

verify mergePairs
    mergePairs([(Val.ValInt(1), Val.ValUnit)], [(Val.ValInt(0), Val.ValUnit)], []) => [(Val.ValInt(0), Val.ValUnit), (Val.ValInt(1), Val.ValUnit)]

fn pairBefore(x: Tuple<Val, Val>, y: Tuple<Val, Val>) -> Bool
    ? "Whether the first pair's key sorts before the second's."
    match (x, y)
        ((a, _), (b, _)) -> valCmp(a, b) < 0

verify pairBefore
    pairBefore((Val.ValInt(1), Val.ValUnit), (Val.ValInt(2), Val.ValUnit)) => true

fn valCmp(a: Val, b: Val) -> Int
    ? "Order two map keys of one type, -1, 0 or 1: Int by value, String by codepoint, Bool false first, a list or tuple item by item, a record by its fields in name order, a variant by constructor name and then payload, None before Some, Ok before Err."
    match (a, b)
        (Val.ValInt(x), Val.ValInt(y)) -> ordOf(x < y, x == y)
        (Val.ValStr(x), Val.ValStr(y)) -> ordOf(x < y, x == y)
        (Val.ValBool(x), Val.ValBool(y)) -> ordOf(Bool.and(y, x == false), x == y)
        (Val.ValList(xs), Val.ValList(ys)) -> valsCmp(xs, ys)
        (Val.ValTuple(xs), Val.ValTuple(ys)) -> valsCmp(xs, ys)
        (Val.ValRecord(_, fs), Val.ValRecord(_, gs)) -> valsCmp(Map.values(Map.fromList(fs)), Map.values(Map.fromList(gs)))
        (Val.ValVariant(_, n, fs), Val.ValVariant(_, m, gs)) -> match n == m
            true -> valsCmp(fs, gs)
            false -> ordOf(n < m, false)
        (Val.ValSome(x), Val.ValSome(y)) -> valCmp(x, y)
        (Val.ValOk(x), Val.ValOk(y)) -> valCmp(x, y)
        (Val.ValErr(x), Val.ValErr(y)) -> valCmp(x, y)
        (Val.ValNone, Val.ValSome(_)) -> -1
        (Val.ValSome(_), Val.ValNone) -> 1
        (Val.ValOk(_), Val.ValErr(_)) -> -1
        (Val.ValErr(_), Val.ValOk(_)) -> 1
        _ -> 0

verify valCmp
    valCmp(Val.ValInt(9), Val.ValInt(10)) => -1
    valCmp(Val.ValStr("b"), Val.ValStr("a")) => 1
    valCmp(Val.ValBool(false), Val.ValBool(true)) => -1
    valCmp(Val.ValList([Val.ValInt(1), Val.ValInt(2)]), Val.ValList([Val.ValInt(12)])) => -1
    valCmp(Val.ValRecord("P", [("y", Val.ValInt(1)), ("x", Val.ValInt(2))]), Val.ValRecord("P", [("x", Val.ValInt(1)), ("y", Val.ValInt(2))])) => 1
    valCmp(Val.ValVariant(1, "S.Line", []), Val.ValVariant(0, "S.Box", [Val.ValInt(1)])) => 1
    valCmp(Val.ValNone, Val.ValSome(Val.ValInt(0))) => -1
    valCmp(Val.ValUnit, Val.ValUnit) => 0

fn valsCmp(xs: List<Val>, ys: List<Val>) -> Int
    ? "Order two lists of values item by item, a shorter prefix first."
    match xs
        [] -> match ys
            [] -> 0
            _ -> -1
        [x, ..xr] -> match ys
            [] -> 1
            [y, ..yr] -> match valCmp(x, y)
                0 -> valsCmp(xr, yr)
                c -> c

verify valsCmp
    valsCmp([], []) => 0
    valsCmp([], [Val.ValInt(1)]) => -1
    valsCmp([Val.ValInt(1), Val.ValInt(3)], [Val.ValInt(1), Val.ValInt(2)]) => 1

fn ordOf(less: Bool, same: Bool) -> Int
    ? "-1 when less, 0 when the same, 1 otherwise."
    match less
        true -> -1
        false -> match same
            true -> 0
            false -> 1

verify ordOf
    ordOf(true, false) => -1
    ordOf(false, true) => 0
    ordOf(false, false) => 1

fn valVariantReprTagged(fullName: String, fields: List<Val>) -> String
    ? "Display a variant value using its full name."
    match fields
        [] -> fullName
        _ -> "{fullName}({valFieldsRepr(fields, "", true)})"

verify valVariantReprTagged
    valVariantReprTagged("Token.TkPlus", []) => "Token.TkPlus"
    valVariantReprTagged("Expr.ExprInt", [Val.ValInt(5)]) => "Expr.ExprInt(5)"

fn valFieldsRepr(items: List<Val>, acc: String, first: Bool) -> String
    ? "Build comma-separated repr of variant fields."
    match items
        [] -> acc
        [v, ..rest] -> match first
            true -> valFieldsRepr(rest, valReprInner(v), false)
            false -> valFieldsRepr(rest, acc + ", " + valReprInner(v), false)

verify valFieldsRepr
    valFieldsRepr([], "", true) => ""
    valFieldsRepr([Val.ValInt(1), Val.ValStr("hi")], "", true) => "1, \"hi\""

fn valEq(a: Val, b: Val) -> Bool
    ? "Whether two values are equal as == says: part by part, a Float by IEEE 754, so a NaN is not equal to itself and 0.0 is equal to -0.0."
    match (a, b)
        (Val.ValInt(x), Val.ValInt(y)) -> x == y
        (Val.ValFloat(x), Val.ValFloat(y)) -> x == y
        (Val.ValStr(x), Val.ValStr(y)) -> x == y
        (Val.ValBool(x), Val.ValBool(y)) -> x == y
        (Val.ValFnRef(x), Val.ValFnRef(y)) -> x == y
        (Val.ValList(xs), Val.ValList(ys)) -> valsEq(xs, ys)
        (Val.ValTuple(xs), Val.ValTuple(ys)) -> valsEq(xs, ys)
        (Val.ValVector(xs), Val.ValVector(ys)) -> valsEq(List.fromVector(xs), List.fromVector(ys))
        (Val.ValOk(x), Val.ValOk(y)) -> valEq(x, y)
        (Val.ValErr(x), Val.ValErr(y)) -> valEq(x, y)
        (Val.ValSome(x), Val.ValSome(y)) -> valEq(x, y)
        (Val.ValNone, Val.ValNone) -> true
        (Val.ValUnit, Val.ValUnit) -> true
        (Val.ValRecord(n, fs), Val.ValRecord(m, gs)) -> match n == m
            true -> entriesEq(Map.entries(Map.fromList(fs)), Map.entries(Map.fromList(gs)))
            false -> false
        (Val.ValVariant(_, n, fs), Val.ValVariant(_, m, gs)) -> match n == m
            true -> valsEq(fs, gs)
            false -> false
        (Val.ValMap(x), Val.ValMap(y)) -> pairsEq(Map.values(x), Map.values(y))
        _ -> valRepr(a) == valRepr(b)

verify valEq
    valEq(Val.ValInt(1), Val.ValInt(1)) => true
    valEq(Val.ValFloat(0.0), Val.ValFloat(-0.0)) => true
    valEq(Val.ValList([Val.ValInt(1)]), Val.ValList([Val.ValInt(2)])) => false
    valEq(Val.ValSome(Val.ValStr("a")), Val.ValSome(Val.ValStr("a"))) => true
    valEq(Val.ValRecord("P", [("x", Val.ValInt(1))]), Val.ValRecord("P", [("x", Val.ValInt(2))])) => false
    valEq(Val.ValVariant(0, "S.A", [Val.ValInt(1)]), Val.ValVariant(0, "S.A", [Val.ValInt(1)])) => true
    valEq(Val.ValVariant(0, "S.A", []), Val.ValVariant(1, "S.B", [])) => false
    valEq(Val.ValNone, Val.ValUnit) => false

fn valsEq(xs: List<Val>, ys: List<Val>) -> Bool
    ? "Whether two lists of values are equal item by item."
    match xs
        [] -> match ys
            [] -> true
            _ -> false
        [x, ..xr] -> match ys
            [] -> false
            [y, ..yr] -> match valEq(x, y)
                true -> valsEq(xr, yr)
                false -> false

verify valsEq
    valsEq([], []) => true
    valsEq([Val.ValInt(1)], []) => false
    valsEq([Val.ValInt(1)], [Val.ValInt(1)]) => true

fn entriesEq(xs: List<Tuple<String, Val>>, ys: List<Tuple<String, Val>>) -> Bool
    ? "Whether two lists of named values are equal entry by entry."
    match xs
        [] -> match ys
            [] -> true
            _ -> false
        [x, ..xr] -> match ys
            [] -> false
            [y, ..yr] -> match (x, y)
                ((k, v), (j, w)) -> match k == j
                    true -> match valEq(v, w)
                        true -> entriesEq(xr, yr)
                        false -> false
                    false -> false

verify entriesEq
    entriesEq([], []) => true
    entriesEq([("a", Val.ValInt(1))], [("a", Val.ValInt(1))]) => true
    entriesEq([("a", Val.ValInt(1))], [("b", Val.ValInt(1))]) => false

fn pairsEq(xs: List<Tuple<Val, Val>>, ys: List<Tuple<Val, Val>>) -> Bool
    ? "Whether two lists of (key, value) pairs are equal pair by pair."
    match xs
        [] -> match ys
            [] -> true
            _ -> false
        [x, ..xr] -> match ys
            [] -> false
            [y, ..yr] -> match (x, y)
                ((k, v), (j, w)) -> match Bool.and(valEq(k, j), valEq(v, w))
                    true -> pairsEq(xr, yr)
                    false -> false

verify pairsEq
    pairsEq([], []) => true
    pairsEq([(Val.ValInt(1), Val.ValInt(2))], [(Val.ValInt(1), Val.ValInt(2))]) => true
    pairsEq([(Val.ValInt(1), Val.ValInt(2))], [(Val.ValInt(1), Val.ValInt(3))]) => false
