module TimeCapabilityTargets
    intent = "Exercises the standard Time and Random contracts on every shipped execution target."
    effects [Random.int, Random.float, Time.now, Time.unixMs, Time.sleep]

fn main() -> Int
    ! [Random.int, Random.float, Time.now, Time.unixMs, Time.sleep]
    stamp = Time.now()
    _epoch = Time.unixMs()
    Time.sleep(0)
    roll = Random.int(1, 6)
    _fraction = Random.float()
    String.len(stamp) + roll
