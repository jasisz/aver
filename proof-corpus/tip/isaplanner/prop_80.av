module Prop80
    intent =
        "TIP isaplanner prop_80: take n (xs ++ ys) = take n xs ++ take (n - len xs) ys."
    effects []

type Nat
    Z
    S(Nat)

fn take(n: Nat, xs: List<Int>) -> List<Int>
    match n
        Nat.Z -> []
        Nat.S(z) -> match xs
            [] -> []
            [x2, ..x3] -> List.concat([x2], take(z, x3))

fn len(xs: List<Int>) -> Nat
    match xs
        [] -> Nat.Z
        [y, ..ys] -> Nat.S(len(ys))

fn minus(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> Nat.Z
        Nat.S(z) -> match y
            Nat.Z -> x
            Nat.S(x2) -> minus(z, x2)

verify take law takeAppendSplit
    given n: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given xs: List<Int> = [[5], [1], [1, 2]]
    given ys: List<Int> = [[6], [3], [3, 4]]
    take(n, List.concat(xs, ys)) => List.concat(take(n, xs), take(minus(n, len(xs)), ys))
