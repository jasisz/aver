(steps 16
 (obligation stringDiffers () (none)
  (op != (s "a") (s "b"))
  (bi Bool.not (op == (s "a") (s "b"))))
 (defs
  (def f ((x (named _))) (named _) () (v x)))
 (consts)
 (sums)
 (recs)
 (sigs)
 (laws)
 (proof
  (trans
   ((op != (s "a") (s "b"))
    (op != (call f (s "a")) (s "b"))
    (op != (call f (s "a")) (call f (s "b")))
    (bi Bool.not (op == (call f (s "a")) (call f (s "b"))))
    (bi Bool.not (op == (s "a") (call f (s "b"))))
    (bi Bool.not (op == (s "a") (s "b"))))
   (symm (congr (op != (hole) (s "b")) (unfold f 0 ((s "a")) ())))
   (symm (congr (op != (call f (s "a")) (hole)) (unfold f 0 ((s "b")) ())))
   (rule int.ne.def ((a (call f (s "a"))) (b (call f (s "b")))))
   (congr (bi Bool.not (op == (hole) (call f (s "b")))) (unfold f 0 ((s "a")) ()))
   (congr (bi Bool.not (op == (s "a") (hole))) (unfold f 0 ((s "b")) ())))))
