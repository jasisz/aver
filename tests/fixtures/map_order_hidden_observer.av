module MapOrderHiddenObserver
    intent =
        "Two ways of reaching a map iteration-order observer that the cone walk used to miss."
        "Neither law names Map.values itself: one reaches it through a string interpolation, the other through a tail call into a mutual peer."

fn hiddenValues(m: Map<Tuple<Int, Int>, Int>) -> List<Int>
    ? "Reads a tuple-keyed map in iteration order."
    Map.values(m)

fn firstValue(m: Map<Tuple<Int, Int>, Int>) -> Int
    ? "The value the map yields first."
    match hiddenValues(m)
        [x, ..__rest] -> x
        _ -> 0

fn describe(m: Map<Tuple<Int, Int>, Int>) -> String
    ? "The first value, rendered through an interpolated string."
    "{firstValue(m)}"

verify describe law describeReadsIterationOrder
    given m: Map<Tuple<Int, Int>, Int> = [{ (2, 0) => 5, (1, 0) => 3}]
    describe(m) => "5"

fn readValues(m: Map<Tuple<Int, Int>, Int>, n: Int) -> List<Int>
    ? "Reads the map in iteration order, or bounces back to its peer."
    match n
        0 -> Map.values(m)
        _ -> bounce(m, n - 1)

fn bounce(m: Map<Tuple<Int, Int>, Int>, n: Int) -> List<Int>
    ? "Bounces straight into the reader; the call is in tail position."
    readValues(m, n)

verify bounce law bounceReadsIterationOrder
    given m: Map<Tuple<Int, Int>, Int> = [{ (2, 0) => 5, (1, 0) => 3}]
    bounce(m, 1) => [5, 3]
