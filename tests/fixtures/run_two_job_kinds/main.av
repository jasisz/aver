module Node
    intent = "Fixture: two job kinds under one generated loop with max-jobs = 3. Four tasks share the table and the limit; the run ends when the pool reports what they scored, which is the proof each of them landed once."
    depends [Process, Wait, Work, Pool, Alpha, Beta, Pooled]
    effects [Console.print, Pool.claim, yield]
    exposes [Pending, View, order, admit, stop]

type Pending
    Looping(Int, Wait.Wake)

record View
    pending: Map<Int, Pending>
    ready: List<Int>
    askable: List<Int>
    jobs: Int
    room: Int
    stopping: Bool

fn looping() -> Unit
    ? "Claims handles until the pool finishes it — which happens only once every task has landed — and says what they scored."
    ! [Console.print, Pool.claim, yield]
    match Pool.claim()
        Pool.Assignment.Handle(_) -> looping()
        Pool.Assignment.Finished(scored) -> Console.print("all jobs landed: scored {scored}")

fn order(view: View) -> List<Int>
    ? "Every seated process, in slot order."
    Map.keys(view.pending)

fn admit(view: View, id: Int) -> Bool
    ? "Everything seated is served."
    Map.has(view.pending, id)

fn stop(view: View) -> Bool
    ? "The run ends when the process asked us to."
    view.stopping
