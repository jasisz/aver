module Fractal
    intent =
        "Pure-Aver Mandelbrot rendered via Unicode Braille (U+2800..U+28FF)."
        "Each character represents a 2×4 grid of sub-pixels — eight"
        "mandelIter samples per char, one bit per sample, packed into the"
        "low 8 bits of the Braille code-point. Pattern lifted from"
        "examples/games/doom/render.av. No effects: render() builds the"
        "string, page() wraps a full-view + seahorse-zoom pair in HTML."
    exposes [render, page, fullView, seahorseView, View]
    effects []

record View
    cxMin: Float
    cxRange: Float
    cyMin: Float
    cyRange: Float

fn fullView() -> View
    ? "Standard Mandelbrot view: cx ∈ [-2.5, 1.0], cy ∈ [-1.0, 1.0]."
    View(
        cxMin = 0.0 - 2.5,
        cxRange = 3.5,
        cyMin = 0.0 - 1.0,
        cyRange = 2.0,
    )

verify fullView
    fullView().cxRange => 3.5

fn seahorseView() -> View
    ? "Seahorse valley zoom centred on (-0.7463, 0.1102) — a classic spiral landmark deep in the valley, ~290× zoom. Picked so the period-2 bulb wall is *outside* the view, leaving filaments and mini-Mandelbrot satellites in the centre instead of a solid block on the right."
    View(
        cxMin = 0.0 - 0.7523,
        cxRange = 0.012,
        cyMin = 0.1042,
        cyRange = 0.012,
    )

verify seahorseView
    seahorseView().cxRange => 0.012

fn mandelStep(n: Int, x: Float, y: Float, cx: Float, cy: Float, maxIter: Int) -> Int
    ? "One iteration of z = z² + c, dispatched on whether |z|² has escaped 4."
    x2 = x * x
    y2 = y * y
    match (x2 + y2) > 4.0
        true  -> n
        false -> mandelIter(n + 1, x2 - y2 + cx, 2.0 * x * y + cy, cx, cy, maxIter)

verify mandelStep
    mandelStep(7, 3.0, 0.0, 0.0, 0.0, 50) => 7
    mandelStep(0, 0.0, 0.0, 0.0, 0.0, 50) => 50

fn mandelIter(n: Int, x: Float, y: Float, cx: Float, cy: Float, maxIter: Int) -> Int
    ? "Iterates z = z² + c until |z|² > 4 or maxIter; returns the escape iteration count. TCO-eligible mutual recursion via mandelStep."
    match n >= maxIter
        true  -> maxIter
        false -> mandelStep(n, x, y, cx, cy, maxIter)

verify mandelIter
    mandelIter(0, 0.0, 0.0, 0.0, 0.0, 50) => 50
    mandelIter(0, 0.0, 0.0, 3.0, 0.0, 50) => 1
    mandelIter(0, 0.0, 0.0, 2.0, 0.0, 50) => 2

fn brailleBase() -> Int
    ? "Unicode code point for empty Braille pattern (U+2800)."
    10240

verify brailleBase
    brailleBase() => 10240

fn brailleChar(bits: Int) -> String
    ? "Convert an 8-bit dot mask to a Braille Unicode character. Bits 0..7 map to the eight Braille dots; the lowest 6 bits are the standard 6-dot pattern, bits 6 and 7 are the bottom row of the 8-dot extension."
    match Char.fromCode(brailleBase() + bits)
        Option.Some(ch) -> ch
        Option.None    -> " "

verify brailleChar
    String.len(brailleChar(0))   => 1
    String.len(brailleChar(255)) => 1

fn dotBitLeft(row: Int) -> Int
    ? "Bit value for the left column at sub-pixel row 0..3."
    match row
        0 -> 1
        1 -> 2
        2 -> 4
        3 -> 64
        _ -> 0

verify dotBitLeft
    dotBitLeft(0) => 1
    dotBitLeft(3) => 64
    dotBitLeft(9) => 0

fn dotBitRight(row: Int) -> Int
    ? "Bit value for the right column at sub-pixel row 0..3."
    match row
        0 -> 8
        1 -> 16
        2 -> 32
        3 -> 128
        _ -> 0

verify dotBitRight
    dotBitRight(0) => 8
    dotBitRight(3) => 128
    dotBitRight(9) => 0

fn insideCardioid(cx: Float, cy: Float) -> Bool
    ? "True if (cx, cy) lies inside the main cardioid (the largest connected component of the set). Roughly 50% of inside-set points fall here; this test costs ~5 ops and avoids running mandelIter to maxIter on every one of them."
    qx = cx - 0.25
    q = qx * qx + cy * cy
    q * (q + qx) < 0.25 * cy * cy

verify insideCardioid
    insideCardioid(0.0, 0.0) => true
    insideCardioid(2.0, 0.0) => false

fn insideBulb(cx: Float, cy: Float) -> Bool
    ? "True if (cx, cy) lies inside the period-2 bulb (disk of radius 1/4 around c = -1). Catches the second-largest inside-set region."
    dx = cx + 1.0
    dx * dx + cy * cy < 0.0625

verify insideBulb
    insideBulb(0.0 - 1.0, 0.0) => true
    insideBulb(0.0, 0.0)       => false

fn dotEscape(cx: Float, cy: Float, maxIter: Int, bitVal: Int) -> Int
    ? "Slow path — only reached when both cardioid and bulb pre-tests miss. Runs mandelIter to determine inside-set membership."
    match mandelIter(0, 0.0, 0.0, cx, cy, maxIter) >= maxIter
        true  -> bitVal
        false -> 0

fn dotInsideOrEscape(cx: Float, cy: Float, maxIter: Int, bitVal: Int) -> Int
    ? "Cardioid missed — try the period-2 bulb, then fall through to mandelIter."
    match insideBulb(cx, cy)
        true  -> bitVal
        false -> dotEscape(cx, cy, maxIter, bitVal)

fn dot(cx: Float, cy: Float, maxIter: Int, bitVal: Int) -> Int
    ? "Returns bitVal if (cx, cy) is inside the Mandelbrot set under the given iteration cap, else 0. Tries the two cheap geometric inside-set tests (main cardioid, period-2 bulb) before falling back to the iterative escape test — typically a ~3-5× speedup on full views."
    match insideCardioid(cx, cy)
        true  -> bitVal
        false -> dotInsideOrEscape(cx, cy, maxIter, bitVal)

verify dot
    dot(0.0, 0.0, 50, 1)        => 1
    dot(3.0, 0.0, 50, 1)        => 0
    dot(0.0, 0.0, 50, 128)      => 128
    dot(0.0 - 1.0, 0.0, 50, 1)  => 1

fn cellCx(charCol: Int, dx: Int, charsW: Int, view: View) -> Float
    ? "Sub-pixel column → Mandelbrot cx coordinate, parameterised by the view rectangle."
    pixelX = charCol * 2 + dx
    pixelW = charsW * 2
    Int.toFloat(pixelX) / Int.toFloat(pixelW) * view.cxRange + view.cxMin

verify cellCx
    cellCx(0, 0, 1, fullView()) => 0.0 - 2.5
    cellCx(0, 1, 2, fullView()) => 0.0 - 1.625

fn cellCy(charRow: Int, dy: Int, charsH: Int, view: View) -> Float
    ? "Sub-pixel row → Mandelbrot cy coordinate, parameterised by the view rectangle."
    pixelY = charRow * 4 + dy
    pixelH = charsH * 4
    Int.toFloat(pixelY) / Int.toFloat(pixelH) * view.cyRange + view.cyMin

verify cellCy
    cellCy(0, 0, 1, fullView()) => 0.0 - 1.0
    cellCy(0, 1, 1, fullView()) => 0.0 - 0.5

fn brailleCell(charCol: Int, charRow: Int, charsW: Int, charsH: Int, maxIter: Int, view: View) -> String
    ? "Render one Braille character by sampling all eight sub-pixels of the cell through the Mandelbrot set and OR-ing their bit values."
    cxL = cellCx(charCol, 0, charsW, view)
    cxR = cellCx(charCol, 1, charsW, view)
    cy0 = cellCy(charRow, 0, charsH, view)
    cy1 = cellCy(charRow, 1, charsH, view)
    cy2 = cellCy(charRow, 2, charsH, view)
    cy3 = cellCy(charRow, 3, charsH, view)
    b0 = dot(cxL, cy0, maxIter, dotBitLeft(0))
    b1 = dot(cxL, cy1, maxIter, dotBitLeft(1))
    b2 = dot(cxL, cy2, maxIter, dotBitLeft(2))
    b3 = dot(cxL, cy3, maxIter, dotBitLeft(3))
    b4 = dot(cxR, cy0, maxIter, dotBitRight(0))
    b5 = dot(cxR, cy1, maxIter, dotBitRight(1))
    b6 = dot(cxR, cy2, maxIter, dotBitRight(2))
    b7 = dot(cxR, cy3, maxIter, dotBitRight(3))
    brailleChar(b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7)

verify brailleCell
    String.len(brailleCell(0, 0, 1, 1, 50, fullView())) => 1

fn cellRow(col: Int, row: Int, charsW: Int, charsH: Int, maxIter: Int, view: View, acc: List<String>) -> List<String>
    ? "Folds across one row of Braille cells, prepending each rendered char; reverses on completion."
    match col >= charsW
        true  -> List.reverse(acc)
        false -> cellRow(col + 1, row, charsW, charsH, maxIter, view, List.prepend(brailleCell(col, row, charsW, charsH, maxIter, view), acc))

verify cellRow
    cellRow(0, 0, 0, 1, 50, fullView(), []) => []
    String.len(String.join(cellRow(0, 0, 2, 1, 50, fullView(), []), "")) => 2

fn renderRow(row: Int, charsW: Int, charsH: Int, maxIter: Int, view: View) -> String
    ? "Joins one row of Braille cells into a single text line."
    String.join(cellRow(0, row, charsW, charsH, maxIter, view, []), "")

verify renderRow
    renderRow(0, 0, 1, 50, fullView()) => ""

fn allRows(row: Int, charsW: Int, charsH: Int, maxIter: Int, view: View, acc: List<String>) -> List<String>
    ? "Folds across char-rows, accumulating each rendered line."
    match row >= charsH
        true  -> List.reverse(acc)
        false -> allRows(row + 1, charsW, charsH, maxIter, view, List.prepend(renderRow(row, charsW, charsH, maxIter, view), acc))

verify allRows
    allRows(0, 1, 0, 50, fullView(), []) => []
    String.len(String.join(allRows(0, 2, 2, 50, fullView(), []), "")) => 4

fn render(charsW: Int, charsH: Int, maxIter: Int, view: View) -> String
    ? "Public entry: renders a Braille-encoded Mandelbrot of charsW × charsH characters (covering 2*charsW × 4*charsH logical sub-pixels) over the given view rectangle."
    String.join(allRows(0, charsW, charsH, maxIter, view, []), "\n")

verify render
    render(0, 0, 50, fullView()) => ""

fn page(fullRendered: String, zoomRendered: String) -> String
    ? "HTML page wrapping two Braille fractals: the full Mandelbrot view and a zoom into the seahorse valley. Pure string assembly — no IO."
    String.join([
        "<!doctype html>",
        "<html lang=\"en\">",
        "<head>",
        "  <meta charset=\"utf-8\">",
        "  <title>edge.averlang.dev — Mandelbrot from pure Aver</title>",
        "  <style>",
        "    body {{ font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; color: #1a1a1a; background: #fafafa; }}",
        "    h1 {{ font-size: 1.4rem; margin-bottom: 0.2rem; }}",
        "    .sub {{ color: #666; margin-top: 0; font-size: 0.92rem; }}",
        "    h2.viewname {{ font-size: 1.0rem; margin: 1.6rem 0 0.4rem; color: #444; font-weight: 650; }}",
        "    h2.viewname .coords {{ color: #888; font-weight: 400; font-size: 0.85rem; margin-left: 0.4rem; }}",
        "    pre.fractal {{ background: #0f0f0f; color: #d4f7d4; padding: 1rem; border-radius: 8px; font-size: clamp(0.5rem, 1.45vw, 0.95rem); line-height: 1.0; letter-spacing: 0; box-shadow: 0 1px 4px rgba(0,0,0,0.18); white-space: pre; width: max-content; max-width: 100%; margin: 0 auto; box-sizing: border-box; overflow-x: auto; }}",
        "    a {{ color: #1a4cdb; }}",
        "    code {{ background: #f3f3f3; padding: 0.1em 0.35em; border-radius: 3px; }}",
        "  </style>",
        "</head>",
        "<body>",
        "  <h1>Mandelbrot, in pure Aver, served from the edge.</h1>",
        "  <p class=\"sub\">Two views, both rendered via Unicode Braille — every glyph packs 2×4 sub-pixels into one character (U+2800..U+28FF). 80×24 chars per panel = 160×96 sub-pixel resolution. The same <code>render(w, h, maxIter, view)</code> function builds both panels per request, no caching. Speed-up trick: cardioid + period-2 bulb pre-tests reject ~70% of inside-set pixels in ~5 ops each, before any iteration runs.</p>",
        "  <h2 class=\"viewname\">full set <span class=\"coords\">cx ∈ [-2.5, 1.0], cy ∈ [-1.0, 1.0]</span></h2>",
        "  <pre class=\"fractal\">{fullRendered}</pre>",
        "  <h2 class=\"viewname\">seahorse valley <span class=\"coords\">centred on (-0.7463, 0.1102) · 290× zoom · 150 iter</span></h2>",
        "  <pre class=\"fractal\">{zoomRendered}</pre>",
        "  <p>Pattern lifted from <a href=\"https://github.com/jasisz/aver/blob/main/examples/games/doom/render.av\">the Doom raycaster's Braille renderer</a>. Each Braille code point's low 8 bits are an eight-dot bitmap; we OR together one bit per sub-pixel hit on <code>mandelIter</code>'s inside-set test, then look up the resulting glyph through <code>Char.fromCode</code>. The view rectangle is just a 4-Float record passed through to <code>cellCx</code> / <code>cellCy</code> — same engine, two viewports. The <code>Fractal</code> module declares <code>effects []</code>. <a href=\"https://github.com/jasisz/aver/blob/main/tools/edge/fractal.av\">Read the fractal source.</a></p>",
        "  <p><a href=\"/\">← back to the landing</a></p>",
        "</body>",
        "</html>",
        ""
    ], "\n")
