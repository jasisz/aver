module MapEqualityCollidingType
    intent =
        "Two modules declare a record called Entry, and only one of them holds a float-keyed map."
        "Comparing the map-free one must export; comparing the map-carrying one must not. Routing by bare name cannot tell them apart, so it gets exactly one of the two wrong."
    depends [Holder]

record Entry
    label: String
    scores: Map<Float, Int>

fn sameHeldEntry(a: Holder.Entry, b: Holder.Entry) -> Bool
    ? "Compares two map-free entries from the other module."
    a == b

verify sameHeldEntry law reflexive
    given a: Holder.Entry = [Holder.entryOf("x", 1), Holder.entryOf("y", 2)]
    sameHeldEntry(a, a) => true

fn sameScoredEntry(a: Entry, b: Entry) -> Bool
    ? "Compares two entries that each carry a float-keyed map."
    a == b

verify sameScoredEntry law alsoReflexive
    given a: Entry = [Entry(label = "x", scores = {1.0 => 1})]
    sameScoredEntry(a, a) => true
