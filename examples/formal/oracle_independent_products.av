module OracleIndependentProducts
    intent =
        "Demonstrates Oracle verification for independent products."
        "Covers bare ! branch traces and ?! Result unwrapping with leftmost-error priority."
    effects [Disk, Random]

fn counterStub(path: BranchPath, n: Int, min: Int, max: Int) -> Result<Int, String>
    ? "Return the per-branch oracle counter."
    Result.Ok(n)

fn pairSpec(path: BranchPath, rnd: Fn(BranchPath, Int, Int, Int) -> Result<Int, String>) -> Tuple<Int, Int>
    ? "Expected pair for a two-branch independent product."
    leftPath = BranchPath.child(path, 0)
    rightPath = BranchPath.child(path, 1)
    left = Result.withDefault(rnd(leftPath, 0, 1, 6), 1)
    right = Result.withDefault(rnd(rightPath, 0, 7, 12), 7)
    (left, right)

fn pickPair() -> Tuple<Int, Int>
    ? "Draw two values in one independent product."
    ! [Random.int]
    (Random.int(1, 6), Random.int(7, 12))!

verify pickPair law branchPathLaw
    given rnd: Random.int = [counterStub]
    pickPair() => pairSpec(BranchPath.Root, rnd)

verify pickPair trace
    given rnd: Random.int = [counterStub]
    picked = pickPair()
    picked.trace.group(0).length() => 2
    picked.trace.group(0).branch(0).event(0) => Option.Some(EffectEvent(method = "Random.int", args = [1, 6], path = "0"))
    picked.trace.group(0).branch(1).event(0) => Option.Some(EffectEvent(method = "Random.int", args = [7, 12], path = "1"))

fn fakeReadByFile(path: BranchPath, n: Int, file: String) -> Result<String, String>
    ? "Return deterministic file content or deterministic file errors."
    match file
        "left.txt" -> Result.Ok("left")
        "right.txt" -> Result.Ok("right")
        "fail-left.txt" -> Result.Err("left failed")
        "fail-right.txt" -> Result.Err("right failed")
        _ -> Result.Err("unknown file")

fn readPair(leftFile: String, rightFile: String) -> Result<Tuple<String, String>, String>
    ? "Read two files with ?!, unwrapping both Ok values or propagating the leftmost Err."
    ! [Disk.readText]
    pair = (Disk.readText(leftFile), Disk.readText(rightFile))?!
    match pair
        (left, right) -> Result.Ok((left, right))

verify readPair trace
    given read: Disk.readText = [fakeReadByFile]
    ok = readPair("left.txt", "right.txt")
    fails = readPair("fail-left.txt", "fail-right.txt")
    ok.result => Result.Ok(("left", "right"))
    ok.trace.group(0).length() => 2
    ok.trace.group(0).branch(0).event(0) => Option.Some(EffectEvent(method = "Disk.readText", args = ["left.txt"], path = "0"))
    ok.trace.group(0).branch(1).event(0) => Option.Some(EffectEvent(method = "Disk.readText", args = ["right.txt"], path = "1"))
    fails.result => Result.Err("left failed")
    fails.trace.group(0).length() => 2

verify counterStub
    counterStub(BranchPath.Root, 0, 1, 6) => Result.Ok(0)

verify pairSpec
    pairSpec(BranchPath.Root, counterStub) => (0, 0)

verify fakeReadByFile
    fakeReadByFile(BranchPath.Root, 0, "left.txt") => Result.Ok("left")
    fakeReadByFile(BranchPath.Root, 0, "fail-left.txt") => Result.Err("left failed")
