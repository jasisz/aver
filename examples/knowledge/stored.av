module Stored
    intent = "The Content answer module owns Knowledge and the validation jobs it begins itself. Only the take of a local validation job inserts verdicts."
    depends [Bytes, Knowledge, Content, Validation, Wait, Work]
    effects [Validation.begin, Validation.take]
    answers [Content]

record State
    knowledge: Knowledge.Knowledge
    jobs: Map<String, Work.Job>
    failure: Option<String>

fn fresh() -> State
    ? "No peer content, jobs or local failure."
    State(knowledge = Knowledge.empty(), jobs = {}, failure = Option.None)

verify fresh
    Map.len(fresh().jobs) => 0

fn contribution(peer: Content.Peer) -> Knowledge.Delta
    ? "The peer boundary can construct a body contribution only."
    Knowledge.Delta.Body(peer.hash, peer.bytes)

verify contribution
    contribution(samplePeer()) => Knowledge.Delta.Body(Knowledge.keyOf(Bytes.empty()), Bytes.empty())

fn admitted(peer: Content.Peer) -> Bool
    ? "Admission depends only on the offered content, never the store."
    Knowledge.admit(contribution(peer))

verify admitted
    admitted(samplePeer()) => true
    admitted(Content.Peer(hash = "forged", bytes = Bytes.empty())) => false

fn offer(state: State, first: Content.Peer, second: Content.Peer) -> Tuple<State, Result<Bool, Run.Wake>>
    ? "Hash both offers independently; reject the batch before any merge if either fails."
    match (admitted(first), admitted(second))!
        (true, true) -> (accepted(state, first, second), Result.Ok(true))
        _ -> (state, Result.Ok(false))

verify offer
    offer(fresh(), Content.Peer(hash = "forged", bytes = Bytes.empty()), samplePeer()) => (fresh(), Result.Ok(false))
    offer(fresh(), samplePeer(), samplePeer()) => (accepted(fresh(), samplePeer(), samplePeer()), Result.Ok(true))

verify offer law rejectedBatchChangesNothing
    given state: State = [fresh(), known()]
    given first: Content.Peer = [samplePeer(), Content.Peer(hash = "bad", bytes = Bytes.empty())]
    given second: Content.Peer = [samplePeer(), Content.Peer(hash = "bad", bytes = Bytes.empty())]
    when Bool.not(Bool.and(admitted(first), admitted(second)))
    using []
    offer(state, first, second) => (state, Result.Ok(false))

verify offer law admittedBatchUsesTheModel
    given state: State = [fresh(), known()]
    given first: Content.Peer = [samplePeer()]
    given second: Content.Peer = [samplePeer()]
    when admitted(first)
    when admitted(second)
    using []
    offer(state, first, second) => (accepted(state, first, second), Result.Ok(true))

fn accepted(state: State, first: Content.Peer, second: Content.Peer) -> State
    ? "Merge an admitted batch. Agreement is an explicit cryptographic premise of the merge laws."
    State.update(state, knowledge = Knowledge.mergeAll(state.knowledge, [contribution(first), contribution(second)]))

verify accepted law knowledgeCommutes
    given state: State = [fresh(), known()]
    given first: Content.Peer = [samplePeer()]
    given second: Content.Peer = [samplePeer()]
    when admitted(first)
    when admitted(second)
    when Knowledge.agrees(contribution(first), contribution(second))
    using [Knowledge.mergeAll.orderFree]
    accepted(state, first, second).knowledge => accepted(state, second, first).knowledge

verify accepted law peersCannotWriteVerdicts
    given state: State = [fresh(), known()]
    given first: Content.Peer = [samplePeer()]
    given second: Content.Peer = [samplePeer()]
    using []
    accepted(state, first, second).knowledge.verdicts => state.knowledge.verdicts

fn answer(body: Option<Bytes>, verdict: Option<Knowledge.Verdict>, failure: Option<String>) -> Result<Result<Content.Snapshot, String>, Run.Wake>
    ? "Combine two independent lookups; only successful answers claim stability."
    match body
        Option.None -> missing(failure)
        Option.Some(bytes) -> withBody(bytes, verdict, failure)

verify answer law successfulAnswerHasBothFacts
    given body: Option<Bytes> = [Option.None, Option.Some(Bytes.empty())]
    given verdict: Option<Knowledge.Verdict> = [Option.None, Option.Some(Knowledge.Verdict.Invalid), Option.Some(Knowledge.Verdict.Valid)]
    given failure: Option<String> = [Option.None, Option.Some("failed")]
    given snapshot: Content.Snapshot = [Content.Snapshot(body = Bytes.empty(), valid = false)]
    when successful(answer(body, verdict, failure)) == Option.Some(snapshot)
    because match verdict
        Option.None -> false
        Option.Some(value) -> verdictOf(value == Knowledge.Verdict.Valid) == value
    because match body
        Option.None -> false
        Option.Some(bytes) -> bytes == snapshot.body
    using [verdictOf.roundtrip]
    Bool.and(body == Option.Some(snapshot.body), verdict == Option.Some(verdictOf(snapshot.valid))) holds

verify answer law knownFactsAnswer
    given bytes: Bytes = [Bytes.empty()]
    given valid: Bool = [false, true]
    given failure: Option<String> = [Option.None, Option.Some("failed")]
    using [verdictOf.preservesFlag]
    answer(Option.Some(bytes), Option.Some(verdictOf(valid)), failure) => Result.Ok(Result.Ok(Content.Snapshot(body = bytes, valid = valid)))

fn withBody(bytes: Bytes, verdict: Option<Knowledge.Verdict>, failure: Option<String>) -> Result<Result<Content.Snapshot, String>, Run.Wake>
    ? "A known body still waits for its local verdict."
    match verdict
        Option.None -> missing(failure)
        Option.Some(value) -> Result.Ok(Result.Ok(Content.Snapshot(body = bytes, valid = value == Knowledge.Verdict.Valid)))

verify withBody
    withBody(Bytes.empty(), Option.None, Option.None) => Result.Err(Run.Wake.Settled(Option.None))
    withBody(Bytes.empty(), Option.Some(Knowledge.Verdict.Invalid), Option.None) => Result.Ok(Result.Ok(Content.Snapshot(body = Bytes.empty(), valid = false)))

fn missing(failure: Option<String>) -> Result<Result<Content.Snapshot, String>, Run.Wake>
    ? "Missing knowledge waits for this module's state to move, unless a worker failure ended this attempt."
    match failure
        Option.Some(message) -> Result.Ok(Result.Err(message))
        Option.None -> Result.Err(Run.Wake.Settled(Option.None))

verify missing
    missing(Option.None) => Result.Err(Run.Wake.Settled(Option.None))
    missing(Option.Some("cancelled")) => Result.Ok(Result.Err("cancelled"))

fn read(state: State, hash: String) -> Tuple<State, Result<Result<Content.Snapshot, String>, Run.Wake>>
    ? "The answer to Content.read. A body whose verdict is unknown starts its local validation job here and waits on it; the ask after the job settles takes it and merges the verdict. Everything else is answered from the knowledge alone."
    ! [Validation.begin, Validation.take]
    match Map.get(state.jobs, hash)
        Option.Some(job) -> taken(state, hash, job)
        Option.None -> match unjudged(state, hash)
            Option.None -> lookup(state, hash)
            Option.Some(body) -> begun(state, hash, body)

fn unjudged(state: State, hash: String) -> Option<Bytes>
    ? "The body at this hash when it is known, has no verdict yet, and no worker failure ended this attempt: the one case that needs a validation job."
    match (Knowledge.body(state.knowledge, hash), Knowledge.verdict(state.knowledge, hash, "nonempty-v1"), state.failure)
        (Option.Some(body), Option.None, Option.None) -> Option.Some(body)
        _ -> Option.None

verify unjudged
    unjudged(fresh(), samplePeer().hash) => Option.None
    unjudged(accepted(fresh(), samplePeer(), samplePeer()), samplePeer().hash) => Option.Some(Bytes.empty())
    unjudged(known(), samplePeer().hash) => Option.None

fn begun(state: State, hash: String, body: Bytes) -> Tuple<State, Result<Result<Content.Snapshot, String>, Run.Wake>>
    ? "Begins the validation job of one body and waits on it; a job that could not begin is recorded as the failure it is."
    ! [Validation.begin]
    match Validation.begin(body)
        Result.Err(message) -> lookup(validated(state, Result.Err(message)), hash)
        Result.Ok(job) -> (State.update(state, jobs = Map.set(state.jobs, hash, job)), Result.Err(Run.Wake.Until([Wait.Item.Job(job)], Option.None)))

fn taken(state: State, hash: String, job: Work.Job) -> Tuple<State, Result<Result<Content.Snapshot, String>, Run.Wake>>
    ? "Takes the validation job of one body: still running waits on it again, and an outcome lands through validated before the answer is read from the knowledge."
    ! [Validation.take]
    match Validation.take(job)
        Result.Err(message) -> lookup(validated(State.update(state, jobs = Map.remove(state.jobs, hash)), Result.Err(message)), hash)
        Result.Ok(found) -> match found
            Option.None -> (state, Result.Err(Run.Wake.Until([Wait.Item.Job(job)], Option.None)))
            Option.Some(checked) -> lookup(validated(State.update(state, jobs = Map.remove(state.jobs, hash)), Result.Ok(checked)), hash)

fn lookup(state: State, hash: String) -> Tuple<State, Result<Result<Content.Snapshot, String>, Run.Wake>>
    ? "Read body and verdict independently, then answer from those facts alone."
    match (Knowledge.body(state.knowledge, hash), Knowledge.verdict(state.knowledge, hash, "nonempty-v1"))!
        (body, verdict) -> (state, answer(body, verdict, state.failure))

verify lookup
    lookup(fresh(), samplePeer().hash) => (fresh(), Result.Err(Run.Wake.Settled(Option.None)))
    lookup(known(), samplePeer().hash) => (known(), Result.Ok(Result.Ok(Content.Snapshot(body = Bytes.empty(), valid = false))))
    lookup(State.update(fresh(), failure = Option.Some("cancelled")), samplePeer().hash) => (State.update(fresh(), failure = Option.Some("cancelled")), Result.Ok(Result.Err("cancelled")))

verify lookup law stableAnswer
    given state: State = [known()]
    given hash: String = [samplePeer().hash]
    given snapshot: Content.Snapshot = [Content.Snapshot(body = Bytes.empty(), valid = false)]
    given delta: Knowledge.Delta = [contribution(samplePeer()), Knowledge.Delta.Verdict("other", "nonempty-v1", Knowledge.Verdict.Valid)]
    when observed(state, hash) == Option.Some(snapshot)
    when Knowledge.admit(delta)
    when Knowledge.consistent(state.knowledge, delta)
    because Knowledge.body(state.knowledge, hash) == Option.Some(snapshot.body)
    because Knowledge.verdict(state.knowledge, hash, "nonempty-v1") == Option.Some(verdictOf(snapshot.valid))
    because Knowledge.body(Knowledge.merge(state.knowledge, delta), hash) == Option.Some(snapshot.body)
    because Knowledge.verdict(Knowledge.merge(state.knowledge, delta), hash, "nonempty-v1") == Option.Some(verdictOf(snapshot.valid))
    using [answer.successfulAnswerHasBothFacts, answer.knownFactsAnswer, Knowledge.body.stable, Knowledge.verdict.stable]
    lookup(State.update(state, knowledge = Knowledge.merge(state.knowledge, delta)), hash) => (State.update(state, knowledge = Knowledge.merge(state.knowledge, delta)), Result.Ok(Result.Ok(snapshot)))

verify lookup law stableHistory
    given state: State = [known()]
    given hash: String = [samplePeer().hash]
    given snapshot: Content.Snapshot = [Content.Snapshot(body = Bytes.empty(), valid = false)]
    given deltas: List<Knowledge.Delta> = [[], [contribution(samplePeer())], [contribution(samplePeer()), contribution(samplePeer())]]
    when observed(state, hash) == Option.Some(snapshot)
    when Knowledge.consistentRun(state.knowledge, deltas)
    because Knowledge.body(state.knowledge, hash) == Option.Some(snapshot.body)
    because Knowledge.verdict(state.knowledge, hash, "nonempty-v1") == Option.Some(verdictOf(snapshot.valid))
    because Knowledge.body(Knowledge.mergeAll(state.knowledge, deltas), hash) == Option.Some(snapshot.body)
    because Knowledge.verdict(Knowledge.mergeAll(state.knowledge, deltas), hash, "nonempty-v1") == Option.Some(verdictOf(snapshot.valid))
    using [answer.successfulAnswerHasBothFacts, answer.knownFactsAnswer, Knowledge.body.stableRun, Knowledge.verdict.stableRun]
    lookup(State.update(state, knowledge = Knowledge.mergeAll(state.knowledge, deltas)), hash) => (State.update(state, knowledge = Knowledge.mergeAll(state.knowledge, deltas)), Result.Ok(Result.Ok(snapshot)))

fn validate(task: Bytes) -> Tuple<String, Bool>
    ? "A deliberately small validation rule, not Bitcoin validation: a body is valid exactly when nonempty. Identical bytes always give one verdict in the fixed nonempty-v1 context."
    (Knowledge.keyOf(task), Bytes.len(task) > 0)

verify validate
    validate(Bytes.empty()) => (Knowledge.keyOf(Bytes.empty()), false)
    validate(Bytes.fromList([1])) => (Knowledge.keyOf(Bytes.fromList([1])), true)

fn validated(state: State, outcome: Result<Tuple<String, Bool>, String>) -> State
    ? "Where a local validation job's outcome lands, and the only verdict insertion path; failure changes control state only."
    match outcome
        Result.Err(message) -> State.update(state, failure = Option.Some(message))
        Result.Ok(checked) -> match checked
            (hash, valid) -> State.update(state, knowledge = Knowledge.merge(state.knowledge, Knowledge.Delta.Verdict(hash, "nonempty-v1", verdictOf(valid))))

verify validated
    validated(fresh(), Result.Ok(validate(Bytes.empty()))).knowledge.bodies => fresh().knowledge.bodies
    validated(fresh(), Result.Err("cancelled")) => State.update(fresh(), failure = Option.Some("cancelled"))

verify validated law failedWorkAddsNoKnowledge
    given state: State = [fresh(), known()]
    given message: String = ["cancelled", "worker failed"]
    validated(state, Result.Err(message)).knowledge => state.knowledge

verify validated law workCannotRewriteBodies
    given state: State = [fresh(), known()]
    given outcome: Result<Tuple<String, Bool>, String> = [Result.Err("cancelled"), Result.Ok(validate(Bytes.empty()))]
    using []
    validated(state, outcome).knowledge.bodies => state.knowledge.bodies

fn samplePeer() -> Content.Peer
    ? "A valid empty body for executable examples."
    Content.Peer(hash = Knowledge.keyOf(Bytes.empty()), bytes = Bytes.empty())

verify samplePeer
    admitted(samplePeer()) => true

fn known() -> State
    ? "The empty body after its local validation has landed."
    validated(accepted(fresh(), samplePeer(), samplePeer()), Result.Ok(validate(Bytes.empty())))

verify known
    observed(known(), samplePeer().hash) => Option.Some(Content.Snapshot(body = Bytes.empty(), valid = false))

fn verdictOf(valid: Bool) -> Knowledge.Verdict
    ? "Translate the capability-owned Boolean wire result to the internal model's verdict."
    match valid
        true -> Knowledge.Verdict.Valid
        false -> Knowledge.Verdict.Invalid

verify verdictOf
    verdictOf(true) => Knowledge.Verdict.Valid
    verdictOf(false) => Knowledge.Verdict.Invalid

verify verdictOf law roundtrip
    given value: Knowledge.Verdict = [Knowledge.Verdict.Valid, Knowledge.Verdict.Invalid]
    because match value
        Knowledge.Verdict.Valid -> verdictOf(true) == value
        Knowledge.Verdict.Invalid -> verdictOf(false) == value
    verdictOf(value == Knowledge.Verdict.Valid) => value

verify verdictOf law preservesFlag
    given valid: Bool = [true, false]
    (verdictOf(valid) == Knowledge.Verdict.Valid) => valid

fn successful(reply: Result<Result<Content.Snapshot, String>, Run.Wake>) -> Option<Content.Snapshot>
    ? "Exactly the successful Ok payload; a parked request and failures have no settled successful answer. Wake handles are never compared."
    match reply
        Result.Ok(result) -> okSnapshot(result)
        _ -> Option.None

verify successful
    successful(Result.Err(Run.Wake.Settled(Option.None))) => Option.None
    successful(Result.Ok(Result.Err("failed"))) => Option.None
    successful(Result.Ok(Result.Ok(Content.Snapshot(body = Bytes.empty(), valid = false)))) => Option.Some(Content.Snapshot(body = Bytes.empty(), valid = false))

fn observed(state: State, hash: String) -> Option<Content.Snapshot>
    ? "Project the successful answer the knowledge alone gives, which is what Content.read answers once no validation is left to run."
    match lookup(state, hash)
        (_, reply) -> successful(reply)

verify observed
    observed(fresh(), samplePeer().hash) => Option.None
    observed(known(), samplePeer().hash) => Option.Some(Content.Snapshot(body = Bytes.empty(), valid = false))

fn okSnapshot(result: Result<Content.Snapshot, String>) -> Option<Content.Snapshot>
    ? "The successful payload of one settled result."
    match result
        Result.Ok(snapshot) -> Option.Some(snapshot)
        Result.Err(_) -> Option.None

verify okSnapshot
    okSnapshot(Result.Err("cancelled")) => Option.None
    okSnapshot(Result.Ok(Content.Snapshot(body = Bytes.empty(), valid = false))) => Option.Some(Content.Snapshot(body = Bytes.empty(), valid = false))
