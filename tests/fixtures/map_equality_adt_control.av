module MapEqualityAdtControl
    intent =
        "An ordinary record compared with == inside a function whose call cone also touches a map the exporter cannot see the key type of."
        "The comparison has nothing to do with a map, and the map is only MEASURED — never iterated, never compared — so neither gate has anything to say and the law must keep exporting. Over-refusing a provable law is as bad as exporting an unprovable one, because either way --check is green and the user believes something untrue."
    effects []

record Point
    x: Int
    y: Int

fn builtMapSize(v: Int) -> Int
    ? "Measures a map built in place. Order-blind, never compared, and nothing here says what it is keyed on."
    Map.len(Map.set({}, "a", v))

fn samePoint(p: Point, q: Point, v: Int) -> Bool
    ? "Compares two points; the map is only measured."
    match builtMapSize(v)
        0 -> p == q
        _ -> p == q

verify samePoint law reflexive
    given p: Point = [Point(x = 1, y = 2), Point(x = 0, y = 0)]
    given v: Int = [1]
    samePoint(p, p, v) => true
