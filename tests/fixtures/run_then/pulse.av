module Pulse
    kind = capability
    semantics = effectful
    intent = "Replies carrying a value and Unit through the same wake gate."
    exposes [NextReply, DoneReply, next, done]

type NextReply
    Now(Int)
    Later(Wait.Wake)
    Then(Wait.Wake, Int)

type DoneReply
    Now(Unit)
    Later(Wait.Wake)
    Then(Wait.Wake, Unit)

operation next(base: Int) -> Int
    ? "The next answer, held until its wake."
    oracle = generative
    replay = recorded

operation done() -> Unit
    ? "A Unit answer held until the next turn."
    oracle = generative
    replay = recorded
