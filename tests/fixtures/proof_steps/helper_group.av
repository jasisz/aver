module HelperGroup
    intent =
        "Two recursions through a large group of helpers, each helper calling the next four ways:"
        "one also through a pair of helpers that call each other without it, one through the"
        "chain alone. Reading every path of calls through the group would never end; steps"
        "refuse each recursion with the reason and the laws stay open."
    exposes [walk, total]
    effects []

fn walk(xs: List<Int>) -> Int
    ? "The items, each counted again through the chain and the pair."
    match xs
        [] -> 0
        [h, ..t] -> h + a1(t, 0) + spin(t, 1)

verify walk law nonNegative
    given a: Int = [0, 1, 5]
    given b: Int = [2, 7]
    walk([a, b]) >= 0 => true

fn spin(xs: List<Int>, n: Int) -> Int
    ? "Back to walk once n reaches zero, through spinBack before."
    match n <= 0
        true -> walk(xs)
        false -> spinBack(xs, n - 1)

fn spinBack(xs: List<Int>, n: Int) -> Int
    ? "Calls spin again: a pair of helpers that call each other without walk."
    spin(xs, n)

fn a1(xs: List<Int>, k: Int) -> Int
    ? "Step 1 of the chain back to walk."
    match k
        0 -> a2(xs, k)
        1 -> a2(xs, k)
        2 -> a2(xs, k)
        _ -> a2(xs, k)

fn a2(xs: List<Int>, k: Int) -> Int
    ? "Step 2 of the chain back to walk."
    match k
        0 -> a3(xs, k)
        1 -> a3(xs, k)
        2 -> a3(xs, k)
        _ -> a3(xs, k)

fn a3(xs: List<Int>, k: Int) -> Int
    ? "Step 3 of the chain back to walk."
    match k
        0 -> a4(xs, k)
        1 -> a4(xs, k)
        2 -> a4(xs, k)
        _ -> a4(xs, k)

