module Prop39
    intent =
        "TIP isaplanner prop_39: +2(count(n, [x]), count(n, xs)) = count(n, cons(x, xs))."
    effects []

type Nat
    Z
    S(Nat)

fn eq(x: Nat, y: Nat) -> Bool
    match x
        Nat.Z -> match y
            Nat.Z -> true
            Nat.S(z) -> false
        Nat.S(x2) -> match y
            Nat.Z -> false
            Nat.S(y2) -> eq(x2, y2)

fn count(x: Nat, y: List<Nat>) -> Nat
    match y
        [] -> Nat.Z
        [z, ..ys] -> match eq(x, z)
            true -> Nat.S(count(x, ys))
            false -> count(x, ys)

fn plus(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> y
        Nat.S(z) -> Nat.S(plus(z, y))

verify count law countConsSplit
    given n: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.Z]
    given xs: List<Nat> = [[], [Nat.Z], [Nat.S(Nat.Z), Nat.Z]]
    plus(count(n, [x]), count(n, xs)) => count(n, List.concat([x], xs))
