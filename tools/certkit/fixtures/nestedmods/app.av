module NestedMods
    intent =
        "Certification probe whose model tree carries a nested module"
        "dependency, so the emitted certificate stages a dotted model root."
    exposes [addTwo, viaDep]
    depends [Nested.Deep.Util]
    effects []

fn addTwo(n: Int) -> Int
    ? "Adds two to an integer."
    n + 2

fn viaDep(n: Int) -> Int
    ? "Delegates to the nested dependency module."
    Nested.Deep.Util.combine(n, 0)

verify addTwo
    addTwo(1) => 3

verify viaDep
    viaDep(1) => 3
