module Eval
    depends [Domain.Ast, Domain.Value, Domain.Eval.Store, Domain.Eval.Core]
    intent =
        "Facade module for the self-hosted evaluator."
        "Keeps public entry points stable while the implementation lives in smaller submodules under Domain.Eval."
    exposes [evalProgram, evalProgramWithFns, callResolved]

fn evalProgram(prog: Program) -> Result<Val, String>
    ? "Evaluate a complete program through the self-hosted evaluator."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    Domain.Eval.Core.evalProgram(prog)

fn evalProgramWithFns(prog: Program, extraFns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate a program with additional loaded module functions."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    Domain.Eval.Core.evalProgramWithFns(prog, extraFns)

fn callResolved(fd: FnDef, args: List<Val>, fns: FnStore) -> Result<Val, String>
    ? "Stable facade for calling an already-resolved self-hosted function."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    Domain.Eval.Core.callResolved(fd, args, fns)
