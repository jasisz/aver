module Primitives
    depends [Domain.Value, Domain.Builtins.Helpers]
    intent = "Int, String, Float, and Char namespace builtins."
    exposes [callInt, callString, callFloat, callChar]
    effects []

fn callInt(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch Int.* builtins."
    match name
        "String.fromInt" -> builtinIntToString(args)
        "Float.fromInt" -> builtinIntToFloat(args)
        "Int.fromString" -> builtinIntFromString(args)
        "Int.abs" -> builtinIntAbs(args)
        "Int.mod" -> builtinIntMod(args)
        "Int.div" -> builtinIntDiv(args)
        "Int.max" -> builtinIntMax(args)
        "Int.min" -> builtinIntMin(args)
        _ -> Result.Err("unknown int builtin: {name}")

verify callInt
    callInt("Int.abs", [Val.ValInt(5)]) => Result.Ok(Val.ValInt(5))
    callInt("String.fromInt", [Val.ValInt(42)]) => Result.Ok(Val.ValStr("42"))
    callInt("Int.bogus", [Val.ValInt(1)]) => Result.Err("unknown int builtin: Int.bogus")

fn builtinIntMax(args: List<Val>) -> Result<Val, String>
    ? "Int.max(a, b) -> larger of a and b."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (aV, bV) -> builtinIntMaxInner(aV, bV)

verify builtinIntMax
    builtinIntMax([Val.ValInt(3), Val.ValInt(7)]) => Result.Ok(Val.ValInt(7))
    builtinIntMax([Val.ValInt(1)]) => Result.Err("expected 2 arguments")

fn builtinIntMaxInner(aV: Val, bV: Val) -> Result<Val, String>
    ? "Inner Int.max."
    a = Domain.Builtins.Helpers.expectInt(aV)?
    b = Domain.Builtins.Helpers.expectInt(bV)?
    match a > b
        true -> Result.Ok(Val.ValInt(a))
        false -> Result.Ok(Val.ValInt(b))

verify builtinIntMaxInner
    builtinIntMaxInner(Val.ValInt(3), Val.ValInt(7)) => Result.Ok(Val.ValInt(7))
    builtinIntMaxInner(Val.ValInt(10), Val.ValInt(2)) => Result.Ok(Val.ValInt(10))
    builtinIntMaxInner(Val.ValStr("x"), Val.ValInt(2)) => Result.Err("expected int argument")

fn builtinIntMin(args: List<Val>) -> Result<Val, String>
    ? "Int.min(a, b) -> smaller of a and b."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (aV, bV) -> builtinIntMinInner(aV, bV)

verify builtinIntMin
    builtinIntMin([Val.ValInt(3), Val.ValInt(7)]) => Result.Ok(Val.ValInt(3))
    builtinIntMin([Val.ValInt(1)]) => Result.Err("expected 2 arguments")

fn builtinIntMinInner(aV: Val, bV: Val) -> Result<Val, String>
    ? "Inner Int.min."
    a = Domain.Builtins.Helpers.expectInt(aV)?
    b = Domain.Builtins.Helpers.expectInt(bV)?
    match a < b
        true -> Result.Ok(Val.ValInt(a))
        false -> Result.Ok(Val.ValInt(b))

verify builtinIntMinInner
    builtinIntMinInner(Val.ValInt(3), Val.ValInt(7)) => Result.Ok(Val.ValInt(3))
    builtinIntMinInner(Val.ValInt(10), Val.ValInt(2)) => Result.Ok(Val.ValInt(2))
    builtinIntMinInner(Val.ValStr("x"), Val.ValInt(2)) => Result.Err("expected int argument")

fn callString(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch String.* builtins."
    match name
        "String.len" -> builtinStringLen(args)
        "String.charAt" -> builtinStringCharAt(args)
        "String.chars" -> builtinStringChars(args)
        "String.join" -> builtinStringJoin(args)
        "String.slice" -> builtinStringSlice(args)
        "String.fromBool" -> builtinStringFromBool(args)
        "String.fromInt" -> builtinStringFromInt(args)
        "String.fromFloat" -> builtinStringFromFloat(args)
        "String.contains" -> builtinStringContains(args)
        "String.startsWith" -> builtinStringStartsWith(args)
        "String.toLower" -> builtinStringToLower(args)
        "String.toUpper" -> builtinStringToUpper(args)
        "String.trim" -> builtinStringTrim(args)
        "String.endsWith" -> builtinStringEndsWith(args)
        "String.split" -> builtinStringSplit(args)
        "String.repeat" -> builtinStringRepeat(args)
        "String.replace" -> builtinStringReplaceAll(args)
        _ -> Result.Err("unknown string builtin: {name}")

verify callString
    callString("String.len", [Val.ValStr("hello")]) => Result.Ok(Val.ValInt(5))
    callString("String.bogus", [Val.ValStr("x")]) => Result.Err("unknown string builtin: String.bogus")

fn callChar(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch Char.* builtins."
    match name
        "Char.fromCode" -> builtinCharFromCode(args)
        "Char.toCode" -> builtinCharToCode(args)
        _ -> Result.Err("unknown char builtin: {name}")

verify callChar
    callChar("Char.fromCode", [Val.ValInt(65)]) => Result.Ok(Val.ValSome(Val.ValStr("A")))
    callChar("Char.bogus", [Val.ValInt(1)]) => Result.Err("unknown char builtin: Char.bogus")

fn builtinIntToFloat(args: List<Val>) -> Result<Val, String>
    ? "Float.fromInt(n) -> Float value."
    v = Domain.Builtins.Helpers.oneArg(args)?
    n = Domain.Builtins.Helpers.expectInt(v)?
    Result.Ok(Val.ValFloat(Float.fromInt(n)))

verify builtinIntToFloat
    builtinIntToFloat([Val.ValInt(3)]) => Result.Ok(Val.ValFloat(3.0))
    builtinIntToFloat([Val.ValStr("x")]) => Result.Err("expected int argument")

fn builtinIntToString(args: List<Val>) -> Result<Val, String>
    ? "String.fromInt(n) -> string representation."
    v = Domain.Builtins.Helpers.oneArg(args)?
    n = Domain.Builtins.Helpers.expectInt(v)?
    Result.Ok(Val.ValStr(String.fromInt(n)))

verify builtinIntToString
    builtinIntToString([Val.ValInt(42)]) => Result.Ok(Val.ValStr("42"))
    builtinIntToString([Val.ValStr("x")]) => Result.Err("expected int argument")

fn builtinIntAbs(args: List<Val>) -> Result<Val, String>
    ? "Int.abs(n) -> absolute value."
    v = Domain.Builtins.Helpers.oneArg(args)?
    n = Domain.Builtins.Helpers.expectInt(v)?
    Result.Ok(Val.ValInt(Int.abs(n)))

verify builtinIntAbs
    builtinIntAbs([Val.ValInt(5)]) => Result.Ok(Val.ValInt(5))
    builtinIntAbs([Val.ValStr("x")]) => Result.Err("expected int argument")

fn builtinIntMod(args: List<Val>) -> Result<Val, String>
    ? "Int.mod(a, b) -> a mod b as Result."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (aV, bV) -> builtinIntModInner(aV, bV)

verify builtinIntMod
    builtinIntMod([Val.ValInt(7), Val.ValInt(3)]) => Result.Ok(Val.ValOk(Val.ValInt(1)))
    builtinIntMod([Val.ValInt(1)]) => Result.Err("expected 2 arguments")

fn builtinIntModInner(aV: Val, bV: Val) -> Result<Val, String>
    ? "Inner impl of Int.mod."
    a = Domain.Builtins.Helpers.expectInt(aV)?
    b = Domain.Builtins.Helpers.expectInt(bV)?
    match b == 0
        true -> Result.Ok(Val.ValErr(Val.ValStr("modulo by zero")))
        false -> Result.Ok(Val.ValOk(Val.ValInt(Result.withDefault(Int.mod(a, b), 0))))

verify builtinIntModInner
    builtinIntModInner(Val.ValInt(7), Val.ValInt(3)) => Result.Ok(Val.ValOk(Val.ValInt(1)))
    builtinIntModInner(Val.ValInt(5), Val.ValInt(0)) => Result.Ok(Val.ValErr(Val.ValStr("modulo by zero")))
    builtinIntModInner(Val.ValStr("x"), Val.ValInt(3)) => Result.Err("expected int argument")

fn builtinIntDiv(args: List<Val>) -> Result<Val, String>
    ? "Int.div(a, b) -> a div b as a Result value."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (aV, bV) -> builtinIntDivInner(aV, bV)

verify builtinIntDiv
    builtinIntDiv([Val.ValInt(7), Val.ValInt(2)]) => Result.Ok(Val.ValOk(Val.ValInt(3)))
    builtinIntDiv([Val.ValInt(1)]) => Result.Err("expected 2 arguments")

fn builtinIntDivInner(aV: Val, bV: Val) -> Result<Val, String>
    ? "Inner impl of Int.div — Euclidean, Err on zero divisor or overflow."
    a = Domain.Builtins.Helpers.expectInt(aV)?
    b = Domain.Builtins.Helpers.expectInt(bV)?
    match Int.div(a, b)
        Result.Ok(q)  -> Result.Ok(Val.ValOk(Val.ValInt(q)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

verify builtinIntDivInner
    builtinIntDivInner(Val.ValInt(7), Val.ValInt(2)) => Result.Ok(Val.ValOk(Val.ValInt(3)))
    builtinIntDivInner(Val.ValInt(5), Val.ValInt(0)) => Result.Ok(Val.ValErr(Val.ValStr("division by zero")))
    builtinIntDivInner(Val.ValStr("x"), Val.ValInt(3)) => Result.Err("expected int argument")

fn builtinStringLen(args: List<Val>) -> Result<Val, String>
    ? "String.len(s) -> length as Int."
    v = Domain.Builtins.Helpers.oneArg(args)?
    s = Domain.Builtins.Helpers.expectStr(v)?
    Result.Ok(Val.ValInt(String.len(s)))

verify builtinStringLen
    builtinStringLen([Val.ValStr("hello")]) => Result.Ok(Val.ValInt(5))
    builtinStringLen([Val.ValInt(1)]) => Result.Err("expected string argument")

fn builtinStringCharAt(args: List<Val>) -> Result<Val, String>
    ? "String.charAt(s, index) -> single character string or error."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (sV, idxV) -> builtinStringCharAtInner(sV, idxV)

verify builtinStringCharAt
    builtinStringCharAt([Val.ValStr("abc"), Val.ValInt(1)]) => Result.Ok(Val.ValStr("b"))
    builtinStringCharAt([Val.ValStr("a")]) => Result.Err("expected 2 arguments")

fn builtinStringCharAtInner(sV: Val, idxV: Val) -> Result<Val, String>
    ? "Inner impl of String.charAt."
    s = Domain.Builtins.Helpers.expectStr(sV)?
    idx = Domain.Builtins.Helpers.expectInt(idxV)?
    match String.charAt(s, idx)
        Option.Some(c) -> Result.Ok(Val.ValSome(Val.ValStr(c)))
        Option.None -> Result.Ok(Val.ValNone)

verify builtinStringCharAtInner
    builtinStringCharAtInner(Val.ValStr("abc"), Val.ValInt(0)) => Result.Ok(Val.ValStr("a"))
    builtinStringCharAtInner(Val.ValInt(1), Val.ValInt(0)) => Result.Err("expected string argument")

fn builtinStringJoin(args: List<Val>) -> Result<Val, String>
    ? "String.join(list, separator) -> joined string."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (lstV, sepV) -> builtinStringJoinInner(lstV, sepV)

verify builtinStringJoin
    builtinStringJoin([Val.ValList([Val.ValStr("a"), Val.ValStr("b")]), Val.ValStr(",")]) => Result.Ok(Val.ValStr("a,b"))
    builtinStringJoin([Val.ValStr("a")]) => Result.Err("expected 2 arguments")

fn builtinStringJoinInner(lstV: Val, sepV: Val) -> Result<Val, String>
    ? "Inner impl of String.join."
    items = Domain.Builtins.Helpers.expectList(lstV)?
    sep = Domain.Builtins.Helpers.expectStr(sepV)?
    strs = extractStrings(items, [])?
    Result.Ok(Val.ValStr(String.join(strs, sep)))

verify builtinStringJoinInner
    builtinStringJoinInner(Val.ValList([Val.ValStr("x"), Val.ValStr("y")]), Val.ValStr("-")) => Result.Ok(Val.ValStr("x-y"))
    builtinStringJoinInner(Val.ValInt(1), Val.ValStr("-")) => Result.Err("expected list argument")

fn extractStrings(items: List<Val>, acc: List<String>) -> Result<List<String>, String>
    ? "Convert list of ValStr to list of String."
    match items
        [] -> Result.Ok(List.reverse(acc))
        [v, ..rest] -> match v
            Val.ValStr(s) -> extractStrings(rest, List.prepend(s, acc))
            _ -> Result.Err("String.join requires list of strings")

verify extractStrings
    extractStrings([Val.ValStr("a"), Val.ValStr("b")], []) => Result.Ok(["a", "b"])
    extractStrings([], []) => Result.Ok([])
    extractStrings([Val.ValInt(1)], []) => Result.Err("String.join requires list of strings")

fn builtinStringSlice(args: List<Val>) -> Result<Val, String>
    ? "String.slice(s, start, end) -> substring."
    match args
        [sV, ..rest] -> match rest
            [startV, ..rest2] -> match rest2
                [endV, ..rest3] -> match rest3
                    [] -> builtinStringSliceInner(sV, startV, endV)
                    _ -> Result.Err("String.slice takes 3 arguments")
                _ -> Result.Err("String.slice takes 3 arguments")
            _ -> Result.Err("String.slice takes 3 arguments")
        _ -> Result.Err("String.slice takes 3 arguments")

verify builtinStringSlice
    builtinStringSlice([Val.ValStr("hello"), Val.ValInt(1), Val.ValInt(3)]) => Result.Ok(Val.ValStr("el"))
    builtinStringSlice([]) => Result.Err("String.slice takes 3 arguments")

fn builtinStringSliceInner(sV: Val, startV: Val, endV: Val) -> Result<Val, String>
    ? "Inner impl of String.slice."
    s = Domain.Builtins.Helpers.expectStr(sV)?
    start = Domain.Builtins.Helpers.expectInt(startV)?
    end = Domain.Builtins.Helpers.expectInt(endV)?
    Result.Ok(Val.ValStr(String.slice(s, start, end)))

verify builtinStringSliceInner
    builtinStringSliceInner(Val.ValStr("hello"), Val.ValInt(0), Val.ValInt(2)) => Result.Ok(Val.ValStr("he"))
    builtinStringSliceInner(Val.ValInt(1), Val.ValInt(0), Val.ValInt(2)) => Result.Err("expected string argument")

fn builtinStringFromBool(args: List<Val>) -> Result<Val, String>
    ? "String.fromBool(b) -> string."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValBool(b) -> Result.Ok(Val.ValStr(String.fromBool(b)))
        _ -> Result.Err("String.fromBool requires Bool")

verify builtinStringFromBool
    builtinStringFromBool([Val.ValBool(true)]) => Result.Ok(Val.ValStr("true"))
    builtinStringFromBool([Val.ValInt(1)]) => Result.Err("String.fromBool requires Bool")

fn builtinStringFromInt(args: List<Val>) -> Result<Val, String>
    ? "String.fromInt(n) -> string (alias for String.fromInt)."
    v = Domain.Builtins.Helpers.oneArg(args)?
    n = Domain.Builtins.Helpers.expectInt(v)?
    Result.Ok(Val.ValStr(String.fromInt(n)))

verify builtinStringFromInt
    builtinStringFromInt([Val.ValInt(99)]) => Result.Ok(Val.ValStr("99"))
    builtinStringFromInt([Val.ValStr("x")]) => Result.Err("expected int argument")

fn builtinStringFromFloat(args: List<Val>) -> Result<Val, String>
    ? "String.fromFloat(f) -> string."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValFloat(f) -> Result.Ok(Val.ValStr(String.fromFloat(f)))
        _ -> Result.Err("String.fromFloat requires Float")

verify builtinStringFromFloat
    builtinStringFromFloat([Val.ValFloat(3.14)]) => Result.Ok(Val.ValStr("3.14"))
    builtinStringFromFloat([Val.ValInt(1)]) => Result.Err("String.fromFloat requires Float")

fn builtinStringContains(args: List<Val>) -> Result<Val, String>
    ? "String.contains(haystack, needle) -> Bool."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (hV, nV) -> builtinStringContainsInner(hV, nV)

verify builtinStringContains
    builtinStringContains([Val.ValStr("hello world"), Val.ValStr("world")]) => Result.Ok(Val.ValBool(true))
    builtinStringContains([Val.ValStr("a")]) => Result.Err("expected 2 arguments")

fn builtinStringContainsInner(hV: Val, nV: Val) -> Result<Val, String>
    ? "Inner impl of String.contains."
    h = Domain.Builtins.Helpers.expectStr(hV)?
    n = Domain.Builtins.Helpers.expectStr(nV)?
    Result.Ok(Val.ValBool(String.contains(h, n)))

verify builtinStringContainsInner
    builtinStringContainsInner(Val.ValStr("abc"), Val.ValStr("b")) => Result.Ok(Val.ValBool(true))
    builtinStringContainsInner(Val.ValStr("abc"), Val.ValStr("z")) => Result.Ok(Val.ValBool(false))
    builtinStringContainsInner(Val.ValInt(1), Val.ValStr("b")) => Result.Err("expected string argument")

fn builtinStringStartsWith(args: List<Val>) -> Result<Val, String>
    ? "String.startsWith(s, prefix) -> Bool."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (sV, pV) -> builtinStringStartsWithInner(sV, pV)

verify builtinStringStartsWith
    builtinStringStartsWith([Val.ValStr("hello"), Val.ValStr("he")]) => Result.Ok(Val.ValBool(true))
    builtinStringStartsWith([Val.ValStr("a")]) => Result.Err("expected 2 arguments")

fn builtinStringStartsWithInner(sV: Val, pV: Val) -> Result<Val, String>
    ? "Inner impl of String.startsWith."
    s = Domain.Builtins.Helpers.expectStr(sV)?
    p = Domain.Builtins.Helpers.expectStr(pV)?
    Result.Ok(Val.ValBool(String.startsWith(s, p)))

verify builtinStringStartsWithInner
    builtinStringStartsWithInner(Val.ValStr("hello"), Val.ValStr("he")) => Result.Ok(Val.ValBool(true))
    builtinStringStartsWithInner(Val.ValStr("hello"), Val.ValStr("xx")) => Result.Ok(Val.ValBool(false))
    builtinStringStartsWithInner(Val.ValInt(1), Val.ValStr("he")) => Result.Err("expected string argument")

fn builtinStringToLower(args: List<Val>) -> Result<Val, String>
    ? "String.toLower(s) -> lowercase string."
    v = Domain.Builtins.Helpers.oneArg(args)?
    s = Domain.Builtins.Helpers.expectStr(v)?
    Result.Ok(Val.ValStr(String.toLower(s)))

verify builtinStringToLower
    builtinStringToLower([Val.ValStr("HELLO")]) => Result.Ok(Val.ValStr("hello"))
    builtinStringToLower([Val.ValInt(1)]) => Result.Err("expected string argument")

fn builtinCharFromCode(args: List<Val>) -> Result<Val, String>
    ? "Char.fromCode(n) -> single character string."
    v = Domain.Builtins.Helpers.oneArg(args)?
    n = Domain.Builtins.Helpers.expectInt(v)?
    match Char.fromCode(n)
        Option.Some(c) -> Result.Ok(Val.ValSome(Val.ValStr(c)))
        Option.None -> Result.Ok(Val.ValNone)

verify builtinCharFromCode
    builtinCharFromCode([Val.ValInt(65)]) => Result.Ok(Val.ValSome(Val.ValStr("A")))
    builtinCharFromCode([Val.ValStr("x")]) => Result.Err("expected int argument")

fn builtinCharToCode(args: List<Val>) -> Result<Val, String>
    ? "Char.toCode(c) -> Int code point."
    v = Domain.Builtins.Helpers.oneArg(args)?
    s = Domain.Builtins.Helpers.expectStr(v)?
    Result.Ok(Val.ValInt(Char.toCode(s)))

verify builtinCharToCode
    builtinCharToCode([Val.ValStr("A")]) => Result.Ok(Val.ValInt(65))
    builtinCharToCode([Val.ValStr("0")]) => Result.Ok(Val.ValInt(48))
    builtinCharToCode([Val.ValInt(1)]) => Result.Err("expected string argument")

fn builtinIntFromString(args: List<Val>) -> Result<Val, String>
    ? "Int.fromString(s) -> Result<Int, String>."
    v = Domain.Builtins.Helpers.oneArg(args)?
    s = Domain.Builtins.Helpers.expectStr(v)?
    match Int.fromString(s)
        Result.Ok(n) -> Result.Ok(Val.ValOk(Val.ValInt(n)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

verify builtinIntFromString
    builtinIntFromString([Val.ValStr("42")]) => Result.Ok(Val.ValOk(Val.ValInt(42)))
    builtinIntFromString([Val.ValInt(1)]) => Result.Err("expected string argument")

fn builtinStringChars(args: List<Val>) -> Result<Val, String>
    ? "String.chars(s) -> list of single-character strings."
    v = Domain.Builtins.Helpers.oneArg(args)?
    s = Domain.Builtins.Helpers.expectStr(v)?
    Result.Ok(Val.ValList(stringToCharList(s, 0, String.len(s), [])))

verify builtinStringChars
    builtinStringChars([Val.ValStr("hi")]) => Result.Ok(Val.ValList([Val.ValStr("h"), Val.ValStr("i")]))
    builtinStringChars([Val.ValStr("")]) => Result.Ok(Val.ValList([]))
    builtinStringChars([Val.ValInt(1)]) => Result.Err("expected string argument")

fn stringToCharList(s: String, pos: Int, total: Int, acc: List<Val>) -> List<Val>
    ? "Split string into list of ValStr chars."
    reversed = List.reverse(acc)
    match pos >= total
        true -> reversed
        false -> match String.charAt(s, pos)
            Option.Some(c) -> stringToCharList(s, pos + 1, total, List.prepend(Val.ValStr(c), acc))
            Option.None -> reversed

verify stringToCharList
    stringToCharList("ab", 0, 2, []) => [Val.ValStr("a"), Val.ValStr("b")]
    stringToCharList("", 0, 0, []) => []

fn callFloat(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch Float.* builtins."
    match name
        "String.fromFloat" -> builtinFloatToString(args)
        "Float.fromInt" -> builtinFloatFromInt(args)
        "Float.round" -> builtinFloatRound(args)
        "Float.fromString" -> builtinFloatFromString(args)
        "Float.abs" -> builtinFloatAbs(args)
        "Float.floor" -> builtinFloatFloor(args)
        "Float.ceil" -> builtinFloatCeil(args)
        "Float.min" -> builtinFloatMin(args)
        "Float.max" -> builtinFloatMax(args)
        "Float.sin" -> builtinFloatSin(args)
        "Float.cos" -> builtinFloatCos(args)
        "Float.sqrt" -> builtinFloatSqrt(args)
        "Float.pow" -> builtinFloatPow(args)
        "Float.atan2" -> builtinFloatAtan2(args)
        "Float.pi" -> builtinFloatPi(args)
        _ -> Result.Err("unknown float builtin: {name}")

verify callFloat
    callFloat("String.fromFloat", [Val.ValFloat(3.14)]) => Result.Ok(Val.ValStr("3.14"))
    callFloat("Float.bogus", [Val.ValFloat(1.0)]) => Result.Err("unknown float builtin: Float.bogus")

fn builtinFloatFromString(args: List<Val>) -> Result<Val, String>
    ? "Float.fromString(s) -> Result<Float, String>."
    v = Domain.Builtins.Helpers.oneArg(args)?
    s = Domain.Builtins.Helpers.expectStr(v)?
    match Float.fromString(s)
        Result.Ok(f) -> Result.Ok(Val.ValOk(Val.ValFloat(f)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

verify builtinFloatFromString
    builtinFloatFromString([Val.ValStr("3.14")]) => Result.Ok(Val.ValOk(Val.ValFloat(3.14)))
    builtinFloatFromString([Val.ValInt(1)]) => Result.Err("expected string argument")

fn builtinFloatFromInt(args: List<Val>) -> Result<Val, String>
    ? "Float.fromInt(n) -> Float."
    v = Domain.Builtins.Helpers.oneArg(args)?
    n = Domain.Builtins.Helpers.expectInt(v)?
    Result.Ok(Val.ValFloat(Float.fromInt(n)))

verify builtinFloatFromInt
    builtinFloatFromInt([Val.ValInt(5)]) => Result.Ok(Val.ValFloat(5.0))
    builtinFloatFromInt([Val.ValStr("x")]) => Result.Err("expected int argument")

fn builtinFloatRound(args: List<Val>) -> Result<Val, String>
    ? "Float.round(f) -> Int."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValFloat(f) -> Result.Ok(Val.ValInt(Float.round(f)))
        _ -> Result.Err("Float.round requires Float")

verify builtinFloatRound
    builtinFloatRound([Val.ValFloat(2.7)]) => Result.Ok(Val.ValInt(3))
    builtinFloatRound([Val.ValInt(1)]) => Result.Err("Float.round requires Float")

fn builtinFloatToString(args: List<Val>) -> Result<Val, String>
    ? "String.fromFloat(f) -> string representation."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValFloat(f) -> Result.Ok(Val.ValStr(String.fromFloat(f)))
        _ -> Result.Err("String.fromFloat requires Float")

verify builtinFloatToString
    builtinFloatToString([Val.ValFloat(3.14)]) => Result.Ok(Val.ValStr("3.14"))
    builtinFloatToString([Val.ValInt(1)]) => Result.Err("String.fromFloat requires Float")

fn builtinFloatAbs(args: List<Val>) -> Result<Val, String>
    ? "Float.abs(f) -> Float."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValFloat(f) -> Result.Ok(Val.ValFloat(Float.abs(f)))
        _ -> Result.Err("Float.abs requires Float")

verify builtinFloatAbs
    builtinFloatAbs([Val.ValFloat(-3.5)]) => Result.Ok(Val.ValFloat(3.5))
    builtinFloatAbs([Val.ValInt(1)]) => Result.Err("Float.abs requires Float")

fn builtinFloatFloor(args: List<Val>) -> Result<Val, String>
    ? "Float.floor(f) -> Int."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValFloat(f) -> Result.Ok(Val.ValInt(Float.floor(f)))
        _ -> Result.Err("Float.floor requires Float")

verify builtinFloatFloor
    builtinFloatFloor([Val.ValFloat(2.7)]) => Result.Ok(Val.ValInt(2))
    builtinFloatFloor([Val.ValInt(1)]) => Result.Err("Float.floor requires Float")

