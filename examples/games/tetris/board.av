module Board
    intent =
        "Board representation and manipulation for Tetris."
        "Immutable 2D grid as List<List<Option<PieceKind>>>, with cell access,"
        "line clearing, and row counting."
    depends []

type PieceKind
    I
    O
    T
    S
    Z
    J
    L

record Point
    x: Int
    y: Int

fn pt(x: Int, y: Int) -> Point
    ? "Shorthand Point constructor"
    Point(x = x, y = y)

verify pt
    pt(3, 4).x => 3
    pt(3, 4).y => 4

fn emptyRow() -> List<Option<PieceKind>>
    ? "A row of 10 Nones"
    [Option.None, Option.None, Option.None, Option.None, Option.None, Option.None, Option.None, Option.None, Option.None, Option.None]

verify emptyRow
    List.len(emptyRow()) => 10

fn buildBoard(n: Int) -> List<List<Option<PieceKind>>>
    ? "Build n empty rows"
    match n == 0
        true -> []
        false -> List.prepend(emptyRow(), buildBoard(n - 1))

verify buildBoard
    List.len(buildBoard(3)) => 3

fn emptyBoard() -> List<List<Option<PieceKind>>>
    ? "Standard 20-row empty board"
    buildBoard(20)

verify emptyBoard
    List.len(emptyBoard()) => 20

fn getCell(board: List<List<Option<PieceKind>>>, x: Int, y: Int) -> Option<PieceKind>
    ? "Get cell value at (x,y), Option.None if out of bounds"
    match List.get(board, y)
        Option.Some(row) -> match List.get(row, x)
            Option.Some(v) -> v
            Option.None -> Option.None
        Option.None -> Option.None

verify getCell
    getCell(emptyBoard(), 0, 0) => Option.None
    getCell(emptyBoard(), 9, 19) => Option.None

fn setCellCols(r: List<Option<PieceKind>>, x: Int, val: Option<PieceKind>, col: Int) -> List<Option<PieceKind>>
    ? "Rebuild a row replacing column x"
    match col == 10
        true -> []
        false -> match List.get(r, col)
            Option.Some(v) -> match col == x
                true -> List.prepend(val, setCellCols(r, x, val, col + 1))
                false -> List.prepend(v, setCellCols(r, x, val, col + 1))
            Option.None -> []

verify setCellCols
    List.len(setCellCols(emptyRow(), 3, Option.Some(PieceKind.T), 0)) => 10

fn setCellRows(board: List<List<Option<PieceKind>>>, x: Int, y: Int, val: Option<PieceKind>, row: Int) -> List<List<Option<PieceKind>>>
    ? "Rebuild rows replacing cell at (x,y)"
    match row == 20
        true -> []
        false -> match List.get(board, row)
            Option.Some(r) -> match row == y
                true -> List.prepend(setCellCols(r, x, val, 0), setCellRows(board, x, y, val, row + 1))
                false -> List.prepend(r, setCellRows(board, x, y, val, row + 1))
            Option.None -> []

verify setCellRows
    List.len(setCellRows(emptyBoard(), 3, 5, Option.Some(PieceKind.T), 0)) => 20

fn setCell(board: List<List<Option<PieceKind>>>, x: Int, y: Int, val: PieceKind) -> List<List<Option<PieceKind>>>
    ? "Return board with cell (x,y) set to Option.Some(val)"
    setCellRows(board, x, y, Option.Some(val), 0)

verify setCell
    getCell(setCell(emptyBoard(), 3, 5, PieceKind.T), 3, 5) => Option.Some(PieceKind.T)
    getCell(setCell(emptyBoard(), 3, 5, PieceKind.T), 4, 5) => Option.None

fn isFullRow(row: List<Option<PieceKind>>, i: Int) -> Bool
    ? "True if row has no empty cells"
    match i == List.len(row)
        true -> true
        false -> match List.get(row, i)
            Option.Some(v) -> match v
                Option.None -> false
                Option.Some(_) -> isFullRow(row, i + 1)
            Option.None -> true

verify isFullRow
    isFullRow([Option.Some(PieceKind.I), Option.Some(PieceKind.O), Option.Some(PieceKind.T), Option.Some(PieceKind.S), Option.Some(PieceKind.Z), Option.Some(PieceKind.J), Option.Some(PieceKind.L), Option.Some(PieceKind.I), Option.Some(PieceKind.O), Option.Some(PieceKind.T)], 0) => true
    isFullRow([Option.Some(PieceKind.I), Option.None, Option.Some(PieceKind.T), Option.Some(PieceKind.S), Option.Some(PieceKind.Z), Option.Some(PieceKind.J), Option.Some(PieceKind.L), Option.Some(PieceKind.I), Option.Some(PieceKind.O), Option.Some(PieceKind.T)], 0) => false
    isFullRow(emptyRow(), 0) => false

fn filterRows(board: List<List<Option<PieceKind>>>, i: Int) -> List<List<Option<PieceKind>>>
    ? "Keep only non-full rows"
    match i == List.len(board)
        true -> []
        false -> match List.get(board, i)
            Option.Some(row) -> match isFullRow(row, 0)
                true -> filterRows(board, i + 1)
                false -> List.prepend(row, filterRows(board, i + 1))
            Option.None -> []

verify filterRows
    List.len(filterRows(emptyBoard(), 0)) => 20

fn prependEmpty(board: List<List<Option<PieceKind>>>, n: Int) -> List<List<Option<PieceKind>>>
    ? "Prepend n empty rows"
    match n == 0
        true -> board
        false -> prependEmpty(List.prepend(emptyRow(), board), n - 1)

verify prependEmpty
    List.len(prependEmpty([], 3)) => 3

fn clearLines(board: List<List<Option<PieceKind>>>) -> List<List<Option<PieceKind>>>
    ? "Remove full rows and prepend empty rows at top"
    prependEmpty(filterRows(board, 0), 20 - List.len(filterRows(board, 0)))

verify clearLines
    List.len(clearLines(emptyBoard())) => 20

fn countFullRows(board: List<List<Option<PieceKind>>>, i: Int) -> Int
    ? "Count full rows from index i"
    match i == List.len(board)
        true -> 0
        false -> match List.get(board, i)
            Option.Some(row) -> match isFullRow(row, 0)
                true -> 1 + countFullRows(board, i + 1)
                false -> countFullRows(board, i + 1)
            Option.None -> 0

verify countFullRows
    countFullRows(emptyBoard(), 0) => 0

fn countCleared(board: List<List<Option<PieceKind>>>) -> Int
    ? "Count full rows in board"
    countFullRows(board, 0)

verify countCleared
    countCleared(emptyBoard()) => 0

fn fullRow() -> List<Option<PieceKind>>
    ? "Test helper: a full row"
    [Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I)]

verify fullRow
    isFullRow(fullRow(), 0) => true
