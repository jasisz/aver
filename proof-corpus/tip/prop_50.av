module Prop50
    intent =
        "TIP isaplanner prop_50: butlast xs = take (len xs - 1) xs."
    effects []

type Nat
    Z
    S(Nat)

fn take(n: Nat, xs: List<Int>) -> List<Int>
    match n
        Nat.Z -> []
        Nat.S(z) -> match xs
            [] -> []
            [x2, ..x3] -> List.concat([x2], take(z, x3))

fn len(xs: List<Int>) -> Nat
    match xs
        [] -> Nat.Z
        [y, ..ys] -> Nat.S(len(ys))

fn butlast(xs: List<Int>) -> List<Int>
    match xs
        [] -> []
        [y, ..z] -> match z
            [] -> []
            [x2, ..x3] -> List.concat([y], butlast(z))

fn minus(x: Nat, y: Nat) -> Nat
    match x
        Nat.Z -> Nat.Z
        Nat.S(z) -> match y
            Nat.Z -> x
            Nat.S(x2) -> minus(z, x2)

verify butlast law butlastTakeLenMinusOne
    given xs: List<Int> = [[], [1], [1, 2], [1, 2, 3]]
    butlast(xs) => take(minus(len(xs), Nat.S(Nat.Z)), xs)
