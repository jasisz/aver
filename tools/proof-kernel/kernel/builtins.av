module Builtins
    intent =
        "The signature of every builtin a step term may apply. GENERATED by `aver kernel-builtins`"
        "from the compiler's type checker (src/types/checker/builtins.rs); do not edit by hand."
        "A type variable is bound by the arguments, in order, and the result is read at that binding."
    exposes [Sig, sig, equality]
    depends [Kernel.Term]
    effects []

record Sig
    params: List<Ty>
    ret: Ty

fn sig(name: String) -> Option<Sig>
    ? "The signature of a builtin, by its dotted name."
    match name
        "Bits.and" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "Bits.low" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyResult(Ty.TyInt, Ty.TyStr)))
        "Bits.not" -> Option.Some(Sig(params = [Ty.TyInt], ret = Ty.TyInt))
        "Bits.or" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "Bits.popCount" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyResult(Ty.TyInt, Ty.TyStr)))
        "Bits.shiftLeft" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyResult(Ty.TyInt, Ty.TyStr)))
        "Bits.shiftRight" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyResult(Ty.TyInt, Ty.TyStr)))
        "Bits.xor" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "Bool.and" -> Option.Some(Sig(params = [Ty.TyBool, Ty.TyBool], ret = Ty.TyBool))
        "Bool.not" -> Option.Some(Sig(params = [Ty.TyBool], ret = Ty.TyBool))
        "Bool.or" -> Option.Some(Sig(params = [Ty.TyBool, Ty.TyBool], ret = Ty.TyBool))
        "BranchPath.child" -> Option.Some(Sig(params = [Ty.TyNamed("BranchPath"), Ty.TyInt], ret = Ty.TyResult(Ty.TyNamed("BranchPath"), Ty.TyStr)))
        "BranchPath.parse" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyResult(Ty.TyNamed("BranchPath"), Ty.TyStr)))
        "Crypto.sha256" -> Option.Some(Sig(params = [Ty.TyNamed("Bytes")], ret = Ty.TyNamed("Digest32")))
        "Float.abs" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyFloat))
        "Float.atan2" -> Option.Some(Sig(params = [Ty.TyFloat, Ty.TyFloat], ret = Ty.TyFloat))
        "Float.ceil" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyInt))
        "Float.cos" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyFloat))
        "Float.floor" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyInt))
        "Float.fromInt" -> Option.Some(Sig(params = [Ty.TyInt], ret = Ty.TyFloat))
        "Float.fromString" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyResult(Ty.TyFloat, Ty.TyStr)))
        "Float.max" -> Option.Some(Sig(params = [Ty.TyFloat, Ty.TyFloat], ret = Ty.TyFloat))
        "Float.min" -> Option.Some(Sig(params = [Ty.TyFloat, Ty.TyFloat], ret = Ty.TyFloat))
        "Float.pi" -> Option.Some(Sig(params = [], ret = Ty.TyFloat))
        "Float.pow" -> Option.Some(Sig(params = [Ty.TyFloat, Ty.TyFloat], ret = Ty.TyFloat))
        "Float.round" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyInt))
        "Float.sin" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyFloat))
        "Float.sqrt" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyFloat))
        "Int.abs" -> Option.Some(Sig(params = [Ty.TyInt], ret = Ty.TyInt))
        "Int.div" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyResult(Ty.TyInt, Ty.TyStr)))
        "Int.fromBigEndian" -> Option.Some(Sig(params = [Ty.TyNamed("Bytes")], ret = Ty.TyInt))
        "Int.fromFloat" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyInt))
        "Int.fromLittleEndian" -> Option.Some(Sig(params = [Ty.TyNamed("Bytes")], ret = Ty.TyInt))
        "Int.fromString" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyResult(Ty.TyInt, Ty.TyStr)))
        "Int.max" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "Int.min" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "Int.mod" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyResult(Ty.TyInt, Ty.TyStr)))
        "Int.toBigEndian" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyResult(Ty.TyNamed("Bytes"), Ty.TyStr)))
        "Int.toLittleEndian" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyResult(Ty.TyNamed("Bytes"), Ty.TyStr)))
        "List.concat" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("T", false)), Ty.TyList(Ty.TyVar("T", false))], ret = Ty.TyList(Ty.TyVar("T", false))))
        "List.contains" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("T", false)), Ty.TyVar("T", false)], ret = Ty.TyBool))
        "List.drop" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("T", false)), Ty.TyInt], ret = Ty.TyList(Ty.TyVar("T", false))))
        "List.fromVector" -> Option.Some(Sig(params = [Ty.TyVector(Ty.TyVar("T", false))], ret = Ty.TyList(Ty.TyVar("T", false))))
        "List.len" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("T", false))], ret = Ty.TyInt))
        "List.prepend" -> Option.Some(Sig(params = [Ty.TyVar("T", false), Ty.TyList(Ty.TyVar("T", false))], ret = Ty.TyList(Ty.TyVar("T", false))))
        "List.reverse" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("T", false))], ret = Ty.TyList(Ty.TyVar("T", false))))
        "List.take" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("T", false)), Ty.TyInt], ret = Ty.TyList(Ty.TyVar("T", false))))
        "List.zip" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("A", false)), Ty.TyList(Ty.TyVar("B", false))], ret = Ty.TyList(Ty.TyTuple([Ty.TyVar("A", false), Ty.TyVar("B", false)]))))
        "Map.empty" -> Option.Some(Sig(params = [], ret = Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false))))
        "Map.entries" -> Option.Some(Sig(params = [Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false))], ret = Ty.TyList(Ty.TyTuple([Ty.TyVar("K", false), Ty.TyVar("V", false)]))))
        "Map.fromList" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyTuple([Ty.TyVar("K", false), Ty.TyVar("V", false)]))], ret = Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false))))
        "Map.get" -> Option.Some(Sig(params = [Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false)), Ty.TyVar("K", false)], ret = Ty.TyOption(Ty.TyVar("V", false))))
        "Map.has" -> Option.Some(Sig(params = [Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false)), Ty.TyVar("K", false)], ret = Ty.TyBool))
        "Map.keys" -> Option.Some(Sig(params = [Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false))], ret = Ty.TyList(Ty.TyVar("K", false))))
        "Map.len" -> Option.Some(Sig(params = [Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false))], ret = Ty.TyInt))
        "Map.remove" -> Option.Some(Sig(params = [Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false)), Ty.TyVar("K", false)], ret = Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false))))
        "Map.set" -> Option.Some(Sig(params = [Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false)), Ty.TyVar("K", false), Ty.TyVar("V", false)], ret = Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false))))
        "Map.values" -> Option.Some(Sig(params = [Ty.TyMap(Ty.TyVar("K", false), Ty.TyVar("V", false))], ret = Ty.TyList(Ty.TyVar("V", false))))
        "Option.Some" -> Option.Some(Sig(params = [Ty.TyVar("T", false)], ret = Ty.TyOption(Ty.TyVar("T", false))))
        "Option.withDefault" -> Option.Some(Sig(params = [Ty.TyOption(Ty.TyVar("T", false)), Ty.TyVar("T", false)], ret = Ty.TyVar("T", false)))
        "Result.Err" -> Option.Some(Sig(params = [Ty.TyVar("E", false)], ret = Ty.TyResult(Ty.TyVar("T", false), Ty.TyVar("E", false))))
        "Result.Ok" -> Option.Some(Sig(params = [Ty.TyVar("T", false)], ret = Ty.TyResult(Ty.TyVar("T", false), Ty.TyVar("E", false))))
        "Result.fromOption" -> Option.Some(Sig(params = [Ty.TyOption(Ty.TyVar("T", false)), Ty.TyVar("E", false)], ret = Ty.TyResult(Ty.TyVar("T", false), Ty.TyVar("E", false))))
        "Result.withDefault" -> Option.Some(Sig(params = [Ty.TyResult(Ty.TyVar("T", false), Ty.TyVar("E", false)), Ty.TyVar("T", false)], ret = Ty.TyVar("T", false)))
        "String.byteLength" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyInt))
        "String.charAt" -> Option.Some(Sig(params = [Ty.TyStr, Ty.TyInt], ret = Ty.TyOption(Ty.TyStr)))
        "String.chars" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyList(Ty.TyStr)))
        "String.contains" -> Option.Some(Sig(params = [Ty.TyStr, Ty.TyStr], ret = Ty.TyBool))
        "String.endsWith" -> Option.Some(Sig(params = [Ty.TyStr, Ty.TyStr], ret = Ty.TyBool))
        "String.firstCodePoint" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyOption(Ty.TyInt)))
        "String.fromBool" -> Option.Some(Sig(params = [Ty.TyBool], ret = Ty.TyStr))
        "String.fromCodePoint" -> Option.Some(Sig(params = [Ty.TyInt], ret = Ty.TyOption(Ty.TyStr)))
        "String.fromFloat" -> Option.Some(Sig(params = [Ty.TyFloat], ret = Ty.TyStr))
        "String.fromInt" -> Option.Some(Sig(params = [Ty.TyInt], ret = Ty.TyStr))
        "String.fromUtf8" -> Option.Some(Sig(params = [Ty.TyNamed("Bytes")], ret = Ty.TyResult(Ty.TyStr, Ty.TyStr)))
        "String.join" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyStr), Ty.TyStr], ret = Ty.TyStr))
        "String.len" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyInt))
        "String.replace" -> Option.Some(Sig(params = [Ty.TyStr, Ty.TyStr, Ty.TyStr], ret = Ty.TyStr))
        "String.slice" -> Option.Some(Sig(params = [Ty.TyStr, Ty.TyInt, Ty.TyInt], ret = Ty.TyStr))
        "String.split" -> Option.Some(Sig(params = [Ty.TyStr, Ty.TyStr], ret = Ty.TyList(Ty.TyStr)))
        "String.startsWith" -> Option.Some(Sig(params = [Ty.TyStr, Ty.TyStr], ret = Ty.TyBool))
        "String.toLower" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyStr))
        "String.toUpper" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyStr))
        "String.toUtf8" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyNamed("Bytes")))
        "String.trim" -> Option.Some(Sig(params = [Ty.TyStr], ret = Ty.TyStr))
        "Vector.fromList" -> Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("T", false))], ret = Ty.TyVector(Ty.TyVar("T", false))))
        "Vector.get" -> Option.Some(Sig(params = [Ty.TyVector(Ty.TyVar("T", false)), Ty.TyInt], ret = Ty.TyOption(Ty.TyVar("T", false))))
        "Vector.len" -> Option.Some(Sig(params = [Ty.TyVector(Ty.TyVar("T", false))], ret = Ty.TyInt))
        "Vector.new" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyVar("T", false)], ret = Ty.TyResult(Ty.TyVector(Ty.TyVar("T", false)), Ty.TyStr)))
        "Vector.set" -> Option.Some(Sig(params = [Ty.TyVector(Ty.TyVar("T", false)), Ty.TyInt, Ty.TyVar("T", false)], ret = Ty.TyOption(Ty.TyVector(Ty.TyVar("T", false)))))
        "__bits_low" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "__bits_popcount" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "__bits_shl" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "__bits_shr" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "__int_div_euclid" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "__int_mod_euclid" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyInt], ret = Ty.TyInt))
        "__to_str" -> Option.Some(Sig(params = [Ty.TyVar("T", false)], ret = Ty.TyStr))
        "__vector_new" -> Option.Some(Sig(params = [Ty.TyInt, Ty.TyVar("T", false)], ret = Ty.TyVector(Ty.TyVar("T", false))))
        _ -> Option.None

verify sig
    sig("List.len") => Option.Some(Sig(params = [Ty.TyList(Ty.TyVar("T", false))], ret = Ty.TyInt))
    sig("List.map") => Option.None

fn equality(shape: String) -> Bool
    ? "Whether == between two values of a type of this shape is equality once it is for the shape's parts: the shapes Lean's model proves it for. A hole, the type of no value, has one."
    match shape
        "Int" -> true
        "Bool" -> true
        "String" -> true
        "Unit" -> true
        "List" -> true
        "Option" -> true
        "Result" -> true
        "tuple" -> true
        "_" -> true
        _ -> false

verify equality
    equality("Int") => true
    equality("Float") => false
