module StandardCapabilityTargets
    intent = "Exercises the standard Time, Random, and Disk contracts on every shipped execution target."
    effects [Disk.exists, Random.int, Random.float, Time.now, Time.unixMs, Time.sleep]

fn main() -> Int
    ! [Disk.exists, Random.int, Random.float, Time.now, Time.unixMs, Time.sleep]
    stamp = Time.now()
    _epoch = Time.unixMs()
    Time.sleep(0)
    roll = Random.int(1, 6)
    _fraction = Random.float()
    diskProbe = match Disk.exists("aver-target-disk-probe.absent")
        true -> 1
        _ -> 0
    String.len(stamp) + roll + diskProbe
