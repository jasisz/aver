module Builtins
    depends [Domain.Ast, Domain.Value, Domain.Builtins.Helpers, Domain.Builtins.List, Domain.Builtins.Vector, Domain.Builtins.Primitives, Domain.Builtins.Wrappers]
    intent =
        "Builtin function implementations for the self-hosted evaluator."
        "Dispatches qualified names like List.len, String.charAt, Console.print to sub-modules."
    exposes [callBuiltin, callBuiltinByIdValues, splitDotted, tryVariantConstructor]
    effects [Args, Console, Disk, Env, Http, Random, Tcp, Terminal, Time]

fn callBuiltin(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch qualified builtin calls to sub-module implementations."
    ! [Args.get, Console.error, Console.print, Console.readLine, Console.warn, Disk.appendText, Disk.delete, Disk.deleteDir, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText, Env.get, Env.set, Http.delete, Http.get, Http.head, Http.patch, Http.post, Http.put, Random.int, Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.connect, Tcp.dialled, Tcp.listen, Tcp.peerAddress, Tcp.ping, Tcp.poll, Tcp.readLine, Tcp.send, Tcp.writeLine, Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor, Terminal.showCursor, Terminal.size, Time.now, Time.sleep, Time.unixMs]
    match callBuiltinFast(name, args)
        Option.Some(result) -> result
        Option.None -> match String.startsWith(name, "List.")
            true -> Domain.Builtins.List.call(name, args)
            false -> callBuiltinAfterList(name, args)

fn callBuiltinFast(name: String, args: List<Val>) -> Option<Result<Val, String>>
    ? "Fast exact-match dispatch for the hottest builtins."
    match name
        "Map.set" -> Option.Some(builtinMapSet(args))
        "Map.get" -> Option.Some(builtinMapGet(args))
        "Map.has" -> Option.Some(builtinMapHas(args))
        "Map.fromList" -> Option.Some(builtinMapFromList(args))
        "Map.entries" -> Option.Some(builtinMapEntries(args))
        "Map.remove" -> Option.Some(builtinMapRemove(args))
        "Vector.new" -> Option.Some(Domain.Builtins.Vector.call(name, args))
        "Vector.get" -> Option.Some(Domain.Builtins.Vector.call(name, args))
        "Vector.set" -> Option.Some(Domain.Builtins.Vector.call(name, args))
        "Vector.len" -> Option.Some(Domain.Builtins.Vector.call(name, args))
        "Vector.fromList" -> Option.Some(Domain.Builtins.Vector.call(name, args))
        "List.fromVector" -> Option.Some(Domain.Builtins.Vector.call(name, args))
        "Option.None" -> Option.Some(Result.Ok(Val.ValNone))
        "Option.Some" -> Option.Some(Domain.Builtins.Wrappers.call(name, args))
        "Option.withDefault" -> Option.Some(Domain.Builtins.Wrappers.call(name, args))
        "Result.Ok" -> Option.Some(Domain.Builtins.Wrappers.call(name, args))
        "Result.Err" -> Option.Some(Domain.Builtins.Wrappers.call(name, args))
        "Result.withDefault" -> Option.Some(Domain.Builtins.Wrappers.call(name, args))
        "String.fromInt" -> Option.Some(Domain.Builtins.Primitives.callInt(name, args))
        _ -> Option.None

verify callBuiltinFast
    callBuiltinFast("Result.Ok", [Val.ValInt(5)]) => Option.Some(Result.Ok(Val.ValOk(Val.ValInt(5))))
    callBuiltinFast("Option.None", []) => Option.Some(Result.Ok(Val.ValNone))
    callBuiltinFast("List.len", [Val.ValList([Val.ValInt(1), Val.ValInt(2)])]) => Option.None

fn callBuiltinByIdValues(id: Int, args: List<Val>) -> Result<Val, String>
    ? "Dispatch pre-evaluated args by integer builtin ID. IDs assigned in Ast.builtinNameToId."
    match id
        1 -> builtinMapSet(args)
        2 -> builtinMapGet(args)
        3 -> builtinMapHas(args)
        4 -> builtinMapFromList(args)
        5 -> builtinMapEntries(args)
        6 -> builtinMapRemove(args)
        7 -> Domain.Builtins.Vector.call("Vector.new", args)
        8 -> Domain.Builtins.Vector.call("Vector.get", args)
        9 -> Domain.Builtins.Vector.call("Vector.set", args)
        10 -> Domain.Builtins.Vector.call("Vector.len", args)
        11 -> Domain.Builtins.Vector.call("Vector.fromList", args)
        12 -> Domain.Builtins.Vector.call("List.fromVector", args)
        13 -> Result.Ok(Val.ValNone)
        14 -> Domain.Builtins.Wrappers.call("Option.Some", args)
        15 -> Domain.Builtins.Wrappers.call("Option.withDefault", args)
        16 -> Domain.Builtins.Wrappers.call("Result.Ok", args)
        17 -> Domain.Builtins.Wrappers.call("Result.Err", args)
        18 -> Domain.Builtins.Wrappers.call("Result.withDefault", args)
        19 -> Domain.Builtins.Primitives.callInt("String.fromInt", args)
        20 -> Domain.Builtins.List.call("List.take", args)
        21 -> Domain.Builtins.List.call("List.drop", args)
        _ -> Result.Err("Unknown builtin ID: {String.fromInt(id)}")

verify callBuiltinByIdValues
    callBuiltinByIdValues(13, []) => Result.Ok(Val.ValNone)
    callBuiltinByIdValues(20, [Val.ValList([Val.ValInt(1), Val.ValInt(2)]), Val.ValInt(1)]) => Result.Ok(Val.ValList([Val.ValInt(1)]))
    callBuiltinByIdValues(999, []) => Result.Err("Unknown builtin ID: 999")

fn callBuiltinAfterList(name: String, args: List<Val>) -> Result<Val, String>
    ? "Continue dispatch after List."
    ! [Args.get, Console.error, Console.print, Console.readLine, Console.warn, Disk.appendText, Disk.delete, Disk.deleteDir, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText, Env.get, Env.set, Http.delete, Http.get, Http.head, Http.patch, Http.post, Http.put, Random.int, Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.connect, Tcp.dialled, Tcp.listen, Tcp.peerAddress, Tcp.ping, Tcp.poll, Tcp.readLine, Tcp.send, Tcp.writeLine, Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor, Terminal.showCursor, Terminal.size, Time.now, Time.sleep, Time.unixMs]
    match String.startsWith(name, "Vector.")
        true -> Domain.Builtins.Vector.call(name, args)
        false -> match String.startsWith(name, "Int.")
            true -> Domain.Builtins.Primitives.callInt(name, args)
            false -> match String.startsWith(name, "String.")
                true -> Domain.Builtins.Primitives.callString(name, args)
                false -> match String.startsWith(name, "Float.")
                    true -> Domain.Builtins.Primitives.callFloat(name, args)
                    false -> callBuiltinOther(name, args)

fn callBuiltinOther(name: String, args: List<Val>) -> Result<Val, String>
    ? "Handle non-prefixed builtins: Result.*, Option.*, Bool.*, Map.*, services, and variant constructors."
    ! [Args.get, Console.error, Console.print, Console.readLine, Console.warn, Disk.appendText, Disk.delete, Disk.deleteDir, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText, Env.get, Env.set, Http.delete, Http.get, Http.head, Http.patch, Http.post, Http.put, Random.int, Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.connect, Tcp.dialled, Tcp.listen, Tcp.peerAddress, Tcp.ping, Tcp.poll, Tcp.readLine, Tcp.send, Tcp.writeLine, Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor, Terminal.showCursor, Terminal.size, Time.now, Time.sleep, Time.unixMs]
    match name
        "Console.print" -> builtinConsolePrint(args)
        "Console.readLine" -> builtinConsoleReadLine(args)
        "Console.error" -> builtinConsoleError(args)
        "Console.warn" -> builtinConsoleWarn(args)
        "Disk.readText" -> builtinDiskReadText(args)
        "Disk.writeText" -> builtinDiskWriteText(args)
        "Disk.exists" -> builtinDiskExists(args)
        "Disk.listDir" -> builtinDiskListDir(args)
        "Disk.appendText" -> builtinDiskAppendText(args)
        "Disk.delete" -> builtinDiskDelete(args)
        "Disk.deleteDir" -> builtinDiskDeleteDir(args)
        "Disk.makeDir" -> builtinDiskMakeDir(args)
        "Env.get" -> builtinEnvGet(args)
        "Env.set" -> builtinEnvSet(args)
        "Args.get" -> builtinArgsGet(args)
        "Result.Ok" -> Domain.Builtins.Wrappers.call(name, args)
        "Result.Err" -> Domain.Builtins.Wrappers.call(name, args)
        "Result.withDefault" -> Domain.Builtins.Wrappers.call(name, args)
        "Option.Some" -> Domain.Builtins.Wrappers.call(name, args)
        "Option.None" -> Result.Ok(Val.ValNone)
        "Option.withDefault" -> Domain.Builtins.Wrappers.call(name, args)
        "Result.fromOption" -> Domain.Builtins.Wrappers.callResultFromOption(args)
        "Bool.or" -> builtinBoolOr(args)
        "Bool.and" -> builtinBoolAnd(args)
        "Bool.not" -> builtinBoolNot(args)
        "Map.set" -> builtinMapSet(args)
        "Map.get" -> builtinMapGet(args)
        "Map.has" -> builtinMapHas(args)
        "Map.entries" -> builtinMapEntries(args)
        "Map.keys" -> builtinMapKeys(args)
        "Map.values" -> builtinMapValues(args)
        "Map.fromList" -> builtinMapFromList(args)
        "Map.size" -> builtinMapSize(args)
        "Map.len" -> builtinMapSize(args)
        "Map.remove" -> builtinMapRemove(args)
        _ -> callBuiltinServices(name, args)

fn builtinConsolePrint(args: List<Val>) -> Result<Val, String>
    ? "Console.print(v) -> print any value and return Unit."
    ! [Console.print]
    v = Domain.Builtins.Helpers.oneArg(args)?
    Console.print(Domain.Value.valRepr(v))
    Result.Ok(Val.ValUnit)

fn builtinConsoleError(args: List<Val>) -> Result<Val, String>
    ? "Console.error(v) -> print to stderr."
    ! [Console.error]
    v = Domain.Builtins.Helpers.oneArg(args)?
    Console.error(Domain.Value.valRepr(v))
    Result.Ok(Val.ValUnit)

fn builtinConsoleWarn(args: List<Val>) -> Result<Val, String>
    ? "Console.warn(v) -> print warning."
    ! [Console.warn]
    v = Domain.Builtins.Helpers.oneArg(args)?
    Console.warn(Domain.Value.valRepr(v))
    Result.Ok(Val.ValUnit)

fn builtinConsoleReadLine(args: List<Val>) -> Result<Val, String>
    ? "Console.readLine() -> Result<String, String>."
    ! [Console.readLine]
    match Console.readLine()
        Result.Ok(line) -> Result.Ok(Val.ValOk(Val.ValStr(line)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinDiskReadText(args: List<Val>) -> Result<Val, String>
    ? "Disk.readText(path) -> Result string."
    ! [Disk.readText]
    v = Domain.Builtins.Helpers.oneArg(args)?
    path = Domain.Builtins.Helpers.expectStr(v)?
    match Disk.readText(path)
        Result.Ok(content) -> Result.Ok(Val.ValOk(Val.ValStr(content)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinArgsGet(args: List<Val>) -> Result<Val, String>
    ? "Args.get() -> list of string args."
    ! [Args.get]
    rawArgs = Args.get()
    Result.Ok(Val.ValList(stringsToVals(rawArgs, [])))

fn builtinEnvGet(args: List<Val>) -> Result<Val, String>
    ? "Env.get(key) -> Option<String>."
    ! [Env.get]
    v = Domain.Builtins.Helpers.oneArg(args)?
    key = Domain.Builtins.Helpers.expectStr(v)?
    match Env.get(key)
        Option.Some(value) -> Result.Ok(Val.ValSome(Val.ValStr(value)))
        Option.None -> Result.Ok(Val.ValNone)

fn builtinEnvSet(args: List<Val>) -> Result<Val, String>
    ? "Env.set(key, value) -> Result<Unit, String>."
    ! [Env.set]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (keyV, valueV) -> builtinEnvSetInner(keyV, valueV)

fn builtinEnvSetInner(keyV: Val, valueV: Val) -> Result<Val, String>
    ? "Inner Env.set."
    ! [Env.set]
    key = Domain.Builtins.Helpers.expectStr(keyV)?
    value = Domain.Builtins.Helpers.expectStr(valueV)?
    match Env.set(key, value)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn stringsToVals(strs: List<String>, acc: List<Val>) -> List<Val>
    ? "Convert list of strings to list of ValStr."
    match strs
        [] -> List.reverse(acc)
        [s, ..rest] -> stringsToVals(rest, List.prepend(Val.ValStr(s), acc))

verify stringsToVals
    stringsToVals(["a", "b"], []) => [Val.ValStr("a"), Val.ValStr("b")]
    stringsToVals([], []) => []

fn builtinMapEntries(args: List<Val>) -> Result<Val, String>
    ? "Map.entries(map) -> List of tuples."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValMap(m) -> Result.Ok(Val.ValList(mapEntriesToTuples(Map.entries(m), [])))
        _ -> Result.Err("Map.entries requires a Map")

verify builtinMapEntries
    builtinMapEntries([Val.ValMap({})]) => Result.Ok(Val.ValList([]))
    builtinMapEntries([Val.ValInt(1)]) => Result.Err("Map.entries requires a Map")

fn mapEntriesToTuples(entries: List<Tuple<String, Val>>, acc: List<Val>) -> List<Val>
    ? "Convert entries to list of (key, value) tuples."
    match entries
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (k, v) -> mapEntriesToTuples(rest, List.prepend(Val.ValTuple([Val.ValStr(k), v]), acc))

verify mapEntriesToTuples
    mapEntriesToTuples([], []) => []
    mapEntriesToTuples([("a", Val.ValInt(1))], []) => [Val.ValTuple([Val.ValStr("a"), Val.ValInt(1)])]

fn builtinMapKeys(args: List<Val>) -> Result<Val, String>
    ? "Map.keys(map) -> List of keys."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValMap(m) -> Result.Ok(Val.ValList(stringsToVals(Map.keys(m), [])))
        _ -> Result.Err("Map.keys requires a Map")

verify builtinMapKeys
    builtinMapKeys([Val.ValMap({})]) => Result.Ok(Val.ValList([]))
    builtinMapKeys([Val.ValInt(1)]) => Result.Err("Map.keys requires a Map")

fn builtinMapValues(args: List<Val>) -> Result<Val, String>
    ? "Map.values(map) -> List of values."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValMap(m) -> Result.Ok(Val.ValList(Map.values(m)))
        _ -> Result.Err("Map.values requires a Map")

verify builtinMapValues
    builtinMapValues([Val.ValMap({})]) => Result.Ok(Val.ValList([]))
    builtinMapValues([Val.ValInt(1)]) => Result.Err("Map.values requires a Map")

fn builtinMapFromList(args: List<Val>) -> Result<Val, String>
    ? "Map.fromList(entries) -> Map."
    v = Domain.Builtins.Helpers.oneArg(args)?
    items = Domain.Builtins.Helpers.expectList(v)?
    Result.Ok(Val.ValMap(tuplesToMap(items, {})))

verify builtinMapFromList
    builtinMapFromList([Val.ValList([])]) => Result.Ok(Val.ValMap({}))
    builtinMapFromList([Val.ValInt(1)]) => Result.Err("expected list argument")

fn tuplesToMap(items: List<Val>, acc: Map<String, Val>) -> Map<String, Val>
    ? "Convert list of (key, value) tuples to a Map."
    match items
        [] -> acc
        [item, ..rest] -> match item
            Val.ValTuple(parts) -> tuplesToMapOne(parts, rest, acc)
            _ -> tuplesToMap(rest, acc)

verify tuplesToMap
    tuplesToMap([], {}) => {}
    tuplesToMap([Val.ValTuple([Val.ValStr("a"), Val.ValInt(1)])], {}) => Map.set({}, "a", Val.ValInt(1))

fn tuplesToMapOne(parts: List<Val>, rest: List<Val>, acc: Map<String, Val>) -> Map<String, Val>
    ? "Extract key-value from tuple parts."
    match parts
        [kV, ..tail] -> match tail
            [vV, ..ignored] -> tuplesToMap(rest, Map.set(acc, Domain.Value.mapKeyRepr(kV), vV))
            [] -> tuplesToMap(rest, acc)
        [] -> tuplesToMap(rest, acc)

verify tuplesToMapOne
    tuplesToMapOne([Val.ValStr("k"), Val.ValInt(1)], [], {}) => Map.set({}, "k", Val.ValInt(1))
    tuplesToMapOne([], [], {}) => {}

fn builtinMapSize(args: List<Val>) -> Result<Val, String>
    ? "Map.size(map) -> Int."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValMap(m) -> Result.Ok(Val.ValInt(Map.len(m)))
        _ -> Result.Err("Map.size requires a Map")

verify builtinMapSize
    builtinMapSize([Val.ValMap({})]) => Result.Ok(Val.ValInt(0))
    builtinMapSize([Val.ValInt(1)]) => Result.Err("Map.size requires a Map")

fn builtinMapRemove(args: List<Val>) -> Result<Val, String>
    ? "Map.remove(map, key) -> Map."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (mapV, keyV) -> builtinMapRemoveInner(mapV, keyV)

verify builtinMapRemove
    builtinMapRemove([Val.ValMap({}), Val.ValStr("x")]) => Result.Ok(Val.ValMap({}))
    builtinMapRemove([Val.ValInt(1), Val.ValStr("x")]) => Result.Err("Map.remove requires a Map")

fn builtinMapRemoveInner(mapV: Val, keyV: Val) -> Result<Val, String>
    ? "Inner Map.remove."
    match mapV
        Val.ValMap(m) -> Result.Ok(Val.ValMap(Map.remove(m, Domain.Value.mapKeyRepr(keyV))))
        _ -> Result.Err("Map.remove requires a Map")

verify builtinMapRemoveInner
    builtinMapRemoveInner(Val.ValMap({}), Val.ValStr("x")) => Result.Ok(Val.ValMap({}))
    builtinMapRemoveInner(Val.ValInt(1), Val.ValStr("x")) => Result.Err("Map.remove requires a Map")

fn callBuiltinServices(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch Terminal.*, Time.*, Random.*, Http.*, Tcp.* service builtins."
    ! [Http.delete, Http.get, Http.head, Http.patch, Http.post, Http.put, Random.int, Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.connect, Tcp.dialled, Tcp.listen, Tcp.peerAddress, Tcp.ping, Tcp.poll, Tcp.readLine, Tcp.send, Tcp.writeLine, Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor, Terminal.showCursor, Terminal.size, Time.now, Time.sleep, Time.unixMs]
    match name
        "Random.int" -> builtinRandomInt(args)
        "Time.now" -> builtinTimeNow(args)
        "Time.sleep" -> builtinTimeSleep(args)
        "Time.unixMs" -> builtinTimeUnixMs(args)
        "Http.get" -> builtinHttpSimple(args, "get")
        "Http.head" -> builtinHttpSimple(args, "head")
        "Http.delete" -> builtinHttpSimple(args, "delete")
        "Http.post" -> builtinHttpBody(args, "post")
        "Http.put" -> builtinHttpBody(args, "put")
        "Http.patch" -> builtinHttpBody(args, "patch")
        "Tcp.send" -> builtinTcpSend(args)
        "Tcp.ping" -> builtinTcpPing(args)
        "Tcp.connect" -> builtinTcpConnect(args)
        "Tcp.beginConnect" -> builtinTcpBeginConnect(args)
        "Tcp.dialled" -> builtinTcpDialled(args)
        "Tcp.listen" -> builtinTcpListen(args)
        "Tcp.accept" -> builtinTcpAccept(args)
        "Tcp.peerAddress" -> builtinTcpPeerAddress(args)
        "Tcp.poll" -> builtinTcpPoll(args)
        "Tcp.writeLine" -> builtinTcpWriteLine(args)
        "Tcp.readLine" -> builtinTcpReadLine(args)
        "Tcp.close" -> builtinTcpClose(args)
        "Tcp.closeDial" -> builtinTcpCloseDial(args)
        "Tcp.closeListener" -> builtinTcpCloseListener(args)
        "Terminal.clear" -> builtinTerminalNoArg(name, args)
        "Terminal.flush" -> builtinTerminalNoArg(name, args)
        "Terminal.enableRawMode" -> builtinTerminalNoArg(name, args)
        "Terminal.disableRawMode" -> builtinTerminalNoArg(name, args)
        "Terminal.hideCursor" -> builtinTerminalNoArg(name, args)
        "Terminal.showCursor" -> builtinTerminalNoArg(name, args)
        "Terminal.resetColor" -> builtinTerminalNoArg(name, args)
        "Terminal.readKey" -> builtinTerminalReadKey(args)
        "Terminal.size" -> builtinTerminalSize(args)
        "Terminal.print" -> builtinTerminalPrint(args)
        "Terminal.setColor" -> builtinTerminalSetColor(args)
        "Terminal.moveTo" -> builtinTerminalMoveTo(args)
        _ -> tryVariantConstructor(name, args)

fn builtinRandomInt(args: List<Val>) -> Result<Val, String>
    ? "Random.int(min, max) -> random integer."
    ! [Random.int]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (minV, maxV) -> builtinRandomIntInner(minV, maxV)

fn builtinRandomIntInner(minV: Val, maxV: Val) -> Result<Val, String>
    ? "Inner Random.int."
    ! [Random.int]
    minN = Domain.Builtins.Helpers.expectInt(minV)?
    maxN = Domain.Builtins.Helpers.expectInt(maxV)?
    match Random.int(minN, maxN)
        Result.Ok(value) -> Result.Ok(Val.ValOk(Val.ValInt(value)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTimeSleep(args: List<Val>) -> Result<Val, String>
    ? "Time.sleep(ms) -> Result<Unit, String>."
    ! [Time.sleep]
    v = Domain.Builtins.Helpers.oneArg(args)?
    ms = Domain.Builtins.Helpers.expectInt(v)?
    match Time.sleep(ms)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTimeUnixMs(args: List<Val>) -> Result<Val, String>
    ? "Time.unixMs() -> Int."
    ! [Time.unixMs]
    Result.Ok(Val.ValInt(Time.unixMs()))

fn builtinTerminalNoArg(name: String, args: List<Val>) -> Result<Val, String>
    ? "Terminal no-arg commands: clear, flush, enableRawMode, etc."
    ! [Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.resetColor, Terminal.showCursor]
    match name
        "Terminal.clear" -> termClear()
        "Terminal.flush" -> termFlush()
        "Terminal.enableRawMode" -> termEnableRawMode()
        "Terminal.disableRawMode" -> termDisableRawMode()
        "Terminal.hideCursor" -> termHideCursor()
        "Terminal.showCursor" -> termShowCursor()
        "Terminal.resetColor" -> termResetColor()
        _ -> Result.Err("unknown terminal command: {name}")

fn termClear() -> Result<Val, String>
    ? "Clear the terminal screen."
    ! [Terminal.clear]
    match Terminal.clear()
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn termFlush() -> Result<Val, String>
    ? "Flush terminal output."
    ! [Terminal.flush]
    match Terminal.flush()
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn termEnableRawMode() -> Result<Val, String>
    ? "Enable terminal raw mode."
    ! [Terminal.enableRawMode]
    match Terminal.enableRawMode()
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn termDisableRawMode() -> Result<Val, String>
    ? "Disable terminal raw mode."
    ! [Terminal.disableRawMode]
    match Terminal.disableRawMode()
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn termHideCursor() -> Result<Val, String>
    ? "Hide terminal cursor."
    ! [Terminal.hideCursor]
    match Terminal.hideCursor()
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn termShowCursor() -> Result<Val, String>
    ? "Show terminal cursor."
    ! [Terminal.showCursor]
    match Terminal.showCursor()
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn termResetColor() -> Result<Val, String>
    ? "Reset terminal color."
    ! [Terminal.resetColor]
    match Terminal.resetColor()
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

