module DafnyBytesHex
    intent = "Hex parsing is admitted through its checked Unicode case dependency."
    depends [Bytes]
    effects []

fn decode(text: String) -> Result<Bytes, String>
    Bytes.fromHex(text)

verify decode law reflexive
    given text: String = ["", "00ff"]
    because true
    using []
    decode(text) => decode(text)
