module StickyInt
    intent =
        "Integer significand truncation and round-to-odd composition for K5."
        "truncSig drops low bits; stickySig retains one bit recording whether"
        "any discarded bit was set. Truncating that result more coarsely gives"
        "the same integer as truncating the original directly. The proof is"
        "ordinary Aver: powers of two split the scale, nested floors compose,"
        "and the final truncation discards either value of the sticky bit."
        "Each because is checked and using selects the proved identities."
        "The independent sigDouble law also exercises automatic arithmetic proof."
    exposes [pow2, floorDiv, truncSig, stickySig, sigDouble]
    effects []

fn pow2(n: Int) -> Int
    ? "Two to the n for n >= 0 (and 1 at or below zero): the scale factor 2^n of an exponent."
    match n <= 0
        true -> 1
        false -> 2 * pow2(n - 1)

verify pow2
    pow2(0) => 1
    pow2(1) => 2
    pow2(3) => 8

// Adding nonnegative exponents multiplies their scales.

verify pow2 law homomorphism
    given m: Int = [0, 1, 4]
    given n: Int = [0, 2, 3]
    when m >= 0
    when n >= 0
    pow2(m + n) => pow2(m) * pow2(n)

// Every scale is positive, including the clamped nonpositive-exponent case.

verify pow2 law positive
    given k: Int = [0, 1, 4]
    pow2(k) >= 1 holds

verify pow2 law successor
    given k: Int = [1, 2, 5]
    when k >= 1
    using []
    pow2(k) => 2 * pow2(k - 1)

fn floorDiv(a: Int, d: Int) -> Int
    ? "Total Euclidean floor division a / d (0 when d == 0): the digit-dropping shift."
    Result.withDefault(Int.div(a, d), 0)

verify floorDiv
    floorDiv(7, 2) => 3
    floorDiv(8, 4) => 2

verify floorDiv law nestedFloorCollapse
    given a: Int = [-13, 0, 7, 52]
    given d: Int = [1, 2, 3, 8]
    given e: Int = [1, 2, 5]
    when 0 < d
    when 0 < e
    floorDiv(floorDiv(a, d), e) => floorDiv(a, d * e)

verify floorDiv law cancelCommonFactor
    given value: Int = [-13, 0, 52]
    given divisor: Int = [1, 2, 5]
    given factor: Int = [2, 3]
    when divisor > 0
    when factor > 0
    floorDiv(factor * value, factor * divisor) => floorDiv(value, divisor)

verify floorDiv law absorbRemainder
    given d: Int = [2, 3, 5]
    given q: Int = [-7, 0, 4, 6]
    given r: Int = [0, 1, 2]
    when 0 < d
    when 0 <= r
    when r < d
    floorDiv(d * q + r, d) => q

verify floorDiv law lowBitDrops
    given q: Int = [-13, 0, 3, 7]
    given bit: Int = [0, 1]
    given scale: Int = [1, 2, 5]
    when 0 <= bit
    when bit < 2
    when scale >= 1
    because floorDiv(2 * q + bit, 2) == q
    because floorDiv(floorDiv(2 * q + bit, 2), scale) == floorDiv(2 * q + bit, 2 * scale)
    using [floorDiv.absorbRemainder, floorDiv.nestedFloorCollapse]
    floorDiv(2 * q + bit, 2 * scale) => floorDiv(q, scale)

fn truncSig(A: Int, drop: Int) -> Int
    ? "Truncated significand: floor(A / 2^drop), the kept high bits after dropping `drop` low bits."
    floorDiv(A, pow2(drop))

verify truncSig
    truncSig(13, 2) => 3
    truncSig(8, 1) => 4

verify truncSig law truncStickyInt
    given A: Int = [-257, -13, -1, 0, 1, 8, 13, 257]
    given dn: Int = [0, 1, 2, 8]
    given jt: Int = [0, 1, 2, 3, 6]
    when dn >= 0
    when jt >= 1
    because pow2(jt) == 2 * pow2(jt - 1)
    because pow2(dn + jt - 1) == pow2(dn) * pow2(jt - 1)
    because floorDiv(floorDiv(A, pow2(dn)), pow2(jt - 1)) == floorDiv(A, pow2(dn + jt - 1))
    because floorDiv(2 * floorDiv(A, pow2(dn)), 2 * pow2(jt - 1)) == floorDiv(floorDiv(A, pow2(dn)), pow2(jt - 1))
    because floorDiv(2 * floorDiv(A, pow2(dn)) + 1, 2 * pow2(jt - 1)) == floorDiv(floorDiv(A, pow2(dn)), pow2(jt - 1))
    using [pow2.homomorphism, pow2.positive, pow2.successor, floorDiv.nestedFloorCollapse, floorDiv.cancelCommonFactor, floorDiv.lowBitDrops]
    truncSig(stickySig(A, dn), jt) => truncSig(A, dn + jt - 1)

fn stickySig(A: Int, dn: Int) -> Int
    ? "Round-to-odd at position dn: shift right by dn, append one sticky bit (1 iff any dropped bit set). Value is 2*floor(A/2^dn) + (A mod 2^dn != 0)."
    match A - pow2(dn) * floorDiv(A, pow2(dn)) == 0
        true -> 2 * floorDiv(A, pow2(dn))
        false -> 2 * floorDiv(A, pow2(dn)) + 1

verify stickySig
    stickySig(13, 2) => 7
    stickySig(8, 2) => 4

// Split the final scale into twice a coarser scale, then compose the two
// divisions. Both possible sticky bits disappear at that coarser boundary.
// There is no bound on the significand or the two shift counts.

fn sigDouble(x: Int) -> Int
    ? "Doubling: x + x, checked against multiplication by two."
    x + x

// The same elementary identity can be proved automatically by both backends.
verify sigDouble law doubleIsTwice
    given x: Int = [0, 3, -4]
    sigDouble(x) => 2 * x
