module Looper
    intent = "Fixture library: a yielding function the lowering cannot finish, so the importer is told why instead of being told the protocol is missing."
    depends [Pool, Pooled]
    effects [Pool.claim]
    exposes [loop]

fn loop(id: Int, seen: Int) -> Int
    ? "Claims two handles at once; a request inside an independent product is not something the lowering cuts."
    ! [Pool.claim]
    both = (Pool.claim(id), Pool.claim(id + 1))!
    match both
        (first, second) -> match id
            0 -> seen + first + second
            _ -> loop(id - 1, seen + first)
