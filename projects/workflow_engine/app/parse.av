    Result.Ok(Input.RunCommand(Command.SetDeadline(taskId, deadline)))

verify parseSetDeadline
    parseSetDeadline(["set_deadline", "t1", "2026-03-10T12:00:00Z"]) => Result.Ok(Input.RunCommand(Command.SetDeadline("t1", "2026-03-10T12:00:00Z")))

fn parseClearDeadline(parts: List<String>) -> Result<Input, String>
    ? "Parses clear_deadline."
    taskId = field(parts, 1, "task_id")?
    Result.Ok(Input.RunCommand(Command.ClearDeadline(taskId)))

verify parseClearDeadline
    parseClearDeadline(["clear_deadline", "t1"]) => Result.Ok(Input.RunCommand(Command.ClearDeadline("t1")))

fn parseArchiveTask(parts: List<String>) -> Result<Input, String>
    ? "Parses archive_task."
    taskId = field(parts, 1, "task_id")?
    Result.Ok(Input.RunCommand(Command.ArchiveTask(taskId)))

verify parseArchiveTask
    parseArchiveTask(["archive_task", "t1"]) => Result.Ok(Input.RunCommand(Command.ArchiveTask("t1")))

fn parseListTasks(parts: List<String>) -> Result<Input, String>
    ? "Parses list_tasks."
    Result.Ok(Input.RunQuery(Query.ListTasks(optionalField(parts, 1))))

verify parseListTasks
    parseListTasks(["list_tasks"]) => Result.Ok(Input.RunQuery(Query.ListTasks(Option.None)))
    parseListTasks(["list_tasks", "alpha"]) => Result.Ok(Input.RunQuery(Query.ListTasks(Option.Some("alpha"))))

fn parseShowTask(parts: List<String>) -> Result<Input, String>
    ? "Parses show_task."
    taskId = field(parts, 1, "task_id")?
    Result.Ok(Input.RunQuery(Query.ShowTask(taskId)))

verify parseShowTask
    parseShowTask(["show_task", "t1"]) => Result.Ok(Input.RunQuery(Query.ShowTask("t1")))

fn parseShowAudit(parts: List<String>) -> Result<Input, String>
    ? "Parses show_audit."
    Result.Ok(Input.RunQuery(Query.ShowAudit(optionalField(parts, 1))))

verify parseShowAudit
    parseShowAudit(["show_audit"]) => Result.Ok(Input.RunQuery(Query.ShowAudit(Option.None)))
    parseShowAudit(["show_audit", "t1"]) => Result.Ok(Input.RunQuery(Query.ShowAudit(Option.Some("t1"))))

fn parseRunRules(parts: List<String>) -> Result<Input, String>
    ? "Parses run_rules."
    Result.Ok(Input.RunCommand(Command.RunRules(optionalField(parts, 1))))

verify parseRunRules
    parseRunRules(["run_rules"]) => Result.Ok(Input.RunCommand(Command.RunRules(Option.None)))
    parseRunRules(["run_rules", "t1"]) => Result.Ok(Input.RunCommand(Command.RunRules(Option.Some("t1"))))
