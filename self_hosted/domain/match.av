module Match
    depends [Domain.Ast, Domain.Value]
    intent =
        "Pattern matching engine for the self-hosted evaluator."
        "Matches runtime Val values against Pattern AST nodes and produces bindings."
        "Supports integer tag-based dispatch for fast constructor matching."
    exposes [matchPattern, zipBindings]

fn matchPattern(pat: Pattern, v: Val) -> Result<List<(String, Val)>, String>
    ? "Try to match a value against a pattern. Returns bindings on success."
    match pat
        Pattern.PatWild -> Result.Ok([])
        Pattern.PatInt(n) -> matchPatInt(n, v)
        Pattern.PatFloat(f) -> matchPatFloat(f, v)
        Pattern.PatBool(b) -> matchPatBool(b, v)
        Pattern.PatStr(s) -> matchPatStr(s, v)
        Pattern.PatEmpty -> matchPatEmpty(v)
        Pattern.PatCons(h, t) -> matchPatCons(h, t, v)
        Pattern.PatConstructor(ctorName, bindings) -> matchPatConstructor(ctorName, bindings, v)
        Pattern.PatConstructorId(tag, ctorName, bindings) -> matchPatConstructorById(tag, ctorName, bindings, v)
        Pattern.PatTuple(pats) -> matchPatTuple(pats, v)
        Pattern.PatVar(name) -> Result.Ok([(name, v)])

verify matchPattern
    matchPattern(Pattern.PatWild, Val.ValInt(42)) => Result.Ok([])
    matchPattern(Pattern.PatInt(5), Val.ValInt(5)) => Result.Ok([])
    matchPattern(Pattern.PatInt(5), Val.ValInt(6)) => Result.Err("no match")
    matchPattern(Pattern.PatFloat(3.14), Val.ValFloat(3.14)) => Result.Ok([])
    matchPattern(Pattern.PatFloat(3.14), Val.ValFloat(2.0)) => Result.Err("no match")
    matchPattern(Pattern.PatBool(true), Val.ValBool(true)) => Result.Ok([])
    matchPattern(Pattern.PatBool(true), Val.ValBool(false)) => Result.Err("no match")
    matchPattern(Pattern.PatStr("hi"), Val.ValStr("hi")) => Result.Ok([])
    matchPattern(Pattern.PatEmpty, Val.ValList([])) => Result.Ok([])
    matchPattern(Pattern.PatCons("h", "t"), Val.ValList([Val.ValInt(1)])) => Result.Ok([("h", Val.ValInt(1)), ("t", Val.ValList([]))])
    matchPattern(Pattern.PatTuple([Pattern.PatVar("a")]), Val.ValTuple([Val.ValInt(1)])) => Result.Ok([("a", Val.ValInt(1))])
    matchPattern(Pattern.PatConstructor("Result.Ok", ["x"]), Val.ValOk(Val.ValInt(1))) => Result.Ok([("x", Val.ValInt(1))])
    matchPattern(Pattern.PatConstructorId(1, "Result.Ok", ["x"]), Val.ValOk(Val.ValInt(1))) => Result.Ok([("x", Val.ValInt(1))])
    matchPattern(Pattern.PatVar("x"), Val.ValInt(42)) => Result.Ok([("x", Val.ValInt(42))])

fn matchPatInt(n: Int, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a PatInt pattern against a value."
    match v
        Val.ValInt(m) -> match n == m
            true -> Result.Ok([])
            false -> Result.Err("no match")
        _ -> Result.Err("no match")

verify matchPatInt
    matchPatInt(5, Val.ValInt(5)) => Result.Ok([])
    matchPatInt(5, Val.ValInt(6)) => Result.Err("no match")
    matchPatInt(3, Val.ValBool(true)) => Result.Err("no match")

fn matchPatFloat(f: Float, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a PatFloat pattern against a value."
    match v
        Val.ValFloat(vf) -> match f == vf
            true -> Result.Ok([])
            false -> Result.Err("no match")
        _ -> Result.Err("no match")

verify matchPatFloat
    matchPatFloat(3.14, Val.ValFloat(3.14)) => Result.Ok([])
    matchPatFloat(3.14, Val.ValFloat(2.0)) => Result.Err("no match")
    matchPatFloat(1.0, Val.ValInt(1)) => Result.Err("no match")

fn matchPatBool(b: Bool, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a PatBool pattern against a value."
    match v
        Val.ValBool(vb) -> match b == vb
            true -> Result.Ok([])
            false -> Result.Err("no match")
        _ -> Result.Err("no match")

verify matchPatBool
    matchPatBool(true, Val.ValBool(true)) => Result.Ok([])
    matchPatBool(true, Val.ValBool(false)) => Result.Err("no match")
    matchPatBool(false, Val.ValInt(0)) => Result.Err("no match")

fn matchPatStr(s: String, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a string literal pattern."
    match v
        Val.ValStr(vs) -> match s == vs
            true -> Result.Ok([])
            false -> Result.Err("no match")
        _ -> Result.Err("no match")

verify matchPatStr
    matchPatStr("hello", Val.ValStr("hello")) => Result.Ok([])
    matchPatStr("hello", Val.ValStr("world")) => Result.Err("no match")

fn matchPatEmpty(v: Val) -> Result<List<(String, Val)>, String>
    ? "Match empty list pattern []."
    match v
        Val.ValList(items) -> match items
            [] -> Result.Ok([])
            _ -> Result.Err("no match")
        _ -> Result.Err("no match")

verify matchPatEmpty
    matchPatEmpty(Val.ValList([])) => Result.Ok([])
    matchPatEmpty(Val.ValList([Val.ValInt(1)])) => Result.Err("no match")

fn matchPatCons(h: String, t: String, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match cons pattern [h, ..t]."
    match v
        Val.ValList(items) -> match items
            [] -> Result.Err("no match")
            [head, ..tail] -> Result.Ok([(h, head), (t, Val.ValList(tail))])
        _ -> Result.Err("no match")

verify matchPatCons
    matchPatCons("h", "t", Val.ValList([Val.ValInt(1), Val.ValInt(2)])) => Result.Ok([("h", Val.ValInt(1)), ("t", Val.ValList([Val.ValInt(2)]))])
    matchPatCons("h", "t", Val.ValList([])) => Result.Err("no match")

fn matchPatConstructor(ctorName: String, bindings: List<String>, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match constructor pattern. Checks tag name and extracts inner values."
    match ctorName
        "Result.Ok" -> matchWrapperPat(v, "Ok", bindings)
        "Result.Err" -> matchWrapperPat(v, "Err", bindings)
        "Option.Some" -> matchWrapperPat(v, "Some", bindings)
        "Option.None" -> matchNonePat(v)
        _ -> matchGenericConstructor(ctorName, bindings, v)

verify matchPatConstructor
    matchPatConstructor("Result.Ok", ["x"], Val.ValOk(Val.ValInt(1))) => Result.Ok([("x", Val.ValInt(1))])
    matchPatConstructor("Result.Err", ["e"], Val.ValErr(Val.ValStr("fail"))) => Result.Ok([("e", Val.ValStr("fail"))])
    matchPatConstructor("Option.Some", ["v"], Val.ValSome(Val.ValInt(7))) => Result.Ok([("v", Val.ValInt(7))])
    matchPatConstructor("Option.None", [], Val.ValNone) => Result.Ok([])
    matchPatConstructor("Result.Ok", ["x"], Val.ValInt(5)) => Result.Err("no match")

fn matchPatTuple(pats: List<Pattern>, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match tuple pattern with nested patterns."
    match v
        Val.ValTuple(items) -> matchPatTupleItems(pats, items)
        _ -> Result.Err("no match")

verify matchPatTuple
    matchPatTuple([Pattern.PatVar("a"), Pattern.PatVar("b")], Val.ValTuple([Val.ValInt(1), Val.ValInt(2)])) => Result.Ok([("a", Val.ValInt(1)), ("b", Val.ValInt(2))])
    matchPatTuple([Pattern.PatVar("x")], Val.ValInt(5)) => Result.Err("no match")
    matchPatTuple([], Val.ValTuple([])) => Result.Ok([])

fn matchPatTupleItems(pats: List<Pattern>, items: List<Val>) -> Result<List<(String, Val)>, String>
    ? "Match each pattern against corresponding tuple item."
    match pats
        [] -> Result.Ok([])
        [pat, ..restPats] -> match items
            [] -> Result.Err("no match")
            [item, ..restItems] -> matchPatTupleOne(pat, item, restPats, restItems)

verify matchPatTupleItems
    matchPatTupleItems([Pattern.PatVar("a")], [Val.ValInt(1)]) => Result.Ok([("a", Val.ValInt(1))])
    matchPatTupleItems([], []) => Result.Ok([])
    matchPatTupleItems([Pattern.PatVar("a")], []) => Result.Err("no match")

fn matchPatTupleOne(pat: Pattern, item: Val, restPats: List<Pattern>, restItems: List<Val>) -> Result<List<(String, Val)>, String>
    ? "Match one tuple element and continue."
    bindings = matchPattern(pat, item)?
    restBindings = matchPatTupleItems(restPats, restItems)?
    Result.Ok(List.concat(bindings, restBindings))

verify matchPatTupleOne
    matchPatTupleOne(Pattern.PatVar("a"), Val.ValInt(1), [], []) => Result.Ok([("a", Val.ValInt(1))])
    matchPatTupleOne(Pattern.PatVar("a"), Val.ValInt(1), [Pattern.PatVar("b")], [Val.ValInt(2)]) => Result.Ok([("a", Val.ValInt(1)), ("b", Val.ValInt(2))])
    matchPatTupleOne(Pattern.PatInt(5), Val.ValInt(6), [], []) => Result.Err("no match")

fn matchGenericConstructor(ctorName: String, bindings: List<String>, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a generic variant constructor pattern using the full name stored in the value."
    match v
        Val.ValVariant(_, fullName, fields) -> matchGenericCtorCheck(ctorName, fullName, bindings, fields)
        _ -> Result.Err("no match")

verify matchGenericConstructor
    matchGenericConstructor("Shape.Circle", ["r"], Val.ValVariant(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", [Val.ValInt(5)])) => Result.Ok([("r", Val.ValInt(5))])
    matchGenericConstructor("Shape.Circle", ["r"], Val.ValVariant(Domain.Ast.ctorNameToTag("Shape.Rect"), "Shape.Rect", [Val.ValInt(3)])) => Result.Err("no match")
    matchGenericConstructor("Shape.Circle", ["r"], Val.ValInt(5)) => Result.Err("no match")

fn matchGenericCtorCheck(ctorName: String, fullName: String, bindings: List<String>, fields: List<Val>) -> Result<List<(String, Val)>, String>
    ? "Check if variant full name matches constructor name."
    match fullName == ctorName
        true -> Result.Ok(zipBindings(bindings, fields))
        false -> Result.Err("no match")

verify matchGenericCtorCheck
    matchGenericCtorCheck("Shape.Circle", "Shape.Circle", ["r"], [Val.ValInt(5)]) => Result.Ok([("r", Val.ValInt(5))])
    matchGenericCtorCheck("Shape.Circle", "Shape.Rect", ["r"], [Val.ValInt(5)]) => Result.Err("no match")
    matchGenericCtorCheck("Color.Red", "Color.Red", [], []) => Result.Ok([])

fn matchPatConstructorById(tag: Int, ctorName: String, bindings: List<String>, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match constructor pattern by integer tag ID. Builtins dispatch directly; user variants confirm both tag and full name."
    match tag
        1 -> matchWrapperPatDirect(v, 1, bindings)
        2 -> matchWrapperPatDirect(v, 2, bindings)
        3 -> matchWrapperPatDirect(v, 3, bindings)
        4 -> matchNonePat(v)
        _ -> matchGenericCtorById(tag, ctorName, bindings, v)

verify matchPatConstructorById
    matchPatConstructorById(1, "Result.Ok", ["x"], Val.ValOk(Val.ValInt(1))) => Result.Ok([("x", Val.ValInt(1))])
    matchPatConstructorById(2, "Result.Err", ["e"], Val.ValErr(Val.ValStr("fail"))) => Result.Ok([("e", Val.ValStr("fail"))])
    matchPatConstructorById(3, "Option.Some", ["v"], Val.ValSome(Val.ValInt(7))) => Result.Ok([("v", Val.ValInt(7))])
    matchPatConstructorById(4, "Option.None", [], Val.ValNone) => Result.Ok([])
    matchPatConstructorById(1, "Result.Ok", ["x"], Val.ValInt(5)) => Result.Err("no match")
    matchPatConstructorById(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", ["r"], Val.ValVariant(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", [Val.ValInt(5)])) => Result.Ok([("r", Val.ValInt(5))])
    matchPatConstructorById(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", ["r"], Val.ValVariant(Domain.Ast.ctorNameToTag("Shape.Rect"), "Shape.Rect", [Val.ValInt(3)])) => Result.Err("no match")
    matchPatConstructorById(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", ["r"], Val.ValVariant(Domain.Ast.ctorNameToTag("Color.Red"), "Color.Red", [Val.ValInt(5)])) => Result.Err("no match")

fn matchWrapperPatDirect(v: Val, tag: Int, bindings: List<String>) -> Result<List<(String, Val)>, String>
    ? "Match Ok/Err/Some wrapper by integer tag. 1=Ok, 2=Err, 3=Some."
    match tag
        1 -> match v
            Val.ValOk(inner) -> Result.Ok(zipBindings(bindings, [inner]))
            _ -> Result.Err("no match")
        2 -> match v
            Val.ValErr(inner) -> Result.Ok(zipBindings(bindings, [inner]))
            _ -> Result.Err("no match")
        3 -> match v
            Val.ValSome(inner) -> Result.Ok(zipBindings(bindings, [inner]))
            _ -> Result.Err("no match")
        _ -> Result.Err("no match")

verify matchWrapperPatDirect
    matchWrapperPatDirect(Val.ValOk(Val.ValInt(1)), 1, ["x"]) => Result.Ok([("x", Val.ValInt(1))])
    matchWrapperPatDirect(Val.ValErr(Val.ValStr("fail")), 2, ["e"]) => Result.Ok([("e", Val.ValStr("fail"))])
    matchWrapperPatDirect(Val.ValSome(Val.ValInt(7)), 3, ["v"]) => Result.Ok([("v", Val.ValInt(7))])
    matchWrapperPatDirect(Val.ValInt(5), 1, ["x"]) => Result.Err("no match")

fn matchGenericCtorById(tag: Int, ctorName: String, bindings: List<String>, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a user-defined variant by integer tag first, then full constructor name for collision safety."
    match v
        Val.ValVariant(vTag, fullName, fields) -> match vTag == tag
            true -> match fullName == ctorName
                true -> Result.Ok(zipBindings(bindings, fields))
                false -> Result.Err("no match")
            false -> Result.Err("no match")
        _ -> Result.Err("no match")

verify matchGenericCtorById
    matchGenericCtorById(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", ["r"], Val.ValVariant(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", [Val.ValInt(5)])) => Result.Ok([("r", Val.ValInt(5))])
    matchGenericCtorById(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", ["r"], Val.ValVariant(Domain.Ast.ctorNameToTag("Shape.Rect"), "Shape.Rect", [Val.ValInt(3)])) => Result.Err("no match")
    matchGenericCtorById(Domain.Ast.ctorNameToTag("Color.Red"), "Color.Red", [], Val.ValVariant(Domain.Ast.ctorNameToTag("Color.Red"), "Color.Red", [])) => Result.Ok([])
    matchGenericCtorById(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", ["r"], Val.ValInt(5)) => Result.Err("no match")

fn matchNonePat(v: Val) -> Result<List<(String, Val)>, String>
    ? "Match Option.None pattern."
    match v
        Val.ValNone -> Result.Ok([])
        _ -> Result.Err("no match")

verify matchNonePat
    matchNonePat(Val.ValNone) => Result.Ok([])
    matchNonePat(Val.ValInt(1)) => Result.Err("no match")

fn matchWrapperPat(v: Val, tag: String, bindings: List<String>) -> Result<List<(String, Val)>, String>
    ? "Match Ok/Err/Some wrapper and bind inner value."
    match tag
        "Ok" -> match v
            Val.ValOk(inner) -> Result.Ok(zipBindings(bindings, [inner]))
            _ -> Result.Err("no match")
        "Err" -> match v
            Val.ValErr(inner) -> Result.Ok(zipBindings(bindings, [inner]))
            _ -> Result.Err("no match")
        "Some" -> match v
            Val.ValSome(inner) -> Result.Ok(zipBindings(bindings, [inner]))
            _ -> Result.Err("no match")
        _ -> Result.Err("no match")

verify matchWrapperPat
    matchWrapperPat(Val.ValOk(Val.ValInt(1)), "Ok", ["x"]) => Result.Ok([("x", Val.ValInt(1))])
    matchWrapperPat(Val.ValErr(Val.ValStr("fail")), "Err", ["e"]) => Result.Ok([("e", Val.ValStr("fail"))])
    matchWrapperPat(Val.ValSome(Val.ValInt(7)), "Some", ["v"]) => Result.Ok([("v", Val.ValInt(7))])
    matchWrapperPat(Val.ValInt(5), "Ok", ["x"]) => Result.Err("no match")
    matchWrapperPat(Val.ValOk(Val.ValInt(1)), "Err", ["x"]) => Result.Err("no match")

fn zipBindings(names: List<String>, vals: List<Val>) -> List<(String, Val)>
    ? "Pair binding names with values."
    match names
        [] -> []
        [n, ..ns] -> match vals
            [] -> []
            [v, ..vs] -> List.prepend((n, v), zipBindings(ns, vs))

verify zipBindings
    zipBindings(["x", "y"], [Val.ValInt(1), Val.ValInt(2)]) => [("x", Val.ValInt(1)), ("y", Val.ValInt(2))]
    zipBindings([], []) => []
