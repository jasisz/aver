module Prop10
    intent =
        "TIP prod prop_10: rev (rev x) = x."
    effects []

fn append(x: List<Int>, y: List<Int>) -> List<Int>
    match x
        [] -> y
        [z, ..xs] -> List.concat([z], append(xs, y))

fn rev(x: List<Int>) -> List<Int>
    match x
        [] -> []
        [y, ..xs] -> append(rev(xs), [y])

verify rev law revRev
    given x: List<Int> = [[], [1], [1, 2], [1, 2, 3]]
    rev(rev(x)) => x
