module Hash
    intent =
        "A structural hash: an Int below the prime 2^31 - 1, as a refinement"
        "over Int, so the Rust backend can hold it as a machine word."
    exposes [fromInt, hash, value, mix, mix2]
    exposes opaque [Hash]
    effects []

record Hash
    value: Int

fn fromInt(n: Int) -> Result<Hash, String>
    ? "Smart constructor: admits only the residues of 2^31 - 1."
    match Bool.and(n >= 0, n < 2147483647)
        true -> Result.Ok(Hash(value = n))
        false -> Result.Err("hash out of range")

fn hash(n: Int) -> Hash
    ? "A hash from an Int already reduced; zero for anything else."
    match fromInt(n)
        Result.Ok(h) -> h
        Result.Err(_) -> Hash(value = 0)

fn value(h: Hash) -> Int
    ? "The hash as an Int."
    h.value

fn mix(a: Hash, b: Hash) -> Hash
    ? "Combines a hash with one more ingredient."
    hash(Int.mod(a.value * 1000003 + b.value, 2147483647))

fn mix2(a: Int, b: Hash, c: Hash) -> Hash
    ? "mix(mix(a, b), c) with one remainder, for a below 2^11."
    hash(Int.mod((Int.min(Int.max(a, 0), 2047) * 1000003 + b.value) * 1000003 + c.value, 2147483647))
