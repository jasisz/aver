module Lemma09
    intent =
        "TIP prod lemma_09: rev (x ++ (y ++ [z])) = z :: rev (x ++ y)."
    effects []

fn append(x: List<Int>, y: List<Int>) -> List<Int>
    match x
        [] -> y
        [z, ..xs] -> List.concat([z], append(xs, y))

fn rev(x: List<Int>) -> List<Int>
    match x
        [] -> []
        [y, ..xs] -> append(rev(xs), [y])

verify append law appendBridge
    given x: List<Int> = [[], [1], [1, 2, 3], [3, 1, 2]]
    given y: List<Int> = [[], [9], [8, 7], [4, 5, 6]]
    append(x, y) => List.concat(x, y)

verify append law appendRightId
    given x: List<Int> = [[], [1], [1, 2, 3], [3, 1, 2]]
    append(x, []) => x

verify append law appendAssoc
    given x: List<Int> = [[], [1], [1, 2, 3]]
    given y: List<Int> = [[], [9], [8, 7]]
    given z: List<Int> = [[], [4], [5, 6]]
    append(append(x, y), z) => append(x, append(y, z))

verify rev law revAppendDistributes
    given x: List<Int> = [[], [1], [1, 2, 3], [3, 1, 2]]
    given y: List<Int> = [[], [9], [8, 7], [4, 5, 6]]
    rev(append(x, y)) => append(rev(y), rev(x))

verify rev law revSingleton
    given z: Int = [0, 1, 2, 9]
    rev([z]) => [z]

verify rev law revAppendCons
    given x: List<Int> = [[], [1], [1, 2], [3, 4]]
    given y: List<Int> = [[], [5], [6, 7], [8]]
    given z: Int = [0, 1, 2, 9]
    rev(append(x, append(y, [z]))) => List.concat([z], rev(append(x, y)))
