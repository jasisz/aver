module BracketScan

type PResult
    POk(Int, Int)
    PErr(String)

fn scanExpr(s: String, pos: Int) -> PResult
    ? "Bracket-expression scanner: an atom or a parenthesised group."
    match String.charAt(s, pos)
        Option.None -> PResult.PErr("unexpected end")
        Option.Some(c) -> match c
            "(" -> scanGroup(s, pos + 1)
            _ -> PResult.POk(0, pos)

fn scanGroup(s: String, pos: Int) -> PResult
    ? "Scan the inner expression of a group, then its closing tail."
    match scanExpr(s, pos)
        PResult.PErr(m) -> PResult.PErr(m)
        PResult.POk(v, p) -> scanTail(s, p)

fn scanTail(s: String, pos: Int) -> PResult
    ? "Consume the closing bracket of a group."
    match String.charAt(s, pos)
        Option.None -> PResult.PErr("unterminated group")
        Option.Some(c) -> match c
            ")" -> PResult.POk(0, pos + 1)
            _ -> scanGroup(s, pos + 1)

verify scanExpr
    scanExpr("a", 0) => PResult.POk(0, 0)
    scanExpr("", 0) => PResult.PErr("unexpected end")

verify scanGroup
    scanGroup("a)", 0) => PResult.POk(0, 2)
    scanGroup("", 0) => PResult.PErr("unexpected end")

verify scanTail
    scanTail(")", 0) => PResult.POk(0, 1)
    scanTail("", 0) => PResult.PErr("unterminated group")

verify scanExpr law scanExprAdvances
    given s: String = ["a", "()"]
    given pos: Int = [0]
    given v: Int = [0]
    given p: Int = [0]
    when scanExpr(s, pos) == PResult.POk(v, p)
    p >= pos => true

fn skipWs(s: String, pos: Int) -> Int
    ? "Skip run of spaces (a monotone cursor helper)."
    match String.charAt(s, pos)
        Option.None -> pos
        Option.Some(c) -> match c
            " " -> skipWs(s, pos + 1)
            _ -> pos

verify skipWs
    skipWs("", 0) => 0
    skipWs("  a", 0) => 2
    skipWs("a", 0) => 0

verify skipWs law skipWsAdvances
    given s: String = ["", "  a"]
    given pos: Int = [0]
    skipWs(s, pos) >= pos => true

fn scanSeq(s: String, pos: Int) -> PResult
    ? "Scan a bracket expr then optional `;`-separated continuations."
    match scanExpr(s, pos)
        PResult.PErr(m) -> PResult.PErr(m)
        PResult.POk(v, p) -> scanSeqNext(s, skipWs(s, p))

fn scanSeqNext(s: String, pos: Int) -> PResult
    ? "Continue a sequence at a separator position."
    match String.charAt(s, pos)
        Option.None -> PResult.PErr("end of sequence")
        Option.Some(c) -> match c
            ";" -> scanSeq(s, skipWs(s, pos + 1))
            _ -> PResult.POk(0, pos)

verify scanSeq
    scanSeq("a", 0) => PResult.POk(0, 0)
    scanSeq("", 0) => PResult.PErr("unexpected end")

verify scanSeqNext
    scanSeqNext("x", 0) => PResult.POk(0, 0)
    scanSeqNext("", 0) => PResult.PErr("end of sequence")

verify scanSeq law scanSeqAdvances
    given s: String = ["a", "a;b"]
    given pos: Int = [0]
    given v: Int = [0]
    given p: Int = [0]
    when scanSeq(s, pos) == PResult.POk(v, p)
    p >= pos => true
