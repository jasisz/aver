type T15
  A15(Int)

fn sumBig(n: Int) -> Int
  ? "Sum 1..n, plain recursion, over a big type section."
  match n <= 0
    true -> 0
    false -> n + sumBig(n - 1)

verify sumBig
    sumBig(3) => 6
