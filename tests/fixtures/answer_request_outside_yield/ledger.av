module Ledger
    intent = "The answer this program gives to Pool, from one state."
    depends [Pool, Wait]
    exposes [State, claim]
    effects []
    answers [Pool]

record State
    tip: Int

fn claim(state: State, key: Int) -> Tuple<State, Result<Pool.Assignment, Run.Wake>>
    ? "Hands this peer the height after the tip."
    (state, Result.Ok(Pool.Assignment.Height(state.tip + key)))

verify claim
    claim(State(tip = 1), 2) => (State(tip = 1), Result.Ok(Pool.Assignment.Height(3)))
