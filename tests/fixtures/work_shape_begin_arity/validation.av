module Validation
    kind = capability
    semantics = effectful
    depends [Work]
    intent = "A job kind that asks for more than one task parameter."
    exposes [begin, take]

operation begin(task: String, priority: Int) -> Result<Work.Job, String>
    ? "Starts one validation off the turn and returns its job handle at once."
    oracle = generativeOutput
    replay = recorded

operation take(job: Work.Job) -> Result<Option<Int>, String>
    ? "Collects one finished validation: None while it runs, Some(score) once it finished."
    oracle = generativeOutput
    replay = recorded
