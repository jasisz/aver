module Nested
    intent = "Nested literal, constructor and list patterns, run the same on every backend."
    effects [Console.print]

type Shape
    Circle(Int)
    Rect(Int, Int)
    Dot

fn classify(o: Option<Int>) -> String
    ? "Literal inside a constructor."
    match o
        Option.Some(0) -> "zero"
        Option.Some(1) -> "one"
        Option.Some(n) -> "many {n}"
        Option.None -> "none"

verify classify
    classify(Option.Some(0)) => "zero"
    classify(Option.Some(7)) => "many 7"
    classify(Option.None) => "none"

fn okText(r: Result<String, Int>) -> Int
    ? "String literal inside Result.Ok."
    match r
        Result.Ok("x") -> 1
        Result.Ok(s) -> String.len(s)
        Result.Err(0) -> 0 - 1
        Result.Err(e) -> e

fn flags(p: Option<Bool>) -> Int
    ? "Bool literals nested."
    match p
        Option.Some(true) -> 1
        Option.Some(false) -> 2
        Option.None -> 3

fn area(s: Shape) -> Int
    ? "Literals in user constructor fields."
    match s
        Shape.Rect(0, _) -> 0
        Shape.Rect(_, 0) -> 0
        Shape.Rect(w, h) -> w * h
        Shape.Circle(0) -> 0
        Shape.Circle(r) -> 3 * r * r
        Shape.Dot -> 1

fn deep(o: Option<Option<Int>>) -> Int
    ? "Constructors inside constructors."
    match o
        Option.Some(Option.Some(7)) -> 70
        Option.Some(Option.Some(x)) -> x
        Option.Some(Option.None) -> 0 - 1
        Option.None -> 0 - 2

fn pairs(t: Tuple<Int, Option<Int>>) -> Int
    ? "Tuple with a nested constructor."
    match t
        (0, Option.Some(1)) -> 100
        (a, Option.Some(b)) -> a + b
        (a, Option.None) -> a

fn size(xs: List<Int>) -> String
    ? "List patterns by length."
    match xs
        [] -> "empty"
        [a] -> "one {a}"
        [a, b] -> "two {a} {b}"
        [0, ..rest] -> "zero then {List.len(rest)}"
        [a, b, ..rest] -> "many {a} {b} +{List.len(rest)}"

verify size
    size([]) => "empty"
    size([0, 1, 2]) => "zero then 2"
    size([5, 6, 7, 8]) => "many 5 6 +2"

fn firstSome(xs: List<Option<Int>>) -> Int
    ? "Constructor pattern as a list element."
    match xs
        [Option.Some(x), ..rest] -> x
        [Option.None, ..rest] -> firstSome(rest)
        [] -> 0

fn whole(xs: List<Int>) -> Int
    ? "Rest binder alone."
    match xs
        [..all] -> List.len(all)


type Bin
    Bin(Int)

type Box
    Full(List<Int>)
    Empty

fn headCount(items: List<Int>) -> Int
    ? "Zero for nothing, one for anything: a wild non-empty list over a borrowed parameter (#1450)."
    match items
        [] -> 0
        [_, .._] -> 1

verify headCount
    headCount([]) => 0
    headCount([4, 5]) => 1

fn binCount(items: List<Bin>) -> Int
    ? "The same over record elements."
    match items
        [] -> 0
        [_, .._] -> 1

fn wildFirst(items: List<Int>) -> Int
    ? "The wild arm first."
    match items
        [_, .._] -> 1
        [] -> 0

fn one(items: List<Int>) -> Int
    ? "Exactly one, wild."
    match items
        [_] -> 1
        _ -> 0

fn two(items: List<Int>) -> Int
    ? "Exactly two or one, wild."
    match items
        [_, _] -> 2
        [_] -> 1
        _ -> 0

fn headOnly(items: List<Int>) -> Int
    ? "Named head, wild rest."
    match items
        [x, .._] -> x
        [] -> 0

fn restOnly(items: List<Int>) -> Int
    ? "Wild head, named rest."
    match items
        [_, ..rest] -> List.len(rest)
        [] -> 0 - 1

fn boxed(b: Box) -> Int
    ? "A wild list inside a user constructor."
    match b
        Box.Full([]) -> 0
        Box.Full([_, .._]) -> 1
        Box.Empty -> 0 - 1

fn someNonEmpty(o: Option<List<Int>>) -> Int
    ? "A wild list inside Option.Some."
    match o
        Option.Some([_, .._]) -> 1
        Option.Some([]) -> 0
        Option.None -> 0 - 1

fn paired(t: Tuple<List<Int>, Int>) -> Int
    ? "A wild list inside a tuple."
    match t
        ([_, .._], n) -> n
        ([], _) -> 0

fn localWild(n: Int) -> Int
    ? "A wild list over a local, not a parameter."
    xs = List.take([1, 2, 3], n)
    match xs
        [] -> 0
        [_, .._] -> 1

fn main() -> Unit
    ! [Console.print]
    Console.print("{classify(Option.Some(0))}")
    Console.print("{classify(Option.Some(1))}")
    Console.print("{classify(Option.Some(5))}")
    Console.print("{classify(Option.None)}")
    Console.print("{okText(Result.Ok("x"))}")
    Console.print("{okText(Result.Ok("hello"))}")
    Console.print("{okText(Result.Err(0))}")
    Console.print("{okText(Result.Err(9))}")
    Console.print("{flags(Option.Some(true))}")
    Console.print("{flags(Option.Some(false))}")
    Console.print("{flags(Option.None)}")
    Console.print("{area(Shape.Rect(0, 5))}")
    Console.print("{area(Shape.Rect(4, 0))}")
    Console.print("{area(Shape.Rect(4, 5))}")
    Console.print("{area(Shape.Circle(0))}")
    Console.print("{area(Shape.Circle(2))}")
    Console.print("{area(Shape.Dot)}")
    Console.print("{deep(Option.Some(Option.Some(7)))}")
    Console.print("{deep(Option.Some(Option.Some(3)))}")
    Console.print("{deep(Option.Some(Option.None))}")
    Console.print("{deep(Option.None)}")
    Console.print("{pairs((0, Option.Some(1)))}")
    Console.print("{pairs((2, Option.Some(3)))}")
    Console.print("{pairs((4, Option.None))}")
    Console.print("{size([])}")
    Console.print("{size([1])}")
    Console.print("{size([1, 2])}")
    Console.print("{size([0, 2, 3])}")
    Console.print("{size([1, 2, 3, 4])}")
    Console.print("{firstSome([Option.None, Option.None, Option.Some(4)])}")
    Console.print("{firstSome([Option.None])}")
    Console.print("{whole([1, 2, 3])}")
    Console.print("{headCount([])} {headCount([1, 2, 3])}")
    Console.print("{binCount([])} {binCount([Bin.Bin(1)])}")
    Console.print("{wildFirst([])} {wildFirst([7])}")
    Console.print("{one([])} {one([1])} {one([1, 2])}")
    Console.print("{two([])} {two([1])} {two([1, 2])} {two([1, 2, 3])}")
    Console.print("{headOnly([])} {headOnly([9, 8])}")
    Console.print("{restOnly([])} {restOnly([9, 8, 7])}")
    Console.print("{boxed(Box.Full([]))} {boxed(Box.Full([1]))} {boxed(Box.Empty)}")
    Console.print("{someNonEmpty(Option.Some([]))} {someNonEmpty(Option.Some([3]))} {someNonEmpty(Option.None)}")
    Console.print("{paired(([], 5))} {paired(([1], 5))}")
    Console.print("{localWild(0)} {localWild(2)}")
