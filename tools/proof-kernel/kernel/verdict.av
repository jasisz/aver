module Verdict
    intent =
        "One step script in, the law it proves or the refusal of its first wrong step out."
        "Pure: the CLI in main.av and the aver binary (src/proof_kernel, generated) both call it."
    exposes [verdict]
    depends [Kernel.Sexp, Kernel.Decode, Kernel.Check]
    effects []

fn verdict(text: String) -> Result<String, String>
    ? "Read one script and check it: the law it proves, or the refusal."
    sexp = Kernel.Sexp.readAll(text)?
    Kernel.Check.checkScript(Kernel.Decode.script(sexp)?)

verify verdict
    verdict("(steps 12 (obligation k () (none) (i 1) (i 1)) (defs) (consts) (laws) (proof (refl (i 1))))") => Result.Ok("k")
    verdict("(steps 12 (obligation k () (none) (i 1) (i 1)) (defs) (consts) (laws) (proof (hyp h)))") => Result.Err("step proof: hypothesis h is not in scope")
    verdict("(steps 12 (obligation k () (none) (v base) (i 40)) (defs) (consts (const base (i 40))) (laws) (proof (const base)))") => Result.Ok("k")
    verdict("(steps 12 (obligation k () (none) (v base) (i 41)) (defs) (consts (const base (i 40))) (laws) (proof (const base)))") => Result.Err("step proof: the proof ends at a different equation than the claim")
    verdict("(steps 12 (obligation k (a) (none) (call f (v a)) (op + (v a) (i 1))) (defs (def f (x) ((y (op + (v x) (i 1)))) (v y))) (consts) (laws) (proof (unfold f 0 ((v a)) ())))") => Result.Ok("k")
    verdict("(steps 12 (obligation k (a) (none) (call f (v a)) (v y)) (defs (def f (x) ((y (op + (v x) (i 1)))) (v y))) (consts) (laws) (proof (unfold f 0 ((v a)) ())))") => Result.Err("step proof: the proof ends at a different equation than the claim")
    verdict("(steps 12 (obligation k ((b (tbool))) (none) (op == (v b) (v b)) (b true)) (defs) (consts) (laws) (proof (enum b (op == (v b) (v b)) (b true) (compute (op == (b false) (b false)) (b true)) (compute (op == (b true) (b true)) (b true)))))") => Result.Ok("k")
    verdict("(steps 12 (obligation k ((b (tbool))) (none) (op == (v b) (v b)) (b true)) (defs) (consts) (laws) (proof (enum b (op == (v b) (v b)) (b true) (compute (op == (b false) (b false)) (b true)))))") => Result.Err("step proof: the cases do not match the values of b")
    verdict("(steps 12 (obligation k (b) (none) (op == (v b) (v b)) (b true)) (defs) (consts) (laws) (proof (enum b (op == (v b) (v b)) (b true) (compute (op == (b false) (b false)) (b true)) (compute (op == (b true) (b true)) (b true)))))") => Result.Err("step proof: b is not a given of finite type")
    verdict("(steps 12 (obligation k (c) (v c) (v c) (b true)) (defs) (consts) (laws) (proof (have h (v c) (hyp when) (hyp h))))") => Result.Ok("k")
    verdict("(steps 12 (obligation k (c d) (v c) (v c) (b true)) (defs) (consts) (laws) (proof (have h (v d) (hyp when) (hyp h))))") => Result.Err("step proof: the proof of h ends at a different equation than its fact")
    verdict("(steps 12 (obligation k (c) (v c) (v c) (b true)) (defs) (consts) (laws) (proof (have h (v c) (hyp h) (hyp h))))") => Result.Err("step proof/have.h: hypothesis h is not in scope")
    verdict("(steps 12 (obligation k ((n (tint))) (none) (op <= (v n) (v n)) (b true)) (defs (def f (n) () (match (op <= (v n) (i 0)) (arm (pl (b true)) (i 0)) (arm (pl (b false)) (call f (op - (v n) (i 1))))))) (consts) (laws) (proof (induct f ((v n)) (op <= (v n) (v n)) (b true) (case (g) (ih) () (hyp ih)) (case (g) (ih) () (hyp ih)))))") => Result.Err("step proof/case.0: 0 recursive calls, 1 hypotheses")
    verdict("(steps 12 (obligation k ((n (tint))) (none) (op <= (v n) (v n)) (b true)) (defs (def f (n) () (match (op <= (v n) (i 0)) (arm (pl (b true)) (i 0)) (arm (pl (b false)) (call f (op - (v n) (i 1))))))) (consts) (laws) (proof (induct f ((v n)) (op <= (v n) (v n)) (b true) (case (g) () ((0 ih () ())) (hyp ih)) (case (g) (_) () (hyp g)))))") => Result.Err("step proof/case.0: no recursive call 0")
    verdict("(steps 12 (obligation k (n) (none) (call f (v n)) (call f (v n))) (defs (def f (n) () (match (op <= (v n) (i 0)) (arm (pl (b true)) (i 0)) (arm (pl (b false)) (call f (op - (v n) (i 1))))))) (consts) (laws) (proof (induct f ((v n)) (call f (v n)) (call f (v n)) (case (g) () () (refl (call f (v n)))) (case (g) (_) () (refl (call f (v n)))))))") => Result.Err("step proof: n is not a given of type Int")
    verdict("(steps 12 (obligation k ((n (tint))) (op >= (v n) (i 0)) (call f (v n)) (call f (v n))) (defs (def f (n) () (match (op <= (v n) (i 0)) (arm (pl (b true)) (i 0)) (arm (pl (b false)) (call f (op - (v n) (i 1))))))) (consts) (laws) (proof (induct f ((v n)) (call f (v n)) (call f (v n)) (carry when) (case (g) () () (refl (call f (v n)))) (case (g) ((ih (linear (op >= (op - (v n) (i 1)) (i 0)) true (g) (1 1)))) () (hyp ih)))))") => Result.Err("step proof/case.1: the case proves a different equation")
    verdict("(steps 12 (obligation k ((n (tint))) (op >= (v n) (i 0)) (call f (v n)) (call f (v n))) (defs (def f (n) () (match (op <= (v n) (i 0)) (arm (pl (b true)) (i 0)) (arm (pl (b false)) (call f (op - (v n) (i 1))))))) (consts) (laws) (proof (induct f ((v n)) (call f (v n)) (call f (v n)) (carry when) (case (g) () () (refl (call f (v n)))) (case (g) ((ih (linear (op >= (op - (v n) (i 1)) (i 0)) true (g) (1 1)))) () (refl (call f (v n)))))))") => Result.Ok("k")
    verdict("(steps 12 (obligation k ((n (tint))) (op >= (v n) (i 0)) (call f (v n)) (call f (v n))) (defs (def f (n) () (match (op <= (v n) (i 0)) (arm (pl (b true)) (i 0)) (arm (pl (b false)) (call f (op - (v n) (i 1))))))) (consts) (laws) (proof (induct f ((v n)) (call f (v n)) (call f (v n)) (carry when) (case (g) () () (refl (call f (v n)))) (case (g) ((ih (hyp when))) () (refl (call f (v n)))))))") => Result.Err("step proof/case.1/ih/carry.when: the case proves a different equation")
    verdict("(steps 12 (obligation k ((n (tint))) (op >= (v n) (i 0)) (call f (v n)) (call f (v n))) (defs (def f (n) () (match (op > (v n) (i 0)) (arm (pl (b true)) (call f (bi __int_div_euclid (v n) (i 1)))) (arm (pl (b false)) (i 0))))) (consts) (laws) (proof (induct f ((v n)) (call f (v n)) (call f (v n)) (case (g) (_) () (refl (call f (v n)))) (case (g) () () (refl (call f (v n)))))))") => Result.Err("step proof: f does not count n down to zero")
    verdict("(steps 12 (obligation k ((a (tint)) b) (op == (v a) (v b)) (v a) (v b)) (defs) (consts) (laws) (proof (rule int.eq.of_beq ((a (v a)) (b (v b))) (hyp when))))") => Result.Ok("k")
    verdict("(steps 12 (obligation k (a b) (op ==. (v a) (v b)) (bi String.fromFloat (v a)) (bi String.fromFloat (v b))) (defs) (consts) (laws) (proof (congr (bi String.fromFloat (hole)) (rule int.eq.of_beq ((a (v a)) (b (v b))) (hyp when)))))") => Result.Err("step proof/congr: premise 0 does not match")
    verdict("(steps 12 (obligation k ((a (tint))) (none) (op == (v a) (v a)) (b true)) (defs) (consts) (laws) (proof (rule bool.beq.refl ((a (v a))))))") => Result.Ok("k")
    verdict("(steps 12 (obligation k (a) (none) (op ==. (v a) (v a)) (b true)) (defs) (consts) (laws) (proof (rule bool.beq.refl ((a (v a))))))") => Result.Err("step proof: the proof ends at a different equation than the claim")
    verdict("(steps 12 (obligation k (a) (none) (op == (v a) (v b)) (b true)) (defs) (consts) (laws) (proof (rule bool.beq.refl ((a (v a))))))") => Result.Err("step proof: the proof ends at a different equation than the claim")
    verdict("(steps 12 (obligation k ((a (tint))) (none) (bi Bool.and (op <= (i 0) (bi __int_mod_euclid (v a) (i 256))) (op < (bi __int_mod_euclid (v a) (i 256)) (i 256))) (b true)) (defs) (consts) (laws) (proof (rule int.mod_range ((a (v a)) (k (i 256))) (compute (op > (i 256) (i 0)) (b true)))))") => Result.Ok("k")
    verdict("(steps 12 (obligation k ((a (tint))) (none) (bi Bool.and (op <= (i 0) (bi __int_mod_euclid (v a) (i 0))) (op < (bi __int_mod_euclid (v a) (i 0)) (i 0))) (b true)) (defs) (consts) (laws) (proof (rule int.mod_range ((a (v a)) (k (i 0))) (compute (op > (i 0) (i 0)) (b true)))))") => Result.Err("step proof/premise.0: the two sides compute to different values")
    verdict("(steps 6 (obligation k () (none) (i 1) (i 1)) (defs) (consts) (laws) (proof (refl (i 1))))") => Result.Err("unsupported step format version 6")
    verdict("(steps 3)") => Result.Err("unsupported step format version 3")
