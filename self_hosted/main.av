module SelfHosted
    depends [Domain.Token, Domain.Lexer, Domain.Ast, Domain.Value, Domain.Eval, Domain.Parser, Domain.Resolver]
    intent =
        "Mini Aver interpreter written in Aver."
        "Demonstrates self-hosting: Aver source parsed and evaluated by Aver running on its own VM."
        "Usage: aver run self_hosted/main.av --module-root self_hosted -- <file.av> <module-root> [guest args...]"
    effects [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]

fn run(source: String) -> Result<Val, String>
    ? "Lex, parse, resolve, and evaluate an Aver source string (no module loading)."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    tokens = Domain.Lexer.lex(source)
    prog = Domain.Parser.parse(tokens)?
    resolved = Domain.Resolver.resolveProgram(prog)
    runGuestProgram(resolved, [], [])

fn runWithModules(source: String, moduleRoot: String) -> Result<Val, String>
    ? "Lex, parse, resolve, load modules, and evaluate."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    prepared = prepareProgramWithModules(source, moduleRoot)?
    match prepared
        (prog, moduleFns) -> runGuestProgram(prog, moduleFns, [])

fn prepareProgramWithModules(source: String, moduleRoot: String) -> Result<Tuple<Program, List<FnDef>>, String>
    ? "Lex, parse, resolve, load modules, and return a guest program ready for execution."
    ! [Disk.exists, Disk.readText]
    tokens = Domain.Lexer.lex(source)
    prog = Domain.Parser.parse(tokens)?
    resolved = Domain.Resolver.resolveProgram(prog)
    r = loadModules(resolved.deps, moduleRoot, [], {})?
    match r
        (moduleFns, _) -> Result.Ok((resolved, moduleFns))

fn runGuestProgram(prog: Program, moduleFns: List<FnDef>, guestArgs: List<String>) -> Result<Val, String>
    ? "Execute an already-loaded guest program. guestArgs marks the guest input boundary for scoped replay and policy in generated Rust."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    Domain.Eval.evalProgramWithFns(shiftFnIdsInProgram(prog, List.len(moduleFns)), moduleFns)

fn runGuestCliProgram(prog: Program, moduleFns: List<FnDef>, localFns: List<FnDef>, guestArgs: List<String>) -> Result<Val, String>
    ? "Execute a loaded guest program with CLI-compatible main semantics inside the guest boundary. Returns the user main()'s return Val so the replay scope can serialise it as recording.output (and replay-mode output comparison sees the live value), instead of dropping it to Unit before the wrapping aver_replay scope captures the result."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    match runGuestProgram(prog, moduleFns, guestArgs)
        Result.Ok(result) -> finishCliRun(localFns, result)
        Result.Err(e) -> Result.Err("Runtime error: " + e)

fn loadModules(deps: List<String>, moduleRoot: String, acc: List<FnDef>, loaded: Map<String, Bool>) -> Result<Tuple<List<FnDef>, Map<String, Bool>>, String>
    ? "Load all module dependencies, skipping already-loaded modules."
    ! [Disk.exists, Disk.readText]
    match deps
        [] -> Result.Ok((acc, loaded))
        [dep, ..rest] -> match Map.has(loaded, dep)
            true -> loadModules(rest, moduleRoot, acc, loaded)
            false -> loadOneModule(dep, rest, moduleRoot, acc, loaded)

fn loadOneModule(dep: String, rest: List<String>, moduleRoot: String, acc: List<FnDef>, loaded: Map<String, Bool>) -> Result<Tuple<List<FnDef>, Map<String, Bool>>, String>
    ? "Load one module. Tries moduleRoot, then parent dirs up to 3 levels."
    ! [Disk.exists, Disk.readText]
    path = findModulePath(dep, moduleRoot, 0)
    source = Disk.readText(path)?
    tokens = Domain.Lexer.lex(source)
    prog = Domain.Parser.parse(tokens)?
    moduleFns = resolveQualifiedModuleFns(prog, dep)
    loaded2 = Map.set(loaded, dep, true)
    innerResult = loadModules(prog.deps, moduleRoot, acc, loaded2)?
    match innerResult
        (accWithInner, loaded3) -> loadModules(rest, moduleRoot, List.concat(accWithInner, shiftFnIdsInFns(moduleFns, List.len(accWithInner), [])), loaded3)

fn findModulePath(dep: String, root: String, depth: Int) -> String
    ? "Find module file, trying root then parent dirs."
    ! [Disk.exists]
    path = modulePathFromName(dep, root)
    match Disk.exists(path)
        true -> path
        false -> match depth >= 3
            true -> path
            false -> findModulePath(dep, root + "/..", depth + 1)

fn modulePathFromName(name: String, moduleRoot: String) -> String
    ? "Convert Module.Name to file path: Domain.Foo -> domain/foo.av"
    // Simple: replace dots with / and lowercase
    moduleRoot + "/" + dotToSlash(name, 0, String.len(name), "") + ".av"

verify modulePathFromName
    modulePathFromName("Domain.Foo", ".") => "./domain/foo.av"

fn dotToSlash(name: String, pos: Int, total: Int, acc: String) -> String
    ? "Replace dots with slashes and lowercase first char of each segment."
    nextPos = pos + 1
    match pos >= total
        true -> acc
        false -> match String.charAt(name, pos)
            Option.Some(c) -> match c == "."
                true -> dotToSlash(name, nextPos, total, acc + "/")
                false -> dotToSlash(name, nextPos, total, acc + String.toLower(c))
            Option.None -> acc

verify dotToSlash
    dotToSlash("Domain.Foo", 0, 10, "") => "domain/foo"
    dotToSlash("A.B.C", 0, 5, "") => "a/b/c"

fn qualifyFns(fns: List<FnDef>, prefix: String, acc: List<FnDef>) -> List<FnDef>
    ? "Register functions with both qualified (Domain.Foo.bar) and unqualified (bar) names."
    match fns
        [] -> List.reverse(acc)
        [f, ..rest] -> qualifyFnsOne(f, rest, prefix, acc)

verify qualifyFns
    qualifyFns([], "M", []) => []
    qualifyFns([FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)], "M", []) => [FnDef(name = "M.f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false), FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)]

fn qualifyFnsOne(f: FnDef, rest: List<FnDef>, prefix: String, acc: List<FnDef>) -> List<FnDef>
    ? "Add both qualified and unqualified versions."
    qualified = FnDef(name = prefix + "." + f.name, params = f.params, body = f.body, slotCount = f.slotCount, slotMap = f.slotMap, fastPath = f.fastPath, tailLoop = f.tailLoop)
    qualifyFns(rest, prefix, List.prepend(f, List.prepend(qualified, acc)))

verify qualifyFnsOne
    qualifyFnsOne(FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false), [], "M", []) => [FnDef(name = "M.f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false), FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)]

fn resolveQualifiedModuleFns(prog: Program, dep: String) -> List<FnDef>
    ? "Duplicate module function names first, then resolve locally so direct-call ids are consistent within that module."
    qualifiedProg = Program(deps = prog.deps, fns = qualifyFns(prog.fns, dep, []), stmts = prog.stmts)
    Domain.Resolver.resolveProgram(qualifiedProg).fns

verify resolveQualifiedModuleFns
    resolveQualifiedModuleFns(Program(deps = [], fns = [], stmts = []), "M") => []

fn shiftFnIdsInFns(fns: List<FnDef>, offset: Int, acc: List<FnDef>) -> List<FnDef>
    ? "Shift module-local direct-call ids so they point into the final combined function store."
    match fns
        [] -> List.reverse(acc)
        [fd, ..rest] -> shiftFnIdsInFns(rest, offset, List.prepend(shiftFnIdsInFn(fd, offset), acc))

verify shiftFnIdsInFns
    shiftFnIdsInFns([], 5, []) => []
    List.len(shiftFnIdsInFns([FnDef(name = "f", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)], 5, [])) => 1

fn shiftFnIdsInProgram(prog: Program, offset: Int) -> Program
    ? "Shift entry-program direct-call ids before prepending loaded module functions."
    Program(deps = prog.deps, fns = shiftFnIdsInFns(prog.fns, offset, []), stmts = shiftFnIdsInStmts(prog.stmts, offset, []))

verify shiftFnIdsInProgram
    shiftFnIdsInProgram(Program(deps = [], fns = [FnDef(name = "f", params = [], body = [Stmt.StmtExpr(Expr.ExprCallDirect(1, []))], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastForwardCall(2, []), tailLoop = false)], stmts = [Stmt.StmtExpr(Expr.ExprCallDirect(3, []))]), 4) => Program(deps = [], fns = [FnDef(name = "f", params = [], body = [Stmt.StmtExpr(Expr.ExprCallDirect(5, []))], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastForwardCall(6, []), tailLoop = false)], stmts = [Stmt.StmtExpr(Expr.ExprCallDirect(7, []))])

fn shiftFnIdsInFn(fd: FnDef, offset: Int) -> FnDef
    ? "Shift all embedded direct-call ids in one function definition."
    FnDef(name = fd.name, params = fd.params, body = shiftFnIdsInStmts(fd.body, offset, []), slotCount = fd.slotCount, slotMap = fd.slotMap, fastPath = shiftFnIdsInFastPath(fd.fastPath, offset), tailLoop = fd.tailLoop)

verify shiftFnIdsInFn
    shiftFnIdsInFn(FnDef(name = "f", params = [], body = [Stmt.StmtExpr(Expr.ExprCallDirect(2, []))], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastForwardCall(1, [0]), tailLoop = false), 5) => FnDef(name = "f", params = [], body = [Stmt.StmtExpr(Expr.ExprCallDirect(7, []))], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastForwardCall(6, [0]), tailLoop = false)

fn shiftFnIdsInFastPath(path: FnFastPath, offset: Int) -> FnFastPath
    ? "Shift fast-path target ids that were resolved against a module-local function list."
    match path
        FnFastPath.FastForwardCall(targetId, slotArgs) -> FnFastPath.FastForwardCall(targetId + offset, slotArgs)
        _ -> path

verify shiftFnIdsInFastPath
    shiftFnIdsInFastPath(FnFastPath.FastForwardCall(3, [0, 1]), 4) => FnFastPath.FastForwardCall(7, [0, 1])
    shiftFnIdsInFastPath(FnFastPath.FastNone, 4) => FnFastPath.FastNone

fn shiftFnIdsInStmts(stmts: List<Stmt>, offset: Int, acc: List<Stmt>) -> List<Stmt>
    ? "Shift direct-call ids through a statement list."
    match stmts
        [] -> List.reverse(acc)
        [stmt, ..rest] -> shiftFnIdsInStmts(rest, offset, List.prepend(shiftFnIdsInStmt(stmt, offset), acc))

verify shiftFnIdsInStmts
    shiftFnIdsInStmts([], 3, []) => []
    shiftFnIdsInStmts([Stmt.StmtExpr(Expr.ExprCallDirect(1, []))], 4, []) => [Stmt.StmtExpr(Expr.ExprCallDirect(5, []))]

fn shiftFnIdsInStmt(stmt: Stmt, offset: Int) -> Stmt
    ? "Shift direct-call ids in one statement."
    match stmt
        Stmt.StmtBind(name, expr) -> Stmt.StmtBind(name, shiftFnIdsInExpr(expr, offset))
        Stmt.StmtBindSlot(slot, expr) -> Stmt.StmtBindSlot(slot, shiftFnIdsInExpr(expr, offset))
        Stmt.StmtExpr(expr) -> Stmt.StmtExpr(shiftFnIdsInExpr(expr, offset))

verify shiftFnIdsInStmt
    shiftFnIdsInStmt(Stmt.StmtBind("x", Expr.ExprCallDirect(2, [])), 5) => Stmt.StmtBind("x", Expr.ExprCallDirect(7, []))
    shiftFnIdsInStmt(Stmt.StmtExpr(Expr.ExprInt(1)), 5) => Stmt.StmtExpr(Expr.ExprInt(1))

fn shiftFnIdsInExpr(expr: Expr, offset: Int) -> Expr
    ? "Shift direct-call ids in one expression tree."
    match expr
        Expr.ExprBoolBranch(cond, thenExpr, elseExpr) -> Expr.ExprBoolBranch(shiftFnIdsInExpr(cond, offset), shiftFnIdsInExpr(thenExpr, offset), shiftFnIdsInExpr(elseExpr, offset))
        Expr.ExprVectorGetOrInt(vecExpr, idxExpr, defaultValue) -> Expr.ExprVectorGetOrInt(shiftFnIdsInExpr(vecExpr, offset), shiftFnIdsInExpr(idxExpr, offset), defaultValue)
        Expr.ExprIntModOrInt(a, b, defaultValue) -> Expr.ExprIntModOrInt(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset), defaultValue)
        Expr.ExprAdd(a, b) -> Expr.ExprAdd(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprSub(a, b) -> Expr.ExprSub(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprMul(a, b) -> Expr.ExprMul(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprDiv(a, b) -> Expr.ExprDiv(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprEq(a, b) -> Expr.ExprEq(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprNeq(a, b) -> Expr.ExprNeq(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        _ -> shiftFnIdsInExprTail(expr, offset)

fn shiftFnIdsInExprTail(expr: Expr, offset: Int) -> Expr
    ? "Finish shifting direct-call ids through the remaining aggregate forms."
    match expr
        Expr.ExprLt(a, b) -> Expr.ExprLt(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprGt(a, b) -> Expr.ExprGt(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprLte(a, b) -> Expr.ExprLte(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprGte(a, b) -> Expr.ExprGte(shiftFnIdsInExpr(a, offset), shiftFnIdsInExpr(b, offset))
        Expr.ExprConcat(parts) -> Expr.ExprConcat(shiftFnIdsInExprs(parts, offset, []))
        Expr.ExprTuple(exprs) -> Expr.ExprTuple(shiftFnIdsInExprs(exprs, offset, []))
        Expr.ExprList(exprs) -> Expr.ExprList(shiftFnIdsInExprs(exprs, offset, []))
        Expr.ExprRecord(name, fields) -> Expr.ExprRecord(name, shiftFnIdsInFields(fields, offset, []))
        _ -> shiftFnIdsInExprCalls(expr, offset)

fn shiftFnIdsInExprCalls(expr: Expr, offset: Int) -> Expr
    ? "Finish shifting direct-call ids through access, call, and match forms."
    match expr
        Expr.ExprFieldAccess(obj, field) -> Expr.ExprFieldAccess(shiftFnIdsInExpr(obj, offset), field)
        Expr.ExprCall(name, args) -> Expr.ExprCall(name, shiftFnIdsInExprs(args, offset, []))
        Expr.ExprCallDirect(fnId, args) -> Expr.ExprCallDirect(fnId + offset, shiftFnIdsInExprs(args, offset, []))
        Expr.ExprCallBuiltin(name, args) -> Expr.ExprCallBuiltin(name, shiftFnIdsInExprs(args, offset, []))
        Expr.ExprCallBuiltinId(id, args) -> Expr.ExprCallBuiltinId(id, shiftFnIdsInExprs(args, offset, []))
        Expr.ExprMatch(scrutinee, arms) -> Expr.ExprMatch(shiftFnIdsInExpr(scrutinee, offset), shiftFnIdsInArms(arms, offset, []))
        Expr.ExprPropagate(inner) -> Expr.ExprPropagate(shiftFnIdsInExpr(inner, offset))
        Expr.ExprIndependentProduct(exprs, unwrap) -> Expr.ExprIndependentProduct(shiftFnIdsInExprs(exprs, offset, []), unwrap)
        _ -> expr

verify shiftFnIdsInExpr
    shiftFnIdsInExpr(Expr.ExprCallDirect(2, [Expr.ExprCallDirect(1, [])]), 5) => Expr.ExprCallDirect(7, [Expr.ExprCallDirect(6, [])])
    shiftFnIdsInExpr(Expr.ExprCall("f", [Expr.ExprCallDirect(0, [])]), 3) => Expr.ExprCall("f", [Expr.ExprCallDirect(3, [])])

fn shiftFnIdsInExprs(exprs: List<Expr>, offset: Int, acc: List<Expr>) -> List<Expr>
    ? "Shift direct-call ids in a list of expressions."
    match exprs
        [] -> List.reverse(acc)
        [expr, ..rest] -> shiftFnIdsInExprs(rest, offset, List.prepend(shiftFnIdsInExpr(expr, offset), acc))

verify shiftFnIdsInExprs
    shiftFnIdsInExprs([], 2, []) => []
    shiftFnIdsInExprs([Expr.ExprCallDirect(1, []), Expr.ExprInt(9)], 3, []) => [Expr.ExprCallDirect(4, []), Expr.ExprInt(9)]

fn shiftFnIdsInFields(fields: List<Tuple<String, Expr>>, offset: Int, acc: List<Tuple<String, Expr>>) -> List<Tuple<String, Expr>>
    ? "Shift direct-call ids in record field expressions."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (name, expr) -> shiftFnIdsInFields(rest, offset, List.prepend((name, shiftFnIdsInExpr(expr, offset)), acc))

verify shiftFnIdsInFields
    shiftFnIdsInFields([], 1, []) => []
    shiftFnIdsInFields([("x", Expr.ExprCallDirect(2, []))], 4, []) => [("x", Expr.ExprCallDirect(6, []))]

fn shiftFnIdsInArms(arms: List<MatchArm>, offset: Int, acc: List<MatchArm>) -> List<MatchArm>
    ? "Shift direct-call ids in match arm bodies."
    match arms
        [] -> List.reverse(acc)
        [arm, ..rest] -> shiftFnIdsInArms(rest, offset, List.prepend(MatchArm(pattern = arm.pattern, body = shiftFnIdsInExpr(arm.body, offset), bindingSlots = arm.bindingSlots), acc))

verify shiftFnIdsInArms
    shiftFnIdsInArms([], 1, []) => []
    shiftFnIdsInArms([MatchArm(pattern = Pattern.PatWild, body = Expr.ExprCallDirect(3, []), bindingSlots = {})], 2, []) => [MatchArm(pattern = Pattern.PatWild, body = Expr.ExprCallDirect(5, []), bindingSlots = {})]

fn runRepr(source: String) -> String
    ? "Run source and return result representation or error."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    match run(source)
        Result.Ok(val) -> Domain.Value.valRepr(val)
        Result.Err(e) -> "ERROR: {e}"

fn runFile(path: String, moduleRoot: String) -> Result<String, String>
    ? "Read a file and run it through the self-hosted pipeline with module loading."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    match loadProgramFromFile(path, moduleRoot)
        Result.Ok(pair) -> match pair
            (prog, moduleFns) -> runFileLoaded(prog, moduleFns)
        Result.Err(e) -> Result.Err(e)

fn runFileLoaded(prog: Program, moduleFns: List<FnDef>) -> Result<String, String>
    ? "Turn a loaded guest program into a representation string."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    match runGuestProgram(prog, moduleFns, [])
        Result.Ok(val) -> Result.Ok(Domain.Value.valRepr(val))
        Result.Err(e) -> Result.Err(e)

fn loadProgramFromFile(path: String, moduleRoot: String) -> Result<Tuple<Program, List<FnDef>>, String>
    ? "Read a file and prepare the guest program plus loaded modules."
    ! [Disk.exists, Disk.readText]
    source = Disk.readText(path)?
    prepareProgramWithModules(source, moduleRoot)

fn main() -> Result<Unit, String>
    ! [Args, Args.get, Console, Console.print, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    args = Args.get()
    match args
        [] -> runDemo()
        [path, ..rest] -> match runFromFileWithRest(path, rest)
            Result.Ok(_) -> Result.Ok(Unit)
            Result.Err(e) -> Result.Err(e)

fn runFromFileWithRest(path: String, rest: List<String>) -> Result<Val, String>
    ? "Dispatch normalized CLI args: path, module root, then guest args. Carries the user main()'s return Val up so the wrapping replay scope serialises it as recording.output."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    match rest
        [moduleRoot, ..guestArgs] -> runCliFile(path, moduleRoot, guestArgs)
        [] -> runCliFile(path, ".", [])

fn runCliFile(path: String, moduleRoot: String, guestArgs: List<String>) -> Result<Val, String>
    ? "Load a guest file outside scope, then execute the guest program inside the guest boundary. Propagates the user main()'s return Val unchanged."
    ! [Args, Console, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    prepared = loadProgramFromFile(path, moduleRoot)?
    match prepared
        (prog, moduleFns) -> runGuestCliProgram(prog, moduleFns, prog.fns, guestArgs)

fn finishCliRun(localFns: List<FnDef>, result: Val) -> Result<Val, String>
    ? "Mirror host CLI semantics: surface user main() Result.Err as process failure, but otherwise propagate the live return Val so replay-mode output comparison sees the actual value (recording.output stores the serialised Val, replay re-serialises and compares — dropping to Unit here would force every recording to claim Unit-output, masking real divergence)."
    match hasLocalMain(localFns)
        true -> finishCliMainResult(result)
        false -> Result.Ok(result)

verify finishCliRun
    finishCliRun([], Val.ValInt(7)) => Result.Ok(Val.ValInt(7))
    finishCliRun([FnDef(name = "main", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)], Val.ValErr(Val.ValInt(9))) => Result.Err("Main returned error: 9")

fn finishCliMainResult(result: Val) -> Result<Val, String>
    ? "Convert a guest main() return value into CLI success or failure. Successful returns propagate the live Val so the replay scope can serialise it as recording.output."
    match result
        Val.ValErr(err) -> Result.Err("Main returned error: " + Domain.Value.valRepr(err))
        _ -> Result.Ok(result)

verify finishCliMainResult
    finishCliMainResult(Val.ValErr(Val.ValInt(5))) => Result.Err("Main returned error: 5")
    finishCliMainResult(Val.ValUnit) => Result.Ok(Val.ValUnit)
    finishCliMainResult(Val.ValInt(42)) => Result.Ok(Val.ValInt(42))

fn hasLocalMain(fns: List<FnDef>) -> Bool
    ? "Check whether the entry program defines its own main()."
    match fns
        [] -> false
        [f, ..rest] -> match f.name == "main"
            true -> true
            false -> hasLocalMain(rest)

verify hasLocalMain
    hasLocalMain([]) => false
    hasLocalMain([FnDef(name = "helper", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)]) => false
    hasLocalMain([FnDef(name = "helper", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false), FnDef(name = "main", params = [], body = [], slotCount = 0, slotMap = {}, fastPath = FnFastPath.FastNone, tailLoop = false)]) => true

fn printIfNotUnit(s: String) -> Unit
    ? "Print unless the result is Unit."
    ! [Console.print]
    match s == "()"
        true -> Console.print("")
        false -> Console.print(s)

fn runDemo() -> Result<Unit, String>
    ? "Show built-in demo programs."
    ! [Args, Console, Console.print, Disk, Env, Http, HttpServer, Random, Tcp, Terminal, Time]
    demoArithmetic = runRepr("x = 3 + 4\nx * 2")
    demoDouble = runRepr("fn double(n)\n    n + n\n\ndouble(21)")
    demoFib = runRepr("fn fib(n)\n    match n\n        0 -> 0\n        1 -> 1\n        _ -> fib(n - 1) + fib(n - 2)\n\nfib(10)")
    Console.print("=== Self-Hosted Mini Aver ===")
    Console.print("")
    Console.print("Usage: aver run self_hosted/main.av --module-root self_hosted -- <file.av> <module-root> [guest args...]")
    Console.print("")
    Console.print("Built-in demos:")
    Console.print("  x=3+4; x*2 = {demoArithmetic}")
    Console.print("  double(21) = {demoDouble}")
    Console.print("  fib(10) = {demoFib}")
    Result.Ok(Unit)
