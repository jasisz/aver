module Looper
    intent = "A public source process using a private helper process."
    depends [Pool, Pooled]
    exposes [loop]
    effects [Pool.claim]

fn read(id: Int) -> Int
    ! [Pool.claim]
    Pool.claim(id)

fn loop(id: Int, seen: Int) -> Int
    ! [Pool.claim]
    value = read(id)
    value + seen
