module Lexer
    depends [Domain.Token, Domain.Lexer.Chars]
    intent =
        "Lexer for the mini Aver subset."
        "Tokenizes source string into a list of tokens."
    exposes [lex]

fn tokenizeDigit(src: String, pos: Int) -> List<Token>
    ? "Tokenize starting from a digit character."
    match Domain.Lexer.Chars.readNumber(src, pos, 0)
        (n, newPos) -> tokenizeAfterInt(src, newPos, n)

verify tokenizeDigit
    tokenizeDigit("42", 0) => [Token.TkInt(42), Token.TkEof]
    tokenizeDigit("3.14", 0) => [Token.TkFloat(3.14), Token.TkEof]

fn tokenizeAfterInt(src: String, pos: Int, n: Int) -> List<Token>
    ? "After reading integer part, check for decimal point to form a float."
    match String.charAt(src, pos)
        Option.Some(c) -> match c == "."
            true -> tokenizeAfterIntDot(src, pos, n)
            false -> List.prepend(Token.TkInt(n), tokenize(src, pos))
        Option.None -> List.prepend(Token.TkInt(n), tokenize(src, pos))

verify tokenizeAfterInt
    tokenizeAfterInt("", 0, 42) => [Token.TkInt(42), Token.TkEof]
    tokenizeAfterInt(".5", 0, 3) => [Token.TkFloat(3.5), Token.TkEof]
    tokenizeAfterInt(".x", 0, 3) => [Token.TkInt(3), Token.TkDot, Token.TkIdent("x"), Token.TkEof]

fn tokenizeAfterIntDot(src: String, pos: Int, n: Int) -> List<Token>
    ? "After integer and dot, check if next char is digit (float) or not (int + dot)."
    match String.charAt(src, pos + 1)
        Option.Some(d) -> match Domain.Lexer.Chars.isDigit(d)
            true -> tokenizeFloat(src, pos + 1, n)
            false -> List.prepend(Token.TkInt(n), tokenize(src, pos))
        Option.None -> List.prepend(Token.TkInt(n), tokenize(src, pos))

verify tokenizeAfterIntDot
    tokenizeAfterIntDot(".5x", 0, 3) => [Token.TkFloat(3.5), Token.TkIdent("x"), Token.TkEof]
    tokenizeAfterIntDot(".x", 0, 3) => [Token.TkInt(3), Token.TkDot, Token.TkIdent("x"), Token.TkEof]

fn tokenizeFloat(src: String, pos: Int, intPart: Int) -> List<Token>
    ? "Read decimal digits and build float token."
    match Domain.Lexer.Chars.readNumber(src, pos, 0)
        (decPart, newPos) -> buildFloat(src, newPos, intPart, decPart, newPos - pos)

verify tokenizeFloat
    tokenizeFloat("14", 0, 3) => [Token.TkFloat(3.14), Token.TkEof]
    tokenizeFloat("0", 0, 1) => [Token.TkFloat(1.0), Token.TkEof]

fn buildFloat(src: String, pos: Int, intPart: Int, decPart: Int, decDigits: Int) -> List<Token>
    ? "Construct float from integer and decimal parts."
    f = Int.toFloat(intPart) + Int.toFloat(decPart) / pow10(decDigits)
    List.prepend(Token.TkFloat(f), tokenize(src, pos))

verify buildFloat
    buildFloat("", 0, 3, 14, 2) => [Token.TkFloat(3.14), Token.TkEof]

fn pow10(n: Int) -> Float
    ? "Compute 10^n as Float."
    match n <= 0
        true -> 1.0
        false -> 10.0 * pow10(n - 1)

verify pow10
    pow10(0) => 1.0
    pow10(1) => 10.0
    pow10(2) => 100.0
    pow10(3) => 1000.0

fn tokenizeAlpha(src: String, pos: Int) -> List<Token>
    ? "Tokenize starting from an alpha character."
    match String.charAt(src, pos)
        Option.Some(c) -> tokenizeAlphaWith(src, pos, Domain.Lexer.Chars.isUpper(c))
        Option.None -> [Token.TkEof]

verify tokenizeAlpha
    tokenizeAlpha("fn", 0) => [Token.TkFn, Token.TkEof]

fn tokenizeAlphaWith(src: String, pos: Int, dotted: Bool) -> List<Token>
    ? "Tokenize identifier with known dotted mode."
    match Domain.Lexer.Chars.readIdent(src, pos, "", dotted)
        (word, newPos) -> List.prepend(Domain.Lexer.Chars.keywordOrIdent(word), tokenize(src, newPos))

verify tokenizeAlphaWith
    tokenizeAlphaWith("fn", 0, false) => [Token.TkFn, Token.TkEof]

fn isGreaterThan(c: String) -> Bool
    ? "Check if a character is the greater-than sign."
    c == ">"

verify isGreaterThan
    isGreaterThan(">") => true

fn tokenizeMinus(src: String, pos: Int) -> List<Token>
    ? "Tokenize a minus or arrow token."
    match String.charAt(src, pos + 1)
        Option.Some(c) -> match isGreaterThan(c)
            true -> List.prepend(Token.TkArrow, tokenize(src, pos + 2))
            false -> List.prepend(Token.TkMinus, tokenize(src, pos + 1))
        Option.None -> List.prepend(Token.TkMinus, tokenize(src, pos + 1))

verify tokenizeMinus
    tokenizeMinus("->", 0) => [Token.TkArrow, Token.TkEof]

fn tokenizeDefault(c: String, src: String, pos: Int) -> List<Token>
    ? "Tokenize a character that is not a known single-char token."
    match Domain.Lexer.Chars.isDigit(c)
        true -> tokenizeDigit(src, pos)
        false -> match Domain.Lexer.Chars.isAlpha(c)
            true -> tokenizeAlpha(src, pos)
            false -> tokenize(src, pos + 1)

verify tokenizeDefault
    tokenizeDefault("5", "5", 0) => [Token.TkInt(5), Token.TkEof]

fn tokenizeString(src: String, pos: Int, acc: String) -> List<Token>
    ? "Read string literal with interpolation and escape sequences."
    match pos >= String.len(src)
        true -> [Token.TkStr(acc), Token.TkEof]
        false -> tokenizeStringAt(src, pos, acc)

verify tokenizeString
    tokenizeString("hello\"", 0, "") => [Token.TkStr("hello"), Token.TkEof]

fn tokenizeStringAt(src: String, pos: Int, acc: String) -> List<Token>
    ? "Read one character of string."
    match String.charAt(src, pos)
        Option.Some(c) -> match c == "\\"
            true -> tokenizeStringEscape(src, pos + 1, acc)
            false -> tokenizeStringChar(src, pos, acc, c)
        Option.None -> [Token.TkStr(acc), Token.TkEof]

verify tokenizeStringAt
    tokenizeStringAt("a\"", 0, "") => [Token.TkStr("a"), Token.TkEof]

fn tokenizeStringEscape(src: String, pos: Int, acc: String) -> List<Token>
    ? "Handle escape sequence in string: \\n -> newline, \\t -> tab, etc."
    match String.charAt(src, pos)
        Option.Some(c) -> match c
            "n" -> tokenizeString(src, pos + 1, acc + "\n")
            "t" -> tokenizeString(src, pos + 1, acc + "\t")
            _ -> tokenizeString(src, pos + 1, acc + c)
        Option.None -> [Token.TkStr(acc), Token.TkEof]

verify tokenizeStringEscape
    tokenizeStringEscape("n\"", 0, "") => [Token.TkStr("\n"), Token.TkEof]

fn openBrace() -> String
    ? "Return the opening brace character."
    Option.withDefault(Char.fromCode(123), "x")

verify openBrace
    openBrace() => Option.withDefault(Char.fromCode(123), "x")

fn tokenizeStringChar(src: String, pos: Int, acc: String, c: String) -> List<Token>
    ? "Handle one character inside a string literal."
    match c == "\""
        true -> List.prepend(Token.TkStr(acc), tokenize(src, pos + 1))
        false -> tokenizeStringCharInner(src, pos, acc, c)

verify tokenizeStringChar
    tokenizeStringChar("\" ", 0, "hi", "\"") => [Token.TkStr("hi"), Token.TkEof]

fn tokenizeStringCharInner(src: String, pos: Int, acc: String, c: String) -> List<Token>
    ? "Check for interpolation start, {{ escape, or continue string."
    match c == openBrace()
        true -> tokenizeStringMaybeEscapedBrace(src, pos, acc)
        false -> match c == closeBrace()
            true -> tokenizeStringMaybeEscapedClose(src, pos, acc)
            false -> tokenizeString(src, pos + 1, acc + c)

fn tokenizeStringMaybeEscapedBrace(src: String, pos: Int, acc: String) -> List<Token>
    ? "Check for {{ (escaped brace) or start interpolation."
    match String.charAt(src, pos + 1)
        Option.Some(next) -> match next == openBrace()
            true -> tokenizeString(src, pos + 2, acc + openBrace())
            false -> tokenizeInterp(src, pos, acc)
        Option.None -> tokenizeInterp(src, pos, acc)

fn tokenizeStringMaybeEscapedClose(src: String, pos: Int, acc: String) -> List<Token>
    ? "Check for }} (escaped close brace) or continue."
    match String.charAt(src, pos + 1)
        Option.Some(next) -> match next == closeBrace()
            true -> tokenizeString(src, pos + 2, acc + closeBrace())
            false -> tokenizeString(src, pos + 1, acc + closeBrace())
        Option.None -> tokenizeString(src, pos + 1, acc + closeBrace())

verify tokenizeStringCharInner
    tokenizeStringCharInner("x\"", 0, "", "x") => [Token.TkStr("x"), Token.TkEof]

fn tokenizeInterp(src: String, pos: Int, acc: String) -> List<Token>
    ? "Start interpolation: emit accumulated string, TkInterpStart, expr tokens, TkInterpEnd."
    // Emit string so far, then TkInterpStart
    List.prepend(Token.TkStr(acc), List.prepend(Token.TkInterpStart, tokenizeInterpExpr(src, pos + 1)))

verify tokenizeInterp
    tokenizeInterp("x}", 0, "hi") => [Token.TkStr("hi"), Token.TkInterpStart, Token.TkInterpEnd, Token.TkStr(""), Token.TkEof]

fn tokenizeInterpExpr(src: String, pos: Int) -> List<Token>
    ? "Tokenize expression inside interpolation braces."
    match pos >= String.len(src)
        true -> [Token.TkInterpEnd, Token.TkEof]
        false -> tokenizeInterpExprAt(src, pos)

verify tokenizeInterpExpr
    tokenizeInterpExpr("", 0) => [Token.TkInterpEnd, Token.TkEof]

fn tokenizeInterpExprAt(src: String, pos: Int) -> List<Token>
    ? "Read one token of interpolation expression."
    match String.charAt(src, pos)
        Option.Some(c) -> tokenizeInterpExprC(src, pos, c)
        Option.None -> [Token.TkInterpEnd, Token.TkEof]

verify tokenizeInterpExprAt
    tokenizeInterpExprAt("}", 0) => [Token.TkInterpEnd, Token.TkStr(""), Token.TkEof]

fn closeBrace() -> String
    ? "Return the closing brace character."
    Option.withDefault(Char.fromCode(125), "x")

verify closeBrace
    closeBrace() => Option.withDefault(Char.fromCode(125), "x")

fn tokenizeInterpExprC(src: String, pos: Int, c: String) -> List<Token>
    ? "Dispatch interpolation char."
    match c == closeBrace()
        true -> List.prepend(Token.TkInterpEnd, tokenizeString(src, pos + 1, ""))
        false -> tokenizeInterpExprChar(src, pos, c)

verify tokenizeInterpExprC
    tokenizeInterpExprC("}", 0, Option.withDefault(Char.fromCode(125), "x")) => [Token.TkInterpEnd, Token.TkStr(""), Token.TkEof]

fn tokenizeInterpExprChar(src: String, pos: Int, c: String) -> List<Token>
    ? "Tokenize one char of interpolation expression."
    match Domain.Lexer.Chars.isDigit(c)
        true -> tokenizeInterpDigit(src, pos)
        false -> tokenizeInterpNonDigit(src, pos, c)

verify tokenizeInterpExprChar
    tokenizeInterpExprChar("5}", 0, "5") => [Token.TkInt(5), Token.TkInterpEnd, Token.TkStr(""), Token.TkEof]

fn tokenizeInterpNonDigit(src: String, pos: Int, c: String) -> List<Token>
    ? "Handle non-digit char in interpolation."
    match Domain.Lexer.Chars.isAlpha(c)
        true -> tokenizeInterpAlpha(src, pos)
        false -> tokenizeInterpPunct(src, pos, c)

verify tokenizeInterpNonDigit
    tokenizeInterpNonDigit("x}", 0, "x") => [Token.TkIdent("x"), Token.TkInterpEnd, Token.TkStr(""), Token.TkEof]

fn tokenizeInterpPunct(src: String, pos: Int, c: String) -> List<Token>
    ? "Handle punctuation in interpolation."
    match c
        " " -> tokenizeInterpExpr(src, pos + 1)
        "(" -> List.prepend(Token.TkLParen, tokenizeInterpExpr(src, pos + 1))
        ")" -> List.prepend(Token.TkRParen, tokenizeInterpExpr(src, pos + 1))
        "+" -> List.prepend(Token.TkPlus, tokenizeInterpExpr(src, pos + 1))
        "-" -> List.prepend(Token.TkMinus, tokenizeInterpExpr(src, pos + 1))
        "*" -> List.prepend(Token.TkStar, tokenizeInterpExpr(src, pos + 1))
        "," -> List.prepend(Token.TkComma, tokenizeInterpExpr(src, pos + 1))
        "." -> List.prepend(Token.TkDot, tokenizeInterpExpr(src, pos + 1))
        "[" -> List.prepend(Token.TkLBracket, tokenizeInterpExpr(src, pos + 1))
        "]" -> List.prepend(Token.TkRBracket, tokenizeInterpExpr(src, pos + 1))
        "\"" -> tokenizeInterpString(src, pos + 1, "")
        _ -> tokenizeInterpExpr(src, pos + 1)

verify tokenizeInterpPunct
    tokenizeInterpPunct("}", 1, "+") => [Token.TkPlus, Token.TkInterpEnd, Token.TkEof]

fn tokenizeInterpString(src: String, pos: Int, acc: String) -> List<Token>
    ? "Read string literal inside interpolation braces."
    match pos >= String.len(src)
        true -> List.prepend(Token.TkStr(acc), tokenizeInterpExpr(src, pos))
        false -> match String.charAt(src, pos)
            Option.Some(c) -> match c == "\""
                true -> List.prepend(Token.TkStr(acc), tokenizeInterpExpr(src, pos + 1))
                false -> tokenizeInterpString(src, pos + 1, acc + c)
            Option.None -> List.prepend(Token.TkStr(acc), tokenizeInterpExpr(src, pos))

verify tokenizeInterpString
    tokenizeInterpString("hi\"}", 0, "") => [Token.TkStr("hi"), Token.TkInterpEnd, Token.TkStr(""), Token.TkEof]

fn tokenizeInterpDigit(src: String, pos: Int) -> List<Token>
    ? "Read number inside interpolation."
    match Domain.Lexer.Chars.readNumber(src, pos, 0)
        (n, newPos) -> List.prepend(Token.TkInt(n), tokenizeInterpExpr(src, newPos))

verify tokenizeInterpDigit
    tokenizeInterpDigit("42}", 0) => [Token.TkInt(42), Token.TkInterpEnd, Token.TkStr(""), Token.TkEof]

fn tokenizeInterpAlpha(src: String, pos: Int) -> List<Token>
    ? "Read identifier inside interpolation."
    match String.charAt(src, pos)
        Option.Some(c) -> match Domain.Lexer.Chars.readIdent(src, pos, "", Domain.Lexer.Chars.isUpper(c))
            (word, newPos) -> List.prepend(Domain.Lexer.Chars.keywordOrIdent(word), tokenizeInterpExpr(src, newPos))
        Option.None -> tokenizeInterpExpr(src, pos)

verify tokenizeInterpAlpha
    tokenizeInterpAlpha("x}", 0) => [Token.TkIdent("x"), Token.TkInterpEnd, Token.TkStr(""), Token.TkEof]

fn tokenizeSlashOrComment(src: String, pos: Int) -> List<Token>
    ? "Tokenize / (division) or // (line comment)."
    match String.charAt(src, pos + 1)
        Option.Some(c) -> match c == "/"
            true -> skipLineComment(src, pos + 2)
            false -> List.prepend(Token.TkSlash, tokenize(src, pos + 1))
        Option.None -> List.prepend(Token.TkSlash, tokenize(src, pos + 1))

verify tokenizeSlashOrComment
    tokenizeSlashOrComment("/", 0) => [Token.TkSlash, Token.TkEof]

fn skipLineComment(src: String, pos: Int) -> List<Token>
    ? "Skip characters until newline or EOF. Newline goes through indent handling."
    match pos >= String.len(src)
        true -> [Token.TkEof]
        false -> match String.charAt(src, pos)
            Option.Some(c) -> match c == "\n"
                true -> tokenizeNewline(src, pos + 1)
                false -> skipLineComment(src, pos + 1)
            Option.None -> [Token.TkEof]

verify skipLineComment
    skipLineComment("comment", 7) => [Token.TkEof]

fn tokenizeDot(src: String, pos: Int) -> List<Token>
    ? "Tokenize . (field access) or .. (rest pattern)."
    match String.charAt(src, pos + 1)
        Option.Some(c) -> match c == "."
            true -> List.prepend(Token.TkDotDot, tokenize(src, pos + 2))
            false -> List.prepend(Token.TkDot, tokenize(src, pos + 1))
        Option.None -> List.prepend(Token.TkDot, tokenize(src, pos + 1))

verify tokenizeDot
    tokenizeDot("..", 0) => [Token.TkDotDot, Token.TkEof]

fn tokenizeLt(src: String, pos: Int) -> List<Token>
    ? "Tokenize < or <=."
    match String.charAt(src, pos + 1)
        Option.Some(c) -> match c == "="
            true -> List.prepend(Token.TkLte, tokenize(src, pos + 2))
            false -> List.prepend(Token.TkLt, tokenize(src, pos + 1))
        Option.None -> List.prepend(Token.TkLt, tokenize(src, pos + 1))

verify tokenizeLt
    tokenizeLt("<=", 0) => [Token.TkLte, Token.TkEof]

fn tokenizeGt(src: String, pos: Int) -> List<Token>
    ? "Tokenize > or >=."
    match String.charAt(src, pos + 1)
        Option.Some(c) -> match c == "="
            true -> List.prepend(Token.TkGte, tokenize(src, pos + 2))
            false -> List.prepend(Token.TkGt, tokenize(src, pos + 1))
        Option.None -> List.prepend(Token.TkGt, tokenize(src, pos + 1))

verify tokenizeGt
    tokenizeGt(">=", 0) => [Token.TkGte, Token.TkEof]

fn tokenizeBang(src: String, pos: Int) -> List<Token>
    ? "Tokenize ! or !=."
    match String.charAt(src, pos + 1)
        Option.Some(c) -> match c == "="
            true -> List.prepend(Token.TkNeq, tokenize(src, pos + 2))
            false -> List.prepend(Token.TkBang, tokenize(src, pos + 1))
        Option.None -> List.prepend(Token.TkBang, tokenize(src, pos + 1))

verify tokenizeBang
    tokenizeBang("!=", 0) => [Token.TkNeq, Token.TkEof]

fn tokenizeEq(src: String, pos: Int) -> List<Token>
    ? "Tokenize =, ==, or =>."
    match String.charAt(src, pos + 1)
        Option.Some(c) -> match c == "="
            true -> List.prepend(Token.TkEqEq, tokenize(src, pos + 2))
            false -> match c == ">"
                true -> List.prepend(Token.TkFatArrow, tokenize(src, pos + 2))
                false -> List.prepend(Token.TkEq, tokenize(src, pos + 1))
        Option.None -> List.prepend(Token.TkEq, tokenize(src, pos + 1))

verify tokenizeEq
    tokenizeEq("==", 0) => [Token.TkEqEq, Token.TkEof]

fn tokenizeChar(c: String, src: String, pos: Int) -> List<Token>
    ? "Tokenize based on the current character."
    match c
        " " -> tokenize(src, pos + 1)
        "\n" -> tokenizeNewline(src, pos + 1)
        "/" -> tokenizeSlashOrComment(src, pos)
        "+" -> List.prepend(Token.TkPlus, tokenize(src, pos + 1))
        "*" -> List.prepend(Token.TkStar, tokenize(src, pos + 1))
        "<" -> tokenizeLt(src, pos)
        ">" -> tokenizeGt(src, pos)
        "!" -> tokenizeBang(src, pos)
        "?" -> List.prepend(Token.TkQuestion, tokenize(src, pos + 1))
        "\"" -> tokenizeString(src, pos + 1, "")
        "(" -> List.prepend(Token.TkLParen, tokenize(src, pos + 1))
        ")" -> List.prepend(Token.TkRParen, tokenize(src, pos + 1))
        "[" -> List.prepend(Token.TkLBracket, tokenize(src, pos + 1))
        "]" -> List.prepend(Token.TkRBracket, tokenize(src, pos + 1))
        "." -> tokenizeDot(src, pos)
        "," -> List.prepend(Token.TkComma, tokenize(src, pos + 1))
        ":" -> List.prepend(Token.TkColon, tokenize(src, pos + 1))
        "=" -> tokenizeEq(src, pos)
        "-" -> tokenizeMinus(src, pos)
        _ -> tokenizeDefault(c, src, pos)

verify tokenizeChar
    tokenizeChar("+", "+", 0) => [Token.TkPlus, Token.TkEof]

fn tokenizeSome(c: String, src: String, pos: Int) -> List<Token>
    ? "Tokenize when charAt returned Some."
    tokenizeChar(c, src, pos)

verify tokenizeSome
    tokenizeSome("+", "+", 0) => [Token.TkPlus, Token.TkEof]

fn tokenizeAtPos(src: String, pos: Int) -> List<Token>
    ? "Tokenize at given position after bounds check."
    match String.charAt(src, pos)
        Option.None -> [Token.TkEof]
        Option.Some(c) -> tokenizeSome(c, src, pos)

verify tokenizeAtPos
    tokenizeAtPos("+", 0) => [Token.TkPlus, Token.TkEof]

fn tokenize(src: String, pos: Int) -> List<Token>
    ? "Tokenize source string starting from pos."
    match pos >= String.len(src)
        true -> [Token.TkEof]
        false -> tokenizeAtPos(src, pos)

verify tokenize
    tokenize("", 0) => [Token.TkEof]
    tokenize("+", 0) => [Token.TkPlus, Token.TkEof]

fn tokenizeNewline(src: String, pos: Int) -> List<Token>
    ? "Handle newline: count indent of next line, emit NEWLINE + raw indent marker."
    r = countIndent(src, pos, 0)
    match r
        (indent, newPos) -> List.prepend(Token.TkNewline, List.prepend(Token.TkInt(0 - indent - 1), tokenize(src, newPos)))

verify tokenizeNewline
    tokenizeNewline("x", 0) => [Token.TkNewline, Token.TkInt(0 - 0 - 1), Token.TkIdent("x"), Token.TkEof]

fn countIndent(src: String, pos: Int, spaces: Int) -> (Int, Int)
    ? "Count leading spaces after newline. Skip blank lines (reset on another newline)."
    match pos >= String.len(src)
        true -> (spaces, pos)
        false -> countIndentChar(src, pos, spaces)

verify countIndent
    countIndent("  x", 0, 0) => (2, 2)

fn countIndentChar(src: String, pos: Int, spaces: Int) -> (Int, Int)
    ? "Check one character for indent counting."
    match String.charAt(src, pos)
        Option.Some(c) -> match c
            " " -> countIndent(src, pos + 1, spaces + 1)
            "\n" -> countIndent(src, pos + 1, 0)
            _ -> (spaces, pos)
        Option.None -> (spaces, pos)

verify countIndentChar
    countIndentChar("  x", 0, 0) => (2, 2)

fn lex(src: String) -> List<Token>
    ? "Tokenize a complete source string with INDENT/DEDENT."
    raw = tokenize(src, 0)
    processed = processIndentation(raw, [0])
    processed

// --- INDENT/DEDENT post-processing ---

verify lex
    lex("42") => [Token.TkInt(42), Token.TkEof]
    lex("a + b") => [Token.TkIdent("a"), Token.TkPlus, Token.TkIdent("b"), Token.TkEof]
    lex("fn") => [Token.TkFn, Token.TkEof]
    lex("match") => [Token.TkMatch, Token.TkEof]
    lex("") => [Token.TkEof]
    lex("3.14") => [Token.TkFloat(3.14), Token.TkEof]
    lex("0.5") => [Token.TkFloat(0.5), Token.TkEof]

fn processIndentation(tokens: List<Token>, stack: List<Int>) -> List<Token>
    ? "Convert raw indent markers (negative TkInt after TkNewline) into INDENT/DEDENT tokens."
    match tokens
        [] -> emitFinalDedents(stack)
        [t, ..rest] -> processIndentToken(t, rest, stack)

verify processIndentation
    processIndentation([Token.TkEof], [0]) => [Token.TkEof]

fn processIndentToken(t: Token, rest: List<Token>, stack: List<Int>) -> List<Token>
    ? "Process one token in the indentation pass."
    match t
        Token.TkNewline -> processAfterNewline(rest, stack)
        Token.TkEof -> List.concat(emitFinalDedents(stack), [Token.TkEof])
        _ -> List.prepend(t, processIndentation(rest, stack))

verify processIndentToken
    processIndentToken(Token.TkEof, [], [0]) => [Token.TkEof]

fn processAfterNewline(tokens: List<Token>, stack: List<Int>) -> List<Token>
    ? "After TkNewline, check for raw indent marker (negative TkInt)."
    match tokens
        [] -> List.prepend(Token.TkNewline, emitFinalDedents(stack))
        [t, ..rest] -> processAfterNewlineToken(t, rest, stack)

verify processAfterNewline
    processAfterNewline([Token.TkEof], [0]) => List.prepend(Token.TkNewline, [Token.TkEof])

fn processAfterNewlineToken(t: Token, rest: List<Token>, stack: List<Int>) -> List<Token>
    ? "Check if token after newline is a raw indent marker."
    match t
        Token.TkInt(n) -> match n < 0
            true -> emitIndentChange(0 - n - 1, rest, stack)
            false -> List.prepend(Token.TkNewline, List.prepend(t, processIndentation(rest, stack)))
        _ -> List.prepend(Token.TkNewline, List.prepend(t, processIndentation(rest, stack)))

verify processAfterNewlineToken
    processAfterNewlineToken(Token.TkInt(5), [], [0]) => [Token.TkNewline, Token.TkInt(5)]

fn emitIndentChange(indent: Int, rest: List<Token>, stack: List<Int>) -> List<Token>
    ? "Compare indent level to stack top and emit INDENT, DEDENT, or NEWLINE."
    currentIndent = stackTop(stack)
    match indent > currentIndent
        true -> List.prepend(Token.TkNewline, List.prepend(Token.TkIndent, processIndentation(rest, List.prepend(indent, stack))))
        false -> match indent < currentIndent
            true -> emitDedents(indent, rest, stack)
            false -> List.prepend(Token.TkNewline, processIndentation(rest, stack))

verify emitIndentChange
    emitIndentChange(0, [], [0]) => List.prepend(Token.TkNewline, [])

fn emitDedents(targetIndent: Int, rest: List<Token>, stack: List<Int>) -> List<Token>
    ? "Emit DEDENT tokens until stack matches target indent."
    match stack
        [] -> processIndentation(rest, [0])
        [top, ..below] -> match top <= targetIndent
            true -> List.prepend(Token.TkNewline, processIndentation(rest, stack))
            false -> List.prepend(Token.TkDedent, emitDedents(targetIndent, rest, below))

verify emitDedents
    emitDedents(0, [Token.TkEof], [4, 0]) => [Token.TkDedent, Token.TkNewline, Token.TkEof]

fn emitFinalDedents(stack: List<Int>) -> List<Token>
    ? "At EOF, emit DEDENT for each indent level above 0."
    match stack
        [] -> []
        [top, ..rest] -> match top > 0
            true -> List.prepend(Token.TkDedent, emitFinalDedents(rest))
            false -> []

verify emitFinalDedents
    emitFinalDedents([0]) => []
    emitFinalDedents([4, 0]) => [Token.TkDedent]

fn stackTop(stack: List<Int>) -> Int
    ? "Return top of indent stack, or 0 if empty."
    match stack
        [] -> 0
        [top, ..rest] -> top

verify stackTop
    stackTop([4, 0]) => 4
    stackTop([]) => 0
