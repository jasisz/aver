module Rng
    intent =
        "Deterministic LCG pseudo-random number generator."
        "Pure functions, no effects, fully verify-able."
    depends []

fn nextSeed(s: Int) -> Int
    ? "Linear congruential generator step"
    Result.withDefault(Int.mod(s * 1103515245 + 12345, 2147483648), 0)

verify nextSeed
    nextSeed(0) => 12345
    nextSeed(1) => 1103527590
    nextSeed(12345) => 1406932606

fn seedToRange(s: Int, lo: Int, hi: Int) -> Int
    ? "Map seed to integer in [lo, hi]"
    range = hi - lo + 1
    raw = Result.withDefault(Int.mod(Int.abs(s), range), 0)
    lo + raw

verify seedToRange
    seedToRange(100, 0, 9) => 0
    seedToRange(103, 0, 9) => 3
    seedToRange(7, 1, 6) => 2

fn advanceSeed(s: Int, n: Int) -> Int
    ? "Advance the seed n steps"
    match n == 0
        true -> s
        false -> advanceSeed(nextSeed(s), n - 1)

verify advanceSeed
    advanceSeed(0, 0) => 0
    advanceSeed(0, 1) => 12345
    advanceSeed(0, 2) => nextSeed(12345)

fn randomFloat(s: Int) -> Float
    ? "Map seed to [0.0, 1.0)"
    Int.toFloat(Result.withDefault(Int.mod(Int.abs(s), 10000), 0)) / 10000.0

verify randomFloat
    randomFloat(0) => 0.0
    randomFloat(5000) => 0.5
