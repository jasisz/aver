module Node
    intent = "The entry seats one process, which enters a yielding helper from a library."
    depends [Process, Wait, Pool, Pooled, Walker]
    effects [Pool.claim, yield]

fn pooling() -> Unit
    ? "Claims handles until the pool answers None."
    ! [Pool.claim, yield]
    Walker.walking()

fn admit(view: Run.View, id: Int) -> Bool
    ? "Everything seated is served."
    Map.has(view.pending, id)

fn stop(view: Run.View) -> Bool
    ? "The run ends when the process asked us to."
    view.stopping
