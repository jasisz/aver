module Term
    intent =
        "Terms of the proof-step data: Aver expressions as the compiler wrote them."
        "Variables are names; a hole marks the rewrite position of a congruence step."
    exposes [Term, Arm, Field, Pat, Binding, Eqn, Fin, FinField, Ty, TypedVar, isHole, bind, typed]
    effects []

type Ty
    TyInt
    TyBool
    TyStr
    TyFloat
    TyUnit
    TyList(Ty)
    TyOption(Ty)
    TyResult(Ty, Ty)
    TyMap(Ty, Ty)
    TyVector(Ty)
    TyTuple(List<Ty>)
    TyNamed(String)
    TyAny
    TyVar(String, Bool)

record TypedVar
    name: String
    ty: Ty

type Term
    TInt(Int)
    TBool(Bool)
    TStr(String)
    TUnit
    TVar(String)
    THole
    TGet(Term, String)
    TCall(String, List<Term>)
    TBi(String, List<Term>)
    TOp(String, Term, Term)
    TNeg(Term)
    TCtor(String, List<Term>)
    TMatch(Term, List<Arm>)
    TParts(List<Term>)
    TList(List<Term>)
    TTuple(List<Term>)
    TRec(String, List<Field>)
    TUpd(String, Term, List<Field>)

record Arm
    pattern: Pat
    body: Term

record Field
    name: String
    value: Term

type Pat
    PWild
    PVar(String)
    PLit(Term)
    PNil
    PCons(String, String)
    PTuple(List<Pat>)
    PCtor(String, List<String>)

record Binding
    name: String
    value: Term

record Eqn
    lhs: Term
    rhs: Term

type Fin
    FBool
    FSum(List<String>)
    FRec(String, List<FinField>)
    FTuple(List<Fin>)

record FinField
    name: String
    fin: Fin

fn isHole(t: Term) -> Bool
    ? "Whether a term is the hole."
    match t
        Term.THole -> true
        _ -> false

verify isHole
    isHole(Term.THole) => true
    isHole(Term.TVar("x")) => false

fn bind(name: String, value: Term) -> Binding
    ? "One substitution entry."
    Binding(name = name, value = value)

verify bind
    bind("x", Term.TInt(1)) => Binding(name = "x", value = Term.TInt(1))

fn typed(name: String, ty: Ty) -> TypedVar
    ? "A variable with its type."
    TypedVar(name = name, ty = ty)

verify typed
    typed("n", Ty.TyInt) => TypedVar(name = "n", ty = Ty.TyInt)
