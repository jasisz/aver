module Prop11
    intent =
        "TIP prod prop_11: rev (rev x ++ rev y) = y ++ x."
    effects []

fn app(x: List<Int>, y: List<Int>) -> List<Int>
    match x
        [] -> y
        [z, ..xs] -> List.concat([z], app(xs, y))

fn rev(x: List<Int>) -> List<Int>
    match x
        [] -> []
        [y, ..xs] -> app(rev(xs), [y])

verify rev law revAppRev
    given x: List<Int> = [[], [1], [1, 2, 3]]
    given y: List<Int> = [[], [2], [4, 5]]
    rev(app(rev(x), rev(y))) => app(y, x)
