module Prop11
    intent =
        "TIP isaplanner prop_11: drop Z xs = xs."
    effects []

type Nat
    Z
    S(Nat)

fn drop(x: Nat, y: List<Int>) -> List<Int>
    match x
        Nat.Z -> y
        Nat.S(z) -> match y
            [] -> []
            [x2, ..x3] -> drop(z, x3)

verify drop law dropZero
    given xs: List<Int> = [[], [1], [1, 2, 3]]
    drop(Nat.Z, xs) => xs
