module Ledger
    intent = "The answers this program gives to Pool, Blocks and Chain: one state, pure transitions, plus the two ends of the validation job's seam."
    depends [Bytes, Wait, Pool, Blocks, Chain]
    exposes [State, fresh, patience, stopped, emptied, nothingPending, givenUp, blockOf, claim, claimIdle, waited, gone, without, keptUnlessKey, joined, swept, deliver, body, nextTarget, targetAbove, waiting, commit, nextTask, validated, accepted, validate, checked]
    effects []

record State
    idle: List<Int>
    busy: Map<Int, Int>
    nextHeight: Int
    lastHeight: Int
    queued: List<Tuple<Int, Bytes>>
    bodies: Map<Int, Bytes>
    tip: Int
    swept: Int
    idleClaims: Int
    left: Int
    rejected: List<String>

fn fresh() -> State
    ? "No peer has joined, nothing is fetched, nothing has been waited for and nobody has left, and the run is three blocks long."
    State(idle = [], busy = {}, nextHeight = 1, lastHeight = 3, queued = [], bodies = {}, tip = 0, swept = 0, idleClaims = 0, left = 0, rejected = [])

fn patience() -> Int
    ? "How many asks this pool answers with nobody idle before it gives up. Each one parks on a five-millisecond deadline, so this is a couple of seconds of waiting for a peer that may never connect: long enough for one that is on its way, short enough that a run nobody connects to still ends."
    400

fn stopped(state: State) -> Bool
    ? "Whether this pool will hand out no more work: every height has gone out, it spent its patience waiting for a peer to arrive, or every peer it seated has left it."
    Bool.or(state.nextHeight > state.lastHeight, Bool.or(state.idleClaims >= patience(), emptied(state)))

fn emptied(state: State) -> Bool
    ? "Whether the pool had peers and has none left. A peer that left is one this run is finished with, so a pool that has lost every peer it seated has nobody to hand a height to."
    Bool.and(state.left > 0, Bool.and(List.len(state.idle) == 0, Map.len(state.busy) == 0))

fn nothingPending(state: State) -> Bool
    ? "Nothing is on its way to the chain: no peer is fetching a body and nothing is waiting to be validated."
    Bool.and(Map.len(state.busy) == 0, List.len(state.queued) == 0)

fn givenUp(state: State) -> Bool
    ? "Whether nothing will ever validate the body the walk is waiting for: the pool hands out no more work, and nothing is pending that could still bring one."
    Bool.and(stopped(state), nothingPending(state))

fn blockOf(height: Int) -> Bytes
    ? "The body one height carries. A peer asks for exactly these bytes and hands exactly them back."
    String.toUtf8("block {height}")

fn claim(state: State) -> Tuple<State, Pool.__ClaimReply>
    ? "The next height for the next idle peer, Stop once this pool will hand out no more work, and a Later with a deadline while it is still waiting for a peer to take one."
    match stopped(state)
        true -> (state, Pool.__ClaimReply.Now(Pool.Assignment.Stop))
        false -> claimIdle(state, state.idle)

fn claimIdle(state: State, idle: List<Int>) -> Tuple<State, Pool.__ClaimReply>
    ? "One height handed to one idle peer. With nobody idle the ask parks on a deadline and spends one of the pool's asks: what frees a peer is another process, not this one, and a pool nobody ever connects to gives up rather than waiting for ever."
    match idle
        [] -> waited(State.update(state, idleClaims = state.idleClaims + 1))
        [key, ..rest] -> (State.update(state, idle = rest, busy = Map.set(state.busy, key, state.nextHeight), nextHeight = state.nextHeight + 1, idleClaims = 0), Pool.__ClaimReply.Now(Pool.Assignment.Work(key, state.nextHeight)))

fn waited(state: State) -> Tuple<State, Pool.__ClaimReply>
    ? "One ask answered with nobody idle, once it has been counted: Stop when that was the last of the pool's patience, a deadline while it has some left."
    match stopped(state)
        true -> (state, Pool.__ClaimReply.Now(Pool.Assignment.Stop))
        false -> (state, Pool.__ClaimReply.Later(Wait.Wake.After(5)))

fn gone(state: State, key: Int) -> Tuple<State, Pool.__GoneReply>
    ? "A peer that left: it holds no height any more, and it is not in the pool to be handed another one. The pool counts it, because a pool that has lost every peer it seated will hand out no more work and the chain above it has nothing left to wait for."
    (State.update(state, idle = without(state.idle, key, []), busy = Map.remove(state.busy, key), left = state.left + 1), Pool.__GoneReply.Now(Unit))

fn without(keys: List<Int>, key: Int, acc: List<Int>) -> List<Int>
    ? "The idle list with one peer taken out, in the order the rest of them joined."
    match keys
        [] -> acc
        [head, ..rest] -> without(rest, key, keptUnlessKey(acc, head, key))

fn keptUnlessKey(acc: List<Int>, candidate: Int, key: Int) -> List<Int>
    ? "One idle peer, kept unless it is the one that left."
    match candidate == key
        true -> acc
        false -> List.concat(acc, [candidate])

fn joined(state: State, key: Int) -> Tuple<State, Pool.__JoinedReply>
    ? "A peer that arrived, seated in the pool unless the pool is already full."
    match List.len(state.idle) + Map.len(state.busy) >= 4
        true -> (state, Pool.__JoinedReply.Now(Pool.Welcome.Refused))
        false -> (State.update(state, idle = List.concat(state.idle, [key])), Pool.__JoinedReply.Now(Pool.Welcome.Seated))

fn swept(state: State) -> Tuple<State, Pool.__SweptReply>
    ? "One sweep, answering how many peers were idle when it ran."
    (State.update(state, swept = state.swept + 1), Pool.__SweptReply.Now(Pool.Sweep.Swept(List.len(state.idle))))

fn deliver(state: State, key: Int, height: Int, block: Bytes) -> Tuple<State, Blocks.__DeliverReply>
    ? "A body handed over goes into the queue the job engine takes from. A Later while the queue is full, which is the backpressure: the peer waits rather than reading more."
    match List.len(state.queued) >= 2
        true -> (state, Blocks.__DeliverReply.Later(Wait.Wake.NextTurn))
        false -> (State.update(state, queued = List.concat(state.queued, [(height, block)]), idle = List.concat(state.idle, [key]), busy = Map.remove(state.busy, key)), Blocks.__DeliverReply.Now(Blocks.Receipt.Accepted))

fn body(state: State, height: Int) -> Tuple<State, Blocks.__BodyReply>
    ? "Knowledge: a Later until the body at this height is validated, a Now for ever after."
    match Map.get(state.bodies, height)
        Option.None -> (state, Blocks.__BodyReply.Later(Wait.Wake.NextTurn))
        Option.Some(block) -> (state, Blocks.__BodyReply.Now(block))

fn nextTarget(state: State) -> Tuple<State, Chain.__NextTargetReply>
    ? "Which height is next to connect: None once the chain is complete, the height above the tip once its body is validated, and a Later with a deadline while it is not."
    match state.tip >= state.lastHeight
        true -> (state, Chain.__NextTargetReply.Now(Option.None))
        false -> targetAbove(state, state.tip + 1)

fn targetAbove(state: State, height: Int) -> Tuple<State, Chain.__NextTargetReply>
    ? "The height above the tip, once something has validated its body."
    match Map.has(state.bodies, height)
        true -> (state, Chain.__NextTargetReply.Now(Option.Some(height)))
        false -> waiting(state)

fn waiting(state: State) -> Tuple<State, Chain.__NextTargetReply>
    ? "The body above the tip is not validated yet. While something may still bring it the walk parks on a deadline; once the pool has given up and nothing is pending, nothing ever will, and the chain ends where it stands rather than turning for ever."
    match givenUp(state)
        true -> (state, Chain.__NextTargetReply.Now(Option.None))
        false -> (state, Chain.__NextTargetReply.Later(Wait.Wake.After(2)))

fn commit(state: State, height: Int, summary: String) -> Tuple<State, Chain.__CommitReply>
    ? "The commit point: the tip moves by exactly one, or the height is rejected and the walk tries again against a new target."
    match height == state.tip + 1
        true -> (State.update(state, tip = height), Chain.__CommitReply.Now(Chain.Landed.Connected))
        false -> (state, Chain.__CommitReply.Now(Chain.Landed.Rejected("height {height} does not follow tip {state.tip}")))

fn nextTask(state: State) -> Option<Tuple<Int, Bytes>>
    ? "What the turn should start a validation job on, if anything. Named by aver.toml's task key."
    match state.queued
        [] -> Option.None
        [head, ..rest] -> Option.Some(head)

fn validated(state: State, outcome: Result<Int, String>) -> State
    ? "Where a validation that is over lands. Named by aver.toml's landed key. It resumes nobody: the peer that delivered this body moved on and its instance number changed. A validation that will never produce a height — cancelled, stopped, or forgotten by the engine — is recorded as a rejection instead, and the run goes on without it."
    match outcome
        Result.Err(reason) -> State.update(state, rejected = List.concat(state.rejected, [reason]))
        Result.Ok(height) -> accepted(state, height)

fn accepted(state: State, height: Int) -> State
    ? "A validation that produced a height: the body at that height is validated, and its entry leaves the queue. A height of zero is a body this program rejected, which validates nothing."
    match height == 0
        true -> state
        false -> State.update(state, bodies = Map.set(state.bodies, height, blockOf(height)), queued = withoutHeight(state.queued, height, []))

fn withoutHeight(queued: List<Tuple<Int, Bytes>>, height: Int, acc: List<Tuple<Int, Bytes>>) -> List<Tuple<Int, Bytes>>
    ? "The queue with every entry for one height taken out, in the order the rest were queued."
    match queued
        [] -> acc
        [head, ..rest] -> withoutHeight(rest, height, keptUnless(acc, head, height))

fn keptUnless(acc: List<Tuple<Int, Bytes>>, entry: Tuple<Int, Bytes>, height: Int) -> List<Tuple<Int, Bytes>>
    ? "One queued entry, kept unless it is the height that just landed."
    match entry
        (queuedHeight, _) -> match queuedHeight == height
            true -> acc
            false -> List.concat(acc, [entry])

fn validate(task: Tuple<Int, Bytes>) -> Int
    ? "The work one validation job does off the turn: the height whose body checked out, or 0 for a body that did not."
    match task
        (height, block) -> checked(height, Bytes.len(block))

fn checked(height: Int, size: Int) -> Int
    ? "A body of no bytes is no body; anything else stands for the height it was fetched for."
    match size == 0
        true -> 0
        false -> height

verify stopped
    stopped(fresh()) => false
    stopped(State.update(fresh(), nextHeight = 4)) => true
    stopped(State.update(fresh(), idleClaims = 400)) => true
    stopped(State.update(fresh(), left = 1)) => true
    stopped(State.update(fresh(), left = 1, idle = [7])) => false

verify emptied
    emptied(fresh()) => false
    emptied(State.update(fresh(), left = 1)) => true
    emptied(State.update(fresh(), left = 1, idle = [7])) => false
    emptied(State.update(fresh(), left = 1, busy = Map.set({}, 7, 1))) => false

verify nothingPending
    nothingPending(fresh()) => true
    nothingPending(State.update(fresh(), busy = Map.set({}, 7, 1))) => false
    nothingPending(State.update(fresh(), queued = [(1, blockOf(1))])) => false

verify givenUp
    givenUp(fresh()) => false
    givenUp(State.update(fresh(), nextHeight = 4)) => true
    givenUp(State.update(fresh(), nextHeight = 4, queued = [(1, blockOf(1))])) => false

verify claim
    claim(fresh()) => (State.update(fresh(), idleClaims = 1), Pool.__ClaimReply.Later(Wait.Wake.After(5)))
    claim(State.update(fresh(), nextHeight = 4)) => (State.update(fresh(), nextHeight = 4), Pool.__ClaimReply.Now(Pool.Assignment.Stop))
    claim(State.update(fresh(), idleClaims = 400)) => (State.update(fresh(), idleClaims = 400), Pool.__ClaimReply.Now(Pool.Assignment.Stop))

verify claimIdle
    claimIdle(fresh(), []) => (State.update(fresh(), idleClaims = 1), Pool.__ClaimReply.Later(Wait.Wake.After(5)))
    claimIdle(State.update(fresh(), idleClaims = 399), []) => (State.update(fresh(), idleClaims = 400), Pool.__ClaimReply.Now(Pool.Assignment.Stop))
    claimIdle(State.update(fresh(), idle = [7]), [7]) => (State.update(fresh(), idle = [], busy = Map.set({}, 7, 1), nextHeight = 2), Pool.__ClaimReply.Now(Pool.Assignment.Work(7, 1)))

verify waited
    waited(State.update(fresh(), idleClaims = 1)) => (State.update(fresh(), idleClaims = 1), Pool.__ClaimReply.Later(Wait.Wake.After(5)))
    waited(State.update(fresh(), idleClaims = 400)) => (State.update(fresh(), idleClaims = 400), Pool.__ClaimReply.Now(Pool.Assignment.Stop))

verify gone
    gone(State.update(fresh(), busy = Map.set({}, 7, 1)), 7) => (State.update(fresh(), left = 1), Pool.__GoneReply.Now(Unit))
    gone(State.update(fresh(), idle = [7, 8]), 7) => (State.update(fresh(), idle = [8], left = 1), Pool.__GoneReply.Now(Unit))

verify without
    without([], 7, []) => []
    without([7, 8], 7, []) => [8]
    without([8], 7, []) => [8]

verify keptUnlessKey
    keptUnlessKey([], 7, 7) => []
    keptUnlessKey([], 8, 7) => [8]

verify joined
    joined(fresh(), 7) => (State.update(fresh(), idle = [7]), Pool.__JoinedReply.Now(Pool.Welcome.Seated))
    joined(State.update(fresh(), idle = [1, 2, 3, 4]), 7) => (State.update(fresh(), idle = [1, 2, 3, 4]), Pool.__JoinedReply.Now(Pool.Welcome.Refused))

verify deliver
    deliver(fresh(), 7, 1, blockOf(1)) => (State.update(fresh(), queued = [(1, blockOf(1))], idle = [7]), Blocks.__DeliverReply.Now(Blocks.Receipt.Accepted))
    deliver(State.update(fresh(), queued = [(1, blockOf(1)), (2, blockOf(2))]), 7, 3, blockOf(3)) => (State.update(fresh(), queued = [(1, blockOf(1)), (2, blockOf(2))]), Blocks.__DeliverReply.Later(Wait.Wake.NextTurn))

verify body
    body(fresh(), 1) => (fresh(), Blocks.__BodyReply.Later(Wait.Wake.NextTurn))
    body(State.update(fresh(), bodies = Map.set({}, 1, blockOf(1))), 1) => (State.update(fresh(), bodies = Map.set({}, 1, blockOf(1))), Blocks.__BodyReply.Now(blockOf(1)))

verify nextTarget
    nextTarget(fresh()) => (fresh(), Chain.__NextTargetReply.Later(Wait.Wake.After(2)))
    nextTarget(State.update(fresh(), tip = 3)) => (State.update(fresh(), tip = 3), Chain.__NextTargetReply.Now(Option.None))

verify targetAbove
    targetAbove(fresh(), 1) => (fresh(), Chain.__NextTargetReply.Later(Wait.Wake.After(2)))
    targetAbove(State.update(fresh(), bodies = Map.set({}, 1, blockOf(1))), 1) => (State.update(fresh(), bodies = Map.set({}, 1, blockOf(1))), Chain.__NextTargetReply.Now(Option.Some(1)))

verify waiting
    waiting(fresh()) => (fresh(), Chain.__NextTargetReply.Later(Wait.Wake.After(2)))
    waiting(State.update(fresh(), left = 1)) => (State.update(fresh(), left = 1), Chain.__NextTargetReply.Now(Option.None))

verify commit
    commit(fresh(), 1, "7") => (State.update(fresh(), tip = 1), Chain.__CommitReply.Now(Chain.Landed.Connected))
    commit(fresh(), 3, "7") => (fresh(), Chain.__CommitReply.Now(Chain.Landed.Rejected("height 3 does not follow tip 0")))

verify nextTask
    nextTask(fresh()) => Option.None
    nextTask(State.update(fresh(), queued = [(1, blockOf(1))])) => Option.Some((1, blockOf(1)))

verify validated
    validated(State.update(fresh(), queued = [(1, blockOf(1))]), Result.Ok(1)) => State.update(fresh(), bodies = Map.set({}, 1, blockOf(1)))
    validated(State.update(fresh(), queued = [(1, blockOf(1))]), Result.Ok(0)) => State.update(fresh(), queued = [(1, blockOf(1))])
    validated(fresh(), Result.Err("work: job cancelled")) => State.update(fresh(), rejected = ["work: job cancelled"])

verify accepted
    accepted(State.update(fresh(), queued = [(1, blockOf(1))]), 1) => State.update(fresh(), bodies = Map.set({}, 1, blockOf(1)))
    accepted(State.update(fresh(), queued = [(1, blockOf(1))]), 0) => State.update(fresh(), queued = [(1, blockOf(1))])

verify withoutHeight
    withoutHeight([], 1, []) => []
    withoutHeight([(1, blockOf(1)), (2, blockOf(2))], 1, []) => [(2, blockOf(2))]

verify keptUnless
    keptUnless([], (1, blockOf(1)), 1) => []
    keptUnless([], (2, blockOf(2)), 1) => [(2, blockOf(2))]

verify validate
    validate((1, blockOf(1))) => 1

verify checked
    checked(1, 7) => 1
    checked(1, 0) => 0
