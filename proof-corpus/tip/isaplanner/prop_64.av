module Prop64
    intent =
        "TIP isaplanner prop_64: last (xs ++ [x]) = x."
    effects []

type Nat
    Z
    S(Nat)

fn last(x: List<Nat>) -> Nat
    match x
        [] -> Nat.Z
        [y, ..z] -> match z
            [] -> y
            [x2, ..x3] -> last(z)

verify last law lastAppendSingleton
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given xs: List<Nat> = [[], [Nat.Z], [Nat.S(Nat.Z), Nat.Z]]
    last(List.concat(xs, [x])) => x
