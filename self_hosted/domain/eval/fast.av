module Fast
    depends [Domain.Ast, Domain.Value, Domain.Eval.Common, Domain.Eval.Ops, Domain.Eval.Slots]
    intent =
        "Direct slot-based fast paths for the self-hosted evaluator."
        "Executes tiny leaf wrappers and fixed-shape branches without descending the full AST."
    exposes [runFastLeafSlot, fastBoolSlotBranch, fastEqIntBranch, fastEqStringBranch, fastLtIntSlotsBranch, fastListSlotBranch]
    effects []

fn runFastLeafSlot(leaf: FastLeaf, calleeEnv: Vector<Val>) -> Result<Val, String>
    ? "Execute a leaf-like fast path directly from slots."
    match leaf
        FastLeaf.LeafConstInt(n) -> Result.Ok(Val.ValInt(n))
        FastLeaf.LeafConstFloat(f) -> Result.Ok(Val.ValFloat(f))
        FastLeaf.LeafConstStr(s) -> Result.Ok(Val.ValStr(s))
        FastLeaf.LeafConstBool(b) -> Result.Ok(Val.ValBool(b))
        FastLeaf.LeafSlot(slot) -> Domain.Eval.Slots.lookupSlot(calleeEnv, slot)
        FastLeaf.LeafFieldAccess(slot, field) -> fastFieldAccessSlot(calleeEnv, slot, field)
        FastLeaf.LeafMapGet(mapSlot, keySlot) -> fastMapGetSlot(calleeEnv, mapSlot, keySlot)
        FastLeaf.LeafMapSet(mapSlot, keySlot, valueSlot) -> fastMapSetSlot(calleeEnv, mapSlot, keySlot, valueSlot)
        FastLeaf.LeafMapHas(mapSlot, keySlot) -> fastMapHasSlot(calleeEnv, mapSlot, keySlot)
        FastLeaf.LeafMapRemove(mapSlot, keySlot) -> fastMapRemoveSlot(calleeEnv, mapSlot, keySlot)
        FastLeaf.LeafVectorNew(sizeSlot, fill) -> fastVectorNewSlot(calleeEnv, sizeSlot, fill)
        FastLeaf.LeafVectorLen(vecSlot) -> fastVectorLenSlot(calleeEnv, vecSlot)
        FastLeaf.LeafVectorGetOrInt(vecSlot, idxSlot, defaultValue) -> fastVectorGetOrIntSlot(calleeEnv, vecSlot, idxSlot, defaultValue)
        FastLeaf.LeafBinopSlots(op, slotA, slotB) -> fastBinopSlots(calleeEnv, op, slotA, slotB)
        FastLeaf.LeafCmpSlots(op, slotA, slotB) -> fastCmpSlots(calleeEnv, op, slotA, slotB)

verify runFastLeafSlot
    runFastLeafSlot(FastLeaf.LeafConstInt(42), Vector.new(0, Val.ValUnit)) => Result.Ok(Val.ValInt(42))
    runFastLeafSlot(FastLeaf.LeafConstFloat(3.14), Vector.new(0, Val.ValUnit)) => Result.Ok(Val.ValFloat(3.14))
    runFastLeafSlot(FastLeaf.LeafConstStr("hi"), Vector.new(0, Val.ValUnit)) => Result.Ok(Val.ValStr("hi"))
    runFastLeafSlot(FastLeaf.LeafConstBool(true), Vector.new(0, Val.ValUnit)) => Result.Ok(Val.ValBool(true))
    runFastLeafSlot(FastLeaf.LeafSlot(0), Vector.fromList([Val.ValInt(7)])) => Result.Ok(Val.ValInt(7))
    runFastLeafSlot(FastLeaf.LeafFieldAccess(0, "x"), Vector.fromList([Val.ValRecord("R", [("x", Val.ValInt(5))])])) => Result.Ok(Val.ValInt(5))
    runFastLeafSlot(FastLeaf.LeafMapGet(0, 1), Vector.fromList([Val.ValMap(Map.set(Map.empty(), "k", Val.ValInt(9))), Val.ValStr("k")])) => Result.Ok(Val.ValSome(Val.ValInt(9)))
    runFastLeafSlot(FastLeaf.LeafMapSet(0, 1, 2), Vector.fromList([Val.ValMap(Map.empty()), Val.ValStr("k"), Val.ValInt(1)])) => Result.Ok(Val.ValMap(Map.set(Map.empty(), "k", Val.ValInt(1))))
    runFastLeafSlot(FastLeaf.LeafMapHas(0, 1), Vector.fromList([Val.ValMap(Map.empty()), Val.ValStr("k")])) => Result.Ok(Val.ValBool(false))
    runFastLeafSlot(FastLeaf.LeafMapRemove(0, 1), Vector.fromList([Val.ValMap(Map.set(Map.empty(), "k", Val.ValInt(1))), Val.ValStr("k")])) => Result.Ok(Val.ValMap(Map.empty()))
    runFastLeafSlot(FastLeaf.LeafVectorGetOrInt(0, 1, 99), Vector.fromList([Val.ValVector(Vector.fromList([Val.ValInt(42)])), Val.ValInt(0)])) => Result.Ok(Val.ValInt(42))
    runFastLeafSlot(FastLeaf.LeafBinopSlots(BinOp.OpAdd, 0, 1), Vector.fromList([Val.ValInt(3), Val.ValInt(4)])) => Result.Ok(Val.ValInt(7))
    runFastLeafSlot(FastLeaf.LeafCmpSlots(CmpOp.CmpEq, 0, 1), Vector.fromList([Val.ValInt(1), Val.ValInt(1)])) => Result.Ok(Val.ValBool(true))
    runFastLeafSlot(FastLeaf.LeafVectorNew(0, 0), Vector.fromList([Val.ValInt(3)])) => Result.Ok(Val.ValVector(Vector.new(3, Val.ValInt(0))))
    runFastLeafSlot(FastLeaf.LeafVectorLen(0), Vector.fromList([Val.ValVector(Vector.new(3, Val.ValInt(0)))])) => Result.Ok(Val.ValInt(3))
    runFastLeafSlot(FastLeaf.LeafSlot(0), Vector.new(0, Val.ValUnit)) => Result.Err("slot out of bounds: 0")

fn fastBoolSlotBranch(calleeEnv: Vector<Val>, slot: Int, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute a bool-slot branch with precomputed leaf results."
    slotV = Domain.Eval.Slots.lookupSlot(calleeEnv, slot)?
    match slotV
        Val.ValBool(cond) -> selectFastLeaf(cond, thenLeaf, elseLeaf, calleeEnv)
        _ -> Result.Err("fast bool branch expects Bool slot")

verify fastBoolSlotBranch
    fastBoolSlotBranch(Vector.fromList([Val.ValBool(true)]), 0, FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(2)) => Result.Ok(Val.ValInt(1))
    fastBoolSlotBranch(Vector.fromList([Val.ValBool(false)]), 0, FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(2)) => Result.Ok(Val.ValInt(2))
    fastBoolSlotBranch(Vector.fromList([Val.ValInt(1)]), 0, FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(2)) => Result.Err("fast bool branch expects Bool slot")

fn fastEqIntBranch(calleeEnv: Vector<Val>, slot: Int, expected: Int, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute an int equality branch with precomputed leaf results."
    slotV = Domain.Eval.Slots.lookupSlot(calleeEnv, slot)?
    match slotV
        Val.ValInt(actual) -> selectFastLeaf(actual == expected, thenLeaf, elseLeaf, calleeEnv)
        _ -> Result.Err("fast int branch expects Int slot")

verify fastEqIntBranch
    fastEqIntBranch(Vector.fromList([Val.ValInt(5)]), 0, 5, FastLeaf.LeafConstStr("yes"), FastLeaf.LeafConstStr("no")) => Result.Ok(Val.ValStr("yes"))
    fastEqIntBranch(Vector.fromList([Val.ValInt(3)]), 0, 5, FastLeaf.LeafConstStr("yes"), FastLeaf.LeafConstStr("no")) => Result.Ok(Val.ValStr("no"))
    fastEqIntBranch(Vector.fromList([Val.ValStr("x")]), 0, 5, FastLeaf.LeafConstStr("yes"), FastLeaf.LeafConstStr("no")) => Result.Err("fast int branch expects Int slot")

fn fastEqStringBranch(calleeEnv: Vector<Val>, slot: Int, expected: String, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute a string equality branch with precomputed leaf results."
    slotV = Domain.Eval.Slots.lookupSlot(calleeEnv, slot)?
    match slotV
        Val.ValStr(actual) -> selectFastLeaf(actual == expected, thenLeaf, elseLeaf, calleeEnv)
        _ -> Result.Err("fast string branch expects String slot")

verify fastEqStringBranch
    fastEqStringBranch(Vector.fromList([Val.ValStr("a")]), 0, "a", FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => Result.Ok(Val.ValInt(1))
    fastEqStringBranch(Vector.fromList([Val.ValStr("b")]), 0, "a", FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => Result.Ok(Val.ValInt(0))
    fastEqStringBranch(Vector.fromList([Val.ValInt(1)]), 0, "a", FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => Result.Err("fast string branch expects String slot")

fn fastLtIntSlotsBranch(calleeEnv: Vector<Val>, lhsSlot: Int, rhsSlot: Int, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute an int less-than branch with precomputed leaf results."
    lhsV = Domain.Eval.Slots.lookupSlot(calleeEnv, lhsSlot)?
    rhsV = Domain.Eval.Slots.lookupSlot(calleeEnv, rhsSlot)?
    match lhsV
        Val.ValInt(lhs) -> match rhsV
            Val.ValInt(rhs) -> selectFastLeaf(lhs < rhs, thenLeaf, elseLeaf, calleeEnv)
            _ -> Result.Err("fast lt branch expects Int rhs slot")
        _ -> Result.Err("fast lt branch expects Int lhs slot")

verify fastLtIntSlotsBranch
    fastLtIntSlotsBranch(Vector.fromList([Val.ValInt(1), Val.ValInt(5)]), 0, 1, FastLeaf.LeafConstStr("lt"), FastLeaf.LeafConstStr("gte")) => Result.Ok(Val.ValStr("lt"))
    fastLtIntSlotsBranch(Vector.fromList([Val.ValInt(5), Val.ValInt(1)]), 0, 1, FastLeaf.LeafConstStr("lt"), FastLeaf.LeafConstStr("gte")) => Result.Ok(Val.ValStr("gte"))
    fastLtIntSlotsBranch(Vector.fromList([Val.ValStr("x"), Val.ValInt(1)]), 0, 1, FastLeaf.LeafConstStr("lt"), FastLeaf.LeafConstStr("gte")) => Result.Err("fast lt branch expects Int lhs slot")

fn selectFastLeaf(cond: Bool, thenLeaf: FastLeaf, elseLeaf: FastLeaf, calleeEnv: Vector<Val>) -> Result<Val, String>
    ? "Choose and execute one of two leaf results."
    match cond
        true -> runFastLeafSlot(thenLeaf, calleeEnv)
        false -> runFastLeafSlot(elseLeaf, calleeEnv)

verify selectFastLeaf
    selectFastLeaf(true, FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(2), Vector.new(0, Val.ValUnit)) => Result.Ok(Val.ValInt(1))
    selectFastLeaf(false, FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(2), Vector.new(0, Val.ValUnit)) => Result.Ok(Val.ValInt(2))
    selectFastLeaf(true, FastLeaf.LeafSlot(0), FastLeaf.LeafConstInt(2), Vector.new(0, Val.ValUnit)) => Result.Err("slot out of bounds: 0")

fn fastListSlotBranch(calleeEnv: Vector<Val>, slot: Int, emptyLeaf: FastLeaf, headSlot: Int, tailSlot: Int, consLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute a two-arm [] / [h, ..t] list branch with precomputed leaf bodies."
    listV = Domain.Eval.Slots.lookupSlot(calleeEnv, slot)?
    match listV
        Val.ValList(items) -> fastListSlotBranchItems(items, calleeEnv, emptyLeaf, headSlot, tailSlot, consLeaf)
        _ -> Result.Err("no matching arm")

verify fastListSlotBranch
    fastListSlotBranch(Vector.fromList([Val.ValList([])]), 0, FastLeaf.LeafConstStr("empty"), 1, 2, FastLeaf.LeafConstStr("cons")) => Result.Ok(Val.ValStr("empty"))
    fastListSlotBranch(Vector.fromList([Val.ValInt(1)]), 0, FastLeaf.LeafConstStr("empty"), 1, 2, FastLeaf.LeafConstStr("cons")) => Result.Err("no matching arm")

fn fastListSlotBranchItems(items: List<Val>, calleeEnv: Vector<Val>, emptyLeaf: FastLeaf, headSlot: Int, tailSlot: Int, consLeaf: FastLeaf) -> Result<Val, String>
    ? "Finish [] / [h, ..t] list branching once the list payload is extracted."
    match items
        [] -> runFastLeafSlot(emptyLeaf, calleeEnv)
        [head, ..tail] -> runFastLeafSlot(consLeaf, Domain.Eval.Slots.setSlot(Domain.Eval.Slots.setSlot(calleeEnv, headSlot, head), tailSlot, Val.ValList(tail)))

verify fastListSlotBranchItems
    fastListSlotBranchItems([], Vector.new(3, Val.ValUnit), FastLeaf.LeafConstInt(0), 1, 2, FastLeaf.LeafConstInt(1)) => Result.Ok(Val.ValInt(0))
    fastListSlotBranchItems([Val.ValInt(10)], Vector.new(3, Val.ValUnit), FastLeaf.LeafConstInt(0), 1, 2, FastLeaf.LeafSlot(1)) => Result.Ok(Val.ValInt(10))
    fastListSlotBranchItems([], Vector.new(0, Val.ValUnit), FastLeaf.LeafSlot(0), 1, 2, FastLeaf.LeafConstInt(1)) => Result.Err("slot out of bounds: 0")

fn fastFieldAccessSlot(calleeEnv: Vector<Val>, slot: Int, field: String) -> Result<Val, String>
    ? "Read a record field directly from a resolved slot."
    recordV = Domain.Eval.Slots.lookupSlot(calleeEnv, slot)?
    match recordV
        Val.ValRecord(_, fields) -> Domain.Eval.Common.lookupField(fields, field)
        _ -> Result.Err("field access on non-record")

verify fastFieldAccessSlot
    fastFieldAccessSlot(Vector.fromList([Val.ValRecord("Foo", [("x", Val.ValInt(1))])]), 0, "x") => Result.Ok(Val.ValInt(1))
    fastFieldAccessSlot(Vector.fromList([Val.ValInt(5)]), 0, "x") => Result.Err("field access on non-record")

fn fastMapGetSlot(calleeEnv: Vector<Val>, mapSlot: Int, keySlot: Int) -> Result<Val, String>
    ? "Read a map key directly from resolved slots."
    mapV = Domain.Eval.Slots.lookupSlot(calleeEnv, mapSlot)?
    keyV = Domain.Eval.Slots.lookupSlot(calleeEnv, keySlot)?
    fastMapGetSlotInner(mapV, keyV)

verify fastMapGetSlot
    fastMapGetSlot(Vector.fromList([Val.ValMap(Map.set(Map.empty(), "k", Val.ValInt(9))), Val.ValStr("k")]), 0, 1) => Result.Ok(Val.ValSome(Val.ValInt(9)))
    fastMapGetSlot(Vector.fromList([Val.ValInt(1), Val.ValStr("k")]), 0, 1) => Result.Err("Map.get requires a Map")

fn fastMapGetSlotInner(mapV: Val, keyV: Val) -> Result<Val, String>
    ? "Look up a key in a ValMap without going through builtin dispatch."
    match mapV
        Val.ValMap(m) -> match Map.get(m, Domain.Value.mapKeyRepr(keyV))
            Option.Some(v) -> Result.Ok(Val.ValSome(v))
            Option.None -> Result.Ok(Val.ValNone)
        _ -> Result.Err("Map.get requires a Map")

verify fastMapGetSlotInner
    fastMapGetSlotInner(Val.ValMap(Map.set(Map.empty(), "a", Val.ValInt(1))), Val.ValStr("a")) => Result.Ok(Val.ValSome(Val.ValInt(1)))
    fastMapGetSlotInner(Val.ValMap(Map.empty()), Val.ValStr("x")) => Result.Ok(Val.ValNone)
    fastMapGetSlotInner(Val.ValInt(5), Val.ValStr("x")) => Result.Err("Map.get requires a Map")

fn fastMapSetSlot(calleeEnv: Vector<Val>, mapSlot: Int, keySlot: Int, valueSlot: Int) -> Result<Val, String>
    ? "Update a map directly from resolved slots."
    mapV = Domain.Eval.Slots.lookupSlot(calleeEnv, mapSlot)?
    keyV = Domain.Eval.Slots.lookupSlot(calleeEnv, keySlot)?
    valueV = Domain.Eval.Slots.lookupSlot(calleeEnv, valueSlot)?
    fastMapSetSlotInner(mapV, keyV, valueV)

verify fastMapSetSlot
    fastMapSetSlot(Vector.fromList([Val.ValMap(Map.empty()), Val.ValStr("k"), Val.ValInt(1)]), 0, 1, 2) => Result.Ok(Val.ValMap(Map.set(Map.empty(), "k", Val.ValInt(1))))
    fastMapSetSlot(Vector.fromList([Val.ValInt(1), Val.ValStr("k"), Val.ValInt(1)]), 0, 1, 2) => Result.Err("Map.set requires a Map")

fn fastMapSetSlotInner(mapV: Val, keyV: Val, valueV: Val) -> Result<Val, String>
    ? "Set a key in a ValMap without going through builtin dispatch."
    match mapV
        Val.ValMap(m) -> Result.Ok(Val.ValMap(Map.set(m, Domain.Value.mapKeyRepr(keyV), valueV)))
        _ -> Result.Err("Map.set requires a Map")

verify fastMapSetSlotInner
    fastMapSetSlotInner(Val.ValMap(Map.empty()), Val.ValStr("k"), Val.ValInt(9)) => Result.Ok(Val.ValMap(Map.set(Map.empty(), "k", Val.ValInt(9))))
    fastMapSetSlotInner(Val.ValInt(1), Val.ValStr("k"), Val.ValInt(9)) => Result.Err("Map.set requires a Map")

fn fastVectorNewSlot(calleeEnv: Vector<Val>, sizeSlot: Int, fill: Int) -> Result<Val, String>
    ? "Fast path for Vector.new(slot, int) wrappers."
    sizeV = Domain.Eval.Slots.lookupSlot(calleeEnv, sizeSlot)?
    fastVectorNewSlotInner(sizeV, fill)

verify fastVectorNewSlot
    fastVectorNewSlot(Vector.fromList([Val.ValInt(3)]), 0, 0) => Result.Ok(Val.ValVector(Vector.new(3, Val.ValInt(0))))
    fastVectorNewSlot(Vector.fromList([Val.ValStr("x")]), 0, 0) => Result.Err("Vector.new size must be Int")

fn fastVectorNewSlotInner(sizeV: Val, fill: Int) -> Result<Val, String>
    ? "Allocate a vector when the wrapper shape is known in advance."
    match sizeV
        Val.ValInt(size) -> Result.Ok(Val.ValVector(Vector.new(size, Val.ValInt(fill))))
        _ -> Result.Err("Vector.new size must be Int")

verify fastVectorNewSlotInner
    fastVectorNewSlotInner(Val.ValInt(2), 0) => Result.Ok(Val.ValVector(Vector.new(2, Val.ValInt(0))))
    fastVectorNewSlotInner(Val.ValStr("x"), 0) => Result.Err("Vector.new size must be Int")

fn fastVectorGetOrIntSlot(calleeEnv: Vector<Val>, vecSlot: Int, idxSlot: Int, defaultValue: Int) -> Result<Val, String>
    ? "Fast path for Option.withDefault(Vector.get(slotVec, slotIdx), int)."
    vecV = Domain.Eval.Slots.lookupSlot(calleeEnv, vecSlot)?
    idxV = Domain.Eval.Slots.lookupSlot(calleeEnv, idxSlot)?
    fastVectorGetOrIntSlotInner(vecV, idxV, defaultValue)

verify fastVectorGetOrIntSlot
    fastVectorGetOrIntSlot(Vector.fromList([Val.ValVector(Vector.fromList([Val.ValInt(42)])), Val.ValInt(0)]), 0, 1, 99) => Result.Ok(Val.ValInt(42))
    fastVectorGetOrIntSlot(Vector.fromList([Val.ValInt(1), Val.ValInt(0)]), 0, 1, 99) => Result.Err("Vector.get expects a Vector")

fn fastVectorGetOrIntSlotInner(vecV: Val, idxV: Val, defaultValue: Int) -> Result<Val, String>
    ? "Read a vector cell with an integer default without going through builtin dispatch."
    match vecV
        Val.ValVector(vec) -> match idxV
            Val.ValInt(idx) -> match Vector.get(vec, idx)
                Option.Some(v) -> Result.Ok(v)
                Option.None -> Result.Ok(Val.ValInt(defaultValue))
            _ -> Result.Err("Vector.get index must be Int")
        _ -> Result.Err("Vector.get expects a Vector")

verify fastVectorGetOrIntSlotInner
    fastVectorGetOrIntSlotInner(Val.ValVector(Vector.fromList([Val.ValInt(7)])), Val.ValInt(0), 99) => Result.Ok(Val.ValInt(7))
    fastVectorGetOrIntSlotInner(Val.ValVector(Vector.fromList([Val.ValInt(7)])), Val.ValInt(5), 99) => Result.Ok(Val.ValInt(99))
    fastVectorGetOrIntSlotInner(Val.ValInt(1), Val.ValInt(0), 99) => Result.Err("Vector.get expects a Vector")

fn fastMapHasSlot(calleeEnv: Vector<Val>, mapSlot: Int, keySlot: Int) -> Result<Val, String>
    ? "Check map membership directly from resolved slots."
    mapV = Domain.Eval.Slots.lookupSlot(calleeEnv, mapSlot)?
    keyV = Domain.Eval.Slots.lookupSlot(calleeEnv, keySlot)?
    match mapV
        Val.ValMap(m) -> Result.Ok(Val.ValBool(Map.has(m, Domain.Value.mapKeyRepr(keyV))))
        _ -> Result.Err("Map.has requires a Map")

verify fastMapHasSlot
    fastMapHasSlot(Vector.fromList([Val.ValMap(Map.set(Map.empty(), "k", Val.ValInt(1))), Val.ValStr("k")]), 0, 1) => Result.Ok(Val.ValBool(true))
    fastMapHasSlot(Vector.fromList([Val.ValMap(Map.empty()), Val.ValStr("k")]), 0, 1) => Result.Ok(Val.ValBool(false))
    fastMapHasSlot(Vector.fromList([Val.ValInt(1), Val.ValStr("k")]), 0, 1) => Result.Err("Map.has requires a Map")

fn fastMapRemoveSlot(calleeEnv: Vector<Val>, mapSlot: Int, keySlot: Int) -> Result<Val, String>
    ? "Remove a map key directly from resolved slots."
    mapV = Domain.Eval.Slots.lookupSlot(calleeEnv, mapSlot)?
    keyV = Domain.Eval.Slots.lookupSlot(calleeEnv, keySlot)?
    match mapV
        Val.ValMap(m) -> Result.Ok(Val.ValMap(Map.remove(m, Domain.Value.mapKeyRepr(keyV))))
        _ -> Result.Err("Map.remove requires a Map")

verify fastMapRemoveSlot
    fastMapRemoveSlot(Vector.fromList([Val.ValMap(Map.set(Map.empty(), "k", Val.ValInt(1))), Val.ValStr("k")]), 0, 1) => Result.Ok(Val.ValMap(Map.empty()))
    fastMapRemoveSlot(Vector.fromList([Val.ValInt(1), Val.ValStr("k")]), 0, 1) => Result.Err("Map.remove requires a Map")

fn fastVectorLenSlot(calleeEnv: Vector<Val>, vecSlot: Int) -> Result<Val, String>
    ? "Get vector length directly from a resolved slot."
    vecV = Domain.Eval.Slots.lookupSlot(calleeEnv, vecSlot)?
    match vecV
        Val.ValVector(vec) -> Result.Ok(Val.ValInt(Vector.len(vec)))
        _ -> Result.Err("Vector.len expects a Vector")

verify fastVectorLenSlot
    fastVectorLenSlot(Vector.fromList([Val.ValVector(Vector.new(3, Val.ValInt(0)))]), 0) => Result.Ok(Val.ValInt(3))
    fastVectorLenSlot(Vector.fromList([Val.ValInt(1)]), 0) => Result.Err("Vector.len expects a Vector")

fn fastBinopSlots(calleeEnv: Vector<Val>, op: BinOp, slotA: Int, slotB: Int) -> Result<Val, String>
    ? "Execute arithmetic on two slot values without entering the full eval."
    va = Domain.Eval.Slots.lookupSlot(calleeEnv, slotA)?
    vb = Domain.Eval.Slots.lookupSlot(calleeEnv, slotB)?
    Domain.Eval.Ops.evalBinopVals(va, vb, op)

verify fastBinopSlots
    fastBinopSlots(Vector.fromList([Val.ValInt(3), Val.ValInt(4)]), BinOp.OpAdd, 0, 1) => Result.Ok(Val.ValInt(7))
    fastBinopSlots(Vector.fromList([Val.ValInt(10), Val.ValInt(3)]), BinOp.OpSub, 0, 1) => Result.Ok(Val.ValInt(7))
    fastBinopSlots(Vector.fromList([Val.ValBool(true), Val.ValInt(1)]), BinOp.OpAdd, 0, 1) => Result.Err("binop type mismatch")

fn fastCmpSlots(calleeEnv: Vector<Val>, op: CmpOp, slotA: Int, slotB: Int) -> Result<Val, String>
    ? "Execute comparison on two slot values without entering the full eval."
    va = Domain.Eval.Slots.lookupSlot(calleeEnv, slotA)?
    vb = Domain.Eval.Slots.lookupSlot(calleeEnv, slotB)?
    Domain.Eval.Ops.evalCmpVals(va, vb, op)

verify fastCmpSlots
    fastCmpSlots(Vector.fromList([Val.ValInt(1), Val.ValInt(2)]), CmpOp.CmpLt, 0, 1) => Result.Ok(Val.ValBool(true))
    fastCmpSlots(Vector.fromList([Val.ValInt(3), Val.ValInt(3)]), CmpOp.CmpEq, 0, 1) => Result.Ok(Val.ValBool(true))
    fastCmpSlots(Vector.fromList([Val.ValNone, Val.ValNone]), CmpOp.CmpLt, 0, 1) => Result.Err("comparison not supported for these types")
