module Parser
    intent =
        "Recursive descent parser for the mini Aver subset."
        "Transforms a token list into an AST Program."
        "Stateless: each parse function takes (tokens, pos) and returns Result<(result, pos), String>."
    depends [Domain.Token, Domain.Lexer, Domain.Ast]
    exposes [parse]

// ─── Token access helpers ───────────────────────────────────

fn tokenAt(tokens: List<Token>, pos: Int) -> Token
    ? "Token at position, or TkEof if past end."
    Option.withDefault(List.get(tokens, pos), Token.TkEof)

fn isToken(t: Token, expected: Token) -> Bool
    ? "Check if token matches expected (structural equality via repr)."
    Domain.Token.tokenRepr(t) == Domain.Token.tokenRepr(expected)

fn expect(tokens: List<Token>, pos: Int, expected: Token) -> Result<Int, String>
    ? "Consume expected token, return new position."
    t = tokenAt(tokens, pos)
    match isToken(t, expected)
        true -> Result.Ok(pos + 1)
        false -> Result.Err("Expected {Domain.Token.tokenRepr(expected)}, got {Domain.Token.tokenRepr(t)}")

fn skipNewlines(tokens: List<Token>, pos: Int) -> Int
    ? "Skip past any newline tokens."
    match tokenAt(tokens, pos)
        Token.TkNewline -> skipNewlines(tokens, pos + 1)
        _ -> pos

// ─── Pattern parsing ────────────────────────────────────────

fn parsePattern(tokens: List<Token>, pos: Int) -> Result<(Pattern, Int), String>
    ? "Parse a match pattern: INT literal, _ (wildcard), or variable."
    t = tokenAt(tokens, pos)
    match t
        Token.TkInt(n) -> Result.Ok((Pattern.PatInt(n), pos + 1))
        Token.TkTrue -> Result.Ok((Pattern.PatBool(true), pos + 1))
        Token.TkFalse -> Result.Ok((Pattern.PatBool(false), pos + 1))
        Token.TkLBracket -> parseListPattern(tokens, pos + 1)
        Token.TkLParen -> parseTuplePattern(tokens, pos + 1)
        Token.TkIdent(s) -> parseIdentPattern(tokens, pos + 1, s)
        _ -> Result.Err("Expected pattern, got {Domain.Token.tokenRepr(t)}")

fn parseIdentPattern(tokens: List<Token>, pos: Int, name: String) -> Result<(Pattern, Int), String>
    ? "Parse ident pattern: wildcard _, variable, or constructor Foo.Bar(bindings)."
    match name == "_"
        true -> Result.Ok((Pattern.PatWild, pos))
        false -> parseIdentPatternMaybeConstructor(tokens, pos, name)

fn parseIdentPatternMaybeConstructor(tokens: List<Token>, pos: Int, name: String) -> Result<(Pattern, Int), String>
    ? "Check for constructor pattern: Name(binding) or plain variable."
    match tokenAt(tokens, pos)
        Token.TkLParen -> parseConstructorPatternBindings(tokens, pos + 1, name, [])
        _ -> Result.Ok((Pattern.PatVar(name), pos))

fn parseConstructorPatternBindings(tokens: List<Token>, pos: Int, name: String, acc: List<String>) -> Result<(Pattern, Int), String>
    ? "Parse bindings inside constructor pattern: Ctor(a, b) or Ctor()."
    match tokenAt(tokens, pos)
        Token.TkRParen -> Result.Ok((Pattern.PatConstructor(name, acc), pos + 1))
        Token.TkIdent(binding) -> parseConstructorPatternTail(tokens, pos + 1, name, List.append(acc, binding))
        _ -> Result.Err("Expected binding or ')' in constructor pattern")

fn parseConstructorPatternTail(tokens: List<Token>, pos: Int, name: String, acc: List<String>) -> Result<(Pattern, Int), String>
    ? "After binding: ',' for more or ')' to end."
    match tokenAt(tokens, pos)
        Token.TkComma -> parseConstructorPatternBindings(tokens, pos + 1, name, acc)
        Token.TkRParen -> Result.Ok((Pattern.PatConstructor(name, acc), pos + 1))
        _ -> Result.Err("Expected ',' or ')' in constructor pattern")

fn parseTuplePattern(tokens: List<Token>, pos: Int) -> Result<(Pattern, Int), String>
    ? "Parse tuple pattern: (a, b, ...)."
    match tokenAt(tokens, pos)
        Token.TkIdent(name) -> parseTuplePatternTail(tokens, pos + 1, [name])
        _ -> Result.Err("Expected binding name in tuple pattern")

fn parseTuplePatternTail(tokens: List<Token>, pos: Int, acc: List<String>) -> Result<(Pattern, Int), String>
    ? "After binding in tuple pattern: ',' for more or ')' to end."
    match tokenAt(tokens, pos)
        Token.TkComma -> parseTuplePatternNext(tokens, pos + 1, acc)
        Token.TkRParen -> Result.Ok((Pattern.PatTuple(acc), pos + 1))
        _ -> Result.Err("Expected ',' or ')' in tuple pattern")

fn parseTuplePatternNext(tokens: List<Token>, pos: Int, acc: List<String>) -> Result<(Pattern, Int), String>
    ? "Parse next binding in tuple pattern."
    match tokenAt(tokens, pos)
        Token.TkIdent(name) -> parseTuplePatternTail(tokens, pos + 1, List.append(acc, name))
        _ -> Result.Err("Expected binding name in tuple pattern")

fn parseListPattern(tokens: List<Token>, pos: Int) -> Result<(Pattern, Int), String>
    ? "Parse [] or [h, ..t] list pattern."
    match tokenAt(tokens, pos)
        Token.TkRBracket -> Result.Ok((Pattern.PatEmpty, pos + 1))
        Token.TkIdent(head) -> parseConsPattern(tokens, pos + 1, head)
        _ -> Result.Err("Expected identifier or ']' in list pattern")

fn parseConsPattern(tokens: List<Token>, pos: Int, head: String) -> Result<(Pattern, Int), String>
    ? "Parse [h, ..t] after reading head ident."
    pos2 = expect(tokens, pos, Token.TkComma)?
    pos3 = expect(tokens, pos2, Token.TkDotDot)?
    t = tokenAt(tokens, pos3)
    match t
        Token.TkIdent(tail) -> Result.Ok((Pattern.PatCons(head, tail), expect(tokens, pos3 + 1, Token.TkRBracket)?))
        _ -> Result.Err("Expected tail identifier in cons pattern")

// ─── Expression parsing (precedence climbing) ──────────────

fn parseExpr(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse an expression: comparison level, then optional ? postfix."
    r = parseCmpExpr(tokens, pos)?
    match r
        (expr, pos2) -> parsePostfixQuestion(tokens, pos2, expr)

fn parsePostfixQuestion(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Expr, Int), String>
    ? "Check for postfix ? (error propagation)."
    match tokenAt(tokens, pos)
        Token.TkQuestion -> Result.Ok((Expr.ExprPropagate(expr), pos + 1))
        _ -> Result.Ok((expr, pos))

fn parseCmpExpr(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse comparison: addExpr (('==' | '<' | '>') addExpr)?"
    r = parseAddExpr(tokens, pos)?
    match r
        (left, pos2) -> parseCmpExprTail(tokens, pos2, left)

fn parseCmpExprTail(tokens: List<Token>, pos: Int, left: Expr) -> Result<(Expr, Int), String>
    ? "Check for comparison operator."
    match tokenAt(tokens, pos)
        Token.TkEqEq -> parseCmpExprRight(tokens, pos + 1, left, 0)
        Token.TkNeq -> parseCmpExprRight(tokens, pos + 1, left, 1)
        Token.TkLt -> parseCmpExprRight(tokens, pos + 1, left, 2)
        Token.TkGt -> parseCmpExprRight(tokens, pos + 1, left, 3)
        Token.TkLte -> parseCmpExprRight(tokens, pos + 1, left, 4)
        Token.TkGte -> parseCmpExprRight(tokens, pos + 1, left, 5)
        _ -> Result.Ok((left, pos))

fn parseCmpExprRight(tokens: List<Token>, pos: Int, left: Expr, op: Int) -> Result<(Expr, Int), String>
    ? "Parse right side of comparison."
    r = parseAddExpr(tokens, pos)?
    match r
        (right, pos2) -> buildCmpExpr(left, right, pos2, op)

fn buildCmpExpr(left: Expr, right: Expr, pos: Int, op: Int) -> Result<(Expr, Int), String>
    ? "Build comparison AST node from op code."
    match op
        0 -> Result.Ok((Expr.ExprEq(left, right), pos))
        1 -> Result.Ok((Expr.ExprNeq(left, right), pos))
        2 -> Result.Ok((Expr.ExprLt(left, right), pos))
        3 -> Result.Ok((Expr.ExprGt(left, right), pos))
        4 -> Result.Ok((Expr.ExprLte(left, right), pos))
        _ -> Result.Ok((Expr.ExprGte(left, right), pos))

fn parseAddExpr(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse additive: mulExpr (('+' | '-') mulExpr)*"
    r = parseMulExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseAddExprTail(tokens, pos2, expr)

fn parseAddExprTail(tokens: List<Token>, pos: Int, left: Expr) -> Result<(Expr, Int), String>
    ? "Continue parsing additive operators."
    t = tokenAt(tokens, pos)
    match t
        Token.TkPlus -> parseAddExprRight(tokens, pos + 1, left, 0)
        Token.TkMinus -> parseAddExprRight(tokens, pos + 1, left, 1)
        _ -> Result.Ok((left, pos))

fn parseAddExprRight(tokens: List<Token>, pos: Int, left: Expr, op: Int) -> Result<(Expr, Int), String>
    ? "Parse right side of additive op."
    r = parseMulExpr(tokens, pos)?
    match r
        (right, pos2) -> match op == 0
            true -> parseAddExprTail(tokens, pos2, Expr.ExprAdd(left, right))
            false -> parseAddExprTail(tokens, pos2, Expr.ExprSub(left, right))

fn parseMulExpr(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse multiplicative: atom ('*' atom)*"
    r = parseAtom(tokens, pos)?
    match r
        (expr, pos2) -> parseMulExprTail(tokens, pos2, expr)

fn parseMulExprTail(tokens: List<Token>, pos: Int, left: Expr) -> Result<(Expr, Int), String>
    ? "Continue parsing multiplicative operators."
    match tokenAt(tokens, pos)
        Token.TkStar -> parseMulExprRight(tokens, pos + 1, left, 0)
        Token.TkSlash -> parseMulExprRight(tokens, pos + 1, left, 1)
        _ -> Result.Ok((left, pos))

fn parseMulExprRight(tokens: List<Token>, pos: Int, left: Expr, op: Int) -> Result<(Expr, Int), String>
    ? "Parse right side of mul/div op."
    r = parseAtom(tokens, pos)?
    match r
        (right, pos2) -> match op == 0
            true -> parseMulExprTail(tokens, pos2, Expr.ExprMul(left, right))
            false -> parseMulExprTail(tokens, pos2, Expr.ExprDiv(left, right))

fn parseAtom(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse atomic expression: literal, variable, call, match, or parenthesized."
    t = tokenAt(tokens, pos)
    match t
        Token.TkMinus -> parseNegAtom(tokens, pos + 1)
        Token.TkInt(n) -> Result.Ok((Expr.ExprInt(n), pos + 1))
        Token.TkStr(s) -> parseStringOrInterp(tokens, pos + 1, s)
        Token.TkTrue -> Result.Ok((Expr.ExprBool(true), pos + 1))
        Token.TkFalse -> Result.Ok((Expr.ExprBool(false), pos + 1))
        Token.TkLBracket -> parseListExpr(tokens, pos + 1)
        Token.TkLParen -> parseParenExpr(tokens, pos + 1)
        Token.TkMatch -> parseMatchExpr(tokens, pos + 1)
        Token.TkIdent(name) -> parseIdentOrCall(tokens, pos + 1, name)
        _ -> Result.Err("Expected expression, got {Domain.Token.tokenRepr(t)}")

fn parseStringOrInterp(tokens: List<Token>, pos: Int, prefix: String) -> Result<(Expr, Int), String>
    ? "After TkStr: check for interpolation (TkInterpStart) or plain string."
    match tokenAt(tokens, pos)
        Token.TkInterpStart -> parseInterpParts(tokens, pos + 1, [Expr.ExprStr(prefix)])
        _ -> Result.Ok((Expr.ExprStr(prefix), pos))

fn parseInterpParts(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<(Expr, Int), String>
    ? "Parse interpolation parts: expressions between TkInterpStart/TkInterpEnd and TkStr segments."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseInterpAfterExpr(tokens, pos2, List.append(acc, expr))

fn parseInterpAfterExpr(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<(Expr, Int), String>
    ? "After interpolation expr: expect TkInterpEnd, then maybe more string."
    match tokenAt(tokens, pos)
        Token.TkInterpEnd -> parseInterpContinue(tokens, pos + 1, acc)
        _ -> Result.Err("Expected } in string interpolation")

fn parseInterpContinue(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<(Expr, Int), String>
    ? "After }: next TkStr continues, or end of string."
    match tokenAt(tokens, pos)
        Token.TkStr(s) -> parseInterpAfterStr(tokens, pos + 1, List.append(acc, Expr.ExprStr(s)))
        Token.TkInterpStart -> parseInterpParts(tokens, pos + 1, acc)
        _ -> Result.Ok((Expr.ExprConcat(acc), pos))

fn parseInterpAfterStr(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<(Expr, Int), String>
    ? "After string segment: more interpolation or end."
    match tokenAt(tokens, pos)
        Token.TkInterpStart -> parseInterpParts(tokens, pos + 1, acc)
        _ -> Result.Ok((Expr.ExprConcat(acc), pos))

fn parseNegAtom(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse unary minus: -expr → 0 - expr."
    r = parseAtom(tokens, pos)?
    match r
        (expr, pos2) -> Result.Ok((Expr.ExprSub(Expr.ExprInt(0), expr), pos2))

fn parseListExpr(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse list literal: [expr, expr, ...] or []."
    match tokenAt(tokens, pos)
        Token.TkRBracket -> Result.Ok((Expr.ExprList([]), pos + 1))
        _ -> parseListItems(tokens, pos, [])

fn parseListItems(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<(Expr, Int), String>
    ? "Parse comma-separated list items."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseListItemsTail(tokens, pos2, List.append(acc, expr))

fn parseListItemsTail(tokens: List<Token>, pos: Int, items: List<Expr>) -> Result<(Expr, Int), String>
    ? "After a list item: ',' for more or ']' to end."
    match tokenAt(tokens, pos)
        Token.TkComma -> parseListItems(tokens, pos + 1, items)
        Token.TkRBracket -> Result.Ok((Expr.ExprList(items), pos + 1))
        _ -> Result.Err("Expected ',' or ']' in list literal")

fn parseParenExpr(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse parenthesized expression or tuple."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> match tokenAt(tokens, pos2)
            Token.TkComma -> parseTupleRest(tokens, pos2 + 1, [expr])
            Token.TkRParen -> Result.Ok((expr, pos2 + 1))
            _ -> Result.Err("Expected ')' or ',' after expression")

fn parseTupleRest(tokens: List<Token>, pos: Int, acc: List<Expr>) -> Result<(Expr, Int), String>
    ? "Parse remaining tuple elements after first comma."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseTupleRestTail(tokens, pos2, List.append(acc, expr))

fn parseTupleRestTail(tokens: List<Token>, pos: Int, items: List<Expr>) -> Result<(Expr, Int), String>
    ? "After tuple element: ',' for more or ')' to end."
    match tokenAt(tokens, pos)
        Token.TkComma -> parseTupleRest(tokens, pos + 1, items)
        Token.TkRParen -> Result.Ok((Expr.ExprTuple(items), pos + 1))
        _ -> Result.Err("Expected ')' or ',' in tuple")

fn parseIdentOrCall(tokens: List<Token>, pos: Int, name: String) -> Result<(Expr, Int), String>
    ? "After reading an identifier: call, record constructor, field access, or variable?"
    match tokenAt(tokens, pos)
        Token.TkLParen -> parseCallOrRecord(tokens, pos + 1, name)
        Token.TkDot -> parseFieldAccess(tokens, pos + 1, Expr.ExprVar(name))
        _ -> Result.Ok((Expr.ExprVar(name), pos))

fn parseFieldAccess(tokens: List<Token>, pos: Int, obj: Expr) -> Result<(Expr, Int), String>
    ? "Parse .field after an expression."
    match tokenAt(tokens, pos)
        Token.TkIdent(field) -> parseFieldAccessTail(tokens, pos + 1, Expr.ExprFieldAccess(obj, field))
        _ -> Result.Err("Expected field name after '.'")

fn parseFieldAccessTail(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Expr, Int), String>
    ? "Check for chained field access."
    match tokenAt(tokens, pos)
        Token.TkDot -> parseFieldAccess(tokens, pos + 1, expr)
        _ -> Result.Ok((expr, pos))

fn parseCallOrRecord(tokens: List<Token>, pos: Int, name: String) -> Result<(Expr, Int), String>
    ? "After '(': is this a function call f(args) or record Foo(field = val)?"
    match tokenAt(tokens, pos)
        Token.TkRParen -> Result.Ok((Expr.ExprCall(name, []), pos + 1))
        Token.TkIdent(first) -> parseCallOrRecordLookahead(tokens, pos, name, first)
        _ -> parseCallArgsList(tokens, pos, name, [])

fn parseCallOrRecordLookahead(tokens: List<Token>, pos: Int, name: String, first: String) -> Result<(Expr, Int), String>
    ? "Lookahead after first ident in parens: '=' means record, otherwise call."
    match tokenAt(tokens, pos + 1)
        Token.TkEq -> parseRecordFields(tokens, pos, name, [])
        _ -> parseCallArgsList(tokens, pos, name, [])

fn parseRecordFields(tokens: List<Token>, pos: Int, name: String, acc: List<(String, Expr)>) -> Result<(Expr, Int), String>
    ? "Parse record fields: field = expr, ..."
    match tokenAt(tokens, pos)
        Token.TkIdent(field) -> parseRecordField(tokens, pos + 1, name, acc, field)
        _ -> Result.Err("Expected field name in record constructor")

fn parseRecordField(tokens: List<Token>, pos: Int, name: String, acc: List<(String, Expr)>, field: String) -> Result<(Expr, Int), String>
    ? "Parse = expr after field name."
    pos2 = expect(tokens, pos, Token.TkEq)?
    r = parseExpr(tokens, pos2)?
    match r
        (expr, pos3) -> parseRecordFieldsTail(tokens, pos3, name, List.append(acc, (field, expr)))

fn parseRecordFieldsTail(tokens: List<Token>, pos: Int, name: String, fields: List<(String, Expr)>) -> Result<(Expr, Int), String>
    ? "After a field: ',' for more or ')' to end."
    match tokenAt(tokens, pos)
        Token.TkComma -> parseRecordFields(tokens, pos + 1, name, fields)
        Token.TkRParen -> Result.Ok((Expr.ExprRecord(name, fields), pos + 1))
        _ -> Result.Err("Expected ',' or ')' in record constructor")

fn parseCallArgs(tokens: List<Token>, pos: Int, name: String) -> Result<(Expr, Int), String>
    ? "Parse function call arguments: expr (',' expr)* ')'"
    match tokenAt(tokens, pos)
        Token.TkRParen -> Result.Ok((Expr.ExprCall(name, []), pos + 1))
        _ -> parseCallArgsList(tokens, pos, name, [])

fn parseCallArgsList(tokens: List<Token>, pos: Int, name: String, acc: List<Expr>) -> Result<(Expr, Int), String>
    ? "Parse comma-separated argument list."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> parseCallArgsListTail(tokens, pos2, name, List.append(acc, expr))

fn parseCallArgsListTail(tokens: List<Token>, pos: Int, name: String, args: List<Expr>) -> Result<(Expr, Int), String>
    ? "After an argument: ',' for more or ')' to end."
    match tokenAt(tokens, pos)
        Token.TkComma -> parseCallArgsList(tokens, pos + 1, name, args)
        Token.TkRParen -> Result.Ok((Expr.ExprCall(name, args), pos + 1))
        _ -> Result.Err("Expected ',' or ')' in argument list")

// ─── Match expression ───────────────────────────────────────

fn parseMatchExpr(tokens: List<Token>, pos: Int) -> Result<(Expr, Int), String>
    ? "Parse: match expr NEWLINE arms"
    r = parseExpr(tokens, pos)?
    match r
        (subject, pos2) -> parseMatchArms(tokens, skipNewlines(tokens, pos2), subject, [])

fn isArmStart(tokens: List<Token>, pos: Int) -> Bool
    ? "Check if position looks like a match arm: pattern followed by '->'."
    t = tokenAt(tokens, pos)
    match t
        Token.TkInt(_) -> isArrow(tokens, pos + 1)
        Token.TkTrue -> isArrow(tokens, pos + 1)
        Token.TkFalse -> isArrow(tokens, pos + 1)
        Token.TkLBracket -> true
        Token.TkLParen -> true
        Token.TkIdent(name) -> isArmStartIdent(tokens, pos + 1, name)
        _ -> false

fn isArmStartIdent(tokens: List<Token>, pos: Int, name: String) -> Bool
    ? "After ident in arm: arrow (var/wildcard), or '(' for uppercase (constructor)."
    match tokenAt(tokens, pos)
        Token.TkArrow -> true
        Token.TkLParen -> isUpperStart(name)
        _ -> false

fn isUpperStart(name: String) -> Bool
    ? "Check if name starts with uppercase letter."
    match String.charAt(name, 0)
        Option.Some(c) -> match c >= "A"
            true -> c <= "Z"
            false -> false
        Option.None -> false

fn isArrow(tokens: List<Token>, pos: Int) -> Bool
    ? "Check if token at pos is an arrow."
    match tokenAt(tokens, pos)
        Token.TkArrow -> true
        _ -> false

fn parseMatchArms(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>) -> Result<(Expr, Int), String>
    ? "Parse match arms until no more 'pattern ->' found."
    match isArmStart(tokens, pos)
        true -> parseOneArm(tokens, pos, subject, acc)
        false -> match List.len(acc) == 0
            true -> Result.Err("Expected at least one match arm")
            false -> Result.Ok((Expr.ExprMatch(subject, acc), pos))

fn parseOneArm(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>) -> Result<(Expr, Int), String>
    ? "Parse one match arm: pattern '->' expr NEWLINE"
    pr = parsePattern(tokens, pos)?
    match pr
        (pat, pos2) -> parseOneArmBody(tokens, pos2, subject, acc, pat)

fn parseOneArmBody(tokens: List<Token>, pos: Int, subject: Expr, acc: List<MatchArm>, pat: Pattern) -> Result<(Expr, Int), String>
    ? "Parse arrow and body of a match arm."
    pos2 = expect(tokens, pos, Token.TkArrow)?
    er = parseExpr(tokens, pos2)?
    match er
        (body, pos3) -> parseMatchArms(tokens, skipNewlines(tokens, pos3), subject, List.append(acc, MatchArm(pattern = pat, body = body)))

// ─── Statement parsing ──────────────────────────────────────

fn parseStmt(tokens: List<Token>, pos: Int) -> Result<(Stmt, Int), String>
    ? "Parse a statement: binding (name = expr) or expression."
    t = tokenAt(tokens, pos)
    match t
        Token.TkIdent(name) -> parseStmtAfterIdent(tokens, pos + 1, name)
        _ -> parseStmtExpr(tokens, pos)

fn parseStmtAfterIdent(tokens: List<Token>, pos: Int, name: String) -> Result<(Stmt, Int), String>
    ? "After ident: if '=' or ':' follows it's a binding, otherwise reparse as expr."
    match tokenAt(tokens, pos)
        Token.TkEq -> parseBinding(tokens, pos + 1, name)
        Token.TkColon -> parseBinding(tokens, skipTypeAnnotationAndEq(tokens, pos), name)
        _ -> parseStmtExprFrom(tokens, pos, name)

fn skipTypeAnnotationAndEq(tokens: List<Token>, pos: Int) -> Int
    ? "Skip : Type = and return position after =."
    pos2 = skipTypeAnnotation(tokens, pos)
    match tokenAt(tokens, pos2)
        Token.TkEq -> pos2 + 1
        _ -> pos2

fn parseBinding(tokens: List<Token>, pos: Int, name: String) -> Result<(Stmt, Int), String>
    ? "Parse: name = expr"
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> Result.Ok((Stmt.StmtBind(name, expr), pos2))

fn parseStmtExpr(tokens: List<Token>, pos: Int) -> Result<(Stmt, Int), String>
    ? "Parse an expression statement."
    r = parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> Result.Ok((Stmt.StmtExpr(expr), pos2))

fn parseStmtExprFrom(tokens: List<Token>, pos: Int, name: String) -> Result<(Stmt, Int), String>
    ? "Reparse as expression starting from an identifier (might be call or var in expr)."
    ir = parseIdentOrCall(tokens, pos, name)?
    match ir
        (expr, pos2) -> parseStmtExprFromMul(tokens, pos2, expr)

fn parseStmtExprFromMul(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Stmt, Int), String>
    ? "Continue parsing expression statement from multiplicative level."
    mr = parseMulExprTail(tokens, pos, expr)?
    match mr
        (expr2, pos2) -> parseStmtExprFromAdd(tokens, pos2, expr2)

fn parseStmtExprFromAdd(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Stmt, Int), String>
    ? "Continue parsing expression statement from additive level."
    ar = parseAddExprTail(tokens, pos, expr)?
    match ar
        (expr2, pos2) -> parseStmtExprFromCmp(tokens, pos2, expr2)

fn parseStmtExprFromCmp(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Stmt, Int), String>
    ? "Continue parsing expression statement from comparison level."
    cr = parseCmpExprTail(tokens, pos, expr)?
    match cr
        (expr2, pos2) -> parseStmtExprFromQ(tokens, pos2, expr2)

fn parseStmtExprFromQ(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Stmt, Int), String>
    ? "Check for postfix ? on expression statement."
    qr = parsePostfixQuestion(tokens, pos, expr)?
    match qr
        (expr2, pos2) -> Result.Ok((Stmt.StmtExpr(expr2), pos2))

// ─── Function definition ────────────────────────────────────

fn parseFnDef(tokens: List<Token>, pos: Int) -> Result<(FnDef, Int), String>
    ? "Parse: fn NAME(params) NEWLINE body"
    t = tokenAt(tokens, pos)
    match t
        Token.TkIdent(name) -> parseFnDefParams(tokens, pos + 1, name)
        _ -> Result.Err("Expected function name after 'fn'")

fn parseFnDefParams(tokens: List<Token>, pos: Int, name: String) -> Result<(FnDef, Int), String>
    ? "Parse parameter list and body."
    pos2 = expect(tokens, pos, Token.TkLParen)?
    pr = parseParamList(tokens, pos2, [])?
    match pr
        (params, pos3) -> parseFnDefBody(tokens, pos3, name, params)

fn parseFnDefBody(tokens: List<Token>, pos: Int, name: String, params: List<String>) -> Result<(FnDef, Int), String>
    ? "Parse function body: skip return type, ?, !, then statements."
    pos2 = skipReturnType(tokens, pos)
    pos3 = expect(tokens, pos2, Token.TkNewline)?
    pos4 = skipDescAndEffects(tokens, pos3)
    sr = parseFnBodyStmts(tokens, pos4, [])?
    match sr
        (stmts, pos4) -> Result.Ok((FnDef(name = name, params = params, body = stmts), pos4))

fn isBodyEnd(tokens: List<Token>, pos: Int) -> Bool
    ? "Check if we've reached the end of a function body (EOF, fn, or blank line)."
    t = tokenAt(tokens, pos)
    match t
        Token.TkEof -> true
        Token.TkFn -> true
        Token.TkNewline -> true
        _ -> false

fn parseFnBodyStmts(tokens: List<Token>, pos: Int, acc: List<Stmt>) -> Result<(List<Stmt>, Int), String>
    ? "Parse statements in function body. Blank line or fn/EOF ends body."
    match isBodyEnd(tokens, pos)
        true -> Result.Ok((acc, pos))
        false -> parseFnBodyOneStmt(tokens, pos, acc)

fn parseFnBodyOneStmt(tokens: List<Token>, pos: Int, acc: List<Stmt>) -> Result<(List<Stmt>, Int), String>
    ? "Parse one statement in function body and continue."
    r = parseStmt(tokens, pos)?
    match r
        (stmt, pos2) -> parseFnBodyAfterStmt(tokens, pos2, List.append(acc, stmt))

fn parseFnBodyAfterStmt(tokens: List<Token>, pos: Int, acc: List<Stmt>) -> Result<(List<Stmt>, Int), String>
    ? "After a body statement: single newline continues, anything else ends."
    match tokenAt(tokens, pos)
        Token.TkNewline -> parseFnBodyStmts(tokens, pos + 1, acc)
        _ -> Result.Ok((acc, pos))

fn parseParamList(tokens: List<Token>, pos: Int, acc: List<String>) -> Result<(List<String>, Int), String>
    ? "Parse comma-separated parameter names until ')'."
    match tokenAt(tokens, pos)
        Token.TkRParen -> Result.Ok((acc, pos + 1))
        Token.TkIdent(name) -> parseParamListTail(tokens, skipTypeAnnotation(tokens, pos + 1), List.append(acc, name))
        _ -> Result.Err("Expected parameter name or ')'")

fn parseParamListTail(tokens: List<Token>, pos: Int, acc: List<String>) -> Result<(List<String>, Int), String>
    ? "After a param name: ',' for more or ')' to end."
    match tokenAt(tokens, pos)
        Token.TkRParen -> Result.Ok((acc, pos + 1))
        Token.TkComma -> parseParamList(tokens, pos + 1, acc)
        _ -> Result.Err("Expected ',' or ')' in parameter list")

fn skipTypeAnnotation(tokens: List<Token>, pos: Int) -> Int
    ? "Skip optional : Type annotation."
    match tokenAt(tokens, pos)
        Token.TkColon -> skipTypeExpr(tokens, pos + 1)
        _ -> pos

fn skipTypeExpr(tokens: List<Token>, pos: Int) -> Int
    ? "Skip a type expression (ident, possibly with generics)."
    match tokenAt(tokens, pos)
        Token.TkIdent(_) -> skipTypeExprTail(tokens, pos + 1)
        Token.TkLParen -> skipUntilClose(tokens, pos + 1, 1)
        _ -> pos

fn skipTypeExprTail(tokens: List<Token>, pos: Int) -> Int
    ? "After type ident: possibly <...> generics or .Qualified."
    match tokenAt(tokens, pos)
        Token.TkLt -> skipUntilGt(tokens, pos + 1, 1)
        Token.TkDot -> match tokenAt(tokens, pos + 1)
            Token.TkIdent(_) -> skipTypeExprTail(tokens, pos + 2)
            _ -> pos
        _ -> pos

fn skipUntilGt(tokens: List<Token>, pos: Int, depth: Int) -> Int
    ? "Skip until matching > for generic type params."
    match depth == 0
        true -> pos
        false -> match tokenAt(tokens, pos)
            Token.TkEof -> pos
            Token.TkLt -> skipUntilGt(tokens, pos + 1, depth + 1)
            Token.TkGt -> skipUntilGt(tokens, pos + 1, depth - 1)
            _ -> skipUntilGt(tokens, pos + 1, depth)

fn skipUntilClose(tokens: List<Token>, pos: Int, depth: Int) -> Int
    ? "Skip until matching ) for tuple types."
    match depth == 0
        true -> pos
        false -> match tokenAt(tokens, pos)
            Token.TkEof -> pos
            Token.TkLParen -> skipUntilClose(tokens, pos + 1, depth + 1)
            Token.TkRParen -> skipUntilClose(tokens, pos + 1, depth - 1)
            _ -> skipUntilClose(tokens, pos + 1, depth)

// ─── Program (top-level) ────────────────────────────────────

fn parseProgram(tokens: List<Token>, pos: Int, fns: List<FnDef>, stmts: List<Stmt>) -> Result<Program, String>
    ? "Parse top-level items until EOF."
    pos2 = skipNewlines(tokens, pos)
    match tokenAt(tokens, pos2)
        Token.TkEof -> Result.Ok(Program(fns = fns, stmts = stmts))
        Token.TkFn -> parseProgramFn(tokens, pos2 + 1, fns, stmts)
        Token.TkIdent(kw) -> parseProgramKeyword(tokens, pos2, fns, stmts, kw)
        _ -> parseProgramStmt(tokens, pos2, fns, stmts)

fn parseProgramKeyword(tokens: List<Token>, pos: Int, fns: List<FnDef>, stmts: List<Stmt>, kw: String) -> Result<Program, String>
    ? "Handle keywords that should be skipped: module, type, record, verify."
    match kw
        "module" -> parseProgram(tokens, skipBlock(tokens, pos + 1), fns, stmts)
        "type" -> parseProgram(tokens, skipBlock(tokens, pos + 1), fns, stmts)
        "record" -> parseProgram(tokens, skipBlock(tokens, pos + 1), fns, stmts)
        "verify" -> parseProgram(tokens, skipBlock(tokens, pos + 1), fns, stmts)
        "decision" -> parseProgram(tokens, skipBlock(tokens, pos + 1), fns, stmts)
        _ -> parseProgramStmt(tokens, pos, fns, stmts)

fn parseProgramFn(tokens: List<Token>, pos: Int, fns: List<FnDef>, stmts: List<Stmt>) -> Result<Program, String>
    ? "Parse a function definition and continue."
    r = parseFnDef(tokens, pos)?
    match r
        (fd, pos2) -> parseProgram(tokens, skipNewlines(tokens, pos2), List.append(fns, fd), stmts)

fn parseProgramStmt(tokens: List<Token>, pos: Int, fns: List<FnDef>, stmts: List<Stmt>) -> Result<Program, String>
    ? "Parse a statement and continue."
    r = parseStmt(tokens, pos)?
    match r
        (st, pos2) -> parseProgram(tokens, skipNewlines(tokens, pos2), fns, List.append(stmts, st))

// ─── Public API ─────────────────────────────────────────────

fn skipDescAndEffects(tokens: List<Token>, pos: Int) -> Int
    ? "Skip optional ? description and ! [effects] lines."
    match tokenAt(tokens, pos)
        Token.TkQuestion -> skipDescAndEffects(tokens, skipToNextLine(tokens, pos + 1))
        Token.TkBang -> skipDescAndEffects(tokens, skipToNextLine(tokens, pos + 1))
        _ -> pos

fn skipToNextLine(tokens: List<Token>, pos: Int) -> Int
    ? "Skip tokens until newline, then past it."
    match tokenAt(tokens, pos)
        Token.TkEof -> pos
        Token.TkNewline -> pos + 1
        _ -> skipToNextLine(tokens, pos + 1)

fn skipReturnType(tokens: List<Token>, pos: Int) -> Int
    ? "Skip optional -> ReturnType annotation."
    match tokenAt(tokens, pos)
        Token.TkArrow -> skipTypeExpr(tokens, pos + 1)
        _ -> pos

fn skipBlock(tokens: List<Token>, pos: Int) -> Int
    ? "Skip tokens until blank line, fn, or EOF."
    match tokenAt(tokens, pos)
        Token.TkEof -> pos
        Token.TkNewline -> skipBlockAfterNewline(tokens, pos + 1)
        _ -> skipBlock(tokens, pos + 1)

fn skipBlockAfterNewline(tokens: List<Token>, pos: Int) -> Int
    ? "After newline: another newline or fn/type/record/verify/EOF = end of block."
    match tokenAt(tokens, pos)
        Token.TkEof -> pos
        Token.TkNewline -> pos
        Token.TkFn -> pos
        Token.TkIdent(kw) -> match kw
            "module" -> pos
            "type" -> pos
            "record" -> pos
            "verify" -> pos
            "decision" -> pos
            _ -> skipBlock(tokens, pos)
        _ -> skipBlock(tokens, pos)

fn parse(tokens: List<Token>) -> Result<Program, String>
    ? "Parse a token list into a Program."
    parseProgram(tokens, 0, [], [])

// ─── Verify ─────────────────────────────────────────────────

verify parse
    parse(Domain.Lexer.lex("x = 5")) => Result.Ok(Program(fns = [], stmts = [Stmt.StmtBind("x", Expr.ExprInt(5))]))
    parse(Domain.Lexer.lex("1 + 2")) => Result.Ok(Program(fns = [], stmts = [Stmt.StmtExpr(Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)))]))
    parse(Domain.Lexer.lex("3 == 3")) => Result.Ok(Program(fns = [], stmts = [Stmt.StmtExpr(Expr.ExprEq(Expr.ExprInt(3), Expr.ExprInt(3)))]))
    parse(Domain.Lexer.lex("[1, 2]")) => Result.Ok(Program(fns = [], stmts = [Stmt.StmtExpr(Expr.ExprList([Expr.ExprInt(1), Expr.ExprInt(2)]))]))
    parse(Domain.Lexer.lex("+")) => Result.Err("Expected expression, got Plus")
