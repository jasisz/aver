  "decisions": [
    {
      "name": "OneRulePassPerCommand",
      "date": "2026-03-08",
      "chosen": "SingleExplicitRulePass",
      "rejected": [
        "LoopUntilNoRulesFire",
        "HideRulesInsideStoreWrites"
      ],
      "reason": "Workflow rules should stay reviewable, not turn into an implicit fixpoint engine. A single pass after each user mutation keeps command flow explicit even if it leaves some second-order derivations for a later manual `run_rules` call.",
      "impacts": [
        "execute",
        "decide",
        "planTaskCommand",
        "deriveRuleEffectsAfterPrimaryEvent",
        "commit",
        "dispatch"
      ],
      "author": "Codex"
    },
    {
      "name": "ProjectsStayStateBased",
      "date": "2026-03-08",
      "chosen": "StateRecordsForProjects",
      "rejected": [
        "ProjectEventSourcing",
        "SingleGlobalAggregate"
      ],
      "reason": "Project transitions are shallow compared with task lifecycle. A separate project event log would add ceremony without revealing new pressure. Keeping projects as direct state lets the task event stream stay focused on richer behavior.",
      "impacts": [
        "createProject",
        "archiveProject",
        "putProject"
      ],
      "author": "Codex"
    },
    {
      "name": "CommandsProduceEventsNotMutatedTasks",
      "date": "2026-03-08",
      "chosen": "CommandFunctionsEmitEvents",
      "rejected": [
        "MutateTaskRecordsDirectly",
        "HideStateChangeInsideStore"
      ],
      "reason": "A task workflow engine should make state transitions reviewable at the event level. Returning events instead of directly mutated tasks keeps replay and audit aligned.",
      "impacts": [
        "createTask",
        "renameTask",
        "completeTask",
        "reopenTask"
      ],
      "author": "Codex"
    },
    {
      "name": "ReplayReturnsToDomain",
      "date": "2026-03-08",
      "chosen": "TypedReplayInDomain",
      "rejected": [
        "KeepReplayInInfraStore",
        "DeleteReplayHelpers"
      ],
      "reason": "Replay belongs with the domain semantics, not inside the storage adapter. Now that constructor payload matching is reliable enough, the natural typed version is clearer than the old serialized-payload workaround.",
      "impacts": [
        "replayTask",
        "replayAll",
        "applyEvent"
      ],
      "author": "Codex"
    },
    {
      "name": "DeadlinesProjectUrgencyInsteadOfMutatingPriority",
      "date": "2026-03-08",
      "chosen": "DerivedUrgencyAndNotifications",
      "rejected": [
        "RewritePriorityToUrgent",
        "IgnoreDeadlinePressure"
      ],
      "reason": "Stored priority represents intent; deadline pressure is situational. Mutating priority during rule evaluation would erase who set the original priority.",
      "impacts": [
        "ruleDeadlineSoon",
        "ruleOverdue"
      ],
      "author": "Codex"
    },
    {
      "name": "AppendOnlyTaskEventsWithFlatProjectState",
      "date": "2026-03-08",
      "chosen": "TaskEventsPlusProjectState",
      "rejected": [
        "EverythingAsMutableState",
        "EverythingEventSourced",
        "InMemoryOnly"
      ],
      "reason": "Task lifecycle is where reviewable history matters, so an append-only event log pays for itself. Projects are much shallower, and storing them as current state avoids a second event system. This keeps the storage model simple while still exercising replay in a realistic place.",
      "impacts": [
        "loadProjects",
        "saveProjects",
        "loadTaskEvents",
        "appendTaskEvents"
      ],
      "author": "Codex"
    },
    {
      "name": "NotificationsDeduplicateByKey",
      "date": "2026-03-08",
      "chosen": "PersistAndSkipKnownKeys",
      "rejected": [
        "AlwaysEmitAgain",
        "NoNotificationHistory"
      ],
      "reason": "Deadline and overdue rules can be re-run manually, so delivery needs a stable idempotency key or the CLI will drown in repeated warnings.",
      "impacts": [
        "emitNotifications",
        "loadNotifications"
      ],
      "author": "Codex"
    },
    {
      "name": "AuditsStayAdjacentToEventsNotInsideThem",
      "date": "2026-03-08",
      "chosen": "SeparateAuditLog",
      "rejected": [
        "EncodeAllAuditNarrativeAsTaskEvents",
        "NoAuditTrail"
      ],
      "reason": "Reopen reasons and command traces are valuable to reviewers, but they should not change replay semantics for task state.",
      "impacts": [
        "recordEntries",
        "loadEntries"
      ],
      "author": "Codex"
    }
  ]
}