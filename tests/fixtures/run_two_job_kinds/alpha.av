module Alpha
    kind = capability
    semantics = effectful
    depends [Work]
    intent = "One job kind of this fixture: scoring a handle off the turn."
    exposes [begin, take]

operation begin(task: Int) -> Result<Work.Job, String>
    ? "Starts one alpha scoring off the turn and returns its job handle at once."
    oracle = generativeOutput
    replay = recorded

operation take(job: Work.Job) -> Result<Option<Int>, String>
    ? "Collects one finished alpha scoring: None while it runs, Some(score) once it finished."
    oracle = generativeOutput
    replay = recorded
