module Prop78
    intent =
        "TIP isaplanner prop_78: sorted(sort(xs)) holds for all xs (insertion sort produces a sorted list)."
    effects []

type Nat
    Z
    S(Nat)

fn leq(x: Nat, y: Nat) -> Bool
    match x
        Nat.Z -> true
        Nat.S(z) -> match y
            Nat.Z -> false
            Nat.S(x2) -> leq(z, x2)

fn insort(x: Nat, y: List<Nat>) -> List<Nat>
    match y
        [] -> [x]
        [z, ..xs] -> match leq(x, z)
            true -> List.concat([x], y)
            false -> List.concat([z], insort(x, xs))

fn sort(x: List<Nat>) -> List<Nat>
    match x
        [] -> []
        [y, ..xs] -> insort(y, sort(xs))

fn and2(x: Bool, y: Bool) -> Bool
    match x
        true -> y
        false -> false

fn sorted(x: List<Nat>) -> Bool
    match x
        [] -> true
        [y, ..z] -> match z
            [] -> true
            [y2, ..ys] -> and2(leq(y, y2), sorted(z))

fn leHead(z: Nat, l: List<Nat>) -> Bool
    match l
        [] -> true
        [a, ..as] -> leq(z, a)

verify leq law leTotal
    given a: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given b: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    when Bool.not(leq(a, b))
    leq(b, a) => true

verify sorted law sortTail
    given a: Nat = [Nat.Z, Nat.S(Nat.Z)]
    given l: List<Nat> = [[], [Nat.Z], [Nat.Z, Nat.S(Nat.Z)]]
    when sorted(List.concat([a], l))
    sorted(l) => true

verify sorted law sortedConsLeHead
    given a: Nat = [Nat.Z, Nat.S(Nat.Z)]
    given l: List<Nat> = [[], [Nat.Z], [Nat.Z, Nat.S(Nat.Z)]]
    when sorted(List.concat([a], l))
    leHead(a, l) => true

verify insort law leHeadInsort
    given z: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given l: List<Nat> = [[], [Nat.Z], [Nat.Z, Nat.S(Nat.Z)]]
    when leHead(z, l)
    when leq(z, x)
    leHead(z, insort(x, l)) => true

verify sorted law sortedCons
    given z: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given l: List<Nat> = [[], [Nat.Z], [Nat.Z, Nat.S(Nat.Z)]]
    when leHead(z, l)
    when sorted(l)
    sorted(List.concat([z], l)) => true

verify insort law sortedInsort
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given y: List<Nat> = [[], [Nat.Z], [Nat.Z, Nat.S(Nat.Z)]]
    when sorted(y)
    sorted(insort(x, y)) => true

verify sort law sortProducesSorted
    given xs: List<Nat> = [[], [Nat.S(Nat.Z)], [Nat.S(Nat.S(Nat.Z)), Nat.Z], [Nat.S(Nat.Z), Nat.Z, Nat.S(Nat.S(Nat.Z))]]
    sorted(sort(xs)) => true
