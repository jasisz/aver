module Edge
    intent =
        "edge.averlang.dev — proof-of-Aver served from Cloudflare Workers."
        "GET / returns the HTML landing; GET /api the JSON manifesto;"
        "GET /fractal a server-rendered ASCII Mandelbrot computed in pure"
        "Aver per request (logic in the Fractal module); GET /llms.txt the"
        "LLM-readable description of this subdomain; everything else gets"
        "a styled 404 (so favicon.ico etc. don't fall back to the landing"
        "page)."
    depends [Fractal]
    exposes [handler]
    effects [Time]

fn manifesto(country: String, ts: Int) -> String
    ? "JSON body advertising what compiled and serves this request. `cf_ipcountry` reflects the request origin per Cloudflare's GeoIP (the `cf-ipcountry` request header), not the location where the worker executes."
    String.join([
        "{{",
        "  \"language\": \"Aver\",",
        "  \"target\": \"wasm\",",
        "  \"runtime\": \"Cloudflare Workers\",",
        "  \"cf_ipcountry\": \"{country}\",",
        "  \"served_at_unix_ms\": {ts},",
        "  \"pure_core\": true,",
        "  \"effects\": [\"Time.unixMs\"]",
        "}}",
        ""
    ], "\n")

verify manifesto
    manifesto("PL", 0) => "{{\n  \"language\": \"Aver\",\n  \"target\": \"wasm\",\n  \"runtime\": \"Cloudflare Workers\",\n  \"cf_ipcountry\": \"PL\",\n  \"served_at_unix_ms\": 0,\n  \"pure_core\": true,\n  \"effects\": [\"Time.unixMs\"]\n}}\n"

fn landing(country: String) -> String
    ? "Minimal HTML landing — explains what's happening."
    String.join([
        "<!doctype html>",
        "<html lang=\"en\">",
        "<head>",
        "  <meta charset=\"utf-8\">",
        "  <title>edge.averlang.dev — served by Aver</title>",
        "  <style>",
        "    body {{ font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; max-width: 720px; margin: 4rem auto; padding: 0 1rem; line-height: 1.55; color: #1a1a1a; }}",
        "    h1 {{ font-size: 1.6rem; margin-bottom: 0.2rem; }}",
        "    .sub {{ color: #666; margin-top: 0; }}",
        "    code {{ background: #f3f3f3; padding: 0.1em 0.35em; border-radius: 3px; }}",
        "    pre {{ background: #f3f3f3; padding: 1rem; border-radius: 6px; overflow: auto; font-size: 0.9rem; }}",
        "    a {{ color: #1a4cdb; }}",
        "  </style>",
        "</head>",
        "<body>",
        "  <h1>This page is served by Aver.</h1>",
        "  <p class=\"sub\">Compiled with <code>aver compile --preset cloudflare</code> and running as a Cloudflare Worker.</p>",
        "  <p>The request enters a normal Aver function:</p>",
        "  <pre>fn handler(req: HttpRequest) -&gt; HttpResponse",
        "    ! [Time.unixMs]</pre>",
        "  <p>Routing, response bodies, and headers are pure Aver code. The only declared runtime effect is the timestamp used by <code>/api</code>.</p>",
        "  <p class=\"sub\">Cloudflare sees this request as: <strong>{country}</strong></p>",
        "  <h2>Endpoints</h2>",
        "  <ul>",
        "    <li><a href=\"/api\">/api</a> — JSON manifesto</li>",
        "    <li><a href=\"/fractal\">/fractal</a> — server-rendered ASCII Mandelbrot, pure Aver compute per request</li>",
        "    <li><a href=\"/llms.txt\">/llms.txt</a> — LLM-readable description of this subdomain</li>",
        "    <li><a href=\"https://averlang.dev\">averlang.dev</a> — the language</li>",
        "    <li><a href=\"https://github.com/jasisz/aver/blob/main/tools/edge/app.av\">app.av on GitHub</a> — full handler source</li>",
        "  </ul>",
        "</body>",
        "</html>",
        ""
    ], "\n")

fn notFoundHtml(path: String) -> String
    ? "Styled 404 page — same typography/colour scheme as the landing."
    String.join([
        "<!doctype html>",
        "<html lang=\"en\">",
        "<head>",
        "  <meta charset=\"utf-8\">",
        "  <title>404 — edge.averlang.dev</title>",
        "  <style>",
        "    body {{ font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; max-width: 720px; margin: 4rem auto; padding: 0 1rem; line-height: 1.55; color: #1a1a1a; }}",
        "    h1 {{ font-size: 1.6rem; margin-bottom: 0.2rem; }}",
        "    .sub {{ color: #666; margin-top: 0; }}",
        "    code {{ background: #f3f3f3; padding: 0.1em 0.35em; border-radius: 3px; }}",
        "    a {{ color: #1a4cdb; }}",
        "  </style>",
        "</head>",
        "<body>",
        "  <h1>404 — not on this edge.</h1>",
        "  <p class=\"sub\">No route matched <code>{path}</code> on this Aver-served subdomain.</p>",
        "  <p>Try one of the routes the handler does know:</p>",
        "  <ul>",
        "    <li><a href=\"/\">/</a> — the HTML landing</li>",
        "    <li><a href=\"/api\">/api</a> — JSON manifesto</li>",
        "    <li><a href=\"/llms.txt\">/llms.txt</a> — LLM-readable description of this subdomain</li>",
        "  </ul>",
        "</body>",
        "</html>",
        ""
    ], "\n")

fn llmsTxt() -> String
    ? "Per-domain llms.txt for edge.averlang.dev — describes this subdomain to LLMs and points back to averlang.dev for the full language."
    String.join([
        "# edge.averlang.dev",
        "",
        "> An Aver `fn handler(req: HttpRequest) -> HttpResponse` compiled with `aver compile --preset cloudflare` and deployed to Cloudflare Workers. The handler declares `! [Time.unixMs]` as its only runtime effect; routing, response bodies, and headers are pure Aver code. ~100 lines of source.",
        "",
        "- Source: [tools/edge/app.av](https://github.com/jasisz/aver/blob/main/tools/edge/app.av)",
        "- Language: [averlang.dev](https://averlang.dev)",
        "- Playground: [averlang.dev/playground](https://averlang.dev/playground/)",
        "- Full LLM guide for the language: [averlang.dev/llms.txt](https://averlang.dev/llms.txt) and [averlang.dev/llms-full.txt](https://averlang.dev/llms-full.txt)",
        "",
        "## Routes",
        "",
        "- `GET /` — HTML landing page describing the deployment",
        "- `GET /api` — JSON manifesto with the request's `cf-ipcountry` and a server-side `Time.unixMs()` timestamp",
        "- `GET /fractal` — server-rendered 80×30 ASCII Mandelbrot, recomputed in pure Aver on every request. Logic lives in `fractal.av` (a separate module declaring `effects []`); the route handler injects `Time.unixMs` only to time the render",
        "- `GET /llms.txt` — this file",
        "- everything else — 404 (HTML, same look as the landing)",
        "",
        "## How the handler is wired",
        "",
        "`--preset cloudflare` expands to `--target wasm --bridge fetch --pack cloudflare`: a single bundled `app.wasm` (Aver runtime inlined via `wasm-merge`), a `worker.js` ES-module bootstrap that satisfies the `aver/*` host imports against the JS environment (`console.*`, `Date.now()`, `Math.random()`, Fetch API + JSPI for `Http.*`), and a `wrangler.toml`. Cloudflare Workers reject `WebAssembly.instantiate(bytes, …)` from runtime-fetched bytes, so the single-bundle shape is the only viable path; browsers / Deno / Bun can use the thinner `--target edge-wasm` shape with the runtime fetched from `averlang.dev/runtime/`.",
        "",
        "## What this URL is *not*",
        "",
        "This is the dogfood demo, not a service you should depend on. The route shape, manifesto fields, and even the codename of the deployment may change. For programmatic access to anything stable, follow the source link above and check the latest `app.av`.",
        ""
    ], "\n")

fn jsonResponse(body: String) -> HttpResponse
    ? "200 OK with application/json content-type."
    HttpResponse(
        status = 200,
        body = body,
        headers = { "content-type" => ["application/json; charset=utf-8"] },
    )

fn htmlResponse(body: String) -> HttpResponse
    ? "200 OK with text/html content-type."
    HttpResponse(
        status = 200,
        body = body,
        headers = { "content-type" => ["text/html; charset=utf-8"] },
    )

fn textResponse(body: String) -> HttpResponse
    ? "200 OK with text/plain content-type — used for /llms.txt."
    HttpResponse(
        status = 200,
        body = body,
        headers = { "content-type" => ["text/plain; charset=utf-8"] },
    )

fn notFound(path: String) -> HttpResponse
    ? "404 with a styled HTML body — keeps the look consistent with the landing page."
    HttpResponse(
        status = 404,
        body = notFoundHtml(path),
        headers = { "content-type" => ["text/html; charset=utf-8"] },
    )

verify notFound
    notFound("/favicon.ico").status => 404
    notFound("/whatever").status    => 404

fn firstHeader(values: List<String>) -> String
    ? "First entry of a header list, or '??' when empty."
    v = Vector.fromList(values)
    match Vector.get(v, 0)
        Option.Some(c) -> c
        Option.None    -> "??"

verify firstHeader
    firstHeader(["PL"])       => "PL"
    firstHeader(["PL", "DE"]) => "PL"
    firstHeader([])           => "??"

fn extractCountry(req: HttpRequest) -> String
    ? "Reads the Cloudflare-injected cf-ipcountry header; falls back to '??'."
    match Map.get(req.headers, "cf-ipcountry")
        Option.Some(values) -> firstHeader(values)
        Option.None         -> "??"

verify extractCountry
    extractCountry(HttpRequest(method = "GET", path = "/", body = "", headers = {"cf-ipcountry" => ["PL"]})) => "PL"
    extractCountry(HttpRequest(method = "GET", path = "/", body = "", headers = {})) => "??"

fn fractalResponse() -> HttpResponse
    ? "Renders two Braille-encoded Mandelbrot views per request — the full set plus a 350× zoom into the seahorse valley — and returns them as styled HTML. The same Fractal.render entry serves both views, parameterised by a View record. Compute fits inside the free-plan 10 ms CPU budget."
    HttpResponse(
        status = 200,
        body = Fractal.page(
            Fractal.render(80, 24, 80, Fractal.fullView()),
            Fractal.render(80, 24, 150, Fractal.seahorseView()),
        ),
        headers = { "content-type" => ["text/html; charset=utf-8"] },
    )

fn handler(req: HttpRequest) -> HttpResponse
    ? "Routes by path. `/` HTML, `/api` JSON, `/fractal` ASCII Mandelbrot, `/llms.txt` plain text, everything else 404s."
    ! [Time.unixMs]
    country = extractCountry(req)
    match req.path
        "/"          -> htmlResponse(landing(country))
        "/api"       -> jsonResponse(manifesto(country, Time.unixMs()))
        "/fractal"   -> fractalResponse()
        "/llms.txt"  -> textResponse(llmsTxt())
        _            -> notFound(req.path)
