module Types
    intent =
        "Seed corpus entry for Aver's two user-type families: sum types"
        "(variant constructors with payloads) and record types (named"
        "fields). Covers pattern matching across all three Shape arms,"
        "record construction and field access, and verify laws over a"
        "generated `given` list."
    exposes [Shape, User, area, greet]
    effects []

type Shape
    Circle(Float)
    Rect(Float, Float)
    Point

record User
    name: String
    age: Int

fn area(s: Shape) -> Float
    ? "Total exhaustive match on Shape — every arm produces a Float."
    match s
        Shape.Circle(r)   -> r * r
        Shape.Rect(w, h)  -> w * h
        Shape.Point       -> 0.0

verify area
    area(Shape.Circle(3.0))     => 9.0
    area(Shape.Rect(4.0, 2.5))  => 10.0
    area(Shape.Point)           => 0.0

verify area law areaIsNonNegativeOnPositive
    given r: Float = [0.1, 1.0, 7.5, 100.0]
    when r > 0.0
    area(Shape.Circle(r)) >= 0.0 => true

fn greet(u: User) -> String
    ? "Demonstrates record field access via `.name`/`.age`."
    "hello, {u.name} ({u.age})"

verify greet
    greet(User(name = "Aver", age = 1))   => "hello, Aver (1)"
    greet(User(name = "World", age = 42)) => "hello, World (42)"
