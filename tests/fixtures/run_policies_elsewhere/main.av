module Node
    intent = "Fixture: an entry loaded as Node while the [run] table names its policies in Slice.Node."
    depends [Process, Wait, Pool, Pooled, Walker]
    effects [Console.print, Pool.claim, yield]
    exposes [Pending, View, order, admit, stop]

type Pending
    Pooling(Int, Wait.Wake)

record View
    pending: Map<Int, Pending>
    ready: List<Int>
    askable: List<Int>
    jobs: Int
    stopping: Bool

fn pooling() -> Unit
    ? "Claims handles until the pool answers None."
    ! [Console.print, Pool.claim, yield]
    _said = Console.print("pooling starts")
    Walker.walking()

fn order(view: View) -> List<Int>
    ? "Every seated process, in slot order."
    Map.keys(view.pending)

fn admit(view: View, id: Int) -> Bool
    ? "Everything seated is served."
    Map.has(view.pending, id)

fn stop(view: View) -> Bool
    ? "The run ends when the process asked us to."
    view.stopping
