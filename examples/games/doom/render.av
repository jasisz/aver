module Render
    intent =
        "Braille-based raycasting renderer. Each terminal cell is a 2x4 pixel"
        "block encoded as a Unicode Braille character (U+2800..U+28FF)."
        "Casts one ray per terminal column, computes wall height from distance,"
        "and fills braille dots for ceiling/wall/floor regions."
    depends [Math, Level]

// ─── Screen constants ──────────────────────────────────────────────────────

fn screenW() -> Int
    ? "Terminal columns for the 3D viewport"
    60

fn screenH() -> Int
    ? "Terminal rows for the 3D viewport"
    20

fn pixelH() -> Int
    ? "Virtual pixel height = screenH * 4 (braille has 4 vertical dots)"
    80

fn fov() -> Float
    ? "Horizontal field of view in radians (~60 degrees)"
    Float.pi() / 3.0

// ─── Braille encoding ──────────────────────────────────────────────────────

fn brailleBase() -> Int
    ? "Unicode code point for empty Braille pattern"
    10240

fn brailleChar(bits: Int) -> String
    ? "Convert 8-bit pattern to Braille Unicode character"
    match Char.fromCode(brailleBase() + bits)
        Option.Some(ch) -> ch
        Option.None -> " "

fn dotBit(row: Int) -> Int
    ? "Bit value for left-column dot at vertical position 0..3"
    match row
        0 -> 1
        1 -> 2
        2 -> 4
        3 -> 64
        _ -> 0

fn dotBitRight(row: Int) -> Int
    ? "Bit value for right-column dot at vertical position 0..3"
    match row
        0 -> 8
        1 -> 16
        2 -> 32
        3 -> 128
        _ -> 0

verify dotBit
    dotBit(0) => 1
    dotBit(1) => 2
    dotBit(2) => 4
    dotBit(3) => 64

verify dotBitRight
    dotBitRight(0) => 8
    dotBitRight(1) => 16
    dotBitRight(2) => 32
    dotBitRight(3) => 128

// ─── Raycasting ────────────────────────────────────────────────────────────

fn castRay(levelMap: List<String>, px: Float, py: Float, angle: Float) -> Float
    ? "March a ray from (px,py) at angle, return distance to first wall"
    marchRay(levelMap, px, py, Float.cos(angle), Float.sin(angle), 0.0)

fn marchRay(levelMap: List<String>, px: Float, py: Float, dx: Float, dy: Float, dist: Float) -> Float
    ? "Step along the ray until hitting a wall or max distance"
    match dist > 16.0
        true -> 16.0
        false ->
            mx = Float.floor(px + dx * dist)
            my = Float.floor(py + dy * dist)
            match Level.isWall(levelMap, mx, my)
                true -> dist
                false -> marchRay(levelMap, px, py, dx, dy, dist + 0.05)

// ─── Column rendering ──────────────────────────────────────────────────────

fn wallHeight(distance: Float) -> Int
    ? "Pixel height of the wall strip for a given corrected distance"
    match distance < 0.1
        true -> pixelH()
        false ->
            h = Float.floor(Int.toFloat(pixelH()) / distance)
            match h > pixelH()
                true -> pixelH()
                false -> h

fn columnBraille(wallTop: Int, wallBot: Int, row: Int) -> String
    ? "Compute one Braille character for a column at terminal row"
    bits = cellBits(wallTop, wallBot, row * 4, 0, 0)
    brailleChar(bits)

fn cellBits(wallTop: Int, wallBot: Int, pixY: Int, i: Int, acc: Int) -> Int
    ? "Accumulate 4 dot rows (both columns) into a braille bit pattern"
    match i == 4
        true -> acc
        false ->
            y = pixY + i
            isWallPixel = Bool.and(y >= wallTop, y < wallBot)
            newBits = match isWallPixel
                true -> acc + dotBit(i) + dotBitRight(i)
                false -> acc
            cellBits(wallTop, wallBot, pixY, i + 1, newBits)

verify cellBits
    cellBits(0, 80, 0, 0, 0) => 255
    cellBits(40, 41, 40, 0, 0) => 1 + 8

// ─── Shading ───────────────────────────────────────────────────────────────

fn shadeColor(distance: Float) -> String
    ? "Color based on distance — closer is brighter"
    match distance < 3.0
        true -> "white"
        false -> match distance < 6.0
            true -> "cyan"
            false -> match distance < 10.0
                true -> "blue"
                false -> "black"

// ─── Full frame rendering ──────────────────────────────────────────────────

fn renderFrame(levelMap: List<String>, px: Float, py: Float, angle: Float) -> Unit
    ? "Render the full 3D viewport using raycasting and Braille characters"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor, Terminal.resetColor, Terminal.flush]
    renderColumns(levelMap, px, py, angle, 0)
    Terminal.flush()

fn renderColumns(levelMap: List<String>, px: Float, py: Float, angle: Float, col: Int) -> Unit
    ? "Render one column and recurse to the next"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor, Terminal.resetColor, Terminal.flush]
    match col == screenW()
        true -> renderHud(px, py, angle)
        false ->
            rayAngle = angle - fov() / 2.0 + Int.toFloat(col) * fov() / Int.toFloat(screenW())
            rawDist = castRay(levelMap, px, py, rayAngle)
            dist = rawDist * Float.cos(rayAngle - angle)
            wh = wallHeight(dist)
            wTop = (pixelH() - wh) / 2
            wBot = wTop + wh
            color = shadeColor(dist)
            Terminal.setColor(color)
            renderColumnRows(col, wTop, wBot, 0)
            Terminal.resetColor()
            renderColumns(levelMap, px, py, angle, col + 1)

fn renderColumnRows(col: Int, wallTop: Int, wallBot: Int, row: Int) -> Unit
    ? "Render all rows for a single column"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor, Terminal.resetColor, Terminal.flush]
    match row == screenH()
        true -> Terminal.print("")
        false ->
            ch = columnBraille(wallTop, wallBot, row)
            Terminal.moveTo(col, row)
            Terminal.print(ch)
            renderColumnRows(col, wallTop, wallBot, row + 1)

// ─── HUD ───────────────────────────────────────────────────────────────────

fn renderHud(px: Float, py: Float, angle: Float) -> Unit
    ? "Draw position info and controls to the right of the viewport"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor, Terminal.resetColor, Terminal.flush]
    hudX = screenW() + 2
    Terminal.setColor("yellow")
    Terminal.moveTo(hudX, 1)
    Terminal.print("BRAILLE DOOM")
    Terminal.setColor("white")
    Terminal.moveTo(hudX, 3)
    Terminal.print("x: {Float.toString(px)}")
    Terminal.moveTo(hudX, 4)
    Terminal.print("y: {Float.toString(py)}")
    Terminal.moveTo(hudX, 5)
    deg = Float.floor(Math.radToDeg(angle))
    Terminal.print("angle: {Int.toString(deg)}")
    Terminal.setColor("cyan")
    Terminal.moveTo(hudX, 7)
    Terminal.print("WASD  move")
    Terminal.moveTo(hudX, 8)
    Terminal.print("</>   turn")
    Terminal.moveTo(hudX, 9)
    Terminal.print("q     quit")
    Terminal.resetColor()

// ─── Minimap ───────────────────────────────────────────────────────────────

fn renderMinimap(levelMap: List<String>, px: Float, py: Float, angle: Float) -> Unit
    ? "Draw a small ASCII minimap below the 3D view"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor, Terminal.resetColor, Terminal.flush]
    Terminal.setColor("green")
    renderMinimapRows(levelMap, px, py, 0)
    Terminal.resetColor()

fn renderMinimapRows(levelMap: List<String>, px: Float, py: Float, row: Int) -> Unit
    ? "Render one minimap row"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor, Terminal.resetColor, Terminal.flush]
    match row == Level.mapHeight()
        true -> Terminal.print("")
        false ->
            Terminal.moveTo(screenW() + 2, screenH() + 2 + row)
            renderMinimapCols(levelMap, px, py, row, 0)
            renderMinimapRows(levelMap, px, py, row + 1)

fn renderMinimapCols(levelMap: List<String>, px: Float, py: Float, row: Int, col: Int) -> Unit
    ? "Render one minimap cell"
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor, Terminal.resetColor, Terminal.flush]
    match col == Level.mapWidth()
        true -> Terminal.print("")
        false ->
            isPlayer = Bool.and(Float.floor(px) == col, Float.floor(py) == row)
            match isPlayer
                true ->
                    Terminal.setColor("yellow")
                    Terminal.print("@")
                    Terminal.setColor("green")
                false -> match Level.isWall(levelMap, col, row)
                    true -> Terminal.print("#")
                    false -> Terminal.print(".")
            renderMinimapCols(levelMap, px, py, row, col + 1)
