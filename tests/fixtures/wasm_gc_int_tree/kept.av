module M
    intent = "Int arithmetic the certificate reads keeps its ordinary lowering on wasm-gc."
    effects [Console]

fn poly(a: Int, b: Int, c: Int) -> Int
    ? "A fn the certificate plan printer admits."
    a * b + c * 3 - 1

fn main() -> Unit
    ? "Prints it. No Int literal here: this fn is not one the certificate reads, so it would share them."
    ! [Console.print]
    n = String.len("abc")
    Console.print("{poly(n, n, n)}")
