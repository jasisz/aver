module Using
    intent = "Cited laws as rewrite rules: a set, applied left to right, refused where the outcome would depend on the order."
    exposes [f, g, h, sameLen]
    effects []

fn f(x: String) -> String
    ? "An exclamation after the text."
    x + "!"

fn g(x: String) -> String
    ? "The same, written with an empty text in front."
    ("" + x) + "!"

fn h(x: String) -> String
    ? "The same again."
    x + "!"

fn sameLen(a: List<Int>, b: List<Int>) -> Bool
    ? "Whether two lists are as long."
    List.len(a) == List.len(b)

verify f
    f("a") => "a!"

verify g
    g("a") => "a!"

verify h
    h("a") => "a!"

verify sameLen
    sameLen([1], [2]) => true

verify f law isG
    given x: String = ["", "a"]
    f(x) => g(x)

verify f law isH
    given x: String = ["", "a"]
    f(x) => h(x)

verify h law isG
    given x: String = ["", "a"]
    h(x) => g(x)

verify g law throughHOneWay
    given x: String = ["", "a"]
    using [f.isH, h.isG]
    f(x) => g(x)

verify g law throughHOtherWay
    given x: String = ["", "a"]
    using [h.isG, f.isH]
    f(x) => g(x)

verify g law overlapping
    given x: String = ["", "a"]
    using [f.isG, f.isH]
    f(x) + "?" => g(x) + "?"

verify sameLen law commutes
    given a: List<Int> = [[], [1]]
    given b: List<Int> = [[2]]
    sameLen(a, b) => sameLen(b, a)

verify sameLen law againstOne
    given xs: List<Int> = [[], [1]]
    using [sameLen.commutes]
    sameLen(xs, [1]) => sameLen([1], xs)

verify sameLen law negatedAgainstOne
    given xs: List<Int> = [[], [1]]
    using [sameLen.commutes]
    Bool.not(sameLen(xs, [1])) => Bool.not(sameLen([1], xs))
