fn builtinDiskListDir(args: List<Val>) -> Result<Val, String>
    ? "Disk.listDir(path) -> Result<List<String>, String>."
    ! [Disk.listDir]
    v = Domain.Builtins.Helpers.oneArg(args)?
    path = Domain.Builtins.Helpers.expectStr(v)?
    match Disk.listDir(path)
        Result.Ok(entries) -> Result.Ok(Val.ValOk(Val.ValList(stringsToVals(entries, []))))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn tryVariantConstructor(name: String, args: List<Val>) -> Result<Val, String>
    ? "Try to construct a variant value from a dotted name like Type.Ctor."
    match splitDotted(name)
        Option.Some(pair) -> match pair
            (typeName, ctorName) -> Result.Ok(Val.ValVariant(typeName, ctorName, args))
        Option.None -> Result.Err("undefined function: {name}")

verify tryVariantConstructor
    tryVariantConstructor("Shape.Circle", [Val.ValInt(5)]) => Result.Ok(Val.ValVariant("Shape", "Circle", [Val.ValInt(5)]))
    tryVariantConstructor("noDot", []) => Result.Err("undefined function: noDot")

fn splitDotted(name: String) -> Option<(String, String)>
    ? "Split 'Type.Ctor' into (Type, Ctor). Returns None if no dot."
    splitDottedLoop(name, 0, String.len(name))

verify splitDotted
    splitDotted("List.len") => Option.Some(("List", "len"))
    splitDotted("hello") => Option.None

fn splitDottedLoop(name: String, pos: Int, total: Int) -> Option<(String, String)>
    ? "Find first dot and split."
    match pos >= total
        true -> Option.None
        false -> match String.charAt(name, pos)
            Option.Some(c) -> match c == "."
                true -> Option.Some((String.slice(name, 0, pos), String.slice(name, pos + 1, total)))
                false -> splitDottedLoop(name, pos + 1, total)
            Option.None -> Option.None

verify splitDottedLoop
    splitDottedLoop("A.B", 0, 3) => Option.Some(("A", "B"))
    splitDottedLoop("abc", 0, 3) => Option.None

fn builtinBoolOr(args: List<Val>) -> Result<Val, String>
    ? "Bool.or(a, b) -> a || b."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (aV, bV) -> builtinBoolOrInner(aV, bV)

fn builtinBoolOrInner(aV: Val, bV: Val) -> Result<Val, String>
    ? "Inner Bool.or."
    match aV
        Val.ValBool(a) -> match bV
            Val.ValBool(b) -> match a
                true -> Result.Ok(Val.ValBool(true))
                false -> Result.Ok(Val.ValBool(b))
            _ -> Result.Err("Bool.or requires Bool arguments")
        _ -> Result.Err("Bool.or requires Bool arguments")

verify builtinBoolOr
    builtinBoolOr([Val.ValBool(true), Val.ValBool(false)]) => Result.Ok(Val.ValBool(true))
    builtinBoolOr([Val.ValBool(false), Val.ValBool(false)]) => Result.Ok(Val.ValBool(false))
    builtinBoolOr([Val.ValBool(false), Val.ValBool(true)]) => Result.Ok(Val.ValBool(true))

fn builtinBoolAnd(args: List<Val>) -> Result<Val, String>
    ? "Bool.and(a, b) -> a && b."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (aV, bV) -> builtinBoolAndInner(aV, bV)

fn builtinBoolAndInner(aV: Val, bV: Val) -> Result<Val, String>
    ? "Inner Bool.and."
    match aV
        Val.ValBool(a) -> match bV
            Val.ValBool(b) -> match a
                true -> Result.Ok(Val.ValBool(b))
                false -> Result.Ok(Val.ValBool(false))
            _ -> Result.Err("Bool.and requires Bool arguments")
        _ -> Result.Err("Bool.and requires Bool arguments")

verify builtinBoolAnd
    builtinBoolAnd([Val.ValBool(true), Val.ValBool(true)]) => Result.Ok(Val.ValBool(true))
    builtinBoolAnd([Val.ValBool(true), Val.ValBool(false)]) => Result.Ok(Val.ValBool(false))

fn builtinBoolNot(args: List<Val>) -> Result<Val, String>
    ? "Bool.not(a) -> negation."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValBool(b) -> match b
            true -> Result.Ok(Val.ValBool(false))
            false -> Result.Ok(Val.ValBool(true))
        _ -> Result.Err("Bool.not requires Bool argument")

verify builtinBoolNot
    builtinBoolNot([Val.ValBool(true)]) => Result.Ok(Val.ValBool(false))
    builtinBoolNot([Val.ValBool(false)]) => Result.Ok(Val.ValBool(true))

fn builtinMapEmpty(args: List<Val>) -> Result<Val, String>
    ? "Map.empty() -> empty map as record."
    Result.Ok(Val.ValRecord("Map", []))

fn builtinMapSet(args: List<Val>) -> Result<Val, String>
    ? "Map.set(map, key, value) -> updated map."
    match List.len(args) == 3
        true -> builtinMapSetExtract(args)
        false -> Result.Err("Map.set takes 3 arguments")

fn builtinMapSetExtract(args: List<Val>) -> Result<Val, String>
    ? "Extract 3 args for Map.set."
    mapV = Option.withDefault(List.get(args, 0), Val.ValUnit)
    keyV = Option.withDefault(List.get(args, 1), Val.ValUnit)
    valV = Option.withDefault(List.get(args, 2), Val.ValUnit)
    builtinMapSetInner(mapV, keyV, valV)

fn builtinMapSetInner(mapV: Val, keyV: Val, valV: Val) -> Result<Val, String>
    ? "Set a key in the map record."
    match mapV
        Val.ValRecord(_, fields) -> Result.Ok(Val.ValRecord("Map", mapSetField(fields, Domain.Value.valRepr(keyV), valV, [])))
        _ -> Result.Err("Map.set requires a Map")

fn mapSetField(fields: List<(String, Val)>, key: String, val: Val, acc: List<(String, Val)>) -> List<(String, Val)>
    ? "Replace or append a key in field list."
    match fields
        [] -> List.reverse(List.prepend((key, val), acc))
        [pair, ..rest] -> match pair
            (k, v) -> match k == key
                true -> List.concat(List.reverse(List.prepend((key, val), acc)), rest)
                false -> mapSetField(rest, key, val, List.prepend((k, v), acc))

fn builtinMapGet(args: List<Val>) -> Result<Val, String>
    ? "Map.get(map, key) -> Option<Val>."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (mapV, keyV) -> builtinMapGetInner(mapV, keyV)

fn builtinMapGetInner(mapV: Val, keyV: Val) -> Result<Val, String>
    ? "Look up key in map record."
    match mapV
        Val.ValRecord(_, fields) -> mapLookup(fields, Domain.Value.valRepr(keyV))
        _ -> Result.Err("Map.get requires a Map")

fn mapLookup(fields: List<(String, Val)>, key: String) -> Result<Val, String>
    ? "Find key in map fields."
    match fields
        [] -> Result.Ok(Val.ValNone)
        [pair, ..rest] -> match pair
            (k, v) -> match k == key
                true -> Result.Ok(Val.ValSome(v))
                false -> mapLookup(rest, key)

fn builtinMapHas(args: List<Val>) -> Result<Val, String>
    ? "Map.has(map, key) -> Bool."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (mapV, keyV) -> builtinMapHasInner(mapV, keyV)

fn builtinMapHasInner(mapV: Val, keyV: Val) -> Result<Val, String>
    ? "Check if key exists in map."
    match mapV
        Val.ValRecord(_, fields) -> mapHasKey(fields, Domain.Value.valRepr(keyV))
        _ -> Result.Err("Map.has requires a Map")

fn mapHasKey(fields: List<(String, Val)>, key: String) -> Result<Val, String>
    ? "Check if key exists in field list."
    match fields
        [] -> Result.Ok(Val.ValBool(false))
        [pair, ..rest] -> match pair
            (k, _) -> match k == key
                true -> Result.Ok(Val.ValBool(true))
                false -> mapHasKey(rest, key)

fn builtinTimeNow(args: List<Val>) -> Result<Val, String>
    ? "Time.now() -> ISO timestamp string."
    ! [Time.now]
    Result.Ok(Val.ValStr(Time.now()))

fn builtinHttpSimple(args: List<Val>, method: String) -> Result<Val, String>
    ? "Http.get/head/delete(url) -> Result<HttpResponse, String> forwarded to host."
    ! [Http]
    v = Domain.Builtins.Helpers.oneArg(args)?
    url = Domain.Builtins.Helpers.expectStr(v)?
    match method
        "get" -> httpResponseToVal(Http.get(url))
        "head" -> httpResponseToVal(Http.head(url))
        _ -> httpResponseToVal(Http.delete(url))

fn builtinHttpBody(args: List<Val>, method: String) -> Result<Val, String>
    ? "Http.post/put/patch(url, body, contentType, headers) forwarded to host."
    ! [Http]
    match args
        [urlV, ..r1] -> match r1
            [bodyV, ..r2] -> match r2
                [ctV, ..r3] -> match r3
                    [hdrsV, ..r4] -> builtinHttpBodyInner(urlV, bodyV, ctV, hdrsV, method)
                    _ -> Result.Err("Http method takes 4 arguments")
                _ -> Result.Err("Http method takes 4 arguments")
            _ -> Result.Err("Http method takes 4 arguments")
        _ -> Result.Err("Http method takes 4 arguments")

fn builtinHttpBodyInner(urlV: Val, bodyV: Val, ctV: Val, hdrsV: Val, method: String) -> Result<Val, String>
    ? "Inner Http body method."
    ! [Http]
    url = Domain.Builtins.Helpers.expectStr(urlV)?
    body = Domain.Builtins.Helpers.expectStr(bodyV)?
    ct = Domain.Builtins.Helpers.expectStr(ctV)?
    match method
        "post" -> httpResponseToVal(Http.post(url, body, ct, []))
        "put" -> httpResponseToVal(Http.put(url, body, ct, []))
        _ -> httpResponseToVal(Http.patch(url, body, ct, []))

fn httpResponseToVal(result: Result<HttpResponse, String>) -> Result<Val, String>
    ? "Convert host HttpResponse to Val."
    match result
        Result.Ok(resp) -> Result.Ok(Val.ValOk(Val.ValRecord("HttpResponse", [("status", Val.ValInt(resp.status)), ("body", Val.ValStr(resp.body)), ("headers", headersToVal(resp.headers, []))])))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn headersToVal(headers: List<Header>, acc: List<Val>) -> Val
    ? "Convert host Header list to Val list."
    match headers
        [] -> Val.ValList(List.reverse(acc))
        [h, ..rest] -> headersToVal(rest, List.prepend(Val.ValRecord("Header", [("name", Val.ValStr(h.name)), ("value", Val.ValStr(h.value))]), acc))

fn builtinTcpSend(args: List<Val>) -> Result<Val, String>
    ? "Tcp.send(host, port, message) -> Result<String, String>."
    ! [Tcp.send]
    match args
        [hostV, ..r1] -> match r1
            [portV, ..r2] -> match r2
                [msgV, ..r3] -> builtinTcpSendInner(hostV, portV, msgV)
                _ -> Result.Err("Tcp.send takes 3 arguments")
            _ -> Result.Err("Tcp.send takes 3 arguments")
        _ -> Result.Err("Tcp.send takes 3 arguments")

fn builtinTcpSendInner(hostV: Val, portV: Val, msgV: Val) -> Result<Val, String>
    ? "Inner Tcp.send."
    ! [Tcp.send]
    host = Domain.Builtins.Helpers.expectStr(hostV)?
    port = Domain.Builtins.Helpers.expectInt(portV)?
    msg = Domain.Builtins.Helpers.expectStr(msgV)?
    match Tcp.send(host, port, msg)
        Result.Ok(resp) -> Result.Ok(Val.ValOk(Val.ValStr(resp)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpPing(args: List<Val>) -> Result<Val, String>
    ? "Tcp.ping(host, port) -> Result<Unit, String>."
    ! [Tcp.ping]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (hostV, portV) -> builtinTcpPingInner(hostV, portV)

fn builtinTcpPingInner(hostV: Val, portV: Val) -> Result<Val, String>
    ? "Inner Tcp.ping."
    ! [Tcp.ping]
    host = Domain.Builtins.Helpers.expectStr(hostV)?
    port = Domain.Builtins.Helpers.expectInt(portV)?
    match Tcp.ping(host, port)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpConnect(args: List<Val>) -> Result<Val, String>
    ? "Tcp.connect(host, port) -> Result<Tcp.Connection, String>."
    ! [Tcp.connect]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (hostV, portV) -> builtinTcpConnectInner(hostV, portV)

fn builtinTcpConnectInner(hostV: Val, portV: Val) -> Result<Val, String>
    ? "Inner Tcp.connect."
    ! [Tcp.connect]
    host = Domain.Builtins.Helpers.expectStr(hostV)?
    port = Domain.Builtins.Helpers.expectInt(portV)?
    match Tcp.connect(host, port)
        Result.Ok(conn) -> Result.Ok(Val.ValOk(tcpConnToVal(conn)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn tcpConnToVal(conn: Tcp.Connection) -> Val
    ? "Convert host Tcp.Connection record to Val using own TcpConn type."
    Val.ValRecord("TcpConn", [("id", Val.ValStr(conn.id)), ("host", Val.ValStr(conn.host)), ("port", Val.ValInt(conn.port))])

fn valToTcpConn(v: Val) -> Result<TcpConn, String>
    ? "Extract TcpConn fields from ValRecord."
    match v
        Val.ValRecord(_, fields) -> valToTcpConnFields(fields)
        _ -> Result.Err("expected TcpConn record")

fn valToTcpConnFields(fields: List<(String, Val)>) -> Result<TcpConn, String>
    ? "Build TcpConn from field list."
    idVal = lookupFieldVal(fields, "id")
    hostVal = lookupFieldVal(fields, "host")
    portVal = lookupFieldVal(fields, "port")
    match idVal
        Val.ValStr(id) -> match hostVal
            Val.ValStr(host) -> match portVal
                Val.ValInt(port) -> Result.Ok(TcpConn(id = id, host = host, port = port))
                _ -> Result.Err("bad TcpConn port")
            _ -> Result.Err("bad TcpConn host")
        _ -> Result.Err("bad TcpConn id")

fn lookupFieldVal(fields: List<(String, Val)>, name: String) -> Val
    ? "Find field value by name, return ValUnit if missing."
    match fields
        [] -> Val.ValUnit
        [pair, ..rest] -> match pair
            (k, v) -> match k == name
                true -> v
                false -> lookupFieldVal(rest, name)

fn builtinTcpWriteLine(args: List<Val>) -> Result<Val, String>
    ? "Tcp.writeLine(conn, line) -> Result<Unit, String>."
    ! [Tcp.writeLine]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (connV, lineV) -> builtinTcpWriteLineInner(connV, lineV)

fn builtinTcpWriteLineInner(connV: Val, lineV: Val) -> Result<Val, String>
    ? "Inner Tcp.writeLine."
    ! [Tcp.writeLine]
    tc = valToTcpConn(connV)?
    line = Domain.Builtins.Helpers.expectStr(lineV)?
    match Tcp.writeLine(tc, line)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpReadLine(args: List<Val>) -> Result<Val, String>
    ? "Tcp.readLine(conn) -> Result<String, String>."
    ! [Tcp.readLine]
    v = Domain.Builtins.Helpers.oneArg(args)?
    tc = valToTcpConn(v)?
    match Tcp.readLine(tc)
        Result.Ok(line) -> Result.Ok(Val.ValOk(Val.ValStr(line)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpClose(args: List<Val>) -> Result<Val, String>
    ? "Tcp.close(conn) -> Result<Unit, String>."
    ! [Tcp.close]
    v = Domain.Builtins.Helpers.oneArg(args)?
    tc = valToTcpConn(v)?
    match Tcp.close(tc)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))
