module Rules
    intent =
        "The wall: every rule a step may apply, as an equation schema over typed binders."
        "The replayer's own copy of src/ir/proof_steps/rules.rs; an identifier not listed here is refused."
        "A binder's type is what the rule is true at: Int for arithmetic and order, Bool for the connectives,"
        "any one type ?t for the list, map and vector shapes, and a type whose == is equality where a"
        "rule reads == at that type: the types Lean's statement of the same rule holds at."
        "The list rules are the constructor equations of the list builtins, with Aver's truncation of a count."
        "A product of two nonnegative Ints is nonnegative: the one rule that multiplies two comparisons."
        "What compute, ring or linear show is not a rule. The Bool.and and Bool.or rules follow from a split and compute too; they stay because proofs apply them over ten thousand times and each would grow by a split, as HOL Light keeps TRANS."
        "Int.min, Int.max and Int.abs are read by the comparison that picks their value; List.contains on [], on an element in front that is the one looked for and past one that is not."
        "The map rules read Map.get, Map.has and Map.len on the empty map and on Map.set(m, k, v)."
        "The vector rules read a vector as the list it holds, and Vector.get and Vector.len after a write or a literal-size Vector.new."
        "Option.withDefault and Result.withDefault read the value a Some or an Ok holds, and the default for None or an Err."
        "The bits rules read complement, a shift left and a mask of low bits or of one bit as Int arithmetic."
    exposes [Schema, schema]
    depends [Kernel.Term]
    effects []

record Schema
    binders: List<TypedVar>
    premises: List<Eqn>
    concl: Eqn

fn v(n: String) -> Term
    ? "A schema variable."
    Term.TVar(n)

verify v
    v("a") => Term.TVar("a")

fn i(n: String) -> TypedVar
    ? "A binder of type Int."
    Kernel.Term.typed(n, Ty.TyInt)

verify i
    i("a") => TypedVar(name = "a", ty = Ty.TyInt)

fn bo(n: String) -> TypedVar
    ? "A binder of type Bool."
    Kernel.Term.typed(n, Ty.TyBool)

verify bo
    bo("a") => TypedVar(name = "a", ty = Ty.TyBool)

fn any(n: String) -> TypedVar
    ? "A binder of the rule's one type ?t."
    Kernel.Term.typed(n, Ty.TyVar("t", false))

verify any
    any("x") => TypedVar(name = "x", ty = Ty.TyVar("t", false))

fn same(n: String) -> TypedVar
    ? "A binder of the rule's one type ?t, whose == must be equality."
    Kernel.Term.typed(n, Ty.TyVar("t", true))

verify same
    same("x") => TypedVar(name = "x", ty = Ty.TyVar("t", true))

fn lt(n: String) -> TypedVar
    ? "A binder of type List<?t>."
    Kernel.Term.typed(n, Ty.TyList(Ty.TyVar("t", false)))

verify lt
    lt("a") => TypedVar(name = "a", ty = Ty.TyList(Ty.TyVar("t", false)))

fn kv(n: String) -> TypedVar
    ? "A binder of type Map<?k, ?v>, the key with an equality."
    Kernel.Term.typed(n, Ty.TyMap(Ty.TyVar("k", true), Ty.TyVar("v", false)))

verify kv
    kv("m") => TypedVar(name = "m", ty = Ty.TyMap(Ty.TyVar("k", true), Ty.TyVar("v", false)))

fn key(n: String) -> TypedVar
    ? "A binder of the map's key type ?k."
    Kernel.Term.typed(n, Ty.TyVar("k", true))

verify key
    key("k") => TypedVar(name = "k", ty = Ty.TyVar("k", true))

fn val(n: String) -> TypedVar
    ? "A binder of the map's value type ?v."
    Kernel.Term.typed(n, Ty.TyVar("v", false))

verify val
    val("v") => TypedVar(name = "v", ty = Ty.TyVar("v", false))

fn vec(n: String) -> TypedVar
    ? "A binder of type Vector<?t>."
    Kernel.Term.typed(n, Ty.TyVector(Ty.TyVar("t", false)))

verify vec
    vec("v") => TypedVar(name = "v", ty = Ty.TyVector(Ty.TyVar("t", false)))

fn eq(l: Term, r: Term) -> Eqn
    ? "An equation."
    Eqn(lhs = l, rhs = r)

verify eq
    eq(Term.TUnit, Term.TUnit) => Eqn(lhs = Term.TUnit, rhs = Term.TUnit)

fn is(t: Term, value: Bool) -> Eqn
    ? "A Bool term equals a literal."
    eq(t, Term.TBool(value))

verify is
    is(Term.TVar("a"), true) => Eqn(lhs = Term.TVar("a"), rhs = Term.TBool(true))

fn conn(name: String, a: Term, b: Term) -> Term
    ? "Bool.and or Bool.or."
    Term.TBi(name, [a, b])

verify conn
    conn("Bool.and", Term.TVar("a"), Term.TVar("b")) => Term.TBi("Bool.and", [Term.TVar("a"), Term.TVar("b")])

fn plain(binders: List<TypedVar>, l: Term, r: Term) -> Option<Schema>
    ? "A rule without premises."
    Option.Some(Schema(binders = binders, premises = [], concl = eq(l, r)))

verify plain
    plain([], Term.TUnit, Term.TUnit) => Option.Some(Schema(binders = [], premises = [], concl = eq(Term.TUnit, Term.TUnit)))

fn schema(id: String) -> Option<Schema>
    ? "The rule with this identifier."
    match id
        "bool.and.true_l" -> plain([bo("b")], conn("Bool.and", Term.TBool(true), v("b")), v("b"))
        "bool.and.false_l" -> plain([bo("b")], conn("Bool.and", Term.TBool(false), v("b")), Term.TBool(false))
        "bool.and.true_r" -> plain([bo("a")], conn("Bool.and", v("a"), Term.TBool(true)), v("a"))
        "bool.and.false_r" -> plain([bo("a")], conn("Bool.and", v("a"), Term.TBool(false)), Term.TBool(false))
        "bool.or.true_l" -> plain([bo("b")], conn("Bool.or", Term.TBool(true), v("b")), Term.TBool(true))
        "bool.or.false_l" -> plain([bo("b")], conn("Bool.or", Term.TBool(false), v("b")), v("b"))
        "bool.or.true_r" -> plain([bo("a")], conn("Bool.or", v("a"), Term.TBool(true)), Term.TBool(true))
        "bool.or.false_r" -> plain([bo("a")], conn("Bool.or", v("a"), Term.TBool(false)), v("a"))
        "bool.and.elim_l" -> Option.Some(Schema(binders = [bo("a"), bo("b")], premises = [is(conn("Bool.and", v("a"), v("b")), true)], concl = is(v("a"), true)))
        "bool.and.elim_r" -> Option.Some(Schema(binders = [bo("a"), bo("b")], premises = [is(conn("Bool.and", v("a"), v("b")), true)], concl = is(v("b"), true)))
        _ -> comparisonSchema(id)

verify schema
    schema("simp") => Option.None
    schema("bool.not.true") => Option.None
    schema("bool.and.true_l") => plain([bo("b")], conn("Bool.and", Term.TBool(true), v("b")), v("b"))

fn complement(p: String, pv: Bool, q: String, qv: Bool, binders: List<TypedVar>) -> Option<Schema>
    ? "A decided comparison decides another of the same two terms."
    Option.Some(Schema(binders = binders, premises = [is(Term.TOp(p, v("a"), v("b")), pv)], concl = is(Term.TOp(q, v("a"), v("b")), qv)))

verify complement
    complement("<", true, "==", false, [i("a"), i("b")]) => Option.Some(Schema(binders = [i("a"), i("b")], premises = [is(Term.TOp("<", v("a"), v("b")), true)], concl = is(Term.TOp("==", v("a"), v("b")), false)))

fn comparisonSchema(id: String) -> Option<Schema>
    ? "!= on Int as the negation of ==, an Int equality decided by the two orders, == as equality, as reflexive and as symmetric where the type's == is equality, and the product of two nonnegative Ints. A comparison decided by its complement (a > b false gives a <= b true) is a linear step, not a rule."
    ints = [i("a"), i("b")]
    match id
        "int.ne.def" -> plain(ints, Term.TOp("!=", v("a"), v("b")), Term.TBi("Bool.not", [Term.TOp("==", v("a"), v("b"))]))
        "int.eq.of_le_ge" -> Option.Some(Schema(binders = ints, premises = [is(Term.TOp("<=", v("a"), v("b")), true), is(Term.TOp(">=", v("a"), v("b")), true)], concl = is(Term.TOp("==", v("a"), v("b")), true)))
        "int.mul_nonneg" -> Option.Some(Schema(binders = ints, premises = [is(Term.TOp("<=", Term.TInt(0), v("a")), true), is(Term.TOp("<=", Term.TInt(0), v("b")), true)], concl = is(Term.TOp("<=", Term.TInt(0), Term.TOp("*", v("a"), v("b"))), true)))
        "int.eq.false_of_lt" -> complement("<", true, "==", false, ints)
        "int.eq.false_of_gt" -> complement(">", true, "==", false, ints)
        "int.eq.of_beq" -> Option.Some(Schema(binders = [same("a"), same("b")], premises = [is(Term.TOp("==", v("a"), v("b")), true)], concl = eq(v("a"), v("b"))))
        "bool.beq.refl" -> plain([same("a")], Term.TOp("==", v("a"), v("a")), Term.TBool(true))
        "bool.beq.symm" -> plain([same("a"), same("b")], Term.TOp("==", v("a"), v("b")), Term.TOp("==", v("b"), v("a")))
        _ -> divisionSchema(id)

verify comparisonSchema
    comparisonSchema("nope") => Option.None
    comparisonSchema("int.le.of_not_gt") => Option.None
    comparisonSchema("int.ne.def") => plain([i("a"), i("b")], Term.TOp("!=", v("a"), v("b")), Term.TBi("Bool.not", [Term.TOp("==", v("a"), v("b"))]))
    comparisonSchema("int.mul_nonneg") => Option.Some(Schema(binders = [i("a"), i("b")], premises = [is(Term.TOp("<=", Term.TInt(0), v("a")), true), is(Term.TOp("<=", Term.TInt(0), v("b")), true)], concl = is(Term.TOp("<=", Term.TInt(0), Term.TOp("*", v("a"), v("b"))), true)))
    comparisonSchema("int.eq.of_beq") => Option.Some(Schema(binders = [same("a"), same("b")], premises = [is(Term.TOp("==", v("a"), v("b")), true)], concl = eq(v("a"), v("b"))))

fn divE(a: Term, k: Term) -> Term
    ? "Euclidean division by a literal, as the compiler writes it."
    Term.TBi("__int_div_euclid", [a, k])

verify divE
    divE(v("a"), Term.TInt(2)) => Term.TBi("__int_div_euclid", [v("a"), Term.TInt(2)])

fn modE(a: Term, k: Term) -> Term
    ? "Euclidean remainder by a literal."
    Term.TBi("__int_mod_euclid", [a, k])

verify modE
    modE(v("a"), Term.TInt(2)) => Term.TBi("__int_mod_euclid", [v("a"), Term.TInt(2)])

fn range(t: Term, bound: Term) -> Term
    ? "0 <= t and t < bound."
    conn("Bool.and", Term.TOp("<=", Term.TInt(0), t), Term.TOp("<", t, bound))

verify range
    range(v("a"), v("m")) => conn("Bool.and", Term.TOp("<=", Term.TInt(0), v("a")), Term.TOp("<", v("a"), v("m")))

fn divisionSchema(id: String) -> Option<Schema>
    ? "Int.div and Int.mod by a divisor that is not 0 as the Euclidean quotient and remainder, and Euclidean division by a positive divisor."
    match id
        "int.div.ok" -> Option.Some(Schema(binders = [i("a"), i("k")], premises = [is(Term.TOp("==", v("k"), Term.TInt(0)), false)], concl = eq(Term.TBi("Int.div", [v("a"), v("k")]), Term.TCtor("Result.Ok", [divE(v("a"), v("k"))]))))
        "int.mod.ok" -> Option.Some(Schema(binders = [i("a"), i("k")], premises = [is(Term.TOp("==", v("k"), Term.TInt(0)), false)], concl = eq(Term.TBi("Int.mod", [v("a"), v("k")]), Term.TCtor("Result.Ok", [modE(v("a"), v("k"))]))))
        "int.div_mod_recompose" -> Option.Some(Schema(binders = [i("a"), i("k")], premises = [is(Term.TOp(">", v("k"), Term.TInt(0)), true)], concl = eq(Term.TOp("+", Term.TOp("*", divE(v("a"), v("k")), v("k")), modE(v("a"), v("k"))), v("a"))))
        "int.mod_range" -> Option.Some(Schema(binders = [i("a"), i("k")], premises = [is(Term.TOp(">", v("k"), Term.TInt(0)), true)], concl = is(range(modE(v("a"), v("k")), v("k")), true)))
        "int.div_range" -> Option.Some(Schema(binders = [i("a"), i("k"), i("m"), i("n")], premises = [is(range(v("a"), v("m")), true), is(conn("Bool.and", Term.TOp(">", v("k"), Term.TInt(0)), Term.TOp("==", v("m"), Term.TOp("*", v("n"), v("k")))), true)], concl = is(range(divE(v("a"), v("k")), v("n")), true)))
        _ -> bitsSchema(id)

verify divisionSchema
    divisionSchema("int.div.ok") => Option.Some(Schema(binders = [i("a"), i("k")], premises = [is(Term.TOp("==", v("k"), Term.TInt(0)), false)], concl = eq(Term.TBi("Int.div", [v("a"), v("k")]), Term.TCtor("Result.Ok", [divE(v("a"), v("k"))]))))
    divisionSchema("int.div_range") == Option.None => false

fn shl(a: Term, n: Term) -> Term
    ? "A shift left by a count, as the compiler writes Bits.shiftLeft with a literal count."
    Term.TBi("__bits_shl", [a, n])

verify shl
    shl(v("a"), Term.TInt(3)) => Term.TBi("__bits_shl", [v("a"), Term.TInt(3)])

fn powerOfTwo(k: Term) -> Term
    ? "0 <= n and k == 2^n, written as a shift of 1."
    conn("Bool.and", Term.TOp("<=", Term.TInt(0), v("n")), Term.TOp("==", k, shl(Term.TInt(1), v("n"))))

verify powerOfTwo
    powerOfTwo(v("k")) => conn("Bool.and", Term.TOp("<=", Term.TInt(0), v("n")), Term.TOp("==", v("k"), shl(Term.TInt(1), v("n"))))

fn bitsSchema(id: String) -> Option<Schema>
    ? "The bit-level view of Int, infinite two's complement: complement, a shift left, a low mask 2^n - 1 and a one-bit mask 2^n."
    match id
        "bits.not" -> plain([i("a")], Term.TBi("Bits.not", [v("a")]), Term.TOp("-", Term.TOp("-", Term.TInt(0), v("a")), Term.TInt(1)))
        "bits.shl" -> Option.Some(Schema(binders = [i("a"), i("n"), i("k")], premises = [is(powerOfTwo(v("k")), true)], concl = eq(shl(v("a"), v("n")), Term.TOp("*", v("a"), v("k")))))
        "bits.and_low" -> Option.Some(Schema(binders = [i("a"), i("m"), i("k"), i("n")], premises = [is(conn("Bool.and", conn("Bool.and", Term.TOp("<=", Term.TInt(0), v("n")), Term.TOp("==", Term.TOp("+", v("m"), Term.TInt(1)), v("k"))), Term.TOp("==", v("k"), shl(Term.TInt(1), v("n")))), true)], concl = eq(Term.TBi("Bits.and", [v("a"), v("m")]), modE(v("a"), v("k")))))
        "bits.and_bit" -> Option.Some(Schema(binders = [i("a"), i("k"), i("n")], premises = [is(powerOfTwo(v("k")), true)], concl = eq(Term.TBi("Bits.and", [v("a"), v("k")]), Term.TOp("*", v("k"), modE(divE(v("a"), v("k")), Term.TInt(2))))))
        _ -> listSchema(id)

verify bitsSchema
    bitsSchema("bits.not") => plain([i("a")], Term.TBi("Bits.not", [v("a")]), Term.TOp("-", Term.TOp("-", Term.TInt(0), v("a")), Term.TInt(1)))
    bitsSchema("bits.and_bit") == Option.None => false

fn cons(x: Term, xs: Term) -> Term
    ? "An element in front of a list."
    Term.TBi("List.prepend", [x, xs])

verify cons
    cons(v("x"), Term.TList([])) => Term.TBi("List.prepend", [v("x"), Term.TList([])])

fn lb(name: String, args: List<Term>) -> Term
    ? "A list builtin applied to its arguments."
    Term.TBi("List.{name}", args)

verify lb
    lb("len", [v("a")]) => Term.TBi("List.len", [v("a")])

fn counted(binders: List<TypedVar>, positive: Bool, l: Term, r: Term) -> Option<Schema>
    ? "A rule on a count n that holds when n > 0 (positive) or when n <= 0."
    premise = match positive
        true -> is(Term.TOp(">", v("n"), Term.TInt(0)), true)
        false -> is(Term.TOp("<=", v("n"), Term.TInt(0)), true)
    Option.Some(Schema(binders = binders, premises = [premise], concl = eq(l, r)))

verify counted
    counted([i("n")], false, Term.TUnit, Term.TUnit) => Option.Some(Schema(binders = [i("n")], premises = [is(Term.TOp("<=", v("n"), Term.TInt(0)), true)], concl = eq(Term.TUnit, Term.TUnit)))

fn listSchema(id: String) -> Option<Schema>
    ? "Each list builtin on an element in front of a list, and on the empty list where it has another argument; List.len([]) and List.reverse([]) are closed, so compute shows them."
    xa = cons(v("x"), v("a"))
    nil = Term.TList([])
    less = Term.TOp("-", v("n"), Term.TInt(1))
    xan = [any("x"), lt("a"), i("n")]
    match id
        "list.concat.nil" -> plain([lt("b")], lb("concat", [nil, v("b")]), v("b"))
        "list.concat.cons" -> plain([any("x"), lt("a"), lt("b")], lb("concat", [xa, v("b")]), cons(v("x"), lb("concat", [v("a"), v("b")])))
        "list.len.cons" -> plain([any("x"), lt("a")], lb("len", [xa]), Term.TOp("+", lb("len", [v("a")]), Term.TInt(1)))
        "list.take.nil" -> plain([i("n")], lb("take", [nil, v("n")]), nil)
        "list.take.cons_le" -> counted(xan, false, lb("take", [xa, v("n")]), nil)
        "list.take.cons_gt" -> counted(xan, true, lb("take", [xa, v("n")]), cons(v("x"), lb("take", [v("a"), less])))
        "list.drop.nil" -> plain([i("n")], lb("drop", [nil, v("n")]), nil)
        "list.drop.cons_le" -> counted(xan, false, lb("drop", [xa, v("n")]), xa)
        "list.drop.cons_gt" -> counted(xan, true, lb("drop", [xa, v("n")]), lb("drop", [v("a"), less]))
        "list.reverse.cons" -> plain([any("x"), lt("a")], lb("reverse", [xa]), lb("concat", [lb("reverse", [v("a")]), cons(v("x"), nil)]))
        _ -> mapSchema(id)

verify listSchema
    listSchema("list.len.nil") => Option.None
    listSchema("list.len.cons") => plain([any("x"), lt("a")], Term.TBi("List.len", [Term.TBi("List.prepend", [v("x"), v("a")])]), Term.TOp("+", Term.TBi("List.len", [v("a")]), Term.TInt(1)))
    listSchema("list.len") => Option.None

fn mb(name: String, args: List<Term>) -> Term
    ? "A Map builtin applied to its arguments; the empty map is Map.empty()."
    Term.TBi("Map.{name}", args)

verify mb
    mb("empty", []) => Term.TBi("Map.empty", [])

fn mapSchema(id: String) -> Option<Schema>
    ? "Each Map read on the empty map and on a set: at the key set, at another key, and the size by membership."
    set = mb("set", [v("m"), v("k"), v("v")])
    empty = mb("empty", [])
    other = [is(Term.TOp("!=", v("k"), v("k2")), true)]
    mkv = [kv("m"), key("k"), val("v")]
    mkv2 = [kv("m"), key("k"), val("v"), key("k2")]
    match id
        "map.get.empty" -> plain([key("k")], mb("get", [empty, v("k")]), Term.TCtor("Option.None", []))
        "map.get.set_same" -> plain(mkv, mb("get", [set, v("k")]), Term.TCtor("Option.Some", [v("v")]))
        "map.get.set_other" -> Option.Some(Schema(binders = mkv2, premises = other, concl = eq(mb("get", [set, v("k2")]), mb("get", [v("m"), v("k2")]))))
        "map.has.empty" -> plain([key("k")], mb("has", [empty, v("k")]), Term.TBool(false))
        "map.has.set_same" -> plain(mkv, mb("has", [set, v("k")]), Term.TBool(true))
        "map.has.set_other" -> Option.Some(Schema(binders = mkv2, premises = other, concl = eq(mb("has", [set, v("k2")]), mb("has", [v("m"), v("k2")]))))
        "map.len.empty" -> plain([], mb("len", [empty]), Term.TInt(0))
        "map.len.set_present" -> Option.Some(Schema(binders = mkv, premises = [is(mb("has", [v("m"), v("k")]), true)], concl = eq(mb("len", [set]), mb("len", [v("m")]))))
        "map.len.set_absent" -> Option.Some(Schema(binders = mkv, premises = [is(mb("has", [v("m"), v("k")]), false)], concl = eq(mb("len", [set]), Term.TOp("+", mb("len", [v("m")]), Term.TInt(1)))))
        _ -> vectorSchema(id)

verify mapSchema
    mapSchema("map.len.empty") => plain([], Term.TBi("Map.len", [Term.TBi("Map.empty", [])]), Term.TInt(0))
    mapSchema("map.keys.set") => Option.None

fn vb(name: String, args: List<Term>) -> Term
    ? "A Vector builtin applied to its arguments."
    Term.TBi("Vector.{name}", args)

verify vb
    vb("len", [v("v")]) => Term.TBi("Vector.len", [v("v")])

fn inRange(at: Term, end: Term) -> Eqn
    ? "0 <= at and at < end, as a premise."
    is(conn("Bool.and", Term.TOp("<=", Term.TInt(0), at), Term.TOp("<", at, end)), true)

verify inRange
    inRange(v("i"), v("n")) => is(conn("Bool.and", Term.TOp("<=", Term.TInt(0), v("i")), Term.TOp("<", v("i"), v("n"))), true)

fn vectorSchema(id: String) -> Option<Schema>
    ? "A vector as the list it holds; reads out of range; a read and the length after a write; a literal-size Vector.new."
    len = vb("len", [v("v")])
    written = Term.TBi("Option.withDefault", [vb("set", [v("v"), v("i"), v("x")]), v("v")])
    made = Term.TBi("__vector_new", [v("n"), v("x")])
    vi = [vec("v"), i("i")]
    vix = [vec("v"), i("i"), any("x")]
    match id
        "vector.to_list.of_list" -> plain([lt("l")], Term.TBi("List.fromVector", [vb("fromList", [v("l")])]), v("l"))
        "vector.of_list.to_list" -> plain([vec("v")], vb("fromList", [Term.TBi("List.fromVector", [v("v")])]), v("v"))
        "vector.len.to_list" -> plain([vec("v")], len, Term.TBi("List.len", [Term.TBi("List.fromVector", [v("v")])]))
        "vector.get.negative" -> Option.Some(Schema(binders = vi, premises = [is(Term.TOp("<", v("i"), Term.TInt(0)), true)], concl = eq(vb("get", [v("v"), v("i")]), Term.TCtor("Option.None", []))))
        "vector.get.past_end" -> Option.Some(Schema(binders = vi, premises = [is(Term.TOp(">=", v("i"), len), true)], concl = eq(vb("get", [v("v"), v("i")]), Term.TCtor("Option.None", []))))
        "vector.set.out_of_range" -> Option.Some(Schema(binders = vix, premises = [is(conn("Bool.or", Term.TOp("<", v("i"), Term.TInt(0)), Term.TOp(">=", v("i"), len)), true)], concl = eq(vb("set", [v("v"), v("i"), v("x")]), Term.TCtor("Option.None", []))))
        "vector.get.set_same" -> Option.Some(Schema(binders = vix, premises = [inRange(v("i"), len)], concl = eq(vb("get", [written, v("i")]), Term.TCtor("Option.Some", [v("x")]))))
        "vector.get.set_other" -> Option.Some(Schema(binders = [vec("v"), i("i"), any("x"), i("j")], premises = [inRange(v("i"), len), is(Term.TOp("!=", v("i"), v("j")), true)], concl = eq(vb("get", [written, v("j")]), vb("get", [v("v"), v("j")]))))
        "vector.len.set" -> plain(vix, vb("len", [written]), len)
        "vector.len.new" -> Option.Some(Schema(binders = [i("n"), any("x")], premises = [is(Term.TOp("<=", Term.TInt(0), v("n")), true)], concl = eq(vb("len", [made]), v("n"))))
        "vector.get.new" -> Option.Some(Schema(binders = [i("n"), any("x"), i("i")], premises = [inRange(v("i"), v("n"))], concl = eq(vb("get", [made, v("i")]), Term.TCtor("Option.Some", [v("x")]))))
        _ -> pickSchema(id)

verify vectorSchema
    vectorSchema("vector.len.set") == Option.None => false
    vectorSchema("vector.keys") => Option.None

fn picked(binders: List<TypedVar>, test: Term, holds: Bool, l: Term, r: Term) -> Option<Schema>
    ? "A rule whose value a comparison picks: l is r where the test has this value."
    Option.Some(Schema(binders = binders, premises = [is(test, holds)], concl = eq(l, r)))

verify picked
    picked([bo("a")], v("a"), true, Term.TUnit, Term.TUnit) => Option.Some(Schema(binders = [bo("a")], premises = [is(v("a"), true)], concl = eq(Term.TUnit, Term.TUnit)))

fn pickSchema(id: String) -> Option<Schema>
    ? "Int.min and Int.max by a <= b, Int.abs by a < 0; List.contains on [], on an element in front that the value looked for is (found) and past one it is not, by y == x as the builtin compares. Both read == only at a type whose == is equality, where x == x is true of every value."
    le = Term.TOp("<=", v("a"), v("b"))
    neg = Term.TOp("<", v("a"), Term.TInt(0))
    min = Term.TBi("Int.min", [v("a"), v("b")])
    max = Term.TBi("Int.max", [v("a"), v("b")])
    abs = Term.TBi("Int.abs", [v("a")])
    found = lb("contains", [v("a"), v("y")])
    match id
        "int.min.le" -> picked([i("a"), i("b")], le, true, min, v("a"))
        "int.min.gt" -> picked([i("a"), i("b")], le, false, min, v("b"))
        "int.max.le" -> picked([i("a"), i("b")], le, true, max, v("b"))
        "int.max.gt" -> picked([i("a"), i("b")], le, false, max, v("a"))
        "int.abs.neg" -> picked([i("a")], neg, true, abs, Term.TOp("-", Term.TInt(0), v("a")))
        "int.abs.nonneg" -> picked([i("a")], neg, false, abs, v("a"))
        "list.contains.nil" -> plain([any("y")], lb("contains", [Term.TList([]), v("y")]), Term.TBool(false))
        "list.contains.cons_found" -> picked([same("x"), lt("a"), same("y")], Term.TOp("==", v("y"), v("x")), true, lb("contains", [cons(v("x"), v("a")), v("y")]), Term.TBool(true))
        "list.contains.cons_other" -> picked([same("x"), lt("a"), same("y")], Term.TOp("==", v("y"), v("x")), false, lb("contains", [cons(v("x"), v("a")), v("y")]), found)
        _ -> defaultSchema(id)

verify pickSchema
    pickSchema("int.min.le") => Option.Some(Schema(binders = [i("a"), i("b")], premises = [is(Term.TOp("<=", v("a"), v("b")), true)], concl = eq(Term.TBi("Int.min", [v("a"), v("b")]), v("a"))))
    pickSchema("int.min.gt") => Option.Some(Schema(binders = [i("a"), i("b")], premises = [is(Term.TOp("<=", v("a"), v("b")), false)], concl = eq(Term.TBi("Int.min", [v("a"), v("b")]), v("b"))))
    pickSchema("int.max.le") => Option.Some(Schema(binders = [i("a"), i("b")], premises = [is(Term.TOp("<=", v("a"), v("b")), true)], concl = eq(Term.TBi("Int.max", [v("a"), v("b")]), v("b"))))
    pickSchema("int.max.gt") => Option.Some(Schema(binders = [i("a"), i("b")], premises = [is(Term.TOp("<=", v("a"), v("b")), false)], concl = eq(Term.TBi("Int.max", [v("a"), v("b")]), v("a"))))
    pickSchema("int.abs.neg") => Option.Some(Schema(binders = [i("a")], premises = [is(Term.TOp("<", v("a"), Term.TInt(0)), true)], concl = eq(Term.TBi("Int.abs", [v("a")]), Term.TOp("-", Term.TInt(0), v("a")))))
    pickSchema("int.abs.nonneg") => Option.Some(Schema(binders = [i("a")], premises = [is(Term.TOp("<", v("a"), Term.TInt(0)), false)], concl = eq(Term.TBi("Int.abs", [v("a")]), v("a"))))
    pickSchema("list.contains.nil") => plain([any("y")], Term.TBi("List.contains", [Term.TList([]), v("y")]), Term.TBool(false))
    pickSchema("list.contains.cons_other") => Option.Some(Schema(binders = [same("x"), lt("a"), same("y")], premises = [is(Term.TOp("==", v("y"), v("x")), false)], concl = eq(Term.TBi("List.contains", [Term.TBi("List.prepend", [v("x"), v("a")]), v("y")]), Term.TBi("List.contains", [v("a"), v("y")]))))
    pickSchema("list.contains.cons_found") => Option.Some(Schema(binders = [same("x"), lt("a"), same("y")], premises = [is(Term.TOp("==", v("y"), v("x")), true)], concl = eq(Term.TBi("List.contains", [Term.TBi("List.prepend", [v("x"), v("a")]), v("y")]), Term.TBool(true))))
    pickSchema("list.contains.cons") => Option.None
    pickSchema("int.min") => Option.None
    pickSchema("list.contains") => Option.None

fn defaultSchema(id: String) -> Option<Schema>
    ? "Option.withDefault and Result.withDefault on each constructor: the value a Some or an Ok holds, the default d for None or an Err."
    err = Kernel.Term.typed("e", Ty.TyVar("e", false))
    match id
        "option.with_default.some" -> plain([any("x"), any("d")], Term.TBi("Option.withDefault", [Term.TCtor("Option.Some", [v("x")]), v("d")]), v("x"))
        "option.with_default.none" -> plain([any("d")], Term.TBi("Option.withDefault", [Term.TCtor("Option.None", []), v("d")]), v("d"))
        "result.with_default.ok" -> plain([any("x"), any("d")], Term.TBi("Result.withDefault", [Term.TCtor("Result.Ok", [v("x")]), v("d")]), v("x"))
        "result.with_default.err" -> plain([err, any("d")], Term.TBi("Result.withDefault", [Term.TCtor("Result.Err", [v("e")]), v("d")]), v("d"))
        _ -> Option.None

verify defaultSchema
    defaultSchema("option.with_default.none") => Option.Some(Schema(binders = [Kernel.Term.typed("d", Ty.TyVar("t", false))], premises = [], concl = eq(Term.TBi("Option.withDefault", [Term.TCtor("Option.None", []), v("d")]), v("d"))))
    defaultSchema("option.with_default") => Option.None
