module MapEqualityComparisonOrderMapFirst
    intent =
        "One claim comparing two map-free entries and two tuple-keyed ones, with the tuple-keyed comparison written first."
        "Its sibling free_first.av is the same file with the two comparisons swapped inside a commutative and — same claim, same runtime answer, so the two must be declined or exported together."

    depends [Holder]

record Entry
    label: String
    scores: Map<Tuple<Int, Int>, Int>

fn sameScores(free: Holder.Entry, other: Holder.Entry, k: Tuple<Int, Int>) -> Bool
    ? "Whether the two tuple-keyed entries differ, and-ed with a comparison of two map-free ones."
    a = Entry(label = "x", scores = { (2, 0) => 5, k => 3})
    b = Entry(label = "x", scores = {k => 3, (2, 0) => 5})
    Bool.and(a != b, free == other)

verify sameScores
    sameScores(Holder.entryOf("q", 1), Holder.entryOf("q", 1), (1, 0)) => true
