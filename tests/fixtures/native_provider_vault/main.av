module NativeProviderVault
    intent = "Exercise native opaque resources across direct and parallel calls."
    depends [Vault]
    exposes [TokenBox, TokenBag, openAndRead, openPair, consume, boxToken, bagToken, main]
    effects [Vault.open, Vault.read]

record TokenBox
    token: Vault.Token

type TokenBag
    Memory(Int)
    Stored(Vault.Token)

fn openAndRead() -> Result<Int, String>
    ! [Vault.open, Vault.read]
    token = Vault.open()?
    Vault.read(token)

fn openPair() -> Tuple<Result<Vault.Token, String>, Result<Vault.Token, String>>
    ! [Vault.open]
    (Vault.open(), Vault.open())!

fn consume(token: Vault.Token) -> Result<Int, String>
    ! [Vault.read]
    Vault.read(token)

fn boxToken(token: Vault.Token) -> TokenBox
    TokenBox(token = token)

fn bagToken(token: Vault.Token) -> TokenBag
    TokenBag.Stored(token)

fn main() -> Unit
    Unit
