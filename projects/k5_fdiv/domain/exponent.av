    exponentPh3(0, 18) => true

verify exponentPh3 law table3_row28
    given ep: Int = [0]
    given eP3: Int = [0]
    given ePh3: Int = [0]
    when ep - 384 <= eP3
    when eP3 <= ep + 18
    when ePh3 == eP3
    exponentPh3(ep, ePh3) holds

fn exponentQ3(ep: Int, ed: Int, eQ3: Int) -> Bool
    ? "Table 3 row 29 (p.32): q3 != 0 implies ep - ed - 386 <= e(q3) <= ep - ed + 21. q3 = trunc(sd2*ph3, 24): the §8.1 estimate e(sd2) in [-ed-2, -ed+1] times e(ph3) in [ep-384, ep+18] (row 28) by 7.1.7, then rounded to 24 bits. The paper's Table 3 bounds the rounding to 24 bits uniformly by e in [ex, ex+1] (the same bound as the away digits q0/q1/q2); trunc's exact e = ex is a sub-interval, so the +1 upper holds."
    Bool.and(ep - ed - 386 <= eQ3, eQ3 <= ep - ed + 21)

verify exponentQ3
    exponentQ3(0, 0, 0) => true
    exponentQ3(0, 0, 21) => true

verify exponentQ3 law table3_row29
    given ep: Int = [0]
    given ed: Int = [0]
    given eSd2: Int = [0]
    given ePh3: Int = [0]
    given eProd3: Int = [0]
    given eQ3: Int = [0]
    when 0 - ed - 2 <= eSd2
    when eSd2 <= 0 - ed + 1
    when ep - 384 <= ePh3
    when ePh3 <= ep + 18
    when eSd2 + ePh3 <= eProd3
    when eProd3 <= eSd2 + ePh3 + 1
    when eProd3 <= eQ3
    when eQ3 <= eProd3 + 1
    exponentQ3(ep, ed, eQ3) holds

fn exponentQq2(ep: Int, ed: Int, eQq2: Int) -> Bool
    ? "Table 3 row 30 (p.32): p2 != 0 implies ep - ed - 409 <= e(qq2) <= ep - ed + 22. qq2 = sticky(q2 + q3, 64): the 9.3.1/9.3.2 sum of two 24-bit quotient digits (P=24), e(q2) in [ep-ed-258, ep-ed+15] (row 23) and e(q3) in [ep-ed-386, ep-ed+21] (row 29); the digit sum fits in 64 bits, so sticky to 64 is exact and preserves the exponent."
    Bool.and(ep - ed - 409 <= eQq2, eQq2 <= ep - ed + 22)

verify exponentQq2
    exponentQq2(0, 0, 0) => true
    exponentQq2(0, 0, 22) => true

verify exponentQq2 law table3_row30
    given ep: Int = [0]
    given ed: Int = [0]
    given eQ2: Int = [0]
    given eQ3: Int = [0]
    given eSum2: Int = [0]
    given eQq2: Int = [0]
    when ep - ed - 258 <= eQ2
    when eQ2 <= ep - ed + 15
    when ep - ed - 386 <= eQ3
    when eQ3 <= ep - ed + 21
    when 1 - maxInt(24, 24) + minInt(eQ2, eQ3) <= eSum2
    when eSum2 <= 1 + maxInt(eQ2, eQ3)
    when eQq2 == eSum2
    exponentQq2(ep, ed, eQq2) holds

fn exponentQq1(ep: Int, ed: Int, eQq1: Int) -> Bool
    ? "Table 3 row 31 (p.32): p1 != 0 implies ep - ed - 472 <= e(qq1) <= ep - ed + 23. qq1 = sticky(qq2 + q1, 64): the 9.3.1/9.3.2 sum (P = max(64,24) = 64) of e(qq2) in [ep-ed-409, ep-ed+22] (row 30) and e(q1) in [ep-ed-130, ep-ed+9] (row 17); the sum fits in 64 bits, so sticky to 64 is exact and preserves the exponent."
    Bool.and(ep - ed - 472 <= eQq1, eQq1 <= ep - ed + 23)

verify exponentQq1
    exponentQq1(0, 0, 0) => true
    exponentQq1(0, 0, 23) => true

verify exponentQq1 law table3_row31
    given ep: Int = [0]
    given ed: Int = [0]
    given eQq2: Int = [0]
    given eQ1: Int = [0]
    given eSum1: Int = [0]
    given eQq1: Int = [0]
    when ep - ed - 409 <= eQq2
    when eQq2 <= ep - ed + 22
    when ep - ed - 130 <= eQ1
    when eQ1 <= ep - ed + 9
    when 1 - maxInt(64, 24) + minInt(eQq2, eQ1) <= eSum1
    when eSum1 <= 1 + maxInt(eQq2, eQ1)
    when eQq1 == eSum1
    exponentQq1(ep, ed, eQq1) holds

fn exponentDivide(ep: Int, ed: Int, eDivide: Int) -> Bool
    ? "Table 3 row 32 (p.32): p != 0 implies ep - ed - 535 <= e(divide!) <= ep - ed + 25. divide! = round(qq1 + q0, mode): the 9.3.1/9.3.2 sum (P = max(64,24) = 64) of e(qq1) in [ep-ed-472, ep-ed+23] (row 31) and e(q0) in [ep-ed-2, ep-ed+3] (row 11), then the final round to the requested mode (round adds 0 or 1 -- the +1 carry that lifts the sum's +24 to +25). These are exactly the brackets the landed divideExponentNoOverflow / divideExponentNoUnderflow consume."
    Bool.and(ep - ed - 535 <= eDivide, eDivide <= ep - ed + 25)

verify exponentDivide
    exponentDivide(0, 0, 0) => true
    exponentDivide(0, 0, 25) => true

verify exponentDivide law table3_row32
    given ep: Int = [0]
    given ed: Int = [0]
    given eQq1: Int = [0]
    given eQ0: Int = [0]
    given eSumD: Int = [0]
    given eDivide: Int = [0]
    when ep - ed - 472 <= eQq1
    when eQq1 <= ep - ed + 23
    when ep - ed - 2 <= eQ0
    when eQ0 <= ep - ed + 3
    when 1 - maxInt(64, 24) + minInt(eQq1, eQ0) <= eSumD
    when eSumD <= 1 + maxInt(eQq1, eQ0)
    when eSumD <= eDivide
    when eDivide <= eSumD + 1
    exponentDivide(ep, ed, eDivide) holds
