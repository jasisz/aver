module Tick
    kind = capability
    semantics = effectful
    depends [Work]
    intent = "One job kind whose task carries nothing: the task type is Unit, which has no wasm value at all."
    exposes [begin, take]

operation begin(task: Unit) -> Result<Work.Job, String>
    ? "Starts one tick off the turn and returns its job handle at once."
    oracle = generativeOutput
    replay = recorded

operation take(job: Work.Job) -> Result<Option<Int>, String>
    ? "Collects one finished tick: None while it runs, Some(n) once it finished."
    oracle = generativeOutput
    replay = recorded
