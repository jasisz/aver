module Node
    intent = "Fixture: a process reads frames from a capability under slice/ answered by a module under the same directory."
    depends [Slice.Wire, Slice.Sockets]
    effects [Console.print, Slice.Wire.frame]

fn reader() -> Unit
    ? "Reads until the wire is gone."
    ! [Console.print, Slice.Wire.frame]
    match Slice.Wire.frame()
        Slice.Wire.Heard.Message(text) -> reader()
        Slice.Wire.Heard.Gone(why) -> Console.print("gone {why}")
