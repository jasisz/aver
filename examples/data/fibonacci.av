module Fibonacci
    intent =
        "Explores Fibonacci numbers and the golden ratio."
        "Single-pass stats builder computes fibs, sum, max, and evens in one traversal."
        "Stats returned as a FibStats record; accumulator state as a FibAcc record."
        "Verify blocks serve as executable examples and AI anchors."
    effects [Console]

record FibStats
  fibs: List<Int>
  sum: Int
  mx: Int
  evens: List<Int>

record FibAcc
  a: Int
  b: Int
  fibs: List<Int>
  sum: Int
  mx: Int
  evens: List<Int>

decision TailRecurrenceForPerformance
    date = "2026-02-24"
    reason =
        "Naive fib(n-1)+fib(n-2) is exponential and easy for AI to generate."
        "Tail recursion makes fib linear time and predictable."
    chosen = "TailRecursion"
    rejected = ["NaiveRecursion"]
    impacts = [fib, fibTR]

decision SinglePassStats
    date = "2026-02-25"
    reason =
        "Building a list then folding and filtering is three separate passes."
        "Accumulate sum, max, and even-filter alongside list building in one traversal."
        "Result wrapped in FibStats record: named fields replace positional list indexing."
    chosen = "SinglePassAccumulator"
    rejected = ["SeparateFoldAndFilter"]
    impacts = [buildFibStats, buildFibStatsTR]

decision AccumulatorAsRecord
    date = "2026-02-25"
    reason =
        "buildFibStatsTR originally took 8 positional parameters."
        "Eight positional args are a bug waiting to happen: easy to swap, hard to read."
        "FibAcc record gives each field a name at both call site and use site."
    chosen = "FibAccRecord"
    rejected = ["EightPositionalParams"]
    impacts = [buildFibStatsTR, buildFibStats]

decision EvenCheckWithoutModulo
    date = "2026-02-24"
    reason =
        "Aver has no modulo operator."
        "Integer division truncates: n/2*2 equals n only when n is even."
    chosen = "DivisionTrick"
    rejected = ["ModuloOperator"]
    impacts = [isEven]

decision FloatChecksUseTolerance
    date = "2026-02-24"
    reason =
        "Exact float equality is brittle."
        "Use abs + epsilon for stable verifies."
    chosen = "ApproxEq"
    rejected = ["ExactFloatEquality"]
    impacts = [goldenApprox, absF, approxEq]

fn fibTR(n: Int, a: Int, b: Int) -> Int
    ? "Tail-recursive Fibonacci worker: returns F(n) given state (a=F(0), b=F(1))."
    match n
        0 -> a
        _ -> fibTR(n - 1, b, a + b)

verify fibTR
    fibTR(0, 0, 1)  => 0
    fibTR(1, 0, 1)  => 1
    fibTR(5, 0, 1)  => 5
    fibTR(12, 0, 1) => 144

fn fib(n: Int) -> Int
    ? "Computes Fibonacci number F(n). Returns 0 for negative n."
    match n < 0
        true  -> 0
        false -> fibTR(n, 0, 1)

verify fib
    fib(-1) => 0
    fib(0)  => 0
    fib(1)  => 1
    fib(5)  => 5
    fib(10) => 55
    fib(12) => 144

verify fib law fibSpec
    given n: Int = -1..10
    fib(n) => fibSpec(n)

fn isEven(n: Int) -> Bool
    ? "Even check via integer division trick (no modulo in Aver)."
    n / 2 * 2 == n

verify isEven
    isEven(0)   => true
    isEven(1)   => false
    isEven(2)   => true
    isEven(7)   => false
    isEven(144) => true

fn bigger(a: Int, b: Int) -> Int
    ? "Returns the larger of two integers."
    match a > b
        true  -> a
        false -> b

verify bigger
    bigger(3, 5) => 5
    bigger(5, 3) => 5
    bigger(4, 4) => 4

fn prependIfEven(xs: List<Int>, n: Int) -> List<Int>
    ? "Prepends n to xs only when n is even."
    match isEven(n)
        true  -> List.prepend(n, xs)
        false -> xs

verify prependIfEven
    prependIfEven([], 0)  => [0]
    prependIfEven([], 1)  => []
    prependIfEven([2], 0) => [0, 2]
    prependIfEven([2], 3) => [2]

fn finalizeFibStats(acc: FibAcc) -> FibStats
    ? "Flips accumulator-owned lists back into presentation order."
    FibStats(fibs = List.reverse(acc.fibs), sum = acc.sum, mx = acc.mx, evens = List.reverse(acc.evens))

verify finalizeFibStats
    finalizeFibStats(FibAcc(a = 1, b = 1, fibs = [2, 1, 0], sum = 3, mx = 2, evens = [2, 0])) => FibStats(fibs = [0, 1, 2], sum = 3, mx = 2, evens = [0, 2])

fn buildFibStatsTR(remaining: Int, acc: FibAcc) -> FibStats
    ? "Single-pass builder: advances accumulator state once per remaining Fibonacci slot."
    match remaining <= 0
        true  -> finalizeFibStats(acc)
        false -> buildFibStatsTR(remaining - 1, FibAcc(a = acc.b, b = acc.a + acc.b, fibs = List.prepend(acc.a, acc.fibs), sum = acc.sum + acc.a, mx = bigger(acc.a, acc.mx), evens = prependIfEven(acc.evens, acc.a)))

verify buildFibStatsTR
    buildFibStatsTR(1, FibAcc(a = 0, b = 1, fibs = [], sum = 0, mx = 0, evens = [])) => FibStats(fibs = [0], sum = 0, mx = 0, evens = [0])
    buildFibStatsTR(5, FibAcc(a = 0, b = 1, fibs = [], sum = 0, mx = 0, evens = [])) => FibStats(fibs = [0, 1, 1, 2, 3], sum = 7, mx = 3, evens = [0, 2])

fn buildFibStats(n: Int) -> Result<FibStats, String>
    ? "Computes FibStats for F(0)..F(n) in one pass. Err for n < 0."
    match n < 0
        true  -> Result.Err("Need n >= 0")
        false -> Result.Ok(buildFibStatsTR(n + 1, FibAcc(a = 0, b = 1, fibs = [], sum = 0, mx = 0, evens = [])))

verify buildFibStats
    buildFibStats(-1) => Result.Err("Need n >= 0")
    buildFibStats(0)  => Result.Ok(FibStats(fibs = [0], sum = 0, mx = 0, evens = [0]))
    buildFibStats(4)  => Result.Ok(FibStats(fibs = [0, 1, 1, 2, 3], sum = 7, mx = 3, evens = [0, 2]))

fn nthOrZero(xs: List<Int>, index: Int) -> Int
    ? "Returns the nth element of xs, or 0 when index is out of bounds."
    match xs
        [] -> 0
        [head, ..tail] -> match index <= 0
            true -> head
            false -> nthOrZero(tail, index - 1)

verify nthOrZero
    nthOrZero([], 0) => 0
    nthOrZero([4], 0) => 4
    nthOrZero([4, 5, 6], 2) => 6
    nthOrZero([4, 5], 9) => 0

fn fibSpec(n: Int) -> Int
    ? "Specification for fib as the direct Fibonacci recurrence."
    match n < 0
        true -> 0
        false -> match n
            0 -> 0
            1 -> 1
            _ -> fibSpec(n - 1) + fibSpec(n - 2)

verify fibSpec
    fibSpec(-1) => 0
    fibSpec(0)  => 0
    fibSpec(1)  => 1
    fibSpec(5)  => 5
    fibSpec(10) => 55

fn showListIntInner(xs: List<Int>) -> String
    ? "Comma-separated body of a List<Int> render. Recursive — Aver stdlib has no map."
    match xs
        [] -> ""
        [head, ..tail] -> match tail
            [] -> "{head}"
            _  -> "{head}, {showListIntInner(tail)}"

fn showListInt(xs: List<Int>) -> String
    ? "Render List<Int> as `[1, 2, 3]`."
    "[{showListIntInner(xs)}]"

fn printStats(s: FibStats) -> Unit
    ? "Print all fields of a FibStats record to stdout."
    ! [Console.print]
    Console.print("Fibonacci [0..{List.len(s.fibs) - 1}]:")
    Console.print(showListInt(s.fibs))
    Console.print("Sum: {s.sum}")
    Console.print("Max: {s.mx}")
    Console.print("Even Fibonacci numbers: {showListInt(s.evens)}")

fn absF(x: Float) -> Float
    ? "Absolute value for Float using comparison and negation."
    match x < 0.0
        true  -> 0.0 - x
        false -> x

verify absF
    absF(-2.5) => 2.5
    absF(0.0)  => 0.0
    absF(3.25) => 3.25

fn approxEq(x: Float, y: Float, eps: Float) -> Bool
    ? "Returns true when |x - y| <= eps."
    absF(x - y) <= eps

verify approxEq
    approxEq(1.0, 1.0, 0.0)      => true
    approxEq(1.0, 1.0001, 0.001) => true
    approxEq(1.0, 1.01, 0.001)   => false

fn goldenApprox(n: Int) -> Result<Float, String>
    ? "Approximates golden ratio as F(n+1)/F(n). Requires n >= 1."
    match n < 1
        true  -> Result.Err("Need n >= 1")
        false -> Result.Ok(Float.fromInt(fib(n + 1)) / Float.fromInt(fib(n)))

verify goldenApprox
    goldenApprox(0) => Result.Err("Need n >= 1")
    approxEq(goldenApprox(1)?, 1.0, 0.000001) => true
    approxEq(goldenApprox(2)?, 2.0, 0.000001) => true
    approxEq(goldenApprox(10)?, 1.618181818, 0.00001) => true

fn showGolden(r: Result<Float, String>) -> String
    ? "Render the goldenApprox Result as `Ok(N)` or `Err(\"...\")`."
    match r
        Result.Ok(x)    -> "Ok({x})"
        Result.Err(msg) -> "Err(\"{msg}\")"

fn main() -> Unit
    ! [Console.print]
    result = buildFibStats(12)
    match result
        Result.Ok(stats) -> printStats(stats)
        Result.Err(msg)  -> Console.print(msg)
    Console.print("Golden ratio approx (n=5): {showGolden(goldenApprox(5))}")
    Console.print("Golden ratio approx (n=10): {showGolden(goldenApprox(10))}")
    Console.print("Golden ratio approx (n=12): {showGolden(goldenApprox(12))}")
