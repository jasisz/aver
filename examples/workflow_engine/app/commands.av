    context = loadTaskContext(taskId)?
    now = Infra.Clock.now()
    _active = Domain.Validation.ensureProjectActive(context.project)?
    event = Domain.Tasks.clearDeadline(context.task, Domain.Tasks.nextSeq(context.taskEvents), now)?
