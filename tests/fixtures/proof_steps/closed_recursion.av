module ClosedRecursion
    intent =
        "Laws steps leave open at a recursive call they do not open, and the reason each refusal"
        "gives: a `match` on an Int's literals calling itself with `n - 1` is not a recursion steps"
        "follow; a division down to zero is one, kept whole only in the attempt that keeps it so."
    exposes [count, bytesOf]
    effects []

fn count(n: Int) -> Int
    ? "n for n at least zero, counted one at a time."
    match n
        0 -> 0
        _ -> 1 + count(n - 1)

verify count
    count(0) => 0
    count(3) => 3

verify count law nonnegative
    given n: Int = [0, 1, 3]
    count(n) >= 0 => true

fn bytesOf(value: Int, acc: Int) -> Int
    ? "acc plus the bytes a non-negative value occupies."
    match value <= 0
        true -> acc
        false -> bytesOf(Int.div(value, 256), acc + 1)

verify bytesOf
    bytesOf(0, 0) => 0
    bytesOf(256, 0) => 2

verify bytesOf law belowTheValue
    given value: Int = [1, 255, 256, 70000]
    bytesOf(value, 0) * 8 <= value * 8 + 7 => true
