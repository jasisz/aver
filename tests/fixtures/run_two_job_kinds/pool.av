module Pool
    kind = capability
    semantics = effectful
    intent = "Fixture capability: the score of one task, and what every task scored together."
    exposes [scored, total]

operation scored(task: Int) -> Int
    ? "What one task scores, computed off the turn; 0 for a task that never will."
    oracle = generative
    replay = recorded

operation total() -> Int
    ? "What every task scored together, once every one of them has landed."
    oracle = generative
    replay = recorded
