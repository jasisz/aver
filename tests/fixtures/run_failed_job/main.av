module Node
    intent = "Fixture: a job cancelled before anything takes it. The request parked on it is asked only in a turn whose wait reported the job, the take answers why the job will never finish, and the run reaches its end."
    depends [Pool, Pooled, Validation, Wait, Work]
    effects [Console.print, Pool.scored, Validation.begin, Work.cancel, yield]

fn probing() -> Unit
    ? "Reads the wake gate against a live job handle, then asks for the score of a job that was cancelled and says what came of it."
    ! [Console.print, Pool.scored, Validation.begin, Work.cancel, yield]
    Console.print(probe())
    Console.print(landed(Pool.scored(1)))

fn probe() -> String
    ? "Begins one job, reads the wake gate of a request parked on it, and cancels it again. The gate is read here rather than in a law because a job handle is a resource no law can write down."
    ! [Validation.begin, Work.cancel]
    match Validation.begin(2)
        Result.Err(reason) -> "the job did not begin: {reason}"
        Result.Ok(job) -> probeGated(job, __parked(__asked(__Process.Probing(__ProbingRequest.Scored(2, __ProbingScoredState.Await1)), 1), Run.Wake.Until([Wait.Item.Job(job)], Option.None), 1000, 1, 0))

fn probeGated(job: Work.Job, parked: __Slot) -> String
    ? "A request parked on this job is asked in a turn whose wait reported the slot's key, and in no other."
    ! [Work.cancel]
    _stopped = Work.cancel(job)
    run = __Run.update(__fresh(), now = 1000)
    gated(__askableSlot(run, parked, [], 1), __askableSlot(run, parked, [1], 1))

fn gated(quiet: Bool, reported: Bool) -> String
    ? "The two readings of one parked slot, as the one line a run says them in."
    match quiet
        true -> "the gate asked a job the wait did not report"
        false -> match reported
            true -> "gated on the job"
            false -> "the gate did not ask a job the wait reported"

verify gated
    gated(false, true) => "gated on the job"
    gated(true, true) => "the gate asked a job the wait did not report"
    gated(false, false) => "the gate did not ask a job the wait reported"

fn landed(outcome: Result<Int, String>) -> String
    ? "What one score request answered."
    match outcome
        Result.Err(reason) -> "cancelled, then answered: {reason}"
        Result.Ok(points) -> "scored {points}"

verify landed
    landed(Result.Err("work: job cancelled")) => "cancelled, then answered: work: job cancelled"
    landed(Result.Ok(4)) => "scored 4"
