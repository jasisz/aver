module Routes
    intent =
        "HTTP routing for the Notepad REST API."
        "Maps endpoints to store operations and builds JSON responses."
    exposes [handleRequest]
    depends [Examples.Notepad.Store, Examples.Json]

decision JsonModuleSerialization
    date = "2026-03-01"
    reason =
        "Examples.Json now provides fromString/toString API."
        "JSON should be built from typed Json values, not string templates."
        "Serializer handles escaping consistently."
    chosen = "TypedJsonValues"
    rejected = ["StringTemplates", "ManualConcatenation"]

    impacts = [noteToJson, jsonNote, jsonNoteList, jsonOk, jsonErr]

// --- JSON helpers ---

fn noteToJson(note: Note) -> Json
    ? "Converts a Note record into a Json object value."
    = Examples.Json.Json.JsonObject({"id" => Examples.Json.Json.JsonInt(note.id), "title" => Examples.Json.Json.JsonString(note.title), "body" => Examples.Json.Json.JsonString(note.body)})

verify noteToJson
    noteToJson(Note(id = 1, title = "Hi", body = "there")) => Examples.Json.Json.JsonObject({"id" => Examples.Json.Json.JsonInt(1), "title" => Examples.Json.Json.JsonString("Hi"), "body" => Examples.Json.Json.JsonString("there")})

fn jsonNote(note: Note) -> String
    ? "Serializes a Note as a JSON object."
    = Examples.Json.toString(noteToJson(note))

verify jsonNote
    Examples.Json.fromString(jsonNote(Note(id = 1, title = "Hi", body = "there"))) => Result.Ok(noteToJson(Note(id = 1, title = "Hi", body = "there")))

fn jsonNoteList(notes: List<Note>) -> String
    ? "Serializes a list of Notes as a JSON array."
    values = List.map(notes, noteToJson)
    Examples.Json.toString(Examples.Json.Json.JsonList(values))

verify jsonNoteList
    jsonNoteList([]) => "[]"
    Examples.Json.fromString(jsonNoteList([Note(id = 1, title = "A", body = "a"), Note(id = 2, title = "B", body = "b")])) => Result.Ok(Examples.Json.Json.JsonList([noteToJson(Note(id = 1, title = "A", body = "a")), noteToJson(Note(id = 2, title = "B", body = "b"))]))

fn jsonOk(msg: String) -> String
    ? "Wraps a message in a JSON success envelope."
    = Examples.Json.toString(Examples.Json.Json.JsonObject({"ok" => Examples.Json.Json.JsonString(msg)}))

verify jsonOk
    jsonOk("done") => "{{\"ok\":\"done\"}}"

fn jsonErr(msg: String) -> String
    ? "Wraps a message in a JSON error envelope."
    = Examples.Json.toString(Examples.Json.Json.JsonObject({"error" => Examples.Json.Json.JsonString(msg)}))

verify jsonErr
    jsonErr("oops") => "{{\"error\":\"oops\"}}"

fn jsonHeaders() -> List<Header>
    ? "Standard JSON Content-Type headers."
    = [Header(name = "Content-Type", value = "application/json")]

verify jsonHeaders
    jsonHeaders() => [Header(name = "Content-Type", value = "application/json")]

// --- response builders ---

fn ok(body: String) -> HttpResponse
    ? "Builds a 200 response with JSON headers."
    = HttpResponse(status = 200, body = body, headers = jsonHeaders())

verify ok
    ok("x") => HttpResponse(status = 200, body = "x", headers = jsonHeaders())

fn created(body: String) -> HttpResponse
    ? "Builds a 201 response with JSON headers."
    = HttpResponse(status = 201, body = body, headers = jsonHeaders())

verify created
    created("x") => HttpResponse(status = 201, body = "x", headers = jsonHeaders())

fn notFound(msg: String) -> HttpResponse
    ? "Builds a 404 JSON error response."
    = HttpResponse(status = 404, body = jsonErr(msg), headers = jsonHeaders())

verify notFound
    notFound("missing") => HttpResponse(status = 404, body = "{{\"error\":\"missing\"}}", headers = jsonHeaders())

fn badRequest(msg: String) -> HttpResponse
    ? "Builds a 400 JSON error response."
    = HttpResponse(status = 400, body = jsonErr(msg), headers = jsonHeaders())

verify badRequest
    badRequest("bad") => HttpResponse(status = 400, body = "{{\"error\":\"bad\"}}", headers = jsonHeaders())

fn serverError(msg: String) -> HttpResponse
    ? "Builds a 500 JSON error response."
    = HttpResponse(status = 500, body = jsonErr(msg), headers = jsonHeaders())

verify serverError
    serverError("boom") => HttpResponse(status = 500, body = "{{\"error\":\"boom\"}}", headers = jsonHeaders())

fn methodNotAllowed() -> HttpResponse
    ? "Builds a 405 JSON error response."
    = HttpResponse(status = 405, body = jsonErr("Method not allowed"), headers = jsonHeaders())

verify methodNotAllowed
    methodNotAllowed() => HttpResponse(status = 405, body = "{{\"error\":\"Method not allowed\"}}", headers = jsonHeaders())

fn extractNoteId(path: String) -> Result<Int, String>
    ? "Extracts a numeric ID from a /notes/<id> path."
    parts = String.split(path, "/")
    rawId = Option.toResult(List.get(parts, 2), "missing note ID")?
    Int.fromString(rawId)

verify extractNoteId
    extractNoteId("/notes/42") => Result.Ok(42)
    extractNoteId("/notes/abc") => Result.Err("Cannot parse 'abc' as Int")

// --- request body parsing ---

fn parseTitle(body: String) -> Result<String, String>
    ? "Extracts and validates the title from a request body (first line)."
    lines = String.split(body, "\n")
    title = Option.toResult(List.get(lines, 0), "request body is empty")?
    match String.len(String.trim(title)) > 0
        false -> Result.Err("title cannot be empty")
        true -> Result.Ok(title)

verify parseTitle
    parseTitle("Buy milk") => Result.Ok("Buy milk")
    parseTitle("") => Result.Err("title cannot be empty")

fn extractBody(raw: String) -> String
    ? "Extracts the body portion (everything after the first line)."
    lines = String.split(raw, "\n")
    tail = Option.withDefault(List.tail(lines), [])
    String.join(tail, "\n")

verify extractBody
    extractBody("title\nbody text") => "body text"
    extractBody("title only") => ""

// --- route handlers ---

fn handleListNotes() -> HttpResponse
    ? "GET /notes — returns all notes as a JSON array."
    ! [Disk]
    match Examples.Notepad.Store.loadAll()
        Result.Ok(notes) -> ok(jsonNoteList(notes))
        Result.Err(msg)  -> serverError(msg)

fn handleGetNote(path: String) -> HttpResponse
    ? "GET /notes/:id — returns one note as JSON."
    ! [Disk]
    match extractNoteId(path)
        Result.Err(msg) -> badRequest(msg)
        Result.Ok(id)   -> lookupNote(id)

fn lookupNote(id: Int) -> HttpResponse
    ? "Loads all notes and finds the one matching the given ID."
    ! [Disk]
    match Examples.Notepad.Store.loadAll()
        Result.Err(msg)  -> serverError(msg)
        Result.Ok(notes) -> match Examples.Notepad.Store.findById(notes, id)
            Option.None       -> notFound("note {id} not found")
            Option.Some(note) -> ok(jsonNote(note))

fn handleCreateNote(body: String) -> HttpResponse
    ? "POST /notes — creates a new note from the request body."
    ! [Disk]
    match parseTitle(body)
        Result.Err(msg)  -> badRequest(msg)
        Result.Ok(title) -> createNote(title, extractBody(body))

fn createNote(title: String, body: String) -> HttpResponse
    ? "Persists a new note and returns the created JSON."
    ! [Disk]
    match Examples.Notepad.Store.addNote(title, body)
        Result.Ok(note) -> created(jsonNote(note))
        Result.Err(msg) -> serverError(msg)

fn handleDeleteNote(path: String) -> HttpResponse
    ? "DELETE /notes/:id — removes a note by ID."
    ! [Disk]
    match extractNoteId(path)
        Result.Err(msg) -> badRequest(msg)
        Result.Ok(id)   -> deleteNote(id)

fn deleteNote(id: Int) -> HttpResponse
    ? "Deletes a note and returns a success message."
    ! [Disk]
    match Examples.Notepad.Store.removeNote(id)
        Result.Ok(_)    -> ok(jsonOk("deleted"))
        Result.Err(msg) -> serverError(msg)

// --- main dispatcher ---

fn handleRequest(req: HttpRequest) -> HttpResponse
    ? "Routes an incoming HTTP request to the correct handler."
    ! [Disk]
    match req.method
        "GET" -> match req.path == "/notes"
            true  -> handleListNotes()
            false -> match String.startsWith(req.path, "/notes/")
                true  -> handleGetNote(req.path)
                false -> notFound("not found")
        "POST" -> match req.path == "/notes"
            true  -> handleCreateNote(req.body)
            false -> notFound("not found")
        "DELETE" -> match String.startsWith(req.path, "/notes/")
            true  -> handleDeleteNote(req.path)
            false -> notFound("not found")
        _ -> methodNotAllowed()
