module Wire
    kind = capability
    semantics = effectful
    depends [Wait]
    intent = "Fixture capability: one frame at a time."
    exposes [Heard, FrameReply, frame]

type Heard
    Message(String)
    Gone(String)

type FrameReply
    Now(Heard)
    Later(Wait.Wake)
    Then(Wait.Wake, Heard)

operation frame() -> Heard
    ? "The next frame."
    oracle = generative
    replay = recorded
