module Pool
    intent = "Requests answered by the process test's explicit stub."
    kind = capability
    semantics = effectful
    exposes [claim, finish, notice]

operation claim(peer: Int) -> Option<Int>
    ? "Ask for a handle owned by the peer."
    oracle = generative
    replay = recorded

operation finish(value: Int) -> Result<Int, String>
    ? "Ask whether the result may be committed."
    oracle = generative
    replay = recorded

operation notice(id: Int) -> Unit
    ? "A request whose answer carries no data."
    oracle = generative
    replay = recorded
