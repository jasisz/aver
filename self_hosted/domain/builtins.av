fn tryVariantConstructor(name: String, args: List<Val>) -> Result<Val, String>
    ? "Try to construct a variant value from a dotted name like Type.Ctor. Uses stable tags for both builtin and user constructors."
    match splitDotted(name)
        Option.Some(_) -> Result.Ok(Val.ValVariant(Domain.Ast.ctorNameToTag(name), name, args))
        Option.None -> Result.Err("undefined function: {name}")

verify tryVariantConstructor
    tryVariantConstructor("Shape.Circle", [Val.ValInt(5)]) => Result.Ok(Val.ValVariant(Domain.Ast.ctorNameToTag("Shape.Circle"), "Shape.Circle", [Val.ValInt(5)]))
    tryVariantConstructor("noDot", []) => Result.Err("undefined function: noDot")

fn splitDotted(name: String) -> Option<Tuple<String, String>>
    ? "Split 'Type.Ctor' into (Type, Ctor). Returns None if no dot."
    splitDottedLoop(name, 0, String.len(name))

verify splitDotted
    splitDotted("List.len") => Option.Some(("List", "len"))
    splitDotted("hello") => Option.None

fn splitDottedLoop(name: String, pos: Int, total: Int) -> Option<Tuple<String, String>>
    ? "Find first dot and split."
    match pos >= total
        true -> Option.None
        false -> match String.charAt(name, pos)
            Option.Some(c) -> match c == "."
                true -> Option.Some((String.slice(name, 0, pos), String.slice(name, pos + 1, total)))
                false -> splitDottedLoop(name, pos + 1, total)
            Option.None -> Option.None

verify splitDottedLoop
    splitDottedLoop("A.B", 0, 3) => Option.Some(("A", "B"))
    splitDottedLoop("abc", 0, 3) => Option.None

fn builtinBoolOr(args: List<Val>) -> Result<Val, String>
    ? "Bool.or(a, b) -> a || b."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (aV, bV) -> builtinBoolOrInner(aV, bV)

verify builtinBoolOr
    builtinBoolOr([Val.ValBool(true), Val.ValBool(false)]) => Result.Ok(Val.ValBool(true))
    builtinBoolOr([Val.ValBool(false), Val.ValBool(false)]) => Result.Ok(Val.ValBool(false))
    builtinBoolOr([Val.ValBool(false), Val.ValBool(true)]) => Result.Ok(Val.ValBool(true))
    builtinBoolOr([]) => Result.Err("expected 2 arguments")

fn builtinBoolOrInner(aV: Val, bV: Val) -> Result<Val, String>
    ? "Inner Bool.or."
    match aV
        Val.ValBool(a) -> match bV
            Val.ValBool(b) -> match a
                true -> Result.Ok(Val.ValBool(true))
                false -> Result.Ok(Val.ValBool(b))
            _ -> Result.Err("Bool.or requires Bool arguments")
        _ -> Result.Err("Bool.or requires Bool arguments")

verify builtinBoolOrInner
    builtinBoolOrInner(Val.ValBool(true), Val.ValBool(false)) => Result.Ok(Val.ValBool(true))
    builtinBoolOrInner(Val.ValBool(false), Val.ValBool(true)) => Result.Ok(Val.ValBool(true))
    builtinBoolOrInner(Val.ValInt(1), Val.ValBool(true)) => Result.Err("Bool.or requires Bool arguments")

fn builtinBoolAnd(args: List<Val>) -> Result<Val, String>
    ? "Bool.and(a, b) -> a && b."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (aV, bV) -> builtinBoolAndInner(aV, bV)

verify builtinBoolAnd
    builtinBoolAnd([Val.ValBool(true), Val.ValBool(true)]) => Result.Ok(Val.ValBool(true))
    builtinBoolAnd([Val.ValBool(true), Val.ValBool(false)]) => Result.Ok(Val.ValBool(false))
    builtinBoolAnd([]) => Result.Err("expected 2 arguments")

fn builtinBoolAndInner(aV: Val, bV: Val) -> Result<Val, String>
    ? "Inner Bool.and."
    match aV
        Val.ValBool(a) -> match bV
            Val.ValBool(b) -> match a
                true -> Result.Ok(Val.ValBool(b))
                false -> Result.Ok(Val.ValBool(false))
            _ -> Result.Err("Bool.and requires Bool arguments")
        _ -> Result.Err("Bool.and requires Bool arguments")

verify builtinBoolAndInner
    builtinBoolAndInner(Val.ValBool(true), Val.ValBool(true)) => Result.Ok(Val.ValBool(true))
    builtinBoolAndInner(Val.ValBool(true), Val.ValBool(false)) => Result.Ok(Val.ValBool(false))
    builtinBoolAndInner(Val.ValInt(1), Val.ValBool(true)) => Result.Err("Bool.and requires Bool arguments")

fn builtinBoolNot(args: List<Val>) -> Result<Val, String>
    ? "Bool.not(a) -> negation."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValBool(b) -> match b
            true -> Result.Ok(Val.ValBool(false))
            false -> Result.Ok(Val.ValBool(true))
        _ -> Result.Err("Bool.not requires Bool argument")

verify builtinBoolNot
    builtinBoolNot([Val.ValBool(true)]) => Result.Ok(Val.ValBool(false))
    builtinBoolNot([Val.ValBool(false)]) => Result.Ok(Val.ValBool(true))
    builtinBoolNot([]) => Result.Err("expected 1 argument")

fn builtinMapSet(args: List<Val>) -> Result<Val, String>
    ? "Map.set(map, key, value) -> updated map."
    match args
        [mapV, ..r1] -> match r1
            [keyV, ..r2] -> match r2
                [valV, ..r3] -> builtinMapSetInner(mapV, keyV, valV)
                _ -> Result.Err("Map.set takes 3 arguments")
            _ -> Result.Err("Map.set takes 3 arguments")
        _ -> Result.Err("Map.set takes 3 arguments")

verify builtinMapSet
    builtinMapSet([Val.ValMap({}), Val.ValStr("a"), Val.ValInt(1)]) => Result.Ok(Val.ValMap(Map.set({}, "a", Val.ValInt(1))))
    builtinMapSet([Val.ValInt(1)]) => Result.Err("Map.set takes 3 arguments")
    builtinMapSet([]) => Result.Err("Map.set takes 3 arguments")

fn builtinMapSetInner(mapV: Val, keyV: Val, valV: Val) -> Result<Val, String>
    ? "Set a key in the map. O(1)."
    match mapV
        Val.ValMap(m) -> Result.Ok(Val.ValMap(Map.set(m, Domain.Value.mapKeyRepr(keyV), valV)))
        _ -> Result.Err("Map.set requires a Map")

verify builtinMapSetInner
    builtinMapSetInner(Val.ValMap({}), Val.ValStr("x"), Val.ValInt(5)) => Result.Ok(Val.ValMap(Map.set({}, "x", Val.ValInt(5))))
    builtinMapSetInner(Val.ValInt(1), Val.ValStr("x"), Val.ValInt(5)) => Result.Err("Map.set requires a Map")

fn builtinMapGet(args: List<Val>) -> Result<Val, String>
    ? "Map.get(map, key) -> Option<Val>. O(1)."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (mapV, keyV) -> builtinMapGetInner(mapV, keyV)

verify builtinMapGet
    builtinMapGet([Val.ValMap(Map.set({}, "a", Val.ValInt(1))), Val.ValStr("a")]) => Result.Ok(Val.ValSome(Val.ValInt(1)))
    builtinMapGet([Val.ValMap({}), Val.ValStr("x")]) => Result.Ok(Val.ValNone)
    builtinMapGet([]) => Result.Err("expected 2 arguments")

fn builtinMapGetInner(mapV: Val, keyV: Val) -> Result<Val, String>
    ? "Look up key in map. O(1)."
    match mapV
        Val.ValMap(m) -> match Map.get(m, Domain.Value.mapKeyRepr(keyV))
            Option.Some(v) -> Result.Ok(Val.ValSome(v))
            Option.None -> Result.Ok(Val.ValNone)
        _ -> Result.Err("Map.get requires a Map")

verify builtinMapGetInner
    builtinMapGetInner(Val.ValMap(Map.set({}, "k", Val.ValInt(7))), Val.ValStr("k")) => Result.Ok(Val.ValSome(Val.ValInt(7)))
    builtinMapGetInner(Val.ValMap({}), Val.ValStr("k")) => Result.Ok(Val.ValNone)
    builtinMapGetInner(Val.ValInt(1), Val.ValStr("k")) => Result.Err("Map.get requires a Map")

