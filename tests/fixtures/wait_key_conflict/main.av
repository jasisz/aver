module Main
    depends [Tcp, Wait]
    intent = "Keys one wait by a type of its own and another by whole numbers, which is the collision the wait key exists to remove."
    exposes [main]
    effects [Console.print, Tcp.listen, Tcp.closeListener, Wait.poll]

type Watch
    Listener

fn main() -> Result<Unit, String>
    ? "Waits twice on one listener, keying the two waits differently."
    ! [Console.print, Tcp.listen, Tcp.closeListener, Wait.poll]
    listener = Tcp.listen(0, 1)?
    named = Wait.poll({Watch.Listener => Wait.Item.Socket(Tcp.Socket.Listening(listener))}, 1)?
    numbered = Wait.poll({1 => Wait.Item.Socket(Tcp.Socket.Listening(listener))}, 1)?
    Console.print("waited {List.len(named)} and {List.len(numbered)}")
    Tcp.closeListener(listener)
