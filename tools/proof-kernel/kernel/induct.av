module Induct
    intent =
        "The termination gate for a definition that calls itself, and the pieces of an induction"
        "that follows a function's own recursion: its recursive calls, the parameter it recurses on,"
        "and the givens that vary with it. The gate returns what it checked, which opening a"
        "definition and an induction along it both read: a match on a parameter whose calls pass"
        "a part of the value matched, or a match on `n <= 0` or `n > 0` whose calls pass n - 1 or"
        "n / k (k a literal of at least 2) where n > 0. A call of another definition that calls"
        "back into the one checked counts as the recursive calls its body makes, read at the"
        "call's arguments, so a recursion through a helper is checked as if the helper's body"
        "stood in its place. See src/ir/proof_steps/induct.rs."
    exposes [Call, Place, Varied, ArmCalls, Recursion, selfCalls, recursion, openGate, refuseMutualRecursion, varied, nthTerm]
    depends [Kernel.Term, Kernel.Subst, Kernel.Proof]
    effects []

record Call
    args: List<Term>
    inner: List<String>

record ArmCalls
    arm: Arm
    calls: List<Call>

record Recursion
    at: Int
    guard: Option<Term>
    arms: List<ArmCalls>

record Place
    at: Int
    name: String

record Varied
    v: String
    general: List<Place>

fn selfCalls(t: Term, f: String, bound: List<String>, ds: List<Def>, fuel: Int) -> Result<List<Call>, String>
    ? "The calls of f in t, a call before the calls in its arguments, a match's subject before its arms, each with the names inner arms bind around it. A call of another definition of ds that calls back into f stands for the calls of f its body makes, read at the call's arguments, before the calls in its arguments; fuel bounds how many such bodies one call goes through."
    match t
        Term.TCall(g, xs) -> match g == f
            true -> Result.Ok(List.prepend(Call(args = xs, inner = bound), callsAll(xs, f, bound, ds, fuel)?))
            false -> Result.Ok(List.concat(helperCalls(g, xs, f, bound, ds, fuel)?, callsAll(xs, f, bound, ds, fuel)?))
        Term.TMatch(s, arms) -> Result.Ok(List.concat(selfCalls(s, f, bound, ds, fuel)?, callsArms(arms, f, bound, ds, fuel)?))
        Term.TGet(o, n) -> selfCalls(o, f, bound, ds, fuel)
        Term.TBi(n, xs) -> callsAll(xs, f, bound, ds, fuel)
        Term.TOp(o, a, b) -> Result.Ok(List.concat(selfCalls(a, f, bound, ds, fuel)?, selfCalls(b, f, bound, ds, fuel)?))
        Term.TNeg(a) -> selfCalls(a, f, bound, ds, fuel)
        Term.TCtor(c, xs) -> callsAll(xs, f, bound, ds, fuel)
        Term.TParts(xs) -> callsAll(xs, f, bound, ds, fuel)
        Term.TList(xs) -> callsAll(xs, f, bound, ds, fuel)
        Term.TTuple(xs) -> callsAll(xs, f, bound, ds, fuel)
        Term.TRec(n, fs) -> callsFields(fs, f, bound, ds, fuel)
        Term.TUpd(n, b, fs) -> Result.Ok(List.concat(selfCalls(b, f, bound, ds, fuel)?, callsFields(fs, f, bound, ds, fuel)?))
        _ -> Result.Ok([])

verify selfCalls
    selfCalls(Term.TCall("f", [Term.TCall("f", [Term.TVar("t")])]), "f", [], [], 0) => Result.Ok([Call(args = [Term.TCall("f", [Term.TVar("t")])], inner = []), Call(args = [Term.TVar("t")], inner = [])])
    selfCalls(Term.TMatch(Term.TVar("x"), [Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("f", [Term.TVar("t")]))]), "f", [], [], 0) => Result.Ok([Call(args = [Term.TVar("t")], inner = ["h", "t"])])
    selfCalls(Term.TCall("g", [Term.TInt(1)]), "f", [], [], 0) => Result.Ok([])
    selfCalls(Term.TCall("orOn", [Term.TVar("h"), Term.TVar("t")]), "any", ["h", "t"], [listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))], 2) => Result.Ok([Call(args = [Term.TVar("t")], inner = ["h", "t"])])
    selfCalls(Term.TCall("orOn", [Term.TVar("h"), Term.TVar("t")]), "any", [], [listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))], 0) => Result.Err("any recurses through orOn, which reaches itself without any")

fn callsAll(xs: List<Term>, f: String, bound: List<String>, ds: List<Def>, fuel: Int) -> Result<List<Call>, String>
    ? "Calls of f in several terms, in order."
    match xs
        [] -> Result.Ok([])
        [x, ..rest] -> Result.Ok(List.concat(selfCalls(x, f, bound, ds, fuel)?, callsAll(rest, f, bound, ds, fuel)?))

verify callsAll
    callsAll([], "f", [], [], 0) => Result.Ok([])

fn callsFields(fs: List<Field>, f: String, bound: List<String>, ds: List<Def>, fuel: Int) -> Result<List<Call>, String>
    ? "Calls of f in record fields, in order."
    match fs
        [] -> Result.Ok([])
        [x, ..rest] -> Result.Ok(List.concat(selfCalls(x.value, f, bound, ds, fuel)?, callsFields(rest, f, bound, ds, fuel)?))

verify callsFields
    callsFields([], "f", [], [], 0) => Result.Ok([])

fn callsArms(arms: List<Arm>, f: String, bound: List<String>, ds: List<Def>, fuel: Int) -> Result<List<Call>, String>
    ? "Calls of f in match arms, each arm's pattern names added to what is bound."
    match arms
        [] -> Result.Ok([])
        [a, ..rest] -> Result.Ok(List.concat(selfCalls(a.body, f, List.concat(bound, Kernel.Subst.patNames(a.pattern)), ds, fuel)?, callsArms(rest, f, bound, ds, fuel)?))

verify callsArms
    callsArms([], "f", [], [], 0) => Result.Ok([])

fn helperCalls(g: String, xs: List<Term>, f: String, bound: List<String>, ds: List<Def>, fuel: Int) -> Result<List<Call>, String>
    ? "The calls of f a call of g at xs makes: none unless g is another definition of ds that calls back into f, and then those of g's body read at xs. A chain of such bodies longer than fuel goes through one of them twice without f: a recursion of its own, refused."
    match (reachesBack(g, f, ds), defNamed(g, ds))
        (true, Option.Some(h)) -> match fuel > 0
            true -> helperBody(h, xs, f, bound, ds, fuel)
            false -> Result.Err("{f} recurses through {g}, which reaches itself without {f}")
        _ -> Result.Ok([])

verify helperCalls
    helperCalls("g", [], "f", [], [], 1) => Result.Ok([])
    helperCalls("orOn", [Term.TVar("h"), Term.TVar("t")], "any", [], [listAny(), orOn(Term.TCall("orOn", [Term.TVar("h"), Term.TCall("any", [Term.TVar("rest")])]))], 2) => Result.Err("any recurses through orOn, which reaches itself without any")

fn helperBody(h: Def, xs: List<Term>, f: String, bound: List<String>, ds: List<Def>, fuel: Int) -> Result<List<Call>, String>
    ? "A helper without local bindings, called with every argument: each call of f in its body, read at xs."
    match (h.lets, List.len(h.params) == List.len(xs))
        ([], true) -> readAt(selfCalls(h.body, f, [], ds, fuel - 1)?, h, xs, bound)
        ([], false) -> Result.Err("{h.name} takes {List.len(h.params)} arguments")
        _ -> Result.Err("{f} recurses through {h.name}, which has local bindings")

verify helperBody
    helperBody(orOn(Term.TCall("any", [Term.TVar("rest")])), [Term.TVar("h")], "any", [], [], 1) => Result.Err("orOn takes 2 arguments")
    helperBody(Def(name = "g", returnsBool = false, params = [], lets = [Kernel.Term.bind("y", Term.TInt(1))], body = Term.TCall("f", [])), [], "f", [], [], 1) => Result.Err("f recurses through g, which has local bindings")

fn readAt(cs: List<Call>, h: Def, xs: List<Term>, bound: List<String>) -> Result<List<Call>, String>
    ? "Each call of f in h's body at the arguments h is called with."
    match cs
        [] -> Result.Ok([])
        [c, ..rest] -> Result.Ok(List.prepend(readOne(c, h, xs, bound)?, readAt(rest, h, xs, bound)?))

verify readAt
    readAt([], listAny(), [], []) => Result.Ok([])

fn readOne(c: Call, h: Def, xs: List<Term>, bound: List<String>) -> Result<Call, String>
    ? "One call of f in h's body at the arguments h is called with: h's parameters that no arm of h rebinds around it replaced, refusing a capture. It may read nothing else of h's scope. The names bound around the call of h come before those h binds around it."
    used = Kernel.Subst.freeVarsAll(c.args)
    bs = Kernel.Subst.unbind(paramsAt(h.params, xs), c.inner)
    unread(Kernel.Subst.without(used, List.concat(h.params, c.inner)), h.name)?
    Kernel.Subst.capture(bs, used, c.inner)?
    Result.Ok(Call(args = Kernel.Subst.substAll(c.args, bs)?, inner = List.concat(bound, c.inner)))

verify readOne
    readOne(Call(args = [Term.TVar("rest")], inner = []), orOn(Term.TUnit), [Term.TVar("h"), Term.TVar("t")], ["h", "t"]) => Result.Ok(Call(args = [Term.TVar("t")], inner = ["h", "t"]))
    readOne(Call(args = [Term.TVar("rest")], inner = ["rest"]), orOn(Term.TUnit), [Term.TVar("h"), Term.TVar("t")], ["h", "t"]) => Result.Ok(Call(args = [Term.TVar("rest")], inner = ["h", "t", "rest"]))
    readOne(Call(args = [Term.TVar("rest")], inner = ["t"]), orOn(Term.TUnit), [Term.TVar("h"), Term.TVar("t")], ["h", "t"]) => Result.Err("substituting rest would capture t")
    readOne(Call(args = [Term.TVar("base")], inner = []), orOn(Term.TUnit), [Term.TVar("h"), Term.TVar("t")], ["h", "t"]) => Result.Err("orOn passes base, which it does not bind, to a recursive call")

fn unread(ns: List<String>, h: String) -> Result<Unit, String>
    ? "No name is left that the helper's call does not give."
    match ns
        [] -> Result.Ok(Unit)
        [n, ..rest] -> Result.Err("{h} passes {n}, which it does not bind, to a recursive call")

verify unread
    unread([], "g") => Result.Ok(Unit)

fn paramsAt(ps: List<String>, xs: List<Term>) -> List<Binding>
    ? "Each parameter bound to its argument."
    match (ps, xs)
        ([p, ..morePs], [x, ..moreXs]) -> List.prepend(Kernel.Term.bind(p, x), paramsAt(morePs, moreXs))
        _ -> []

verify paramsAt
    paramsAt(["a"], [Term.TInt(1)]) => [Kernel.Term.bind("a", Term.TInt(1))]

fn reachesBack(g: String, f: String, ds: List<Def>) -> Bool
    ? "Whether g is another definition of ds from which f is reachable."
    Bool.and(g != f, reaches(calleesOf(g, ds, ds), f, ds, [], List.len(ds)))

verify reachesBack
    reachesBack("orOn", "any", [listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))]) => true
    reachesBack("any", "any", [listAny()]) => false

fn defNamed(n: String, ds: List<Def>) -> Option<Def>
    ? "The definition of ds named n."
    match ds
        [] -> Option.None
        [d, ..rest] -> match d.name == n
            true -> Option.Some(d)
            false -> defNamed(n, rest)

verify defNamed
    defNamed("f", []) => Option.None

fn letCalls(ls: List<Binding>, f: String, ds: List<Def>) -> Result<Int, String>
    ? "How many calls of f the local bindings make."
    match ls
        [] -> Result.Ok(0)
        [b, ..rest] -> Result.Ok(List.len(selfCalls(b.value, f, [], ds, List.len(ds))?) + letCalls(rest, f, ds)?)

verify letCalls
    letCalls([Kernel.Term.bind("y", Term.TCall("f", []))], "f", []) => Result.Ok(1)

fn calls(t: Term, d: Def, ds: List<Def>) -> Result<List<Call>, String>
    ? "The recursive calls of d in t, read through the definitions of ds that call back into d."
    selfCalls(t, d.name, [], ds, List.len(ds))

verify calls
    calls(Term.TCall("f", []), Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), []) => Result.Ok([Call(args = [], inner = [])])

fn recursion(d: Def, ds: List<Def>) -> Result<Option<Recursion>, String>
    ? "None when d does not call itself, directly or through other definitions of ds that call back into it. Otherwise what the gate checked, which opening d and an induction along it both read: the place of the parameter d recurses on, the comparison its match splits on when it counts that Int toward zero (none when it matches the value itself), and each arm with its recursive calls, every one of them checked to descend. A refusal when one does not."
    match (letCalls(d.lets, d.name, ds)? == 0, calls(d.body, d, ds)?)
        (true, []) -> Result.Ok(Option.None)
        _ -> Result.Ok(Option.Some(recursive(d, ds)?))

verify recursion
    recursion(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TVar("x")), []) => Result.Ok(Option.None)
    recursion(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TMatch(Term.TVar("x"), [Arm(pattern = Pat.PNil, body = Term.TInt(0)), Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("f", [Term.TVar("t")]))])), []) => Result.Ok(Option.Some(Recursion(at = 0, guard = Option.None, arms = [ArmCalls(arm = Arm(pattern = Pat.PNil, body = Term.TInt(0)), calls = []), ArmCalls(arm = Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("f", [Term.TVar("t")])), calls = [Call(args = [Term.TVar("t")], inner = [])])])))
    recursion(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TMatch(Term.TVar("x"), [Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("f", [Term.TVar("x")]))])), []) => Result.Err("f recurses on something that is not a part of the value it matches")
    recursion(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TCall("f", [Term.TVar("x")])), []) => Result.Err("f recurses outside a match on a parameter")
    recursion(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TMatch(Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(1)), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))])), []) => Result.Ok(Option.Some(Recursion(at = 0, guard = Option.Some(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))), arms = [ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(1)), calls = []), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))])), calls = [Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])])])))
    recursion(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TMatch(Term.TOp("<=", Term.TVar("n"), Term.TInt(1)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(1)), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))])), []) => Result.Err("f recurses outside a match on a parameter")
    recursion(Def(name = "f", returnsBool = false, params = [], lets = [Kernel.Term.bind("y", Term.TInt(1))], body = Term.TCall("f", [])), []) => Result.Err("f recurses from a local binding")
    recursion(listAny(), [listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))]) => Result.Ok(Option.Some(Recursion(at = 0, guard = Option.None, arms = [ArmCalls(arm = Arm(pattern = Pat.PNil, body = Term.TBool(false)), calls = []), ArmCalls(arm = Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("orOn", [Term.TVar("h"), Term.TVar("t")])), calls = [Call(args = [Term.TVar("t")], inner = [])])])))
    recursion(listAny(), [listAny(), orOn(Term.TCall("any", [Term.TList([Term.TVar("first")])]))]) => Result.Err("any recurses on something that is not a part of the value it matches")
    recursion(listAny(), [listAny(), orOn(Term.TMatch(Term.TVar("first"), [Arm(pattern = Pat.PVar("t"), body = Term.TCall("any", [Term.TVar("t")]))]))]) => Result.Err("any recurses on something that is not a part of the value it matches")
    recursion(listAny(), [listAny(), orOn(Term.TMatch(Term.TVar("first"), [Arm(pattern = Pat.PVar("t"), body = Term.TCall("any", [Term.TVar("rest")]))]))]) => Result.Err("substituting rest would capture t")
    recursion(listAny(), [listAny(), orOn(Term.TCall("orOn", [Term.TVar("first"), Term.TCall("any", [Term.TVar("rest")])]))]) => Result.Err("any recurses through orOn, which reaches itself without any")

fn recursive(d: Def, ds: List<Def>) -> Result<Recursion, String>
    ? "The gate for a definition that does call itself: no local bindings, and a body that matches a parameter or compares one with zero."
    match (d.lets, d.body)
        ([], Term.TMatch(Term.TVar(p), arms)) -> onParts(d, ds, indexOf(d.params, p, 0), arms)
        ([], Term.TMatch(Term.TOp(op, Term.TVar(p), Term.TInt(0)), arms)) -> towardZero(d, ds, Term.TOp(op, Term.TVar(p), Term.TInt(0)), p, indexOf(d.params, p, 0), arms)
        ([], _) -> Result.Err("{d.name} recurses outside a match on a parameter")
        _ -> Result.Err("{d.name} recurses from a local binding")

verify recursive
    recursive(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TMatch(Term.TVar("y"), [])), []) => Result.Err("f recurses on a match whose subject is not a parameter")
    recursive(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TMatch(Term.TOp("<=", Term.TVar("y"), Term.TInt(0)), [])), []) => Result.Err("f recurses on a match whose subject is not a parameter")

fn onParts(d: Def, ds: List<Def>, j: Int, arms: List<Arm>) -> Result<Recursion, String>
    ? "Every recursive call passes, at place j, a name its arm's pattern binds and no inner arm rebinds: a strict part of the value matched."
    match j < 0
        true -> Result.Err("{d.name} recurses on a match whose subject is not a parameter")
        false -> match armsShrink(arms, d, ds, j)?
            true -> Result.Ok(Recursion(at = j, guard = Option.None, arms = armCalls(arms, d, ds)?))
            false -> Result.Err("{d.name} recurses on something that is not a part of the value it matches")

verify onParts
    onParts(Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), [], 0 - 1, []) => Result.Err("f recurses on a match whose subject is not a parameter")

fn armCalls(arms: List<Arm>, d: Def, ds: List<Def>) -> Result<List<ArmCalls>, String>
    ? "Each arm with the recursive calls in it, as selfCalls lists them."
    match arms
        [] -> Result.Ok([])
        [a, ..rest] -> Result.Ok(List.prepend(ArmCalls(arm = a, calls = calls(a.body, d, ds)?), armCalls(rest, d, ds)?))

verify armCalls
    armCalls([Arm(pattern = Pat.PWild, body = Term.TCall("f", []))], Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), []) => Result.Ok([ArmCalls(arm = Arm(pattern = Pat.PWild, body = Term.TCall("f", [])), calls = [Call(args = [], inner = [])])])

fn towardZero(d: Def, ds: List<Def>, guard: Term, p: String, j: Int, arms: List<Arm>) -> Result<Recursion, String>
    ? "match p <= 0 or match p > 0, one arm per truth value: the arm where the comparison says p is at most 0 makes no recursive call, and every call in the other passes p - 1 or p / k at p's place, for a literal k of at least 2, p not rebound around it. Where p > 0 both are at least 0 and below p, so the recursion stops for every Int."
    match (j < 0, stopsAt(guard), arms)
        (true, _, _) -> Result.Err("{d.name} recurses on a match whose subject is not a parameter")
        (false, Option.Some(stop), [a, b]) -> match Bool.and(oneEach(a.pattern, b.pattern), Bool.and(armDescends(a, stop, d, ds, p, j)?, armDescends(b, stop, d, ds, p, j)?))
            true -> Result.Ok(Recursion(at = j, guard = Option.Some(guard), arms = armCalls(arms, d, ds)?))
            false -> Result.Err("{d.name} does not count {p} down to zero")
        _ -> Result.Err("{d.name} does not count {p} down to zero")

verify towardZero
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), [], Term.TOp(">", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TOp("+", Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])]), Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0))]) => Result.Ok(Recursion(at = 0, guard = Option.Some(Term.TOp(">", Term.TVar("n"), Term.TInt(0))), arms = [ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TOp("+", Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])]), Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))), calls = [Call(args = [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])], inner = []), Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])]), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0)), calls = [])]))
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), [], Term.TOp(">", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])])), Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(0))]) => Result.Err("f does not count n down to zero")
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), [], Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(1))]) => Result.Err("f does not count n down to zero")
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), [], Term.TOp(">=", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(1))]) => Result.Err("f does not count n down to zero")
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), [], Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), "n", 0, [Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(1))]) => Result.Err("f does not count n down to zero")
    towardZero(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), [], Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), "n", 0 - 1, []) => Result.Err("f recurses on a match whose subject is not a parameter")

fn stopsAt(guard: Term) -> Option<Bool>
    ? "The value of the comparison where p is at most 0: true for p <= 0, false for p > 0; none for any other comparison."
    match guard
        Term.TOp("<=", _, _) -> Option.Some(true)
        Term.TOp(">", _, _) -> Option.Some(false)
        _ -> Option.None

verify stopsAt
    stopsAt(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))) => Option.Some(true)
    stopsAt(Term.TOp(">", Term.TVar("n"), Term.TInt(0))) => Option.Some(false)
    stopsAt(Term.TOp("<", Term.TVar("n"), Term.TInt(0))) => Option.None

fn oneEach(a: Pat, b: Pat) -> Bool
    ? "One arm true, the other false."
    match (a, b)
        (Pat.PLit(Term.TBool(x)), Pat.PLit(Term.TBool(y))) -> x != y
        _ -> false

verify oneEach
    oneEach(Pat.PLit(Term.TBool(false)), Pat.PLit(Term.TBool(true))) => true
    oneEach(Pat.PLit(Term.TBool(true)), Pat.PLit(Term.TBool(true))) => false
    oneEach(Pat.PLit(Term.TBool(true)), Pat.PWild) => false

fn armDescends(a: Arm, stop: Bool, d: Def, ds: List<Def>, p: String, j: Int) -> Result<Bool, String>
    ? "The arm where p is at most 0 makes no recursive call; each call in the other descends at place j."
    match a.pattern == Pat.PLit(Term.TBool(stop))
        true -> Result.Ok(List.len(calls(a.body, d, ds)?) == 0)
        false -> Result.Ok(callsDescend(calls(a.body, d, ds)?, p, j, List.len(d.params)))

verify armDescends
    armDescends(Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TInt(0)])), true, Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), [], "n", 0) => Result.Ok(false)
    armDescends(Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TMatch(Term.TVar("x"), [Arm(pattern = Pat.PVar("n"), body = Term.TCall("f", [Term.TOp("-", Term.TVar("n"), Term.TInt(1))]))])), true, Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TUnit), [], "n", 0) => Result.Ok(false)

fn callsDescend(cs: List<Call>, p: String, j: Int, n: Int) -> Bool
    ? "Each call has every argument and passes p - 1 or p / k at place j, p not rebound around it."
    match cs
        [] -> true
        [c, ..rest] -> Bool.and(Bool.and(List.len(c.args) == n, Bool.and(descends(nthTerm(c.args, j), p), Bool.not(List.contains(c.inner, p)))), callsDescend(rest, p, j, n))

verify callsDescend
    callsDescend([Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = ["n"])], "n", 0, 1) => false
    callsDescend([Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])], "n", 0, 1) => true
    callsDescend([Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])], "n", 0, 2) => false

fn descends(t: Option<Term>, p: String) -> Bool
    ? "Whether t is p - 1, or p / k for a literal k of at least 2: for p > 0 each is at least 0 and below p."
    match t
        Option.Some(Term.TOp("-", Term.TVar(q), Term.TInt(1))) -> q == p
        Option.Some(Term.TBi("__int_div_euclid", [Term.TVar(q), Term.TInt(k)])) -> Bool.and(q == p, k >= 2)
        _ -> false

verify descends
    descends(Option.Some(Term.TOp("-", Term.TVar("n"), Term.TInt(1))), "n") => true
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(2)])), "n") => true
    descends(Option.Some(Term.TOp("-", Term.TVar("n"), Term.TInt(0))), "n") => false
    descends(Option.Some(Term.TOp("-", Term.TVar("n"), Term.TInt(2))), "n") => false
    descends(Option.Some(Term.TOp("+", Term.TVar("n"), Term.TInt(1))), "n") => false
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(1)])), "n") => false
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(0 - 2)])), "n") => false
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TVar("k")])), "n") => false
    descends(Option.Some(Term.TBi("__int_mod_euclid", [Term.TVar("n"), Term.TInt(2)])), "n") => false
    descends(Option.Some(Term.TBi("__int_div_euclid", [Term.TVar("m"), Term.TInt(2)])), "n") => false
    descends(Option.None, "n") => false

fn openGate(d: Def, ds: List<Def>) -> Result<Unit, String>
    ? "Whether steps may open d: its recursion, read through the definitions of ds it calls back through, passes the gate; or every cycle through d passes one whose recursion does (rooted)."
    match recursion(d, ds)
        Result.Ok(_) -> Result.Ok(Unit)
        Result.Err(why) -> match rooted(d, ds, ds)
            true -> Result.Ok(Unit)
            false -> Result.Err(why)

verify openGate
    openGate(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TMatch(Term.TOp(">", Term.TVar("n"), Term.TInt(0)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(256)])])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0))])), []) => Result.Ok(Unit)
    openGate(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TMatch(Term.TOp(">", Term.TVar("n"), Term.TInt(0)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(1)])])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0))])), []) => Result.Err("f does not count n down to zero")
    openGate(Def(name = "f", returnsBool = false, params = ["n"], lets = [], body = Term.TCall("f", [Term.TVar("n")])), []) => Result.Err("f recurses outside a match on a parameter")
    openGate(orOn(Term.TCall("any", [Term.TVar("rest")])), [listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))]) => Result.Ok(Unit)
    openGate(orOn(Term.TCall("any", [Term.TList([Term.TVar("first")])])), [listAny(), orOn(Term.TCall("any", [Term.TList([Term.TVar("first")])]))]) => Result.Err("orOn does not count first down to zero")

fn rooted(d: Def, todo: List<Def>, ds: List<Def>) -> Bool
    ? "Whether some definition r of ds reaches d and is reached from it, and r's recursion, read through the others, passes the gate. Every cycle through d then passes r, each time on a smaller value, so d stops."
    match todo
        [] -> false
        [r, ..rest] -> match Bool.and(Bool.and(reachesFrom(d.name, r.name, ds), reachesFrom(r.name, d.name, ds)), descendsThrough(r, ds))
            true -> true
            false -> rooted(d, rest, ds)

verify rooted
    rooted(listAny(), [], []) => false
    rooted(orOn(Term.TCall("any", [Term.TVar("rest")])), [listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))], [listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))]) => true

fn reachesFrom(a: String, b: String, ds: List<Def>) -> Bool
    ? "Whether b is a or reachable from a through the definitions of ds."
    Bool.or(a == b, reaches(calleesOf(a, ds, ds), b, ds, [], List.len(ds)))

verify reachesFrom
    reachesFrom("f", "f", []) => true
    reachesFrom("f", "g", []) => false

fn descendsThrough(r: Def, ds: List<Def>) -> Bool
    ? "Whether r calls itself and its recursion passes the gate."
    match recursion(r, ds)
        Result.Ok(Option.Some(_)) -> true
        _ -> false

verify descendsThrough
    descendsThrough(listAny(), []) => false
    descendsThrough(listAny(), [listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))]) => true

fn listAny() -> Def
    ? "A fixture for the tests: any(xs) matches a list and calls orOn on its head and tail."
    Def(name = "any", returnsBool = true, params = ["xs"], lets = [], body = Term.TMatch(Term.TVar("xs"), [Arm(pattern = Pat.PNil, body = Term.TBool(false)), Arm(pattern = Pat.PCons("h", "t"), body = Term.TCall("orOn", [Term.TVar("h"), Term.TVar("t")]))]))

verify listAny
    listAny().name => "any"

fn orOn(back: Term) -> Def
    ? "A fixture for the tests: orOn(first, rest) is true when first is not 0, and back otherwise."
    Def(name = "orOn", returnsBool = true, params = ["first", "rest"], lets = [], body = Term.TMatch(Term.TOp("!=", Term.TVar("first"), Term.TInt(0)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TBool(true)), Arm(pattern = Pat.PLit(Term.TBool(false)), body = back)]))

verify orOn
    orOn(Term.TUnit).params => ["first", "rest"]

fn armsShrink(arms: List<Arm>, d: Def, ds: List<Def>, j: Int) -> Result<Bool, String>
    ? "Every arm passes, at place j of each recursive call, a name its pattern binds and no inner arm rebinds."
    match arms
        [] -> Result.Ok(true)
        [a, ..rest] -> Result.Ok(Bool.and(callsShrink(calls(a.body, d, ds)?, Kernel.Subst.patNames(a.pattern), j, List.len(d.params)), armsShrink(rest, d, ds, j)?))

verify armsShrink
    armsShrink([], listAny(), [], 0) => Result.Ok(true)

fn callsShrink(cs: List<Call>, parts: List<String>, j: Int, n: Int) -> Bool
    ? "Each call passes one of the parts at place j."
    match cs
        [] -> true
        [c, ..rest] -> Bool.and(Bool.and(List.len(c.args) == n, smaller(nthTerm(c.args, j), parts, c.inner)), callsShrink(rest, parts, j, n))

verify callsShrink
    callsShrink([Call(args = [Term.TVar("t")], inner = [])], ["h", "t"], 0, 1) => true
    callsShrink([Call(args = [Term.TVar("t")], inner = ["t"])], ["h", "t"], 0, 1) => false

fn smaller(t: Option<Term>, parts: List<String>, inner: List<String>) -> Bool
    ? "A name the arm's pattern binds, not rebound inside."
    match t
        Option.Some(Term.TVar(b)) -> Bool.and(List.contains(parts, b), Bool.not(List.contains(inner, b)))
        _ -> false

verify smaller
    smaller(Option.Some(Term.TVar("t")), ["t"], []) => true
    smaller(Option.Some(Term.TInt(1)), ["t"], []) => false

fn indexOf(xs: List<String>, x: String, i: Int) -> Int
    ? "Where x is in xs, from i; -1 when it is not."
    match xs
        [] -> 0 - 1
        [y, ..rest] -> match y == x
            true -> i
            false -> indexOf(rest, x, i + 1)

verify indexOf
    indexOf(["a", "b"], "b", 0) => 1
    indexOf(["a"], "c", 0) => 0 - 1

fn nthTerm(xs: List<Term>, i: Int) -> Option<Term>
    ? "The term at place i."
    match xs
        [] -> Option.None
        [x, ..rest] -> match i == 0
            true -> Option.Some(x)
            false -> nthTerm(rest, i - 1)

verify nthTerm
    nthTerm([Term.TInt(1), Term.TInt(2)], 1) => Option.Some(Term.TInt(2))
    nthTerm([], 0) => Option.None

fn refuseMutualRecursion(ds: List<Def>) -> Result<Unit, String>
    ? "No definition reaches itself through another definition of the script, unless every such cycle passes one whose recursion, read through the others, passes the gate (rooted)."
    match ds
        [] -> Result.Ok(Unit)
        _ -> eachNotMutual(ds, ds)

verify refuseMutualRecursion
    refuseMutualRecursion([Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TCall("g", [])), Def(name = "g", returnsBool = false, params = [], lets = [], body = Term.TCall("f", []))]) => Result.Err("f is part of a mutual recursion")
    refuseMutualRecursion([Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TCall("f", [])), Def(name = "g", returnsBool = false, params = [], lets = [], body = Term.TCall("f", []))]) => Result.Ok(Unit)
    refuseMutualRecursion([listAny(), orOn(Term.TCall("any", [Term.TVar("rest")]))]) => Result.Ok(Unit)
    refuseMutualRecursion([listAny(), orOn(Term.TCall("orOn", [Term.TVar("first"), Term.TCall("any", [Term.TVar("rest")])]))]) => Result.Err("any is part of a mutual recursion")

fn eachNotMutual(todo: List<Def>, ds: List<Def>) -> Result<Unit, String>
    ? "Check each definition in turn."
    match todo
        [] -> Result.Ok(Unit)
        [d, ..rest] -> match Bool.and(reaches(callees(d, ds), d.name, ds, [], List.len(ds)), Bool.not(rooted(d, ds, ds)))
            true -> Result.Err("{d.name} is part of a mutual recursion")
            false -> eachNotMutual(rest, ds)

verify eachNotMutual
    eachNotMutual([], []) => Result.Ok(Unit)

fn reaches(frontier: List<String>, target: String, ds: List<Def>, seen: List<String>, fuel: Int) -> Bool
    ? "Whether target is among the definitions reachable from the frontier; fuel is the number of definitions, enough for any path that does not repeat."
    match (frontier, fuel > 0)
        ([], _) -> false
        (_, false) -> false
        ([g, ..rest], true) -> match g == target
            true -> true
            false -> match List.contains(seen, g)
                true -> reaches(rest, target, ds, seen, fuel)
                false -> reaches(List.concat(rest, calleesOf(g, ds, ds)), target, ds, List.prepend(g, seen), fuel - 1)

verify reaches
    reaches([], "f", [], [], 1) => false

fn calleesOf(name: String, todo: List<Def>, ds: List<Def>) -> List<String>
    ? "The definitions of ds that the one named name calls."
    match todo
        [] -> []
        [d, ..rest] -> match d.name == name
            true -> callees(d, ds)
            false -> calleesOf(name, rest, ds)

verify calleesOf
    calleesOf("f", [], []) => []
    calleesOf("g", [Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), Def(name = "g", returnsBool = false, params = [], lets = [], body = Term.TCall("f", []))], [Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), Def(name = "g", returnsBool = false, params = [], lets = [], body = Term.TCall("f", []))]) => ["f"]

fn callees(d: Def, ds: List<Def>) -> List<String>
    ? "The other definitions of the script d calls."
    onlyDefs(List.concat(namesCalled(d.body), letNames(d.lets)), ds, d.name)

verify callees
    callees(Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TCall("f", [])), []) => []

fn letNames(ls: List<Binding>) -> List<String>
    ? "Functions the local bindings call."
    match ls
        [] -> []
        [b, ..rest] -> List.concat(namesCalled(b.value), letNames(rest))

verify letNames
    letNames([]) => []

fn onlyDefs(ns: List<String>, ds: List<Def>, own: String) -> List<String>
    ? "The names that are other definitions of the script."
    match ns
        [] -> []
        [n, ..rest] -> match Bool.and(n != own, isDef(n, ds))
            true -> List.prepend(n, onlyDefs(rest, ds, own))
            false -> onlyDefs(rest, ds, own)

verify onlyDefs
    onlyDefs(["g"], [], "f") => []

fn isDef(n: String, ds: List<Def>) -> Bool
    ? "Whether the script defines n."
    match ds
        [] -> false
        [d, ..rest] -> Bool.or(d.name == n, isDef(n, rest))

verify isDef
    isDef("f", []) => false

fn namesCalled(t: Term) -> List<String>
    ? "Every function a term calls."
    match t
        Term.TCall(g, xs) -> List.prepend(g, namesAll(xs))
        Term.TMatch(s, arms) -> List.concat(namesCalled(s), namesArms(arms))
        Term.TGet(o, n) -> namesCalled(o)
        Term.TBi(n, xs) -> namesAll(xs)
        Term.TOp(o, a, b) -> List.concat(namesCalled(a), namesCalled(b))
        Term.TNeg(a) -> namesCalled(a)
        Term.TCtor(c, xs) -> namesAll(xs)
        Term.TParts(xs) -> namesAll(xs)
        Term.TList(xs) -> namesAll(xs)
        Term.TTuple(xs) -> namesAll(xs)
        Term.TRec(n, fs) -> namesFields(fs)
        Term.TUpd(n, b, fs) -> List.concat(namesCalled(b), namesFields(fs))
        _ -> []

verify namesCalled
    namesCalled(Term.TOp("+", Term.TCall("g", []), Term.TCall("h", []))) => ["g", "h"]

fn namesAll(xs: List<Term>) -> List<String>
    ? "Functions several terms call."
    match xs
        [] -> []
        [x, ..rest] -> List.concat(namesCalled(x), namesAll(rest))

verify namesAll
    namesAll([]) => []

fn namesFields(fs: List<Field>) -> List<String>
    ? "Functions record fields call."
    match fs
        [] -> []
        [x, ..rest] -> List.concat(namesCalled(x.value), namesFields(rest))

verify namesFields
    namesFields([]) => []

fn namesArms(arms: List<Arm>) -> List<String>
    ? "Functions match arms call."
    match arms
        [] -> []
        [a, ..rest] -> List.concat(namesCalled(a.body), namesArms(rest))

verify namesArms
    namesArms([]) => []

fn varied(xs: List<Term>, j: Int, givens: List<String>) -> Result<Varied, String>
    ? "The given at the matched place, and the other givens among the arguments that vary with it, each at the first place it appears."
    match nthTerm(xs, j)
        Option.Some(Term.TVar(v)) -> match List.contains(givens, v)
            true -> Result.Ok(Varied(v = v, general = generalised(xs, 0, j, v, givens, [])))
            false -> Result.Err("the argument at the matched place must be a given")
        _ -> Result.Err("the argument at the matched place must be a given")

verify varied
    varied([Term.TVar("xs"), Term.TVar("acc")], 0, ["xs", "acc"]) => Result.Ok(Varied(v = "xs", general = [Place(at = 1, name = "acc")]))
    varied([Term.TVar("xs"), Term.TInt(0)], 0, ["xs"]) => Result.Ok(Varied(v = "xs", general = []))
    varied([Term.TInt(0)], 0, []) => Result.Err("the argument at the matched place must be a given")

fn generalised(xs: List<Term>, k: Int, j: Int, v: String, givens: List<String>, seen: List<String>) -> List<Place>
    ? "Places other than j holding a given other than v not seen before."
    match xs
        [] -> []
        [Term.TVar(n), ..rest] -> match Bool.and(Bool.and(k != j, n != v), Bool.and(List.contains(givens, n), Bool.not(List.contains(seen, n))))
            true -> List.prepend(Place(at = k, name = n), generalised(rest, k + 1, j, v, givens, List.prepend(n, seen)))
            false -> generalised(rest, k + 1, j, v, givens, seen)
        [x, ..rest] -> generalised(rest, k + 1, j, v, givens, seen)

verify generalised
    generalised([Term.TVar("a"), Term.TVar("a")], 0, 2, "v", ["a"], []) => [Place(at = 0, name = "a")]
