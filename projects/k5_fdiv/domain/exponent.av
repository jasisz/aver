fn exponentPh3(ep: Int, ePh3: Int) -> Bool
    ? "Table 3 row 28 (p.32): p3 != 0 implies ep - 384 <= e(ph3) <= ep + 18. ph3 = trunc(p3,32); truncation preserves the exponent (Lemma 7.2.6), so the row-27 bracket of p3 carries over."
    Bool.and(ep - 384 <= ePh3, ePh3 <= ep + 18)

verify exponentPh3
