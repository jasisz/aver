module Eval
    depends [Domain.Ast, Domain.Value, Domain.Builtins, Domain.Match]
    intent =
        "Tree-walking evaluator for the mini Aver AST."
        "Two eval paths: Map-based for unresolved top-level stmts, slot-based (Vector<Val>) for resolved fns."
        "Delegates builtins to Domain.Builtins and pattern matching to Domain.Match."
    exposes [evalProgram, evalProgramWithFns]

fn lookupVar(env: Map<String, Val>, name: String) -> Result<Val, String>
    ? "Look up a variable in the environment."
    match Map.get(env, name)
        Option.Some(v) -> Result.Ok(v)
        Option.None -> Result.Err("undefined variable: " + name)

verify lookupVar
    lookupVar(Map.set(Map.empty(), "x", Val.ValInt(1)), "x") => Result.Ok(Val.ValInt(1))
    lookupVar(Map.empty(), "x") => Result.Err("undefined variable: x")

fn lookupFn(fns: Map<String, FnDef>, name: String) -> Result<FnDef, String>
    ? "Look up a function definition by name."
    match Map.get(fns, name)
        Option.Some(f) -> Result.Ok(f)
        Option.None -> Result.Err("undefined function: " + name)

verify lookupFn
    lookupFn(Map.set(Map.empty(), "foo", FnDef(name = "foo", params = [], body = [], slotCount = 0, slotMap = Map.empty(), fastPath = FnFastPath.FastNone)), "foo") => Result.Ok(FnDef(name = "foo", params = [], body = [], slotCount = 0, slotMap = Map.empty(), fastPath = FnFastPath.FastNone))
    lookupFn(Map.empty(), "foo") => Result.Err("undefined function: foo")

fn zipArgs(params: List<String>, args: List<Val>, acc: Map<String, Val>) -> Map<String, Val>
    ? "Build env map from parameter names and argument values."
    match params
        [] -> acc
        [p, ..ps] -> match args
            [] -> acc
            [a, ..as_] -> zipArgs(ps, as_, Map.set(acc, p, a))

fn mergeBindings(bindings: List<(String, Val)>, env: Map<String, Val>) -> Map<String, Val>
    ? "Add pattern match bindings to an env map."
    match bindings
        [] -> env
        [pair, ..rest] -> match pair
            (k, v) -> mergeBindings(rest, Map.set(env, k, v))

verify mergeBindings
    mergeBindings([], Map.empty()) => Map.empty()
    mergeBindings([("x", Val.ValInt(1))], Map.empty()) => Map.set(Map.empty(), "x", Val.ValInt(1))

fn fnsToMap(fns: List<FnDef>, acc: Map<String, FnDef>) -> Map<String, FnDef>
    ? "Convert a list of FnDefs to a Map keyed by name."
    match fns
        [] -> acc
        [f, ..rest] -> fnsToMap(rest, Map.set(acc, f.name, f))

fn evalExpr(expr: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate an expression in the given environment."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match expr
        Expr.ExprInt(n) -> Result.Ok(Val.ValInt(n))
        Expr.ExprFloat(f) -> Result.Ok(Val.ValFloat(f))
        Expr.ExprStr(s) -> Result.Ok(Val.ValStr(s))
        Expr.ExprBool(b) -> Result.Ok(Val.ValBool(b))
        Expr.ExprVar(name) -> evalVar(name, env)
        Expr.ExprSlot(_) -> Result.Err("ExprSlot in map-based eval path")
        Expr.ExprAdd(a, b) -> evalBinop(a, b, env, fns, BinOp.OpAdd)
        Expr.ExprSub(a, b) -> evalBinop(a, b, env, fns, BinOp.OpSub)
        Expr.ExprMul(a, b) -> evalBinop(a, b, env, fns, BinOp.OpMul)
        Expr.ExprDiv(a, b) -> evalBinop(a, b, env, fns, BinOp.OpDiv)
        Expr.ExprEq(a, b) -> evalCmp(a, b, env, fns, CmpOp.CmpEq)
        Expr.ExprNeq(a, b) -> evalCmp(a, b, env, fns, CmpOp.CmpNeq)
        Expr.ExprLt(a, b) -> evalCmp(a, b, env, fns, CmpOp.CmpLt)
        Expr.ExprGt(a, b) -> evalCmp(a, b, env, fns, CmpOp.CmpGt)
        Expr.ExprLte(a, b) -> evalCmp(a, b, env, fns, CmpOp.CmpLte)
        Expr.ExprGte(a, b) -> evalCmp(a, b, env, fns, CmpOp.CmpGte)
        Expr.ExprConcat(parts) -> evalConcatExpr(parts, env, fns)
        Expr.ExprTuple(exprs) -> evalTupleExpr(exprs, env, fns)
        Expr.ExprList(exprs) -> evalListExpr(exprs, env, fns)
        Expr.ExprRecord(name, fieldExprs) -> evalRecordExpr(name, fieldExprs, env, fns)
        Expr.ExprFieldAccess(obj, field) -> evalFieldAccess(obj, field, env, fns)
        Expr.ExprCall(name, argExprs) -> evalCall(name, argExprs, env, fns)
        Expr.ExprCallDirect(name, argExprs) -> evalCallDirect(name, argExprs, env, fns)
        Expr.ExprCallBuiltin(name, argExprs) -> evalCallBuiltinMaybeSpecial(name, argExprs, env, fns)
        Expr.ExprMatch(scrutinee, arms) -> evalMatchExpr(scrutinee, arms, env, fns)
        Expr.ExprPropagate(inner) -> evalPropagate(inner, env, fns)

fn evalVar(name: String, env: Map<String, Val>) -> Result<Val, String>
    ? "Look up variable, Option.None, or nullary variant constructor."
    match name
        "Option.None" -> Result.Ok(Val.ValNone)
        _ -> match lookupVar(env, name)
            Result.Ok(v) -> Result.Ok(v)
            Result.Err(_) -> evalVarFallback(name)

verify evalVar
    evalVar("x", Map.set(Map.empty(), "x", Val.ValInt(5))) => Result.Ok(Val.ValInt(5))
    evalVar("Option.None", Map.empty()) => Result.Ok(Val.ValNone)

fn evalVarFallback(name: String) -> Result<Val, String>
    ? "If variable not in env, try as nullary variant (e.g. Token.TkPlus)."
    match Domain.Builtins.splitDotted(name)
        Option.Some(pair) -> match pair
            (typeName, ctorName) -> Result.Ok(Val.ValVariant(typeName, ctorName, []))
        Option.None -> Result.Err("undefined variable: {name}")

verify evalVarFallback
    evalVarFallback("Token.TkPlus") => Result.Ok(Val.ValVariant("Token", "TkPlus", []))
    evalVarFallback("xyz") => Result.Err("undefined variable: xyz")

fn evalPropagate(inner: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate ? operator: unwrap Ok or propagate Err."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExpr(inner, env, fns)?
    match v
        Val.ValOk(x) -> Result.Ok(x)
        Val.ValErr(e) -> match e
            Val.ValStr(msg) -> Result.Err(msg)
            _ -> Result.Err("propagated error")
        _ -> Result.Err("? operator requires Result value")

fn evalMatchExpr(scrutinee: Expr, arms: List<MatchArm>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate a match expression."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalExpr(scrutinee, env, fns)
        Result.Ok(v) -> evalMatch(v, arms, env, fns)
        Result.Err(e) -> Result.Err(e)

fn applyBinop(x: Int, y: Int, op: BinOp) -> Result<Val, String>
    ? "Apply a binary operation to two integers."
    match op
        BinOp.OpAdd -> Result.Ok(Val.ValInt(x + y))
        BinOp.OpSub -> Result.Ok(Val.ValInt(x - y))
        BinOp.OpMul -> Result.Ok(Val.ValInt(x * y))
        BinOp.OpDiv -> match y == 0
            true -> Result.Err("division by zero")
            false -> Result.Ok(Val.ValInt(x / y))

verify applyBinop
    applyBinop(3, 4, BinOp.OpAdd) => Result.Ok(Val.ValInt(7))
    applyBinop(10, 3, BinOp.OpSub) => Result.Ok(Val.ValInt(7))
    applyBinop(3, 4, BinOp.OpMul) => Result.Ok(Val.ValInt(12))
    applyBinop(10, 2, BinOp.OpDiv) => Result.Ok(Val.ValInt(5))
    applyBinop(10, 0, BinOp.OpDiv) => Result.Err("division by zero")

fn applyBinopFloat(x: Float, y: Float, op: BinOp) -> Result<Val, String>
    ? "Apply a binary operation to two floats."
    match op
        BinOp.OpAdd -> Result.Ok(Val.ValFloat(x + y))
        BinOp.OpSub -> Result.Ok(Val.ValFloat(x - y))
        BinOp.OpMul -> Result.Ok(Val.ValFloat(x * y))
        BinOp.OpDiv -> Result.Ok(Val.ValFloat(x / y))

verify applyBinopFloat
    applyBinopFloat(1.5, 2.5, BinOp.OpAdd) => Result.Ok(Val.ValFloat(4.0))
    applyBinopFloat(5.0, 3.0, BinOp.OpSub) => Result.Ok(Val.ValFloat(2.0))
    applyBinopFloat(2.0, 3.0, BinOp.OpMul) => Result.Ok(Val.ValFloat(6.0))
    applyBinopFloat(10.0, 4.0, BinOp.OpDiv) => Result.Ok(Val.ValFloat(2.5))

fn applyCmp(x: Int, y: Int, op: CmpOp) -> Result<Val, String>
    ? "Apply a comparison operation to two integers."
    match op
        CmpOp.CmpEq -> Result.Ok(Val.ValBool(x == y))
        CmpOp.CmpNeq -> Result.Ok(Val.ValBool(x != y))
        CmpOp.CmpLt -> Result.Ok(Val.ValBool(x < y))
        CmpOp.CmpGt -> Result.Ok(Val.ValBool(x > y))
        CmpOp.CmpLte -> Result.Ok(Val.ValBool(x <= y))
        CmpOp.CmpGte -> Result.Ok(Val.ValBool(x >= y))

verify applyCmp
    applyCmp(1, 1, CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    applyCmp(1, 2, CmpOp.CmpEq) => Result.Ok(Val.ValBool(false))
    applyCmp(1, 2, CmpOp.CmpLt) => Result.Ok(Val.ValBool(true))

fn applyCmpFloat(x: Float, y: Float, op: CmpOp) -> Result<Val, String>
    ? "Apply a comparison to two floats."
    match op
        CmpOp.CmpEq -> Result.Ok(Val.ValBool(x == y))
        CmpOp.CmpNeq -> Result.Ok(Val.ValBool(x != y))
        CmpOp.CmpLt -> Result.Ok(Val.ValBool(x < y))
        CmpOp.CmpGt -> Result.Ok(Val.ValBool(x > y))
        CmpOp.CmpLte -> Result.Ok(Val.ValBool(x <= y))
        CmpOp.CmpGte -> Result.Ok(Val.ValBool(x >= y))

verify applyCmpFloat
    applyCmpFloat(1.0, 1.0, CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    applyCmpFloat(1.0, 2.0, CmpOp.CmpLt) => Result.Ok(Val.ValBool(true))
    applyCmpFloat(3.0, 2.0, CmpOp.CmpGt) => Result.Ok(Val.ValBool(true))
    applyCmpFloat(1.0, 1.0, CmpOp.CmpLte) => Result.Ok(Val.ValBool(true))
    applyCmpFloat(1.0, 2.0, CmpOp.CmpNeq) => Result.Ok(Val.ValBool(true))

fn evalBinopVals(va: Val, vb: Val, op: BinOp) -> Result<Val, String>
    ? "Apply binary op to two evaluated values."
    match (va, vb)
        (Val.ValInt(x), Val.ValInt(y)) -> applyBinop(x, y, op)
        (Val.ValFloat(x), Val.ValFloat(y)) -> applyBinopFloat(x, y, op)
        (Val.ValInt(x), Val.ValFloat(y)) -> applyBinopFloat(Int.toFloat(x), y, op)
        (Val.ValFloat(x), Val.ValInt(y)) -> applyBinopFloat(x, Int.toFloat(y), op)
        (Val.ValStr(x), Val.ValStr(y)) -> match op
            BinOp.OpAdd -> Result.Ok(Val.ValStr(x + y))
            _ -> Result.Err("strings only support +")
        _ -> Result.Err("binop type mismatch")

verify evalBinopVals
    evalBinopVals(Val.ValInt(2), Val.ValInt(3), BinOp.OpAdd) => Result.Ok(Val.ValInt(5))
    evalBinopVals(Val.ValFloat(1.5), Val.ValFloat(2.5), BinOp.OpAdd) => Result.Ok(Val.ValFloat(4.0))
    evalBinopVals(Val.ValInt(1), Val.ValFloat(2.5), BinOp.OpAdd) => Result.Ok(Val.ValFloat(3.5))
    evalBinopVals(Val.ValFloat(3.0), Val.ValInt(2), BinOp.OpMul) => Result.Ok(Val.ValFloat(6.0))
    evalBinopVals(Val.ValStr("a"), Val.ValStr("b"), BinOp.OpAdd) => Result.Ok(Val.ValStr("ab"))

fn evalCmpVals(va: Val, vb: Val, op: CmpOp) -> Result<Val, String>
    ? "Apply comparison to two evaluated values (Int, Float, or String)."
    match (va, vb)
        (Val.ValInt(x), Val.ValInt(y)) -> applyCmp(x, y, op)
        (Val.ValFloat(x), Val.ValFloat(y)) -> applyCmpFloat(x, y, op)
        (Val.ValInt(x), Val.ValFloat(y)) -> applyCmpFloat(Int.toFloat(x), y, op)
        (Val.ValFloat(x), Val.ValInt(y)) -> applyCmpFloat(x, Int.toFloat(y), op)
        (Val.ValStr(x), Val.ValStr(y)) -> applyStrCmp(x, y, op)
        (Val.ValBool(x), Val.ValBool(y)) -> applyBoolCmp(x, y, op)
        (a, b) -> evalCmpRepr(a, b, op)

verify evalCmpVals
    evalCmpVals(Val.ValInt(1), Val.ValInt(1), CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValFloat(1.5), Val.ValFloat(1.5), CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValFloat(1.0), Val.ValFloat(2.0), CmpOp.CmpLt) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValInt(1), Val.ValFloat(1.0), CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValStr("a"), Val.ValStr("a"), CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValBool(true), Val.ValBool(false), CmpOp.CmpEq) => Result.Ok(Val.ValBool(false))

fn applyStrCmp(x: String, y: String, op: CmpOp) -> Result<Val, String>
    ? "String comparison: all operators supported."
    match op
        CmpOp.CmpEq -> Result.Ok(Val.ValBool(x == y))
        CmpOp.CmpNeq -> Result.Ok(Val.ValBool(x != y))
        CmpOp.CmpLt -> Result.Ok(Val.ValBool(x < y))
        CmpOp.CmpGt -> Result.Ok(Val.ValBool(x > y))
        CmpOp.CmpLte -> Result.Ok(Val.ValBool(x <= y))
        CmpOp.CmpGte -> Result.Ok(Val.ValBool(x >= y))

verify applyStrCmp
    applyStrCmp("a", "a", CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    applyStrCmp("a", "b", CmpOp.CmpLt) => Result.Ok(Val.ValBool(true))
    applyStrCmp("b", "a", CmpOp.CmpGt) => Result.Ok(Val.ValBool(true))

fn applyBoolCmp(x: Bool, y: Bool, op: CmpOp) -> Result<Val, String>
    ? "Bool comparison: eq and neq."
    match op
        CmpOp.CmpEq -> Result.Ok(Val.ValBool(x == y))
        CmpOp.CmpNeq -> Result.Ok(Val.ValBool(x != y))
        _ -> Result.Err("bools only support == and !=")

verify applyBoolCmp
    applyBoolCmp(true, true, CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    applyBoolCmp(true, false, CmpOp.CmpNeq) => Result.Ok(Val.ValBool(true))

fn evalCmpRepr(va: Val, vb: Val, op: CmpOp) -> Result<Val, String>
    ? "Fallback comparison using repr (for variants, lists, etc)."
    match op
        CmpOp.CmpEq -> Result.Ok(Val.ValBool(Domain.Value.valRepr(va) == Domain.Value.valRepr(vb)))
        CmpOp.CmpNeq -> Result.Ok(Val.ValBool(Domain.Value.valRepr(va) != Domain.Value.valRepr(vb)))
        _ -> Result.Err("comparison not supported for these types")

verify evalCmpRepr
    evalCmpRepr(Val.ValNone, Val.ValNone, CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))

fn evalBinopRight(va: Val, b: Expr, env: Map<String, Val>, fns: Map<String, FnDef>, op: BinOp) -> Result<Val, String>
    ? "Evaluate right side of binop and apply."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalExpr(b, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(vb) -> evalBinopVals(va, vb, op)

fn evalBinop(a: Expr, b: Expr, env: Map<String, Val>, fns: Map<String, FnDef>, op: BinOp) -> Result<Val, String>
    ? "Evaluate a binary operation on two expressions."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalExpr(a, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(va) -> evalBinopRight(va, b, env, fns, op)

fn evalCmpRight(va: Val, b: Expr, env: Map<String, Val>, fns: Map<String, FnDef>, op: CmpOp) -> Result<Val, String>
    ? "Evaluate right side of comparison and apply."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalExpr(b, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(vb) -> evalCmpVals(va, vb, op)

fn evalCmp(a: Expr, b: Expr, env: Map<String, Val>, fns: Map<String, FnDef>, op: CmpOp) -> Result<Val, String>
    ? "Evaluate a comparison expression."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalExpr(a, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(va) -> evalCmpRight(va, b, env, fns, op)

fn evalConcatExpr(parts: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate string interpolation: concat all parts as strings."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    evalConcatParts(parts, env, fns, "")

fn evalConcatParts(parts: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>, acc: String) -> Result<Val, String>
    ? "Concatenate interpolation parts. Self-recursive for codegen TCO."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match parts
        [] -> Result.Ok(Val.ValStr(acc))
        [p, ..rest] -> match evalExpr(p, env, fns)
            Result.Err(e) -> Result.Err(e)
            Result.Ok(v) -> evalConcatParts(rest, env, fns, acc + Domain.Value.valRepr(v))

fn evalTupleExpr(exprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate tuple literal."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    items = evalListItems(exprs, env, fns)?
    Result.Ok(Val.ValTuple(items))

fn evalRecordExpr(name: String, fieldExprs: List<(String, Expr)>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate record constructor."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    fields = evalRecordFields(fieldExprs, env, fns)?
    Result.Ok(Val.ValRecord(name, fields))

fn evalRecordFields(fieldExprs: List<(String, Expr)>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<List<(String, Val)>, String>
    ? "Evaluate record field expressions."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match fieldExprs
        [] -> Result.Ok([])
        [pair, ..rest] -> match pair
            (fname, expr) -> evalRecordFieldOne(fname, expr, rest, env, fns)

fn evalRecordFieldOne(fname: String, expr: Expr, rest: List<(String, Expr)>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<List<(String, Val)>, String>
    ? "Evaluate one record field and continue."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExpr(expr, env, fns)?
    restFields = evalRecordFields(rest, env, fns)?
    Result.Ok(List.prepend((fname, v), restFields))

fn evalFieldAccess(obj: Expr, field: String, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate field access: obj.field."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExpr(obj, env, fns)?
    match v
        Val.ValRecord(_, fields) -> lookupField(fields, field)
        _ -> Result.Err("field access on non-record")

fn lookupField(fields: List<(String, Val)>, name: String) -> Result<Val, String>
    ? "Look up a field in a record's field list."
    match fields
        [] -> Result.Err("unknown field: {name}")
        [pair, ..rest] -> match pair
            (k, v) -> match k == name
                true -> Result.Ok(v)
                false -> lookupField(rest, name)

verify lookupField
    lookupField([("x", Val.ValInt(1)), ("y", Val.ValInt(2))], "x") => Result.Ok(Val.ValInt(1))
    lookupField([("x", Val.ValInt(1))], "z") => Result.Err("unknown field: z")

fn evalListExpr(exprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate a list literal."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalListItems(exprs, env, fns)
        Result.Ok(items) -> Result.Ok(Val.ValList(items))
        Result.Err(e) -> Result.Err(e)

fn evalListItems(exprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<List<Val>, String>
    ? "Evaluate list of expressions into list of values."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    evalListItemsRev(exprs, env, fns, [])

fn evalListItemsRev(exprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>, acc: List<Val>) -> Result<List<Val>, String>
    ? "Tail-recursive worker for evalListItems. Accumulates in reverse."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match exprs
        [] -> Result.Ok(List.reverse(acc))
        [e, ..rest] -> match evalExpr(e, env, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalListItemsRev(rest, env, fns, List.prepend(v, acc))

fn evalArgs(exprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<List<Val>, String>
    ? "Evaluate a list of argument expressions."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    evalArgsRev(exprs, env, fns, [])

fn evalArgsRev(exprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>, acc: List<Val>) -> Result<List<Val>, String>
    ? "Tail-recursive worker for evalArgs. Accumulates in reverse."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match exprs
        [] -> Result.Ok(List.reverse(acc))
        [e, ..rest] -> match evalExpr(e, env, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalArgsRev(rest, env, fns, List.prepend(v, acc))

verify evalArgs
    evalArgs([Expr.ExprInt(1), Expr.ExprInt(2)], Map.empty(), Map.empty()) => Result.Ok([Val.ValInt(1), Val.ValInt(2)])

fn callWithArgs(args: List<Val>, name: String, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Dispatch call: record update if Type.update, else normal call."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match isRecordUpdate(name, args)
        true -> doRecordUpdate(args)
        false -> callWithArgsNormal(args, name, fns)

fn callWithArgsNormal(args: List<Val>, name: String, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Normal function call dispatch. Uses slot-based eval for resolved fns."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match lookupFn(fns, name)
        Result.Ok(fd) -> callResolved(fd, args, fns)
        Result.Err(_) -> Domain.Builtins.callBuiltin(name, args)

fn callResolved(fd: FnDef, args: List<Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call a function: slot-based if resolved, map-based otherwise."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match fd.slotCount > 0
        true -> evalResolvedSlotFn(fd, buildSlotEnv(args, fd.slotCount), fns)
        false -> evalResolvedNamedFn(fd, zipArgs(fd.params, args, Map.empty()), fns)

fn evalResolvedSlotFn(fd: FnDef, calleeEnv: Vector<Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate a resolved function body in slot mode, using a fast expr tag when available."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match fd.fastPath
        FnFastPath.FastLeaf(leaf) -> runFastLeafSlot(leaf, calleeEnv)
        FnFastPath.FastBoolSlotBranch(slot, thenLeaf, elseLeaf) -> fastBoolSlotBranch(calleeEnv, slot, thenLeaf, elseLeaf)
        FnFastPath.FastEqIntBranch(slot, expected, thenLeaf, elseLeaf) -> fastEqIntBranch(calleeEnv, slot, expected, thenLeaf, elseLeaf)
        FnFastPath.FastEqStringBranch(slot, expected, thenLeaf, elseLeaf) -> fastEqStringBranch(calleeEnv, slot, expected, thenLeaf, elseLeaf)
        FnFastPath.FastLtIntSlotsBranch(lhsSlot, rhsSlot, thenLeaf, elseLeaf) -> fastLtIntSlotsBranch(calleeEnv, lhsSlot, rhsSlot, thenLeaf, elseLeaf)
        FnFastPath.FastSingleExpr -> evalResolvedSingleExprSlot(fd.body, calleeEnv, fd.slotMap, fns)
        FnFastPath.FastNone -> evalStmtsSlot(fd.body, calleeEnv, fd.slotMap, fns)

fn evalResolvedNamedFn(fd: FnDef, calleeEnv: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate a resolved function body in named-env mode, using a fast expr tag when available."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match fd.fastPath
        FnFastPath.FastLeaf(leaf) -> runFastLeafNamed(leaf, fd.body, calleeEnv, fns)
        FnFastPath.FastSingleExpr -> evalResolvedSingleExprNamed(fd.body, calleeEnv, fns)
        FnFastPath.FastNone -> evalStmts(fd.body, calleeEnv, fns)
        _ -> evalResolvedSingleExprNamed(fd.body, calleeEnv, fns)

fn evalResolvedSingleExprSlot(body: List<Stmt>, calleeEnv: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Fast path for a single expression body in slot mode."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match body
        [stmt, ..rest] -> match rest == []
            true -> evalResolvedSingleStmtSlot(stmt, calleeEnv, slotMap, fns)
            false -> evalStmtsSlot(body, calleeEnv, slotMap, fns)
        _ -> evalStmtsSlot(body, calleeEnv, slotMap, fns)

fn evalResolvedSingleStmtSlot(stmt: Stmt, calleeEnv: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Run the single expression stmt fast path in slot mode."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match stmt
        Stmt.StmtExpr(expr) -> evalExprSlot(expr, calleeEnv, slotMap, fns)
        _ -> evalStmtsSlot([stmt], calleeEnv, slotMap, fns)

fn evalResolvedSingleExprNamed(body: List<Stmt>, calleeEnv: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Fast path for a single expression body in named-env mode."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match body
        [stmt, ..rest] -> match rest == []
            true -> evalResolvedSingleStmtNamed(stmt, calleeEnv, fns)
            false -> evalStmts(body, calleeEnv, fns)
        _ -> evalStmts(body, calleeEnv, fns)

fn evalResolvedSingleStmtNamed(stmt: Stmt, calleeEnv: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Run the single expression stmt fast path in named-env mode."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match stmt
        Stmt.StmtExpr(expr) -> evalExpr(expr, calleeEnv, fns)
        _ -> evalStmts([stmt], calleeEnv, fns)

fn runFastLeafSlot(leaf: FastLeaf, calleeEnv: Vector<Val>) -> Result<Val, String>
    ? "Execute a leaf-like fast path directly from slots."
    match leaf
        FastLeaf.LeafConstInt(n) -> Result.Ok(Val.ValInt(n))
        FastLeaf.LeafConstFloat(f) -> Result.Ok(Val.ValFloat(f))
        FastLeaf.LeafConstStr(s) -> Result.Ok(Val.ValStr(s))
        FastLeaf.LeafConstBool(b) -> Result.Ok(Val.ValBool(b))
        FastLeaf.LeafSlot(slot) -> lookupSlot(calleeEnv, slot)
        FastLeaf.LeafVectorNew(sizeSlot, fill) -> fastVectorNewSlot(calleeEnv, sizeSlot, fill)
        FastLeaf.LeafVectorGetOrInt(vecSlot, idxSlot, defaultValue) -> fastVectorGetOrIntSlot(calleeEnv, vecSlot, idxSlot, defaultValue)

fn runFastLeafNamed(leaf: FastLeaf, body: List<Stmt>, calleeEnv: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Execute named-env leaves directly when they are pure constants; otherwise fall back."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match leaf
        FastLeaf.LeafConstInt(n) -> Result.Ok(Val.ValInt(n))
        FastLeaf.LeafConstFloat(f) -> Result.Ok(Val.ValFloat(f))
        FastLeaf.LeafConstStr(s) -> Result.Ok(Val.ValStr(s))
        FastLeaf.LeafConstBool(b) -> Result.Ok(Val.ValBool(b))
        _ -> evalResolvedSingleExprNamed(body, calleeEnv, fns)

fn fastBoolSlotBranch(calleeEnv: Vector<Val>, slot: Int, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute a bool-slot branch with precomputed leaf results."
    slotV = lookupSlot(calleeEnv, slot)?
    match slotV
        Val.ValBool(cond) -> selectFastLeaf(cond, thenLeaf, elseLeaf, calleeEnv)
        _ -> Result.Err("fast bool branch expects Bool slot")

fn fastEqIntBranch(calleeEnv: Vector<Val>, slot: Int, expected: Int, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute an int equality branch with precomputed leaf results."
    slotV = lookupSlot(calleeEnv, slot)?
    match slotV
        Val.ValInt(actual) -> selectFastLeaf(actual == expected, thenLeaf, elseLeaf, calleeEnv)
        _ -> Result.Err("fast int branch expects Int slot")

fn fastEqStringBranch(calleeEnv: Vector<Val>, slot: Int, expected: String, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute a string equality branch with precomputed leaf results."
    slotV = lookupSlot(calleeEnv, slot)?
    match slotV
        Val.ValStr(actual) -> selectFastLeaf(actual == expected, thenLeaf, elseLeaf, calleeEnv)
        _ -> Result.Err("fast string branch expects String slot")

fn fastLtIntSlotsBranch(calleeEnv: Vector<Val>, lhsSlot: Int, rhsSlot: Int, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> Result<Val, String>
    ? "Execute an int less-than branch with precomputed leaf results."
    lhsV = lookupSlot(calleeEnv, lhsSlot)?
    rhsV = lookupSlot(calleeEnv, rhsSlot)?
    match lhsV
        Val.ValInt(lhs) -> match rhsV
            Val.ValInt(rhs) -> selectFastLeaf(lhs < rhs, thenLeaf, elseLeaf, calleeEnv)
            _ -> Result.Err("fast lt branch expects Int rhs slot")
        _ -> Result.Err("fast lt branch expects Int lhs slot")

fn selectFastLeaf(cond: Bool, thenLeaf: FastLeaf, elseLeaf: FastLeaf, calleeEnv: Vector<Val>) -> Result<Val, String>
    ? "Choose and execute one of two leaf results."
    match cond
        true -> runFastLeafSlot(thenLeaf, calleeEnv)
        false -> runFastLeafSlot(elseLeaf, calleeEnv)

fn fastVectorNewSlot(calleeEnv: Vector<Val>, sizeSlot: Int, fill: Int) -> Result<Val, String>
    ? "Fast path for Vector.new(slot, int) wrappers."
    sizeV = lookupSlot(calleeEnv, sizeSlot)?
    fastVectorNewSlotInner(sizeV, fill)

fn fastVectorNewSlotInner(sizeV: Val, fill: Int) -> Result<Val, String>
    ? "Allocate a vector when the wrapper shape is known in advance."
    match sizeV
        Val.ValInt(size) -> Result.Ok(Val.ValVector(Vector.new(size, Val.ValInt(fill))))
        _ -> Result.Err("Vector.new size must be Int")

fn fastVectorGetOrIntSlot(calleeEnv: Vector<Val>, vecSlot: Int, idxSlot: Int, defaultValue: Int) -> Result<Val, String>
    ? "Fast path for Option.withDefault(Vector.get(slotVec, slotIdx), int)."
    vecV = lookupSlot(calleeEnv, vecSlot)?
    idxV = lookupSlot(calleeEnv, idxSlot)?
    fastVectorGetOrIntSlotInner(vecV, idxV, defaultValue)

fn fastVectorGetOrIntSlotInner(vecV: Val, idxV: Val, defaultValue: Int) -> Result<Val, String>
    ? "Read a vector cell with an integer default without going through builtin dispatch."
    match vecV
        Val.ValVector(vec) -> match idxV
            Val.ValInt(idx) -> match Vector.get(vec, idx)
                Option.Some(v) -> Result.Ok(v)
                Option.None -> Result.Ok(Val.ValInt(defaultValue))
            _ -> Result.Err("Vector.get index must be Int")
        _ -> Result.Err("Vector.get expects a Vector")

fn isRecordUpdate(name: String, args: List<Val>) -> Bool
    ? "Check if this is a Type.update(record, _named(...)) call."
    match String.contains(name, ".update")
        true -> hasNamedRecord(args)
        false -> false

fn hasNamedRecord(args: List<Val>) -> Bool
    ? "Check if last arg is a _named record sentinel."
    match List.len(args) == 2
        true -> isNamedSentinel(args)
        false -> false

fn isNamedSentinel(args: List<Val>) -> Bool
    ? "Check second element is ValRecord with _named tag."
    match args
        [_, ..rest] -> isNamedSentinelInner(rest)
        [] -> false

fn isNamedSentinelInner(rest: List<Val>) -> Bool
    ? "Check first element of rest is a _named record."
    match rest
        [v, ..ignored] -> match v
            Val.ValRecord(typeName, _) -> typeName == "_named"
            _ -> false
        [] -> false

fn doRecordUpdate(args: List<Val>) -> Result<Val, String>
    ? "Perform record update: merge named fields into base record."
    match args
        [baseVal, ..rest] -> doRecordUpdateInner(baseVal, rest)
        [] -> Result.Err("record update requires (record, named fields)")

fn doRecordUpdateInner(baseVal: Val, rest: List<Val>) -> Result<Val, String>
    ? "Extract named fields from rest and apply update."
    match rest
        [namedVal, ..ignored] -> match namedVal
            Val.ValRecord(_, namedFields) -> applyRecordUpdate(baseVal, namedFields)
            _ -> Result.Err("record update requires named fields")
        [] -> Result.Err("record update requires named fields")

fn applyRecordUpdate(baseVal: Val, namedFields: List<(String, Val)>) -> Result<Val, String>
    ? "Override fields in a record value."
    match baseVal
        Val.ValRecord(typeName, existingFields) -> Result.Ok(Val.ValRecord(typeName, mergeRecordFields(existingFields, namedFields)))
        _ -> Result.Err("update requires a record value")

fn mergeRecordFields(existing: List<(String, Val)>, overrides: List<(String, Val)>) -> List<(String, Val)>
    ? "For each field in existing: use override if present, otherwise keep."
    match existing
        [] -> overrides
        [pair, ..rest] -> match pair
            (k, v) -> mergeOneField(k, v, rest, overrides)

fn mergeOneField(k: String, v: Val, rest: List<(String, Val)>, overrides: List<(String, Val)>) -> List<(String, Val)>
    ? "Check if field k has an override."
    match findOverride(k, overrides)
        Option.Some(newV) -> List.prepend((k, newV), mergeRecordFields(rest, removeOverride(k, overrides)))
        Option.None -> List.prepend((k, v), mergeRecordFields(rest, overrides))

fn findOverride(k: String, overrides: List<(String, Val)>) -> Option<Val>
    ? "Find a field value in the overrides list."
    match overrides
        [] -> Option.None
        [pair, ..rest] -> match pair
            (ok, ov) -> match ok == k
                true -> Option.Some(ov)
                false -> findOverride(k, rest)

fn removeOverride(k: String, overrides: List<(String, Val)>) -> List<(String, Val)>
    ? "Remove a field from overrides list."
    match overrides
        [] -> []
        [pair, ..rest] -> match pair
            (ok, ov) -> match ok == k
                true -> rest
                false -> List.prepend((ok, ov), removeOverride(k, rest))

fn evalCall(name: String, argExprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate a function call."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalArgs(argExprs, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(args) -> callWithArgs(args, name, fns)

fn evalCallDirect(name: String, argExprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call a pre-resolved function directly using a lightweight target reference."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    fd = lookupFn(fns, name)?
    match fd.slotCount > 0
        true -> evalCallDirectMapToSlot(fd, argExprs, env, fns)
        false -> evalCallDirectMapToNamed(fd, argExprs, env, fns)

fn evalCallDirectMapToSlot(fd: FnDef, argExprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call resolved function by evaluating args directly into the callee slot env."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    calleeEnv = evalArgsMapToSlotEnv(argExprs, env, fns, Vector.new(fd.slotCount, Val.ValUnit), 0)?
    evalResolvedSlotFn(fd, calleeEnv, fns)

fn evalCallDirectMapToNamed(fd: FnDef, argExprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call resolved function by evaluating args directly into the callee named env."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    calleeEnv = evalArgsMapToNamedEnv(argExprs, fd.params, env, fns, Map.empty())?
    evalResolvedNamedFn(fd, calleeEnv, fns)

fn evalCallBuiltin(name: String, argExprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call a builtin directly, skipping fns lookup."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalArgs(argExprs, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(args) -> Domain.Builtins.callBuiltin(name, args)

fn evalCallBuiltinMaybeSpecial(name: String, argExprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Builtin dispatch with fast-path peepholes for hot patterns."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match name
        "Option.withDefault" -> evalOptionWithDefaultExpr(argExprs, env, fns)
        _ -> evalCallBuiltin(name, argExprs, env, fns)

fn evalOptionWithDefaultExpr(argExprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Specialize hot Option.withDefault(Vector.get/Vector.set, default) patterns in map path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match argExprs
        [optionExpr, ..rest] -> match rest
            [defaultExpr, ..ignored] -> evalOptionWithDefaultExprInner(optionExpr, defaultExpr, env, fns)
            _ -> evalCallBuiltin("Option.withDefault", argExprs, env, fns)
        _ -> evalCallBuiltin("Option.withDefault", argExprs, env, fns)

fn evalOptionWithDefaultExprInner(optionExpr: Expr, defaultExpr: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Dispatch specialized Option.withDefault cases in map path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match optionExpr
        Expr.ExprCallBuiltin(name, vecArgs) -> match name
            "Vector.set" -> evalVectorSetWithDefaultExpr(vecArgs, defaultExpr, env, fns)
            "Vector.get" -> evalVectorGetWithDefaultExpr(vecArgs, defaultExpr, env, fns)
            _ -> evalCallBuiltin("Option.withDefault", [optionExpr, defaultExpr], env, fns)
        _ -> evalCallBuiltin("Option.withDefault", [optionExpr, defaultExpr], env, fns)

fn evalVectorSetWithDefaultExpr(vecArgs: List<Expr>, defaultExpr: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Specialized Vector.set + Option.withDefault in map path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match vecArgs
        [vecExpr, ..r1] -> match r1
            [idxExpr, ..r2] -> match r2
                [valueExpr, ..ignored] -> evalVectorSetWithDefaultExprValues(vecExpr, idxExpr, valueExpr, defaultExpr, env, fns)
                _ -> evalCallBuiltin("Option.withDefault", [Expr.ExprCallBuiltin("Vector.set", vecArgs), defaultExpr], env, fns)
            _ -> evalCallBuiltin("Option.withDefault", [Expr.ExprCallBuiltin("Vector.set", vecArgs), defaultExpr], env, fns)
        _ -> evalCallBuiltin("Option.withDefault", [Expr.ExprCallBuiltin("Vector.set", vecArgs), defaultExpr], env, fns)

fn evalVectorSetWithDefaultExprValues(vecExpr: Expr, idxExpr: Expr, valueExpr: Expr, defaultExpr: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate Vector.set operands in map path and defer the default expression until needed."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    vecV = evalExpr(vecExpr, env, fns)?
    idxV = evalExpr(idxExpr, env, fns)?
    valueV = evalExpr(valueExpr, env, fns)?
    evalVectorSetWithDefaultExprResult(vecV, idxV, valueV, defaultExpr, env, fns)

fn evalVectorSetWithDefaultExprResult(vecV: Val, idxV: Val, valueV: Val, defaultExpr: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Finish specialized Vector.set + Option.withDefault in map path with lazy default evaluation."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalVectorSetMaybeDefault(vecV, idxV, valueV)
        Result.Ok(maybeV) -> match maybeV
            Option.Some(v) -> Result.Ok(v)
            Option.None -> evalExpr(defaultExpr, env, fns)
        Result.Err(err) -> Result.Err(err)

fn evalVectorGetWithDefaultExpr(vecArgs: List<Expr>, defaultExpr: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Specialized Vector.get + Option.withDefault in map path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match vecArgs
        [vecExpr, ..r1] -> match r1
            [idxExpr, ..ignored] -> evalVectorGetWithDefaultExprValues(vecExpr, idxExpr, defaultExpr, env, fns)
            _ -> evalCallBuiltin("Option.withDefault", [Expr.ExprCallBuiltin("Vector.get", vecArgs), defaultExpr], env, fns)
        _ -> evalCallBuiltin("Option.withDefault", [Expr.ExprCallBuiltin("Vector.get", vecArgs), defaultExpr], env, fns)

fn evalVectorGetWithDefaultExprValues(vecExpr: Expr, idxExpr: Expr, defaultExpr: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate Vector.get operands in map path and defer the default expression until needed."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    vecV = evalExpr(vecExpr, env, fns)?
    idxV = evalExpr(idxExpr, env, fns)?
    evalVectorGetWithDefaultExprResult(vecV, idxV, defaultExpr, env, fns)

fn evalVectorGetWithDefaultExprResult(vecV: Val, idxV: Val, defaultExpr: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Finish specialized Vector.get + Option.withDefault in map path with lazy default evaluation."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalVectorGetMaybeDefault(vecV, idxV)
        Result.Ok(maybeV) -> match maybeV
            Option.Some(v) -> Result.Ok(v)
            Option.None -> evalExpr(defaultExpr, env, fns)
        Result.Err(err) -> Result.Err(err)

fn evalMatch(v: Val, arms: List<MatchArm>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Try each match arm until one matches. Self-recursive for codegen TCO."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match arms
        [] -> Result.Err("no matching arm")
        [arm, ..rest] -> match Domain.Match.matchPattern(arm.pattern, v)
            Result.Ok(bindings) -> evalExpr(arm.body, mergeBindings(bindings, env), fns)
            Result.Err(_) -> evalMatch(v, rest, env, fns)

fn evalStmtExpr(e: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<(Val, Map<String, Val>), String>
    ? "Evaluate a statement expression."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalExpr(e, env, fns)
        Result.Ok(v) -> Result.Ok((v, env))
        Result.Err(e) -> Result.Err(e)

fn evalStmtBind(name: String, e: Expr, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<(Val, Map<String, Val>), String>
    ? "Evaluate a binding statement."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalExpr(e, env, fns)
        Result.Ok(v) -> Result.Ok((v, Map.set(env, name, v)))
        Result.Err(e) -> Result.Err(e)

fn evalStmt(stmt: Stmt, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<(Val, Map<String, Val>), String>
    ? "Evaluate a statement, returning the result and updated environment."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match stmt
        Stmt.StmtExpr(e) -> evalStmtExpr(e, env, fns)
        Stmt.StmtBind(name, e) -> evalStmtBind(name, e, env, fns)
        Stmt.StmtBindSlot(_, e) -> evalStmtExpr(e, env, fns)

fn evalStmts(stmts: List<Stmt>, env: Map<String, Val>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate statements, threading env. Self-recursive for codegen TCO."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match stmts
        [] -> Result.Ok(Val.ValUnit)
        [s, ..rest] -> match evalStmt(s, env, fns)
            Result.Err(e) -> Result.Err(e)
            Result.Ok(pair) -> match pair
                (v, newEnv) -> match rest
                    [] -> Result.Ok(v)
                    _ -> evalStmts(rest, newEnv, fns)

fn evalProgram(prog: Program) -> Result<Val, String>
    ? "Evaluate a complete program: run top-level stmts, then call main() if it exists."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    fnsMap = fnsToMap(prog.fns, Map.empty())
    v = evalStmts(prog.stmts, Map.empty(), fnsMap)?
    maybeCallMain(fnsMap, v)

fn evalProgramWithFns(prog: Program, extraFns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate a program with additional functions from loaded modules."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    baseFns = fnsToMap(extraFns, Map.empty())
    allFns = fnsToMap(prog.fns, baseFns)
    v = evalStmts(prog.stmts, Map.empty(), allFns)?
    maybeCallMain(allFns, v)

fn maybeCallMain(fns: Map<String, FnDef>, fallback: Val) -> Result<Val, String>
    ? "If a main() function exists, call it. Otherwise return fallback value."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match lookupFn(fns, "main")
        Result.Ok(fd) -> callResolved(fd, [], fns)
        Result.Err(_) -> Result.Ok(fallback)

// --- Slot-based eval path for resolved functions ---

fn buildSlotEnv(args: List<Val>, slotCount: Int) -> Vector<Val>
    ? "Create slot env: Vector<Val> of slotCount, args at 0..n-1."
    buildSlotEnvLoop(args, Vector.new(slotCount, Val.ValUnit), 0)

fn buildSlotEnvLoop(args: List<Val>, acc: Vector<Val>, idx: Int) -> Vector<Val>
    ? "Fill slot env from arg list."
    match args
        [] -> acc
        [a, ..rest] -> buildSlotEnvLoop(rest, Option.withDefault(Vector.set(acc, idx, a), acc), idx + 1)

fn lookupSlot(env: Vector<Val>, slot: Int) -> Result<Val, String>
    ? "Look up a variable by slot index. O(1)."
    match Vector.get(env, slot)
        Option.Some(v) -> Result.Ok(v)
        Option.None -> Result.Err("slot out of bounds: {Int.toString(slot)}")

fn setSlot(env: Vector<Val>, slot: Int, v: Val) -> Vector<Val>
    ? "Set slot value. O(1)."
    Option.withDefault(Vector.set(env, slot, v), env)

verify lookupSlot
    lookupSlot(Vector.fromList([Val.ValInt(10), Val.ValInt(20)]), 0) => Result.Ok(Val.ValInt(10))
    lookupSlot(Vector.new(0, Val.ValUnit), 0) => Result.Err("slot out of bounds: 0")

verify setSlot
    setSlot(Vector.fromList([Val.ValUnit, Val.ValUnit]), 0, Val.ValInt(5)) => Vector.fromList([Val.ValInt(5), Val.ValUnit])
    setSlot(Vector.fromList([Val.ValUnit, Val.ValUnit]), 1, Val.ValInt(7)) => Vector.fromList([Val.ValUnit, Val.ValInt(7)])

verify buildSlotEnv
    buildSlotEnv([Val.ValInt(1)], 3) => Vector.fromList([Val.ValInt(1), Val.ValUnit, Val.ValUnit])
    buildSlotEnv([Val.ValInt(1), Val.ValInt(2)], 2) => Vector.fromList([Val.ValInt(1), Val.ValInt(2)])

fn evalExprSlot(expr: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate an expression using slot-based environment."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match expr
        Expr.ExprSlot(slot) -> lookupSlot(env, slot)
        Expr.ExprInt(n) -> Result.Ok(Val.ValInt(n))
        Expr.ExprFloat(f) -> Result.Ok(Val.ValFloat(f))
        Expr.ExprStr(s) -> Result.Ok(Val.ValStr(s))
        Expr.ExprBool(b) -> Result.Ok(Val.ValBool(b))
        Expr.ExprVar(name) -> evalVarSlot(name)
        Expr.ExprAdd(a, b) -> evalBinopSlot(a, b, env, slotMap, fns, BinOp.OpAdd)
        Expr.ExprSub(a, b) -> evalBinopSlot(a, b, env, slotMap, fns, BinOp.OpSub)
        Expr.ExprMul(a, b) -> evalBinopSlot(a, b, env, slotMap, fns, BinOp.OpMul)
        Expr.ExprDiv(a, b) -> evalBinopSlot(a, b, env, slotMap, fns, BinOp.OpDiv)
        Expr.ExprEq(a, b) -> evalCmpSlot(a, b, env, slotMap, fns, CmpOp.CmpEq)
        Expr.ExprNeq(a, b) -> evalCmpSlot(a, b, env, slotMap, fns, CmpOp.CmpNeq)
        Expr.ExprLt(a, b) -> evalCmpSlot(a, b, env, slotMap, fns, CmpOp.CmpLt)
        Expr.ExprGt(a, b) -> evalCmpSlot(a, b, env, slotMap, fns, CmpOp.CmpGt)
        Expr.ExprLte(a, b) -> evalCmpSlot(a, b, env, slotMap, fns, CmpOp.CmpLte)
        Expr.ExprGte(a, b) -> evalCmpSlot(a, b, env, slotMap, fns, CmpOp.CmpGte)
        Expr.ExprConcat(parts) -> evalConcatSlot(parts, env, slotMap, fns)
        Expr.ExprTuple(exprs) -> evalTupleSlot(exprs, env, slotMap, fns)
        Expr.ExprList(exprs) -> evalListSlot(exprs, env, slotMap, fns)
        Expr.ExprRecord(name, fieldExprs) -> evalRecordSlot(name, fieldExprs, env, slotMap, fns)
        Expr.ExprFieldAccess(obj, field) -> evalFieldAccessSlot(obj, field, env, slotMap, fns)
        Expr.ExprCall(name, argExprs) -> evalCallSlot(name, argExprs, env, slotMap, fns)
        Expr.ExprCallDirect(name, argExprs) -> evalCallDirectSlot(name, argExprs, env, slotMap, fns)
        Expr.ExprCallBuiltin(name, argExprs) -> evalCallBuiltinSlotMaybeSpecial(name, argExprs, env, slotMap, fns)
        Expr.ExprMatch(scrutinee, arms) -> evalMatchExprSlot(scrutinee, arms, env, slotMap, fns)
        Expr.ExprPropagate(inner) -> evalPropagateSlot(inner, env, slotMap, fns)

fn evalVarSlot(name: String) -> Result<Val, String>
    ? "Resolve unresolved var in slot path: builtins and constructors only."
    match name
        "Option.None" -> Result.Ok(Val.ValNone)
        _ -> evalVarFallback(name)

fn evalBinopSlot(a: Expr, b: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>, op: BinOp) -> Result<Val, String>
    ? "Binary op in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    va = evalExprSlot(a, env, slotMap, fns)?
    vb = evalExprSlot(b, env, slotMap, fns)?
    evalBinopVals(va, vb, op)

fn evalCmpSlot(a: Expr, b: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>, op: CmpOp) -> Result<Val, String>
    ? "Comparison in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    va = evalExprSlot(a, env, slotMap, fns)?
    vb = evalExprSlot(b, env, slotMap, fns)?
    evalCmpVals(va, vb, op)

fn evalConcatSlot(parts: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "String interpolation in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    evalConcatPartsSlot(parts, env, slotMap, fns, "")

fn evalConcatPartsSlot(parts: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>, acc: String) -> Result<Val, String>
    ? "Concatenate interpolation parts in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match parts
        [] -> Result.Ok(Val.ValStr(acc))
        [p, ..rest] -> match evalExprSlot(p, env, slotMap, fns)
            Result.Err(e) -> Result.Err(e)
            Result.Ok(v) -> evalConcatPartsSlot(rest, env, slotMap, fns, acc + Domain.Value.valRepr(v))

fn evalTupleSlot(exprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Tuple literal in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    items = evalListItemsSlot(exprs, env, slotMap, fns)?
    Result.Ok(Val.ValTuple(items))

fn evalListSlot(exprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "List literal in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    items = evalListItemsSlot(exprs, env, slotMap, fns)?
    Result.Ok(Val.ValList(items))

fn evalListItemsSlot(exprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<List<Val>, String>
    ? "Evaluate list of expressions in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    evalListItemsSlotRev(exprs, env, slotMap, fns, [])

fn evalListItemsSlotRev(exprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>, acc: List<Val>) -> Result<List<Val>, String>
    ? "Tail-recursive worker for evalListItemsSlot. Accumulates in reverse."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match exprs
        [] -> Result.Ok(List.reverse(acc))
        [e, ..rest] -> match evalExprSlot(e, env, slotMap, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalListItemsSlotRev(rest, env, slotMap, fns, List.prepend(v, acc))

fn evalRecordSlot(name: String, fieldExprs: List<(String, Expr)>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Record constructor in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    fields = evalRecordFieldsSlot(fieldExprs, env, slotMap, fns)?
    Result.Ok(Val.ValRecord(name, fields))

fn evalRecordFieldsSlot(fieldExprs: List<(String, Expr)>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<List<(String, Val)>, String>
    ? "Evaluate record fields in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match fieldExprs
        [] -> Result.Ok([])
        [pair, ..rest] -> match pair
            (fname, expr) -> evalRecordFieldOneSlot(fname, expr, rest, env, slotMap, fns)

fn evalRecordFieldOneSlot(fname: String, expr: Expr, rest: List<(String, Expr)>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<List<(String, Val)>, String>
    ? "Evaluate one record field in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExprSlot(expr, env, slotMap, fns)?
    restFields = evalRecordFieldsSlot(rest, env, slotMap, fns)?
    Result.Ok(List.prepend((fname, v), restFields))

fn evalFieldAccessSlot(obj: Expr, field: String, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Field access in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExprSlot(obj, env, slotMap, fns)?
    match v
        Val.ValRecord(_, fields) -> lookupField(fields, field)
        _ -> Result.Err("field access on non-record")

fn evalCallSlot(name: String, argExprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Function call in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    args = evalArgsSlot(argExprs, env, slotMap, fns)?
    callWithArgs(args, name, fns)

fn evalCallDirectSlot(name: String, argExprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call a pre-resolved function directly from slot mode using a lightweight target reference."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    fd = lookupFn(fns, name)?
    match fd.slotCount > 0
        true -> evalCallDirectSlotToSlot(fd, argExprs, env, slotMap, fns)
        false -> evalCallDirectSlotToNamed(fd, argExprs, env, slotMap, fns)

fn evalCallDirectSlotToSlot(fd: FnDef, argExprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call resolved function by evaluating args directly into a callee slot env from slot caller state."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    calleeEnv = evalArgsSlotToSlotEnv(argExprs, env, slotMap, fns, Vector.new(fd.slotCount, Val.ValUnit), 0)?
    evalResolvedSlotFn(fd, calleeEnv, fns)

fn evalCallDirectSlotToNamed(fd: FnDef, argExprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call resolved function by evaluating args directly into a named env from slot caller state."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    calleeEnv = evalArgsSlotToNamedEnv(argExprs, fd.params, env, slotMap, fns, Map.empty())?
    evalResolvedNamedFn(fd, calleeEnv, fns)

fn evalCallBuiltinSlot(name: String, argExprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Call a builtin directly, skipping fns lookup (slot-based path)."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    args = evalArgsSlot(argExprs, env, slotMap, fns)?
    Domain.Builtins.callBuiltin(name, args)

fn evalCallBuiltinSlotMaybeSpecial(name: String, argExprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Builtin dispatch with fast-path peepholes for hot patterns in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match name
        "Option.withDefault" -> evalOptionWithDefaultExprSlot(argExprs, env, slotMap, fns)
        _ -> evalCallBuiltinSlot(name, argExprs, env, slotMap, fns)

fn evalArgsSlot(exprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<List<Val>, String>
    ? "Evaluate argument expressions in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    evalArgsSlotRev(exprs, env, slotMap, fns, [])

fn evalArgsSlotRev(exprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>, acc: List<Val>) -> Result<List<Val>, String>
    ? "Tail-recursive worker for evalArgsSlot. Accumulates in reverse."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match exprs
        [] -> Result.Ok(List.reverse(acc))
        [e, ..rest] -> match evalExprSlot(e, env, slotMap, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalArgsSlotRev(rest, env, slotMap, fns, List.prepend(v, acc))

fn evalOptionWithDefaultExprSlot(argExprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Specialize hot Option.withDefault(Vector.get/Vector.set, default) patterns in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match argExprs
        [optionExpr, ..rest] -> match rest
            [defaultExpr, ..ignored] -> evalOptionWithDefaultExprSlotInner(optionExpr, defaultExpr, env, slotMap, fns)
            _ -> evalCallBuiltinSlot("Option.withDefault", argExprs, env, slotMap, fns)
        _ -> evalCallBuiltinSlot("Option.withDefault", argExprs, env, slotMap, fns)

fn evalOptionWithDefaultExprSlotInner(optionExpr: Expr, defaultExpr: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Dispatch specialized Option.withDefault cases in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match optionExpr
        Expr.ExprCallBuiltin(name, vecArgs) -> match name
            "Vector.set" -> evalVectorSetWithDefaultExprSlot(vecArgs, defaultExpr, env, slotMap, fns)
            "Vector.get" -> evalVectorGetWithDefaultExprSlot(vecArgs, defaultExpr, env, slotMap, fns)
            _ -> evalCallBuiltinSlot("Option.withDefault", [optionExpr, defaultExpr], env, slotMap, fns)
        _ -> evalCallBuiltinSlot("Option.withDefault", [optionExpr, defaultExpr], env, slotMap, fns)

fn evalVectorSetWithDefaultExprSlot(vecArgs: List<Expr>, defaultExpr: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Specialized Vector.set + Option.withDefault in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match vecArgs
        [vecExpr, ..r1] -> match r1
            [idxExpr, ..r2] -> match r2
                [valueExpr, ..ignored] -> evalVectorSetWithDefaultExprSlotValues(vecExpr, idxExpr, valueExpr, defaultExpr, env, slotMap, fns)
                _ -> evalCallBuiltinSlot("Option.withDefault", [Expr.ExprCallBuiltin("Vector.set", vecArgs), defaultExpr], env, slotMap, fns)
            _ -> evalCallBuiltinSlot("Option.withDefault", [Expr.ExprCallBuiltin("Vector.set", vecArgs), defaultExpr], env, slotMap, fns)
        _ -> evalCallBuiltinSlot("Option.withDefault", [Expr.ExprCallBuiltin("Vector.set", vecArgs), defaultExpr], env, slotMap, fns)

fn evalVectorSetWithDefaultExprSlotValues(vecExpr: Expr, idxExpr: Expr, valueExpr: Expr, defaultExpr: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate Vector.set operands in slot path and defer the default expression until needed."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    vecV = evalExprSlot(vecExpr, env, slotMap, fns)?
    idxV = evalExprSlot(idxExpr, env, slotMap, fns)?
    valueV = evalExprSlot(valueExpr, env, slotMap, fns)?
    evalVectorSetWithDefaultExprSlotResult(vecV, idxV, valueV, defaultExpr, env, slotMap, fns)

fn evalVectorSetWithDefaultExprSlotResult(vecV: Val, idxV: Val, valueV: Val, defaultExpr: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Finish specialized Vector.set + Option.withDefault in slot path with lazy default evaluation."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalVectorSetMaybeDefault(vecV, idxV, valueV)
        Result.Ok(maybeV) -> match maybeV
            Option.Some(v) -> Result.Ok(v)
            Option.None -> evalExprSlot(defaultExpr, env, slotMap, fns)
        Result.Err(err) -> Result.Err(err)

fn evalVectorGetWithDefaultExprSlot(vecArgs: List<Expr>, defaultExpr: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Specialized Vector.get + Option.withDefault in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match vecArgs
        [vecExpr, ..r1] -> match r1
            [idxExpr, ..ignored] -> evalVectorGetWithDefaultExprSlotValues(vecExpr, idxExpr, defaultExpr, env, slotMap, fns)
            _ -> evalCallBuiltinSlot("Option.withDefault", [Expr.ExprCallBuiltin("Vector.get", vecArgs), defaultExpr], env, slotMap, fns)
        _ -> evalCallBuiltinSlot("Option.withDefault", [Expr.ExprCallBuiltin("Vector.get", vecArgs), defaultExpr], env, slotMap, fns)

fn evalVectorGetWithDefaultExprSlotValues(vecExpr: Expr, idxExpr: Expr, defaultExpr: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate Vector.get operands in slot path and defer the default expression until needed."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    vecV = evalExprSlot(vecExpr, env, slotMap, fns)?
    idxV = evalExprSlot(idxExpr, env, slotMap, fns)?
    evalVectorGetWithDefaultExprSlotResult(vecV, idxV, defaultExpr, env, slotMap, fns)

fn evalVectorGetWithDefaultExprSlotResult(vecV: Val, idxV: Val, defaultExpr: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Finish specialized Vector.get + Option.withDefault in slot path with lazy default evaluation."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match evalVectorGetMaybeDefault(vecV, idxV)
        Result.Ok(maybeV) -> match maybeV
            Option.Some(v) -> Result.Ok(v)
            Option.None -> evalExprSlot(defaultExpr, env, slotMap, fns)
        Result.Err(err) -> Result.Err(err)

fn evalVectorSetMaybeDefault(vecV: Val, idxV: Val, valueV: Val) -> Result<Option<Val>, String>
    ? "Apply Vector.set and return None when the caller should fall back to its default expression."
    match vecV
        Val.ValVector(vec) -> match idxV
            Val.ValInt(idx) -> match idx < 0
                true -> Result.Ok(Option.None)
                false -> match idx < Vector.len(vec)
                    true -> Result.Ok(Option.Some(Val.ValVector(Option.withDefault(Vector.set(vec, idx, valueV), vec))))
                    false -> Result.Ok(Option.None)
            _ -> Result.Err("Vector.set: second arg must be Int")
        _ -> Result.Err("Vector.set: first arg must be Vector")

fn evalVectorGetMaybeDefault(vecV: Val, idxV: Val) -> Result<Option<Val>, String>
    ? "Apply Vector.get and return None when the caller should fall back to its default expression."
    match vecV
        Val.ValVector(vec) -> match idxV
            Val.ValInt(idx) -> match Vector.get(vec, idx)
                Option.Some(v) -> Result.Ok(Option.Some(v))
                Option.None -> Result.Ok(Option.None)
            _ -> Result.Err("Vector.get: expected (Vector, Int)")
        _ -> Result.Err("Vector.get: expected (Vector, Int)")

fn evalArgsMapToSlotEnv(exprs: List<Expr>, env: Map<String, Val>, fns: Map<String, FnDef>, acc: Vector<Val>, idx: Int) -> Result<Vector<Val>, String>
    ? "Evaluate arg expressions directly into a callee slot env from map caller state."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match exprs
        [] -> Result.Ok(acc)
        [e, ..rest] -> match evalExpr(e, env, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalArgsMapToSlotEnv(rest, env, fns, setSlot(acc, idx, v), idx + 1)

fn evalArgsMapToNamedEnv(exprs: List<Expr>, params: List<String>, env: Map<String, Val>, fns: Map<String, FnDef>, acc: Map<String, Val>) -> Result<Map<String, Val>, String>
    ? "Evaluate arg expressions directly into a callee named env from map caller state."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match exprs
        [] -> Result.Ok(acc)
        [e, ..restExprs] -> match evalExpr(e, env, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalArgsMapToNamedEnvBind(restExprs, params, env, fns, acc, v)

fn evalArgsMapToNamedEnvBind(restExprs: List<Expr>, params: List<String>, env: Map<String, Val>, fns: Map<String, FnDef>, acc: Map<String, Val>, v: Val) -> Result<Map<String, Val>, String>
    ? "Bind one evaluated arg into the callee named env when a parameter exists."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match params
        [param, ..restParams] -> evalArgsMapToNamedEnv(restExprs, restParams, env, fns, Map.set(acc, param, v))
        [] -> evalArgsMapToNamedEnv(restExprs, [], env, fns, acc)

fn evalArgsSlotToSlotEnv(exprs: List<Expr>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>, acc: Vector<Val>, idx: Int) -> Result<Vector<Val>, String>
    ? "Evaluate arg expressions directly into a callee slot env from slot caller state."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match exprs
        [] -> Result.Ok(acc)
        [e, ..rest] -> match evalExprSlot(e, env, slotMap, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalArgsSlotToSlotEnv(rest, env, slotMap, fns, setSlot(acc, idx, v), idx + 1)

fn evalArgsSlotToNamedEnv(exprs: List<Expr>, params: List<String>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>, acc: Map<String, Val>) -> Result<Map<String, Val>, String>
    ? "Evaluate arg expressions directly into a callee named env from slot caller state."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match exprs
        [] -> Result.Ok(acc)
        [e, ..restExprs] -> match evalExprSlot(e, env, slotMap, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalArgsSlotToNamedEnvBind(restExprs, params, env, slotMap, fns, acc, v)

fn evalArgsSlotToNamedEnvBind(restExprs: List<Expr>, params: List<String>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>, acc: Map<String, Val>, v: Val) -> Result<Map<String, Val>, String>
    ? "Bind one evaluated arg into the callee named env when a parameter exists."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match params
        [param, ..restParams] -> evalArgsSlotToNamedEnv(restExprs, restParams, env, slotMap, fns, Map.set(acc, param, v))
        [] -> evalArgsSlotToNamedEnv(restExprs, [], env, slotMap, fns, acc)

verify evalArgsSlot
    evalArgsSlot([Expr.ExprInt(1), Expr.ExprInt(2)], Vector.new(0, Val.ValUnit), Map.empty(), Map.empty()) => Result.Ok([Val.ValInt(1), Val.ValInt(2)])

fn evalMatchExprSlot(scrutinee: Expr, arms: List<MatchArm>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Match expression in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExprSlot(scrutinee, env, slotMap, fns)?
    evalMatchSlot(v, arms, env, slotMap, fns)

fn evalMatchSlot(v: Val, arms: List<MatchArm>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Try each match arm in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match arms
        [] -> Result.Err("no matching arm")
        [arm, ..rest] -> match Domain.Match.matchPattern(arm.pattern, v)
            Result.Ok(bindings) -> evalExprSlot(arm.body, mergeBindingsSlot(bindings, slotMap, env), slotMap, fns)
            Result.Err(_) -> evalMatchSlot(v, rest, env, slotMap, fns)

fn mergeBindingsSlot(bindings: List<(String, Val)>, slotMap: Map<String, Int>, env: Vector<Val>) -> Vector<Val>
    ? "Merge pattern bindings into slot env using slotMap for name-to-slot lookup."
    match bindings
        [] -> env
        [pair, ..rest] -> match pair
            (name, val) -> mergeOneBindingSlot(name, val, rest, slotMap, env)

fn mergeOneBindingSlot(name: String, val: Val, rest: List<(String, Val)>, slotMap: Map<String, Int>, env: Vector<Val>) -> Vector<Val>
    ? "Merge one pattern binding into slot env."
    match Map.get(slotMap, name)
        Option.Some(slot) -> mergeBindingsSlot(rest, slotMap, setSlot(env, slot, val))
        Option.None -> mergeBindingsSlot(rest, slotMap, env)

fn evalPropagateSlot(inner: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate ? operator in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExprSlot(inner, env, slotMap, fns)?
    match v
        Val.ValOk(x) -> Result.Ok(x)
        Val.ValErr(e) -> match e
            Val.ValStr(msg) -> Result.Err(msg)
            _ -> Result.Err("propagated error")
        _ -> Result.Err("? operator requires Result value")

fn evalStmtSlot(stmt: Stmt, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<(Val, Vector<Val>), String>
    ? "Evaluate a statement in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match stmt
        Stmt.StmtBindSlot(slot, e) -> evalStmtBindSlot(slot, e, env, slotMap, fns)
        Stmt.StmtExpr(e) -> evalStmtExprSlot(e, env, slotMap, fns)
        Stmt.StmtBind(name, e) -> evalStmtBindFallbackSlot(name, e, env, slotMap, fns)

fn evalStmtBindSlot(slot: Int, e: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<(Val, Vector<Val>), String>
    ? "Evaluate a slot binding: eval expr, set slot."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExprSlot(e, env, slotMap, fns)?
    Result.Ok((v, setSlot(env, slot, v)))

fn evalStmtExprSlot(e: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<(Val, Vector<Val>), String>
    ? "Evaluate an expression statement in slot path."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExprSlot(e, env, slotMap, fns)?
    Result.Ok((v, env))

fn evalStmtBindFallbackSlot(name: String, e: Expr, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<(Val, Vector<Val>), String>
    ? "Fallback for unresolved StmtBind in slot path (should not happen after resolver)."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    v = evalExprSlot(e, env, slotMap, fns)?
    Result.Ok((v, env))

fn evalStmtsSlot(stmts: List<Stmt>, env: Vector<Val>, slotMap: Map<String, Int>, fns: Map<String, FnDef>) -> Result<Val, String>
    ? "Evaluate statements in slot path, threading env."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match stmts
        [] -> Result.Ok(Val.ValUnit)
        [s, ..rest] -> match evalStmtSlot(s, env, slotMap, fns)
            Result.Err(e) -> Result.Err(e)
            Result.Ok(pair) -> match pair
                (v, newEnv) -> match rest
                    [] -> Result.Ok(v)
                    _ -> evalStmtsSlot(rest, newEnv, slotMap, fns)
