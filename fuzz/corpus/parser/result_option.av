module ResultOption
    intent =
        "Seed corpus entry for Result and Option — the two pillars of"
        "explicit failure handling in Aver. Covers Ok/Err and Some/None"
        "construction, pattern destructuring, and the `?` operator for"
        "error propagation. Includes verify laws with `given` lists and"
        "a `when` guard so the fuzzer sees the full property-test shape."
    exposes [safeDiv, first, chain]
    effects []

fn safeDiv(a: Int, b: Int) -> Result<Int, String>
    ? "Integer division that surfaces division-by-zero as a typed error."
    match b
        0 -> Result.Err("div by zero")
        _ -> Result.Ok(a / b)

verify safeDiv
    safeDiv(10, 2)  => Result.Ok(5)
    safeDiv(7, 0)   => Result.Err("div by zero")
    safeDiv(-9, 3)  => Result.Ok(-3)

verify safeDiv law safeDivOkOnNonzero
    given a: Int = [0, 1, 10, -7, 100]
    given b: Int = [1, 2, -3, 7]
    when b != 0
    safeDiv(a, b) => Result.Ok(a / b)

fn first(xs: List<Int>) -> Option<Int>
    ? "Returns the head of a list as Option, or None for the empty list."
    match xs
        []             -> Option.None
        [head, ..rest] -> Option.Some(head)

verify first
    first([])         => Option.None
    first([42])       => Option.Some(42)
    first([1, 2, 3])  => Option.Some(1)

verify first law firstSomeOnNonempty
    given x: Int = [0, 1, -3, 100]
    given tail: List<Int> = [[], [1], [2, 3]]
    first(List.prepend(x, tail)) => Option.Some(x)

fn chain(a: Int, b: Int) -> Result<Int, String>
    ? "Composes safeDiv with a successor step using `?` error propagation."
    x = safeDiv(a, b)?
    Result.Ok(x + 1)

verify chain
    chain(10, 2) => Result.Ok(6)
    chain(10, 0) => Result.Err("div by zero")
