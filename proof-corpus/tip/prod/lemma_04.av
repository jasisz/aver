module Lemma04
    intent =
        "TIP prod lemma_04: drop (S w) (drop x (cons y zs)) = drop w (drop x zs)."
    effects []

type Nat
    Z
    S(Nat)

fn drop(x: Nat, y: List<Int>) -> List<Int>
    match x
        Nat.Z -> y
        Nat.S(z) -> match y
            [] -> []
            [x2, ..x3] -> drop(z, x3)

verify drop law dropDropCons
    given w: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given y: Int = [1, 2, 3]
    given zs: List<Int> = [[], [1], [1, 2, 3]]
    drop(Nat.S(w), drop(x, List.concat([y], zs))) => drop(w, drop(x, zs))
