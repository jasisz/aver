    Result.Ok(Input.RunCommand(Command.RemoveTag(taskId, tag)))

verify parseRemoveTag
    parseRemoveTag(["remove_tag", "t1", "ops"]) => Result.Ok(Input.RunCommand(Command.RemoveTag("t1", "ops")))

