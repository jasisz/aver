module HttpServer
    intent =
        "Runs an HTTP/1.1 server loop in Aver over Tcp resources."
        "Native programs own polling, sessions, framing, and cooperative shutdown; proxy hosts lift the same handler directly."
    depends [Bytes, HttpWire]
    exposes [listen, serve]
    effects [Tcp.listen, Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested]

record Session
    connection: Tcp.Connection
    buffer: Bytes

record Server
    listener: Tcp.Listener
    sessions: Map<Int, Session>
    nextKey: Int

record DispatchFailure
    server: Server
    reason: String

fn listen(port: Int, handler: Fn(HttpRequest) -> HttpResponse ! [_]) -> Result<Unit, String>
    ? "Binds a conventional backlog and runs until Process requests cooperative shutdown or the listener fails."
    ! [Tcp.listen, Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested]
    serve(Tcp.listen(port, 128)?, handler)

fn serve(listener: Tcp.Listener, handler: Fn(HttpRequest) -> HttpResponse ! [_]) -> Result<Unit, String>
    ? "Serves an already-bound listener, useful when deployment policy owns backlog or socket creation."
    ! [Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested]
    run(Server(listener = listener, sessions = {}, nextKey = 1), handler)

fn run(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_]) -> Result<Unit, String>
    ? "Checks shutdown before each bounded poll so SIGINT and SIGTERM are ordinary program control flow."
    ! [Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested]
    match Process.stopRequested()
        true -> shutdown(server)
        false -> pollNext(server, handler, Tcp.poll(sockets(server.sessions, Map.keys(server.sessions), {0 => Tcp.Socket.Listening(server.listener)}), 250))

fn pollNext(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], ready: Result<List<Int>, String>) -> Result<Unit, String>
    ? "A poll failure closes every resource before the original error escapes."
    ! [Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested]
    match ready
        Result.Err(reason) -> fail(server, reason)
        Result.Ok(keys) -> continue(server, handler, dispatch(server, handler, keys))

fn continue(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], next: Result<Server, DispatchFailure>) -> Result<Unit, String>
    ? "Listener failures retain the latest session state for cleanup; per-session failures do not kill the server."
    ! [Tcp.poll, Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close, Tcp.closeListener, Process.stopRequested]
    match next
        Result.Err(failure) -> fail(failure.server, failure.reason)
        Result.Ok(updated) -> run(updated, handler)

fn dispatch(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], ready: List<Int>) -> Result<Server, DispatchFailure>
    ? "Handles every ready key returned by the complete deterministic Tcp.poll contract."
    ! [Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close]
    match ready
        [] -> Result.Ok(server)
        [key, ..rest] -> match serveKey(server, handler, key)
            Result.Err(reason) -> Result.Err(DispatchFailure(server = server, reason = reason))
            Result.Ok(updated) -> dispatch(updated, handler, rest)

fn serveKey(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], key: Int) -> Result<Server, String>
    ? "Key zero is the listener; positive keys are caller-owned HTTP sessions."
    ! [Tcp.accept, Tcp.readSome, Tcp.writeBytes, Tcp.close]
    match key == 0
        true -> acceptOne(server)
        false -> match Map.get(server.sessions, key)
            Option.None -> Result.Ok(server)
            Option.Some(session) -> pump(server, handler, key, session)

fn acceptOne(server: Server) -> Result<Server, String>
    ? "Accept is nonblocking even after readiness, so a false wakeup is harmless."
    ! [Tcp.accept]
    match Tcp.accept(server.listener)
        Result.Err(reason) -> Result.Err(reason)
        Result.Ok(accepted) -> match accepted
            Option.None -> Result.Ok(server)
            Option.Some(connection) -> Result.Ok(Server(listener = server.listener, sessions = Map.set(server.sessions, server.nextKey, Session(connection = connection, buffer = String.toUtf8(""))), nextKey = server.nextKey + 1))

fn pump(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], key: Int, session: Session) -> Result<Server, String>
    ? "Reads one available chunk; connection-local failures remove only that session."
    ! [Tcp.readSome, Tcp.writeBytes, Tcp.close]
    match Tcp.readSome(session.connection, 65536)
        Result.Err(_) -> dropSession(server, key, session)
        Result.Ok(chunk) -> absorb(server, handler, key, session, chunk)

fn absorb(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], key: Int, session: Session, chunk: Bytes) -> Result<Server, String>
    ? "Empty Bytes is clean EOF; non-empty Bytes extends the protocol buffer."
    ! [Tcp.writeBytes, Tcp.close]
    match Bytes.octets(chunk)
        [] -> dropSession(server, key, session)
        [_, .._] -> match Bytes.fromList(List.concat(Bytes.octets(session.buffer), Bytes.octets(chunk)))
            Result.Err(_) -> dropSession(server, key, session)
            Result.Ok(buffer) -> frame(server, handler, key, Session(connection = session.connection, buffer = buffer))

fn frame(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], key: Int, session: Session) -> Result<Server, String>
    ? "Pipelined complete requests are drained immediately; partial requests return to Tcp.poll."
    ! [Tcp.writeBytes, Tcp.close]
    match HttpWire.frameRequest(session.buffer)
        HttpWire.Framed.Partial -> Result.Ok(remember(server, key, session))
        HttpWire.Framed.Malformed(reason) -> refuse(server, key, session, reason)
        HttpWire.Framed.Complete(request, used) -> answer(server, handler, key, session, request, used, handler(request))

fn answer(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], key: Int, session: Session, request: HttpRequest, used: Int, response: HttpResponse) -> Result<Server, String>
    ? "The connection itself is request identity; response routing needs no provider-owned request token."
    ! [Tcp.writeBytes, Tcp.close]
    match HttpWire.renderResponse(response)
        Result.Err(_) -> dropSession(server, key, session)
        Result.Ok(payload) -> match Tcp.writeBytes(session.connection, payload)
            Result.Err(_) -> dropSession(server, key, session)
            Result.Ok(_) -> afterAnswer(server, handler, key, session, request, used, response)

fn afterAnswer(server: Server, handler: Fn(HttpRequest) -> HttpResponse ! [_], key: Int, session: Session, request: HttpRequest, used: Int, response: HttpResponse) -> Result<Server, String>
    ? "Honors connection-close and otherwise advances exactly by the framer-reported byte count."
    ! [Tcp.writeBytes, Tcp.close]
    match Bool.or(HttpWire.requestCloses(request), HttpWire.responseCloses(response))
        true -> dropSession(server, key, session)
        false -> match Bytes.fromList(List.drop(Bytes.octets(session.buffer), used))
            Result.Err(_) -> dropSession(server, key, session)
            Result.Ok(buffer) -> frame(server, handler, key, Session(connection = session.connection, buffer = buffer))

fn refuse(server: Server, key: Int, session: Session, reason: String) -> Result<Server, String>
    ? "Malformed framing receives one bounded 400 response and the unsynchronizable stream closes."
    ! [Tcp.writeBytes, Tcp.close]
    response = HttpResponse(status = 400, body = reason + "\n", headers = {"connection" => ["close"], "content-type" => ["text/plain; charset=utf-8"]})
    match HttpWire.renderResponse(response)
        Result.Err(_) -> dropSession(server, key, session)
        Result.Ok(payload) -> match Tcp.writeBytes(session.connection, payload)
            Result.Err(_) -> dropSession(server, key, session)
            Result.Ok(_) -> dropSession(server, key, session)

fn remember(server: Server, key: Int, session: Session) -> Server
    ? "Stores incomplete framing state under the caller-owned poll key."
    Server(listener = server.listener, sessions = Map.set(server.sessions, key, session), nextKey = server.nextKey)

fn dropSession(server: Server, key: Int, session: Session) -> Result<Server, String>
    ? "Closing an already-broken session may fail; removal still proceeds so one peer cannot poison the loop."
    ! [Tcp.close]
    match Tcp.close(session.connection)
        Result.Err(_) -> Result.Ok(without(server, key))
        Result.Ok(_) -> Result.Ok(without(server, key))

fn without(server: Server, key: Int) -> Server
    ? "Removes one session without changing listener identity or key allocation."
    Server(listener = server.listener, sessions = Map.remove(server.sessions, key), nextKey = server.nextKey)

fn fail(server: Server, reason: String) -> Result<Unit, String>
    ? "Cleanup is attempted before the triggering listener or poll error is returned."
    ! [Tcp.close, Tcp.closeListener]
    match shutdown(server)
        Result.Err(cleanup) -> Result.Err("{reason}; cleanup failed: {cleanup}")
        Result.Ok(_) -> Result.Err(reason)

fn shutdown(server: Server) -> Result<Unit, String>
    ? "Closes every accepted connection and releases the listener last."
    ! [Tcp.close, Tcp.closeListener]
    closeSessions(Map.values(server.sessions), server.listener)

fn closeSessions(sessions: List<Session>, listener: Tcp.Listener) -> Result<Unit, String>
    ? "Session cleanup is best-effort; listener cleanup remains observable."
    ! [Tcp.close, Tcp.closeListener]
    match sessions
        [] -> Tcp.closeListener(listener)
        [session, ..rest] -> match Tcp.close(session.connection)
            Result.Err(_) -> closeSessions(rest, listener)
            Result.Ok(_) -> closeSessions(rest, listener)

fn sockets(sessions: Map<Int, Session>, keys: List<Int>, acc: Map<Int, Tcp.Socket>) -> Map<Int, Tcp.Socket>
    ? "Projects protocol sessions into the single typed wait map consumed by Tcp.poll."
    match keys
        [] -> acc
        [key, ..rest] -> match Map.get(sessions, key)
            Option.None -> sockets(sessions, rest, acc)
            Option.Some(session) -> sockets(sessions, rest, Map.set(acc, key, Tcp.Socket.Connected(session.connection)))

verify sockets
    sockets({}, [], {}) => {}
