module ListPrefixGuard
    intent =
        "Stack shuffles that read a fixed window of the item list, laws about"
        "them guarded by the list being at least that long, and a countdown"
        "round trip whose probe arm used to break the whole probe build."
    exposes []
    depends []
    effects []

fn itemAt(items: List<List<Int>>, n: Int) -> List<Int>
    ? "The nth item from the top, or an empty item past the end."
    match items
        [] -> []
        [head, ..tail] -> hereOrDeeper(head, tail, n)

verify itemAt
    itemAt([[1], [2], [3]], 0) => [1]
    itemAt([[1], [2], [3]], 2) => [3]
    itemAt([[1]], 3) => []

fn hereOrDeeper(head: List<Int>, tail: List<List<Int>>, n: Int) -> List<Int>
    ? "Count down one position at a time."
    match n <= 0
        true -> head
        false -> itemAt(tail, n - 1)

verify hereOrDeeper
    hereOrDeeper([1], [[2]], 0) => [1]
    hereOrDeeper([1], [[2]], 1) => [2]

fn shuffled(code: Int, items: List<List<Int>>) -> List<List<Int>>
    ? "What three shuffling opcodes make of the items they reach, top first."
    top = itemAt(items, 0)
    second = itemAt(items, 1)
    third = itemAt(items, 2)
    fourth = itemAt(items, 3)
    match code
        114 -> [third, fourth, top, second]
        123 -> [third, top, second]
        124 -> [second, top]
        _ -> items

verify shuffled
    shuffled(124, [[1], [2]]) => [[2], [1]]
    shuffled(123, [[1], [2], [3]]) => [[3], [1], [2]]
    shuffled(114, [[1], [2], [3], [4]]) => [[3], [4], [1], [2]]
    shuffled(9, [[1]]) => [[1]]

verify shuffled law swapTwiceIsTheTopPair
    given items: List<List<Int>> = [[[1], [2]], [[1], [2], [3]], [[0], [7], [8], [9]]]
    when List.len(items) >= 2
    shuffled(124, shuffled(124, items)) => List.take(items, 2)

verify shuffled law rotThreeTimesIsTheTopThree
    given items: List<List<Int>> = [[[1], [2], [3]], [[1], [2], [3], [4]]]
    when List.len(items) > 2
    shuffled(123, shuffled(123, shuffled(123, items))) => List.take(items, 3)

verify shuffled law twoSwapTwiceIsTheTopFour
    given items: List<List<Int>> = [[[1], [2], [3], [4]], [[1], [2], [3], [4], [5]]]
    when 4 <= List.len(items)
    shuffled(114, shuffled(114, items)) => List.take(items, 4)

fn total(items: List<Int>) -> Int
    ? "The sum of a list."
    match items
        [] -> 0
        [head, ..tail] -> head + total(tail)

verify total
    total([]) => 0
    total([1, 2, 3]) => 6

verify total law reverseKeepsTheSumOfLongLists
    given items: List<Int> = [[1, 2], [1, 2, 3], [5, 0, 7, 1]]
    when List.len(items) >= 2
    total(List.reverse(items)) => total(items)

fn bigEndian(bytes: List<Int>, acc: Int) -> Int
    ? "Most significant digit first, which is what reversing the digits gives."
    match bytes
        [] -> acc
        [head, ..tail] -> bigEndian(tail, acc * 256 + head)

verify bigEndian
    bigEndian([], 0) => 0
    bigEndian([1, 2], 0) => 258

verify bigEndian law readsTheLastByteLast
    given bytes: List<Int> = [[], [1], [1, 2]]
    given b: Int = [0, 1, 255]
    given acc: Int = [0, 1, 300]
    bigEndian(List.concat(bytes, [b]), acc) => bigEndian(bytes, acc) * 256 + b

fn digits(value: Int, acc: List<Int>) -> List<Int>
    ? "Least significant base-256 digit first, with no leading zero."
    match value < 1
        true -> List.reverse(acc)
        false -> digits(Int.div(value, 256), List.prepend(Int.mod(value, 256), acc))

verify digits
    digits(0, []) => []
    digits(258, []) => [2, 1]

verify digits law accumulatorComesFirst
    given value: Int = [-1, 0, 1, 255, 256, 65536]
    given acc: List<Int> = [[], [9], [1, 2]]
    digits(value, acc) => List.concat(List.reverse(acc), digits(value, []))

verify digits law readsBackBigEndian
    given m: Int = [0, 1, 127, 128, 255, 256, 65535, 65536, 2147483647]
    when m >= 0
    bigEndian(List.reverse(digits(m, [])), 0) => m
