module Main
    intent = "A record whose Map field every request updates, on the VM."
    effects [Console.print]

record State
    counts: Map<Int, Int>
    served: Int

fn fill(counts: Map<Int, Int>, left: Int) -> Map<Int, Int>
    ? "Counts keys 1 to left once."
    match left <= 0
        true -> counts
        false -> fill(Map.set(counts, left, 1), left - 1)

verify fill
    fill({}, 0) => {}
    fill({}, 2) => {1 => 1, 2 => 1}

fn bump(state: State, key: Int) -> State
    ? "One more for this key. The Map is read before the counter, so the"
      "state still holds the record while the Map is set."
    next = Option.withDefault(Map.get(state.counts, key), 0) + 1
    State.update(state, counts = Map.set(state.counts, key, next), served = state.served + 1)

verify bump
    bump(State(counts = {}, served = 0), 7) => State(counts = {7 => 1}, served = 1)
    bump(State(counts = {7 => 1}, served = 1), 7) => State(counts = {7 => 2}, served = 2)

fn serve(state: State, left: Int) -> State
    ? "One request per key from left down to 1."
    match left <= 0
        true -> state
        false -> serve(bump(state, left), left - 1)

verify serve
    serve(State(counts = {}, served = 0), 0) => State(counts = {}, served = 0)
    serve(State(counts = {}, served = 0), 2) => State(counts = {1 => 1, 2 => 1}, served = 2)

fn main() -> Unit
    ? "Two thousand requests against a hundred thousand keys."
    ! [Console.print]
    done = serve(State(counts = fill({}, 100000), served = 0), 2000)
    Console.print("served {done.served}, {Map.len(done.counts)} keys")
