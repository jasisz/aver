module MapOrderHiddenObserver
    intent =
        "Two ways of reaching a map iteration-order observer that the cone walk used to miss."
        "Neither law names Map.values itself: one reaches it through a string interpolation, the other through a tail call into a mutual peer. Every map is built inside a body and no signature mentions one, so once the walk arrives the key type is invisible as well. Both claims name the value written LAST, which is not the value the map iterates first, so aver verify refutes both."
    effects []

fn hiddenValues(v: Int) -> List<Int>
    ? "Reads a two-key map, built in place, in iteration order."
    m = Map.set(Map.set({}, "b", 5), "a", v)
    Map.values(m)

fn firstValue(v: Int) -> Int
    ? "The value the map yields first."
    match hiddenValues(v)
        [x, ..__rest] -> x
        _ -> 0

fn describe(v: Int) -> String
    ? "The first value, rendered through an interpolated string."
    "{firstValue(v)}"

verify describe law describeReadsIterationOrder
    given v: Int = [3, 4]
    describe(v) => "5"

fn readValues(v: Int, n: Int) -> List<Int>
    ? "Reads the map in iteration order, or bounces back to its peer."
    match n
        0 -> hiddenValues(v)
        _ -> bounce(v, n - 1)

fn bounce(v: Int, n: Int) -> List<Int>
    ? "Bounces straight into the reader; the call is in tail position."
    readValues(v, n)

verify bounce law bounceReadsIterationOrder
    given v: Int = [3, 4]
    bounce(v, 1) => [5, v]
