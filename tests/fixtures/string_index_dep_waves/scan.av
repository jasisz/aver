module Scan
    intent = "A helper that walks a String by position, its String not the first parameter."
    exposes [skipTo]

fn skipTo(i: Int, s: String) -> Int
    ? "The position of the next quote at or after i, or the length."
    match String.charAt(s, i)
        Option.None -> i
        Option.Some("\"") -> i
        Option.Some(_) -> skipTo(i + 1, s)

verify skipTo
    skipTo(0, "ab\"c") => 2
