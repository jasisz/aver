module Decode
    intent =
        "From S-expressions to terms, patterns and proofs."
        "The grammar is the one written at the top of src/ir/proof_steps/sexpr.rs; anything else is refused by name."
    exposes [term, terms, proof, script, typ, typedVars]
    depends [Kernel.Sexp, Kernel.Term, Kernel.Proof]
    effects []

fn atom(s: Sexp) -> Result<String, String>
    ? "An atom's text."
    match s
        Sexp.Atom(a) -> Result.Ok(a)
        _ -> Result.Err("expected an atom")

verify atom
    atom(Sexp.Atom("x")) => Result.Ok("x")
    atom(Sexp.Node([])) => Result.Err("expected an atom")

fn atoms(ss: List<Sexp>) -> Result<List<String>, String>
    ? "Atoms of a list."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(atom(s)?, atoms(rest)?))

verify atoms
    atoms([Sexp.Atom("a"), Sexp.Atom("b")]) => Result.Ok(["a", "b"])

fn items(s: Sexp) -> Result<List<Sexp>, String>
    ? "The items of a list."
    match s
        Sexp.Node(xs) -> Result.Ok(xs)
        _ -> Result.Err("expected a list")

verify items
    items(Sexp.Node([Sexp.Atom("a")])) => Result.Ok([Sexp.Atom("a")])

fn tagged(s: Sexp) -> Result<Tuple<String, List<Sexp>>, String>
    ? "A list headed by an atom: the tag and the arguments."
    match s
        Sexp.Node([Sexp.Atom(tag), ..args]) -> Result.Ok((tag, args))
        _ -> Result.Err("expected a tagged list")

verify tagged
    tagged(Sexp.Node([Sexp.Atom("v"), Sexp.Atom("x")])) => Result.Ok(("v", [Sexp.Atom("x")]))

fn term(s: Sexp) -> Result<Term, String>
    ? "One term."
    match tagged(s)?
        (tag, args) -> termOf(tag, args)

verify term
    term(Sexp.Node([Sexp.Atom("i"), Sexp.Atom("-5")])) => Result.Ok(Term.TInt(0 - 5))
    term(Sexp.Node([Sexp.Atom("v"), Sexp.Atom("x")])) => Result.Ok(Term.TVar("x"))
    term(Sexp.Node([Sexp.Atom("zz")])) => Result.Err("unknown term zz")

fn termOf(tag: String, args: List<Sexp>) -> Result<Term, String>
    ? "A term by its tag."
    match tag
        "i" -> intTerm(args)
        "b" -> boolTerm(args)
        "s" -> textTerm(args)
        "unit" -> Result.Ok(Term.TUnit)
        "v" -> nameTerm(args)
        "hole" -> Result.Ok(Term.THole)
        "get" -> getTerm(args)
        "call" -> headed(args, "call")
        "bi" -> headed(args, "bi")
        "ctor" -> headed(args, "ctor")
        "op" -> opTerm(args)
        "neg" -> negTerm(args)
        "match" -> matchTerm(args)
        "str" -> Result.Ok(Term.TParts(terms(args)?))
        "list" -> Result.Ok(Term.TList(terms(args)?))
        "tuple" -> Result.Ok(Term.TTuple(terms(args)?))
        "rec" -> recTerm(args)
        "upd" -> updTerm(args)
        _ -> Result.Err("unknown term {tag}")

verify termOf
    termOf("unit", []) => Result.Ok(Term.TUnit)

fn intTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(i DIGITS)"
    match args
        [Sexp.Atom(d)] -> Result.Ok(Term.TInt(Int.fromString(d)?))
        _ -> Result.Err("malformed integer")

verify intTerm
    intTerm([Sexp.Atom("18446744073709551616")]) => Result.Ok(Term.TInt(18446744073709551616))

fn boolTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(b true) or (b false)"
    match args
        [Sexp.Atom("true")] -> Result.Ok(Term.TBool(true))
        [Sexp.Atom("false")] -> Result.Ok(Term.TBool(false))
        _ -> Result.Err("malformed Bool")

verify boolTerm
    boolTerm([Sexp.Atom("true")]) => Result.Ok(Term.TBool(true))

fn textTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(s \"text\")"
    match args
        [Sexp.Text(t)] -> Result.Ok(Term.TStr(t))
        _ -> Result.Err("malformed text")

verify textTerm
    textTerm([Sexp.Text("a")]) => Result.Ok(Term.TStr("a"))

fn nameTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(v NAME)"
    match args
        [Sexp.Atom(n)] -> Result.Ok(Term.TVar(n))
        _ -> Result.Err("malformed variable")

verify nameTerm
    nameTerm([Sexp.Atom("x")]) => Result.Ok(Term.TVar("x"))

fn getTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(get TERM FIELD)"
    match args
        [o, Sexp.Atom(f)] -> Result.Ok(Term.TGet(term(o)?, f))
        _ -> Result.Err("malformed field access")

verify getTerm
    getTerm([Sexp.Node([Sexp.Atom("v"), Sexp.Atom("r")]), Sexp.Atom("f")]) => Result.Ok(Term.TGet(Term.TVar("r"), "f"))

fn headed(args: List<Sexp>, kind: String) -> Result<Term, String>
    ? "(call NAME TERM…), (bi NAME TERM…), (ctor NAME TERM…)"
    match args
        [Sexp.Atom(name), ..rest] -> headedOf(kind, name, terms(rest)?)
        _ -> Result.Err("malformed {kind}")

verify headed
    headed([Sexp.Atom("f")], "call") => Result.Ok(Term.TCall("f", []))

fn headedOf(kind: String, name: String, xs: List<Term>) -> Result<Term, String>
    ? "The term for a headed form."
    match kind
        "call" -> Result.Ok(Term.TCall(name, xs))
        "bi" -> Result.Ok(Term.TBi(name, xs))
        _ -> Result.Ok(Term.TCtor(name, xs))

verify headedOf
    headedOf("ctor", "Option.None", []) => Result.Ok(Term.TCtor("Option.None", []))

fn opTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(op OP TERM TERM)"
    match args
        [Sexp.Atom(o), a, b] -> Result.Ok(Term.TOp(o, term(a)?, term(b)?))
        _ -> Result.Err("malformed operator")

verify opTerm
    opTerm([Sexp.Atom("+")]) => Result.Err("malformed operator")

fn negTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(neg TERM)"
    match args
        [a] -> Result.Ok(Term.TNeg(term(a)?))
        _ -> Result.Err("malformed negation")

verify negTerm
    negTerm([]) => Result.Err("malformed negation")

fn matchTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(match TERM (arm PAT TERM)…)"
    match args
        [s, ..rest] -> Result.Ok(Term.TMatch(term(s)?, arms(rest)?))
        _ -> Result.Err("malformed match")

verify matchTerm
    matchTerm([]) => Result.Err("malformed match")

fn arms(ss: List<Sexp>) -> Result<List<Arm>, String>
    ? "Match arms."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(arm(s)?, arms(rest)?))

verify arms
    arms([]) => Result.Ok([])

fn arm(s: Sexp) -> Result<Arm, String>
    ? "(arm PAT TERM)"
    match s
        Sexp.Node([Sexp.Atom("arm"), p, b]) -> Result.Ok(Arm(pattern = pat(p)?, body = term(b)?))
        _ -> Result.Err("malformed arm")

verify arm
    arm(Sexp.Atom("x")) => Result.Err("malformed arm")

fn pat(s: Sexp) -> Result<Pat, String>
    ? "A pattern."
    match tagged(s)?
        (tag, args) -> patOf(tag, args)

verify pat
    pat(Sexp.Node([Sexp.Atom("pw")])) => Result.Ok(Pat.PWild)

fn patOf(tag: String, args: List<Sexp>) -> Result<Pat, String>
    ? "A pattern by its tag."
    match tag
        "pw" -> Result.Ok(Pat.PWild)
        "pv" -> Result.Ok(Pat.PVar(onlyAtom(args)?))
        "pl" -> patLit(args)
        "pnil" -> Result.Ok(Pat.PNil)
        "pcons" -> patCons(args)
        "pt" -> Result.Ok(Pat.PTuple(pats(args)?))
        "pc" -> patCtor(args)
        _ -> Result.Err("unknown pattern {tag}")

verify patOf
    patOf("pnil", []) => Result.Ok(Pat.PNil)

fn onlyAtom(args: List<Sexp>) -> Result<String, String>
    ? "The single atom of a form."
    match args
        [Sexp.Atom(a)] -> Result.Ok(a)
        _ -> Result.Err("expected one atom")

verify onlyAtom
    onlyAtom([Sexp.Atom("x")]) => Result.Ok("x")

fn patLit(args: List<Sexp>) -> Result<Pat, String>
    ? "(pl TERM)"
    match args
        [t] -> Result.Ok(Pat.PLit(term(t)?))
        _ -> Result.Err("malformed literal pattern")

verify patLit
    patLit([]) => Result.Err("malformed literal pattern")

fn patCons(args: List<Sexp>) -> Result<Pat, String>
    ? "(pcons HEAD TAIL)"
    match args
        [Sexp.Atom(h), Sexp.Atom(t)] -> Result.Ok(Pat.PCons(h, t))
        _ -> Result.Err("malformed cons pattern")

verify patCons
    patCons([Sexp.Atom("h"), Sexp.Atom("t")]) => Result.Ok(Pat.PCons("h", "t"))

fn patCtor(args: List<Sexp>) -> Result<Pat, String>
    ? "(pc CTOR NAME…)"
    match args
        [Sexp.Atom(c), ..names] -> Result.Ok(Pat.PCtor(c, atoms(names)?))
        _ -> Result.Err("malformed constructor pattern")

verify patCtor
    patCtor([Sexp.Atom("Option.None")]) => Result.Ok(Pat.PCtor("Option.None", []))

fn pats(ss: List<Sexp>) -> Result<List<Pat>, String>
    ? "Several patterns."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(pat(s)?, pats(rest)?))

verify pats
    pats([]) => Result.Ok([])

fn recTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(rec TYPE (FIELD TERM)…)"
    match args
        [Sexp.Atom(ty), ..fs] -> Result.Ok(Term.TRec(ty, fields(fs)?))
        _ -> Result.Err("malformed record")

verify recTerm
    recTerm([Sexp.Atom("R")]) => Result.Ok(Term.TRec("R", []))

fn updTerm(args: List<Sexp>) -> Result<Term, String>
    ? "(upd TYPE TERM (FIELD TERM)…)"
    match args
        [Sexp.Atom(ty), b, ..fs] -> Result.Ok(Term.TUpd(ty, term(b)?, fields(fs)?))
        _ -> Result.Err("malformed record update")

verify updTerm
    updTerm([]) => Result.Err("malformed record update")

fn fields(ss: List<Sexp>) -> Result<List<Field>, String>
    ? "(FIELD TERM)…"
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom(n), v]), ..rest] -> Result.Ok(List.prepend(Field(name = n, value = term(v)?), fields(rest)?))
        _ -> Result.Err("malformed field")

verify fields
    fields([]) => Result.Ok([])

fn terms(ss: List<Sexp>) -> Result<List<Term>, String>
    ? "Several terms."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(term(s)?, terms(rest)?))

verify terms
    terms([]) => Result.Ok([])

fn termList(s: Sexp) -> Result<List<Term>, String>
    ? "A parenthesised list of terms."
    terms(items(s)?)

verify termList
    termList(Sexp.Node([])) => Result.Ok([])

fn bindings(s: Sexp) -> Result<List<Binding>, String>
    ? "((NAME TERM)…)"
    bindingsOf(items(s)?)

verify bindings
    bindings(Sexp.Node([])) => Result.Ok([])

fn bindingsOf(ss: List<Sexp>) -> Result<List<Binding>, String>
    ? "Each (NAME TERM)."
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom(n), v]), ..rest] -> Result.Ok(List.prepend(Kernel.Term.bind(n, term(v)?), bindingsOf(rest)?))
        _ -> Result.Err("malformed binding")

verify bindingsOf
    bindingsOf([Sexp.Atom("x")]) => Result.Err("malformed binding")

fn proof(s: Sexp) -> Result<Proof, String>
    ? "One proof step."
    match tagged(s)?
        (tag, args) -> proofOf(tag, args)

verify proof
    proof(Sexp.Node([Sexp.Atom("hyp"), Sexp.Atom("h")])) => Result.Ok(Proof.PHyp("h"))
    proof(Sexp.Node([Sexp.Atom("simp")])) => Result.Err("unknown rule simp")

fn proofOf(tag: String, args: List<Sexp>) -> Result<Proof, String>
    ? "A proof step by its rule."
    match tag
        "refl" -> Result.Ok(Proof.PRefl(oneTerm(args)?))
        "symm" -> Result.Ok(Proof.PSymm(oneProof(args)?))
        "trans" -> transProof(args)
        "congr" -> congrProof(args)
        "unfold" -> unfoldProof(args)
        "const" -> Result.Ok(Proof.PConst(onlyAtom(args)?))
        "arm" -> armProof(args)
        "proj" -> Result.Ok(Proof.PProj(oneTerm(args)?))
        "cell" -> Result.Ok(Proof.PCell(oneTerm(args)?))
        "hyp" -> Result.Ok(Proof.PHyp(onlyAtom(args)?))
        "rule" -> instanceProof(args, "rule")
        "law" -> instanceProof(args, "law")
        "compute" -> computeProof(args)
        "cases" -> casesProof(args)
        "split" -> splitProof(args)
        "have" -> haveProof(args)
        "enum" -> enumProof(args)
        "absurd" -> absurdProof(args)
        "induct" -> inductProof(args)
        "listinduct" -> listInductProof(args)
        "listcases" -> listCasesProof(args)
        "ring" -> ringProof(args)
        "linear" -> linearProof(args)
        _ -> Result.Err("unknown rule {tag}")

verify proofOf
    proofOf("refl", [Sexp.Node([Sexp.Atom("unit")])]) => Result.Ok(Proof.PRefl(Term.TUnit))

fn oneTerm(args: List<Sexp>) -> Result<Term, String>
    ? "The single term of a step."
    match args
        [t] -> term(t)
        _ -> Result.Err("expected one term")

verify oneTerm
    oneTerm([]) => Result.Err("expected one term")

fn oneProof(args: List<Sexp>) -> Result<Proof, String>
    ? "The single sub-proof of a step."
    match args
        [p] -> proof(p)
        _ -> Result.Err("expected one proof")

verify oneProof
    oneProof([]) => Result.Err("expected one proof")

fn proofs(ss: List<Sexp>) -> Result<List<Proof>, String>
    ? "Several proofs."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(proof(s)?, proofs(rest)?))

verify proofs
    proofs([]) => Result.Ok([])

fn transProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(trans (TERM…) PROOF…)"
    match args
        [ts, ..steps] -> Result.Ok(Proof.PTrans(termList(ts)?, proofs(steps)?))
        _ -> Result.Err("malformed trans")

verify transProof
    transProof([]) => Result.Err("malformed trans")

fn congrProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(congr CONTEXT PROOF)"
    match args
        [c, p] -> Result.Ok(Proof.PCongr(term(c)?, proof(p)?))
        _ -> Result.Err("malformed congr")

verify congrProof
    congrProof([]) => Result.Err("malformed congr")

fn unfoldProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(unfold FN ARM (TERM…) (TERM…) [PROOF])"
    match args
        [Sexp.Atom(f), Sexp.Atom(k), xs, ys, ..given] -> Result.Ok(Proof.PUnfold(f, Int.fromString(k)?, termList(xs)?, termList(ys)?, proofs(given)?))
        _ -> Result.Err("malformed unfold")

verify unfoldProof
    unfoldProof([]) => Result.Err("malformed unfold")

fn armProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(arm ARM (TERM…) MATCH PROOF)"
    match args
        [Sexp.Atom(k), ys, t, p] -> Result.Ok(Proof.PArm(Int.fromString(k)?, termList(ys)?, term(t)?, proof(p)?))
        _ -> Result.Err("malformed arm step")

verify armProof
    armProof([]) => Result.Err("malformed arm step")

fn instanceProof(args: List<Sexp>, kind: String) -> Result<Proof, String>
    ? "(rule ID ((NAME TERM)…) PROOF…) or (law KEY ((NAME TERM)…) [PROOF])"
    match args
        [Sexp.Atom(id), bs, ..ps] -> instanceOf(kind, id, bindings(bs)?, proofs(ps)?)
        _ -> Result.Err("malformed {kind}")

verify instanceProof
    instanceProof([], "rule") => Result.Err("malformed rule")

fn instanceOf(kind: String, id: String, bs: List<Binding>, ps: List<Proof>) -> Result<Proof, String>
    ? "A rule or law instance."
    match kind
        "rule" -> Result.Ok(Proof.PRule(id, bs, ps))
        _ -> Result.Ok(Proof.PLaw(id, bs, ps))

verify instanceOf
    instanceOf("law", "k", [], []) => Result.Ok(Proof.PLaw("k", [], []))

fn computeProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(compute TERM TERM)"
    match args
        [a, b] -> Result.Ok(Proof.PCompute(term(a)?, term(b)?))
        _ -> Result.Err("malformed compute")

verify computeProof
    computeProof([]) => Result.Err("malformed compute")

fn casesProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(cases TERM NAME PROOF PROOF)"
    match args
        [on, Sexp.Atom(h), t, f] -> Result.Ok(Proof.PCases(term(on)?, h, proof(t)?, proof(f)?))
        _ -> Result.Err("malformed cases")

verify casesProof
    casesProof([]) => Result.Err("malformed cases")

fn splitProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(split FN (TERM…) TERM NAME (case CTOR (NAME…) PROOF)…)"
    match args
        [Sexp.Atom(f), xs, on, Sexp.Atom(h), ..cs] -> Result.Ok(Proof.PSplit(f, termList(xs)?, term(on)?, h, splitCases(cs)?))
        _ -> Result.Err("malformed split")

verify splitProof
    splitProof([]) => Result.Err("malformed split")
    splitProof([Sexp.Atom("f"), Sexp.Node([]), Sexp.Node([Sexp.Atom("v"), Sexp.Atom("x")]), Sexp.Atom("h"), Sexp.Node([Sexp.Atom("case"), Sexp.Atom("nil"), Sexp.Node([]), Sexp.Node([Sexp.Atom("hyp"), Sexp.Atom("h")])])]) => Result.Ok(Proof.PSplit("f", [], Term.TVar("x"), "h", [SplitCase(ctor = "nil", binders = [], proof = Proof.PHyp("h"))]))

fn splitCases(ss: List<Sexp>) -> Result<List<SplitCase>, String>
    ? "(case CTOR (NAME…) PROOF)…"
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom("case"), Sexp.Atom(c), bs, p]), ..rest] -> Result.Ok(List.prepend(SplitCase(ctor = c, binders = atoms(items(bs)?)?, proof = proof(p)?), splitCases(rest)?))
        _ -> Result.Err("malformed split case")

verify splitCases
    splitCases([Sexp.Atom("x")]) => Result.Err("malformed split case")

fn haveProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(have NAME TERM PROOF PROOF)"
    match args
        [Sexp.Atom(h), fact, p, body] -> Result.Ok(Proof.PHave(h, term(fact)?, proof(p)?, proof(body)?))
        _ -> Result.Err("malformed have")

verify haveProof
    haveProof([]) => Result.Err("malformed have")
    haveProof([Sexp.Atom("h"), Sexp.Node([Sexp.Atom("unit")]), Sexp.Node([Sexp.Atom("refl"), Sexp.Node([Sexp.Atom("unit")])]), Sexp.Node([Sexp.Atom("hyp"), Sexp.Atom("h")])]) => Result.Ok(Proof.PHave("h", Term.TUnit, Proof.PRefl(Term.TUnit), Proof.PHyp("h")))

fn enumProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(enum NAME TERM TERM PROOF…)"
    match args
        [Sexp.Atom(v), l, r, ..cs] -> Result.Ok(Proof.PEnum(v, term(l)?, term(r)?, proofs(cs)?))
        _ -> Result.Err("malformed enum")

verify enumProof
    enumProof([]) => Result.Err("malformed enum")
    enumProof([Sexp.Atom("b"), Sexp.Node([Sexp.Atom("v"), Sexp.Atom("b")]), Sexp.Node([Sexp.Atom("v"), Sexp.Atom("b")])]) => Result.Ok(Proof.PEnum("b", Term.TVar("b"), Term.TVar("b"), []))

fn linearProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(linear TERM BOOL (NAME…) (INT…) (cut INT (INT…))…)"
    match args
        [g, Sexp.Atom(v), hs, ws, ..cs] -> Result.Ok(Proof.PLinear(term(g)?, v == "true", atoms(items(hs)?)?, ints(items(ws)?)?, cuts(cs)?))
        _ -> Result.Err("malformed linear")

verify linearProof
    linearProof([]) => Result.Err("malformed linear")
    linearProof([Sexp.Node([Sexp.Atom("v"), Sexp.Atom("g")]), Sexp.Atom("true"), Sexp.Node([]), Sexp.Node([Sexp.Atom("1")]), Sexp.Node([Sexp.Atom("cut"), Sexp.Atom("2"), Sexp.Node([Sexp.Atom("1")])])]) => Result.Ok(Proof.PLinear(Term.TVar("g"), true, [], [1], [Cut(divisor = 2, weights = [1])]))
    linearProof([Sexp.Node([Sexp.Atom("v"), Sexp.Atom("g")]), Sexp.Atom("true"), Sexp.Node([]), Sexp.Node([Sexp.Atom("1")]), Sexp.Node([Sexp.Atom("cut"), Sexp.Atom("2")])]) => Result.Err("malformed cut")

fn cuts(cs: List<Sexp>) -> Result<List<Cut>, String>
    ? "Each (cut INT (INT…)): a divisor and weights."
    match cs
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom("cut"), Sexp.Atom(d), ws]), ..rest] -> Result.Ok(List.prepend(Cut(divisor = Int.fromString(d)?, weights = ints(items(ws)?)?), cuts(rest)?))
        _ -> Result.Err("malformed cut")

verify cuts
    cuts([]) => Result.Ok([])
    cuts([Sexp.Atom("cut")]) => Result.Err("malformed cut")

fn ints(ss: List<Sexp>) -> Result<List<Int>, String>
    ? "Integers written as atoms."
    match ss
        [] -> Result.Ok([])
        [Sexp.Atom(a), ..rest] -> Result.Ok(List.prepend(Int.fromString(a)?, ints(rest)?))
        _ -> Result.Err("expected an integer")

verify ints
    ints([Sexp.Atom("2"), Sexp.Atom("-1")]) => Result.Ok([2, 0 - 1])

fn ringProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(ring TERM TERM)"
    match args
        [l, r] -> Result.Ok(Proof.PRing(term(l)?, term(r)?))
        _ -> Result.Err("malformed ring")

verify ringProof
    ringProof([]) => Result.Err("malformed ring")

fn listInductProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(listinduct NAME TERM TERM PROOF (HEAD TAIL) (GENERAL…) ((IH (TERM…) ())…) PROOF)"
    match args
        [Sexp.Atom(v), l, r, n, Sexp.Node([Sexp.Atom(h), Sexp.Atom(t)]), gs, hs, c] -> Result.Ok(Proof.PListInduct(v, term(l)?, term(r)?, proof(n)?, h, t, atoms(items(gs)?)?, ihAts(items(hs)?)?, proof(c)?))
        _ -> Result.Err("malformed listinduct")

verify listInductProof
    listInductProof([]) => Result.Err("malformed listinduct")

fn listCasesProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(listcases NAME TERM TERM PROOF (HEAD TAIL) PROOF)"
    match args
        [Sexp.Atom(v), l, r, n, Sexp.Node([Sexp.Atom(h), Sexp.Atom(t)]), c] -> Result.Ok(Proof.PListCases(v, term(l)?, term(r)?, proof(n)?, h, t, proof(c)?))
        _ -> Result.Err("malformed listcases")

verify listCasesProof
    listCasesProof([]) => Result.Err("malformed listcases")
    listCasesProof([Sexp.Atom("xs"), Sexp.Node([Sexp.Atom("v"), Sexp.Atom("xs")]), Sexp.Node([Sexp.Atom("v"), Sexp.Atom("xs")]), Sexp.Node([Sexp.Atom("refl"), Sexp.Node([Sexp.Atom("list")])]), Sexp.Node([Sexp.Atom("h"), Sexp.Atom("t")]), Sexp.Node([Sexp.Atom("hyp"), Sexp.Atom("k")])]) => Result.Ok(Proof.PListCases("xs", Term.TVar("xs"), Term.TVar("xs"), Proof.PRefl(Term.TList([])), "h", "t", Proof.PHyp("k")))

fn ihAts(ss: List<Sexp>) -> Result<List<IhAt>, String>
    ? "(IH (TERM…) (PROOF…))…: a hypothesis, the values of the generalised givens, the proofs of the carried hypotheses there."
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom(h), at, ps]), ..rest] -> Result.Ok(List.prepend(IhAt(name = h, at = termList(at)?, carry = proofs(items(ps)?)?), ihAts(rest)?))
        _ -> Result.Err("malformed induction hypothesis")

verify ihAts
    ihAts([Sexp.Node([Sexp.Atom("ih"), Sexp.Node([]), Sexp.Node([])])]) => Result.Ok([IhAt(name = "ih", at = [], carry = [])])
    ihAts([Sexp.Atom("ih")]) => Result.Err("malformed induction hypothesis")

fn inductProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(induct FN (TERM…) TERM TERM [(carry NAME…)] (case (NAME…) (IH…) PROOF)…)"
    match args
        [Sexp.Atom(f), xs, l, r, ..rest] -> inductWith(f, termList(xs)?, term(l)?, term(r)?, carried(rest)?)
        _ -> Result.Err("malformed induct")

verify inductProof
    inductProof([]) => Result.Err("malformed induct")

fn inductWith(f: String, xs: List<Term>, l: Term, r: Term, rest: Tuple<List<String>, List<Sexp>>) -> Result<Proof, String>
    ? "The induction step, once the carried names are split off its cases."
    match rest
        (ns, cs) -> Result.Ok(Proof.PInduct(f, xs, l, r, ns, cases(cs)?))

verify inductWith
    inductWith("f", [], Term.TUnit, Term.TUnit, (["h"], [])) => Result.Ok(Proof.PInduct("f", [], Term.TUnit, Term.TUnit, ["h"], []))

fn carried(ss: List<Sexp>) -> Result<Tuple<List<String>, List<Sexp>>, String>
    ? "The names after carry, when the first form is (carry NAME…), and the forms after it."
    match ss
        [] -> Result.Ok(([], []))
        [s, ..rest] -> match s
            Sexp.Node([Sexp.Atom("carry"), ..ns]) -> Result.Ok((atoms(ns)?, rest))
            _ -> Result.Ok(([], ss))

verify carried
    carried([Sexp.Node([Sexp.Atom("carry"), Sexp.Atom("h")])]) => Result.Ok((["h"], []))
    carried([Sexp.Atom("x")]) => Result.Ok(([], [Sexp.Atom("x")]))

fn cases(ss: List<Sexp>) -> Result<List<Case>, String>
    ? "(case (NAME…) (IH…) ((K IH (TERM…) (PROOF…))…) PROOF)…, each IH a NAME or (NAME PROOF…) with the proofs of the carried hypotheses; each (K …) a hypothesis at the part recursive call K recurses on and other values of the varied givens."
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom("case"), bs, hs, ms, p]), ..rest] -> Result.Ok(List.prepend(Case(binders = atoms(items(bs)?)?, ihs = ihNames(items(hs)?)?, carry = ihCarry(items(hs)?)?, more = mores(items(ms)?)?, proof = proof(p)?), cases(rest)?))
        _ -> Result.Err("malformed case")

verify cases
    cases([Sexp.Atom("x")]) => Result.Err("malformed case")

fn mores(ss: List<Sexp>) -> Result<List<More>, String>
    ? "(K IH (TERM…) (PROOF…))…"
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom(k), Sexp.Atom(h), at, ps]), ..rest] -> match Int.fromString(k)
            Result.Ok(n) -> Result.Ok(List.prepend(More(call = n, ih = IhAt(name = h, at = termList(at)?, carry = proofs(items(ps)?)?)), mores(rest)?))
            Result.Err(_) -> Result.Err("malformed hypothesis")
        _ -> Result.Err("malformed hypothesis")

verify mores
    mores([Sexp.Node([Sexp.Atom("0"), Sexp.Atom("ih"), Sexp.Node([]), Sexp.Node([])])]) => Result.Ok([More(call = 0, ih = IhAt(name = "ih", at = [], carry = []))])
    mores([Sexp.Atom("x")]) => Result.Err("malformed hypothesis")

fn ihNames(ss: List<Sexp>) -> Result<List<String>, String>
    ? "The name of each induction hypothesis."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(ihName(s)?, ihNames(rest)?))

verify ihNames
    ihNames([Sexp.Atom("ih1"), Sexp.Node([Sexp.Atom("ih2")])]) => Result.Ok(["ih1", "ih2"])

fn ihName(s: Sexp) -> Result<String, String>
    ? "NAME or (NAME PROOF…)."
    match s
        Sexp.Atom(n) -> Result.Ok(n)
        Sexp.Node([Sexp.Atom(n), ..ps]) -> Result.Ok(n)
        _ -> Result.Err("malformed hypothesis")

verify ihName
    ihName(Sexp.Node([])) => Result.Err("malformed hypothesis")

fn ihCarry(ss: List<Sexp>) -> Result<List<List<Proof>>, String>
    ? "The proofs of the carried hypotheses for each induction hypothesis."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(ihProofs(s)?, ihCarry(rest)?))

verify ihCarry
    ihCarry([Sexp.Atom("ih1")]) => Result.Ok([[]])

fn ihProofs(s: Sexp) -> Result<List<Proof>, String>
    ? "None for a bare NAME; the proofs after the name otherwise."
    match s
        Sexp.Atom(n) -> Result.Ok([])
        Sexp.Node([Sexp.Atom(n), ..ps]) -> proofs(ps)
        _ -> Result.Err("malformed hypothesis")

verify ihProofs
    ihProofs(Sexp.Atom("ih")) => Result.Ok([])

fn absurdProof(args: List<Sexp>) -> Result<Proof, String>
    ? "(absurd PROOF TERM TERM)"
    match args
        [p, l, r] -> Result.Ok(Proof.PAbsurd(proof(p)?, term(l)?, term(r)?))
        _ -> Result.Err("malformed absurd")

verify absurdProof
    absurdProof([]) => Result.Err("malformed absurd")

fn typ(s: Sexp, vars: Bool) -> Result<Ty, String>
    ? "A type: int, bool, str, float, unit, (list T), (option T), (result T E), (map K V), (vector T), (tuple T…), (named NAME), a type variable (var NAME) or (var NAME eq) whose == is equality (in the givens of a law only), or _: a type the data cannot state, read as one unknown type (shown as ?) that fits only itself."
    match s
        Sexp.Atom("int") -> Result.Ok(Ty.TyInt)
        Sexp.Atom("bool") -> Result.Ok(Ty.TyBool)
        Sexp.Atom("str") -> Result.Ok(Ty.TyStr)
        Sexp.Atom("float") -> Result.Ok(Ty.TyFloat)
        Sexp.Atom("unit") -> Result.Ok(Ty.TyUnit)
        Sexp.Atom("_") -> Result.Ok(Ty.TyRigid("", false))
        Sexp.Node([Sexp.Atom("var"), Sexp.Atom(n)]) -> typeVar(n, false, vars)
        Sexp.Node([Sexp.Atom("var"), Sexp.Atom(n), Sexp.Atom("eq")]) -> typeVar(n, true, vars)
        Sexp.Node([Sexp.Atom("list"), t]) -> Result.Ok(Ty.TyList(typ(t, vars)?))
        Sexp.Node([Sexp.Atom("option"), t]) -> Result.Ok(Ty.TyOption(typ(t, vars)?))
        Sexp.Node([Sexp.Atom("vector"), t]) -> Result.Ok(Ty.TyVector(typ(t, vars)?))
        Sexp.Node([Sexp.Atom("result"), t, e]) -> Result.Ok(Ty.TyResult(typ(t, vars)?, typ(e, vars)?))
        Sexp.Node([Sexp.Atom("map"), k, v]) -> Result.Ok(Ty.TyMap(typ(k, vars)?, typ(v, vars)?))
        Sexp.Node([Sexp.Atom("tuple"), ..ts]) -> Result.Ok(Ty.TyTuple(tys(ts, vars)?))
        Sexp.Node([Sexp.Atom("named"), Sexp.Atom(n)]) -> Result.Ok(Ty.TyNamed(n))
        _ -> Result.Err("malformed type")

verify typ
    typ(Sexp.Atom("int"), true) => Result.Ok(Ty.TyInt)
    typ(Sexp.Node([Sexp.Atom("list"), Sexp.Atom("bool")]), true) => Result.Ok(Ty.TyList(Ty.TyBool))
    typ(Sexp.Node([Sexp.Atom("tint")]), true) => Result.Err("malformed type")
    typ(Sexp.Atom("_"), true) => Result.Ok(Ty.TyRigid("", false))
    typ(Sexp.Node([Sexp.Atom("var"), Sexp.Atom("K"), Sexp.Atom("eq")]), true) => Result.Ok(Ty.TyVar("K", true))

fn typeVar(n: String, eq: Bool, vars: Bool) -> Result<Ty, String>
    ? "A type variable, where one may stand: in the givens of a law, never in a definition, a signature or a declared type."
    match vars
        true -> Result.Ok(Ty.TyVar(n, eq))
        false -> Result.Err("a type variable outside a law's givens")

verify typeVar
    typeVar("T", false, false) => Result.Err("a type variable outside a law's givens")

fn tys(ss: List<Sexp>, vars: Bool) -> Result<List<Ty>, String>
    ? "Several types."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(typ(s, vars)?, tys(rest, vars)?))

verify tys
    tys([], true) => Result.Ok([])

fn typedVars(ss: List<Sexp>, vars: Bool) -> Result<List<TypedVar>, String>
    ? "(NAME TYPE)…: names with their types."
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom(n), t]), ..rest] -> Result.Ok(List.prepend(Kernel.Term.typed(n, typ(t, vars)?), typedVars(rest, vars)?))
        _ -> Result.Err("malformed typed name")

verify typedVars
    typedVars([Sexp.Node([Sexp.Atom("n"), Sexp.Atom("int")])], true) => Result.Ok([Kernel.Term.typed("n", Ty.TyInt)])
    typedVars([Sexp.Atom("n")], true) => Result.Err("malformed typed name")

fn premise(s: Sexp) -> Result<List<Term>, String>
    ? "(none) or a term."
    match s
        Sexp.Node([Sexp.Atom("none")]) -> Result.Ok([])
        _ -> Result.Ok([term(s)?])

verify premise
    premise(Sexp.Node([Sexp.Atom("none")])) => Result.Ok([])

fn law(s: Sexp, head: String) -> Result<Law, String>
    ? "(law KEY ((NAME TYPE)…) PREMISE TERM TERM), or the same headed obligation or fact."
    match s
        Sexp.Node([Sexp.Atom(h), Sexp.Atom(k), gs, p, l, r]) -> lawOf(h == head, k, typedVars(items(gs)?, true)?, premise(p)?, term(l)?, term(r)?)
        _ -> Result.Err("malformed {head}")

verify law
    law(Sexp.Atom("x"), "law") => Result.Err("malformed law")

fn lawOf(expected: Bool, k: String, gs: List<TypedVar>, p: List<Term>, l: Term, r: Term) -> Result<Law, String>
    ? "A law once its head was checked."
    match expected
        true -> Result.Ok(Law(key = k, givens = gs, premise = p, lhs = l, rhs = r))
        false -> Result.Err("unexpected head for {k}")

verify lawOf
    lawOf(false, "k", [], [], Term.TUnit, Term.TUnit) => Result.Err("unexpected head for k")

record Cited
    laws: List<Law>
    facts: List<Fact>

fn laws(ss: List<Sexp>) -> Result<Cited, String>
    ? "Cited laws, and cited builtin facts with their proofs."
    match ss
        [] -> Result.Ok(Cited(laws = [], facts = []))
        [s, ..rest] -> withCited(s, laws(rest)?)

verify laws
    laws([]) => Result.Ok(Cited(laws = [], facts = []))

fn withCited(s: Sexp, rest: Cited) -> Result<Cited, String>
    ? "One cited law or fact in front of the rest; (fact KEY ((NAME TYPE)…) PREMISE TERM TERM PROOF)."
    match s
        Sexp.Node([Sexp.Atom("fact"), Sexp.Atom(k), gs, w, l, r, p]) -> Result.Ok(Cited(laws = rest.laws, facts = List.prepend(Fact(law = Law(key = k, givens = typedVars(items(gs)?, true)?, premise = premise(w)?, lhs = term(l)?, rhs = term(r)?), proof = proof(p)?), rest.facts)))
        _ -> Result.Ok(Cited(laws = List.prepend(law(s, "law")?, rest.laws), facts = rest.facts))

verify withCited
    withCited(Sexp.Atom("x"), Cited(laws = [], facts = [])) => Result.Err("malformed law")

fn def(s: Sexp) -> Result<Def, String>
    ? "(def NAME ((PARAM TYPE)…) TYPE ((NAME TERM)…) TERM): typed parameters, the result type, local bindings in order, the final expression."
    match s
        Sexp.Node([Sexp.Atom("def"), Sexp.Atom(n), ps, rt, ls, b]) -> Result.Ok(Def(name = n, params = typedVars(items(ps)?, false)?, ret = typ(rt, false)?, lets = bindings(ls)?, body = term(b)?))
        _ -> Result.Err("malformed def")

verify def
    def(Sexp.Atom("x")) => Result.Err("malformed def")
    def(Sexp.Node([Sexp.Atom("def"), Sexp.Atom("p"), Sexp.Node([]), Sexp.Atom("bool"), Sexp.Node([]), Sexp.Node([Sexp.Atom("b"), Sexp.Atom("true")])])) => Result.Ok(Def(name = "p", params = [], ret = Ty.TyBool, lets = [], body = Term.TBool(true)))
    def(Sexp.Node([Sexp.Atom("def"), Sexp.Atom("f"), Sexp.Node([Sexp.Node([Sexp.Atom("x"), Sexp.Atom("int")])]), Sexp.Atom("int"), Sexp.Node([Sexp.Node([Sexp.Atom("y"), Sexp.Node([Sexp.Atom("v"), Sexp.Atom("x")])])]), Sexp.Node([Sexp.Atom("v"), Sexp.Atom("y")])])) => Result.Ok(Def(name = "f", params = [Kernel.Term.typed("x", Ty.TyInt)], ret = Ty.TyInt, lets = [Kernel.Term.bind("y", Term.TVar("x"))], body = Term.TVar("y")))

fn defs(ss: List<Sexp>) -> Result<List<Def>, String>
    ? "Definitions."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(def(s)?, defs(rest)?))

verify defs
    defs([]) => Result.Ok([])

fn constant(s: Sexp) -> Result<Const, String>
    ? "(const NAME TYPE TERM)"
    match s
        Sexp.Node([Sexp.Atom("const"), Sexp.Atom(n), t, v]) -> Result.Ok(Const(name = n, ty = typ(t, false)?, value = term(v)?))
        _ -> Result.Err("malformed const")

verify constant
    constant(Sexp.Atom("x")) => Result.Err("malformed const")
    constant(Sexp.Node([Sexp.Atom("const"), Sexp.Atom("base"), Sexp.Atom("int"), Sexp.Node([Sexp.Atom("i"), Sexp.Atom("40")])])) => Result.Ok(Const(name = "base", ty = Ty.TyInt, value = Term.TInt(40)))

fn consts(ss: List<Sexp>) -> Result<List<Const>, String>
    ? "Module-level bindings."
    match ss
        [] -> Result.Ok([])
        [s, ..rest] -> Result.Ok(List.prepend(constant(s)?, consts(rest)?))

verify consts
    consts([]) => Result.Ok([])

fn sums(ss: List<Sexp>) -> Result<List<Sum>, String>
    ? "(sum NAME (CTOR TYPE…)…)…: the sum types the program declares, each constructor in order with the types of its fields; `eq` after the name where == between two values of the type is equality."
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom("sum"), Sexp.Atom(n), Sexp.Atom("eq"), ..vs]), ..rest] -> Result.Ok(List.prepend(Sum(name = n, eq = true, variants = variants(vs)?), sums(rest)?))
        [Sexp.Node([Sexp.Atom("sum"), Sexp.Atom(n), ..vs]), ..rest] -> Result.Ok(List.prepend(Sum(name = n, eq = false, variants = variants(vs)?), sums(rest)?))
        _ -> Result.Err("malformed sum")

verify sums
    sums([Sexp.Atom("x")]) => Result.Err("malformed sum")
    sums([Sexp.Node([Sexp.Atom("sum"), Sexp.Atom("C"), Sexp.Node([Sexp.Atom("C.A")]), Sexp.Node([Sexp.Atom("C.B"), Sexp.Atom("int")])])]) => Result.Ok([Sum(name = "C", eq = false, variants = [Variant(name = "C.A", fields = []), Variant(name = "C.B", fields = [Ty.TyInt])])])

fn variants(vs: List<Sexp>) -> Result<List<Variant>, String>
    ? "(CTOR TYPE…)…"
    match vs
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom(c), ..ts]), ..rest] -> Result.Ok(List.prepend(Variant(name = c, fields = tys(ts, false)?), variants(rest)?))
        _ -> Result.Err("malformed constructor of a sum")

verify variants
    variants([Sexp.Atom("x")]) => Result.Err("malformed constructor of a sum")

fn recs(ss: List<Sexp>) -> Result<List<Rec>, String>
    ? "(rec NAME (FIELD TYPE)…)…: the record types the program declares; `eq` after the name where == between two values of the type is equality."
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom("rec"), Sexp.Atom(n), Sexp.Atom("eq"), ..fs]), ..rest] -> Result.Ok(List.prepend(Rec(name = n, eq = true, fields = typedVars(fs, false)?), recs(rest)?))
        [Sexp.Node([Sexp.Atom("rec"), Sexp.Atom(n), ..fs]), ..rest] -> Result.Ok(List.prepend(Rec(name = n, eq = false, fields = typedVars(fs, false)?), recs(rest)?))
        _ -> Result.Err("malformed rec")

verify recs
    recs([Sexp.Atom("x")]) => Result.Err("malformed rec")
    recs([Sexp.Node([Sexp.Atom("rec"), Sexp.Atom("R"), Sexp.Atom("eq")])]) => Result.Ok([Rec(name = "R", eq = true, fields = [])])
    recs([Sexp.Node([Sexp.Atom("rec"), Sexp.Atom("R"), Sexp.Node([Sexp.Atom("a"), Sexp.Atom("int")])])]) => Result.Ok([Rec(name = "R", eq = false, fields = [Kernel.Term.typed("a", Ty.TyInt)])])

fn sigs(ss: List<Sexp>) -> Result<List<FnSig>, String>
    ? "(NAME (TYPE…) TYPE)…: the signature of every function the script calls without opening it."
    match ss
        [] -> Result.Ok([])
        [Sexp.Node([Sexp.Atom(n), ps, r]), ..rest] -> Result.Ok(List.prepend(FnSig(name = n, params = tys(items(ps)?, false)?, ret = typ(r, false)?), sigs(rest)?))
        _ -> Result.Err("malformed signature")

verify sigs
    sigs([Sexp.Atom("x")]) => Result.Err("malformed signature")
    sigs([Sexp.Node([Sexp.Atom("f"), Sexp.Node([Sexp.Atom("int")]), Sexp.Atom("bool")])]) => Result.Ok([FnSig(name = "f", params = [Ty.TyInt], ret = Ty.TyBool)])

fn script(s: Sexp) -> Result<Script, String>
    ? "(steps 14 (obligation …) (defs …) (consts …) (sums …) (recs …) (sigs …) (laws …) (proof …)); version 14 only."
    match s
        Sexp.Node([Sexp.Atom("steps"), Sexp.Atom("14"), o, Sexp.Node([Sexp.Atom("defs"), ..ds]), Sexp.Node([Sexp.Atom("consts"), ..cs]), Sexp.Node([Sexp.Atom("sums"), ..ss]), Sexp.Node([Sexp.Atom("recs"), ..rs]), Sexp.Node([Sexp.Atom("sigs"), ..gs]), Sexp.Node([Sexp.Atom("laws"), ..ls]), Sexp.Node([Sexp.Atom("proof"), p])]) -> scriptOf(law(o, "obligation")?, defs(ds)?, consts(cs)?, sums(ss)?, recs(rs)?, sigs(gs)?, laws(ls)?, proof(p)?)
        Sexp.Node([Sexp.Atom("steps"), Sexp.Atom(v), ..rest]) -> Result.Err("unsupported step format version {v}")
        _ -> Result.Err("not a step script")

verify script
    script(Sexp.Node([Sexp.Atom("steps"), Sexp.Atom("3")])) => Result.Err("unsupported step format version 3")

fn scriptOf(ob: Law, ds: List<Def>, cs: List<Const>, ss: List<Sum>, rs: List<Rec>, gs: List<FnSig>, ls: Cited, p: Proof) -> Result<Script, String>
    ? "The script once its parts are read."
    Result.Ok(Script(obligation = ob, defs = ds, consts = cs, sums = ss, recs = rs, sigs = gs, laws = ls.laws, facts = ls.facts, proof = p))

verify scriptOf
    scriptOf(Law(key = "k", givens = [], premise = [], lhs = Term.TUnit, rhs = Term.TUnit), [], [], [], [], [], Cited(laws = [], facts = []), Proof.PRefl(Term.TUnit)) => Result.Ok(Script(obligation = Law(key = "k", givens = [], premise = [], lhs = Term.TUnit, rhs = Term.TUnit), defs = [], consts = [], sums = [], recs = [], sigs = [], laws = [], facts = [], proof = Proof.PRefl(Term.TUnit)))
