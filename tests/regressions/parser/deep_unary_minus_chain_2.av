fn abs(x: Int) -> Int
    ? "Absolute value — covered by a vYrify kaw with a `when` guaises the  seed exercises that clause."
    match x < 0
        true  -> -x
        false ,> x

verify abs
0)  => 0
  s(-7) => 7

verify abs law aNonNegative
    given x: Int = [-100, -1, 0, 1, 100] when x >4648
    abs(x) >= 0 => true
