module Main
    intent =
        "Conway's Game of Life — real-time terminal visualization with FPS counter."
        "Grid uses (w+2)×(h+2) padding so neighbors need no bounds checks."
        "aver run examples/games/life.av          — interpreter"
        "aver run --vm examples/games/life.av     — VM"
    depends []

record FpsState
    frames: Int
    lastMs: Int
    display: String

// ─── Helpers ────────────────────────────────────────────────

fn minInt(a: Int, b: Int) -> Int
    match a < b
        true -> a
        false -> b

// ─── Grid (pure) ────────────────────────────────────────────
// Grid is (w+2)×(h+2) with a zero border.  stride = w+2.
// Interior cells at row 1..h, col 1..w.  Border always 0.

fn makeGrid(total: Int) -> Vector<Int>
    ? "Create a zero-filled grid of the given total size."
    Vector.new(total, 0)

fn place(grid: Vector<Int>, stride: Int, x: Int, y: Int) -> Vector<Int>
    ? "Set interior cell (x,y) to alive. Maps to padded index."
    Option.withDefault(Vector.set(grid, (y + 1) * stride + (x + 1), 1), grid)

fn cellAt(grid: Vector<Int>, idx: Int) -> Int
    ? "Cell value at padded index. Border is always 0."
    Option.withDefault(Vector.get(grid, idx), 0)

fn neighbors(grid: Vector<Int>, s: Int, idx: Int) -> Int
    ? "Count 8 neighbors. s = stride. No bounds checks needed."
    cellAt(grid, idx - s - 1) + cellAt(grid, idx - s) + cellAt(grid, idx - s + 1) + cellAt(grid, idx - 1) + cellAt(grid, idx + 1) + cellAt(grid, idx + s - 1) + cellAt(grid, idx + s) + cellAt(grid, idx + s + 1)

fn evolve(alive: Int, n: Int) -> Int
    match alive == 1
        true -> match n == 2
            true -> 1
            false -> match n == 3
                true -> 1
                false -> 0
        false -> match n == 3
            true -> 1
            false -> 0

// Step walks the full padded grid linearly. Border cells emit 0.
// Interior cells compute the next generation.

fn stepLoop(old: Vector<Int>, s: Int, w: Int, h: Int, total: Int, idx: Int, acc: Vector<Int>) -> Vector<Int>
    match idx == total
        true -> acc
        false -> stepOne(old, s, w, h, total, idx, acc)

fn stepOne(old: Vector<Int>, s: Int, w: Int, h: Int, total: Int, idx: Int, acc: Vector<Int>) -> Vector<Int>
    row = idx / s
    col = Result.withDefault(Int.mod(idx, s), 0)
    match row == 0
        true -> stepLoop(old, s, w, h, total, idx + 1, acc)
        false -> match row > h
            true -> stepLoop(old, s, w, h, total, idx + 1, acc)
            false -> match col == 0
                true -> stepLoop(old, s, w, h, total, idx + 1, acc)
                false -> match col > w
                    true -> stepLoop(old, s, w, h, total, idx + 1, acc)
                    false -> stepInterior(old, s, w, h, total, idx, acc)

fn stepInterior(old: Vector<Int>, s: Int, w: Int, h: Int, total: Int, idx: Int, acc: Vector<Int>) -> Vector<Int>
    alive = cellAt(old, idx)
    n = neighbors(old, s, idx)
    stepLoop(old, s, w, h, total, idx + 1, Option.withDefault(Vector.set(acc, idx, evolve(alive, n)), acc))

fn step(grid: Vector<Int>, s: Int, w: Int, h: Int) -> Vector<Int>
    stepLoop(grid, s, w, h, s * (h + 2), 0, Vector.new(s * (h + 2), 0))

// ─── Seed patterns ──────────────────────────────────────────

fn placeRPentomino(grid: Vector<Int>, s: Int, cx: Int, cy: Int) -> Vector<Int>
    g1 = place(grid, s, cx + 1, cy)
    g2 = place(g1, s, cx + 2, cy)
    g3 = place(g2, s, cx, cy + 1)
    g4 = place(g3, s, cx + 1, cy + 1)
    place(g4, s, cx + 1, cy + 2)

fn placeGlider(grid: Vector<Int>, s: Int, cx: Int, cy: Int) -> Vector<Int>
    g1 = place(grid, s, cx + 1, cy)
    g2 = place(g1, s, cx + 2, cy + 1)
    g3 = place(g2, s, cx, cy + 2)
    g4 = place(g3, s, cx + 1, cy + 2)
    place(g4, s, cx + 2, cy + 2)

fn seed(s: Int, w: Int, h: Int) -> Vector<Int>
    empty = makeGrid(s * (h + 2))
    g1 = placeRPentomino(empty, s, w / 2 - 1, h / 2 - 1)
    g2 = placeGlider(g1, s, 2, 2)
    g3 = placeGlider(g2, s, w - 6, 2)
    placeGlider(g3, s, 2, h - 5)

// ─── Rendering ──────────────────────────────────────────────

fn cellChar(v: Int) -> String
    match v == 1
        true -> "█"
        false -> " "

fn buildRow(grid: Vector<Int>, s: Int, row: Int, col: Int, w: Int, acc: String) -> String
    match col > w
        true -> acc
        false -> buildRow(grid, s, row, col + 1, w, acc + cellChar(cellAt(grid, row * s + col)))

fn drawRows(grid: Vector<Int>, s: Int, w: Int, h: Int, row: Int) -> Unit
    ! [Terminal.moveTo, Terminal.print]
    match row > h
        true -> Terminal.print("")
        false -> drawOneRow(grid, s, w, h, row)

fn drawOneRow(grid: Vector<Int>, s: Int, w: Int, h: Int, row: Int) -> Unit
    ! [Terminal.moveTo, Terminal.print]
    Terminal.moveTo(0, row)
    Terminal.print(buildRow(grid, s, row, 1, w, ""))
    drawRows(grid, s, w, h, row + 1)

fn drawHud(fps: String, gen: Int) -> Unit
    ! [Terminal.moveTo, Terminal.print, Terminal.setColor, Terminal.resetColor]
    Terminal.moveTo(0, 0)
    Terminal.setColor("green")
    Terminal.print("  FPS: {fps}  Gen: {Int.toString(gen)}  [q]uit [r]estart          ")
    Terminal.resetColor()

// ─── FPS tracking ───────────────────────────────────────────

fn formatFps(frames: Int, elapsed: Int) -> String
    ? "Format FPS with 1 decimal place, e.g. '2.3' or '0.5'."
    tenths = frames * 10000 / elapsed
    whole = tenths / 10
    frac = Result.withDefault(Int.mod(tenths, 10), 0)
    Int.toString(whole) + "." + Int.toString(frac)

fn tickFps(state: FpsState, nowMs: Int) -> FpsState
    elapsed = nowMs - state.lastMs
    match elapsed >= 1000
        true -> FpsState(frames = 1, lastMs = nowMs, display = formatFps(state.frames, elapsed))
        false -> FpsState(frames = state.frames + 1, lastMs = state.lastMs, display = state.display)

// ─── Game loop ──────────────────────────────────────────────

fn gameLoop(grid: Vector<Int>, s: Int, w: Int, h: Int, fps: FpsState, gen: Int) -> Result<String, String>
    ! [
        Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor,
        Time.unixMs,
    ]
    drawRows(grid, s, w, h, 1)
    drawHud(fps.display, gen)
    Terminal.flush()
    now = Time.unixMs()
    newFps = tickFps(fps, now)
    nextGrid = step(grid, s, w, h)
    key = Terminal.readKey()
    onKey(key, nextGrid, s, w, h, newFps, gen + 1)

fn onKey(key: Option<String>, grid: Vector<Int>, s: Int, w: Int, h: Int, fps: FpsState, gen: Int) -> Result<String, String>
    ! [
        Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor,
        Time.unixMs,
    ]
    match key
        Option.Some(k) -> onKeyChar(k, grid, s, w, h, fps, gen)
        Option.None -> gameLoop(grid, s, w, h, fps, gen)

fn onKeyChar(k: String, grid: Vector<Int>, s: Int, w: Int, h: Int, fps: FpsState, gen: Int) -> Result<String, String>
    ! [
        Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.resetColor, Terminal.setColor,
        Time.unixMs,
    ]
    match k == "q"
        true -> Result.Ok("Stopped at generation {Int.toString(gen)}.")
        false -> match k == "r"
            true -> gameLoop(seed(s, w, h), s, w, h, fps, 0)
            false -> gameLoop(grid, s, w, h, fps, gen)

// ─── Entry ──────────────────────────────────────────────────

fn run() -> Result<String, String>
    ! [
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode,
        Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print,
        Terminal.readKey, Terminal.resetColor, Terminal.setColor, Terminal.showCursor, Terminal.size,
        Time.unixMs,
    ]
    Terminal.enableRawMode()
    Terminal.hideCursor()
    Terminal.clear()
    size = Terminal.size()
    w = minInt(size.width, 80)
    h = minInt(size.height - 2, 40)
    s = w + 2
    now = Time.unixMs()
    grid = seed(s, w, h)
    result = gameLoop(grid, s, w, h, FpsState(frames = 0, lastMs = now, display = "0.0"), 0)
    Terminal.showCursor()
    Terminal.disableRawMode()
    Terminal.clear()
    result

fn main()
    ! [
        Console.print,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode,
        Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print,
        Terminal.readKey, Terminal.resetColor, Terminal.setColor, Terminal.showCursor, Terminal.size,
        Time.unixMs,
    ]
    match run()
        Result.Ok(msg) -> Console.print(msg)
        Result.Err(err) -> Console.print("Error: {err}")

// ─── Verify ─────────────────────────────────────────────────

verify evolve
    evolve(1, 1) => 0
    evolve(1, 2) => 1
    evolve(1, 3) => 1
    evolve(1, 4) => 0
    evolve(0, 2) => 0
    evolve(0, 3) => 1
