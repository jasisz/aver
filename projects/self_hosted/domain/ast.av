module Ast
    intent =
        "AST node types for the mini Aver interpreter."
        "Covers: literals, binops, comparisons, variables, bindings, function defs/calls, match."
    exposes [Expr, MatchArm, Pattern, Stmt, FnDef, Program]

type Expr
    ExprInt(Int)
    ExprFloat(Float)
    ExprStr(String)
    ExprBool(Bool)
    ExprVar(String)
    ExprSlot(Int)
    ExprAdd(Expr, Expr)
    ExprSub(Expr, Expr)
    ExprMul(Expr, Expr)
    ExprDiv(Expr, Expr)
    ExprEq(Expr, Expr)
    ExprNeq(Expr, Expr)
    ExprLt(Expr, Expr)
    ExprGt(Expr, Expr)
    ExprLte(Expr, Expr)
    ExprGte(Expr, Expr)
    ExprConcat(List<Expr>)
    ExprTuple(List<Expr>)
    ExprList(List<Expr>)
    ExprRecord(String, List<(String, Expr)>)
    ExprFieldAccess(Expr, String)
    ExprCall(String, List<Expr>)
    ExprCallDirect(FnDef, List<Expr>)
    ExprCallBuiltin(String, List<Expr>)
    ExprMatch(Expr, List<MatchArm>)
    ExprPropagate(Expr)

record MatchArm
    pattern: Pattern
    body: Expr

type Pattern
    PatInt(Int)
    PatFloat(Float)
    PatBool(Bool)
    PatStr(String)
    PatEmpty
    PatCons(String, String)
    PatConstructor(String, List<String>)
    PatTuple(List<Pattern>)
    PatWild
    PatVar(String)

type Stmt
    StmtBind(String, Expr)
    StmtBindSlot(Int, Expr)
    StmtExpr(Expr)

record FnDef
    name: String
    params: List<String>
    body: List<Stmt>
    slotCount: Int
    slotMap: Map<String, Int>

record Program
    deps: List<String>
    fns: List<FnDef>
    stmts: List<Stmt>
