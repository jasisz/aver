module Prop86
    intent =
        "TIP isaplanner prop_86: if x < y then elem x (ins y xs) = elem x xs."
    effects []

type Nat
    Z
    S(Nat)

fn eqNat(x: Nat, y: Nat) -> Bool
    match x
        Nat.Z -> match y
            Nat.Z -> true
            Nat.S(z) -> false
        Nat.S(x2) -> match y
            Nat.Z -> false
            Nat.S(y2) -> eqNat(x2, y2)

fn lt(x: Nat, y: Nat) -> Bool
    match y
        Nat.Z -> false
        Nat.S(z) -> match x
            Nat.Z -> true
            Nat.S(x2) -> lt(x2, z)

fn elem(x: Nat, y: List<Nat>) -> Bool
    match y
        [] -> false
        [z, ..xs] -> match eqNat(x, z)
            true -> true
            false -> elem(x, xs)

fn ins(x: Nat, y: List<Nat>) -> List<Nat>
    match y
        [] -> [x]
        [z, ..xs] -> match lt(x, z)
            true -> List.concat([x], y)
            false -> List.concat([z], ins(x, xs))

fn eqBool(a: Bool, b: Bool) -> Bool
    match a
        true -> b
        false -> match b
            true -> false
            false -> true

fn goal(x: Nat, y: Nat, xs: List<Nat>) -> Bool
    match lt(x, y)
        true -> eqBool(elem(x, ins(y, xs)), elem(x, xs))
        false -> true

verify goal law insElemBelow
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.Z]
    given y: Nat = [Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z)), Nat.S(Nat.Z)]
    given xs: List<Nat> = [[], [Nat.S(Nat.Z)], [Nat.Z, Nat.S(Nat.S(Nat.Z))]]
    goal(x, y, xs) => true
