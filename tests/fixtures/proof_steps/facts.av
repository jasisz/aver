module Facts
    intent = "Laws over concrete lists that cite builtin facts in `using`."
    exposes [Tx, joined, batch, reversed]
    effects []

record Tx
    id: Int
    amount: Int

fn joined(xs: List<Int>, ys: List<Int>) -> List<Int>
    ? "Both lists, one after the other."
    List.concat(xs, ys)

verify joined
    joined([1], [2]) => [1, 2]

verify joined law lengthAdds
    given xs: List<Int> = [[], [1], [1, 2]]
    given ys: List<Int> = [[], [3]]
    using [List.len.ofConcat]
    List.len(joined(xs, ys)) => List.len(xs) + List.len(ys)

verify joined law regroups
    given xs: List<Int> = [[], [1]]
    given ys: List<Int> = [[], [2]]
    given zs: List<Int> = [[], [3]]
    using [List.concat.assoc]
    joined(joined(xs, ys), zs) => joined(xs, joined(ys, zs))

fn batch(a: List<Tx>, b: List<Tx>) -> List<Tx>
    ? "Two batches of transactions as one."
    List.concat(a, b)

verify batch
    batch([], [Tx(id = 1, amount = 5)]) => [Tx(id = 1, amount = 5)]

verify batch law sizeAdds
    given a: List<Tx> = [[], [Tx(id = 1, amount = 5)]]
    given b: List<Tx> = [[], [Tx(id = 2, amount = 7)]]
    using [List.len.ofConcat]
    List.len(batch(a, b)) => List.len(a) + List.len(b)

verify batch law threeBatches
    given a: List<Tx> = [[], [Tx(id = 1, amount = 5)]]
    given b: List<Tx> = [[], [Tx(id = 2, amount = 7)]]
    given c: List<Tx> = [[], [Tx(id = 3, amount = 9)]]
    using [List.concat.assoc]
    batch(batch(a, b), c) => batch(a, batch(b, c))

verify joined law emptyOnTheRight
    given xs: List<Int> = [[], [1, 2]]
    using [List.concat.rightIdentity]
    joined(xs, []) => xs

verify joined law takesTheFront
    given xs: List<Int> = [[], [1], [1, 1]]
    given ys: List<Int> = [[], [2]]
    using [List.take.ofConcat]
    List.take(joined(xs, ys), List.len(xs)) => xs

verify joined law dropsTheFront
    given xs: List<Int> = [[], [1], [1, 1]]
    given ys: List<Int> = [[], [2]]
    using [List.drop.ofConcat]
    List.drop(joined(xs, ys), List.len(xs)) => ys

fn reversed(xs: List<Int>) -> List<Int>
    ? "The list backwards."
    List.reverse(xs)

verify reversed
    reversed([1, 2]) => [2, 1]

verify reversed law keepsTheLength
    given xs: List<Int> = [[], [1, 2, 2]]
    using [List.len.ofReverse]
    List.len(reversed(xs)) => List.len(xs)

verify reversed law ofJoined
    given xs: List<Int> = [[], [1, 2]]
    given ys: List<Int> = [[], [3]]
    using [List.reverse.ofConcat]
    reversed(joined(xs, ys)) => joined(reversed(ys), reversed(xs))

verify reversed law twiceIsTheSame
    given xs: List<Int> = [[], [1, 2, 3]]
    using [List.reverse.involutive]
    reversed(reversed(xs)) => xs

verify reversed law lengthIsNeverNegative
    given xs: List<Int> = [[], [1]]
    using [List.len.nonneg]
    List.len(reversed(xs)) >= 0 => true

verify joined law splitsAnywhere
    given xs: List<Int> = [[], [1], [1, 2, 3]]
    given n: Int = [-1, 0, 2, 5]
    using [List.concat.takeDrop]
    joined(List.take(xs, n), List.drop(xs, n)) => xs

verify joined law takesNothingBelowOne
    given xs: List<Int> = [[], [1, 2]]
    given n: Int = [-3, 0]
    when n <= 0
    using [List.take.nonPositive]
    List.take(joined(xs, xs), n) => []

verify joined law dropsNothingBelowOne
    given xs: List<Int> = [[], [1, 2]]
    given n: Int = [-3, 0]
    when n <= 0
    using [List.drop.nonPositive]
    List.drop(joined(xs, xs), n) => joined(xs, xs)

verify joined law droppingShortens
    given xs: List<Int> = [[], [1, 2]]
    given n: Int = [-1, 1, 4]
    using [List.len.ofDropAtMost]
    List.len(List.drop(joined(xs, xs), n)) <= List.len(joined(xs, xs)) => true
