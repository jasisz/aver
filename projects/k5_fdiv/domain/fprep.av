module Fprep
    intent =
        "Stage 1 of the K5 division proof: the paper's FAITHFUL floating-point model"
        "(Section 5.1, p.10). Every non-zero rational is sigma * s * 2^e with the sign"
        "sigma either +1 or -1, a NORMALIZED rational significand s in [1, 2), and an"
        "integer exponent e (p.10). We represent s as an n-bit integer `sigBits` in"
        "[2^(n-1), 2^n) -- so the rational significand is sigBits / 2^(n-1) in [1, 2) --"
        "carrying the width n as a field, and the denoted value sigma * (sigBits/2^(n-1))"
        "* 2^e as the Stage-0 exact rational (domain/rational.av Fraction)."
        "The landed laws are Lemma 7.1.2 (p.18): scaling by a power of two leaves the"
        "significand unchanged and shifts the exponent -- s(x*2^j) = s_x, e(x*2^j) = e_x"
        "+ j -- which hold DEFINITIONALLY here because fpScale renormalizes nothing; and"
        "Lemma 7.1.7 (p.18): e_x + e_y <= e(x*y) <= e_x + e_y + 1, the product-exponent"
        "range, proven by splitting fpMul's normalization match (grind case-splits the"
        "branch) and bounding each arm. The scaling value-preservation fact (scaling"
        "denotes the scaled rational) is floating-point folklore, NOT a numbered paper"
        "lemma; it is the project's laws-as-lemmas composition in action -- it re-proves"
        "nothing about powers of two, it CITES the proven homomorphism pow2(m+n) =="
        "pow2(m)*pow2(n) and the compiler composes it via one generic strategy."
    depends [Domain.Rational]
    exposes [pow2, Fp, isFp, fpValue, fpScale, fpMul, pow2Fraction, fpScaleKeepsSignificand, fpScaleShiftsExponent, fpScalePreservesValue, productExp, productExpInRange, fpMulValue]
    effects []

fn pow2(n: Int) -> Int
    ? "Two to the n for n >= 0 (and 1 for n <= 0): the scale factor 2^n of an exponent."
    match n <= 0
        true -> 1
        false -> 2 * pow2(n - 1)

verify pow2
    pow2(0) => 1
    pow2(3) => 8
    pow2(7) => 128

// The power-of-two homomorphism: adding exponents multiplies scales. This is the
// pool law the value-preservation proofs below CITE; it proves on its own first.
verify pow2 law homomorphism
    given m: Int = [0, 1, 4]
    given n: Int = [0, 2, 3]
    when m >= 0
    when n >= 0
    pow2(m + n) => pow2(m) * pow2(n)

// A float in the paper's representation (Section 5.1, p.10): a sign in {+1,-1}, a
// normalized n-bit significand integer, an integer exponent, and the width n. The
// rational significand is sigBits / 2^(width-1), normalized into [1, 2).
record Fp
    sign: Int
    sigBits: Int
    exp: Int
    width: Int

fn isFp(f: Fp) -> Bool
    ? "The format/normalization predicate (p.10-11): sign +1 or -1 and the significand integer normalized into [2^(width-1), 2^width), i.e. the rational significand in [1, 2)."
    Bool.and(Bool.or(f.sign == 1, f.sign == -1), Bool.and(pow2(f.width - 1) <= f.sigBits, f.sigBits < pow2(f.width)))

verify isFp
    isFp(Fp(sign = 1, sigBits = 8, exp = 0, width = 4)) => true
    isFp(Fp(sign = -1, sigBits = 15, exp = 3, width = 4)) => true
    isFp(Fp(sign = 1, sigBits = 16, exp = 0, width = 4)) => false
    isFp(Fp(sign = 1, sigBits = 7, exp = 0, width = 4)) => false
    isFp(Fp(sign = 2, sigBits = 8, exp = 0, width = 4)) => false

fn fpValue(f: Fp) -> Fraction
    ? "The denoted value as an exact rational (for exp >= 0): sign * sigBits * 2^exp over 2^(width-1) = sign * (sigBits/2^(width-1)) * 2^exp."
    Domain.Rational.Fraction(top = f.sign * f.sigBits * pow2(f.exp), bottom = pow2(f.width - 1))

verify fpValue
    fpValue(Fp(sign = 1, sigBits = 8, exp = 0, width = 4)) => Domain.Rational.Fraction(top = 8, bottom = 8)
    fpValue(Fp(sign = 1, sigBits = 12, exp = 1, width = 4)) => Domain.Rational.Fraction(top = 24, bottom = 8)
    fpValue(Fp(sign = -1, sigBits = 10, exp = 2, width = 4)) => Domain.Rational.Fraction(top = -40, bottom = 8)

fn pow2Fraction(j: Int) -> Fraction
    ? "The rational 2^j (for j >= 0) as the fraction 2^j / 1 -- the scale factor of Lemma 7.1.2."
    Domain.Rational.Fraction(top = pow2(j), bottom = 1)

fn fpScale(f: Fp, j: Int) -> Fp
    ? "Scale by 2^j (Lemma 7.1.2, p.18): shift the exponent by j, renormalizing NOTHING -- sign, significand and width are untouched."
    Fp(sign = f.sign, sigBits = f.sigBits, exp = f.exp + j, width = f.width)

verify fpScale
    fpScale(Fp(sign = 1, sigBits = 8, exp = 0, width = 4), 3) => Fp(sign = 1, sigBits = 8, exp = 3, width = 4)
    fpScale(Fp(sign = -1, sigBits = 10, exp = 2, width = 4), -5) => Fp(sign = -1, sigBits = 10, exp = -3, width = 4)

fn fpScaleKeepsSignificand(f: Fp, j: Int) -> Bool
    ? "Lemma 7.1.2 (p.18), significand half: s(x*2^j) = s_x."
    fpScale(f, j).sigBits == f.sigBits

verify fpScaleKeepsSignificand
    fpScaleKeepsSignificand(Fp(sign = 1, sigBits = 8, exp = 0, width = 4), 3) => true

// Lemma 7.1.2 (p.18): "If j is an integer, s(x*2^j) = s_x." The significand is
// invariant under scaling -- here definitional, because fpScale touches only exp.
verify fpScaleKeepsSignificand law significandInvariant
    given f: Fp = [Fp(sign = 1, sigBits = 8, exp = 0, width = 4), Fp(sign = -1, sigBits = 12, exp = 2, width = 4)]
    given j: Int = [-5, 0, 3]
    fpScaleKeepsSignificand(f, j) holds

fn fpScaleShiftsExponent(f: Fp, j: Int) -> Bool
    ? "Lemma 7.1.2 (p.18), exponent half: e(x*2^j) = e_x + j."
    fpScale(f, j).exp == f.exp + j

verify fpScaleShiftsExponent
    fpScaleShiftsExponent(Fp(sign = 1, sigBits = 8, exp = 0, width = 4), 3) => true

// Lemma 7.1.2 (p.18): "If j is an integer, e(x*2^j) = e_x + j." The exponent shifts
// by exactly j under scaling -- here definitional.
verify fpScaleShiftsExponent law exponentShift
    given f: Fp = [Fp(sign = 1, sigBits = 8, exp = 0, width = 4), Fp(sign = -1, sigBits = 12, exp = 2, width = 4)]
    given j: Int = [-5, 0, 3]
    fpScaleShiftsExponent(f, j) holds

fn fpScalePreservesValue(f: Fp, j: Int) -> Bool
    ? "Folklore corollary of Lemma 7.1.2: scaling multiplies the denoted value by 2^j."
    Domain.Rational.sameValue(fpValue(fpScale(f, j)), Domain.Rational.times(fpValue(f), pow2Fraction(j)))

verify fpScalePreservesValue
    fpScalePreservesValue(Fp(sign = 1, sigBits = 8, exp = 0, width = 4), 3) => true

// Floating-point folklore (the value form of Lemma 7.1.2, p.18): scaling by 2^j
// multiplies the denoted rational by 2^j. NOT a numbered paper lemma -- it is the
// laws-as-lemmas composition: cross-multiplied it asks pow2(exp+j) = pow2(exp)*
// pow2(j), so it CITES the pow2 homomorphism above; the engine adds only the
// citation skeleton, the algebra lives entirely as the cited Aver law.
verify fpScalePreservesValue law scalesByPowerOfTwo
    given f: Fp = [Fp(sign = 1, sigBits = 8, exp = 1, width = 4), Fp(sign = -1, sigBits = 12, exp = 0, width = 4)]
    given j: Int = [0, 2, 3]
    when f.exp >= 0
    when j >= 0
    fpScalePreservesValue(f, j) holds

fn fpMul(a: Fp, b: Fp) -> Fp
    ? "Multiply floats (p.18 structure): multiply significands, add exponents, then NORMALIZE the rational significand s_a*s_b in [1,4) back into [1,2) by shifting the exponent 0 or 1 (Lemma 7.1.7) -- value-preserving, never rounding, so the product is exact in width_a+width_b bits (Lemma 7.2.12)."
    match a.sigBits * b.sigBits < pow2(a.width + b.width - 1)
        true -> Fp(sign = a.sign * b.sign, sigBits = a.sigBits * b.sigBits, exp = a.exp + b.exp, width = a.width + b.width - 1)
        false -> Fp(sign = a.sign * b.sign, sigBits = a.sigBits * b.sigBits, exp = a.exp + b.exp + 1, width = a.width + b.width)

verify fpMul
    fpMul(Fp(sign = 1, sigBits = 8, exp = 0, width = 4), Fp(sign = 1, sigBits = 12, exp = 1, width = 4)) => Fp(sign = 1, sigBits = 96, exp = 1, width = 7)
    fpMul(Fp(sign = 1, sigBits = 12, exp = 0, width = 4), Fp(sign = 1, sigBits = 12, exp = 0, width = 4)) => Fp(sign = 1, sigBits = 144, exp = 1, width = 8)

fn productExp(a: Fp, b: Fp) -> Int
    ? "The exponent of the product float e(x*y) -- either e_a+e_b or e_a+e_b+1 depending on whether the significand product overflows [1,2)."
    fpMul(a, b).exp

fn productExpInRange(a: Fp, b: Fp) -> Bool
    ? "Lemma 7.1.7 (p.18): the product exponent lies in [e_a + e_b, e_a + e_b + 1]."
    Bool.and(a.exp + b.exp <= productExp(a, b), productExp(a, b) <= a.exp + b.exp + 1)

verify productExpInRange
    productExpInRange(Fp(sign = 1, sigBits = 8, exp = 0, width = 4), Fp(sign = 1, sigBits = 12, exp = 1, width = 4)) => true
    productExpInRange(Fp(sign = 1, sigBits = 12, exp = 0, width = 4), Fp(sign = 1, sigBits = 12, exp = 0, width = 4)) => true

// Lemma 7.1.7 (p.18): "If x != 0 and y != 0 then e_x + e_y <= e(x*y) <= e_x +
// e_y + 1." The product exponent is e_a + e_b plus the normalization shift of 0
// or 1, so it lands in that closed range whichever branch fpMul takes. A
// nonzero float here is one with a nonzero significand (a zero significand is
// the only way the denoted rational vanishes), matching the paper's x != 0.
verify productExpInRange law productExponentBounds
    given a: Fp = [Fp(sign = 1, sigBits = 8, exp = 0, width = 4), Fp(sign = -1, sigBits = 12, exp = 2, width = 4)]
    given b: Fp = [Fp(sign = 1, sigBits = 12, exp = 1, width = 4), Fp(sign = 1, sigBits = 11, exp = 0, width = 4)]
    when a.sigBits != 0
    when b.sigBits != 0
    productExpInRange(a, b) holds

fn fpMulValue(a: Fp, b: Fp) -> Bool
    ? "Multiplication denotes the product of the denoted values (folklore)."
    Domain.Rational.sameValue(fpValue(fpMul(a, b)), Domain.Rational.times(fpValue(a), fpValue(b)))

verify fpMulValue
    fpMulValue(Fp(sign = 1, sigBits = 8, exp = 0, width = 4), Fp(sign = 1, sigBits = 12, exp = 1, width = 4)) => true
    fpMulValue(Fp(sign = 1, sigBits = 12, exp = 0, width = 4), Fp(sign = 1, sigBits = 12, exp = 0, width = 4)) => true
    fpMulValue(Fp(sign = -1, sigBits = 10, exp = 2, width = 4), Fp(sign = 1, sigBits = 11, exp = 1, width = 4)) => true

// Floating-point folklore (the denotation of multiplication): the product float
// denotes the product of the values. NOT a numbered paper lemma -- labelled folklore,
// the denotation of multiplication. Universal on the Lean kernel. It is the project's
// laws-as-lemmas composition at its sharpest: it re-proves nothing about powers of two,
// it CITES the proven homomorphism pow2(m+n) == pow2(m)*pow2(n). The composition needs
// the homomorphism at a REARRANGED exponent -- the product denominator
// pow2(width_a + width_b - 2) is pow2(width_a - 1) * pow2(width_b - 1), the homomorphism
// at (width_a - 1) + (width_b - 1), and the normalization branch shifts the width/exp by
// one, asking pow2 of an odd offset too. grind's default match keys on the homomorphism's
// LHS pow2(m+n) and never splits a subtraction. The engine closes it with one GENERIC
// mechanism: a pow2-of-nonneg-linear-form normalizer that registers the homomorphism on
// its PRODUCT side and a successor step, so grind canonicalizes pow2 of any nonneg linear
// form into a product of pow2 of atoms (shape-keyed on the power-of-two fn, never a
// per-figure template). Whichever branch fpMul takes, the two sides cross-multiply equal.
verify fpMulValue law denotesProduct
    given a: Fp = [Fp(sign = 1, sigBits = 8, exp = 0, width = 4), Fp(sign = -1, sigBits = 10, exp = 2, width = 4)]
    given b: Fp = [Fp(sign = 1, sigBits = 12, exp = 1, width = 4), Fp(sign = 1, sigBits = 11, exp = 0, width = 4)]
    when a.exp >= 0
    when b.exp >= 0
    when a.width >= 1
    when b.width >= 1
    fpMulValue(a, b) holds
