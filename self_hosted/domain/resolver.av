module Resolver
    depends [Domain.Ast, Domain.Resolver.Core, Domain.Resolver.Calls, Domain.Resolver.Fast, Domain.Resolver.Rewrite]
    intent =
        "Compile-time variable resolution: ExprVar to ExprSlot, StmtBind to StmtBindSlot."
        "Assigns slot indices to params and local bindings inside each FnDef."
        "Globals and dotted names (builtins, constructors) are left as ExprVar."
    exposes [resolveProgram]

fn resolveProgram(prog: Program) -> Program
    ? "Resolve all functions: slots, direct calls, then attach narrow fast-path tags."
    resolvedFns = Domain.Resolver.Core.resolveFns(prog.fns, [])
    fnMap = Domain.Resolver.Calls.buildFnMap(resolvedFns, Map.empty(), 0)
    calledFns = Domain.Resolver.Calls.resolveCallsInFns(resolvedFns, fnMap, [])
    annotatedFns = Domain.Resolver.Fast.annotateFastFns(calledFns, fnMap, [])
    Program(
        deps = prog.deps,
        fns = Domain.Resolver.Rewrite.rewriteInternalFns(annotatedFns, []),
        stmts = Domain.Resolver.Rewrite.rewriteInternalStmts(prog.stmts, [])
    )

verify resolveProgram
    resolveProgram(Program(deps = [], fns = [], stmts = [Stmt.StmtExpr(Expr.ExprInt(1))])) => Program(deps = [], fns = [], stmts = [Stmt.StmtExpr(Expr.ExprInt(1))])
