module Blocks
    kind = capability
    semantics = effectful
    depends [Bytes]
    intent = "Block bodies by height and the hand-over of a freshly read body."
    exposes [Receipt, DeliverReply, BodyReply, deliver, body]

type Receipt
    Accepted
    Refused(String)

type DeliverReply
    Now(Blocks.Receipt)
    Later(Wait.Wake)

operation deliver(key: Int, height: Int, block: Bytes) -> Blocks.Receipt
    ? "Hands one block body over; the peer does not wait for validation."
    oracle = generative
    replay = recorded

type BodyReply
    Now(Bytes)
    Later(Wait.Wake)

operation body(height: Int) -> Bytes
    ? "The validated body at this height."
    oracle = generative
    replay = recorded
