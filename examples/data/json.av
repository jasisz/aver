module Json
    intent =
        "RFC 8259 JSON parser. Recursive descent, pure, no effects."
        "Supports: integers, floats, strings (with \\uXXXX), bools, null, arrays, objects."
        "Validates: trailing content, leading zeros, control chars, invalid escapes."
    exposes [Json, fromString, toString]
    effects [Console]

type Json
    JsonString(String)
    JsonInt(Int)
    JsonFloat(Float)
    JsonBool(Bool)
    JsonList(List<Json>)
    JsonObject(Map<String, Json>)
    JsonNull

type ParseResult
    Ok(Json, Int)
    Err(String, Int)

// ── Public API ────────────────────────────────────────────────────

fn fromString(s: String) -> Result<Json, String>
    ? "Parse a JSON string into a Json value."
    match parseValue(s, skipWs(s, 0))
        ParseResult.Err(msg, p) -> Result.Err(msg + " at position " + String.fromInt(p))
        ParseResult.Ok(val, p) -> checkEof(s, val, skipWs(s, p))

verify fromString
    fromString("null") => Result.Ok(Json.JsonNull)
    fromString("true") => Result.Ok(Json.JsonBool(true))
    fromString("false") => Result.Ok(Json.JsonBool(false))
    fromString("42") => Result.Ok(Json.JsonInt(42))
    fromString("-7") => Result.Ok(Json.JsonInt(-7))
    fromString("0") => Result.Ok(Json.JsonInt(0))
    fromString("-0") => Result.Ok(Json.JsonInt(0))

verify fromString
    fromString("1.5") => Result.Ok(Json.JsonFloat(1.5))
    fromString("0.5") => Result.Ok(Json.JsonFloat(0.5))
    fromString("-3.14") => Result.Ok(Json.JsonFloat(-3.14))
    fromString("1e2") => Result.Ok(Json.JsonFloat(100.0))
    fromString("1E2") => Result.Ok(Json.JsonFloat(100.0))
    fromString("1e+2") => Result.Ok(Json.JsonFloat(100.0))
    fromString("1e-1") => Result.Ok(Json.JsonFloat(0.1))
    fromString("1.5e1") => Result.Ok(Json.JsonFloat(15.0))
    fromString("0e5") => Result.Ok(Json.JsonFloat(0.0))
    fromString("-2.5e3") => Result.Ok(Json.JsonFloat(-2500.0))

verify fromString
    fromString("\"hello\"") => Result.Ok(Json.JsonString("hello"))
    fromString("\"\"") => Result.Ok(Json.JsonString(""))
    fromString("\"he\\nllo\"") => Result.Ok(Json.JsonString("he\nllo"))
    fromString("\"\\u0041\"") => Result.Ok(Json.JsonString("A"))
    fromString("\"caf\\u00e9\"") => Result.Ok(Json.JsonString("café"))
    fromString("\"\\uD83D\\uDE00\"") => Result.Ok(Json.JsonString("😀"))

verify fromString
    fromString("[]") => Result.Ok(Json.JsonList([]))
    fromString("[1,2,3]") => Result.Ok(Json.JsonList([Json.JsonInt(1), Json.JsonInt(2), Json.JsonInt(3)]))
    fromString("{{}}") => Result.Ok(Json.JsonObject(emptyJsonMap()))
    fromString("{{\"a\":1}}") => Result.Ok(Json.JsonObject({"a" => Json.JsonInt(1)}))
    fromString("  {{ \"x\" : [1, 2] , \"y\" : null }}  ") => Result.Ok(Json.JsonObject({"x" => Json.JsonList([Json.JsonInt(1), Json.JsonInt(2)]), "y" => Json.JsonNull}))

verify fromString
    fromString("true false") => Result.Err("Trailing content: f at position 5")
    fromString("42oops") => Result.Err("Trailing content: o at position 2")
    fromString("-") => Result.Err("Expected digit after '-' at position 1")
    fromString("01") => Result.Err("Leading zeros not allowed at position 1")
    fromString("-01") => Result.Err("Leading zeros not allowed at position 2")
    fromString("1.") => Result.Err("Expected digit after '.' at position 2")
    fromString("1e") => Result.Err("Expected digit in exponent at position 2")
    fromString("1e+") => Result.Err("Expected digit in exponent at position 3")
    fromString("\"\\uXXXX\"") => Result.Err("Invalid \\u escape at position 3")
    fromString("\"\\uD800\"") => Result.Err("Invalid Unicode surrogate pair at position 3")
    fromString("\"\t\"") => Result.Err("Unescaped control character at position 1")

fn checkEof(s: String, val: Json, pos: Int) -> Result<Json, String>
    ? "JSON helper: checkEof."
    match String.charAt(s, pos)
        Option.None -> Result.Ok(val)
        Option.Some(c) -> Result.Err("Trailing content: " + c + " at position " + String.fromInt(pos))

verify checkEof
    checkEof("abc", Json.JsonInt(1), 3) => Result.Ok(Json.JsonInt(1))
    checkEof("abc", Json.JsonInt(1), 1) => Result.Err("Trailing content: b at position 1")

fn toString(j: Json) -> String
    ? "Serialize Json into compact JSON."
    match j
        Json.JsonString(s) -> "\"" + escapeJsonString(s) + "\""
        Json.JsonInt(n) -> String.fromInt(n)
        Json.JsonFloat(f) -> String.fromFloat(f)
        Json.JsonBool(b) -> match b
            true -> "true"
            false -> "false"
        Json.JsonList(items) -> "[" + renderJsonList(items) + "]"
        Json.JsonObject(m) -> "{{" + renderJsonEntries(Map.entries(m)) + "}}"
        Json.JsonNull -> "null"

verify toString
    toString(Json.JsonNull) => "null"
    toString(Json.JsonBool(true)) => "true"
    toString(Json.JsonInt(42)) => "42"
    toString(Json.JsonFloat(3.5)) => "3.5"
    toString(Json.JsonString("hi")) => "\"hi\""
    toString(Json.JsonString("a\"b")) => "\"a\\\"b\""
    toString(Json.JsonString("line\nx")) => "\"line\\nx\""
    toString(Json.JsonList([Json.JsonInt(1), Json.JsonNull])) => "[1,null]"
    toString(Json.JsonObject({"a" => Json.JsonInt(1), "b" => Json.JsonBool(false)})) => "{{\"a\":1,\"b\":false}}"

// ── Char helpers ──────────────────────────────────────────────────

verify toString law parseValueRoundtrip
    given j: Json = [
        Json.JsonNull,
        Json.JsonBool(true),
        Json.JsonBool(false),
        Json.JsonInt(42),
        Json.JsonFloat(3.5),
        Json.JsonString("a\"b"),
        Json.JsonList([Json.JsonInt(1), Json.JsonNull]),
        Json.JsonObject({"a" => Json.JsonInt(1), "b" => Json.JsonBool(false)}),
        Json.JsonObject({"nested" => Json.JsonList([Json.JsonString("x"), Json.JsonObject({"ok" => Json.JsonBool(true)})])})
    ]
    when jsonRoundtripSafe(j)
    parseValue(toString(j), 0) => ParseResult.Ok(j, String.len(toString(j)))

verify toString law parseRoundtrip
    given j: Json = [
        Json.JsonNull,
        Json.JsonBool(true),
        Json.JsonBool(false),
        Json.JsonInt(42),
        Json.JsonFloat(3.5),
        Json.JsonString("a\"b"),
        Json.JsonList([Json.JsonInt(1), Json.JsonNull]),
        Json.JsonObject({"a" => Json.JsonInt(1), "b" => Json.JsonBool(false)}),
        Json.JsonObject({"nested" => Json.JsonList([Json.JsonString("x"), Json.JsonObject({"ok" => Json.JsonBool(true)})])})
    ]
    when jsonRoundtripSafe(j)
    fromString(toString(j)) => Result.Ok(j)

fn floatRoundtripSafe(f: Float) -> Bool
    ? "Precondition for JSON float serializer round-tripping through decimal text. Match (rather than `==`) so the parsed Result's E binds to the concrete signature — Aver's type inference doesn't yet propagate Result type args across BinOp::Eq into a bare `Result.Ok(f)` literal on the RHS."
    match Float.fromString(String.fromFloat(f))
        Result.Ok(g)  -> g == f
        Result.Err(_) -> false

verify floatRoundtripSafe
    floatRoundtripSafe(3.5) => true
    floatRoundtripSafe(0.1) => true
    floatRoundtripSafe(-2500.0) => true

fn jsonListRoundtripSafe(items: List<Json>) -> Bool
    ? "True when every array element satisfies the JSON round-trip precondition."
    match items
        [] -> true
        [head, ..tail] -> match jsonRoundtripSafe(head)
            true -> jsonListRoundtripSafe(tail)
            false -> false

verify jsonListRoundtripSafe
    jsonListRoundtripSafe([]) => true
    jsonListRoundtripSafe([Json.JsonInt(1), Json.JsonBool(false)]) => true

fn nonEmptyJsonListRoundtripSafe(items: List<Json>) -> Bool
    ? "True when the array is non-empty and every element satisfies the JSON round-trip precondition."
    match items
        [] -> false
        _ -> jsonListRoundtripSafe(items)

verify nonEmptyJsonListRoundtripSafe
    nonEmptyJsonListRoundtripSafe([]) => false
    nonEmptyJsonListRoundtripSafe([Json.JsonInt(1), Json.JsonBool(false)]) => true

fn jsonEntriesRoundtripSafe(entries: List<(String, Json)>) -> Bool
    ? "True when object values are safe and keys are distinct."
    match entries
        [] -> true
        [entry, ..tail] -> match entry
            (key, value) -> match List.contains(jsonEntryKeys(tail), key)
                true -> false
                false -> match jsonRoundtripSafe(value)
                    true -> jsonEntriesRoundtripSafe(tail)
                    false -> false

verify jsonEntriesRoundtripSafe
    jsonEntriesRoundtripSafe([]) => true
    jsonEntriesRoundtripSafe([("a", Json.JsonInt(1)), ("b", Json.JsonBool(false))]) => true
    jsonEntriesRoundtripSafe([("a", Json.JsonInt(1)), ("a", Json.JsonBool(false))]) => false

fn nonEmptyJsonEntriesRoundtripSafe(entries: List<(String, Json)>) -> Bool
    ? "True when the object entry list is non-empty, distinct, and every value is round-trip safe."
    match entries
        [] -> false
        _ -> jsonEntriesRoundtripSafe(entries)

verify nonEmptyJsonEntriesRoundtripSafe
    nonEmptyJsonEntriesRoundtripSafe([]) => false
    nonEmptyJsonEntriesRoundtripSafe([("a", Json.JsonInt(1)), ("b", Json.JsonBool(false))]) => true

fn jsonEntryKeys(entries: List<(String, Json)>) -> List<String>
    ? "Extract object keys in encounter order."
    match entries
        [] -> []
        [entry, ..tail] -> match entry
            (key, _) -> List.prepend(key, jsonEntryKeys(tail))

verify jsonEntryKeys
    jsonEntryKeys([]) => []
    jsonEntryKeys([("a", Json.JsonInt(1)), ("b", Json.JsonBool(false))]) => ["a", "b"]

fn jsonObjectRoundtripSafe(m: Map<String, Json>) -> Bool
    ? "True when object values are safe; Map already guarantees unique keys."
    jsonEntriesRoundtripSafe(Map.entries(m))

verify jsonObjectRoundtripSafe
    jsonObjectRoundtripSafe({"a" => Json.JsonInt(1), "b" => Json.JsonBool(false)}) => true
    jsonObjectRoundtripSafe({"a" => Json.JsonInt(1)}) => true

fn jsonRoundtripSafe(j: Json) -> Bool
    ? "Precondition for fromString(toString(j)) round-tripping."
    match j
        Json.JsonString(_) -> true
        Json.JsonInt(_) -> true
        Json.JsonFloat(f) -> floatRoundtripSafe(f)
        Json.JsonBool(_) -> true
        Json.JsonList(items) -> jsonListRoundtripSafe(items)
        Json.JsonObject(m) -> jsonObjectRoundtripSafe(m)
        Json.JsonNull -> true

verify jsonRoundtripSafe
    jsonRoundtripSafe(Json.JsonNull) => true
    jsonRoundtripSafe(Json.JsonFloat(3.5)) => true
    jsonRoundtripSafe(Json.JsonList([Json.JsonFloat(0.1), Json.JsonBool(true)])) => true

fn renderJsonList(items: List<Json>) -> String
    ? "JSON helper: renderJsonList."
    match items
        [] -> ""
        [head, ..tail] -> renderJsonListTail(toString(head), tail)

verify renderJsonList
    renderJsonList([]) => ""
    renderJsonList([Json.JsonInt(1), Json.JsonNull]) => "1,null"

verify renderJsonList law parseArrayRoundtrip
    given items: List<Json> = [
        [],
        [Json.JsonInt(1)],
        [Json.JsonString("hi"), Json.JsonBool(false)],
        [Json.JsonList([Json.JsonInt(1)]), Json.JsonObject({"ok" => Json.JsonBool(true)})]
    ]
    when jsonListRoundtripSafe(items)
    parseArray(renderJsonList(items) + "]", 0) => ParseResult.Ok(Json.JsonList(items), String.len(renderJsonList(items)) + 1)

fn renderJsonListTail(acc: String, rest: List<Json>) -> String
    ? "JSON helper: renderJsonListTail."
    match rest
        [] -> acc
        [head, ..tail] -> renderJsonListTail(acc + "," + toString(head), tail)

verify renderJsonListTail
    renderJsonListTail("1", []) => "1"
    renderJsonListTail("1", [Json.JsonInt(2), Json.JsonInt(3)]) => "1,2,3"

verify renderJsonListTail law parseArrayNextRoundtrip
    given head: Json = [
        Json.JsonInt(1),
        Json.JsonBool(false),
        Json.JsonString("hi"),
        Json.JsonList([Json.JsonInt(1)])
    ]
    given tail: List<Json> = [
        [],
        [Json.JsonNull],
        [Json.JsonBool(false), Json.JsonInt(2)],
        [Json.JsonObject({"ok" => Json.JsonBool(true)})]
    ]
    when jsonListRoundtripSafe(List.prepend(head, tail))
    parseArrayNext(renderJsonListTail(toString(head), tail) + "]", String.len(toString(head)), [head]) => ParseResult.Ok(Json.JsonList(List.prepend(head, tail)), String.len(renderJsonListTail(toString(head), tail)) + 1)

fn renderJsonEntries(entries: List<(String, Json)>) -> String
    ? "JSON helper: renderJsonEntries."
    match entries
        [] -> ""
        [entry, ..tail] -> renderJsonEntriesTail(entryToString(entry), tail)

verify renderJsonEntries law parseObjectRoundtrip
    given entries: List<(String, Json)> = [
        [],
        [("a", Json.JsonInt(1))],
        [("a", Json.JsonBool(false)), ("nested", Json.JsonList([Json.JsonString("x")]))],
        [("quote\"", Json.JsonString("a\"b")), ("newline", Json.JsonString("line\nx"))]
    ]
    when jsonEntriesRoundtripSafe(entries)
    parseObject(renderJsonEntries(entries) + "}}", 0) => ParseResult.Ok(Json.JsonObject(Map.fromList(entries)), String.len(renderJsonEntries(entries)) + 1)

fn renderJsonEntriesTail(acc: String, rest: List<(String, Json)>) -> String
    ? "JSON helper: renderJsonEntriesTail."
    match rest
        [] -> acc
        [entry, ..tail] -> renderJsonEntriesTail(acc + "," + entryToString(entry), tail)

verify renderJsonEntriesTail
    renderJsonEntriesTail("\"a\":1", []) => "\"a\":1"
    renderJsonEntriesTail("\"a\":1", [("b", Json.JsonInt(2))]) => "\"a\":1,\"b\":2"

verify renderJsonEntriesTail law parseObjNextRoundtrip
    given entry: (String, Json) = [
        ("a", Json.JsonInt(1)),
        ("nested", Json.JsonBool(false)),
        ("quote\"", Json.JsonString("a\"b"))
    ]
    given tail: List<(String, Json)> = [
        [],
        [("b", Json.JsonInt(2))],
        [("nested", Json.JsonList([Json.JsonString("x")]))]
    ]
    when jsonEntriesRoundtripSafe(prependJsonEntry(entry, tail))
    parseObjNext(renderJsonEntriesTail(entryToString(entry), tail) + "}}", String.len(entryToString(entry)), Map.fromList(singletonJsonEntries(entry))) => ParseResult.Ok(Json.JsonObject(Map.fromList(prependJsonEntry(entry, tail))), String.len(renderJsonEntriesTail(entryToString(entry), tail)) + 1)

fn entryToString(entry: (String, Json)) -> String
    ? "JSON helper: entryToString."
    match entry
        (key, val) -> "\"" + escapeJsonString(key) + "\":" + toString(val)

verify entryToString
    entryToString(("a\"b", Json.JsonInt(1))) => "\"a\\\"b\":1"

verify entryToString law parseObjKeyRoundtrip
    given entry: (String, Json) = [
        ("a", Json.JsonInt(1)),
        ("quote\"", Json.JsonBool(false)),
        ("newline", Json.JsonString("a\"b")),
        ("emoji😀", Json.JsonList([Json.JsonString("x")]))
    ]
    when jsonEntryRoundtripSafe(entry)
    parseObjKey(entryToString(entry) + "}}", 1, emptyJsonMap()) => ParseResult.Ok(Json.JsonObject(Map.fromList(singletonJsonEntries(entry))), String.len(entryToString(entry)) + 1)

fn jsonEntryKey(entry: (String, Json)) -> String
    ? "JSON helper: jsonEntryKey."
    match entry
        (key, _) -> key

verify jsonEntryKey
    jsonEntryKey(("a", Json.JsonInt(1))) => "a"

fn jsonEntryValue(entry: (String, Json)) -> Json
    ? "JSON helper: jsonEntryValue."
    match entry
        (_, value) -> value

verify jsonEntryValue
    jsonEntryValue(("a", Json.JsonInt(1))) => Json.JsonInt(1)

fn singletonJsonEntries(entry: (String, Json)) -> List<(String, Json)>
    ? "JSON helper: singletonJsonEntries."
    List.prepend(entry, [])

verify singletonJsonEntries
    singletonJsonEntries(("a", Json.JsonInt(1))) => [("a", Json.JsonInt(1))]

fn prependJsonEntry(entry: (String, Json), tail: List<(String, Json)>) -> List<(String, Json)>
    ? "JSON helper: prependJsonEntry."
    List.prepend(entry, tail)

fn jsonEntryRoundtripSafe(entry: (String, Json)) -> Bool
    ? "JSON helper: jsonEntryRoundtripSafe."
    jsonRoundtripSafe(jsonEntryValue(entry))

verify jsonEntryRoundtripSafe
    jsonEntryRoundtripSafe(("a", Json.JsonInt(1))) => true

fn escapeJsonString(s: String) -> String
    ? "JSON helper: escapeJsonString."
    escapeJsonChars(String.chars(s), "")

verify escapeJsonString
    escapeJsonString("a\"b\nc") => "a\\\"b\\nc"

verify escapeJsonString law parseStringRoundtrip
    given s: String = ["", "hi", "a\"b", "line\nx", "\t", "\r", "\\", "😀"]
    parseString("\"" + escapeJsonString(s) + "\"", 1) => ParseResult.Ok(Json.JsonString(s), String.len(escapeJsonString(s)) + 2)

fn escapeJsonChars(chars: List<String>, acc: String) -> String
    ? "JSON helper: escapeJsonChars."
    match chars
        [] -> acc
        [c, ..rest] -> escapeJsonChars(rest, acc + escapeJsonChar(c))

verify escapeJsonChars
    escapeJsonChars([], "x") => "x"
    escapeJsonChars(["a", "\"", "b"], "") => "a\\\"b"

fn escapeJsonChar(c: String) -> String
    ? "JSON helper: escapeJsonChar."
    match c
        "\"" -> "\\\""
        "\\" -> "\\\\"
        "\n" -> "\\n"
        "\r" -> "\\r"
        "\t" -> "\\t"
        _ -> escapeControlChar(c)

verify escapeJsonChar
    escapeJsonChar("\"") => "\\\""
    escapeJsonChar("\\") => "\\\\"
    escapeJsonChar("\n") => "\\n"
    escapeJsonChar("\r") => "\\r"
    escapeJsonChar("\t") => "\\t"
    escapeJsonChar("a") => "a"

fn escapeControlChar(c: String) -> String
    ? "JSON helper: escapeControlChar."
    code = Char.toCode(c)
    match code == 8
        true -> "\\b"
        false -> match code == 12
            true -> "\\f"
            false -> match code < 32
                true -> controlCodeEscape(c, code)
                false -> c

verify escapeControlChar
    escapeControlChar(Option.withDefault(Char.fromCode(8), "")) => "\\b"
    escapeControlChar(Option.withDefault(Char.fromCode(12), "")) => "\\f"
    escapeControlChar(Option.withDefault(Char.fromCode(1), "")) => "\\u0001"
    escapeControlChar("A") => "A"

fn controlCodeEscape(c: String, code: Int) -> String
    ? "JSON helper: controlCodeEscape."
    match Byte.toHex(code)
        Result.Ok(hex) -> "\\u00" + hex
        Result.Err(_) -> c

verify controlCodeEscape
    controlCodeEscape("x", 9) => "\\u0009"
    controlCodeEscape("x", 300) => "x"

fn isDigit(c: String) -> Bool
    ? "JSON helper: isDigit."
    code = Char.toCode(c)
    match code >= 48
        true -> code <= 57
        false -> false

verify isDigit
    isDigit("/") => false
    isDigit("5") => true
    isDigit("a") => false

fn digitVal(c: String) -> Int
    ? "JSON helper: digitVal."
    Char.toCode(c) - 48

verify digitVal
    digitVal("7") => 7

fn hexVal(c: String) -> Option<Int>
    ? "Hex digit value: 0-9, a-f, A-F. None for non-hex."
    match isDigit(c)
        true -> Option.Some(digitVal(c))
        false -> hexAlpha(Char.toCode(c))

verify hexVal
    hexVal("9") => Option.Some(9)
    hexVal("a") => Option.Some(10)
    hexVal("Z") => Option.None

fn hexAlpha(code: Int) -> Option<Int>
    ? "JSON helper: hexAlpha."
    match code >= 97
        true -> match code <= 102
            true -> Option.Some(code - 87)
            false -> Option.None
        false -> match code >= 65
            true -> match code <= 70
                true -> Option.Some(code - 55)
                false -> Option.None
            false -> Option.None

verify hexAlpha
    hexAlpha(97) => Option.Some(10)
    hexAlpha(103) => Option.None
    hexAlpha(65) => Option.Some(10)
    hexAlpha(71) => Option.None
    hexAlpha(47) => Option.None

fn skipWs(s: String, pos: Int) -> Int
    ? "JSON helper: skipWs."
    match String.charAt(s, pos)
        Option.None -> pos
        Option.Some(c) -> match c
            " " -> skipWs(s, pos + 1)
            "\t" -> skipWs(s, pos + 1)
            "\n" -> skipWs(s, pos + 1)
            "\r" -> skipWs(s, pos + 1)
            _ -> pos

verify skipWs
    skipWs("", 0) => 0
    skipWs("  abc", 0) => 2
    skipWs("\tabc", 0) => 1
    skipWs("\nabc", 0) => 1
    skipWs("\rabc", 0) => 1
    skipWs("abc", 0) => 0

fn parseValue(s: String, pos: Int) -> ParseResult
    ? "JSON helper: parseValue."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unexpected end of input", pos)
        Option.Some(c) -> dispatchChar(s, pos, c)

verify parseValue
    parseValue("", 0) => ParseResult.Err("Unexpected end of input", 0)
    parseValue("1", 0) => ParseResult.Ok(Json.JsonInt(1), 1)

fn dispatchChar(s: String, pos: Int, c: String) -> ParseResult
    ? "JSON helper: dispatchChar."
    match c
        "\"" -> parseString(s, pos + 1)
        "{{" -> parseObject(s, skipWs(s, pos + 1))
        "[" -> parseArray(s, skipWs(s, pos + 1))
        "t" -> parseLiteral(s, pos, "true", Json.JsonBool(true))
        "f" -> parseLiteral(s, pos, "false", Json.JsonBool(false))
        "n" -> parseLiteral(s, pos, "null", Json.JsonNull)
        "-" -> parseNumber(s, pos)
        _ -> dispatchNumberOrErr(s, pos, c)

verify dispatchChar
    dispatchChar("\"x\"", 0, "\"") => ParseResult.Ok(Json.JsonString("x"), 3)
    dispatchChar("{{}}", 0, "{{") => ParseResult.Ok(Json.JsonObject(emptyJsonMap()), 2)
    dispatchChar("[]", 0, "[") => ParseResult.Ok(Json.JsonList([]), 2)
    dispatchChar("true", 0, "t") => ParseResult.Ok(Json.JsonBool(true), 4)
    dispatchChar("false", 0, "f") => ParseResult.Ok(Json.JsonBool(false), 5)
    dispatchChar("null", 0, "n") => ParseResult.Ok(Json.JsonNull, 4)
    dispatchChar("-1", 0, "-") => ParseResult.Ok(Json.JsonInt(-1), 2)
    dispatchChar("9", 0, "9") => ParseResult.Ok(Json.JsonInt(9), 1)

fn dispatchNumberOrErr(s: String, pos: Int, c: String) -> ParseResult
    ? "JSON helper: dispatchNumberOrErr."
    match isDigit(c)
        true -> parseNumber(s, pos)
        false -> ParseResult.Err("Unexpected character: " + c, pos)

verify dispatchNumberOrErr
    dispatchNumberOrErr("7", 0, "7") => ParseResult.Ok(Json.JsonInt(7), 1)
    dispatchNumberOrErr("x", 0, "x") => ParseResult.Err("Unexpected character: x", 0)

verify dispatchNumberOrErr law fromIntRoundtrip
    given n: Int = [0, 7, 42, 2500]
    when n >= 0
    dispatchNumberOrErr(toString(Json.JsonInt(n)), 0, String.slice(toString(Json.JsonInt(n)), 0, 1)) => ParseResult.Ok(Json.JsonInt(n), String.len(toString(Json.JsonInt(n))))

fn parseLiteral(s: String, pos: Int, expected: String, value: Json) -> ParseResult
    ? "Match exact keyword using slice comparison."
    len = String.len(expected)
    match String.slice(s, pos, pos + len) == expected
        true -> ParseResult.Ok(value, pos + len)
        false -> ParseResult.Err("Expected '" + expected + "'", pos)

verify parseLiteral
    parseLiteral("true", 0, "true", Json.JsonBool(true)) => ParseResult.Ok(Json.JsonBool(true), 4)
    parseLiteral("truX", 0, "true", Json.JsonBool(true)) => ParseResult.Err("Expected 'true'", 0)

verify parseLiteral law boolRoundtrip
    given b: Bool = [true, false]
    parseLiteral(toString(Json.JsonBool(b)), 0, toString(Json.JsonBool(b)), Json.JsonBool(b)) => ParseResult.Ok(Json.JsonBool(b), String.len(toString(Json.JsonBool(b))))

fn parseString(s: String, pos: Int) -> ParseResult
    ? "Parse string using segment chunks to avoid repeated concatenation."
    parseStringChunk(s, pos, pos, [])

verify parseString
    parseString("\"", 0) => ParseResult.Ok(Json.JsonString(""), 1)
    parseString("abc\"", 0) => ParseResult.Ok(Json.JsonString("abc"), 4)

fn parseStringChunk(s: String, pos: Int, segmentStart: Int, chunks: List<String>) -> ParseResult
    ? "JSON helper: parseStringChunk."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unterminated string", pos)
        Option.Some(c) -> match c
            "\"" -> finishString(s, pos + 1, segmentStart, chunks)
            "\\" -> parseEscape(s, pos + 1, pos, segmentStart, chunks)
            _ -> validateChar(s, pos, segmentStart, chunks, c)

verify parseStringChunk
    parseStringChunk("", 0, 0, []) => ParseResult.Err("Unterminated string", 0)
    parseStringChunk("\"", 0, 0, []) => ParseResult.Ok(Json.JsonString(""), 1)
    parseStringChunk("\\\\\"", 0, 0, []) => ParseResult.Ok(Json.JsonString("\\"), 3)
    parseStringChunk("a\"", 0, 0, []) => ParseResult.Ok(Json.JsonString("a"), 2)

verify parseStringChunk law escapedStringRoundtrip
    given s: String = ["", "hi", "a\"b", "line\nx", "\t", "\r", "\\", "😀"]
    parseStringChunk("\"" + escapeJsonString(s) + "\"", 1, 1, []) => ParseResult.Ok(Json.JsonString(s), String.len(escapeJsonString(s)) + 2)

fn finishString(s: String, nextPos: Int, segmentStart: Int, chunks: List<String>) -> ParseResult
    ? "JSON helper: finishString."
    segment = String.slice(s, segmentStart, nextPos - 1)
    all = String.join(List.concat(chunks, [segment]), "")
    ParseResult.Ok(Json.JsonString(all), nextPos)

verify finishString
    finishString("abc\"", 4, 0, []) => ParseResult.Ok(Json.JsonString("abc"), 4)

verify finishString law plainSegmentRoundtrip
    given s: String = ["", "abc", "😀"]
    finishString(s + "\"", String.len(s) + 1, 0, []) => ParseResult.Ok(Json.JsonString(s), String.len(s) + 1)

fn validateChar(s: String, pos: Int, segmentStart: Int, chunks: List<String>, c: String) -> ParseResult
    ? "JSON helper: validateChar."
    match Char.toCode(c) < 32
        true -> ParseResult.Err("Unescaped control character", pos)
        false -> parseStringChunk(s, pos + 1, segmentStart, chunks)

verify validateChar
    validateChar("\t", 0, 0, [], "\t") => ParseResult.Err("Unescaped control character", 0)
    validateChar("a\"", 0, 0, [], "a") => ParseResult.Ok(Json.JsonString("a"), 2)

verify validateChar law printableCharRoundtrip
    given c: String = ["a", "😀"]
    validateChar(c + "\"", 0, 0, [], c) => ParseResult.Ok(Json.JsonString(c), String.len(c) + 1)

fn parseEscape(s: String, pos: Int, slashPos: Int, segmentStart: Int, chunks: List<String>) -> ParseResult
    ? "JSON helper: parseEscape."
    segment = String.slice(s, segmentStart, slashPos)
    base = List.concat(chunks, [segment])
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unterminated escape", pos)
        Option.Some(c) -> match c
            "\"" -> parseStringChunk(s, pos + 1, pos + 1, List.concat(base, ["\""]))
            "\\" -> parseStringChunk(s, pos + 1, pos + 1, List.concat(base, ["\\"]))
            "/" -> parseStringChunk(s, pos + 1, pos + 1, List.concat(base, ["/"]))
            "n" -> parseStringChunk(s, pos + 1, pos + 1, List.concat(base, ["\n"]))
            "t" -> parseStringChunk(s, pos + 1, pos + 1, List.concat(base, ["\t"]))
            "r" -> parseStringChunk(s, pos + 1, pos + 1, List.concat(base, ["\r"]))
            "b" -> parseStringChunk(s, pos + 1, pos + 1, List.concat(base, ["\b"]))
            "f" -> parseStringChunk(s, pos + 1, pos + 1, List.concat(base, ["\f"]))
            "u" -> parseUnicode(s, pos + 1, pos + 1, base)
            _ -> ParseResult.Err("Unknown escape: \\" + c, pos)

verify parseEscape
    parseEscape("\\", 1, 0, 0, []) => ParseResult.Err("Unterminated escape", 1)
    parseEscape("\\\"\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\""), 3)
    parseEscape("\\\\\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\\"), 3)
    parseEscape("\\/\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("/"), 3)
    parseEscape("\\n\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\n"), 3)
    parseEscape("\\t\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\t"), 3)
    parseEscape("\\r\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\r"), 3)
    parseEscape("\\b\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\b"), 3)
    parseEscape("\\f\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\f"), 3)
    parseEscape("\\u0041\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("A"), 7)
    parseEscape("\\x\"", 1, 0, 0, []) => ParseResult.Err("Unknown escape: \\x", 1)

verify parseEscape law escapedChunkRoundtrip
    given dummy: Int = [0]
    parseEscape("\\\"\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\""), 3)

verify parseEscape law slashEscapeRoundtrip
    given dummy: Int = [0]
    parseEscape("\\\\\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\\"), 3)

verify parseEscape law newlineEscapeRoundtrip
    given dummy: Int = [0]
    parseEscape("\\n\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("\n"), 3)

verify parseEscape law unicodeEscapeRoundtrip
    given dummy: Int = [0]
    parseEscape("\\u0041\"", 1, 0, 0, []) => ParseResult.Ok(Json.JsonString("A"), 7)

fn parseUnicode(s: String, pos: Int, escapePos: Int, chunks: List<String>) -> ParseResult
    ? "Parse \\uXXXX, including surrogate pairs."
    match readHex4(s, pos, 0, 0)
        Option.None -> ParseResult.Err("Invalid \\u escape", escapePos)
        Option.Some(cp) -> parseUnicodeCodePoint(s, pos + 4, escapePos, chunks, cp)

verify parseUnicode
    parseUnicode("0041\"", 0, 0, []) => ParseResult.Ok(Json.JsonString("A"), 5)
    parseUnicode("XX", 0, 0, []) => ParseResult.Err("Invalid \\u escape", 0)

fn parseUnicodeCodePoint(s: String, pos: Int, escapePos: Int, chunks: List<String>, cp: Int) -> ParseResult
    ? "JSON helper: parseUnicodeCodePoint."
    match isHighSurrogate(cp)
        true -> parseUnicodePair(s, pos, escapePos, chunks, cp)
        false -> match isLowSurrogate(cp)
            true -> ParseResult.Err("Invalid Unicode surrogate pair", escapePos)
            false -> applyCodePoint(s, pos, escapePos, chunks, cp)

verify parseUnicodeCodePoint
    parseUnicodeCodePoint("\\uDE00\"", 0, 0, [], 55357) => ParseResult.Ok(Json.JsonString("😀"), 7)
    parseUnicodeCodePoint("", 0, 0, [], 56832) => ParseResult.Err("Invalid Unicode surrogate pair", 0)
    parseUnicodeCodePoint("\"", 0, 0, [], 65) => ParseResult.Ok(Json.JsonString("A"), 1)

fn isHighSurrogate(cp: Int) -> Bool
    ? "JSON helper: isHighSurrogate."
    match cp >= 55296
        true -> cp <= 56319
        false -> false

verify isHighSurrogate
    isHighSurrogate(55357) => true
    isHighSurrogate(65) => false

fn isLowSurrogate(cp: Int) -> Bool
    ? "JSON helper: isLowSurrogate."
    match cp >= 56320
        true -> cp <= 57343
        false -> false

verify isLowSurrogate
    isLowSurrogate(56832) => true
    isLowSurrogate(65) => false

fn parseUnicodePair(s: String, pos: Int, escapePos: Int, chunks: List<String>, hi: Int) -> ParseResult
    ? "JSON helper: parseUnicodePair."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Invalid Unicode surrogate pair", escapePos)
        Option.Some(c) -> match c
            "\\" -> parseUnicodePairU(s, pos + 1, escapePos, chunks, hi)
            _ -> ParseResult.Err("Invalid Unicode surrogate pair", escapePos)

verify parseUnicodePair
    parseUnicodePair("", 0, 0, [], 55357) => ParseResult.Err("Invalid Unicode surrogate pair", 0)
    parseUnicodePair("x", 0, 0, [], 55357) => ParseResult.Err("Invalid Unicode surrogate pair", 0)
    parseUnicodePair("\\uDE00\"", 0, 0, [], 55357) => ParseResult.Ok(Json.JsonString("😀"), 7)

fn parseUnicodePairU(s: String, pos: Int, escapePos: Int, chunks: List<String>, hi: Int) -> ParseResult
    ? "JSON helper: parseUnicodePairU."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Invalid Unicode surrogate pair", escapePos)
        Option.Some(c) -> match c
            "u" -> parseUnicodePairLow(s, pos + 1, escapePos, chunks, hi)
            _ -> ParseResult.Err("Invalid Unicode surrogate pair", escapePos)

verify parseUnicodePairU
    parseUnicodePairU("", 0, 0, [], 55357) => ParseResult.Err("Invalid Unicode surrogate pair", 0)
    parseUnicodePairU("x", 0, 0, [], 55357) => ParseResult.Err("Invalid Unicode surrogate pair", 0)
    parseUnicodePairU("uDE00\"", 0, 0, [], 55357) => ParseResult.Ok(Json.JsonString("😀"), 6)

fn parseUnicodePairLow(s: String, pos: Int, escapePos: Int, chunks: List<String>, hi: Int) -> ParseResult
    ? "JSON helper: parseUnicodePairLow."
    match readHex4(s, pos, 0, 0)
        Option.None -> ParseResult.Err("Invalid \\u escape", pos - 1)
        Option.Some(lo) -> match isLowSurrogate(lo)
            true -> applyCodePoint(s, pos + 4, escapePos, chunks, combineSurrogates(hi, lo))
            false -> ParseResult.Err("Invalid Unicode surrogate pair", escapePos)

verify parseUnicodePairLow
    parseUnicodePairLow("ZZ", 0, 0, [], 55357) => ParseResult.Err("Invalid \\u escape", -1)
    parseUnicodePairLow("DE00\"", 0, 0, [], 55357) => ParseResult.Ok(Json.JsonString("😀"), 5)
    parseUnicodePairLow("0041\"", 0, 0, [], 55357) => ParseResult.Err("Invalid Unicode surrogate pair", 0)

fn combineSurrogates(hi: Int, lo: Int) -> Int
    ? "JSON helper: combineSurrogates."
    65536 + (hi - 55296) * 1024 + (lo - 56320)

verify combineSurrogates
    combineSurrogates(55357, 56832) => 128512

fn readHex4(s: String, pos: Int, acc: Int, count: Int) -> Option<Int>
    ? "JSON helper: readHex4."
    match count == 4
        true -> Option.Some(acc)
        false -> match String.charAt(s, pos)
            Option.None -> Option.None
            Option.Some(c) -> match hexVal(c)
                Option.None -> Option.None
                Option.Some(v) -> readHex4(s, pos + 1, acc * 16 + v, count + 1)

verify readHex4
    readHex4("ABCD", 0, 0, 4) => Option.Some(0)
    readHex4("", 0, 0, 0) => Option.None
    readHex4("Z", 0, 0, 0) => Option.None
    readHex4("0041", 0, 0, 0) => Option.Some(65)

fn applyCodePoint(s: String, pos: Int, escapePos: Int, chunks: List<String>, cp: Int) -> ParseResult
    ? "JSON helper: applyCodePoint."
    match Char.fromCode(cp)
        Option.None -> ParseResult.Err("Invalid Unicode code point", escapePos)
        Option.Some(ch) -> parseStringChunk(s, pos, pos, List.concat(chunks, [ch]))

verify applyCodePoint
    applyCodePoint("\"", 0, 0, [], 65) => ParseResult.Ok(Json.JsonString("A"), 1)
    applyCodePoint("\"", 0, 0, [], 1114112) => ParseResult.Err("Invalid Unicode code point", 0)

fn parseNumber(s: String, start: Int) -> ParseResult
    ? "Parse JSON number using source slices (avoids Int overflow during scan)."
    match String.charAt(s, start)
        Option.None -> ParseResult.Err("Unexpected end of input", start)
        Option.Some(c) -> match c
            "-" -> parseNumberSign(s, start + 1, start)
            "0" -> scanIntTail(s, start + 1, start, true)
            _ -> startNumberDigits(s, start, c)

verify parseNumber
    parseNumber("", 0) => ParseResult.Err("Unexpected end of input", 0)
    parseNumber("-1", 0) => ParseResult.Ok(Json.JsonInt(-1), 2)
    parseNumber("0", 0) => ParseResult.Ok(Json.JsonInt(0), 1)
    parseNumber("9", 0) => ParseResult.Ok(Json.JsonInt(9), 1)

verify parseNumber law fromIntRoundtrip
    given n: Int = [-7, 0, 42, 2500]
    parseNumber(toString(Json.JsonInt(n)), 0) => ParseResult.Ok(Json.JsonInt(n), String.len(toString(Json.JsonInt(n))))

verify parseNumber law fromFloatRoundtrip
    given f: Float = [3.5, 0.1, -2.5]
    when floatRoundtripSafe(f)
    parseNumber(toString(Json.JsonFloat(f)), 0) => ParseResult.Ok(Json.JsonFloat(f), String.len(toString(Json.JsonFloat(f))))

fn startNumberDigits(s: String, start: Int, c: String) -> ParseResult
    ? "JSON helper: startNumberDigits."
    match isDigit(c)
        true -> scanIntTail(s, start + 1, start, false)
        false -> ParseResult.Err("Unexpected character: " + c, start)

verify startNumberDigits
    startNumberDigits("7", 0, "7") => ParseResult.Ok(Json.JsonInt(7), 1)
    startNumberDigits("x", 0, "x") => ParseResult.Err("Unexpected character: x", 0)

verify startNumberDigits law fromPositiveIntRoundtrip
    given n: Int = [1, 7, 42, 2500]
    when n > 0
    startNumberDigits(toString(Json.JsonInt(n)), 0, String.slice(toString(Json.JsonInt(n)), 0, 1)) => ParseResult.Ok(Json.JsonInt(n), String.len(toString(Json.JsonInt(n))))

fn parseNumberSign(s: String, pos: Int, start: Int) -> ParseResult
    ? "JSON helper: parseNumberSign."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Expected digit after '-'", pos)
        Option.Some(c) -> match c
            "0" -> scanIntTail(s, pos + 1, start, true)
            _ -> startSignDigit(s, pos, start, c)

verify parseNumberSign
    parseNumberSign("-", 1, 0) => ParseResult.Err("Expected digit after '-'", 1)
    parseNumberSign("-0", 1, 0) => ParseResult.Ok(Json.JsonInt(0), 2)
    parseNumberSign("-8", 1, 0) => ParseResult.Ok(Json.JsonInt(-8), 2)

verify parseNumberSign law fromNegativeIntRoundtrip
    given n: Int = [-1, -7, -42]
    when n < 0
    parseNumberSign(toString(Json.JsonInt(n)), 1, 0) => ParseResult.Ok(Json.JsonInt(n), String.len(toString(Json.JsonInt(n))))

fn startSignDigit(s: String, pos: Int, start: Int, c: String) -> ParseResult
    ? "JSON helper: startSignDigit."
    match isDigit(c)
        true -> scanIntTail(s, pos + 1, start, false)
        false -> ParseResult.Err("Expected digit after '-'", pos)

verify startSignDigit
    startSignDigit("-8", 1, 0, "8") => ParseResult.Ok(Json.JsonInt(-8), 2)
    startSignDigit("-x", 1, 0, "x") => ParseResult.Err("Expected digit after '-'", 1)

verify startSignDigit law negativeDigitRoundtrip
    given n: Int = [-1, -42]
    when n < 0
    startSignDigit(toString(Json.JsonInt(n)), 1, 0, String.slice(toString(Json.JsonInt(n)), 1, 2)) => ParseResult.Ok(Json.JsonInt(n), String.len(toString(Json.JsonInt(n))))

fn scanIntTail(s: String, pos: Int, start: Int, leadingZero: Bool) -> ParseResult
    ? "JSON helper: scanIntTail."
    match String.charAt(s, pos)
        Option.None -> finishNumber(s, start, pos, false)
        Option.Some(c) -> match isDigit(c)
            true -> match leadingZero
                true -> ParseResult.Err("Leading zeros not allowed", pos)
                false -> scanIntTail(s, pos + 1, start, false)
            false -> afterIntChar(s, pos, start, c)

verify scanIntTail
    scanIntTail("1", 1, 0, false) => ParseResult.Ok(Json.JsonInt(1), 1)
    scanIntTail("01", 1, 0, true) => ParseResult.Err("Leading zeros not allowed", 1)
    scanIntTail("12", 1, 0, false) => ParseResult.Ok(Json.JsonInt(12), 2)
    scanIntTail("1.", 1, 0, false) => ParseResult.Err("Expected digit after '.'", 2)

verify scanIntTail law fromCanonicalIntTail
    given n: Int = [0, 7, 42, 2500]
    when n >= 0
    scanIntTail(toString(Json.JsonInt(n)), 1, 0, n == 0) => ParseResult.Ok(Json.JsonInt(n), String.len(toString(Json.JsonInt(n))))

fn afterIntChar(s: String, pos: Int, start: Int, c: String) -> ParseResult
    ? "JSON helper: afterIntChar."
    match c
        "." -> scanFracFirst(s, pos + 1, start)
        "e" -> scanExpStart(s, pos + 1, start)
        "E" -> scanExpStart(s, pos + 1, start)
        _ -> finishNumber(s, start, pos, false)

verify afterIntChar
    afterIntChar("1.5", 1, 0, ".") => ParseResult.Ok(Json.JsonFloat(1.5), 3)
    afterIntChar("1e2", 1, 0, "e") => ParseResult.Ok(Json.JsonFloat(100.0), 3)
    afterIntChar("1E2", 1, 0, "E") => ParseResult.Ok(Json.JsonFloat(100.0), 3)
    afterIntChar("1]", 1, 0, "]") => ParseResult.Ok(Json.JsonInt(1), 1)

verify afterIntChar law terminatedIntRoundtrip
    given n: Int = [1, 42]
    afterIntChar(toString(Json.JsonInt(n)) + "]", String.len(toString(Json.JsonInt(n))), 0, "]") => ParseResult.Ok(Json.JsonInt(n), String.len(toString(Json.JsonInt(n))))

fn scanFracFirst(s: String, pos: Int, start: Int) -> ParseResult
    ? "JSON helper: scanFracFirst."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Expected digit after '.'", pos)
        Option.Some(c) -> match isDigit(c)
            true -> scanFracTail(s, pos + 1, start)
            false -> ParseResult.Err("Expected digit after '.'", pos)

verify scanFracFirst
    scanFracFirst("1.", 2, 0) => ParseResult.Err("Expected digit after '.'", 2)
    scanFracFirst("1.5", 2, 0) => ParseResult.Ok(Json.JsonFloat(1.5), 3)
    scanFracFirst("1.x", 2, 0) => ParseResult.Err("Expected digit after '.'", 2)

fn scanFracTail(s: String, pos: Int, start: Int) -> ParseResult
    ? "JSON helper: scanFracTail."
    match String.charAt(s, pos)
        Option.None -> finishNumber(s, start, pos, true)
        Option.Some(c) -> match isDigit(c)
            true -> scanFracTail(s, pos + 1, start)
            false -> afterFracChar(s, pos, start, c)

verify scanFracTail
    scanFracTail("1.5", 3, 0) => ParseResult.Ok(Json.JsonFloat(1.5), 3)
    scanFracTail("1.56", 3, 0) => ParseResult.Ok(Json.JsonFloat(1.56), 4)
    scanFracTail("1.5e2", 3, 0) => ParseResult.Ok(Json.JsonFloat(150.0), 5)

fn afterFracChar(s: String, pos: Int, start: Int, c: String) -> ParseResult
    ? "JSON helper: afterFracChar."
    match c
        "e" -> scanExpStart(s, pos + 1, start)
        "E" -> scanExpStart(s, pos + 1, start)
        _ -> finishNumber(s, start, pos, true)

verify afterFracChar
    afterFracChar("1.5e2", 3, 0, "e") => ParseResult.Ok(Json.JsonFloat(150.0), 5)
    afterFracChar("1.5E2", 3, 0, "E") => ParseResult.Ok(Json.JsonFloat(150.0), 5)
    afterFracChar("1.5]", 3, 0, "]") => ParseResult.Ok(Json.JsonFloat(1.5), 3)

fn scanExpStart(s: String, pos: Int, start: Int) -> ParseResult
    ? "Parse exponent: optional sign then at least one digit."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Expected digit in exponent", pos)
        Option.Some(c) -> match c
            "+" -> scanExpDigit1(s, pos + 1, start)
            "-" -> scanExpDigit1(s, pos + 1, start)
            _ -> startExpDigit(s, pos, start, c)

verify scanExpStart
    scanExpStart("1e", 2, 0) => ParseResult.Err("Expected digit in exponent", 2)
    scanExpStart("1e+2", 2, 0) => ParseResult.Ok(Json.JsonFloat(100.0), 4)
    scanExpStart("1e-2", 2, 0) => ParseResult.Ok(Json.JsonFloat(0.01), 4)
    scanExpStart("1e2", 2, 0) => ParseResult.Ok(Json.JsonFloat(100.0), 3)

fn scanExpDigit1(s: String, pos: Int, start: Int) -> ParseResult
    ? "JSON helper: scanExpDigit1."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Expected digit in exponent", pos)
        Option.Some(c) -> startExpDigit(s, pos, start, c)

verify scanExpDigit1
    scanExpDigit1("1e+", 3, 0) => ParseResult.Err("Expected digit in exponent", 3)
    scanExpDigit1("1e+2", 3, 0) => ParseResult.Ok(Json.JsonFloat(100.0), 4)

fn startExpDigit(s: String, pos: Int, start: Int, c: String) -> ParseResult
    ? "JSON helper: startExpDigit."
    match isDigit(c)
        true -> scanExpTail(s, pos + 1, start)
        false -> ParseResult.Err("Expected digit in exponent", pos)

verify startExpDigit
    startExpDigit("1e2", 2, 0, "2") => ParseResult.Ok(Json.JsonFloat(100.0), 3)
    startExpDigit("1ex", 2, 0, "x") => ParseResult.Err("Expected digit in exponent", 2)

fn scanExpTail(s: String, pos: Int, start: Int) -> ParseResult
    ? "JSON helper: scanExpTail."
    match String.charAt(s, pos)
        Option.None -> finishNumber(s, start, pos, true)
        Option.Some(c) -> match isDigit(c)
            true -> scanExpTail(s, pos + 1, start)
            false -> finishNumber(s, start, pos, true)

verify scanExpTail
    scanExpTail("1e2", 3, 0) => ParseResult.Ok(Json.JsonFloat(100.0), 3)
    scanExpTail("1e02", 3, 0) => ParseResult.Ok(Json.JsonFloat(100.0), 4)
    scanExpTail("1e2]", 3, 0) => ParseResult.Ok(Json.JsonFloat(100.0), 3)

fn finishNumber(s: String, start: Int, endPos: Int, asFloat: Bool) -> ParseResult
    ? "JSON helper: finishNumber."
    num = String.slice(s, start, endPos)
    match asFloat
        true -> finishFloat(num, endPos)
        false -> finishInt(num, endPos)

verify finishNumber
    finishNumber("42", 0, 2, false) => ParseResult.Ok(Json.JsonInt(42), 2)
    finishNumber("4.2", 0, 3, true) => ParseResult.Ok(Json.JsonFloat(4.2), 3)

verify finishNumber law fromCanonicalIntSlice
    given n: Int = [-7, 42]
    finishNumber(toString(Json.JsonInt(n)), 0, String.len(toString(Json.JsonInt(n))), false) => ParseResult.Ok(Json.JsonInt(n), String.len(toString(Json.JsonInt(n))))

verify finishNumber law fromCanonicalFloatSlice
    given f: Float = [3.5, -2.5]
    when floatRoundtripSafe(f)
    finishNumber(toString(Json.JsonFloat(f)), 0, String.len(toString(Json.JsonFloat(f))), true) => ParseResult.Ok(Json.JsonFloat(f), String.len(toString(Json.JsonFloat(f))))

fn finishInt(num: String, pos: Int) -> ParseResult
    ? "JSON helper: finishInt."
    match Int.fromString(num)
        Result.Ok(n) -> ParseResult.Ok(Json.JsonInt(n), pos)
        Result.Err(_) -> ParseResult.Err("Invalid number: " + num, pos)

verify finishInt
    finishInt("42", 2) => ParseResult.Ok(Json.JsonInt(42), 2)
    finishInt("x", 1) => ParseResult.Err("Invalid number: x", 1)

verify finishInt law fromCanonicalInt
    given n: Int = [-7, 0, 42]
    finishInt(String.fromInt(n), String.len(String.fromInt(n))) => ParseResult.Ok(Json.JsonInt(n), String.len(String.fromInt(n)))

fn finishFloat(num: String, pos: Int) -> ParseResult
    ? "JSON helper: finishFloat."
    match Float.fromString(num)
        Result.Ok(f) -> ParseResult.Ok(Json.JsonFloat(f), pos)
        Result.Err(_) -> ParseResult.Err("Invalid number: " + num, pos)

verify finishFloat
    finishFloat("4.2", 3) => ParseResult.Ok(Json.JsonFloat(4.2), 3)
    finishFloat("x", 1) => ParseResult.Err("Invalid number: x", 1)

verify finishFloat law fromCanonicalFloat
    given f: Float = [3.5, 0.1, -2.5]
    when floatRoundtripSafe(f)
    finishFloat(String.fromFloat(f), String.len(String.fromFloat(f))) => ParseResult.Ok(Json.JsonFloat(f), String.len(String.fromFloat(f)))

fn parseArray(s: String, pos: Int) -> ParseResult
    ? "JSON helper: parseArray."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unterminated array", pos)
        Option.Some(c) -> match c
            "]" -> ParseResult.Ok(Json.JsonList([]), pos + 1)
            _ -> parseArrayElems(s, pos, [])

verify parseArray
    parseArray("", 0) => ParseResult.Err("Unterminated array", 0)
    parseArray("]", 0) => ParseResult.Ok(Json.JsonList([]), 1)
    parseArray("1]", 0) => ParseResult.Ok(Json.JsonList([Json.JsonInt(1)]), 2)

fn parseArrayElems(s: String, pos: Int, acc: List<Json>) -> ParseResult
    ? "JSON helper: parseArrayElems."
    match parseValue(s, pos)
        ParseResult.Err(msg, p) -> ParseResult.Err(msg, p)
        ParseResult.Ok(val, p) -> parseArrayNext(s, skipWs(s, p), List.concat(acc, [val]))

verify parseArrayElems
    parseArrayElems("x]", 0, []) => ParseResult.Err("Unexpected character: x", 0)
    parseArrayElems("1]", 0, []) => ParseResult.Ok(Json.JsonList([Json.JsonInt(1)]), 2)

verify parseArrayElems law renderJsonListElemsRoundtrip
    given items: List<Json> = [
        [Json.JsonInt(1)],
        [Json.JsonString("hi"), Json.JsonBool(false)],
        [Json.JsonList([Json.JsonInt(1)]), Json.JsonObject({"ok" => Json.JsonBool(true)})]
    ]
    when nonEmptyJsonListRoundtripSafe(items)
    parseArrayElems(renderJsonList(items) + "]", 0, []) => ParseResult.Ok(Json.JsonList(items), String.len(renderJsonList(items)) + 1)

fn parseArrayNext(s: String, pos: Int, acc: List<Json>) -> ParseResult
    ? "JSON helper: parseArrayNext."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unterminated array", pos)
        Option.Some(c) -> match c
            "]" -> ParseResult.Ok(Json.JsonList(acc), pos + 1)
            "," -> parseArrayElems(s, skipWs(s, pos + 1), acc)
            _ -> ParseResult.Err("Expected ',' or ']'", pos)

verify parseArrayNext
    parseArrayNext("", 0, []) => ParseResult.Err("Unterminated array", 0)
    parseArrayNext("]", 0, [Json.JsonInt(1)]) => ParseResult.Ok(Json.JsonList([Json.JsonInt(1)]), 1)
    parseArrayNext(",2]", 0, [Json.JsonInt(1)]) => ParseResult.Ok(Json.JsonList([Json.JsonInt(1), Json.JsonInt(2)]), 3)
    parseArrayNext("x", 0, []) => ParseResult.Err("Expected ',' or ']'", 0)

fn emptyJsonMap() -> Map<String, Json>
    ? "JSON helper: emptyJsonMap."
    {}

fn parseObject(s: String, pos: Int) -> ParseResult
    ? "JSON helper: parseObject."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unterminated object", pos)
        Option.Some(c) -> match c
            "}}" -> ParseResult.Ok(Json.JsonObject(emptyJsonMap()), pos + 1)
            _ -> parseObjFields(s, pos, emptyJsonMap())

verify parseObject
    parseObject("", 0) => ParseResult.Err("Unterminated object", 0)
    parseObject("}}", 0) => ParseResult.Ok(Json.JsonObject(emptyJsonMap()), 1)
    parseObject("\"a\":1}}", 0) => ParseResult.Ok(Json.JsonObject({"a" => Json.JsonInt(1)}), 6)

fn parseObjFields(s: String, pos: Int, acc: Map<String, Json>) -> ParseResult
    ? "JSON helper: parseObjFields."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unterminated object", pos)
        Option.Some(c) -> match c
            "\"" -> parseObjKey(s, pos + 1, acc)
            _ -> ParseResult.Err("Expected string key", pos)

verify parseObjFields
    parseObjFields("", 0, emptyJsonMap()) => ParseResult.Err("Unterminated object", 0)
    parseObjFields("\"a\":1}}", 0, emptyJsonMap()) => ParseResult.Ok(Json.JsonObject({"a" => Json.JsonInt(1)}), 6)
    parseObjFields("x", 0, emptyJsonMap()) => ParseResult.Err("Expected string key", 0)

verify parseObjFields law renderJsonEntriesFieldsRoundtrip
    given entries: List<(String, Json)> = [
        [("a", Json.JsonInt(1))],
        [("a", Json.JsonBool(false)), ("nested", Json.JsonList([Json.JsonString("x")]))],
        [("quote\"", Json.JsonString("a\"b")), ("newline", Json.JsonString("line\nx"))]
    ]
    when nonEmptyJsonEntriesRoundtripSafe(entries)
    parseObjFields(renderJsonEntries(entries) + "}}", 0, emptyJsonMap()) => ParseResult.Ok(Json.JsonObject(Map.fromList(entries)), String.len(renderJsonEntries(entries)) + 1)

fn parseObjKey(s: String, pos: Int, acc: Map<String, Json>) -> ParseResult
    ? "JSON helper: parseObjKey."
    match parseString(s, pos)
        ParseResult.Err(msg, p) -> ParseResult.Err(msg, p)
        ParseResult.Ok(keyJson, p) -> parseObjKeyValue(s, p, acc, keyJson)

verify parseObjKey
    parseObjKey("", 0, emptyJsonMap()) => ParseResult.Err("Unterminated string", 0)
    parseObjKey("a\":1}}", 0, emptyJsonMap()) => ParseResult.Ok(Json.JsonObject({"a" => Json.JsonInt(1)}), 5)

fn parseObjKeyValue(s: String, pos: Int, acc: Map<String, Json>, keyJson: Json) -> ParseResult
    ? "JSON helper: parseObjKeyValue."
    match keyJson
        Json.JsonString(key) -> parseObjColon(s, skipWs(s, pos), acc, key)
        _ -> ParseResult.Err("Expected string key", pos)

verify parseObjKeyValue
    parseObjKeyValue(":1}}", 0, emptyJsonMap(), Json.JsonString("a")) => ParseResult.Ok(Json.JsonObject({"a" => Json.JsonInt(1)}), 3)
    parseObjKeyValue(":1}}", 0, emptyJsonMap(), Json.JsonInt(1)) => ParseResult.Err("Expected string key", 0)

verify parseObjKeyValue law valueRoundtrip
    given entry: (String, Json) = [
        ("a", Json.JsonInt(1)),
        ("quote\"", Json.JsonBool(false)),
        ("newline", Json.JsonString("a\"b")),
        ("emoji😀", Json.JsonList([Json.JsonString("x")]))
    ]
    when jsonEntryRoundtripSafe(entry)
    parseObjKeyValue(":" + toString(jsonEntryValue(entry)) + "}}", 0, emptyJsonMap(), Json.JsonString(jsonEntryKey(entry))) => ParseResult.Ok(Json.JsonObject(Map.fromList(singletonJsonEntries(entry))), String.len(toString(jsonEntryValue(entry))) + 2)

fn parseObjColon(s: String, pos: Int, acc: Map<String, Json>, key: String) -> ParseResult
    ? "JSON helper: parseObjColon."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unterminated object", pos)
        Option.Some(c) -> match c
            ":" -> parseObjVal(s, skipWs(s, pos + 1), acc, key)
            _ -> ParseResult.Err("Expected ':'", pos)

verify parseObjColon
    parseObjColon("", 0, emptyJsonMap(), "a") => ParseResult.Err("Unterminated object", 0)
    parseObjColon(":1}}", 0, emptyJsonMap(), "a") => ParseResult.Ok(Json.JsonObject({"a" => Json.JsonInt(1)}), 3)
    parseObjColon("x", 0, emptyJsonMap(), "a") => ParseResult.Err("Expected ':'", 0)

fn parseObjVal(s: String, pos: Int, acc: Map<String, Json>, key: String) -> ParseResult
    ? "JSON helper: parseObjVal."
    match parseValue(s, pos)
        ParseResult.Err(msg, p) -> ParseResult.Err(msg, p)
        ParseResult.Ok(val, p) -> parseObjNext(s, skipWs(s, p), Map.set(acc, key, val))

verify parseObjVal
    parseObjVal("x}}", 0, emptyJsonMap(), "a") => ParseResult.Err("Unexpected character: x", 0)
    parseObjVal("1}}", 0, emptyJsonMap(), "a") => ParseResult.Ok(Json.JsonObject({"a" => Json.JsonInt(1)}), 2)

fn parseObjNext(s: String, pos: Int, acc: Map<String, Json>) -> ParseResult
    ? "JSON helper: parseObjNext."
    match String.charAt(s, pos)
        Option.None -> ParseResult.Err("Unterminated object", pos)
        Option.Some(c) -> match c
            "}}" -> ParseResult.Ok(Json.JsonObject(acc), pos + 1)
            "," -> parseObjFields(s, skipWs(s, pos + 1), acc)
            _ -> ParseResult.Err("Expected ',' or '}'", pos)

verify parseObjNext
    parseObjNext("", 0, emptyJsonMap()) => ParseResult.Err("Unterminated object", 0)
    parseObjNext("}}", 0, {"a" => Json.JsonInt(1)}) => ParseResult.Ok(Json.JsonObject({"a" => Json.JsonInt(1)}), 1)
    parseObjNext(",\"b\":2}}", 0, {"a" => Json.JsonInt(1)}) => ParseResult.Ok(Json.JsonObject({"a" => Json.JsonInt(1), "b" => Json.JsonInt(2)}), 7)
    parseObjNext("x", 0, emptyJsonMap()) => ParseResult.Err("Expected ',' or '}'", 0)

// ── Roundtrip law layers ──────────────────────────────────────────

fn getField(j: Json, key: String) -> Option<Json>
    ? "JSON helper: getField."
    match j
        Json.JsonObject(m) -> Map.get(m, key)
        _ -> Option.None

verify getField
    getField(Json.JsonObject({"a" => Json.JsonInt(1)}), "a") => Option.Some(Json.JsonInt(1))
    getField(Json.JsonInt(1), "a") => Option.None

fn jsonStr(j: Json) -> String
    ? "JSON helper: jsonStr."
    match j
        Json.JsonString(s) -> s
        _ -> ""

verify jsonStr
    jsonStr(Json.JsonString("x")) => "x"
    jsonStr(Json.JsonInt(1)) => ""

fn jsonInt(j: Json) -> Int
    ? "JSON helper: jsonInt."
    match j
        Json.JsonInt(n) -> n
        _ -> 0

verify jsonInt
    jsonInt(Json.JsonInt(42)) => 42
    jsonInt(Json.JsonString("x")) => 0

fn jsonFloat(j: Json) -> Float
    ? "JSON helper: jsonFloat."
    match j
        Json.JsonFloat(f) -> f
        _ -> 0.0

verify jsonFloat
    jsonFloat(Json.JsonFloat(3.5)) => 3.5
    jsonFloat(Json.JsonString("x")) => 0.0

fn jsonList(j: Json) -> List<Json>
    ? "JSON helper: jsonList."
    match j
        Json.JsonList(items) -> items
        _ -> []

verify jsonList
    jsonList(Json.JsonList([Json.JsonInt(1)])) => [Json.JsonInt(1)]
    jsonList(Json.JsonInt(1)) => []

fn renderJsonStringList(items: List<Json>) -> String
    ? "Formats a JSON string list as a human-readable comma-separated line."
    match items
        [] -> ""
        [item, ..rest] -> match rest
            [] -> jsonStr(item)
            _ -> "{jsonStr(item)}, {renderJsonStringList(rest)}"

verify renderJsonStringList
    renderJsonStringList([]) => ""
    renderJsonStringList([Json.JsonString("Jan"), Json.JsonString("Anna")]) => "Jan, Anna"

fn main() -> Unit
    ! [Console.print]
    json = "{{ \"name\": \"Aver Labs\", \"score\": 9.75, \"motto\": \"caf\\u00e9 au code\", \"team\": [\"Jan\", \"Anna\"] }}"
    Console.print("Parsing JSON...")
    match fromString(json)
        Result.Err(msg) -> Console.print("Error: " + msg)
        Result.Ok(root) -> printResult(root)

fn printResult(root: Json) -> Unit
    ? "JSON helper: printResult."
    ! [Console.print]
    match getField(root, "name")
        Option.Some(v) -> Console.print("Name: " + jsonStr(v))
        Option.None -> Console.print("Name: ?")
    match getField(root, "score")
        Option.Some(v) -> Console.print("Score: " + String.fromFloat(jsonFloat(v)))
        Option.None -> Console.print("Score: ?")
    match getField(root, "motto")
        Option.Some(v) -> Console.print("Motto: " + jsonStr(v))
        Option.None -> Console.print("Motto: ?")
    match getField(root, "team")
        Option.Some(t) -> Console.print("Team: " + renderJsonStringList(jsonList(t)))
        Option.None -> Console.print("Team: ?")
