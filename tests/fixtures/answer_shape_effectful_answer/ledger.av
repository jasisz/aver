module Ledger
    intent = "An answer module that prints while it answers."
    depends [Pool]
    exposes [State, claim, gone]
    effects [Console]
    answers [Pool]

record State
    free: List<Int>
    stopping: Bool

fn claim(state: State, key: Int) -> Tuple<State, Result<Pool.Assignment, Run.Wake>>
    ? "The next height for this peer, announced as it is handed out."
    ! [Console.print]
    Console.print("claim {key}")
    (state, Result.Ok(Pool.Assignment.Idle))

fn gone(state: State, key: Int) -> Tuple<State, Result<Unit, Run.Wake>>
    ? "A peer that left gives its height back."
    (state, Result.Ok(Unit))
