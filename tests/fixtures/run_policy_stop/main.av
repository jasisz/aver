module Node
    intent = "The stop policy ends the run while its process is still seated."
    depends [Wait]
    effects [Console.print, yield]

type Pending
    Ticking(Int, Wait.Wake)

record View
    pending: Map<Int, Pending>
    ready: List<Int>
    askable: List<Int>
    jobs: Int
    stopping: Bool

fn ticking() -> Unit
    ? "Print once when seated; the policy stops before the next iteration."
    ! [Console.print, yield]
    Console.print("seated")
    ticking()

fn order(view: View) -> List<Int>
    Map.keys(view.pending)

fn admit(view: View, id: Int) -> Bool
    List.contains(view.askable, id)

fn stop(view: View) -> Bool
    Map.len(view.pending) > 0
