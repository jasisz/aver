    planTaskCommand("Reopened task '{taskId}'", context.project, context.persistedEvents, primaryEvent, now)

fn planChangePriority(taskId: String, priority: Priority) -> Result<CommandPlan, String>
    ? "Decides a priority change event and derives follow-up rule effects."
    ! [Disk.readText, Time.now]
    context = loadActiveTaskContext(taskId)?
