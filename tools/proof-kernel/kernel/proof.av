module Proof
    intent =
        "Proof steps, definitions (local bindings, then one expression), module-level bindings, cited"
        "laws and the script that ties them"
        "to one obligation."
        "Each step names its rule and writes out every instance; see src/ir/proof_steps/mod.rs."
    exposes [Proof, Case, SplitCase, More, IhAt, Def, Const, Variant, Law, Fact, Script, Hyp, Given, premiseOf]
    depends [Kernel.Term]
    effects []

type Proof
    PRefl(Term)
    PSymm(Proof)
    PTrans(List<Term>, List<Proof>)
    PCongr(Term, Proof)
    PUnfold(String, Int, List<Term>, List<Term>, List<Proof>)
    PConst(String)
    PArm(Int, List<Term>, Term, Proof)
    PProj(Term)
    PCell(Term)
    PHyp(String)
    PRule(String, List<Binding>, List<Proof>)
    PLaw(String, List<Binding>, List<Proof>)
    PCompute(Term, Term)
    PCases(Term, String, Proof, Proof)
    PSplit(String, List<Term>, Term, String, List<SplitCase>)
    PHave(String, Term, Proof, Proof)
    PEnum(String, Term, Term, List<Proof>)
    PAbsurd(Proof, Term, Term)
    PInduct(String, List<Term>, Term, Term, List<String>, List<Case>)
    PListInduct(String, Term, Term, Proof, String, String, List<String>, List<IhAt>, Proof)
    PRing(Term, Term)
    PLinear(Term, Bool, List<String>, List<Int>)

record Case
    binders: List<String>
    ihs: List<String>
    carry: List<List<Proof>>
    more: List<More>
    proof: Proof

record SplitCase
    ctor: String
    binders: List<String>
    proof: Proof

record More
    call: Int
    ih: IhAt

record IhAt
    name: String
    at: List<Term>
    carry: List<Proof>

record Def
    name: String
    returnsBool: Bool
    params: List<String>
    lets: List<Binding>
    body: Term

record Const
    name: String
    value: Term

record Variant
    name: String
    arity: Int

record Law
    key: String
    givens: List<String>
    premise: List<Term>
    lhs: Term
    rhs: Term

record Fact
    law: Law
    lists: List<String>
    proof: Proof

record Given
    name: String
    fin: Fin

record Script
    obligation: Law
    finite: List<Given>
    lists: List<String>
    ints: List<String>
    defs: List<Def>
    consts: List<Const>
    sums: List<List<Variant>>
    laws: List<Law>
    facts: List<Fact>
    proof: Proof

record Hyp
    name: String
    eqn: Eqn

fn premiseOf(law: Law) -> Option<Term>
    ? "A law's when, if it has one."
    match law.premise
        [p, ..rest] -> Option.Some(p)
        [] -> Option.None

verify premiseOf
    premiseOf(Law(key = "k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(1))) => Option.None
