module Value
    intent =
        "Runtime values for the mini interpreter."
    exposes [Val, valRepr]

type Val
    ValInt(Int)
    ValStr(String)
    ValBool(Bool)
    ValList(List<Val>)
    ValOk(Val)
    ValErr(Val)
    ValSome(Val)
    ValNone
    ValTuple(List<Val>)
    ValRecord(String, List<(String, Val)>)
    ValVariant(String, String, List<Val>)
    ValUnit

fn valListRepr(items: List<Val>, acc: String, first: Bool) -> String
    ? "Build list repr recursively."
    match items
        [] -> "[{acc}]"
        [v, ..rest] -> match first
            true -> valListRepr(rest, valRepr(v), false)
            false -> valListRepr(rest, acc + ", " + valRepr(v), false)

fn valRepr(v: Val) -> String
    ? "Display representation of a runtime value."
    match v
        Val.ValInt(n) -> Int.toString(n)
        Val.ValStr(s) -> s
        Val.ValBool(b) -> String.fromBool(b)
        Val.ValList(items) -> valListRepr(items, "", true)
        Val.ValOk(inner) -> "Result.Ok({valRepr(inner)})"
        Val.ValErr(inner) -> "Result.Err({valRepr(inner)})"
        Val.ValTuple(items) -> "({valFieldsRepr(items, "", true)})"
        Val.ValSome(inner) -> "Option.Some({valRepr(inner)})"
        Val.ValNone -> "Option.None"
        Val.ValRecord(name, _) -> "{name}(...)"
        Val.ValVariant(typeName, ctorName, fields) -> valVariantRepr(typeName, ctorName, fields)
        Val.ValUnit -> "()"

verify valRepr
    valRepr(Val.ValInt(42)) => "42"
    valRepr(Val.ValStr("hello")) => "hello"
    valRepr(Val.ValBool(true)) => "true"
    valRepr(Val.ValUnit) => "()"

fn valVariantRepr(typeName: String, ctorName: String, fields: List<Val>) -> String
    ? "Display a variant value."
    match fields
        [] -> "{typeName}.{ctorName}"
        _ -> "{typeName}.{ctorName}({valFieldsRepr(fields, "", true)})"

fn valFieldsRepr(items: List<Val>, acc: String, first: Bool) -> String
    ? "Build comma-separated repr of variant fields."
    match items
        [] -> acc
        [v, ..rest] -> match first
            true -> valFieldsRepr(rest, valRepr(v), false)
            false -> valFieldsRepr(rest, acc + ", " + valRepr(v), false)
