module Proof
    intent =
        "Proof steps, definitions (local bindings, then one expression), module-level bindings, cited"
        "laws and the script that ties them"
        "to one obligation."
        "A goal is a script without its proof: what a project's proof plan is given to prove,"
        "with the hypotheses in scope where it is posed and what the list givens hold."
        "Each step names its rule and writes out every instance; see src/ir/proof_steps/mod.rs."
        "A linear step's cuts each divide a weighted sum of the rows before it by a divisor, its"
        "constant rounded down, which holds because every atom is an integer."
    exposes [Proof, Cut, Case, SplitCase, More, IhAt, Def, Const, Variant, Sum, Rec, FnSig, Law, Fact, Script, Goal, Given, Hyp, premiseOf, givenNames, findDef, variantNames]
    depends [Kernel.Term]
    effects []

type Proof
    PRefl(Term)
    PSymm(Proof)
    PTrans(List<Term>, List<Proof>)
    PCongr(Term, Proof)
    PUnfold(String, Int, List<Term>, List<Term>, List<Proof>)
    PConst(String)
    PArm(Int, List<Term>, Term, Proof)
    PProj(Term)
    PCell(Term)
    PHyp(String)
    PRule(String, List<Binding>, List<Proof>)
    PLaw(String, List<Binding>, List<Proof>)
    PCompute(Term, Term)
    PCases(Term, String, Proof, Proof)
    PSplit(Term, String, List<Term>, List<SplitCase>)
    PHave(String, Term, Proof, Proof)
    PEnum(String, Term, Term, List<Proof>)
    PAbsurd(Proof, Term, Term)
    PInduct(String, List<Term>, Term, Term, List<String>, List<Case>)
    PListInduct(String, Term, Term, List<String>, Proof, String, String, List<String>, List<IhAt>, Proof)
    PListCases(String, Term, Term, Proof, String, String, Proof)
    PRing(Term, Term)
    PLinear(Term, Bool, List<String>, List<Int>, List<Cut>)

record Cut
    divisor: Int
    weights: List<Int>

record Case
    binders: List<String>
    ihs: List<String>
    carry: List<List<Proof>>
    more: List<More>
    proof: Proof

record SplitCase
    ctor: String
    binders: List<String>
    proof: Proof

record More
    call: Int
    ih: IhAt

record IhAt
    name: String
    at: List<Term>
    carry: List<Proof>

record Def
    name: String
    params: List<TypedVar>
    ret: Ty
    lets: List<Binding>
    body: Term

record Const
    name: String
    ty: Ty
    value: Term

record Variant
    name: String
    fields: List<Ty>

record Sum
    name: String
    eq: Bool
    variants: List<Variant>

record Rec
    name: String
    eq: Bool
    fields: List<TypedVar>

record FnSig
    name: String
    params: List<Ty>
    ret: Ty

record Law
    key: String
    givens: List<TypedVar>
    premise: List<Term>
    lhs: Term
    rhs: Term

record Fact
    law: Law
    proof: Proof

record Script
    obligation: Law
    defs: List<Def>
    consts: List<Const>
    sums: List<Sum>
    recs: List<Rec>
    sigs: List<FnSig>
    laws: List<Law>
    facts: List<Fact>
    proof: Proof

record Given
    name: String
    fin: Fin

record Goal
    obligation: Law
    finite: List<Given>
    lists: List<String>
    ints: List<String>
    defs: List<Def>
    consts: List<Const>
    sums: List<Sum>
    recs: List<Rec>
    laws: List<Law>
    facts: List<Fact>
    hyps: List<Hyp>

record Hyp
    name: String
    eqn: Eqn

fn premiseOf(law: Law) -> Option<Term>
    ? "A law's when, if it has one."
    match law.premise
        [p, ..rest] -> Option.Some(p)
        [] -> Option.None

verify premiseOf
    premiseOf(Law(key = "k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(1))) => Option.None

fn givenNames(gs: List<TypedVar>) -> List<String>
    ? "The names of typed variables, in order."
    match gs
        [] -> []
        [g, ..rest] -> List.prepend(g.name, givenNames(rest))

verify givenNames
    givenNames([Kernel.Term.typed("n", Ty.TyInt)]) => ["n"]

fn findDef(name: String, ds: List<Def>) -> Option<Def>
    ? "A definition by name."
    match ds
        [] -> Option.None
        [d, ..rest] -> match d.name == name
            true -> Option.Some(d)
            false -> findDef(name, rest)

verify findDef
    findDef("f", []) => Option.None

fn variantNames(vs: List<Variant>) -> List<String>
    ? "The constructors of a sum, in order."
    match vs
        [] -> []
        [v, ..rest] -> List.prepend(v.name, variantNames(rest))

verify variantNames
    variantNames([Variant(name = "C.A", fields = [])]) => ["C.A"]
