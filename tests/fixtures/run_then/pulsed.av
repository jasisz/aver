module Pulsed
    intent = "Count each ask, saving its answer before the wake."
    depends [Pulse, Wait]
    exposes [State, fresh, next, done, unused]
    effects []

record State
    asked: Int

fn fresh() -> State
    ? "No request has been asked."
    State(asked = 0)

fn next(state: State, base: Int) -> Tuple<State, Pulse.NextReply>
    ? "Count this ask exactly once and hold its result for five milliseconds."
    updated = State.update(state, asked = state.asked + 1)
    (updated, Pulse.NextReply.Then(Wait.Wake.After(5), base + updated.asked))

verify next
    next(fresh(), 10) => (State(asked = 1), Pulse.NextReply.Then(Wait.Wake.After(5), 11))

fn done(state: State) -> Tuple<State, Pulse.DoneReply>
    ? "Save a Unit reply without changing the counter."
    (state, Pulse.DoneReply.Then(Wait.Wake.NextTurn, Unit))

verify done
    done(fresh()) => (fresh(), Pulse.DoneReply.Then(Wait.Wake.NextTurn, Unit))

fn unused() -> Int
    ? "Deliberately unused export for the warning regression."
    42

verify unused
    unused() => 42
