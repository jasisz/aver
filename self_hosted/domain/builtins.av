    builtinMapHas([Val.ValMap(Map.set({}, "a", Val.ValInt(1))), Val.ValStr("a")]) => Result.Ok(Val.ValBool(true))
    builtinMapHas([Val.ValMap({}), Val.ValStr("a")]) => Result.Ok(Val.ValBool(false))
    builtinMapHas([]) => Result.Err("expected 2 arguments")

fn builtinMapHasInner(mapV: Val, keyV: Val) -> Result<Val, String>
    ? "Check if key exists in map. O(1)."
    match mapV
        Val.ValMap(m) -> Result.Ok(Val.ValBool(Map.has(m, Domain.Value.mapKeyRepr(keyV))))
        _ -> Result.Err("Map.has requires a Map")

verify builtinMapHasInner
    builtinMapHasInner(Val.ValMap(Map.set({}, "x", Val.ValInt(1))), Val.ValStr("x")) => Result.Ok(Val.ValBool(true))
    builtinMapHasInner(Val.ValMap({}), Val.ValStr("x")) => Result.Ok(Val.ValBool(false))
    builtinMapHasInner(Val.ValInt(1), Val.ValStr("x")) => Result.Err("Map.has requires a Map")

fn builtinTimeNow(args: List<Val>) -> Result<Val, String>
    ? "Time.now() -> ISO timestamp string."
    ! [Time.now]
    Result.Ok(Val.ValStr(Time.now()))

fn builtinHttpSimple(args: List<Val>, method: String) -> Result<Val, String>
    ? "Http.get/head/delete(url) -> Result<Http.Response, String> forwarded to host."
    ! [Http.delete, Http.get, Http.head]
    v = Domain.Builtins.Helpers.oneArg(args)?
    url = Domain.Builtins.Helpers.expectStr(v)?
    match method
        "get" -> Result.Ok(httpResponseToVal(Http.get(url)))
        "head" -> Result.Ok(httpResponseToVal(Http.head(url)))
        _ -> Result.Ok(httpResponseToVal(Http.delete(url)))

fn builtinHttpBody(args: List<Val>, method: String) -> Result<Val, String>
    ? "Http.post/put/patch(url, body, contentType, headers) forwarded to host."
    ! [Http.patch, Http.post, Http.put]
    match args
        [urlV, ..r1] -> match r1
            [bodyV, ..r2] -> match r2
                [ctV, ..r3] -> match r3
                    [hdrsV, ..r4] -> builtinHttpBodyInner(urlV, bodyV, ctV, hdrsV, method)
                    _ -> Result.Err("Http method takes 4 arguments")
                _ -> Result.Err("Http method takes 4 arguments")
            _ -> Result.Err("Http method takes 4 arguments")
        _ -> Result.Err("Http method takes 4 arguments")

fn builtinHttpBodyInner(urlV: Val, bodyV: Val, ctV: Val, hdrsV: Val, method: String) -> Result<Val, String>
    ? "Inner Http body method."
    ! [Http.patch, Http.post, Http.put]
    url = Domain.Builtins.Helpers.expectStr(urlV)?
    body = Domain.Builtins.Helpers.expectStr(bodyV)?
    ct = Domain.Builtins.Helpers.expectStr(ctV)?
    match method
        "post" -> Result.Ok(httpResponseToVal(Http.post(url, body, ct, {})))
        "put" -> Result.Ok(httpResponseToVal(Http.put(url, body, ct, {})))
        _ -> Result.Ok(httpResponseToVal(Http.patch(url, body, ct, {})))

fn httpResponseToVal(result: Result<Http.Response, String>) -> Val
    ? "Convert host Http.Response to Val."
    match result
        Result.Ok(resp) -> Val.ValOk(Val.ValRecord("Http.Response", [("status", Val.ValInt(resp.status)), ("body", Val.ValStr(resp.body)), ("headers", headersToVal(resp.headers))]))
        Result.Err(e) -> Val.ValErr(Val.ValStr(e))

verify httpResponseToVal
    httpResponseToVal(Result.Err("fail")) => Val.ValErr(Val.ValStr("fail"))
    httpResponseToVal(Result.Ok(Http.Response(status = 200, body = "ok", headers = {}))) => Val.ValOk(Val.ValRecord("Http.Response", [("status", Val.ValInt(200)), ("body", Val.ValStr("ok")), ("headers", Val.ValMap({}))]))

fn headersToVal(headers: Map<String, List<String>>) -> Val
    ? "Convert host headers Map<String, List<String>> to a Val.ValMap whose values are Val.ValList of Val.ValStr."
    Val.ValMap(headersToValMap(headers, Map.keys(headers), {}))

fn headersToValMap(headers: Map<String, List<String>>, names: List<String>, acc: Map<String, Val>) -> Map<String, Val>
    ? "Walk header keys, converting each value list to a Val.ValList."
    match names
        [] -> acc
        [name, ..rest] -> match Map.get(headers, name)
            Option.Some(values) -> headersToValMap(headers, rest, Map.set(acc, name, Val.ValList(stringsToValStrs(values, []))))
            Option.None -> headersToValMap(headers, rest, Map.set(acc, name, Val.ValList([])))

fn stringsToValStrs(values: List<String>, acc: List<Val>) -> List<Val>
    ? "Convert a list of strings into a list of Val.ValStr (tail-recursive)."
    match values
        [] -> List.reverse(acc)
        [v, ..rest] -> stringsToValStrs(rest, List.prepend(Val.ValStr(v), acc))

verify stringsToValStrs
    stringsToValStrs([], []) => []
    stringsToValStrs(["a", "b"], []) => [Val.ValStr("a"), Val.ValStr("b")]

verify headersToValMap
    headersToValMap({}, [], {}) => {}
    headersToValMap({"x" => ["Y"]}, ["x"], {}) => {"x" => Val.ValList([Val.ValStr("Y")])}

verify headersToVal
    headersToVal({}) => Val.ValMap({})
    headersToVal({"x" => ["Y"]}) => Val.ValMap({"x" => Val.ValList([Val.ValStr("Y")])})

fn builtinTcpSend(args: List<Val>) -> Result<Val, String>
    ? "Tcp.send(host, port, message) -> Result<String, String>."
    ! [Tcp.send]
    match args
        [hostV, ..r1] -> match r1
            [portV, ..r2] -> match r2
                [msgV, ..r3] -> builtinTcpSendInner(hostV, portV, msgV)
                _ -> Result.Err("Tcp.send takes 3 arguments")
            _ -> Result.Err("Tcp.send takes 3 arguments")
        _ -> Result.Err("Tcp.send takes 3 arguments")

fn builtinTcpSendInner(hostV: Val, portV: Val, msgV: Val) -> Result<Val, String>
    ? "Inner Tcp.send."
    ! [Tcp.send]
    host = Domain.Builtins.Helpers.expectStr(hostV)?
    port = Domain.Builtins.Helpers.expectInt(portV)?
    msg = Domain.Builtins.Helpers.expectStr(msgV)?
    match Tcp.send(host, port, msg)
        Result.Ok(resp) -> Result.Ok(Val.ValOk(Val.ValStr(resp)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpPing(args: List<Val>) -> Result<Val, String>
    ? "Tcp.ping(host, port) -> Result<Unit, String>."
    ! [Tcp.ping]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (hostV, portV) -> builtinTcpPingInner(hostV, portV)

fn builtinTcpPingInner(hostV: Val, portV: Val) -> Result<Val, String>
    ? "Inner Tcp.ping."
    ! [Tcp.ping]
    host = Domain.Builtins.Helpers.expectStr(hostV)?
    port = Domain.Builtins.Helpers.expectInt(portV)?
    match Tcp.ping(host, port)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpConnect(args: List<Val>) -> Result<Val, String>
    ? "Tcp.connect(host, port) -> Result<Tcp.Connection, String>."
    ! [Tcp.connect]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (hostV, portV) -> builtinTcpConnectInner(hostV, portV)

fn builtinTcpConnectInner(hostV: Val, portV: Val) -> Result<Val, String>
    ? "Inner Tcp.connect."
    ! [Tcp.connect]
    host = Domain.Builtins.Helpers.expectStr(hostV)?
    port = Domain.Builtins.Helpers.expectInt(portV)?
    match Tcp.connect(host, port)
        Result.Ok(conn) -> Result.Ok(Val.ValOk(tcpConnToVal(conn)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn tcpConnToVal(conn: Tcp.Connection) -> Val
    ? "Preserve an opaque host Tcp.Connection resource inside Val."
    Val.ValTcpConnection(conn)

fn valToTcpConn(v: Val) -> Result<Tcp.Connection, String>
    ? "Recover an opaque host Tcp.Connection resource from Val."
    match v
        Val.ValTcpConnection(conn) -> Result.Ok(conn)
        _ -> Result.Err("expected Tcp.Connection resource")

verify valToTcpConn
    valToTcpConn(Val.ValInt(1)) => Result.Err("expected Tcp.Connection resource")

fn builtinTcpBeginConnect(args: List<Val>) -> Result<Val, String>
    ? "Tcp.beginConnect(host, port) -> Result<Tcp.Dial, String>."
    ! [Tcp.beginConnect]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (hostV, portV) -> builtinTcpBeginConnectInner(hostV, portV)

fn builtinTcpBeginConnectInner(hostV: Val, portV: Val) -> Result<Val, String>
    ? "Inner Tcp.beginConnect."
    ! [Tcp.beginConnect]
    host = Domain.Builtins.Helpers.expectStr(hostV)?
    port = Domain.Builtins.Helpers.expectInt(portV)?
    match Tcp.beginConnect(host, port)
        Result.Ok(dial) -> Result.Ok(Val.ValOk(Val.ValTcpDial(dial)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn valToTcpDial(v: Val) -> Result<Tcp.Dial, String>
    ? "Recover an opaque host Tcp.Dial resource from Val."
    match v
        Val.ValTcpDial(dial) -> Result.Ok(dial)
        _ -> Result.Err("expected Tcp.Dial resource")

verify valToTcpDial
    valToTcpDial(Val.ValInt(1)) => Result.Err("expected Tcp.Dial resource")

fn builtinTcpDialled(args: List<Val>) -> Result<Val, String>
    ? "Tcp.dialled(dial) -> Result<Option<Tcp.Connection>, String>."
    ! [Tcp.dialled]
    v = Domain.Builtins.Helpers.oneArg(args)?
    dial = valToTcpDial(v)?
    match Tcp.dialled(dial)
        Result.Ok(settled) -> match settled
            Option.None -> Result.Ok(Val.ValOk(Val.ValNone))
            Option.Some(conn) -> Result.Ok(Val.ValOk(Val.ValSome(tcpConnToVal(conn))))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpListen(args: List<Val>) -> Result<Val, String>
    ? "Tcp.listen(port, backlog) -> Result<Tcp.Listener, String>."
    ! [Tcp.listen]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (portV, backlogV) -> builtinTcpListenInner(portV, backlogV)

fn builtinTcpListenInner(portV: Val, backlogV: Val) -> Result<Val, String>
    ? "Inner Tcp.listen."
    ! [Tcp.listen]
    port = Domain.Builtins.Helpers.expectInt(portV)?
    backlog = Domain.Builtins.Helpers.expectInt(backlogV)?
    match Tcp.listen(port, backlog)
        Result.Ok(listener) -> Result.Ok(Val.ValOk(Val.ValTcpListener(listener)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn valToTcpListener(v: Val) -> Result<Tcp.Listener, String>
    ? "Recover an opaque host Tcp.Listener resource from Val."
    match v
        Val.ValTcpListener(listener) -> Result.Ok(listener)
        _ -> Result.Err("expected Tcp.Listener resource")

verify valToTcpListener
    valToTcpListener(Val.ValInt(1)) => Result.Err("expected Tcp.Listener resource")

fn builtinTcpAccept(args: List<Val>) -> Result<Val, String>
    ? "Tcp.accept(listener) -> Result<Option<Tcp.Connection>, String>."
    ! [Tcp.accept]
    v = Domain.Builtins.Helpers.oneArg(args)?
    listener = valToTcpListener(v)?
    match Tcp.accept(listener)
        Result.Ok(accepted) -> match accepted
            Option.None -> Result.Ok(Val.ValOk(Val.ValNone))
            Option.Some(conn) -> Result.Ok(Val.ValOk(Val.ValSome(tcpConnToVal(conn))))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpPeerAddress(args: List<Val>) -> Result<Val, String>
    ? "Tcp.peerAddress(connection) -> Result<String, String>."
    ! [Tcp.peerAddress]
    v = Domain.Builtins.Helpers.oneArg(args)?
    connection = valToTcpConn(v)?
    match Tcp.peerAddress(connection)
        Result.Ok(address) -> Result.Ok(Val.ValOk(Val.ValStr(address)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn valToTcpSocket(v: Val) -> Result<Tcp.Socket, String>
    ? "Decode the self-host's nominal variant carrier into Tcp.Socket."
    match v
        Val.ValVariant(_, name, fields) -> valVariantToTcpSocket(name, fields)
        _ -> Result.Err("expected Tcp.Socket value")

verify valToTcpSocket
    valToTcpSocket(Val.ValInt(1)) => Result.Err("expected Tcp.Socket value")

fn valVariantToTcpSocket(name: String, fields: List<Val>) -> Result<Tcp.Socket, String>
    ? "Decode one named Tcp.Socket variant."
    match name
        "Tcp.Socket.Listening" -> match Domain.Builtins.Helpers.oneArg(fields)
            Result.Ok(listenerV) -> Result.Ok(Tcp.Socket.Listening(valToTcpListener(listenerV)?))
            Result.Err(_) -> Result.Err("Tcp.Socket.Listening takes one resource")
        "Tcp.Socket.Dialing" -> match Domain.Builtins.Helpers.oneArg(fields)
            Result.Ok(dialV) -> Result.Ok(Tcp.Socket.Dialing(valToTcpDial(dialV)?))
            Result.Err(_) -> Result.Err("Tcp.Socket.Dialing takes one resource")
        "Tcp.Socket.Connected" -> match Domain.Builtins.Helpers.oneArg(fields)
            Result.Ok(connV) -> Result.Ok(Tcp.Socket.Connected(valToTcpConn(connV)?))
            Result.Err(_) -> Result.Err("Tcp.Socket.Connected takes one resource")
        _ -> Result.Err("expected Tcp.Socket value")

verify valVariantToTcpSocket
    valVariantToTcpSocket("Other.State", []) => Result.Err("expected Tcp.Socket value")
    valVariantToTcpSocket("Tcp.Socket.Connected", []) => Result.Err("Tcp.Socket.Connected takes one resource")

fn tcpSocketEntriesToMap(entries: List<Tuple<String, Val>>, acc: Map<Int, Tcp.Socket>) -> Result<Map<Int, Tcp.Socket>, String>
    ? "Recover integer caller keys and typed socket states from a self-host Val map."
    match entries
        [] -> Result.Ok(acc)
        [pair, ..rest] -> match pair
            (keyText, socketV) -> tcpSocketEntriesToMap(rest, Map.set(acc, Int.fromString(keyText)?, valToTcpSocket(socketV)?))

verify tcpSocketEntriesToMap
    tcpSocketEntriesToMap([], {}) => Result.Ok({})

fn tcpReadyKeysToVals(keys: List<Int>, acc: List<Val>) -> List<Val>
    ? "Convert ready caller keys back into self-host values."
    match keys
        [] -> List.reverse(acc)
        [key, ..rest] -> tcpReadyKeysToVals(rest, List.prepend(Val.ValInt(key), acc))

verify tcpReadyKeysToVals
    tcpReadyKeysToVals([], []) => []
    tcpReadyKeysToVals([2, 7], []) => [Val.ValInt(2), Val.ValInt(7)]

fn builtinTcpPoll(args: List<Val>) -> Result<Val, String>
    ? "Tcp.poll(sockets, timeoutMs) over the single caller-owned socket map."
    ! [Tcp.poll]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (socketsV, timeoutV) -> match socketsV
            Val.ValMap(sockets) -> builtinTcpPollInner(sockets, timeoutV)
            _ -> Result.Err("Tcp.poll requires a Map as its first argument")

fn builtinTcpPollInner(sockets: Map<String, Val>, timeoutV: Val) -> Result<Val, String>
    ? "Inner Tcp.poll."
    ! [Tcp.poll]
    timeoutMs = Domain.Builtins.Helpers.expectInt(timeoutV)?
    typedSockets = tcpSocketEntriesToMap(Map.entries(sockets), {})?
    match Tcp.poll(typedSockets, timeoutMs)
        Result.Ok(keys) -> Result.Ok(Val.ValOk(Val.ValList(tcpReadyKeysToVals(keys, []))))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpCloseDial(args: List<Val>) -> Result<Val, String>
    ? "Tcp.closeDial(dial) -> Result<Unit, String>."
    ! [Tcp.closeDial]
    v = Domain.Builtins.Helpers.oneArg(args)?
    dial = valToTcpDial(v)?
    match Tcp.closeDial(dial)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpCloseListener(args: List<Val>) -> Result<Val, String>
    ? "Tcp.closeListener(listener) -> Result<Unit, String>."
    ! [Tcp.closeListener]
    v = Domain.Builtins.Helpers.oneArg(args)?
    listener = valToTcpListener(v)?
    match Tcp.closeListener(listener)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpWriteLine(args: List<Val>) -> Result<Val, String>
    ? "Tcp.writeLine(conn, line) -> Result<Unit, String>."
    ! [Tcp.writeLine]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (connV, lineV) -> builtinTcpWriteLineInner(connV, lineV)

fn builtinTcpWriteLineInner(connV: Val, lineV: Val) -> Result<Val, String>
    ? "Inner Tcp.writeLine."
    ! [Tcp.writeLine]
    tc = valToTcpConn(connV)?
    line = Domain.Builtins.Helpers.expectStr(lineV)?
    match Tcp.writeLine(tc, line)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpReadLine(args: List<Val>) -> Result<Val, String>
    ? "Tcp.readLine(conn) -> Result<String, String>."
    ! [Tcp.readLine]
    v = Domain.Builtins.Helpers.oneArg(args)?
    tc = valToTcpConn(v)?
    match Tcp.readLine(tc)
        Result.Ok(line) -> Result.Ok(Val.ValOk(Val.ValStr(line)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinTcpClose(args: List<Val>) -> Result<Val, String>
    ? "Tcp.close(conn) -> Result<Unit, String>."
    ! [Tcp.close]
    v = Domain.Builtins.Helpers.oneArg(args)?
    tc = valToTcpConn(v)?
    match Tcp.close(tc)
        Result.Ok(_) -> Result.Ok(Val.ValOk(Val.ValUnit))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))
