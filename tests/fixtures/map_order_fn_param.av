module MapOrderFnParam
    intent =
        "A claim that reads a map's iteration order through a function it was handed by name."
        "The observer is never written inside the claim's own text: viaHof applies whatever reader it is given, and the reader arrives as an argument — so the cone has to follow the name to find the observation. The map is built inside the reader and no signature mentions one, so once the walk arrives the key type is invisible as well. Both claims name the keys in the order they were WRITTEN, which is not the order the map iterates, so aver verify refutes both."
    effects []

fn builtKeys(v: Int) -> List<String>
    ? "Builds a two-key map in place and reads its keys in iteration order."
    m = Map.set(Map.set({}, "b", v), "a", 3)
    Map.keys(m)

fn viaHof(f: Fn(Int) -> List<String>, v: Int) -> List<String>
    ? "Applies the given reader."
    f(v)

verify viaHof
    viaHof(builtKeys, 5) => ["b", "a"]

verify viaHof law keysAsWritten
    given v: Int = [5, 7]
    viaHof(builtKeys, v) => ["b", "a"]
