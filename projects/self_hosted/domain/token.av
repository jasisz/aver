module Token
    intent =
        "Token types for the mini Aver lexer."
        "Covers a subset: Int, Bool, identifiers, operators, parens, keywords."
    exposes [Token, tokenRepr]

type Token
    TkInt(Int)
    TkFloat(Float)
    TkStr(String)
    TkIdent(String)
    TkTrue
    TkFalse
    TkPlus
    TkMinus
    TkStar
    TkSlash
    TkEq
    TkEqEq
    TkNeq
    TkLt
    TkGt
    TkLte
    TkGte
    TkLParen
    TkRParen
    TkComma
    TkArrow
    TkLBracket
    TkRBracket
    TkDot
    TkDotDot
    TkQuestion
    TkNewline
    TkInterpStart
    TkInterpEnd
    TkColon
    TkBang
    TkFatArrow
    TkIndent
    TkDedent
    TkFn
    TkMatch
    TkEof

fn tokenRepr(t: Token) -> String
    ? "Debug representation of a token."
    match t
        Token.TkInt(n) -> "Int({n})"
        Token.TkFloat(f) -> "Float"
        Token.TkStr(s) -> "Str({s})"
        Token.TkIdent(s) -> "Ident({s})"
        Token.TkTrue -> "True"
        Token.TkFalse -> "False"
        Token.TkPlus -> "Plus"
        Token.TkMinus -> "Minus"
        Token.TkStar -> "Star"
        Token.TkSlash -> "Slash"
        Token.TkEq -> "Eq"
        Token.TkEqEq -> "EqEq"
        Token.TkNeq -> "Neq"
        Token.TkLt -> "Lt"
        Token.TkGt -> "Gt"
        Token.TkLte -> "Lte"
        Token.TkGte -> "Gte"
        Token.TkLParen -> "LParen"
        Token.TkRParen -> "RParen"
        Token.TkComma -> "Comma"
        Token.TkArrow -> "Arrow"
        Token.TkLBracket -> "LBracket"
        Token.TkRBracket -> "RBracket"
        Token.TkDot -> "Dot"
        Token.TkDotDot -> "DotDot"
        Token.TkQuestion -> "Question"
        Token.TkNewline -> "Newline"
        Token.TkInterpStart -> "InterpStart"
        Token.TkInterpEnd -> "InterpEnd"
        Token.TkColon -> "Colon"
        Token.TkBang -> "Bang"
        Token.TkFatArrow -> "FatArrow"
        Token.TkIndent -> "Indent"
        Token.TkDedent -> "Dedent"
        Token.TkFn -> "Fn"
        Token.TkMatch -> "Match"
        Token.TkEof -> "Eof"

verify tokenRepr
    tokenRepr(Token.TkInt(42)) => "Int(42)"
    tokenRepr(Token.TkIdent("foo")) => "Ident(foo)"
    tokenRepr(Token.TkTrue) => "True"
    tokenRepr(Token.TkEqEq) => "EqEq"
    tokenRepr(Token.TkLt) => "Lt"
    tokenRepr(Token.TkEof) => "Eof"
    tokenRepr(Token.TkStr("hello")) => "Str(hello)"
    tokenRepr(Token.TkFalse) => "False"
    tokenRepr(Token.TkMinus) => "Minus"
    tokenRepr(Token.TkStar) => "Star"
    tokenRepr(Token.TkSlash) => "Slash"
    tokenRepr(Token.TkEq) => "Eq"
    tokenRepr(Token.TkNeq) => "Neq"
    tokenRepr(Token.TkGt) => "Gt"
    tokenRepr(Token.TkLte) => "Lte"
    tokenRepr(Token.TkGte) => "Gte"
    tokenRepr(Token.TkLParen) => "LParen"
    tokenRepr(Token.TkRParen) => "RParen"
    tokenRepr(Token.TkComma) => "Comma"
    tokenRepr(Token.TkArrow) => "Arrow"
    tokenRepr(Token.TkLBracket) => "LBracket"
    tokenRepr(Token.TkRBracket) => "RBracket"
    tokenRepr(Token.TkDot) => "Dot"
    tokenRepr(Token.TkDotDot) => "DotDot"
    tokenRepr(Token.TkQuestion) => "Question"
    tokenRepr(Token.TkNewline) => "Newline"
    tokenRepr(Token.TkInterpStart) => "InterpStart"
    tokenRepr(Token.TkInterpEnd) => "InterpEnd"
    tokenRepr(Token.TkColon) => "Colon"
    tokenRepr(Token.TkBang) => "Bang"
    tokenRepr(Token.TkFatArrow) => "FatArrow"
    tokenRepr(Token.TkIndent) => "Indent"
    tokenRepr(Token.TkDedent) => "Dedent"
    tokenRepr(Token.TkFn) => "Fn"
    tokenRepr(Token.TkMatch) => "Match"
    tokenRepr(Token.TkPlus) => "Plus"
    tokenRepr(Token.TkInt(0)) => "Int(0)"
    tokenRepr(Token.TkFloat(3.14)) => "Float"
