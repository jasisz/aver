module Eval
    depends [Domain.Ast, Domain.Value]
    intent =
        "Tree-walking evaluator for the mini Aver AST."
        "Evaluates expressions in an environment of bindings and function definitions."
    exposes [evalProgram]

fn checkVarMatch(k: String, v: Val, name: String, rest: List<(String, Val)>) -> Result<Val, String>
    ? "Check if k matches name, otherwise continue lookup."
    match k == name
        true -> Result.Ok(v)
        false -> lookupVar(rest, name)

fn lookupVar(env: List<(String, Val)>, name: String) -> Result<Val, String>
    ? "Look up a variable in the environment."
    match env
        [] -> Result.Err("undefined variable: " + name)
        [pair, ..rest] -> match pair
            (k, v) -> checkVarMatch(k, v, name, rest)

fn lookupFn(fns: List<FnDef>, name: String) -> Result<FnDef, String>
    ? "Look up a function definition by name."
    match fns
        [] -> Result.Err("undefined function: " + name)
        [f, ..rest] -> match f.name == name
            true -> Result.Ok(f)
            false -> lookupFn(rest, name)

fn zipArgs(params: List<String>, args: List<Val>) -> List<(String, Val)>
    ? "Pair parameter names with argument values."
    match params
        [] -> []
        [p, ..ps] -> match args
            [] -> []
            [a, ..as_] -> List.prepend((p, a), zipArgs(ps, as_))

fn evalExpr(expr: Expr, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate an expression in the given environment."
    match expr
        Expr.ExprInt(n) -> Result.Ok(Val.ValInt(n))
        Expr.ExprStr(s) -> Result.Ok(Val.ValStr(s))
        Expr.ExprBool(b) -> Result.Ok(Val.ValBool(b))
        Expr.ExprVar(name) -> evalVar(name, env)
        Expr.ExprAdd(a, b) -> evalBinop(a, b, env, fns, "add")
        Expr.ExprSub(a, b) -> evalBinop(a, b, env, fns, "sub")
        Expr.ExprMul(a, b) -> evalBinop(a, b, env, fns, "mul")
        Expr.ExprDiv(a, b) -> evalBinop(a, b, env, fns, "div")
        Expr.ExprEq(a, b) -> evalCmp(a, b, env, fns, "eq")
        Expr.ExprNeq(a, b) -> evalCmp(a, b, env, fns, "neq")
        Expr.ExprLt(a, b) -> evalCmp(a, b, env, fns, "lt")
        Expr.ExprGt(a, b) -> evalCmp(a, b, env, fns, "gt")
        Expr.ExprLte(a, b) -> evalCmp(a, b, env, fns, "lte")
        Expr.ExprGte(a, b) -> evalCmp(a, b, env, fns, "gte")
        Expr.ExprList(exprs) -> evalListExpr(exprs, env, fns)
        Expr.ExprRecord(name, fieldExprs) -> evalRecordExpr(name, fieldExprs, env, fns)
        Expr.ExprFieldAccess(obj, field) -> evalFieldAccess(obj, field, env, fns)
        Expr.ExprCall(name, argExprs) -> evalCall(name, argExprs, env, fns)
        Expr.ExprMatch(scrutinee, arms) -> evalMatchExpr(scrutinee, arms, env, fns)
        Expr.ExprPropagate(inner) -> evalPropagate(inner, env, fns)

fn evalVar(name: String, env: List<(String, Val)>) -> Result<Val, String>
    ? "Look up variable, Option.None, or nullary variant constructor."
    match name
        "Option.None" -> Result.Ok(Val.ValNone)
        _ -> match lookupVar(env, name)
            Result.Ok(v) -> Result.Ok(v)
            Result.Err(_) -> evalVarFallback(name)

fn evalVarFallback(name: String) -> Result<Val, String>
    ? "If variable not in env, try as nullary variant (e.g. Token.TkPlus)."
    match splitDotted(name)
        Option.Some(pair) -> match pair
            (typeName, ctorName) -> Result.Ok(Val.ValVariant(typeName, ctorName, []))
        Option.None -> Result.Err("undefined variable: {name}")

fn evalPropagate(inner: Expr, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate ? operator: unwrap Ok or propagate Err."
    v = evalExpr(inner, env, fns)?
    match v
        Val.ValOk(x) -> Result.Ok(x)
        Val.ValErr(e) -> match e
            Val.ValStr(msg) -> Result.Err(msg)
            _ -> Result.Err("propagated error")
        _ -> Result.Err("? operator requires Result value")

fn evalMatchExpr(scrutinee: Expr, arms: List<MatchArm>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate a match expression."
    match evalExpr(scrutinee, env, fns)
        Result.Ok(v) -> evalMatch(v, arms, env, fns)
        Result.Err(e) -> Result.Err(e)

fn applyBinop(x: Int, y: Int, op: String) -> Result<Val, String>
    ? "Apply a binary operation to two integers."
    match op
        "add" -> Result.Ok(Val.ValInt(x + y))
        "sub" -> Result.Ok(Val.ValInt(x - y))
        "mul" -> Result.Ok(Val.ValInt(x * y))
        "div" -> match y == 0
            true -> Result.Err("division by zero")
            false -> Result.Ok(Val.ValInt(x / y))
        _ -> Result.Err("unknown op: " + op)

fn applyCmp(x: Int, y: Int, op: String) -> Result<Val, String>
    ? "Apply a comparison operation to two integers."
    match op
        "eq" -> Result.Ok(Val.ValBool(x == y))
        "neq" -> Result.Ok(Val.ValBool(x != y))
        "lt" -> Result.Ok(Val.ValBool(x < y))
        "gt" -> Result.Ok(Val.ValBool(x > y))
        "lte" -> Result.Ok(Val.ValBool(x <= y))
        "gte" -> Result.Ok(Val.ValBool(x >= y))
        _ -> Result.Err("unknown cmp: " + op)

fn evalBinopVals(va: Val, vb: Val, op: String) -> Result<Val, String>
    ? "Apply binary op to two evaluated values."
    match (va, vb)
        (Val.ValInt(x), Val.ValInt(y)) -> applyBinop(x, y, op)
        (Val.ValStr(x), Val.ValStr(y)) -> match op == "add"
            true -> Result.Ok(Val.ValStr(x + y))
            false -> Result.Err("strings only support +")
        _ -> Result.Err("binop type mismatch")

fn evalCmpVals(va: Val, vb: Val, op: String) -> Result<Val, String>
    ? "Apply comparison to two evaluated values."
    match (va, vb)
        (Val.ValInt(x), Val.ValInt(y)) -> applyCmp(x, y, op)
        _ -> Result.Err("comparison requires ints")

fn evalBinopRight(va: Val, b: Expr, env: List<(String, Val)>, fns: List<FnDef>, op: String) -> Result<Val, String>
    ? "Evaluate right side of binop and apply."
    match evalExpr(b, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(vb) -> evalBinopVals(va, vb, op)

fn evalBinop(a: Expr, b: Expr, env: List<(String, Val)>, fns: List<FnDef>, op: String) -> Result<Val, String>
    ? "Evaluate a binary operation on two expressions."
    match evalExpr(a, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(va) -> evalBinopRight(va, b, env, fns, op)

fn evalCmpRight(va: Val, b: Expr, env: List<(String, Val)>, fns: List<FnDef>, op: String) -> Result<Val, String>
    ? "Evaluate right side of comparison and apply."
    match evalExpr(b, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(vb) -> evalCmpVals(va, vb, op)

fn evalCmp(a: Expr, b: Expr, env: List<(String, Val)>, fns: List<FnDef>, op: String) -> Result<Val, String>
    ? "Evaluate a comparison expression."
    match evalExpr(a, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(va) -> evalCmpRight(va, b, env, fns, op)

fn evalRecordExpr(name: String, fieldExprs: List<(String, Expr)>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate record constructor."
    fields = evalRecordFields(fieldExprs, env, fns)?
    Result.Ok(Val.ValRecord(name, fields))

fn evalRecordFields(fieldExprs: List<(String, Expr)>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<List<(String, Val)>, String>
    ? "Evaluate record field expressions."
    match fieldExprs
        [] -> Result.Ok([])
        [pair, ..rest] -> match pair
            (fname, expr) -> evalRecordFieldOne(fname, expr, rest, env, fns)

fn evalRecordFieldOne(fname: String, expr: Expr, rest: List<(String, Expr)>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<List<(String, Val)>, String>
    ? "Evaluate one record field and continue."
    v = evalExpr(expr, env, fns)?
    restFields = evalRecordFields(rest, env, fns)?
    Result.Ok(List.prepend((fname, v), restFields))

fn evalFieldAccess(obj: Expr, field: String, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate field access: obj.field."
    v = evalExpr(obj, env, fns)?
    match v
        Val.ValRecord(_, fields) -> lookupField(fields, field)
        _ -> Result.Err("field access on non-record")

fn lookupField(fields: List<(String, Val)>, name: String) -> Result<Val, String>
    ? "Look up a field in a record's field list."
    match fields
        [] -> Result.Err("unknown field: {name}")
        [pair, ..rest] -> match pair
            (k, v) -> match k == name
                true -> Result.Ok(v)
                false -> lookupField(rest, name)

fn evalListExpr(exprs: List<Expr>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate a list literal."
    match evalListItems(exprs, env, fns)
        Result.Ok(items) -> Result.Ok(Val.ValList(items))
        Result.Err(e) -> Result.Err(e)

fn evalListItems(exprs: List<Expr>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<List<Val>, String>
    ? "Evaluate list of expressions into list of values."
    match exprs
        [] -> Result.Ok([])
        [e, ..rest] -> match evalExpr(e, env, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> match evalListItems(rest, env, fns)
                Result.Err(err) -> Result.Err(err)
                Result.Ok(vs) -> Result.Ok(List.prepend(v, vs))

fn evalArgsRest(v: Val, rest: List<Expr>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<List<Val>, String>
    ? "Evaluate remaining args and prepend v."
    match evalArgs(rest, env, fns)
        Result.Err(err) -> Result.Err(err)
        Result.Ok(vs) -> Result.Ok(List.prepend(v, vs))

fn evalArgs(exprs: List<Expr>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<List<Val>, String>
    ? "Evaluate a list of argument expressions."
    match exprs
        [] -> Result.Ok([])
        [e, ..rest] -> match evalExpr(e, env, fns)
            Result.Err(err) -> Result.Err(err)
            Result.Ok(v) -> evalArgsRest(v, rest, env, fns)

fn callWithArgs(args: List<Val>, name: String, fns: List<FnDef>) -> Result<Val, String>
    ? "Look up function and call it with args. Falls back to builtins for qualified names."
    match lookupFn(fns, name)
        Result.Ok(fd) -> evalStmts(fd.body, zipArgs(fd.params, args), fns)
        Result.Err(_) -> callBuiltin(name, args)

fn evalCall(name: String, argExprs: List<Expr>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate a function call."
    match evalArgs(argExprs, env, fns)
        Result.Err(e) -> Result.Err(e)
        Result.Ok(args) -> callWithArgs(args, name, fns)

// ─── Builtins (delegate to host) ────────────────────────────

fn callBuiltin(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch qualified builtin calls to host implementations."
    match name
        "List.prepend" -> builtinListPrepend(args)
        "List.len" -> builtinListLen(args)
        "List.reverse" -> builtinListReverse(args)
        "List.append" -> builtinListAppend(args)
        "List.get" -> builtinListGet(args)
        "Int.toString" -> builtinIntToString(args)
        "Int.abs" -> builtinIntAbs(args)
        "String.len" -> builtinStringLen(args)
        "String.charAt" -> builtinStringCharAt(args)
        "String.join" -> builtinStringJoin(args)
        "Result.Ok" -> builtinResultOk(args)
        "Result.Err" -> builtinResultErr(args)
        "Result.withDefault" -> builtinResultWithDefault(args)
        "Option.Some" -> builtinOptionSome(args)
        "Option.None" -> Result.Ok(Val.ValNone)
        "Option.withDefault" -> builtinOptionWithDefault(args)
        "Int.mod" -> builtinIntMod(args)
        "String.slice" -> builtinStringSlice(args)
        "String.fromBool" -> builtinStringFromBool(args)
        "String.fromInt" -> builtinStringFromInt(args)
        "String.contains" -> builtinStringContains(args)
        "String.startsWith" -> builtinStringStartsWith(args)
        _ -> tryVariantConstructor(name, args)

fn oneArg(args: List<Val>) -> Result<Val, String>
    ? "Extract single argument from args list."
    match args
        [a, ..rest] -> match rest
            [] -> Result.Ok(a)
            _ -> Result.Err("expected 1 argument")
        _ -> Result.Err("expected 1 argument")

fn twoArgs(args: List<Val>) -> Result<(Val, Val), String>
    ? "Extract two arguments from args list."
    match args
        [a, ..rest] -> match rest
            [b, ..rest2] -> match rest2
                [] -> Result.Ok((a, b))
                _ -> Result.Err("expected 2 arguments")
            _ -> Result.Err("expected 2 arguments")
        _ -> Result.Err("expected 2 arguments")

fn expectList(v: Val) -> Result<List<Val>, String>
    ? "Extract list from Val or error."
    match v
        Val.ValList(items) -> Result.Ok(items)
        _ -> Result.Err("expected list argument")

fn expectInt(v: Val) -> Result<Int, String>
    ? "Extract int from Val or error."
    match v
        Val.ValInt(n) -> Result.Ok(n)
        _ -> Result.Err("expected int argument")

fn builtinListPrepend(args: List<Val>) -> Result<Val, String>
    ? "List.prepend(value, list) → list with value at front."
    pair = twoArgs(args)?
    match pair
        (v, lstV) -> builtinListPrependInner(v, lstV)

fn builtinListPrependInner(v: Val, lstV: Val) -> Result<Val, String>
    items = expectList(lstV)?
    Result.Ok(Val.ValList(List.prepend(v, items)))

fn builtinListLen(args: List<Val>) -> Result<Val, String>
    ? "List.len(list) → length as Int."
    v = oneArg(args)?
    items = expectList(v)?
    Result.Ok(Val.ValInt(List.len(items)))

fn builtinListReverse(args: List<Val>) -> Result<Val, String>
    ? "List.reverse(list) → reversed list."
    v = oneArg(args)?
    items = expectList(v)?
    Result.Ok(Val.ValList(List.reverse(items)))

fn builtinListAppend(args: List<Val>) -> Result<Val, String>
    ? "List.append(list, val) → list with val at end."
    pair = twoArgs(args)?
    match pair
        (lstV, v) -> builtinListAppendInner(lstV, v)

fn builtinListAppendInner(lstV: Val, v: Val) -> Result<Val, String>
    ? "Inner impl of List.append."
    items = expectList(lstV)?
    Result.Ok(Val.ValList(List.append(items, v)))

fn builtinListGet(args: List<Val>) -> Result<Val, String>
    ? "List.get(list, index) → element or error."
    pair = twoArgs(args)?
    match pair
        (lstV, idxV) -> builtinListGetInner(lstV, idxV)

fn builtinListGetInner(lstV: Val, idxV: Val) -> Result<Val, String>
    ? "Inner impl of List.get. Returns Option (ValSome/ValNone)."
    items = expectList(lstV)?
    idx = expectInt(idxV)?
    match List.get(items, idx)
        Option.Some(v) -> Result.Ok(Val.ValSome(v))
        Option.None -> Result.Ok(Val.ValNone)

fn builtinIntToString(args: List<Val>) -> Result<Val, String>
    ? "Int.toString(n) → string representation."
    v = oneArg(args)?
    n = expectInt(v)?
    Result.Ok(Val.ValStr(Int.toString(n)))

fn builtinIntAbs(args: List<Val>) -> Result<Val, String>
    ? "Int.abs(n) → absolute value."
    v = oneArg(args)?
    n = expectInt(v)?
    Result.Ok(Val.ValInt(Int.abs(n)))

fn builtinIntMod(args: List<Val>) -> Result<Val, String>
    ? "Int.mod(a, b) → a mod b as Result."
    pair = twoArgs(args)?
    match pair
        (aV, bV) -> builtinIntModInner(aV, bV)

fn builtinIntModInner(aV: Val, bV: Val) -> Result<Val, String>
    a = expectInt(aV)?
    b = expectInt(bV)?
    match b == 0
        true -> Result.Ok(Val.ValErr(Val.ValStr("modulo by zero")))
        false -> Result.Ok(Val.ValOk(Val.ValInt(Result.withDefault(Int.mod(a, b), 0))))

fn builtinStringSlice(args: List<Val>) -> Result<Val, String>
    ? "String.slice(s, start, end) → substring."
    match args
        [sV, ..rest] -> match rest
            [startV, ..rest2] -> match rest2
                [endV, ..rest3] -> match rest3
                    [] -> builtinStringSliceInner(sV, startV, endV)
                    _ -> Result.Err("String.slice takes 3 arguments")
                _ -> Result.Err("String.slice takes 3 arguments")
            _ -> Result.Err("String.slice takes 3 arguments")
        _ -> Result.Err("String.slice takes 3 arguments")

fn builtinStringSliceInner(sV: Val, startV: Val, endV: Val) -> Result<Val, String>
    s = expectStr(sV)?
    start = expectInt(startV)?
    end = expectInt(endV)?
    Result.Ok(Val.ValStr(String.slice(s, start, end)))

fn builtinStringFromBool(args: List<Val>) -> Result<Val, String>
    ? "String.fromBool(b) → string."
    v = oneArg(args)?
    match v
        Val.ValBool(b) -> Result.Ok(Val.ValStr(String.fromBool(b)))
        _ -> Result.Err("String.fromBool requires Bool")

fn builtinStringFromInt(args: List<Val>) -> Result<Val, String>
    ? "String.fromInt(n) → string (alias for Int.toString)."
    v = oneArg(args)?
    n = expectInt(v)?
    Result.Ok(Val.ValStr(Int.toString(n)))

fn builtinStringContains(args: List<Val>) -> Result<Val, String>
    ? "String.contains(haystack, needle) → Bool."
    pair = twoArgs(args)?
    match pair
        (hV, nV) -> builtinStringContainsInner(hV, nV)

fn builtinStringContainsInner(hV: Val, nV: Val) -> Result<Val, String>
    h = expectStr(hV)?
    n = expectStr(nV)?
    Result.Ok(Val.ValBool(String.contains(h, n)))

fn builtinStringStartsWith(args: List<Val>) -> Result<Val, String>
    ? "String.startsWith(s, prefix) → Bool."
    pair = twoArgs(args)?
    match pair
        (sV, pV) -> builtinStringStartsWithInner(sV, pV)

fn builtinStringStartsWithInner(sV: Val, pV: Val) -> Result<Val, String>
    s = expectStr(sV)?
    p = expectStr(pV)?
    Result.Ok(Val.ValBool(String.startsWith(s, p)))

fn builtinOptionSome(args: List<Val>) -> Result<Val, String>
    ? "Option.Some(value) → wrapped Some value."
    v = oneArg(args)?
    Result.Ok(Val.ValSome(v))

fn builtinOptionWithDefault(args: List<Val>) -> Result<Val, String>
    ? "Option.withDefault(option, default) → unwrap Some or return default."
    pair = twoArgs(args)?
    match pair
        (opt, def) -> match opt
            Val.ValSome(inner) -> Result.Ok(inner)
            Val.ValNone -> Result.Ok(def)
            _ -> Result.Err("Option.withDefault requires Option value")

fn builtinResultWithDefault(args: List<Val>) -> Result<Val, String>
    ? "Result.withDefault(result, default) → unwrap Ok or return default."
    pair = twoArgs(args)?
    match pair
        (res, def) -> match res
            Val.ValOk(inner) -> Result.Ok(inner)
            Val.ValErr(_) -> Result.Ok(def)
            _ -> Result.Err("Result.withDefault requires Result value")

fn builtinResultOk(args: List<Val>) -> Result<Val, String>
    ? "Result.Ok(value) → wrapped Ok value."
    v = oneArg(args)?
    Result.Ok(Val.ValOk(v))

fn builtinResultErr(args: List<Val>) -> Result<Val, String>
    ? "Result.Err(value) → wrapped Err value."
    v = oneArg(args)?
    Result.Ok(Val.ValErr(v))

fn tryVariantConstructor(name: String, args: List<Val>) -> Result<Val, String>
    ? "Try to construct a variant value from a dotted name like Type.Ctor."
    match splitDotted(name)
        Option.Some(pair) -> match pair
            (typeName, ctorName) -> Result.Ok(Val.ValVariant(typeName, ctorName, args))
        Option.None -> Result.Err("undefined function: {name}")

fn splitDotted(name: String) -> Option<(String, String)>
    ? "Split 'Type.Ctor' into (Type, Ctor). Returns None if no dot."
    splitDottedLoop(name, 0, String.len(name))

fn splitDottedLoop(name: String, pos: Int, total: Int) -> Option<(String, String)>
    ? "Find first dot and split."
    match pos >= total
        true -> Option.None
        false -> match String.charAt(name, pos)
            Option.Some(c) -> match c == "."
                true -> Option.Some((String.slice(name, 0, pos), String.slice(name, pos + 1, total)))
                false -> splitDottedLoop(name, pos + 1, total)
            Option.None -> Option.None

fn expectStr(v: Val) -> Result<String, String>
    ? "Extract string from Val or error."
    match v
        Val.ValStr(s) -> Result.Ok(s)
        _ -> Result.Err("expected string argument")

fn builtinStringLen(args: List<Val>) -> Result<Val, String>
    ? "String.len(s) → length as Int."
    v = oneArg(args)?
    s = expectStr(v)?
    Result.Ok(Val.ValInt(String.len(s)))

fn builtinStringCharAt(args: List<Val>) -> Result<Val, String>
    ? "String.charAt(s, index) → single character string or error."
    pair = twoArgs(args)?
    match pair
        (sV, idxV) -> builtinStringCharAtInner(sV, idxV)

fn builtinStringCharAtInner(sV: Val, idxV: Val) -> Result<Val, String>
    ? "Inner impl of String.charAt."
    s = expectStr(sV)?
    idx = expectInt(idxV)?
    match String.charAt(s, idx)
        Option.Some(c) -> Result.Ok(Val.ValStr(c))
        Option.None -> Result.Err("charAt index out of bounds")

fn builtinStringJoin(args: List<Val>) -> Result<Val, String>
    ? "String.join(list, separator) → joined string."
    pair = twoArgs(args)?
    match pair
        (lstV, sepV) -> builtinStringJoinInner(lstV, sepV)

fn builtinStringJoinInner(lstV: Val, sepV: Val) -> Result<Val, String>
    ? "Inner impl of String.join."
    items = expectList(lstV)?
    sep = expectStr(sepV)?
    strs = extractStrings(items, [])?
    Result.Ok(Val.ValStr(String.join(strs, sep)))

fn extractStrings(items: List<Val>, acc: List<String>) -> Result<List<String>, String>
    ? "Convert list of ValStr to list of String."
    match items
        [] -> Result.Ok(List.reverse(acc))
        [v, ..rest] -> match v
            Val.ValStr(s) -> extractStrings(rest, List.prepend(s, acc))
            _ -> Result.Err("String.join requires list of strings")

// ─── Pattern matching ───────────────────────────────────────

fn matchPattern(pat: Pattern, v: Val) -> Result<List<(String, Val)>, String>
    ? "Try to match a value against a pattern. Returns bindings on success."
    match pat
        Pattern.PatWild -> Result.Ok([])
        Pattern.PatInt(n) -> matchPatInt(n, v)
        Pattern.PatBool(b) -> matchPatBool(b, v)
        Pattern.PatEmpty -> matchPatEmpty(v)
        Pattern.PatCons(h, t) -> matchPatCons(h, t, v)
        Pattern.PatConstructor(ctorName, bindings) -> matchPatConstructor(ctorName, bindings, v)
        Pattern.PatVar(name) -> Result.Ok([(name, v)])

fn matchPatInt(n: Int, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a PatInt pattern against a value."
    match v
        Val.ValInt(m) -> match n == m
            true -> Result.Ok([])
            false -> Result.Err("no match")
        _ -> Result.Err("no match")

fn matchPatBool(b: Bool, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a PatBool pattern against a value."
    match v
        Val.ValBool(vb) -> match b == vb
            true -> Result.Ok([])
            false -> Result.Err("no match")
        _ -> Result.Err("no match")

fn matchPatEmpty(v: Val) -> Result<List<(String, Val)>, String>
    ? "Match empty list pattern []."
    match v
        Val.ValList(items) -> match items
            [] -> Result.Ok([])
            _ -> Result.Err("no match")
        _ -> Result.Err("no match")

fn matchPatCons(h: String, t: String, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match cons pattern [h, ..t]."
    match v
        Val.ValList(items) -> match items
            [] -> Result.Err("no match")
            [head, ..tail] -> Result.Ok([(h, head), (t, Val.ValList(tail))])
        _ -> Result.Err("no match")

fn matchPatConstructor(ctorName: String, bindings: List<String>, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match constructor pattern. Checks tag name and extracts inner values."
    match ctorName
        "Result.Ok" -> matchWrapperPat(v, "Ok", bindings)
        "Result.Err" -> matchWrapperPat(v, "Err", bindings)
        "Option.Some" -> matchWrapperPat(v, "Some", bindings)
        "Option.None" -> matchNonePat(v)
        _ -> matchGenericConstructor(ctorName, bindings, v)

fn matchGenericConstructor(ctorName: String, bindings: List<String>, v: Val) -> Result<List<(String, Val)>, String>
    ? "Match a generic variant constructor pattern."
    match v
        Val.ValVariant(typeName, varName, fields) -> matchGenericCtorCheck(ctorName, typeName, varName, bindings, fields)
        _ -> Result.Err("no match")

fn matchGenericCtorCheck(ctorName: String, typeName: String, varName: String, bindings: List<String>, fields: List<Val>) -> Result<List<(String, Val)>, String>
    ? "Check if variant matches constructor name."
    fullName = typeName + "." + varName
    match fullName == ctorName
        true -> zipBindings(bindings, fields)
        false -> Result.Err("no match")

fn matchNonePat(v: Val) -> Result<List<(String, Val)>, String>
    ? "Match Option.None pattern."
    match v
        Val.ValNone -> Result.Ok([])
        _ -> Result.Err("no match")

fn matchWrapperPat(v: Val, tag: String, bindings: List<String>) -> Result<List<(String, Val)>, String>
    ? "Match Ok/Err/Some wrapper and bind inner value."
    match tag
        "Ok" -> match v
            Val.ValOk(inner) -> zipBindings(bindings, [inner])
            _ -> Result.Err("no match")
        "Err" -> match v
            Val.ValErr(inner) -> zipBindings(bindings, [inner])
            _ -> Result.Err("no match")
        "Some" -> match v
            Val.ValSome(inner) -> zipBindings(bindings, [inner])
            _ -> Result.Err("no match")
        _ -> Result.Err("no match")

fn zipBindings(names: List<String>, vals: List<Val>) -> Result<List<(String, Val)>, String>
    ? "Pair binding names with values."
    match names
        [] -> Result.Ok([])
        [n, ..ns] -> match vals
            [] -> Result.Ok([])
            [v, ..vs] -> match zipBindings(ns, vs)
                Result.Ok(rest) -> Result.Ok(List.prepend((n, v), rest))
                Result.Err(e) -> Result.Err(e)

fn evalMatch(v: Val, arms: List<MatchArm>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Try each match arm until one matches."
    match arms
        [] -> Result.Err("no matching arm")
        [arm, ..rest] -> tryArm(arm, v, rest, env, fns)

fn tryArm(arm: MatchArm, v: Val, rest: List<MatchArm>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Try a single match arm, fall through to rest on failure."
    match matchPattern(arm.pattern, v)
        Result.Ok(bindings) -> evalExpr(arm.body, List.concat(bindings, env), fns)
        Result.Err(_) -> evalMatch(v, rest, env, fns)

fn evalStmtExpr(e: Expr, env: List<(String, Val)>, fns: List<FnDef>) -> Result<(Val, List<(String, Val)>), String>
    ? "Evaluate a statement expression."
    match evalExpr(e, env, fns)
        Result.Ok(v) -> Result.Ok((v, env))
        Result.Err(e) -> Result.Err(e)

fn evalStmtBind(name: String, e: Expr, env: List<(String, Val)>, fns: List<FnDef>) -> Result<(Val, List<(String, Val)>), String>
    ? "Evaluate a binding statement."
    match evalExpr(e, env, fns)
        Result.Ok(v) -> Result.Ok((v, List.prepend((name, v), env)))
        Result.Err(e) -> Result.Err(e)

fn evalStmt(stmt: Stmt, env: List<(String, Val)>, fns: List<FnDef>) -> Result<(Val, List<(String, Val)>), String>
    ? "Evaluate a statement, returning the result and updated environment."
    match stmt
        Stmt.StmtExpr(e) -> evalStmtExpr(e, env, fns)
        Stmt.StmtBind(name, e) -> evalStmtBind(name, e, env, fns)

fn evalStmtsRest(v: Val, newEnv: List<(String, Val)>, rest: List<Stmt>, fns: List<FnDef>) -> Result<Val, String>
    ? "Continue evaluating remaining statements."
    match rest
        [] -> Result.Ok(v)
        _ -> evalStmts(rest, newEnv, fns)

fn evalStmtsContinue(pair: (Val, List<(String, Val)>), rest: List<Stmt>, fns: List<FnDef>) -> Result<Val, String>
    ? "Unpack stmt result and continue."
    match pair
        (v, newEnv) -> evalStmtsRest(v, newEnv, rest, fns)

fn evalStmts(stmts: List<Stmt>, env: List<(String, Val)>, fns: List<FnDef>) -> Result<Val, String>
    ? "Evaluate a list of statements, threading the environment."
    match stmts
        [] -> Result.Ok(Val.ValUnit)
        [s, ..rest] -> match evalStmt(s, env, fns)
            Result.Err(e) -> Result.Err(e)
            Result.Ok(pair) -> evalStmtsContinue(pair, rest, fns)

fn evalProgram(prog: Program) -> Result<Val, String>
    ? "Evaluate a complete program."
    evalStmts(prog.stmts, [], prog.fns)

verify matchPattern
    matchPattern(Pattern.PatWild, Val.ValInt(42)) => Result.Ok([])
    matchPattern(Pattern.PatInt(5), Val.ValInt(5)) => Result.Ok([])
    matchPattern(Pattern.PatInt(5), Val.ValInt(6)) => Result.Err("no match")
    matchPattern(Pattern.PatBool(true), Val.ValBool(true)) => Result.Ok([])
    matchPattern(Pattern.PatBool(true), Val.ValBool(false)) => Result.Err("no match")
    matchPattern(Pattern.PatVar("x"), Val.ValInt(42)) => Result.Ok([("x", Val.ValInt(42))])
