module Ledger
    intent = "An answer module that threads one state for Pool and another for Chain."
    depends [Chain, Pool]
    exposes [State, Store, claim, gone, nextTarget]
    effects []
    answers [Pool, Chain]

record State
    free: List<Int>
    stopping: Bool

record Store
    tip: Int

fn claim(state: State, key: Int) -> Tuple<State, Result<Pool.Assignment, Run.Wake>>
    ? "The next height for this peer."
    (state, Result.Ok(Pool.Assignment.Idle))

fn gone(state: State, key: Int) -> Tuple<State, Result<Unit, Run.Wake>>
    ? "A peer that left gives its height back."
    (state, Result.Ok(Unit))

fn nextTarget(store: Store, height: Int) -> Option<String>
    ? "Which hash is next at this height."
    Option.None
