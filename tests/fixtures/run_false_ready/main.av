module Node
    intent = "Fixture: a take that finds its job still running, which is what a wait may report ready before the job has finished. The answer module must keep the handle and answer once the job really lands."
    depends [Pool, Pooled]
    effects [Console.print, Pool.early, Pool.scored, yield]

fn probing() -> Unit
    ? "Asks for one score and says what came of it."
    ! [Console.print, Pool.early, Pool.scored, yield]
    Console.print(landed(Pool.scored(1)))
    Console.print(earlyTakes(Pool.early()))

fn landed(outcome: Result<Int, String>) -> String
    ? "What one score request answered."
    match outcome
        Result.Err(reason) -> "the job failed: {reason}"
        Result.Ok(points) -> "kept the handle, then landed: scored {points}"

verify landed
    landed(Result.Ok(2)) => "kept the handle, then landed: scored 2"
    landed(Result.Err("no")) => "the job failed: no"

fn earlyTakes(count: Int) -> String
    ? "Whether a take found its job still running."
    match count > 0
        true -> "a take found the job still running"
        false -> "no take found the job still running"

verify earlyTakes
    earlyTakes(1) => "a take found the job still running"
    earlyTakes(0) => "no take found the job still running"
