module Clock
    kind = capability
    semantics = effectful
    intent = "The periodic tick the ticker waits on."
    exposes [Tick, tick]

type Tick
    Tock
    Closed(Int)

operation tick() -> Clock.Tick
    ? "The next tick, or Closed once the clock is done ticking, carrying how many times it was asked for one."
    oracle = generative
    replay = recorded
