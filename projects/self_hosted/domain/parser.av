module Parser
    depends [Domain.Token, Domain.Lexer, Domain.Ast, Domain.ParserMatch, Domain.Parser.Expr]
    intent =
        "Statement, function definition, and program parsing for the Aver parser."
        "Expression parsing delegated to Domain.Parser.Expr."
    exposes [parse]

fn parseStmt(tokens: List<Token>, pos: Int) -> Result<(Stmt, Int), String>
    ? "Parse a statement: binding (name = expr) or expression."
    t = Domain.ParserMatch.tokenAt(tokens, pos)
    match t
        Token.TkIdent(name) -> parseStmtAfterIdent(tokens, pos + 1, name)
        _ -> parseStmtExpr(tokens, pos)

verify parseStmt
    parseStmt([Token.TkInt(42), Token.TkEof], 0) => Result.Ok((Stmt.StmtExpr(Expr.ExprInt(42)), 1))

fn parseStmtAfterIdent(tokens: List<Token>, pos: Int, name: String) -> Result<(Stmt, Int), String>
    ? "After ident: if '=' or ':' follows it's a binding, otherwise reparse as expr."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkEq -> parseBinding(tokens, pos + 1, name)
        Token.TkColon -> parseBinding(tokens, skipTypeAnnotationAndEq(tokens, pos), name)
        _ -> parseStmtExprFrom(tokens, pos, name)

verify parseStmtAfterIdent
    parseStmtAfterIdent([Token.TkEq, Token.TkInt(5), Token.TkEof], 0, "x") => Result.Ok((Stmt.StmtBind("x", Expr.ExprInt(5)), 2))

fn skipTypeAnnotationAndEq(tokens: List<Token>, pos: Int) -> Int
    ? "Skip : Type = and return position after =."
    pos2 = Domain.ParserMatch.skipTypeAnnotation(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkEq -> pos2 + 1
        _ -> pos2

verify skipTypeAnnotationAndEq
    skipTypeAnnotationAndEq([Token.TkColon, Token.TkIdent("Int"), Token.TkEq, Token.TkEof], 0) => 3

fn parseBinding(tokens: List<Token>, pos: Int, name: String) -> Result<(Stmt, Int), String>
    ? "Parse: name = expr. Skips leading NL+INDENT and trailing DEDENT for multi-line exprs."
    r = Domain.Parser.Expr.parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> Result.Ok((Stmt.StmtBind(name, expr), skipTrailingDedent(tokens, pos2, pos)))

fn skipTrailingDedent(tokens: List<Token>, pos: Int, startPos: Int) -> Int
    ? "If expression consumed an INDENT (multi-line), skip the trailing DEDENT."
    match countIndentsInRange(tokens, startPos, pos, 0)
        0 -> pos
        n -> skipNDedents(tokens, pos, n)

fn countIndentsInRange(tokens: List<Token>, pos: Int, endPos: Int, count: Int) -> Int
    ? "Count net indent/dedent balance in a token range."
    match pos >= endPos
        true -> count
        false -> match Domain.ParserMatch.tokenAt(tokens, pos)
            Token.TkIndent -> countIndentsInRange(tokens, pos + 1, endPos, count + 1)
            Token.TkDedent -> countIndentsInRange(tokens, pos + 1, endPos, count - 1)
            _ -> countIndentsInRange(tokens, pos + 1, endPos, count)

fn skipNDedents(tokens: List<Token>, pos: Int, n: Int) -> Int
    ? "Skip n DEDENT tokens (and interleaved newlines) after multi-line expression."
    match n <= 0
        true -> pos
        false -> match Domain.ParserMatch.tokenAt(tokens, pos)
            Token.TkNewline -> skipNDedents(tokens, pos + 1, n)
            Token.TkDedent -> skipNDedents(tokens, pos + 1, n - 1)
            _ -> pos

verify parseBinding
    parseBinding([Token.TkInt(5), Token.TkEof], 0, "x") => Result.Ok((Stmt.StmtBind("x", Expr.ExprInt(5)), 1))

fn parseStmtExpr(tokens: List<Token>, pos: Int) -> Result<(Stmt, Int), String>
    ? "Parse an expression statement."
    r = Domain.Parser.Expr.parseExpr(tokens, pos)?
    match r
        (expr, pos2) -> Result.Ok((Stmt.StmtExpr(expr), skipTrailingDedent(tokens, pos2, pos)))

verify parseStmtExpr
    parseStmtExpr([Token.TkInt(1), Token.TkEof], 0) => Result.Ok((Stmt.StmtExpr(Expr.ExprInt(1)), 1))

fn parseStmtExprFrom(tokens: List<Token>, pos: Int, name: String) -> Result<(Stmt, Int), String>
    ? "Reparse as expression starting from an identifier (might be call or var in expr)."
    ir = Domain.Parser.Expr.parseIdentOrCall(tokens, pos, name)?
    match ir
        (expr, pos2) -> parseStmtExprFromMul(tokens, pos2, expr)

verify parseStmtExprFrom
    parseStmtExprFrom([Token.TkLParen, Token.TkRParen, Token.TkEof], 0, "f") => Result.Ok((Stmt.StmtExpr(Expr.ExprCall("f", [])), 2))

fn parseStmtExprFromMul(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Stmt, Int), String>
    ? "Continue parsing expression statement from multiplicative level."
    mr = Domain.Parser.Expr.parseMulExprTail(tokens, pos, expr)?
    match mr
        (expr2, pos2) -> parseStmtExprFromAdd(tokens, pos2, expr2)

verify parseStmtExprFromMul
    parseStmtExprFromMul([Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Stmt.StmtExpr(Expr.ExprInt(1)), 0))

fn parseStmtExprFromAdd(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Stmt, Int), String>
    ? "Continue parsing expression statement from additive level."
    ar = Domain.Parser.Expr.parseAddExprTail(tokens, pos, expr)?
    match ar
        (expr2, pos2) -> parseStmtExprFromCmp(tokens, pos2, expr2)

verify parseStmtExprFromAdd
    parseStmtExprFromAdd([Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Stmt.StmtExpr(Expr.ExprInt(1)), 0))

fn parseStmtExprFromCmp(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Stmt, Int), String>
    ? "Continue parsing expression statement from comparison level."
    cr = Domain.Parser.Expr.parseCmpExprTail(tokens, pos, expr)?
    match cr
        (expr2, pos2) -> parseStmtExprFromQ(tokens, pos2, expr2)

verify parseStmtExprFromCmp
    parseStmtExprFromCmp([Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Stmt.StmtExpr(Expr.ExprInt(1)), 0))

fn parseStmtExprFromQ(tokens: List<Token>, pos: Int, expr: Expr) -> Result<(Stmt, Int), String>
    ? "Check for postfix ? on expression statement."
    qr = Domain.Parser.Expr.parsePostfixQuestion(tokens, pos, expr)?
    match qr
        (expr2, pos2) -> Result.Ok((Stmt.StmtExpr(expr2), pos2))

verify parseStmtExprFromQ
    parseStmtExprFromQ([Token.TkEof], 0, Expr.ExprInt(1)) => Result.Ok((Stmt.StmtExpr(Expr.ExprInt(1)), 0))

fn parseFnDef(tokens: List<Token>, pos: Int) -> Result<(FnDef, Int), String>
    ? "Parse: fn NAME(params) NEWLINE body"
    t = Domain.ParserMatch.tokenAt(tokens, pos)
    match t
        Token.TkIdent(name) -> parseFnDefParams(tokens, pos + 1, name)
        _ -> Result.Err("Expected function name after 'fn'")

verify parseFnDef
    parseFnDef([Token.TkIdent("foo"), Token.TkLParen, Token.TkRParen, Token.TkNewline, Token.TkInt(1), Token.TkEof], 0) => Result.Ok((FnDef(name = "foo", params = [], body = [Stmt.StmtExpr(Expr.ExprInt(1))]), 5))

fn parseFnDefParams(tokens: List<Token>, pos: Int, name: String) -> Result<(FnDef, Int), String>
    ? "Parse parameter list and body."
    pos2 = Domain.ParserMatch.expect(tokens, pos, Token.TkLParen)?
    pr = Domain.ParserMatch.parseParamList(tokens, pos2, [])?
    match pr
        (params, pos3) -> parseFnDefBody(tokens, pos3, name, params)

verify parseFnDefParams
    parseFnDefParams([Token.TkLParen, Token.TkRParen, Token.TkNewline, Token.TkInt(1), Token.TkEof], 0, "foo") => Result.Ok((FnDef(name = "foo", params = [], body = [Stmt.StmtExpr(Expr.ExprInt(1))]), 4))

fn parseFnDefBody(tokens: List<Token>, pos: Int, name: String, params: List<String>) -> Result<(FnDef, Int), String>
    ? "Parse function body: skip return type, newline, INDENT, ?, !, then statements until DEDENT."
    pos2 = Domain.ParserMatch.skipReturnType(tokens, pos)
    pos3 = Domain.ParserMatch.skipNewlines(tokens, pos2)
    match Domain.ParserMatch.tokenAt(tokens, pos3)
        Token.TkIndent -> parseFnDefBodyIndented(tokens, pos3 + 1, name, params)
        _ -> parseFnDefBodyFlat(tokens, pos3, name, params)

verify parseFnDefBody
    parseFnDefBody([Token.TkNewline, Token.TkInt(1), Token.TkEof], 0, "foo", []) => Result.Ok((FnDef(name = "foo", params = [], body = [Stmt.StmtExpr(Expr.ExprInt(1))]), 2))

fn parseFnDefBodyIndented(tokens: List<Token>, pos: Int, name: String, params: List<String>) -> Result<(FnDef, Int), String>
    ? "Parse function body with INDENT/DEDENT."
    pos2 = Domain.ParserMatch.skipDescAndEffects(tokens, pos)
    sr = parseFnBodyStmtsIndented(tokens, pos2, [])?
    match sr
        (stmts, pos3) -> Result.Ok((FnDef(name = name, params = params, body = stmts), pos3))

verify parseFnDefBodyIndented
    parseFnDefBodyIndented([Token.TkInt(1), Token.TkNewline, Token.TkDedent, Token.TkEof], 0, "foo", []) => Result.Ok((FnDef(name = "foo", params = [], body = [Stmt.StmtExpr(Expr.ExprInt(1))]), 3))

fn parseFnDefBodyFlat(tokens: List<Token>, pos: Int, name: String, params: List<String>) -> Result<(FnDef, Int), String>
    ? "Parse function body without INDENT/DEDENT (fallback)."
    pos2 = Domain.ParserMatch.skipDescAndEffects(tokens, pos)
    sr = parseFnBodyStmtsFlat(tokens, pos2, [])?
    match sr
        (stmts, pos3) -> Result.Ok((FnDef(name = name, params = params, body = stmts), pos3))

verify parseFnDefBodyFlat
    parseFnDefBodyFlat([Token.TkInt(1), Token.TkEof], 0, "foo", []) => Result.Ok((FnDef(name = "foo", params = [], body = [Stmt.StmtExpr(Expr.ExprInt(1))]), 1))

fn parseFnBodyStmtsIndented(tokens: List<Token>, pos: Int, acc: List<Stmt>) -> Result<(List<Stmt>, Int), String>
    ? "Parse statements until DEDENT or EOF."
    pos2 = Domain.ParserMatch.skipNewlines(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkDedent -> Result.Ok((acc, pos2 + 1))
        Token.TkEof -> Result.Ok((acc, pos2))
        _ -> parseFnBodyOneStmtIndented(tokens, pos2, acc)

verify parseFnBodyStmtsIndented
    parseFnBodyStmtsIndented([Token.TkDedent, Token.TkEof], 0, []) => Result.Ok(([], 1))
    parseFnBodyStmtsIndented([Token.TkInt(1), Token.TkNewline, Token.TkDedent, Token.TkEof], 0, []) => Result.Ok(([Stmt.StmtExpr(Expr.ExprInt(1))], 3))

fn parseFnBodyOneStmtIndented(tokens: List<Token>, pos: Int, acc: List<Stmt>) -> Result<(List<Stmt>, Int), String>
    ? "Parse one statement and continue with indented body."
    r = parseStmt(tokens, pos)?
    match r
        (stmt, pos2) -> parseFnBodyStmtsIndented(tokens, pos2, List.append(acc, stmt))

verify parseFnBodyOneStmtIndented
    parseFnBodyOneStmtIndented([Token.TkInt(1), Token.TkNewline, Token.TkDedent, Token.TkEof], 0, []) => Result.Ok(([Stmt.StmtExpr(Expr.ExprInt(1))], 3))

fn parseFnBodyStmtsFlat(tokens: List<Token>, pos: Int, acc: List<Stmt>) -> Result<(List<Stmt>, Int), String>
    ? "Parse statements in function body (flat mode)."
    match Domain.ParserMatch.isBodyEndFlat(tokens, pos)
        true -> Result.Ok((acc, pos))
        false -> parseFnBodyOneStmtFlat(tokens, pos, acc)

verify parseFnBodyStmtsFlat
    parseFnBodyStmtsFlat([Token.TkEof], 0, []) => Result.Ok(([], 0))
    parseFnBodyStmtsFlat([Token.TkInt(1), Token.TkEof], 0, []) => Result.Ok(([Stmt.StmtExpr(Expr.ExprInt(1))], 1))

fn parseFnBodyOneStmtFlat(tokens: List<Token>, pos: Int, acc: List<Stmt>) -> Result<(List<Stmt>, Int), String>
    ? "Parse one statement in function body and continue (flat mode)."
    r = parseStmt(tokens, pos)?
    match r
        (stmt, pos2) -> parseFnBodyAfterStmtFlat(tokens, pos2, List.append(acc, stmt))

verify parseFnBodyOneStmtFlat
    parseFnBodyOneStmtFlat([Token.TkInt(1), Token.TkEof], 0, []) => Result.Ok(([Stmt.StmtExpr(Expr.ExprInt(1))], 1))

fn parseFnBodyAfterStmtFlat(tokens: List<Token>, pos: Int, acc: List<Stmt>) -> Result<(List<Stmt>, Int), String>
    ? "After a body statement: single newline continues, anything else ends (flat mode)."
    match Domain.ParserMatch.tokenAt(tokens, pos)
        Token.TkNewline -> parseFnBodyStmtsFlat(tokens, pos + 1, acc)
        _ -> Result.Ok((acc, pos))

verify parseFnBodyAfterStmtFlat
    parseFnBodyAfterStmtFlat([Token.TkEof], 0, [Stmt.StmtExpr(Expr.ExprInt(1))]) => Result.Ok(([Stmt.StmtExpr(Expr.ExprInt(1))], 0))
    parseFnBodyAfterStmtFlat([Token.TkNewline, Token.TkEof], 0, [Stmt.StmtExpr(Expr.ExprInt(1))]) => Result.Ok(([Stmt.StmtExpr(Expr.ExprInt(1))], 1))

fn parseProgram(tokens: List<Token>, pos: Int, deps: List<String>, fns: List<FnDef>, stmts: List<Stmt>) -> Result<Program, String>
    ? "Parse top-level items until EOF."
    pos2 = Domain.ParserMatch.skipNewlinesAndDedents(tokens, pos)
    match Domain.ParserMatch.tokenAt(tokens, pos2)
        Token.TkEof -> Result.Ok(Program(deps = deps, fns = fns, stmts = stmts))
        Token.TkFn -> parseProgramFn(tokens, pos2 + 1, deps, fns, stmts)
        Token.TkIdent(kw) -> parseProgramKeyword(tokens, pos2, deps, fns, stmts, kw)
        _ -> parseProgramStmt(tokens, pos2, deps, fns, stmts)

verify parseProgram
    parseProgram([Token.TkEof], 0, [], [], []) => Result.Ok(Program(deps = [], fns = [], stmts = []))

fn parseProgramKeyword(tokens: List<Token>, pos: Int, deps: List<String>, fns: List<FnDef>, stmts: List<Stmt>, kw: String) -> Result<Program, String>
    ? "Handle keywords: module (extract depends), type/record/verify/decision (skip)."
    match kw
        "module" -> parseProgramModuleHeader(tokens, pos + 1, fns, stmts)
        "type" -> parseProgram(tokens, Domain.ParserMatch.skipBlock(tokens, pos + 1), deps, fns, stmts)
        "record" -> parseProgram(tokens, Domain.ParserMatch.skipBlock(tokens, pos + 1), deps, fns, stmts)
        "verify" -> parseProgram(tokens, Domain.ParserMatch.skipBlock(tokens, pos + 1), deps, fns, stmts)
        "decision" -> parseProgram(tokens, Domain.ParserMatch.skipBlock(tokens, pos + 1), deps, fns, stmts)
        _ -> parseProgramStmt(tokens, pos, deps, fns, stmts)

verify parseProgramKeyword
    parseProgramKeyword([Token.TkIdent("type"), Token.TkEof], 0, [], [], [], "type") => Result.Ok(Program(deps = [], fns = [], stmts = []))

fn parseProgramModuleHeader(tokens: List<Token>, pos: Int, fns: List<FnDef>, stmts: List<Stmt>) -> Result<Program, String>
    ? "Parse module header and continue with program."
    r = Domain.ParserMatch.parseModuleHeader(tokens, pos)
    match r
        (depList, endPos) -> parseProgram(tokens, endPos, depList, fns, stmts)

verify parseProgramModuleHeader
    parseProgramModuleHeader([Token.TkIdent("Test"), Token.TkEof], 0, [], []) => Result.Ok(Program(deps = [], fns = [], stmts = []))

fn parseProgramFn(tokens: List<Token>, pos: Int, deps: List<String>, fns: List<FnDef>, stmts: List<Stmt>) -> Result<Program, String>
    ? "Parse a function definition and continue."
    r = parseFnDef(tokens, pos)?
    match r
        (fd, pos2) -> parseProgram(tokens, Domain.ParserMatch.skipNewlines(tokens, pos2), deps, List.append(fns, fd), stmts)

verify parseProgramFn
    parseProgramFn([Token.TkIdent("f"), Token.TkLParen, Token.TkRParen, Token.TkNewline, Token.TkInt(1), Token.TkEof], 0, [], [], []) => Result.Ok(Program(deps = [], fns = [FnDef(name = "f", params = [], body = [Stmt.StmtExpr(Expr.ExprInt(1))])], stmts = []))

fn parseProgramStmt(tokens: List<Token>, pos: Int, deps: List<String>, fns: List<FnDef>, stmts: List<Stmt>) -> Result<Program, String>
    ? "Parse a statement and continue."
    r = parseStmt(tokens, pos)?
    match r
        (st, pos2) -> parseProgram(tokens, Domain.ParserMatch.skipNewlines(tokens, pos2), deps, fns, List.append(stmts, st))

verify parseProgramStmt
    parseProgramStmt([Token.TkInt(1), Token.TkEof], 0, [], [], []) => Result.Ok(Program(deps = [], fns = [], stmts = [Stmt.StmtExpr(Expr.ExprInt(1))]))

fn parse(tokens: List<Token>) -> Result<Program, String>
    ? "Parse a token list into a Program."
    parseProgram(tokens, 0, [], [], [])

verify parse
    parse(Domain.Lexer.lex("x = 5")) => Result.Ok(Program(deps = [], fns = [], stmts = [Stmt.StmtBind("x", Expr.ExprInt(5))]))
    parse(Domain.Lexer.lex("1 + 2")) => Result.Ok(Program(deps = [], fns = [], stmts = [Stmt.StmtExpr(Expr.ExprAdd(Expr.ExprInt(1), Expr.ExprInt(2)))]))
    parse(Domain.Lexer.lex("3 == 3")) => Result.Ok(Program(deps = [], fns = [], stmts = [Stmt.StmtExpr(Expr.ExprEq(Expr.ExprInt(3), Expr.ExprInt(3)))]))
    parse(Domain.Lexer.lex("[1, 2]")) => Result.Ok(Program(deps = [], fns = [], stmts = [Stmt.StmtExpr(Expr.ExprList([Expr.ExprInt(1), Expr.ExprInt(2)]))]))
    parse(Domain.Lexer.lex("+")) => Result.Err("Expected expression, got Plus")
