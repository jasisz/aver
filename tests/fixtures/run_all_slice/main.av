module Node
    intent = "The follow slice as processes: a peer, a walk, an accepting process, a dialling process and a ticker, with two policies over the generated view. The loop between them is generated."
    depends [Bytes, Wire, Pool, Blocks, Chain, Clock, Sockets, Ledger, Clocked]
    effects [Wire.accept, Wire.dialled, Wire.read, Wire.write, Wire.writes, Pool.claim, Pool.gone, Pool.joined, Pool.swept, Blocks.deliver, Blocks.body, Chain.nextTarget, Chain.commit, Clock.tick, Console.print, yield]
    exposes [admit, stop]

fn accepting() -> Unit
    ? "Every peer the listener hands over, seated in the pool, until the listener closes."
    ! [Wire.accept, Pool.joined, yield]
    match Wire.accept()
        Wire.Arrival.Closed -> Unit
        Wire.Arrival.Peer(key) -> match Pool.joined(key)
            Pool.Welcome.Seated -> accepting()
            Pool.Welcome.Refused -> accepting()

fn dialling() -> Unit
    ? "Every dial that settles, seated in the pool, until no dial is outstanding."
    ! [Wire.dialled, Pool.joined, yield]
    match Wire.dialled()
        Wire.Arrival.Closed -> Unit
        Wire.Arrival.Peer(key) -> match Pool.joined(key)
            Pool.Welcome.Seated -> dialling()
            Pool.Welcome.Refused -> dialling()

fn ticker() -> Unit
    ? "One sweep of the pool per tick, until the clock closes, which is when it says how often the deadline let it be asked."
    ! [Clock.tick, Pool.swept, Console.print, yield]
    match Clock.tick()
        Clock.Tick.Closed(asks) -> reported(asks)
        Clock.Tick.Tock -> match Pool.swept()
            Pool.Sweep.Swept(_) -> ticker()

fn reported(asks: Int) -> Unit
    ? "What the clock did over this run, once it has closed."
    ! [Console.print]
    Console.print("ticker: asked {asks} times")

fn peer() -> Unit
    ? "Ask the pool what to fetch, let the helper fetch it, go round; a peer the helper could not finish with is handed back. It is the process that used the wire, so it is the one that says what the wire did once there is nothing left to fetch."
    ! [Pool.claim, Pool.gone, Wire.write, Wire.read, Wire.writes, Blocks.deliver, Console.print, yield]
    Console.print("peer: asking the pool for work")
    match Pool.claim()
        Pool.Assignment.Stop -> reportWire(Wire.writes())
        Pool.Assignment.Work(key, height) -> match fetchBody(key, height)
            true -> peer()
            false -> Pool.gone(key)

fn fetchBody(key: Int, height: Int) -> Bool
    ? "One body from one peer: the write, the read and the hand-over. True when the body landed, false when anything on the way said this peer is finished."
    ! [Wire.write, Wire.read, Blocks.deliver, Console.print, yield]
    match Wire.write(key, Ledger.blockOf(height))
        Result.Err(_) -> false
        Result.Ok(_) -> match Wire.read(key, 4000000, 2000)
            Wire.Heard.EndOfStream -> false
            Wire.Heard.Failed(_) -> false
            Wire.Heard.TimedOut -> timedOut(key)
            Wire.Heard.Data(raw) -> match Blocks.deliver(key, height, raw)
                Blocks.Receipt.Accepted -> true
                Blocks.Receipt.Refused(_) -> false

fn timedOut(key: Int) -> Bool
    ? "A peer that said nothing before this read's deadline ran out: the body did not arrive, so this run is finished with that peer."
    ! [Console.print]
    Console.print("peer: {key} said nothing in time")
    false

fn reportWire(tally: Wire.Tally) -> Unit
    ? "What the wire did over this run: how many payloads it wrote, how many asks the writes took, and how many asks the reads took."
    ! [Console.print]
    match tally
        Wire.Tally.Counted(payloads, writeAsks, readAsks) -> counted(payloads, writeAsks, readAsks)

fn counted(payloads: Int, writeAsks: Int, readAsks: Int) -> Unit
    ? "The one line the wire's own process ends with."
    ! [Console.print]
    Console.print("sockets: {payloads} payloads took {writeAsks} asks and {readAsks} reads")

fn walk() -> Unit
    ? "One connected block per turn: the next target, its validated body, the commit."
    ! [Chain.nextTarget, Blocks.body, Chain.commit, Console.print, yield]
    Console.print("walk: looking for the next block to connect")
    match Chain.nextTarget()
        Option.None -> Unit
        Option.Some(height) -> match Chain.commit(height, summary(Blocks.body(height)))
            Chain.Landed.Connected -> walk()
            Chain.Landed.Rejected(_) -> walk()

fn summary(block: Bytes) -> String
    ? "What a connected block is recorded as."
    "{Bytes.len(block)}"

fn admit(view: Run.View, id: Int) -> Bool
    ? "Whether to serve this id in this turn."
    match Map.get(view.pending, id)
        Option.None -> false
        Option.Some(marker) -> admitted(view, marker)

fn admitted(view: Run.View, marker: Run.Pending) -> Bool
    ? "A peer request is always admitted, even once the run is stopping, so a peer is never left half way through a body. Everything else steps aside once the run is stopping."
    match marker
        Run.Pending.Peer(_, _) -> true
        Run.Pending.Accepting(_, _) -> true
        Run.Pending.Dialling(_, _) -> true
        Run.Pending.Ticker(_, _) -> Bool.not(view.stopping)
        Run.Pending.Walk(_, _) -> Bool.not(view.stopping)

fn stop(view: Run.View) -> Bool
    ? "The run ends when the process asked us to, or when the listener is the only thing still seated: with the pool stopped and the walk and the ticker gone, a client that arrived now would find no work, so waiting for one is over. The flag was read by the turn and reaches here as data."
    Bool.or(view.stopping, onlyTheListener(view, Map.keys(view.pending)))

fn onlyTheListener(view: Run.View, keys: List<Int>) -> Bool
    ? "Whether every seated process under these keys is the accepting one."
    match keys
        [] -> true
        [key, ..rest] -> match Map.get(view.pending, key)
            Option.None -> onlyTheListener(view, rest)
            Option.Some(marker) -> Bool.and(isAcceptingMarker(marker), onlyTheListener(view, rest))

fn isAcceptingMarker(marker: Run.Pending) -> Bool
    ? "Whether one marker stands for the accepting process."
    match marker
        Run.Pending.Accepting(_, _) -> true
        Run.Pending.Peer(_, _) -> false
        Run.Pending.Dialling(_, _) -> false
        Run.Pending.Ticker(_, _) -> false
        Run.Pending.Walk(_, _) -> false

fn isPeer(view: Run.View, id: Int) -> Bool
    ? "Whether the slot under this id holds the peer process."
    match Map.get(view.pending, id)
        Option.None -> false
        Option.Some(marker) -> isPeerMarker(marker)

fn isPeerMarker(marker: Run.Pending) -> Bool
    ? "Whether one marker stands for the peer process."
    match marker
        Run.Pending.Peer(_, _) -> true
        Run.Pending.Accepting(_, _) -> false
        Run.Pending.Dialling(_, _) -> false
        Run.Pending.Ticker(_, _) -> false
        Run.Pending.Walk(_, _) -> false

fn busyView() -> Run.View
    ? "One view with every process seated and one of them ready."
    Run.View(pending = Map.set(Map.set({}, 1, Run.Pending.Peer(3, Run.Wake.Until([], Option.Some(0)))), 2, Run.Pending.Walk(1, Run.Wake.Until([], Option.Some(2)))), ready = [2], askable = [1, 2], dropped = 0, stopping = false)

fn quietView() -> Run.View
    ? "One view with nothing ready."
    Run.View(pending = Map.set(Map.set({}, 1, Run.Pending.Peer(1, Run.Wake.Until([], Option.Some(0)))), 3, Run.Pending.Ticker(1, Run.Wake.Until([], Option.Some(0)))), ready = [], askable = [1, 3], dropped = 0, stopping = false)

fn stoppingView() -> Run.View
    ? "One view with the run already stopping: what a peer is admitted against at the worst moment of a turn."
    Run.View(pending = Map.set(Map.set({}, 1, Run.Pending.Peer(5, Run.Wake.Until([], Option.Some(0)))), 2, Run.Pending.Walk(2, Run.Wake.Until([], Option.Some(0)))), ready = [1], askable = [1, 2], dropped = 0, stopping = true)

fn listeningView() -> Run.View
    ? "One view where the accepting process is the only one still seated."
    Run.View.update(quietView(), pending = Map.set({}, 4, Run.Pending.Accepting(1, Run.Wake.Until([], Option.Some(0)))))

verify stop
    stop(busyView()) => false
    stop(quietView()) => false
    stop(stoppingView()) => true
    stop(listeningView()) => true

verify onlyTheListener
    onlyTheListener(listeningView(), [4]) => true
    onlyTheListener(busyView(), [1, 2]) => false
    onlyTheListener(quietView(), []) => true

verify isAcceptingMarker
    isAcceptingMarker(Run.Pending.Accepting(1, Run.Wake.Until([], Option.Some(0)))) => true
    isAcceptingMarker(Run.Pending.Walk(1, Run.Wake.Until([], Option.Some(2)))) => false

verify admit law aPeerIsAlwaysAdmitted
    given view: Run.View = [busyView(), quietView(), stoppingView()]
    given id: Int = [1, 2, 3]
    when isPeer(view, id)
    because isPeer(view, id)
    admit(view, id) => true

verify admitted
    admitted(busyView(), Run.Pending.Peer(1, Run.Wake.Until([], Option.Some(0)))) => true
    admitted(busyView(), Run.Pending.Accepting(1, Run.Wake.Until([], Option.Some(0)))) => true
    admitted(busyView(), Run.Pending.Dialling(1, Run.Wake.Until([], Option.Some(0)))) => true
    admitted(busyView(), Run.Pending.Ticker(1, Run.Wake.Until([], Option.Some(0)))) => true
    admitted(busyView(), Run.Pending.Walk(1, Run.Wake.Until([], Option.Some(0)))) => true
    admitted(Run.View(pending = {}, ready = [], askable = [], dropped = 0, stopping = true), Run.Pending.Walk(1, Run.Wake.Until([], Option.Some(0)))) => false
    admitted(Run.View(pending = {}, ready = [], askable = [], dropped = 0, stopping = true), Run.Pending.Ticker(1, Run.Wake.Until([], Option.Some(0)))) => false

verify isPeer
    isPeer(busyView(), 1) => true
    isPeer(busyView(), 2) => false
    isPeer(busyView(), 9) => false

verify isPeerMarker
    isPeerMarker(Run.Pending.Peer(1, Run.Wake.Until([], Option.Some(0)))) => true
    isPeerMarker(Run.Pending.Accepting(1, Run.Wake.Until([], Option.Some(0)))) => false
    isPeerMarker(Run.Pending.Dialling(1, Run.Wake.Until([], Option.Some(0)))) => false
    isPeerMarker(Run.Pending.Ticker(1, Run.Wake.Until([], Option.Some(0)))) => false
    isPeerMarker(Run.Pending.Walk(1, Run.Wake.Until([], Option.Some(0)))) => false
