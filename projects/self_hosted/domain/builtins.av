    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValStr(s) -> termPrintStr(s)
        _ -> termPrintStr(Domain.Value.valRepr(v))

fn termPrintStr(s: String) -> Result<Val, String>
    ! [Terminal.print]
    Terminal.print(s)
    Result.Ok(Val.ValUnit)

