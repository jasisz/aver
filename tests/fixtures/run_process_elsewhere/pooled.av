module Pooled
    intent = "Fixture answer module: the answer this program gives to Pool, from one state."
    depends [Pool, Wait]
    exposes [State, fresh, claim]
    effects []
    answers [Pool]

record State
    left: Int

fn fresh() -> State
    ? "Two handles to give out."
    State(left = 2)

fn claim(state: State) -> Tuple<State, Result<Option<Int>, Run.Wake>>
    ? "One handle, until there are none."
    match state.left == 0
        true -> (state, Result.Ok(Option.None))
        false -> (State.update(state, left = state.left - 1), Result.Ok(Option.Some(state.left)))

verify claim
    claim(fresh()) => (State.update(fresh(), left = 1), Result.Ok(Option.Some(2)))
