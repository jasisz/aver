module Node
    intent = "One process, one answer module and one job kind; the loop between them is generated."
    depends [Clock, Clocked, Scoring, Wait, Work]
    effects [Clock.tick, Console.print, yield]

fn ticker() -> Unit
    ? "Waits on the clock until it closes, then says what the jobs scored together."
    ! [Clock.tick, Console.print, yield]
    match Clock.tick()
        Clock.Tick.Tock -> ticker()
        Clock.Tick.Closed(total) -> Console.print("scored {total}")
