module Level
    intent =
        "Procedural level generation for the raycaster."
        "Map stored as List<String> where '#' is wall, '.' is floor."
        "Wall type map uses 'S'=Stone, 'B'=Brick, 'M'=Metal."
    depends [Rng, Types]
    effects []

record Room
    x: Int
    y: Int
    w: Int
    h: Int

fn mapWidth() -> Int
    ? "Width of the level"
    32

verify mapWidth
    mapWidth() => 32

fn mapHeight() -> Int
    ? "Height of the level"
    32

verify mapHeight
    mapHeight() => 32

// ─── String map helpers ────────────────────────────────────────────────────

fn repeatChar(ch: String, n: Int, acc: String) -> String
    ? "Build a string of n copies of ch"
    match n == 0
        true -> acc
        false -> repeatChar(ch, n - 1, acc + ch)

verify repeatChar
    repeatChar("#", 3, "") => "###"
    repeatChar(".", 0, "") => ""
    String.len(repeatChar("#", 32, "")) => 32

fn wallRow() -> String
    ? "A full row of wall characters"
    repeatChar("#", mapWidth(), "")

verify wallRow
    String.len(wallRow()) => 32

fn wallTypeRow() -> String
    ? "A full row of Stone wall type markers"
    repeatChar("S", mapWidth(), "")

verify wallTypeRow
    String.len(wallTypeRow()) => 32

fn buildMap(n: Int, row: String, acc: List<String>) -> List<String>
    ? "Build n identical rows"
    match n == 0
        true -> acc
        false -> buildMap(n - 1, row, List.prepend(row, acc))

verify buildMap
    List.len(buildMap(32, wallRow(), [])) => 32
    List.len(buildMap(0, wallRow(), [])) => 0

fn setCharAt(s: String, idx: Int, ch: String, i: Int, acc: String) -> String
    ? "Replace character at idx in string s"
    match i == String.len(s)
        true -> acc
        false -> match i == idx
            true -> setCharAt(s, idx, ch, i + 1, acc + ch)
            false -> setCharCopy(s, idx, ch, i, acc)

verify setCharAt
    setCharAt("####", 1, ".", 0, "") => "#.##"
    setCharAt("####", 0, ".", 0, "") => ".###"
    setCharAt("####", 3, ".", 0, "") => "###."

fn setCharCopy(s: String, idx: Int, ch: String, i: Int, acc: String) -> String
    ? "Copy character at position i and continue"
    match String.charAt(s, i)
        Option.Some(c) -> setCharAt(s, idx, ch, i + 1, acc + c)
        Option.None -> acc

verify setCharCopy
    setCharCopy("####", 1, ".", 0, "") => "#.##"

fn setTile(levelMap: List<String>, x: Int, y: Int, ch: String, row: Int, acc: List<String>) -> List<String>
    ? "Set one tile in the map"
    match row == List.len(levelMap)
        true -> acc
        false -> match Vector.get(Vector.fromList(levelMap), row)
            Option.Some(r) -> setTileRow(levelMap, x, y, ch, row, acc, r)
            Option.None -> acc

verify setTile
    charAt(setTile(["####", "####"], 1, 0, ".", 0, []), 1, 0) => "."

fn setTileRow(levelMap: List<String>, x: Int, y: Int, ch: String, row: Int, acc: List<String>, r: String) -> List<String>
    ? "Handle one row of setTile"
    nextRow = row + 1
    match row == y
        true -> setTile(levelMap, x, y, ch, nextRow, List.concat(acc, [setCharAt(r, x, ch, 0, "")]))
        false -> setTile(levelMap, x, y, ch, nextRow, List.concat(acc, [r]))

verify setTileRow
    charAt(setTileRow(["####", "####"], 1, 0, ".", 0, [], "####"), 1, 0) => "."

fn charAt(levelMap: List<String>, x: Int, y: Int) -> String
    ? "Get character at (x, y) in the map"
    match Vector.get(Vector.fromList(levelMap), y)
        Option.Some(row) -> match String.charAt(row, x)
            Option.Some(ch) -> ch
            Option.None -> "#"
        Option.None -> "#"

verify charAt
    charAt(["####", "#..#", "####"], 1, 1) => "."
    charAt(["####", "#..#", "####"], 0, 0) => "#"

fn isWall(levelMap: List<String>, mx: Int, my: Int) -> Bool
    ? "Check if tile (mx, my) is a wall"
    match mx < 0
        true -> true
        false -> match my < 0
            true -> true
            false -> match mx >= mapWidth()
                true -> true
                false -> match my >= mapHeight()
                    true -> true
                    false -> charAt(levelMap, mx, my) == "#"

verify isWall
    isWall(buildMap(4, "##.#", []), 2, 0) => false
    isWall(buildMap(4, "####", []), 0, 0) => true
    isWall(buildMap(4, "####", []), 0 - 1, 0) => true

fn wallTypeAt(wallMap: List<String>, mx: Int, my: Int) -> WallType
    ? "Get wall type at position"
    ch = charAt(wallMap, mx, my)
    match ch
        "B" -> WallType.Brick
        "M" -> WallType.Metal
        _ -> WallType.Stone

verify wallTypeAt
    wallTypeAt(["SSS", "SBS", "SSS"], 1, 1) => WallType.Brick
    wallTypeAt(["SSS", "SMS", "SSS"], 1, 1) => WallType.Metal
    wallTypeAt(["SSS", "SSS", "SSS"], 1, 1) => WallType.Stone

// ─── Room carving ──────────────────────────────────────────────────────────

fn carveRow(levelMap: List<String>, x: Int, endX: Int, y: Int) -> List<String>
    ? "Set tiles from x to endX-1 on row y to floor"
    match x == endX
        true -> levelMap
        false -> carveRow(setTile(levelMap, x, y, ".", 0, []), x + 1, endX, y)

verify carveRow
    charAt(carveRow(buildMap(4, "####", []), 1, 3, 0), 2, 0) => "."

fn carveRect(levelMap: List<String>, x: Int, y: Int, endX: Int, endY: Int) -> List<String>
    ? "Carve a rectangle of floor tiles"
    match y == endY
        true -> levelMap
        false -> carveRect(carveRow(levelMap, x, endX, y), x, y + 1, endX, endY)

verify carveRect
    charAt(carveRect(buildMap(4, "####", []), 1, 1, 3, 3), 1, 1) => "."

fn carveRoom(levelMap: List<String>, room: Room) -> List<String>
    ? "Carve a room into the map"
    carveRect(levelMap, room.x, room.y, Int.min(room.x + room.w, mapWidth() - 1), Int.min(room.y + room.h, mapHeight() - 1))

verify carveRoom
    charAt(carveRoom(buildMap(4, "####", []), Room(x = 1, y = 1, w = 2, h = 2)), 1, 1) => "."

fn markRect(wallMap: List<String>, x: Int, y: Int, endX: Int, endY: Int, ch: String) -> List<String>
    ? "Mark a rectangular region with wall type ch"
    match y == endY
        true -> wallMap
        false -> markRect(markRectRow(wallMap, x, endX, y, ch), x, y + 1, endX, endY, ch)

verify markRect
    charAt(markRect(buildMap(4, "SSSS", []), 1, 1, 3, 3, "B"), 1, 1) => "B"

fn markRectRow(wallMap: List<String>, x: Int, endX: Int, y: Int, ch: String) -> List<String>
    ? "Mark one row of a rectangle with wall type"
    match x == endX
        true -> wallMap
        false -> markRectRow(setTile(wallMap, x, y, ch, 0, []), x + 1, endX, y, ch)

verify markRectRow
    charAt(markRectRow(buildMap(4, "SSSS", []), 1, 3, 0, "B"), 2, 0) => "B"

// ─── Corridors ─────────────────────────────────────────────────────────────

fn carveH(levelMap: List<String>, x1: Int, x2: Int, y: Int) -> List<String>
    ? "Horizontal corridor"
    carveRow(levelMap, Int.min(x1, x2), Int.max(x1, x2) + 1, y)

verify carveH
    charAt(carveH(buildMap(4, "####", []), 1, 2, 0), 1, 0) => "."

fn carveV(levelMap: List<String>, x: Int, y1: Int, y2: Int) -> List<String>
    ? "Vertical corridor"
    carveVStep(levelMap, x, Int.min(y1, y2), Int.max(y1, y2) + 1)

verify carveV
    charAt(carveV(buildMap(4, "####", []), 1, 0, 2), 1, 1) => "."

fn carveVStep(levelMap: List<String>, x: Int, y: Int, endY: Int) -> List<String>
    ? "Carve vertical corridor one row at a time"
    match y == endY
        true -> levelMap
        false -> carveVStep(setTile(levelMap, x, y, ".", 0, []), x, y + 1, endY)

verify carveVStep
    charAt(carveVStep(buildMap(4, "####", []), 1, 0, 2), 1, 1) => "."

fn markHCorridor(wallMap: List<String>, x1: Int, x2: Int, y: Int) -> List<String>
    ? "Mark horizontal corridor as Metal"
    markRectRow(wallMap, Int.min(x1, x2), Int.max(x1, x2) + 1, y, "M")

verify markHCorridor
    charAt(markHCorridor(buildMap(4, "SSSS", []), 1, 2, 0), 2, 0) => "M"

fn markVCorridor(wallMap: List<String>, x: Int, y1: Int, y2: Int) -> List<String>
    ? "Mark vertical corridor as Metal"
    markVCorridorStep(wallMap, x, Int.min(y1, y2), Int.max(y1, y2) + 1)

verify markVCorridor
    charAt(markVCorridor(buildMap(4, "SSSS", []), 1, 0, 2), 1, 1) => "M"

fn markVCorridorStep(wallMap: List<String>, x: Int, y: Int, endY: Int) -> List<String>
    ? "Mark vertical corridor step"
    match y == endY
        true -> wallMap
        false -> markVCorridorStep(setTile(wallMap, x, y, "M", 0, []), x, y + 1, endY)

verify markVCorridorStep
    charAt(markVCorridorStep(buildMap(4, "SSSS", []), 1, 0, 2), 1, 1) => "M"

fn connectRooms(levelMap: List<String>, r1: Room, r2: Room) -> List<String>
    ? "Connect two rooms with an L-shaped corridor"
    cx1 = r1.x + Int.div(r1.w, 2)
    cy1 = r1.y + Int.div(r1.h, 2)
    cx2 = r2.x + Int.div(r2.w, 2)
    cy2 = r2.y + Int.div(r2.h, 2)
    carveV(carveH(levelMap, cx1, cx2, cy1), cx2, cy1, cy2)

verify connectRooms
    charAt(connectRooms(buildMap(8, "########", []), Room(x = 1, y = 1, w = 2, h = 2), Room(x = 5, y = 1, w = 2, h = 2)), 4, 2) => "."

fn connectWalls(wallMap: List<String>, r1: Room, r2: Room) -> List<String>
    ? "Mark corridor wall types between two rooms"
    cx1 = r1.x + Int.div(r1.w, 2)
    cy1 = r1.y + Int.div(r1.h, 2)
    cx2 = r2.x + Int.div(r2.w, 2)
    cy2 = r2.y + Int.div(r2.h, 2)
    markVCorridor(markHCorridor(wallMap, cx1, cx2, cy1), cx2, cy1, cy2)

verify connectWalls
    charAt(connectWalls(buildMap(8, "SSSSSSSS", []), Room(x = 1, y = 1, w = 2, h = 2), Room(x = 5, y = 1, w = 2, h = 2)), 4, 2) => "M"

// ─── Room generation ───────────────────────────────────────────────────────

fn roomFromSeed(s: Int) -> Room
    ? "Generate a room from a seed value"
    s1 = Rng.nextSeed(s)
    s2 = Rng.nextSeed(s1)
    s3 = Rng.nextSeed(s2)
    s4 = Rng.nextSeed(s3)
    Room(x = Rng.seedToRange(s1, 2, 24), y = Rng.seedToRange(s2, 2, 24), w = Rng.seedToRange(s3, 4, 8), h = Rng.seedToRange(s4, 4, 8))

verify roomFromSeed
    roomFromSeed(42).w >= 4 => true
    roomFromSeed(42).w <= 8 => true
    roomFromSeed(42).x >= 2 => true

fn roomCenter(room: Room) -> Tuple<Float, Float>
    ? "Center of a room as float coordinates"
    (Float.fromInt(room.x + Int.div(room.w, 2)) + 0.5, Float.fromInt(room.y + Int.div(room.h, 2)) + 0.5)

verify roomCenter
    roomCenter(Room(x = 4, y = 4, w = 6, h = 6)) => (7.5, 7.5)

fn genRooms(seed: Int, n: Int, i: Int, acc: List<Room>) -> List<Room>
    ? "Generate n rooms from seed"
    match i == n
        true -> acc
        false -> genRooms(Rng.advanceSeed(seed, 5), n, i + 1, List.concat(acc, [roomFromSeed(Rng.advanceSeed(seed, i))]))

verify genRooms
    List.len(genRooms(42, 6, 0, [])) => 6

fn carveRooms(levelMap: List<String>, rooms: List<Room>, i: Int) -> List<String>
    ? "Carve all rooms into the map"
    match i == List.len(rooms)
        true -> levelMap
        false -> match Vector.get(Vector.fromList(rooms), i)
            Option.Some(room) -> carveRooms(carveRoom(levelMap, room), rooms, i + 1)
            Option.None -> levelMap

verify carveRooms
    charAt(carveRooms(buildMap(4, "####", []), [Room(x = 1, y = 1, w = 2, h = 2)], 0), 1, 1) => "."

fn markRoomTypes(wallMap: List<String>, rooms: List<Room>, i: Int) -> List<String>
    ? "Mark wall types for all rooms as Brick"
    match i == List.len(rooms)
        true -> wallMap
        false -> match Vector.get(Vector.fromList(rooms), i)
            Option.Some(room) -> markRoomTypes(markRect(wallMap, room.x, room.y, Int.min(room.x + room.w, mapWidth() - 1), Int.min(room.y + room.h, mapHeight() - 1), "B"), rooms, i + 1)
            Option.None -> wallMap

verify markRoomTypes
    charAt(markRoomTypes(buildMap(4, "SSSS", []), [Room(x = 1, y = 1, w = 2, h = 2)], 0), 1, 1) => "B"

fn connectAll(levelMap: List<String>, rooms: List<Room>, i: Int) -> List<String>
    ? "Connect consecutive rooms with corridors"
    match i + 1 == List.len(rooms)
        true -> levelMap
        false -> match Vector.get(Vector.fromList(rooms), i)
            Option.Some(r1) -> connectNext(levelMap, rooms, i, r1)
            Option.None -> levelMap

verify connectAll
    charAt(connectAll(buildMap(8, "########", []), [Room(x = 1, y = 1, w = 2, h = 2), Room(x = 5, y = 1, w = 2, h = 2)], 0), 4, 2) => "."

fn connectNext(levelMap: List<String>, rooms: List<Room>, i: Int, r1: Room) -> List<String>
    ? "Connect room i with room i+1"
    next = i + 1
    match Vector.get(Vector.fromList(rooms), next)
        Option.Some(r2) -> connectAll(connectRooms(levelMap, r1, r2), rooms, next)
        Option.None -> levelMap

verify connectNext
    charAt(connectNext(buildMap(8, "########", []), [Room(x = 1, y = 1, w = 2, h = 2), Room(x = 5, y = 1, w = 2, h = 2)], 0, Room(x = 1, y = 1, w = 2, h = 2)), 4, 2) => "."

fn connectAllWalls(wallMap: List<String>, rooms: List<Room>, i: Int) -> List<String>
    ? "Mark corridor wall types for all connections"
    match i + 1 == List.len(rooms)
        true -> wallMap
        false -> match Vector.get(Vector.fromList(rooms), i)
            Option.Some(r1) -> connectWallsNext(wallMap, rooms, i, r1)
            Option.None -> wallMap

verify connectAllWalls
    charAt(connectAllWalls(buildMap(8, "SSSSSSSS", []), [Room(x = 1, y = 1, w = 2, h = 2), Room(x = 5, y = 1, w = 2, h = 2)], 0), 4, 2) => "M"

fn connectWallsNext(wallMap: List<String>, rooms: List<Room>, i: Int, r1: Room) -> List<String>
    ? "Mark wall type for corridor between rooms i and i+1"
    next = i + 1
    match Vector.get(Vector.fromList(rooms), next)
        Option.Some(r2) -> connectAllWalls(connectWalls(wallMap, r1, r2), rooms, next)
        Option.None -> wallMap

verify connectWallsNext
    charAt(connectWallsNext(buildMap(8, "SSSSSSSS", []), [Room(x = 1, y = 1, w = 2, h = 2), Room(x = 5, y = 1, w = 2, h = 2)], 0, Room(x = 1, y = 1, w = 2, h = 2)), 4, 2) => "M"

// ─── Full level generation ─────────────────────────────────────────────────

fn generateLevel(seed: Int) -> List<String>
    ? "Generate a full level with 6 rooms and corridors"
    rooms = genRooms(seed, 6, 0, [])
    carved = carveRooms(buildMap(mapHeight(), wallRow(), []), rooms, 0)
    connectAll(carved, rooms, 0)

verify generateLevel
    List.len(generateLevel(42)) => 32

fn generateWallTypes(seed: Int) -> List<String>
    ? "Generate wall type map matching the level"
    rooms = genRooms(seed, 6, 0, [])
    marked = markRoomTypes(buildMap(mapHeight(), wallTypeRow(), []), rooms, 0)
    connectAllWalls(marked, rooms, 0)

verify generateWallTypes
    List.len(generateWallTypes(42)) => 32

fn getRooms(seed: Int) -> List<Room>
    ? "Get the rooms list for a seed (for spawn points)"
    genRooms(seed, 6, 0, [])

verify getRooms
    List.len(getRooms(42)) => 6

fn startPos(seed: Int) -> Tuple<Float, Float>
    ? "Player start position: center of first room"
    match Vector.get(Vector.fromList(getRooms(seed)), 0)
        Option.Some(room) -> roomCenter(room)
        Option.None -> (16.0, 16.0)

verify startPos
    match startPos(42)
        (x, y) -> x > 0.0
    => true
