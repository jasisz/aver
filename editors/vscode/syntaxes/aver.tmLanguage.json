{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aver",
  "scopeName": "source.aver",
  "patterns": [
    { "include": "#comment" },
    { "include": "#decision" },
    { "include": "#verify" },
    { "include": "#module" },
    { "include": "#function-definition" },
    { "include": "#type-definition" },
    { "include": "#record-definition" },
    { "include": "#effects-declaration" },
    { "include": "#effect-annotation" },
    { "include": "#description" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#keywords" },
    { "include": "#constructor" },
    { "include": "#namespace-access" },
    { "include": "#operators" },
    { "include": "#type-names" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.aver",
      "match": "//.*$"
    },
    "function-definition": {
      "match": "^\\s*(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "keyword.other.fn.aver" },
        "2": { "name": "entity.name.function.aver" }
      }
    },
    "type-definition": {
      "match": "^\\s*(type)\\s+([A-Z][a-zA-Z0-9_]*)\\s*:",
      "captures": {
        "1": { "name": "keyword.other.type.aver" },
        "2": { "name": "entity.name.type.aver" }
      }
    },
    "record-definition": {
      "match": "^\\s*(record)\\s+([A-Z][a-zA-Z0-9_]*)\\s*:",
      "captures": {
        "1": { "name": "keyword.other.record.aver" },
        "2": { "name": "entity.name.type.aver" }
      }
    },
    "module": {
      "match": "^\\s*(module)\\s+([A-Z][a-zA-Z0-9_.]*)",
      "captures": {
        "1": { "name": "keyword.other.module.aver" },
        "2": { "name": "entity.name.namespace.aver" }
      }
    },
    "decision": {
      "match": "^\\s*(decision)\\s+([A-Z][a-zA-Z0-9_]*)\\s*:",
      "captures": {
        "1": { "name": "keyword.other.decision.aver" },
        "2": { "name": "entity.name.section.aver" }
      }
    },
    "verify": {
      "match": "^\\s*(verify)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
      "captures": {
        "1": { "name": "keyword.other.verify.aver" },
        "2": { "name": "entity.name.function.aver" }
      }
    },
    "effects-declaration": {
      "match": "^\\s*(effects)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
      "captures": {
        "1": { "name": "keyword.other.effects.aver" },
        "2": { "name": "entity.name.type.aver" }
      }
    },
    "keywords": {
      "match": "\\b(fn|match|module|depends|exposes|intent|verify|decision|type|record|effects|date|author|chosen|rejected|impacts|reason|service|needs)\\b",
      "name": "keyword.other.aver"
    },
    "effect-annotation": {
      "match": "(!)\\s*\\[([^\\]]*)\\]",
      "captures": {
        "1": { "name": "keyword.operator.effect.aver" },
        "2": { "name": "entity.name.type.aver" }
      }
    },
    "description": {
      "match": "(\\?)\\s*(\"[^\"]*\")",
      "captures": {
        "1": { "name": "keyword.operator.description.aver" },
        "2": { "name": "string.quoted.double.description.aver" }
      }
    },
    "string": {
      "name": "string.quoted.double.aver",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aver",
          "match": "\\\\[\"\\\\nrt]"
        },
        {
          "name": "meta.interpolation.aver",
          "begin": "\\{(?=[a-zA-Z_0-9(])",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.aver" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.aver" }
          },
          "patterns": [
            { "include": "source.aver" }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.aver",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.aver",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "boolean": {
      "name": "constant.language.boolean.aver",
      "match": "\\b(true|false)\\b"
    },
    "constructor": {
      "match": "\\b(Result\\.Ok|Result\\.Err|Option\\.Some|Option\\.None)\\b",
      "name": "support.function.constructor.aver"
    },
    "namespace-access": {
      "match": "\\b(Int|Float|String|List|Map|Char|Byte|Result|Option|Console|Http|HttpServer|Disk|Tcp)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "support.class.namespace.aver" },
        "2": { "name": "support.function.member.aver" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.aver",
          "match": "->"
        },
        {
          "name": "keyword.operator.fat-arrow.aver",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.aver",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.aver",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.concatenation.aver",
          "match": "\\+\\+"
        },
        {
          "name": "keyword.operator.assignment.aver",
          "match": "(?<!=|!)=(?!=)"
        },
        {
          "name": "keyword.operator.error-propagation.aver",
          "match": "\\?"
        }
      ]
    },
    "type-names": {
      "match": "\\b(Int|Float|String|Bool|Unit|List|Result|Option|Map|Fn)\\b",
      "name": "support.type.aver"
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.aver"
    }
  }
}
