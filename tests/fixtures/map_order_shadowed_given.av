module MapOrderShadowedGiven
    intent =
        "A law whose PARAMETER is named after an unrelated helper that reads a map in iteration order."
        "Every name means one thing in its scope, so this file is refused at the front door and never reaches the exporter. The cone-walk control it used to carry — the same spelling on a verify-block given, which the shadowing ban does not cover — lives in map_order_given_named_after_reader.av."

fn keys() -> List<String>
    ? "Builds a map in place and reads its keys in iteration order. Nothing below calls it."
    m = Map.set(Map.set({}, "b", 5), "a", 3)
    Map.keys(m)

fn howMany(keys: List<Float>) -> Int
    ? "Counts the values it was given."
    List.len(keys)

verify howMany law countsThem
    given keys: List<Float> = [[1.0], [1.0, 2.0]]
    howMany(keys) => List.len(keys)
