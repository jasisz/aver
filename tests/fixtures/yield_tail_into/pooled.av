module Pooled
    intent = "Fixture answer module: the answer this program gives to Pool, from one state."
    depends [Pool, Wait]
    effects []

record State
    left: Int

fn claim(state: State, peer: Int) -> Tuple<State, Pool.ClaimReply>
    ? "Hands the peer its own number back as a handle."
    (state, Pool.ClaimReply.Now(peer))
