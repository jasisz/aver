module Sockets
    intent = "Fixture answer module for Slice.Wire, itself under slice/."
    depends [Slice.Wire, Wait]
    exposes [State, fresh, frame]
    effects []

record State
    left: Int

fn fresh() -> State
    ? "Two frames."
    State(left = 2)

fn frame(state: State) -> Tuple<State, Slice.Wire.FrameReply>
    ? "A message until none are left."
    match state.left == 0
        true -> (state, Slice.Wire.FrameReply.Now(Slice.Wire.Heard.Gone("done")))
        false -> (State.update(state, left = state.left - 1), Slice.Wire.FrameReply.Now(Slice.Wire.Heard.Message("hi")))

verify frame
    frame(fresh()) => (State(left = 1), Slice.Wire.FrameReply.Now(Slice.Wire.Heard.Message("hi")))
