module Trips
    intent =
        "A poll loop that, once something is ready, drains a whole queue from"
        "disk before it waits again. The drain reads on every step and is the"
        "effectful loop the serve-path warning is about: it runs inside one turn."
    exposes [turn]
    effects [Tcp.poll, Disk.readText]

fn drain(n: Int) -> Result<Unit, String>
    ? "Reads n entries, one per step."
    ! [Disk.readText]
    match n < 1
        true -> Result.Ok(Unit)
        false -> drainStep(n)

fn drainStep(n: Int) -> Result<Unit, String>
    ? "Reads one entry, then continues the drain."
    ! [Disk.readText]
    _entry = Disk.readText("queue.log")?
    drain(n - 1)

fn flush(n: Int) -> Result<Unit, String>
    ? "Hands the queue to the drain."
    ! [Disk.readText]
    drain(n)

fn turn(n: Int) -> Result<Unit, String>
    ? "One wait, then the whole drain."
    ! [Tcp.poll, Disk.readText]
    sockets: Map<Int, Tcp.Socket> = {}
    ready = Tcp.poll(sockets, 100)?
    flush(n + List.len(ready))
