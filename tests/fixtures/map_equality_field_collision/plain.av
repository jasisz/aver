module MapEqualityFieldPlain
    intent =
        "A claim comparing two boxes, each holding a Holder.Scored with a float-keyed map written in a different order."
        "Its sibling shadowed.av is the same file plus one unrelated record that happens to be called Scored too — a declaration this claim never names, which must not change its verdict."

    depends [Holder]

record Box
    held: Holder.Scored

fn sameBox(k: Tuple<Int, Int>) -> Bool
    ? "Whether two boxes holding the same pairs in a different written order differ."
    a = Box(held = Holder.scoredOf({(2, 0) => 5, k => 3}))
    b = Box(held = Holder.scoredOf({k => 3, (2, 0) => 5}))
    a != b

verify sameBox
    sameBox((1, 0)) => true
