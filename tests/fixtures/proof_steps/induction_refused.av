module InductionRefused
    intent = "A law about a function that does not recurse: steps induct on a list given itself before they follow another function's recursion."
    exposes [len, double]
    effects []

fn len(xs: List<Int>) -> Int
    ? "Length."
    match xs
        [] -> 0
        [h, ..t] -> 1 + len(t)

verify len
    len([1]) => 1

fn double(xs: List<Int>) -> Int
    ? "Twice the length."
    len(xs) + len(xs)

verify double
    double([1]) => 2

verify double law isTwiceTheLength
    given xs: List<Int> = [[], [1]]
    double(xs) >= len(xs) => true

// A `when` that mentions the list is carried by the induction on the list
// itself: it holds in each case, and the tail's hypothesis is taken once it
// is proved at the tail.

verify double law isTwiceTheLengthWhenShort
    given xs: List<Int> = [[], [1]]
    when len(xs) < 3
    using []
    double(xs) >= len(xs) => true

// The same shape, false at []: it stays open, and the refusal names the
// function that does recurse.

verify double law isMoreThanTheLengthWhenShort
    given xs: List<Int> = [[], [1]]
    when len(xs) < 3
    using []
    double(xs) > len(xs) => true
