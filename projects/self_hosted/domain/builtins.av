module Builtins
    depends [Domain.Ast, Domain.Value, Domain.Builtins.Helpers, Domain.Builtins.List, Domain.Builtins.Primitives, Domain.Builtins.Wrappers]
    intent =
        "Builtin function implementations for the self-hosted evaluator."
        "Dispatches qualified names like List.len, String.charAt, Console.print to sub-modules."
    exposes [callBuiltin, splitDotted, tryVariantConstructor]
    exposes opaque [TcpConn]

record TcpConn
    id: String
    host: String
    port: Int

fn callBuiltin(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch qualified builtin calls to sub-module implementations."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match String.startsWith(name, "List.")
        true -> Domain.Builtins.List.call(name, args)
        false -> match String.startsWith(name, "Int.")
            true -> Domain.Builtins.Primitives.callInt(name, args)
            false -> match String.startsWith(name, "String.")
                true -> Domain.Builtins.Primitives.callString(name, args)
                false -> match String.startsWith(name, "Float.")
                    true -> Domain.Builtins.Primitives.callFloat(name, args)
                    false -> callBuiltinOther(name, args)

verify callBuiltin
    callBuiltin("List.len", [Val.ValList([Val.ValInt(1), Val.ValInt(2)])]) => Result.Ok(Val.ValInt(2))
    callBuiltin("Result.Ok", [Val.ValInt(5)]) => Result.Ok(Val.ValOk(Val.ValInt(5)))

fn callBuiltinOther(name: String, args: List<Val>) -> Result<Val, String>
    ? "Handle non-prefixed builtins: Result.*, Option.*, Bool.*, Map.*, services, Char, variant constructors."
    ! [Args, Console, Disk, Http, Random, Tcp, Terminal, Time]
    match name
        "Char.fromCode" -> Domain.Builtins.Primitives.callChar(name, args)
        "Char.toCode" -> Domain.Builtins.Primitives.callChar(name, args)
        "Console.print" -> builtinConsolePrint(args)
        "Console.readLine" -> builtinConsoleReadLine(args)
        "Console.error" -> builtinConsoleError(args)
        "Console.warn" -> builtinConsoleWarn(args)
        "Disk.readText" -> builtinDiskReadText(args)
        "Disk.writeText" -> builtinDiskWriteText(args)
        "Disk.exists" -> builtinDiskExists(args)
        "Disk.listDir" -> builtinDiskListDir(args)
        "Disk.appendText" -> builtinDiskAppendText(args)
        "Disk.delete" -> builtinDiskDelete(args)
        "Disk.deleteDir" -> builtinDiskDeleteDir(args)
        "Disk.makeDir" -> builtinDiskMakeDir(args)
        "Args.get" -> builtinArgsGet(args)
        "Result.Ok" -> Domain.Builtins.Wrappers.call(name, args)
        "Result.Err" -> Domain.Builtins.Wrappers.call(name, args)
        "Result.withDefault" -> Domain.Builtins.Wrappers.call(name, args)
        "Option.Some" -> Domain.Builtins.Wrappers.call(name, args)
        "Option.None" -> Result.Ok(Val.ValNone)
        "Option.withDefault" -> Domain.Builtins.Wrappers.call(name, args)
        "Option.toResult" -> Domain.Builtins.Wrappers.callOptionToResult(args)
        "Bool.or" -> builtinBoolOr(args)
        "Bool.and" -> builtinBoolAnd(args)
        "Bool.not" -> builtinBoolNot(args)
        "Map.empty" -> builtinMapEmpty(args)
        "Map.set" -> builtinMapSet(args)
        "Map.get" -> builtinMapGet(args)
        "Map.has" -> builtinMapHas(args)
        "Map.entries" -> builtinMapEntries(args)
        "Map.keys" -> builtinMapKeys(args)
        "Map.values" -> builtinMapValues(args)
        "Map.fromList" -> builtinMapFromList(args)
        "Map.size" -> builtinMapSize(args)
        "Map.remove" -> builtinMapRemove(args)
        _ -> callBuiltinServices(name, args)

verify callBuiltinOther
    callBuiltinOther("Result.Ok", [Val.ValInt(1)]) => Result.Ok(Val.ValOk(Val.ValInt(1)))
    callBuiltinOther("Option.None", []) => Result.Ok(Val.ValNone)

fn builtinConsolePrint(args: List<Val>) -> Result<Val, String>
    ? "Console.print(v) -> print any value and return Unit."
    ! [Console.print]
    v = Domain.Builtins.Helpers.oneArg(args)?
    Console.print(Domain.Value.valRepr(v))
    Result.Ok(Val.ValUnit)

fn builtinConsoleError(args: List<Val>) -> Result<Val, String>
    ? "Console.error(v) -> print to stderr."
    ! [Console.print]
    v = Domain.Builtins.Helpers.oneArg(args)?
    Console.print(Domain.Value.valRepr(v))
    Result.Ok(Val.ValUnit)

fn builtinConsoleWarn(args: List<Val>) -> Result<Val, String>
    ? "Console.warn(v) -> print warning."
    ! [Console.print]
    v = Domain.Builtins.Helpers.oneArg(args)?
    Console.print(Domain.Value.valRepr(v))
    Result.Ok(Val.ValUnit)

fn builtinConsoleReadLine(args: List<Val>) -> Result<Val, String>
    ? "Console.readLine() -> Result<String, String>."
    ! [Console.readLine]
    match Console.readLine()
        Result.Ok(line) -> Result.Ok(Val.ValOk(Val.ValStr(line)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinDiskReadText(args: List<Val>) -> Result<Val, String>
    ? "Disk.readText(path) -> Result string."
    ! [Disk.readText]
    v = Domain.Builtins.Helpers.oneArg(args)?
    path = Domain.Builtins.Helpers.expectStr(v)?
    match Disk.readText(path)
        Result.Ok(content) -> Result.Ok(Val.ValOk(Val.ValStr(content)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinArgsGet(args: List<Val>) -> Result<Val, String>
    ? "Args.get() -> list of string args."
    ! [Args.get]
    rawArgs = Args.get()
    Result.Ok(Val.ValList(stringsToVals(rawArgs, [])))

fn stringsToVals(strs: List<String>, acc: List<Val>) -> List<Val>
    ? "Convert list of strings to list of ValStr."
    match strs
        [] -> List.reverse(acc)
        [s, ..rest] -> stringsToVals(rest, List.prepend(Val.ValStr(s), acc))

verify stringsToVals
    stringsToVals(["a", "b"], []) => [Val.ValStr("a"), Val.ValStr("b")]
    stringsToVals([], []) => []

fn builtinMapEntries(args: List<Val>) -> Result<Val, String>
    ? "Map.entries(map) -> List of tuples."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValRecord(_, fields) -> Result.Ok(Val.ValList(mapFieldsToTuples(fields, [])))
        _ -> Result.Err("Map.entries requires a Map")

fn mapFieldsToTuples(fields: List<(String, Val)>, acc: List<Val>) -> List<Val>
    ? "Convert map fields to list of (key, value) tuples."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (k, v) -> mapFieldsToTuples(rest, List.prepend(Val.ValTuple([Val.ValStr(k), v]), acc))

fn builtinMapKeys(args: List<Val>) -> Result<Val, String>
    ? "Map.keys(map) -> List of keys."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValRecord(_, fields) -> Result.Ok(Val.ValList(mapFieldsToKeys(fields, [])))
        _ -> Result.Err("Map.keys requires a Map")

fn mapFieldsToKeys(fields: List<(String, Val)>, acc: List<Val>) -> List<Val>
    ? "Extract keys from map fields."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (k, _) -> mapFieldsToKeys(rest, List.prepend(Val.ValStr(k), acc))

fn builtinMapValues(args: List<Val>) -> Result<Val, String>
    ? "Map.values(map) -> List of values."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValRecord(_, fields) -> Result.Ok(Val.ValList(mapFieldsToValues(fields, [])))
        _ -> Result.Err("Map.values requires a Map")

fn mapFieldsToValues(fields: List<(String, Val)>, acc: List<Val>) -> List<Val>
    ? "Extract values from map fields."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (_, v) -> mapFieldsToValues(rest, List.prepend(v, acc))

fn builtinMapFromList(args: List<Val>) -> Result<Val, String>
    ? "Map.fromList(entries) -> Map."
    v = Domain.Builtins.Helpers.oneArg(args)?
    items = Domain.Builtins.Helpers.expectList(v)?
    Result.Ok(Val.ValRecord("Map", tuplesToMapFields(items, [])))

fn tuplesToMapFields(items: List<Val>, acc: List<(String, Val)>) -> List<(String, Val)>
    ? "Convert list of (key, value) tuples to map fields."
    match items
        [] -> List.reverse(acc)
        [item, ..rest] -> match item
            Val.ValTuple(parts) -> tuplesToMapFieldsOne(parts, rest, acc)
            _ -> tuplesToMapFields(rest, acc)

fn tuplesToMapFieldsOne(parts: List<Val>, rest: List<Val>, acc: List<(String, Val)>) -> List<(String, Val)>
    ? "Extract key-value from tuple parts."
    match List.get(parts, 0)
        Option.Some(kV) -> match List.get(parts, 1)
            Option.Some(vV) -> tuplesToMapFields(rest, List.prepend((Domain.Value.valRepr(kV), vV), acc))
            Option.None -> tuplesToMapFields(rest, acc)
        Option.None -> tuplesToMapFields(rest, acc)

fn builtinMapSize(args: List<Val>) -> Result<Val, String>
    ? "Map.size(map) -> Int."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValRecord(_, fields) -> Result.Ok(Val.ValInt(List.len(fields)))
        _ -> Result.Err("Map.size requires a Map")

fn builtinMapRemove(args: List<Val>) -> Result<Val, String>
    ? "Map.remove(map, key) -> Map."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (mapV, keyV) -> builtinMapRemoveInner(mapV, keyV)

fn builtinMapRemoveInner(mapV: Val, keyV: Val) -> Result<Val, String>
    ? "Inner Map.remove."
    match mapV
        Val.ValRecord(_, fields) -> Result.Ok(Val.ValRecord("Map", removeMapField(fields, Domain.Value.valRepr(keyV), [])))
        _ -> Result.Err("Map.remove requires a Map")

fn removeMapField(fields: List<(String, Val)>, key: String, acc: List<(String, Val)>) -> List<(String, Val)>
    ? "Remove field with given key."
    match fields
        [] -> List.reverse(acc)
        [pair, ..rest] -> match pair
            (k, v) -> match k == key
                true -> List.concat(List.reverse(acc), rest)
                false -> removeMapField(rest, key, List.prepend((k, v), acc))

fn callBuiltinServices(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch Terminal.*, Time.*, Random.*, Http.*, Tcp.* service builtins."
    ! [Http, Random, Tcp, Terminal, Time]
    match name
        "Random.int" -> builtinRandomInt(args)
        "Time.now" -> builtinTimeNow(args)
        "Time.sleep" -> builtinTimeSleep(args)
        "Time.unixMs" -> builtinTimeUnixMs(args)
        "Http.get" -> builtinHttpSimple(args, "get")
        "Http.head" -> builtinHttpSimple(args, "head")
        "Http.delete" -> builtinHttpSimple(args, "delete")
        "Http.post" -> builtinHttpBody(args, "post")
        "Http.put" -> builtinHttpBody(args, "put")
        "Http.patch" -> builtinHttpBody(args, "patch")
        "Tcp.send" -> builtinTcpSend(args)
        "Tcp.ping" -> builtinTcpPing(args)
        "Tcp.connect" -> builtinTcpConnect(args)
        "Tcp.writeLine" -> builtinTcpWriteLine(args)
        "Tcp.readLine" -> builtinTcpReadLine(args)
        "Tcp.close" -> builtinTcpClose(args)
        "Terminal.clear" -> builtinTerminalNoArg(name, args)
        "Terminal.flush" -> builtinTerminalNoArg(name, args)
        "Terminal.enableRawMode" -> builtinTerminalNoArg(name, args)
        "Terminal.disableRawMode" -> builtinTerminalNoArg(name, args)
        "Terminal.hideCursor" -> builtinTerminalNoArg(name, args)
        "Terminal.showCursor" -> builtinTerminalNoArg(name, args)
        "Terminal.resetColor" -> builtinTerminalNoArg(name, args)
        "Terminal.readKey" -> builtinTerminalReadKey(args)
        "Terminal.size" -> builtinTerminalSize(args)
        "Terminal.print" -> builtinTerminalPrint(args)
        "Terminal.setColor" -> builtinTerminalSetColor(args)
        "Terminal.moveTo" -> builtinTerminalMoveTo(args)
        _ -> tryVariantConstructor(name, args)

fn builtinRandomInt(args: List<Val>) -> Result<Val, String>
    ? "Random.int(min, max) -> random integer."
    ! [Random.int]
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (minV, maxV) -> builtinRandomIntInner(minV, maxV)

fn builtinRandomIntInner(minV: Val, maxV: Val) -> Result<Val, String>
    ? "Inner Random.int."
    ! [Random.int]
    minN = Domain.Builtins.Helpers.expectInt(minV)?
    maxN = Domain.Builtins.Helpers.expectInt(maxV)?
    Result.Ok(Val.ValInt(Random.int(minN, maxN)))

fn builtinTimeSleep(args: List<Val>) -> Result<Val, String>
    ? "Time.sleep(ms) -> Unit."
    ! [Time.sleep]
    v = Domain.Builtins.Helpers.oneArg(args)?
    ms = Domain.Builtins.Helpers.expectInt(v)?
    Time.sleep(ms)
    Result.Ok(Val.ValUnit)

fn builtinTimeUnixMs(args: List<Val>) -> Result<Val, String>
    ? "Time.unixMs() -> Int."
    ! [Time.unixMs]
    Result.Ok(Val.ValInt(Time.unixMs()))

fn builtinTerminalNoArg(name: String, args: List<Val>) -> Result<Val, String>
    ? "Terminal no-arg commands: clear, flush, enableRawMode, etc."
    ! [Terminal]
    match name
        "Terminal.clear" -> termClear()
        "Terminal.flush" -> termFlush()
        "Terminal.enableRawMode" -> termEnableRawMode()
        "Terminal.disableRawMode" -> termDisableRawMode()
        "Terminal.hideCursor" -> termHideCursor()
        "Terminal.showCursor" -> termShowCursor()
        "Terminal.resetColor" -> termResetColor()
        _ -> Result.Err("unknown terminal command: {name}")

fn termClear() -> Result<Val, String>
    ! [Terminal.clear]
    Terminal.clear()
    Result.Ok(Val.ValUnit)

fn termFlush() -> Result<Val, String>
    ! [Terminal.flush]
    Terminal.flush()
    Result.Ok(Val.ValUnit)

