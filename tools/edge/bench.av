module Bench
    intent = "Bench seahorse with various sizes/iters."
    depends [Fractal]
    exposes [main]
    effects [Console.print, Time.unixMs]

fn main() -> Unit
    ! [Console.print, Time.unixMs]
    t0 = Time.unixMs()
    full = Fractal.render(80, 20, 60, Fractal.fullView())
    t1 = Time.unixMs()
    zoom = Fractal.render(80, 20, 80, Fractal.seahorseView())
    t2 = Time.unixMs()
    Console.print("full(80x20)={Int.toString(t1 - t0)}ms sea(80x20,80)={Int.toString(t2 - t1)}ms total={Int.toString(t2 - t0)}ms")
