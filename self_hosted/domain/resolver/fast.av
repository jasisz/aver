module Fast
    depends [Domain.Ast]
    intent =
        "Function fast-path classification for the self-hosted resolver."
        "Tags tiny wrappers and small fixed-shape matches so eval can bypass the full stmt walker."
    exposes [annotateFastFns]

fn annotateFastFns(fns: List<FnDef>, fnMap: Map<String, Int>, acc: List<FnDef>) -> List<FnDef>
    ? "Tag simple single-expression functions so eval can skip the stmt walker."
    match fns
        [] -> List.reverse(acc)
        [f, ..rest] -> annotateFastFns(rest, fnMap, List.prepend(annotateFastFn(f, fnMap), acc))

verify annotateFastFns
    annotateFastFns([], Map.empty(), []) => []

fn annotateFastFn(fd: FnDef, fnMap: Map<String, Int>) -> FnDef
    ? "Attach a narrow fast-path tag to a function definition."
    selfId = Option.withDefault(Map.get(fnMap, fd.name), -1)
    FnDef(name = fd.name, params = fd.params, body = fd.body, slotCount = fd.slotCount, slotMap = fd.slotMap, fastPath = classifyFastPath(fd.body), tailLoop = classifyTailLoop(selfId, fd.body))

verify annotateFastFn
    annotateFastFn(FnDef(name = "f", params = [], body = [Stmt.StmtExpr(Expr.ExprInt(1))], slotCount = 0, slotMap = Map.empty(), fastPath = FnFastPath.FastNone, tailLoop = false), Map.empty()).name => "f"

fn classifyTailLoop(selfId: Int, body: List<Stmt>) -> Bool
    ? "Precompute whether the final expression position can self-tail-call directly."
    match body
        [] -> false
        [stmt, ..rest] -> match rest
            [] -> stmtNeedsTailLoop(selfId, stmt)
            _ -> classifyTailLoop(selfId, rest)

verify classifyTailLoop
    classifyTailLoop(0, []) => false
    classifyTailLoop(0, [Stmt.StmtExpr(Expr.ExprInt(1))]) => false

fn stmtNeedsTailLoop(selfId: Int, stmt: Stmt) -> Bool
    ? "Only the final expression statement can trigger the tail-loop slot evaluator."
    match stmt
        Stmt.StmtExpr(expr) -> exprNeedsTailLoop(selfId, expr)
        _ -> false

verify stmtNeedsTailLoop
    stmtNeedsTailLoop(0, Stmt.StmtExpr(Expr.ExprInt(1))) => false
    stmtNeedsTailLoop(0, Stmt.StmtBind("x", Expr.ExprInt(1))) => false

fn exprNeedsTailLoop(selfId: Int, expr: Expr) -> Bool
    ? "Recognize direct self-calls in tail position, including bool branches and matches."
    match expr
        Expr.ExprCallDirect(fnId, _) -> fnId == selfId
        Expr.ExprBoolBranch(_, thenExpr, elseExpr) -> match exprNeedsTailLoop(selfId, thenExpr)
            true -> true
            false -> exprNeedsTailLoop(selfId, elseExpr)
        Expr.ExprMatch(_, arms) -> armsNeedTailLoop(selfId, arms)
        _ -> false

verify exprNeedsTailLoop
    exprNeedsTailLoop(0, Expr.ExprInt(42)) => false
    exprNeedsTailLoop(5, Expr.ExprCallDirect(5, [])) => true
    exprNeedsTailLoop(5, Expr.ExprCallDirect(3, [])) => false

fn armsNeedTailLoop(selfId: Int, arms: List<MatchArm>) -> Bool
    ? "Return true when any match arm ends in a direct self-tail-call."
    match arms
        [] -> false
        [arm, ..rest] -> match exprNeedsTailLoop(selfId, arm.body)
            true -> true
            false -> armsNeedTailLoop(selfId, rest)

verify armsNeedTailLoop
    armsNeedTailLoop(0, []) => false

fn classifyFastPath(body: List<Stmt>) -> FnFastPath
    ? "Single expression bodies can bypass evalStmts* and evaluate the expr directly."
    match body
        [stmt, ..rest] -> match rest == []
            true -> classifyFastStmt(stmt)
            false -> FnFastPath.FastNone
        _ -> FnFastPath.FastNone

verify classifyFastPath
    classifyFastPath([]) => FnFastPath.FastNone
    classifyFastPath([Stmt.StmtExpr(Expr.ExprInt(42))]) => FnFastPath.FastLeaf(FastLeaf.LeafConstInt(42))

fn classifyFastStmt(stmt: Stmt) -> FnFastPath
    ? "Only plain expression bodies get a fast expr tag."
    match stmt
        Stmt.StmtExpr(expr) -> classifyFastExpr(expr)
        _ -> FnFastPath.FastNone

verify classifyFastStmt
    classifyFastStmt(Stmt.StmtExpr(Expr.ExprInt(42))) => FnFastPath.FastLeaf(FastLeaf.LeafConstInt(42))
    classifyFastStmt(Stmt.StmtBind("x", Expr.ExprInt(1))) => FnFastPath.FastNone

fn classifyFastExpr(expr: Expr) -> FnFastPath
    ? "Recognize a few leaf-like and branch-like expr shapes worth running without the full stmt walker."
    match classifyFastLeafExpr(expr)
        Option.Some(leaf) -> FnFastPath.FastLeaf(leaf)
        Option.None -> match expr
            Expr.ExprCallDirect(fnId, args) -> classifyFastForwardCall(fnId, args)
            Expr.ExprMatch(scrutinee, arms) -> classifyFastMatch(scrutinee, arms)
            _ -> FnFastPath.FastSingleExpr

verify classifyFastExpr
    classifyFastExpr(Expr.ExprInt(42)) => FnFastPath.FastLeaf(FastLeaf.LeafConstInt(42))
    classifyFastExpr(Expr.ExprStr("hi")) => FnFastPath.FastLeaf(FastLeaf.LeafConstStr("hi"))

fn classifyFastLeafExpr(expr: Expr) -> Option<FastLeaf>
    ? "Recognize a leaf-like expr that can be executed without descending the AST."
    match expr
        Expr.ExprInt(n) -> Option.Some(FastLeaf.LeafConstInt(n))
        Expr.ExprFloat(f) -> Option.Some(FastLeaf.LeafConstFloat(f))
        Expr.ExprStr(s) -> Option.Some(FastLeaf.LeafConstStr(s))
        Expr.ExprBool(b) -> Option.Some(FastLeaf.LeafConstBool(b))
        Expr.ExprSlot(slot) -> Option.Some(FastLeaf.LeafSlot(slot))
        Expr.ExprFieldAccess(obj, field) -> classifyFastFieldAccess(obj, field)
        Expr.ExprCallBuiltin(name, args) -> classifyFastBuiltinLeaf(name, args)
        Expr.ExprAdd(a, b) -> classifyFastBinopSlots(BinOp.OpAdd, a, b)
        Expr.ExprSub(a, b) -> classifyFastBinopSlots(BinOp.OpSub, a, b)
        Expr.ExprMul(a, b) -> classifyFastBinopSlots(BinOp.OpMul, a, b)
        Expr.ExprDiv(a, b) -> classifyFastBinopSlots(BinOp.OpDiv, a, b)
        Expr.ExprEq(a, b) -> classifyFastCmpSlots(CmpOp.CmpEq, a, b)
        Expr.ExprNeq(a, b) -> classifyFastCmpSlots(CmpOp.CmpNeq, a, b)
        Expr.ExprLt(a, b) -> classifyFastCmpSlots(CmpOp.CmpLt, a, b)
        Expr.ExprGt(a, b) -> classifyFastCmpSlots(CmpOp.CmpGt, a, b)
        Expr.ExprLte(a, b) -> classifyFastCmpSlots(CmpOp.CmpLte, a, b)
        Expr.ExprGte(a, b) -> classifyFastCmpSlots(CmpOp.CmpGte, a, b)
        _ -> Option.None

verify classifyFastLeafExpr
    classifyFastLeafExpr(Expr.ExprInt(42)) => Option.Some(FastLeaf.LeafConstInt(42))
    classifyFastLeafExpr(Expr.ExprStr("hi")) => Option.Some(FastLeaf.LeafConstStr("hi"))
    classifyFastLeafExpr(Expr.ExprBool(true)) => Option.Some(FastLeaf.LeafConstBool(true))
    classifyFastLeafExpr(Expr.ExprSlot(3)) => Option.Some(FastLeaf.LeafSlot(3))

fn classifyFastFieldAccess(obj: Expr, field: String) -> Option<FastLeaf>
    ? "Recognize obj.field when obj is already a resolved slot."
    match obj
        Expr.ExprSlot(slot) -> Option.Some(FastLeaf.LeafFieldAccess(slot, field))
        _ -> Option.None

verify classifyFastFieldAccess
    classifyFastFieldAccess(Expr.ExprSlot(0), "name") => Option.Some(FastLeaf.LeafFieldAccess(0, "name"))
    classifyFastFieldAccess(Expr.ExprInt(1), "name") => Option.None

fn classifyFastBinopSlots(op: BinOp, a: Expr, b: Expr) -> Option<FastLeaf>
    ? "Recognize slot op slot for arithmetic."
    match a
        Expr.ExprSlot(sa) -> match b
            Expr.ExprSlot(sb) -> Option.Some(FastLeaf.LeafBinopSlots(op, sa, sb))
            _ -> Option.None
        _ -> Option.None

verify classifyFastBinopSlots
    classifyFastBinopSlots(BinOp.OpAdd, Expr.ExprSlot(0), Expr.ExprSlot(1)) => Option.Some(FastLeaf.LeafBinopSlots(BinOp.OpAdd, 0, 1))
    classifyFastBinopSlots(BinOp.OpAdd, Expr.ExprInt(1), Expr.ExprSlot(0)) => Option.None

fn classifyFastCmpSlots(op: CmpOp, a: Expr, b: Expr) -> Option<FastLeaf>
    ? "Recognize slot cmp slot for comparisons."
    match a
        Expr.ExprSlot(sa) -> match b
            Expr.ExprSlot(sb) -> Option.Some(FastLeaf.LeafCmpSlots(op, sa, sb))
            _ -> Option.None
        _ -> Option.None

verify classifyFastCmpSlots
    classifyFastCmpSlots(CmpOp.CmpEq, Expr.ExprSlot(0), Expr.ExprSlot(1)) => Option.Some(FastLeaf.LeafCmpSlots(CmpOp.CmpEq, 0, 1))
    classifyFastCmpSlots(CmpOp.CmpLt, Expr.ExprInt(1), Expr.ExprSlot(0)) => Option.None

fn classifyFastBuiltinLeaf(name: String, args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize tiny builtin wrappers that only shuffle slots and integer constants."
    match name == "Vector.new"
        true -> classifyFastVectorNew(args)
        false -> match name == "Vector.len"
            true -> classifyFastVectorLen(args)
            false -> match name == "Option.withDefault"
                true -> classifyFastOptionWithDefault(args)
                false -> match name == "Map.get"
                    true -> classifyFastMapGet(args)
                    false -> match name == "Map.set"
                        true -> classifyFastMapSet(args)
                        false -> match name == "Map.has"
                            true -> classifyFastMapHas(args)
                            false -> match name == "Map.remove"
                                true -> classifyFastMapRemove(args)
                                false -> Option.None

verify classifyFastBuiltinLeaf
    classifyFastBuiltinLeaf("unknown", []) => Option.None

fn classifyFastMapGet(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Map.get(slotMap, slotKey)."
    match args
        [mapExpr, ..rest] -> match rest
            [keyExpr, ..ignored] -> classifyFastMapGetArgs(mapExpr, keyExpr)
            _ -> Option.None
        _ -> Option.None

verify classifyFastMapGet
    classifyFastMapGet([Expr.ExprSlot(0), Expr.ExprSlot(1)]) => Option.Some(FastLeaf.LeafMapGet(0, 1))
    classifyFastMapGet([]) => Option.None

fn classifyFastMapGetArgs(mapExpr: Expr, keyExpr: Expr) -> Option<FastLeaf>
    ? "Encode a direct map lookup when both operands are resolved slots."
    match mapExpr
        Expr.ExprSlot(mapSlot) -> match keyExpr
            Expr.ExprSlot(keySlot) -> Option.Some(FastLeaf.LeafMapGet(mapSlot, keySlot))
            _ -> Option.None
        _ -> Option.None

verify classifyFastMapGetArgs
    classifyFastMapGetArgs(Expr.ExprSlot(0), Expr.ExprSlot(1)) => Option.Some(FastLeaf.LeafMapGet(0, 1))
    classifyFastMapGetArgs(Expr.ExprInt(0), Expr.ExprSlot(1)) => Option.None

fn classifyFastMapSet(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Map.set(slotMap, slotKey, slotValue)."
    match args
        [mapExpr, ..rest] -> match rest
            [keyExpr, ..rest2] -> match rest2
                [valueExpr, ..ignored] -> classifyFastMapSetArgs(mapExpr, keyExpr, valueExpr)
                _ -> Option.None
            _ -> Option.None
        _ -> Option.None

verify classifyFastMapSet
    classifyFastMapSet([Expr.ExprSlot(0), Expr.ExprSlot(1), Expr.ExprSlot(2)]) => Option.Some(FastLeaf.LeafMapSet(0, 1, 2))
    classifyFastMapSet([]) => Option.None

fn classifyFastMapSetArgs(mapExpr: Expr, keyExpr: Expr, valueExpr: Expr) -> Option<FastLeaf>
    ? "Encode a direct map update when all operands are resolved slots."
    match mapExpr
        Expr.ExprSlot(mapSlot) -> match keyExpr
            Expr.ExprSlot(keySlot) -> match valueExpr
                Expr.ExprSlot(valueSlot) -> Option.Some(FastLeaf.LeafMapSet(mapSlot, keySlot, valueSlot))
                _ -> Option.None
            _ -> Option.None
        _ -> Option.None

verify classifyFastMapSetArgs
    classifyFastMapSetArgs(Expr.ExprSlot(0), Expr.ExprSlot(1), Expr.ExprSlot(2)) => Option.Some(FastLeaf.LeafMapSet(0, 1, 2))
    classifyFastMapSetArgs(Expr.ExprInt(0), Expr.ExprSlot(1), Expr.ExprSlot(2)) => Option.None

fn classifyFastMapHas(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Map.has(slotMap, slotKey)."
    match args
        [mapExpr, ..rest] -> match rest
            [keyExpr, ..ignored] -> classifyFastMapHasArgs(mapExpr, keyExpr)
            _ -> Option.None
        _ -> Option.None

verify classifyFastMapHas
    classifyFastMapHas([Expr.ExprSlot(0), Expr.ExprSlot(1)]) => Option.Some(FastLeaf.LeafMapHas(0, 1))
    classifyFastMapHas([]) => Option.None

fn classifyFastMapHasArgs(mapExpr: Expr, keyExpr: Expr) -> Option<FastLeaf>
    ? "Encode a direct map membership test when both operands are resolved slots."
    match mapExpr
        Expr.ExprSlot(mapSlot) -> match keyExpr
            Expr.ExprSlot(keySlot) -> Option.Some(FastLeaf.LeafMapHas(mapSlot, keySlot))
            _ -> Option.None
        _ -> Option.None

verify classifyFastMapHasArgs
    classifyFastMapHasArgs(Expr.ExprSlot(0), Expr.ExprSlot(1)) => Option.Some(FastLeaf.LeafMapHas(0, 1))
    classifyFastMapHasArgs(Expr.ExprInt(0), Expr.ExprSlot(1)) => Option.None

fn classifyFastMapRemove(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Map.remove(slotMap, slotKey)."
    match args
        [mapExpr, ..rest] -> match rest
            [keyExpr, ..ignored] -> classifyFastMapRemoveArgs(mapExpr, keyExpr)
            _ -> Option.None
        _ -> Option.None

verify classifyFastMapRemove
    classifyFastMapRemove([Expr.ExprSlot(0), Expr.ExprSlot(1)]) => Option.Some(FastLeaf.LeafMapRemove(0, 1))
    classifyFastMapRemove([]) => Option.None

fn classifyFastMapRemoveArgs(mapExpr: Expr, keyExpr: Expr) -> Option<FastLeaf>
    ? "Encode a direct map key removal when both operands are resolved slots."
    match mapExpr
        Expr.ExprSlot(mapSlot) -> match keyExpr
            Expr.ExprSlot(keySlot) -> Option.Some(FastLeaf.LeafMapRemove(mapSlot, keySlot))
            _ -> Option.None
        _ -> Option.None

verify classifyFastMapRemoveArgs
    classifyFastMapRemoveArgs(Expr.ExprSlot(0), Expr.ExprSlot(1)) => Option.Some(FastLeaf.LeafMapRemove(0, 1))
    classifyFastMapRemoveArgs(Expr.ExprInt(0), Expr.ExprSlot(1)) => Option.None

fn classifyFastVectorLen(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Vector.len(slotVec)."
    match args
        [vecExpr, ..ignored] -> match vecExpr
            Expr.ExprSlot(slot) -> Option.Some(FastLeaf.LeafVectorLen(slot))
            _ -> Option.None
        _ -> Option.None

verify classifyFastVectorLen
    classifyFastVectorLen([Expr.ExprSlot(0)]) => Option.Some(FastLeaf.LeafVectorLen(0))
    classifyFastVectorLen([]) => Option.None

fn classifyFastVectorNew(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Vector.new(slot, int) wrappers."
    match args
        [sizeExpr, ..rest] -> match rest
            [fillExpr, ..ignored] -> classifyFastVectorNewArgs(sizeExpr, fillExpr)
            _ -> Option.None
        _ -> Option.None

verify classifyFastVectorNew
    classifyFastVectorNew([Expr.ExprSlot(0), Expr.ExprInt(0)]) => Option.Some(FastLeaf.LeafVectorNew(0, 0))
    classifyFastVectorNew([]) => Option.None

fn classifyFastVectorNewArgs(sizeExpr: Expr, fillExpr: Expr) -> Option<FastLeaf>
    ? "Encode Vector.new(slot, int) without keeping the whole AST around."
    match sizeExpr
        Expr.ExprSlot(sizeSlot) -> match fillExpr
            Expr.ExprInt(fill) -> Option.Some(FastLeaf.LeafVectorNew(sizeSlot, fill))
            _ -> Option.None
        _ -> Option.None

verify classifyFastVectorNewArgs
    classifyFastVectorNewArgs(Expr.ExprSlot(0), Expr.ExprInt(0)) => Option.Some(FastLeaf.LeafVectorNew(0, 0))
    classifyFastVectorNewArgs(Expr.ExprInt(5), Expr.ExprInt(0)) => Option.None

fn classifyFastOptionWithDefault(args: List<Expr>) -> Option<FastLeaf>
    ? "Recognize Option.withDefault(Vector.get(slot, slot), int)."
    match args
        [optionExpr, ..rest] -> match rest
            [defaultExpr, ..ignored] -> classifyFastOptionWithDefaultArgs(optionExpr, defaultExpr)
            _ -> Option.None
        _ -> Option.None

verify classifyFastOptionWithDefault
    classifyFastOptionWithDefault([]) => Option.None

fn classifyFastOptionWithDefaultArgs(optionExpr: Expr, defaultExpr: Expr) -> Option<FastLeaf>
    ? "Encode the common Vector.get-with-default wrapper used in tiny helpers like cellAt."
    match optionExpr
        Expr.ExprCallBuiltin(name, innerArgs) -> match name == "Vector.get"
            true -> classifyFastVectorGet(innerArgs, defaultExpr)
            false -> Option.None
        _ -> Option.None

verify classifyFastOptionWithDefaultArgs
    classifyFastOptionWithDefaultArgs(Expr.ExprInt(1), Expr.ExprInt(0)) => Option.None

fn classifyFastVectorGet(args: List<Expr>, defaultExpr: Expr) -> Option<FastLeaf>
    ? "Recognize Vector.get(slotVec, slotIdx) with an integer default."
    match args
        [vecExpr, ..rest] -> match rest
            [idxExpr, ..ignored] -> classifyFastVectorGetArgs(vecExpr, idxExpr, defaultExpr)
            _ -> Option.None
        _ -> Option.None

verify classifyFastVectorGet
    classifyFastVectorGet([], Expr.ExprInt(0)) => Option.None

fn classifyFastVectorGetArgs(vecExpr: Expr, idxExpr: Expr, defaultExpr: Expr) -> Option<FastLeaf>
    ? "Encode Vector.get(slotVec, slotIdx) with an integer fallback."
    match vecExpr
        Expr.ExprSlot(vecSlot) -> match idxExpr
            Expr.ExprSlot(idxSlot) -> match defaultExpr
                Expr.ExprInt(defaultValue) -> Option.Some(FastLeaf.LeafVectorGetOrInt(vecSlot, idxSlot, defaultValue))
                _ -> Option.None
            _ -> Option.None
        _ -> Option.None

verify classifyFastVectorGetArgs
    classifyFastVectorGetArgs(Expr.ExprSlot(0), Expr.ExprSlot(1), Expr.ExprInt(99)) => Option.Some(FastLeaf.LeafVectorGetOrInt(0, 1, 99))
    classifyFastVectorGetArgs(Expr.ExprInt(0), Expr.ExprSlot(1), Expr.ExprInt(99)) => Option.None

fn classifyFastMatch(scrutinee: Expr, arms: List<MatchArm>) -> FnFastPath
    ? "Recognize a small fixed-shape branch over bools or slot-based comparisons."
    match classifyBoolArms(arms)
        Option.Some(pair) -> match pair
            (thenLeaf, elseLeaf) -> classifyFastMatchScrutinee(scrutinee, thenLeaf, elseLeaf)
        Option.None -> classifyFastListMatch(scrutinee, arms)

verify classifyFastMatch
    classifyFastMatch(Expr.ExprInt(1), []) => FnFastPath.FastSingleExpr

fn classifyFastListMatch(scrutinee: Expr, arms: List<MatchArm>) -> FnFastPath
    ? "Recognize a two-arm list match with [] and [h, ..t] leaf bodies."
    match scrutinee
        Expr.ExprSlot(slot) -> classifyFastListArms(slot, arms)
        _ -> FnFastPath.FastSingleExpr

verify classifyFastListMatch
    classifyFastListMatch(Expr.ExprInt(1), []) => FnFastPath.FastSingleExpr

fn classifyFastListArms(slot: Int, arms: List<MatchArm>) -> FnFastPath
    ? "Extract fixed empty/cons list arms regardless of order."
    match arms
        [arm1, ..rest] -> match rest
            [arm2, ..tail] -> match tail == []
                true -> classifyFastListArmPair(slot, arm1, arm2)
                false -> FnFastPath.FastSingleExpr
            _ -> FnFastPath.FastSingleExpr
        _ -> FnFastPath.FastSingleExpr

verify classifyFastListArms
    classifyFastListArms(0, []) => FnFastPath.FastSingleExpr

fn classifyFastListArmPair(slot: Int, arm1: MatchArm, arm2: MatchArm) -> FnFastPath
    ? "Convert two list-pattern arms into a direct slot branch."
    leaf1 = classifyFastLeafExpr(arm1.body)
    leaf2 = classifyFastLeafExpr(arm2.body)
    match leaf1
        Option.Some(v1) -> match leaf2
            Option.Some(v2) -> classifyFastListPatterns(slot, arm1.pattern, arm1.bindingSlots, v1, arm2.pattern, arm2.bindingSlots, v2)
            Option.None -> FnFastPath.FastSingleExpr
        Option.None -> FnFastPath.FastSingleExpr

verify classifyFastListArmPair
    classifyFastListArmPair(0, MatchArm(pattern = Pattern.PatWild, body = Expr.ExprCall("f", []), bindingSlots = Map.empty()), MatchArm(pattern = Pattern.PatWild, body = Expr.ExprInt(1), bindingSlots = Map.empty())) => FnFastPath.FastSingleExpr

fn classifyFastListPatterns(slot: Int, p1: Pattern, bindingSlots1: Map<String, Int>, leaf1: FastLeaf, p2: Pattern, bindingSlots2: Map<String, Int>, leaf2: FastLeaf) -> FnFastPath
    ? "Order empty/cons arms into a direct list branch."
    match p1
        Pattern.PatEmpty -> classifyFastListOther(slot, leaf1, p2, bindingSlots2, leaf2)
        Pattern.PatCons(head, tail) -> classifyFastListConsFirst(slot, head, tail, bindingSlots1, leaf1, p2, leaf2)
        _ -> FnFastPath.FastSingleExpr

verify classifyFastListPatterns
    classifyFastListPatterns(0, Pattern.PatWild, Map.empty(), FastLeaf.LeafConstInt(1), Pattern.PatWild, Map.empty(), FastLeaf.LeafConstInt(2)) => FnFastPath.FastSingleExpr

fn classifyFastListOther(slot: Int, emptyLeaf: FastLeaf, other: Pattern, bindingSlots: Map<String, Int>, otherLeaf: FastLeaf) -> FnFastPath
    ? "Finish list fast-path classification when the empty arm is known."
    match other
        Pattern.PatCons(head, tail) -> classifyFastListCons(slot, emptyLeaf, head, tail, bindingSlots, otherLeaf)
        _ -> FnFastPath.FastSingleExpr

verify classifyFastListOther
    classifyFastListOther(0, FastLeaf.LeafConstInt(0), Pattern.PatWild, Map.empty(), FastLeaf.LeafConstInt(1)) => FnFastPath.FastSingleExpr

fn classifyFastListConsFirst(slot: Int, head: String, tail: String, bindingSlots: Map<String, Int>, consLeaf: FastLeaf, other: Pattern, otherLeaf: FastLeaf) -> FnFastPath
    ? "Handle reversed list arms where the cons case appears first."
    match other
        Pattern.PatEmpty -> classifyFastListCons(slot, otherLeaf, head, tail, bindingSlots, consLeaf)
        _ -> FnFastPath.FastSingleExpr

verify classifyFastListConsFirst
    classifyFastListConsFirst(0, "h", "t", Map.empty(), FastLeaf.LeafConstInt(1), Pattern.PatWild, FastLeaf.LeafConstInt(0)) => FnFastPath.FastSingleExpr

fn classifyFastListCons(slot: Int, emptyLeaf: FastLeaf, head: String, tail: String, bindingSlots: Map<String, Int>, consLeaf: FastLeaf) -> FnFastPath
    ? "Build the list-slot branch once head/tail binding slots are known."
    match Map.get(bindingSlots, head)
        Option.Some(headSlot) -> match Map.get(bindingSlots, tail)
            Option.Some(tailSlot) -> FnFastPath.FastListSlotBranch(slot, emptyLeaf, headSlot, tailSlot, consLeaf)
            Option.None -> FnFastPath.FastSingleExpr
        Option.None -> FnFastPath.FastSingleExpr

verify classifyFastListCons
    classifyFastListCons(0, FastLeaf.LeafConstInt(0), "h", "t", Map.empty(), FastLeaf.LeafConstInt(1)) => FnFastPath.FastSingleExpr

fn classifyFastForwardCall(fnId: Int, args: List<Expr>) -> FnFastPath
    ? "Recognize tiny direct-call wrappers that only forward slot arguments."
    match classifyFastForwardSlots(args, [])
        Option.Some(slotArgs) -> FnFastPath.FastForwardCall(fnId, slotArgs)
        Option.None -> FnFastPath.FastSingleExpr

verify classifyFastForwardCall
    classifyFastForwardCall(5, [Expr.ExprSlot(0), Expr.ExprSlot(1)]) => FnFastPath.FastForwardCall(5, [0, 1])
    classifyFastForwardCall(5, [Expr.ExprInt(1)]) => FnFastPath.FastSingleExpr

fn classifyFastForwardSlots(args: List<Expr>, acc: List<Int>) -> Option<List<Int>>
    ? "Extract slot numbers from a direct call argument list."
    match args
        [] -> Option.Some(List.reverse(acc))
        [arg, ..rest] -> match arg
            Expr.ExprSlot(slot) -> classifyFastForwardSlots(rest, List.prepend(slot, acc))
            _ -> Option.None

verify classifyFastForwardSlots
    classifyFastForwardSlots([], []) => Option.Some([])
    classifyFastForwardSlots([Expr.ExprSlot(0)], []) => Option.Some([0])
    classifyFastForwardSlots([Expr.ExprInt(1)], []) => Option.None

fn classifyBoolArms(arms: List<MatchArm>) -> Option<(FastLeaf, FastLeaf)>
    ? "Extract (then, else) leaves from a two-arm bool match, regardless of arm order."
    match arms
        [arm1, ..rest] -> match rest
            [arm2, ..tail] -> match tail == []
                true -> classifyBoolArmPair(arm1, arm2)
                false -> Option.None
            _ -> Option.None
        _ -> Option.None

verify classifyBoolArms
    classifyBoolArms([]) => Option.None

fn classifyBoolArmPair(arm1: MatchArm, arm2: MatchArm) -> Option<(FastLeaf, FastLeaf)>
    ? "Convert two bool-pattern arms into ordered leaves."
    leaf1 = classifyFastLeafExpr(arm1.body)
    leaf2 = classifyFastLeafExpr(arm2.body)
    match leaf1
        Option.Some(v1) -> match leaf2
            Option.Some(v2) -> classifyBoolArmPatterns(arm1.pattern, v1, arm2.pattern, v2)
            Option.None -> Option.None
        Option.None -> Option.None

verify classifyBoolArmPair
    classifyBoolArmPair(MatchArm(pattern = Pattern.PatBool(true), body = Expr.ExprInt(1), bindingSlots = Map.empty()), MatchArm(pattern = Pattern.PatBool(false), body = Expr.ExprInt(0), bindingSlots = Map.empty())) => Option.Some((FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)))

fn classifyBoolArmPatterns(p1: Pattern, leaf1: FastLeaf, p2: Pattern, leaf2: FastLeaf) -> Option<(FastLeaf, FastLeaf)>
    ? "Order bool match arms into (trueLeaf, falseLeaf)."
    match p1
        Pattern.PatBool(b1) -> classifyBoolArmPatternsInner(b1, leaf1, p2, leaf2)
        _ -> Option.None

verify classifyBoolArmPatterns
    classifyBoolArmPatterns(Pattern.PatBool(true), FastLeaf.LeafConstInt(1), Pattern.PatBool(false), FastLeaf.LeafConstInt(0)) => Option.Some((FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)))
    classifyBoolArmPatterns(Pattern.PatWild, FastLeaf.LeafConstInt(1), Pattern.PatBool(false), FastLeaf.LeafConstInt(0)) => Option.None

fn classifyBoolArmPatternsInner(b1: Bool, leaf1: FastLeaf, p2: Pattern, leaf2: FastLeaf) -> Option<(FastLeaf, FastLeaf)>
    ? "Finish ordering bool match arms once the first arm bool is extracted."
    match p2
        Pattern.PatBool(b2) -> classifyBoolArmPatternsPair(b1, leaf1, b2, leaf2)
        _ -> Option.None

verify classifyBoolArmPatternsInner
    classifyBoolArmPatternsInner(true, FastLeaf.LeafConstInt(1), Pattern.PatBool(false), FastLeaf.LeafConstInt(0)) => Option.Some((FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)))
    classifyBoolArmPatternsInner(true, FastLeaf.LeafConstInt(1), Pattern.PatWild, FastLeaf.LeafConstInt(0)) => Option.None

fn classifyBoolArmPatternsPair(b1: Bool, leaf1: FastLeaf, b2: Bool, leaf2: FastLeaf) -> Option<(FastLeaf, FastLeaf)>
    ? "Return (trueLeaf, falseLeaf) when the two bool arms are complementary."
    match b1 == true
        true -> match b2 == false
            true -> Option.Some((leaf1, leaf2))
            false -> Option.None
        false -> match b1 == false
            true -> match b2 == true
                true -> Option.Some((leaf2, leaf1))
                false -> Option.None
            false -> Option.None

verify classifyBoolArmPatternsPair
    classifyBoolArmPatternsPair(true, FastLeaf.LeafConstInt(1), false, FastLeaf.LeafConstInt(0)) => Option.Some((FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)))
    classifyBoolArmPatternsPair(false, FastLeaf.LeafConstInt(0), true, FastLeaf.LeafConstInt(1)) => Option.Some((FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)))

fn classifyFastMatchScrutinee(scrutinee: Expr, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> FnFastPath
    ? "Encode a recognized branch scrutinee with preclassified leaves."
    match scrutinee
        Expr.ExprSlot(slot) -> FnFastPath.FastBoolSlotBranch(slot, thenLeaf, elseLeaf)
        Expr.ExprEq(a, b) -> classifyFastEqScrutinee(a, b, thenLeaf, elseLeaf)
        Expr.ExprLt(a, b) -> classifyFastLtScrutinee(a, b, thenLeaf, elseLeaf)
        Expr.ExprGt(a, b) -> classifyFastLtScrutinee(b, a, thenLeaf, elseLeaf)
        _ -> FnFastPath.FastSingleExpr

verify classifyFastMatchScrutinee
    classifyFastMatchScrutinee(Expr.ExprSlot(0), FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => FnFastPath.FastBoolSlotBranch(0, FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0))
    classifyFastMatchScrutinee(Expr.ExprInt(1), FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => FnFastPath.FastSingleExpr

fn classifyFastEqScrutinee(a: Expr, b: Expr, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> FnFastPath
    ? "Recognize slot == int/string in either operand order."
    match a
        Expr.ExprSlot(slot) -> classifyFastEqOther(slot, b, thenLeaf, elseLeaf)
        _ -> match b
            Expr.ExprSlot(slot) -> classifyFastEqOther(slot, a, thenLeaf, elseLeaf)
            _ -> FnFastPath.FastSingleExpr

verify classifyFastEqScrutinee
    classifyFastEqScrutinee(Expr.ExprInt(1), Expr.ExprInt(2), FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => FnFastPath.FastSingleExpr

fn classifyFastEqOther(slot: Int, other: Expr, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> FnFastPath
    ? "Encode equality against a constant once the slot side is known."
    match other
        Expr.ExprInt(n) -> FnFastPath.FastEqIntBranch(slot, n, thenLeaf, elseLeaf)
        Expr.ExprStr(s) -> FnFastPath.FastEqStringBranch(slot, s, thenLeaf, elseLeaf)
        _ -> FnFastPath.FastSingleExpr

verify classifyFastEqOther
    classifyFastEqOther(0, Expr.ExprInt(42), FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => FnFastPath.FastEqIntBranch(0, 42, FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0))
    classifyFastEqOther(0, Expr.ExprStr("hi"), FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => FnFastPath.FastEqStringBranch(0, "hi", FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0))

fn classifyFastLtScrutinee(a: Expr, b: Expr, thenLeaf: FastLeaf, elseLeaf: FastLeaf) -> FnFastPath
    ? "Recognize slot < slot branches like minInt."
    match a
        Expr.ExprSlot(lhs) -> match b
            Expr.ExprSlot(rhs) -> FnFastPath.FastLtIntSlotsBranch(lhs, rhs, thenLeaf, elseLeaf)
            _ -> FnFastPath.FastSingleExpr
        _ -> FnFastPath.FastSingleExpr

verify classifyFastLtScrutinee
    classifyFastLtScrutinee(Expr.ExprSlot(0), Expr.ExprSlot(1), FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => FnFastPath.FastLtIntSlotsBranch(0, 1, FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0))
    classifyFastLtScrutinee(Expr.ExprInt(0), Expr.ExprSlot(1), FastLeaf.LeafConstInt(1), FastLeaf.LeafConstInt(0)) => FnFastPath.FastSingleExpr
