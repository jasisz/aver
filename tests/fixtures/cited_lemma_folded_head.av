module CitedHead
    intent =
        "buildOk needs the conditional lemma pushOk at the induction hypothesis."
        "ok is a non-recursive wrapper, so unfolding it hides pushOk's pattern."

fn allPos(xs: List<Int>) -> Bool
    ? "Every element is positive."
    match xs
        [] -> true
        [h, ..t] -> match h > 0
            true -> allPos(t)
            false -> false

verify allPos
    allPos([1, 2]) => true
    allPos([1, 0]) => false

fn ok(xs: List<Int>) -> Bool
    ? "The list is fit to use: its head is positive and so is the rest."
    match xs
        [] -> true
        [h, ..t] -> Bool.and(h > 0, allPos(t))

verify ok
    ok([3]) => true

fn push(x: Int, xs: List<Int>) -> List<Int>
    ? "Keeps x only when it is positive."
    match x > 0
        true -> List.prepend(x, xs)
        false -> xs

verify push
    push(0, [1]) => [1]

fn build(xs: List<Int>) -> List<Int>
    ? "Pushes every element of xs, last first."
    match xs
        [] -> []
        [h, ..t] -> push(h, build(t))

verify build
    build([3, -1, 2]) => [3, 2]

verify push law pushOk
    given x: Int = [-1, 0, 1, 2]
    given xs: List<Int> = [[], [1], [2, 3], [1, 0]]
    when ok(xs)
    ok(push(x, xs)) holds

verify build law buildOk
    given xs: List<Int> = [[], [1], [3, -1, 2], [0, 0], [-5, 4]]
    ok(build(xs)) holds
