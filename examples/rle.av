module Rle
    intent =
        "Run-length encoding: the simplest lossless compression algorithm."
        "Consecutive identical elements become (element, count) pairs."
        "Demonstrates fold with record accumulator and law roundtrip."

record Run
    char: String
    count: Int

record RleAcc
    runs: List<Run>
    current: String
    count: Int

fn encodeFold(acc: RleAcc, char: String) -> RleAcc
    ? "Fold step: extends current run or starts a new one."
    match acc.count == 0
        true -> RleAcc(runs = acc.runs, current = char, count = 1)
        false -> match acc.current == char
            true -> RleAcc(runs = acc.runs, current = acc.current, count = acc.count + 1)
            false -> RleAcc(runs = List.push(acc.runs, Run(char = acc.current, count = acc.count)), current = char, count = 1)

fn flushAcc(acc: RleAcc) -> List<Run>
    ? "Flushes the final run from the accumulator."
    match acc.count == 0
        true -> acc.runs
        false -> List.push(acc.runs, Run(char = acc.current, count = acc.count))

fn encode(xs: List<String>) -> List<Run>
    ? "Compresses a list of single characters into run-length pairs."
    = flushAcc(List.fold(xs, RleAcc(runs = [], current = "", count = 0), encodeFold))

verify encode
    encode([]) => []
    encode(["a"]) => [Run(char = "a", count = 1)]
    encode(["a", "a", "a"]) => [Run(char = "a", count = 3)]
    encode(["a", "a", "b", "c", "c"]) => [Run(char = "a", count = 2), Run(char = "b", count = 1), Run(char = "c", count = 2)]

fn repeat(char: String, n: Int) -> List<String>
    ? "Produces a list of n copies of char."
    match n
        0 -> []
        _ -> List.push(repeat(char, n - 1), char)

verify repeat
    repeat("x", 0) => []
    repeat("x", 1) => ["x"]
    repeat("x", 3) => ["x", "x", "x"]

fn expandRun(run: Run) -> List<String>
    ? "Expands a single run back into repeated characters."
    = repeat(run.char, run.count)

fn decode(runs: List<Run>) -> List<String>
    ? "Decompresses run-length pairs back into a character list."
    = List.flatMap(runs, expandRun)

verify decode
    decode([]) => []
    decode([Run(char = "a", count = 3)]) => ["a", "a", "a"]
    decode([Run(char = "a", count = 2), Run(char = "b", count = 1)]) => ["a", "a", "b"]

verify encode law roundtrip
    given xs: List<String> = [[], ["a"], ["a", "a", "b"], ["a", "b", "b", "a"]]
    decode(encode(xs)) => xs

fn encodeString(s: String) -> List<Run>
    ? "Compresses a string into run-length pairs."
    = encode(String.chars(s))

fn decodeString(runs: List<Run>) -> String
    ? "Decompresses run-length pairs back into a string."
    = String.join(decode(runs), "")

fn showRun(run: Run) -> String
    ? "Formats a single run as char followed by count."
    = "{run.char}{run.count}"

fn showRuns(runs: List<Run>) -> String
    ? "Formats encoded runs as a compact string like a3b2c1."
    = String.join(List.map(runs, showRun), "")

verify showRuns
    showRuns(encodeString("aaabbc")) => "a3b2c1"
    showRuns(encodeString("x")) => "x1"

verify encodeString law string_roundtrip
    given s: String = ["", "a", "aab", "aaabbbcc", "abcd"]
    decodeString(encodeString(s)) => s

fn main()
    ! [Console]
    text = "aaabbbccdddddd"
    runs = encodeString(text)
    Console.print("Input:    {text}")
    Console.print("Encoded:  {showRuns(runs)}")
    Console.print("Decoded:  {decodeString(runs)}")
    Console.print("Runs:     {List.len(runs)}")
    Console.print("{String.len(text)} chars → {List.len(runs)} runs")
