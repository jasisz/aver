module Validation
    kind = capability
    semantics = effectful
    depends [Work]
    intent = "A job kind that collects a result by name instead of by handle."
    exposes [begin, take]

operation begin(task: String) -> Result<Work.Job, String>
    ? "Starts one validation off the turn and returns its job handle at once."
    oracle = generativeOutput
    replay = recorded

operation take(name: String) -> Result<Option<Int>, String>
    ? "Collects one finished validation: None while it runs, Some(score) once it finished."
    oracle = generativeOutput
    replay = recorded
