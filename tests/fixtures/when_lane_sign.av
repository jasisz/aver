module ScanLane
    intent =
        "Synthetic decimal token scanner for the proof_spec when-universal lane generality pin."
        "Mirrors the canonical decimal parser shape under fresh names so the quarantine lane"
        "must recognize the family structurally, not by the json corpus's identifiers."
    exposes [Tok, ScanOut, readTok, renderTok]

type Tok
    TInt(Int)
    TNone

type ScanOut
    Ok(Tok, Int)
    Err(String, Int)

fn renderTok(t: Tok) -> String
    ? "Serialize a token; TInt renders as its canonical decimal form."
    match t
        Tok.TInt(x) -> String.fromInt(x)
        Tok.TNone -> ""

verify renderTok
    renderTok(Tok.TInt(42)) => "42"
    renderTok(Tok.TInt(-7)) => "-7"
    renderTok(Tok.TNone) => ""

fn digitChar(c: String) -> Bool
    ? "True when c is a single decimal digit."
    code = Char.toCode(c)
    match code >= 48
        true -> code <= 57
        false -> false

verify digitChar
    digitChar("0") => true
    digitChar("9") => true
    digitChar("x") => false

fn readTok(s: String, start: Int) -> ScanOut
    ? "Scan a decimal integer token starting at start."
    match String.charAt(s, start)
        Option.None -> ScanOut.Err("Unexpected end of input", start)
        Option.Some(c) -> match c
            "-" -> readSign(s, start + 1, start)
            "0" -> scanDigits(s, start + 1, start, true)
            _ -> startDigits(s, start, c)

verify readTok
    readTok("", 0) => ScanOut.Err("Unexpected end of input", 0)
    readTok("-1", 0) => ScanOut.Ok(Tok.TInt(-1), 2)
    readTok("0", 0) => ScanOut.Ok(Tok.TInt(0), 1)
    readTok("9", 0) => ScanOut.Ok(Tok.TInt(9), 1)

verify readTok law tokenRoundtrip
    given v: Int = [-7, 0, 42, 2500]
    readTok(renderTok(Tok.TInt(v)), 0) => ScanOut.Ok(Tok.TInt(v), String.len(renderTok(Tok.TInt(v))))

fn startDigits(s: String, start: Int, c: String) -> ScanOut
    ? "Dispatch the first digit of an unsigned token."
    match digitChar(c)
        true -> scanDigits(s, start + 1, start, false)
        false -> ScanOut.Err("Unexpected character: " + c, start)

verify startDigits
    startDigits("7", 0, "7") => ScanOut.Ok(Tok.TInt(7), 1)
    startDigits("x", 0, "x") => ScanOut.Err("Unexpected character: x", 0)

verify startDigits law positiveTokenRoundtrip
    given v: Int = [1, 7, 42, 2500]
    when v > 0
    startDigits(renderTok(Tok.TInt(v)), 0, String.slice(renderTok(Tok.TInt(v)), 0, 1)) => ScanOut.Ok(Tok.TInt(v), String.len(renderTok(Tok.TInt(v))))

fn readSign(s: String, pos: Int, start: Int) -> ScanOut
    ? "Scan the digits after a leading minus sign."
    match String.charAt(s, pos)
        Option.None -> ScanOut.Err("Expected digit after '-'", pos)
        Option.Some(c) -> match c
            "0" -> scanDigits(s, pos + 1, start, true)
            _ -> signDigit(s, pos, start, c)

verify readSign
    readSign("-", 1, 0) => ScanOut.Err("Expected digit after '-'", 1)
    readSign("-0", 1, 0) => ScanOut.Ok(Tok.TInt(0), 2)
    readSign("-8", 1, 0) => ScanOut.Ok(Tok.TInt(-8), 2)

fn signDigit(s: String, pos: Int, start: Int, c: String) -> ScanOut
    ? "Dispatch the first digit after a minus sign."
    match digitChar(c)
        true -> scanDigits(s, pos + 1, start, false)
        false -> ScanOut.Err("Expected digit after '-'", pos)

verify signDigit
    signDigit("-8", 1, 0, "8") => ScanOut.Ok(Tok.TInt(-8), 2)
    signDigit("-x", 1, 0, "x") => ScanOut.Err("Expected digit after '-'", 1)

fn scanDigits(s: String, pos: Int, start: Int, leadingZero: Bool) -> ScanOut
    ? "Scan the remaining digits of a decimal token."
    match String.charAt(s, pos)
        Option.None -> finishTok(s, start, pos, false)
        Option.Some(c) -> match digitChar(c)
            true -> match leadingZero
                true -> ScanOut.Err("Leading zeros not allowed", pos)
                false -> scanDigits(s, pos + 1, start, false)
            false -> trailingChar(s, pos, start, c)

verify scanDigits
    scanDigits("1", 1, 0, false) => ScanOut.Ok(Tok.TInt(1), 1)
    scanDigits("01", 1, 0, true) => ScanOut.Err("Leading zeros not allowed", 1)
    scanDigits("12", 1, 0, false) => ScanOut.Ok(Tok.TInt(12), 2)

fn trailingChar(s: String, pos: Int, start: Int, c: String) -> ScanOut
    ? "A non-digit ends the token; the token is what was scanned so far."
    finishTok(s, start, pos, false)

verify trailingChar
    trailingChar("1]", 1, 0, "]") => ScanOut.Ok(Tok.TInt(1), 1)

fn finishTok(s: String, start: Int, endPos: Int, asFloat: Bool) -> ScanOut
    ? "Finish the scanned token from its slice."
    num = String.slice(s, start, endPos)
    match asFloat
        true -> ScanOut.Err("Floats unsupported", endPos)
        false -> finishTokInt(num, endPos)

verify finishTok
    finishTok("12", 0, 2, false) => ScanOut.Ok(Tok.TInt(12), 2)

fn finishTokInt(num: String, pos: Int) -> ScanOut
    ? "Parse the scanned slice as an integer token."
    match Int.fromString(num)
        Result.Ok(n) -> ScanOut.Ok(Tok.TInt(n), pos)
        Result.Err(_) -> ScanOut.Err("Invalid number: " + num, pos)

verify finishTokInt
    finishTokInt("12", 2) => ScanOut.Ok(Tok.TInt(12), 2)
    finishTokInt("x", 1) => ScanOut.Err("Invalid number: x", 1)
