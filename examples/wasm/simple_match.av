module SimpleMatch
    intent = "Test safeDivide with Result + match"
    effects []

fn safeDivide(a: Int, b: Int) -> Result<Int, String>
    ? "Safe integer division."
    match b
        0 -> Result.Err("Division by zero")
        _ -> Result.Ok(a / b)

verify safeDivide
    safeDivide(10, 2) => Result.Ok(5)
    safeDivide(7, 0) => Result.Err("Division by zero")

fn unwrapOr(r: Result<Int, String>, default: Int) -> Int
    ? "Unwrap Result.Ok or return default."
    match r
        Result.Ok(v) -> v
        Result.Err(_) -> default

verify unwrapOr
    unwrapOr(Result.Ok(7), 0) => 7
    unwrapOr(Result.Err("nope"), 0 - 1) => 0 - 1

fn main() -> Int
    r1 = safeDivide(10, 2)
    v1 = unwrapOr(r1, 0)
    r2 = safeDivide(7, 0)
    v2 = unwrapOr(r2, -1)
    v1 + v2
