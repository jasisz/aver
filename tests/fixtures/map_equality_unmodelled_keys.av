module MapEqualityUnmodelledKeys
    intent =
        "Deciding whether two float-keyed maps are the same map."
        "The proof model orders a map's entries by key and has no ordering for Float keys, so it keeps two maps holding the same entries apart where the runtime considers them equal — every shape below is refuted by aver verify."

fn writtenOrderMatters(k: Float) -> Bool
    ? "Whether two maps holding the same pairs differ by the order they were written in."
    a = {2.0 => 5, k => 3}
    b = {k => 3, 2.0 => 5}
    a != b

verify writtenOrderMatters
    writtenOrderMatters(1.0) => true
    writtenOrderMatters(3.0) => true

fn seenBefore(k: Float) -> Bool
    ? "Whether the reordered map is already among the maps seen, decided by membership."
    a = {2.0 => 5, k => 3}
    b = {k => 3, 2.0 => 5}
    List.contains([a], b)

verify seenBefore
    seenBefore(1.0) => false
    seenBefore(3.0) => false

fn rewrite(m: Map<Float, Int>) -> Map<Float, Int>
    ? "Writes the same two keys back in descending order."
    Map.set(Map.set({}, 2.0, 5), 1.0, 3)

verify rewrite law rewriteChangesIdentity
    given m: Map<Float, Int> = [{1.0 => 3, 2.0 => 5}]
    rewrite(m) == m => false
