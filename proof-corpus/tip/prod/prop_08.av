module Prop08
    intent =
        "TIP prod prop_08: drop x (drop y z) = drop y (drop x z)."
    effects []

type Nat
    Z
    S(Nat)

fn drop(x: Nat, y: List<Int>) -> List<Int>
    match x
        Nat.Z -> y
        Nat.S(z) -> match y
            [] -> []
            [x2, ..x3] -> drop(z, x3)

verify drop law dropDropComm
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given y: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given z: List<Int> = [[], [1], [1, 2, 3]]
    drop(x, drop(y, z)) => drop(y, drop(x, z))
