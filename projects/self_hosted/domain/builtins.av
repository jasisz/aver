module Builtins
    depends [Domain.Ast, Domain.Value, Domain.Builtins.Helpers, Domain.Builtins.List, Domain.Builtins.Primitives, Domain.Builtins.Wrappers]
    intent =
        "Builtin function implementations for the self-hosted evaluator."
        "Dispatches qualified names like List.len, String.charAt, Console.print to sub-modules."
    exposes [callBuiltin, splitDotted, tryVariantConstructor]

fn callBuiltin(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch qualified builtin calls to sub-module implementations."
    ! [Args.get, Console.print, Disk.readText]
    match String.startsWith(name, "List.")
        true -> Domain.Builtins.List.call(name, args)
        false -> match String.startsWith(name, "Int.")
            true -> Domain.Builtins.Primitives.callInt(name, args)
            false -> match String.startsWith(name, "String.")
                true -> Domain.Builtins.Primitives.callString(name, args)
                false -> match String.startsWith(name, "Float.")
                    true -> Domain.Builtins.Primitives.callFloat(name, args)
                    false -> callBuiltinOther(name, args)

verify callBuiltin
    callBuiltin("List.len", [Val.ValList([Val.ValInt(1), Val.ValInt(2)])]) => Result.Ok(Val.ValInt(2))
    callBuiltin("Result.Ok", [Val.ValInt(5)]) => Result.Ok(Val.ValOk(Val.ValInt(5)))

fn callBuiltinOther(name: String, args: List<Val>) -> Result<Val, String>
    ? "Handle non-prefixed builtins: Result.*, Option.*, IO, Char, variant constructors."
    ! [Args.get, Console.print, Disk.readText]
    match name
        "Char.fromCode" -> Domain.Builtins.Primitives.callChar(name, args)
        "Console.print" -> builtinConsolePrint(args)
        "Disk.readText" -> builtinDiskReadText(args)
        "Args.get" -> builtinArgsGet(args)
        "Result.Ok" -> Domain.Builtins.Wrappers.call(name, args)
        "Result.Err" -> Domain.Builtins.Wrappers.call(name, args)
        "Result.withDefault" -> Domain.Builtins.Wrappers.call(name, args)
        "Option.Some" -> Domain.Builtins.Wrappers.call(name, args)
        "Option.None" -> Result.Ok(Val.ValNone)
        "Option.withDefault" -> Domain.Builtins.Wrappers.call(name, args)
        _ -> tryVariantConstructor(name, args)

verify callBuiltinOther
    callBuiltinOther("Result.Ok", [Val.ValInt(1)]) => Result.Ok(Val.ValOk(Val.ValInt(1)))
    callBuiltinOther("Option.None", []) => Result.Ok(Val.ValNone)

fn builtinConsolePrint(args: List<Val>) -> Result<Val, String>
    ? "Console.print(v) -> print any value and return Unit."
    ! [Console.print]
    v = Domain.Builtins.Helpers.oneArg(args)?
    Console.print(Domain.Value.valRepr(v))
    Result.Ok(Val.ValUnit)

fn builtinDiskReadText(args: List<Val>) -> Result<Val, String>
    ? "Disk.readText(path) -> Result string."
    ! [Disk.readText]
    v = Domain.Builtins.Helpers.oneArg(args)?
    path = Domain.Builtins.Helpers.expectStr(v)?
    match Disk.readText(path)
        Result.Ok(content) -> Result.Ok(Val.ValOk(Val.ValStr(content)))
        Result.Err(e) -> Result.Ok(Val.ValErr(Val.ValStr(e)))

fn builtinArgsGet(args: List<Val>) -> Result<Val, String>
    ? "Args.get() -> list of string args."
    ! [Args.get]
    rawArgs = Args.get()
    Result.Ok(Val.ValList(stringsToVals(rawArgs, [])))

fn stringsToVals(strs: List<String>, acc: List<Val>) -> List<Val>
    ? "Convert list of strings to list of ValStr."
    match strs
        [] -> List.reverse(acc)
        [s, ..rest] -> stringsToVals(rest, List.prepend(Val.ValStr(s), acc))

verify stringsToVals
    stringsToVals(["a", "b"], []) => [Val.ValStr("a"), Val.ValStr("b")]
    stringsToVals([], []) => []

fn tryVariantConstructor(name: String, args: List<Val>) -> Result<Val, String>
    ? "Try to construct a variant value from a dotted name like Type.Ctor."
    match splitDotted(name)
        Option.Some(pair) -> match pair
            (typeName, ctorName) -> Result.Ok(Val.ValVariant(typeName, ctorName, args))
        Option.None -> Result.Err("undefined function: {name}")

verify tryVariantConstructor
    tryVariantConstructor("Shape.Circle", [Val.ValInt(5)]) => Result.Ok(Val.ValVariant("Shape", "Circle", [Val.ValInt(5)]))
    tryVariantConstructor("noDot", []) => Result.Err("undefined function: noDot")

fn splitDotted(name: String) -> Option<(String, String)>
    ? "Split 'Type.Ctor' into (Type, Ctor). Returns None if no dot."
    splitDottedLoop(name, 0, String.len(name))

verify splitDotted
    splitDotted("List.len") => Option.Some(("List", "len"))
    splitDotted("hello") => Option.None

fn splitDottedLoop(name: String, pos: Int, total: Int) -> Option<(String, String)>
    ? "Find first dot and split."
    match pos >= total
        true -> Option.None
        false -> match String.charAt(name, pos)
            Option.Some(c) -> match c == "."
                true -> Option.Some((String.slice(name, 0, pos), String.slice(name, pos + 1, total)))
                false -> splitDottedLoop(name, pos + 1, total)
            Option.None -> Option.None

verify splitDottedLoop
    splitDottedLoop("A.B", 0, 3) => Option.Some(("A", "B"))
    splitDottedLoop("abc", 0, 3) => Option.None
