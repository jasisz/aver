module Ast
    intent =
        "AST node types for the mini Aver interpreter."
        "Covers: literals, binops, comparisons, variables, bindings, function defs/calls, match."
    exposes [Expr, MatchArm, Pattern, Stmt, FnDef, Program, BinOp, CmpOp, FnFastPath, FastLeaf, tagResultOk, tagResultErr, tagOptionSome, tagOptionNone, tagUserBase, ctorNameToTag, canonicalCtorName, builtinNameToId]
    effects []

type Expr
    ExprInt(Int)
    ExprFloat(Float)
    ExprStr(String)
    ExprBool(Bool)
    ExprBoolBranch(Expr, Expr, Expr)
    ExprVar(String)
    ExprSlot(Int)
    ExprBinopSlotInt(BinOp, Int, Int)
    ExprBinopSlots(BinOp, Int, Int)
    ExprCmpSlotInt(CmpOp, Int, Int)
    ExprCmpSlots(CmpOp, Int, Int)
    ExprVectorGetOrInt(Expr, Expr, Int)
    ExprIntModOrInt(Expr, Expr, Int)
    ExprAdd(Expr, Expr)
    ExprSub(Expr, Expr)
    ExprMul(Expr, Expr)
    ExprDiv(Expr, Expr)
    ExprNeg(Expr)
    ExprEq(Expr, Expr)
    ExprNeq(Expr, Expr)
    ExprLt(Expr, Expr)
    ExprGt(Expr, Expr)
    ExprLte(Expr, Expr)
    ExprGte(Expr, Expr)
    ExprConcat(List<Expr>)
    ExprTuple(List<Expr>)
    ExprList(List<Expr>)
    ExprRecord(String, List<Tuple<String, Expr>>)
    ExprFieldAccess(Expr, String)
    ExprCall(String, List<Expr>)
    ExprCallDirect(Int, List<Expr>)
    ExprCallBuiltin(String, List<Expr>)
    ExprCallBuiltinId(Int, List<Expr>)
    ExprMatch(Expr, List<MatchArm>)
    ExprPropagate(Expr)
    ExprIndependentProduct(List<Expr>, Bool)

record MatchArm
    pattern: Pattern
    body: Expr
    bindingSlots: Map<String, Int>

type Pattern
    PatInt(Int)
    PatFloat(Float)
    PatBool(Bool)
    PatStr(String)
    PatEmpty
    PatCons(String, String)
    PatConstructor(String, List<String>)
    PatConstructorId(Int, String, List<String>)
    PatTuple(List<Pattern>)
    PatWild
    PatVar(String)

type Stmt
    StmtBind(String, Expr)
    StmtBindSlot(Int, Expr)
    StmtExpr(Expr)

type FastLeaf
    LeafConstInt(Int)
    LeafConstFloat(Float)
    LeafConstStr(String)
    LeafConstBool(Bool)
    LeafSlot(Int)
    LeafFieldAccess(Int, String)
    LeafMapGet(Int, Int)
    LeafMapSet(Int, Int, Int)
    LeafMapHas(Int, Int)
    LeafMapRemove(Int, Int)
    LeafVectorNew(Int, Int)
    LeafVectorLen(Int)
    LeafVectorGetOrInt(Int, Int, Int)
    LeafBinopSlots(BinOp, Int, Int)
    LeafCmpSlots(CmpOp, Int, Int)

type FnFastPath
    FastNone
    FastSingleExpr
    FastLeaf(FastLeaf)
    FastForwardCall(Int, List<Int>)
    FastBoolSlotBranch(Int, FastLeaf, FastLeaf)
    FastEqIntBranch(Int, Int, FastLeaf, FastLeaf)
    FastEqStringBranch(Int, String, FastLeaf, FastLeaf)
    FastLtIntSlotsBranch(Int, Int, FastLeaf, FastLeaf)
    FastListSlotBranch(Int, FastLeaf, Int, Int, FastLeaf)

record FnDef
    name: String
    params: List<String>
    body: List<Stmt>
    slotCount: Int
    slotMap: Map<String, Int>
    fastPath: FnFastPath
    tailLoop: Bool

record Program
    deps: List<String>
    fns: List<FnDef>
    stmts: List<Stmt>

type BinOp
    OpAdd
    OpSub
    OpMul
    OpDiv

type CmpOp
    CmpEq
    CmpNeq
    CmpLt
    CmpGt
    CmpLte
    CmpGte

fn tagResultOk() -> Int
    ? "Tag ID for Result.Ok constructor."
    1

verify tagResultOk
    tagResultOk() => 1

fn tagResultErr() -> Int
    ? "Tag ID for Result.Err constructor."
    2

fn tagOptionSome() -> Int
    ? "Tag ID for Option.Some constructor."
    3

fn tagOptionNone() -> Int
    ? "Tag ID for Option.None constructor."
    4

fn tagUserBase() -> Int
    ? "Base tag ID for user-defined constructors. User tags start from this value."
    100

fn userTagSpan() -> Int
    ? "Modulo span used to keep hashed user constructor tags bounded."
    1000003

fn ctorNameToTag(name: String) -> Int
    ? "Map constructor names to tag IDs. Builtins keep fixed tags; user constructors get stable hashed tags."
    match name
        "Result.Ok" -> tagResultOk()
        "Result.Err" -> tagResultErr()
        "Option.Some" -> tagOptionSome()
        "Option.None" -> tagOptionNone()
        _ -> tagUserBase() + userCtorTagOffset(name)

fn userCtorTagOffset(name: String) -> Int
    ? "Compute a stable non-zero offset for a user-defined constructor tag from its full dotted name."
    userCtorTagOffsetLoop(name, 0, 0)

verify userCtorTagOffset
    userCtorTagOffset("Shape.Circle") > 0 => true
    userCtorTagOffset("A") != userCtorTagOffset("B") => true

fn userCtorTagOffsetLoop(name: String, pos: Int, acc: Int) -> Int
    ? "Walk the constructor name and accumulate a bounded rolling hash."
    accPlusOne = acc + 1
    match pos >= String.len(name)
        true -> accPlusOne
        false -> match String.charAt(name, pos)
            Option.Some(ch) -> userCtorTagOffsetLoop(name, pos + 1, userCtorTagStep(acc, Option.withDefault(String.firstCodePoint(ch), 0)))
            Option.None -> accPlusOne

verify userCtorTagOffsetLoop
    userCtorTagOffsetLoop("A", 0, 0) > 0 => true
    userCtorTagOffsetLoop("X", 3, 5) => 6

fn userCtorTagStep(acc: Int, code: Int) -> Int
    ? "Update the user constructor rolling hash and keep it in a bounded range."
    next = acc * 131 + code
    Result.withDefault(Int.mod(next, userTagSpan()), 0)

verify userCtorTagStep
    userCtorTagStep(0, 65) => 65
    userCtorTagStep(1, 0) => 131

verify ctorNameToTag
    ctorNameToTag("Result.Ok") => 1
    ctorNameToTag("Result.Err") => 2
    ctorNameToTag("Option.Some") => 3
    ctorNameToTag("Option.None") => 4
    ctorNameToTag("Shape.Circle") > tagUserBase() => true

fn canonicalCtorName(name: String) -> String
    ? "One spelling per constructor: drop the declaring-module qualifier from a Module.Type.Variant reference, so a variant a dependency builds as Shade.Dark and its caller writes as Palette.Shade.Dark is the same constructor."
    total = String.len(name)
    canonicalCtorNameAtLastDot(name, total, lastDotAtOrBefore(name, total - 1))

verify canonicalCtorName
    canonicalCtorName("Palette.Shade.Dark") => "Shade.Dark"
    canonicalCtorName("Shade.Dark") => "Shade.Dark"
    canonicalCtorName("Domain.Value.Val.ValOk") => "Val.ValOk"
    canonicalCtorName("Result.Ok") => "Result.Ok"
    canonicalCtorName("Palette.pick") => "Palette.pick"
    canonicalCtorName("Domain.Eval.Store.emptyFnStore") => "Domain.Eval.Store.emptyFnStore"
    canonicalCtorName("Palette.Config.update") => "Palette.Config.update"
    canonicalCtorName("noDot") => "noDot"
    canonicalCtorName("") => ""

fn canonicalCtorNameAtLastDot(name: String, total: Int, lastDot: Int) -> String
    ? "A name with at most one dot is already the shortest spelling it has."
    match lastDot <= 0
        true -> name
        false -> canonicalCtorNameAtBothDots(name, total, lastDot, lastDotAtOrBefore(name, lastDot - 1))

verify canonicalCtorNameAtLastDot
    canonicalCtorNameAtLastDot("Shade.Dark", 10, 5) => "Shade.Dark"
    canonicalCtorNameAtLastDot("noDot", 5, -1) => "noDot"
    canonicalCtorNameAtLastDot("Palette.Shade.Dark", 18, 13) => "Shade.Dark"

fn canonicalCtorNameAtBothDots(name: String, total: Int, lastDot: Int, prevDot: Int) -> String
    ? "Keep only the trailing pair when a module qualifier precedes a Type.Variant reference; leave every other dotted name whole."
    match prevDot < 0
        true -> name
        false -> match isTypeVariantTail(String.slice(name, prevDot + 1, lastDot), String.slice(name, lastDot + 1, total))
            true -> String.slice(name, prevDot + 1, total)
            false -> name

verify canonicalCtorNameAtBothDots
    canonicalCtorNameAtBothDots("Palette.Shade.Dark", 18, 13, 7) => "Shade.Dark"
    canonicalCtorNameAtBothDots("Domain.Eval.Store.emptyFnStore", 30, 17, 11) => "Domain.Eval.Store.emptyFnStore"
    canonicalCtorNameAtBothDots("Domain.Value.Val.ValOk", 22, 16, 12) => "Val.ValOk"

fn isTypeVariantTail(typeName: String, variantName: String) -> Bool
    ? "Whether the trailing two segments spell Type.Variant. Both begin with an uppercase letter, the same rule the surface parser applies to constructor patterns."
    Bool.and(beginsUppercase(typeName), beginsUppercase(variantName))

verify isTypeVariantTail
    isTypeVariantTail("Shade", "Dark") => true
    isTypeVariantTail("Store", "emptyFnStore") => false
    isTypeVariantTail("pick", "Dark") => false

fn beginsUppercase(segment: String) -> Bool
    ? "Whether a dotted-name segment begins with an uppercase letter."
    match String.charAt(segment, 0)
        Option.Some(c) -> c != String.toLower(c)
        Option.None -> false

verify beginsUppercase
    beginsUppercase("Dark") => true
    beginsUppercase("pick") => false
    beginsUppercase("") => false

fn lastDotAtOrBefore(name: String, pos: Int) -> Int
    ? "Index of the last '.' at or before pos, or -1 when that prefix holds none."
    match pos < 0
        true -> -1
        false -> match String.charAt(name, pos)
            Option.Some(c) -> match c == "."
                true -> pos
                false -> lastDotAtOrBefore(name, pos - 1)
            Option.None -> -1

verify lastDotAtOrBefore
    lastDotAtOrBefore("A.B", 2) => 1
    lastDotAtOrBefore("A.B.C", 4) => 3
    lastDotAtOrBefore("A.B.C", 2) => 1
    lastDotAtOrBefore("AB", 1) => -1

fn builtinNameToId(name: String) -> Option<Int>
    ? "Map builtin function names to integer IDs for fast dispatch."
    match name
        "Map.set" -> Option.Some(1)
        "Map.get" -> Option.Some(2)
        "Map.has" -> Option.Some(3)
        "Map.fromList" -> Option.Some(4)
        "Map.entries" -> Option.Some(5)
        "Map.remove" -> Option.Some(6)
        "Vector.new" -> Option.Some(7)
        "Vector.get" -> Option.Some(8)
        "Vector.set" -> Option.Some(9)
        "Vector.len" -> Option.Some(10)
        "Vector.fromList" -> Option.Some(11)
        "List.fromVector" -> Option.Some(12)
        "Option.None" -> Option.Some(13)
        "Option.Some" -> Option.Some(14)
        "Option.withDefault" -> Option.Some(15)
        "Result.Ok" -> Option.Some(16)
        "Result.Err" -> Option.Some(17)
        "Result.withDefault" -> Option.Some(18)
        "String.fromInt" -> Option.Some(19)
        "List.take" -> Option.Some(20)
        "List.drop" -> Option.Some(21)
        _ -> Option.None

verify builtinNameToId
    builtinNameToId("Vector.len") => Option.Some(10)
    builtinNameToId("List.take") => Option.Some(20)
    builtinNameToId("unknown") => Option.None
