module Rules
    intent =
        "The wall: every rule a step may apply, as an equation schema over named binders."
        "The replayer's own copy of src/ir/proof_steps/rules.rs; an identifier not listed here is refused."
        "The list rules are the constructor equations of the list builtins, with Aver's truncation of a count."
        "The map rules read Map.get, Map.has and Map.len on the empty map and on Map.set(m, k, v)."
        "The vector rules read a vector as the list it holds, and Vector.get and Vector.len after a write or a literal-size Vector.new."
    exposes [Schema, schema]
    depends [Kernel.Term]
    effects []

record Schema
    binders: List<String>
    premises: List<Eqn>
    concl: Eqn

fn v(n: String) -> Term
    ? "A schema variable."
    Term.TVar(n)

verify v
    v("a") => Term.TVar("a")

fn eq(l: Term, r: Term) -> Eqn
    ? "An equation."
    Eqn(lhs = l, rhs = r)

verify eq
    eq(Term.TUnit, Term.TUnit) => Eqn(lhs = Term.TUnit, rhs = Term.TUnit)

fn is(t: Term, value: Bool) -> Eqn
    ? "A Bool term equals a literal."
    eq(t, Term.TBool(value))

verify is
    is(Term.TVar("a"), true) => Eqn(lhs = Term.TVar("a"), rhs = Term.TBool(true))

fn conn(name: String, a: Term, b: Term) -> Term
    ? "Bool.and or Bool.or."
    Term.TBi(name, [a, b])

verify conn
    conn("Bool.and", Term.TVar("a"), Term.TVar("b")) => Term.TBi("Bool.and", [Term.TVar("a"), Term.TVar("b")])

fn plain(binders: List<String>, l: Term, r: Term) -> Option<Schema>
    ? "A rule without premises."
    Option.Some(Schema(binders = binders, premises = [], concl = eq(l, r)))

verify plain
    plain([], Term.TUnit, Term.TUnit) => Option.Some(Schema(binders = [], premises = [], concl = eq(Term.TUnit, Term.TUnit)))

fn schema(id: String) -> Option<Schema>
    ? "The rule with this identifier."
    match id
        "bool.and.true_l" -> plain(["b"], conn("Bool.and", Term.TBool(true), v("b")), v("b"))
        "bool.and.false_l" -> plain(["b"], conn("Bool.and", Term.TBool(false), v("b")), Term.TBool(false))
        "bool.and.true_r" -> plain(["a"], conn("Bool.and", v("a"), Term.TBool(true)), v("a"))
        "bool.and.false_r" -> plain(["a"], conn("Bool.and", v("a"), Term.TBool(false)), Term.TBool(false))
        "bool.or.true_l" -> plain(["b"], conn("Bool.or", Term.TBool(true), v("b")), Term.TBool(true))
        "bool.or.false_l" -> plain(["b"], conn("Bool.or", Term.TBool(false), v("b")), v("b"))
        "bool.or.true_r" -> plain(["a"], conn("Bool.or", v("a"), Term.TBool(true)), Term.TBool(true))
        "bool.or.false_r" -> plain(["a"], conn("Bool.or", v("a"), Term.TBool(false)), v("a"))
        "bool.not.true" -> plain([], Term.TBi("Bool.not", [Term.TBool(true)]), Term.TBool(false))
        "bool.not.false" -> plain([], Term.TBi("Bool.not", [Term.TBool(false)]), Term.TBool(true))
        "bool.and.elim_l" -> Option.Some(Schema(binders = ["a", "b"], premises = [is(conn("Bool.and", v("a"), v("b")), true)], concl = is(v("a"), true)))
        "bool.and.elim_r" -> Option.Some(Schema(binders = ["a", "b"], premises = [is(conn("Bool.and", v("a"), v("b")), true)], concl = is(v("b"), true)))
        _ -> comparisonSchema(id)

verify schema
    schema("simp") => Option.None
    schema("bool.not.true") => Option.Some(Schema(binders = [], premises = [], concl = eq(Term.TBi("Bool.not", [Term.TBool(true)]), Term.TBool(false))))

fn complement(p: String, pv: Bool, q: String, qv: Bool) -> Option<Schema>
    ? "A decided comparison decides its complement."
    Option.Some(Schema(binders = ["a", "b"], premises = [is(Term.TOp(p, v("a"), v("b")), pv)], concl = is(Term.TOp(q, v("a"), v("b")), qv)))

verify complement
    complement(">", false, "<=", true) => Option.Some(Schema(binders = ["a", "b"], premises = [is(Term.TOp(">", v("a"), v("b")), false)], concl = is(Term.TOp("<=", v("a"), v("b")), true)))

fn comparisonSchema(id: String) -> Option<Schema>
    ? "The comparison complement rules."
    match id
        "int.le.of_not_gt" -> complement(">", false, "<=", true)
        "int.le.false_of_gt" -> complement(">", true, "<=", false)
        "int.ge.of_not_lt" -> complement("<", false, ">=", true)
        "int.ge.false_of_lt" -> complement("<", true, ">=", false)
        "int.lt.of_not_ge" -> complement(">=", false, "<", true)
        "int.lt.false_of_ge" -> complement(">=", true, "<", false)
        "int.gt.of_not_le" -> complement("<=", false, ">", true)
        "int.gt.false_of_le" -> complement("<=", true, ">", false)
        "int.eq.of_not_ne" -> complement("!=", false, "==", true)
        "int.eq.false_of_ne" -> complement("!=", true, "==", false)
        "int.ne.of_not_eq" -> complement("==", false, "!=", true)
        "int.ne.false_of_eq" -> complement("==", true, "!=", false)
        "int.eq.of_le_ge" -> Option.Some(Schema(binders = ["a", "b"], premises = [is(Term.TOp("<=", v("a"), v("b")), true), is(Term.TOp(">=", v("a"), v("b")), true)], concl = is(Term.TOp("==", v("a"), v("b")), true)))
        "int.eq.false_of_lt" -> complement("<", true, "==", false)
        "int.eq.false_of_gt" -> complement(">", true, "==", false)
        "int.eq.of_beq" -> Option.Some(Schema(binders = ["a", "b"], premises = [is(Term.TOp("==", v("a"), v("b")), true)], concl = eq(v("a"), v("b"))))
        _ -> ringSchema(id)

verify comparisonSchema
    comparisonSchema("nope") => Option.None
    comparisonSchema("int.eq.of_beq") => Option.Some(Schema(binders = ["a", "b"], premises = [is(Term.TOp("==", v("a"), v("b")), true)], concl = eq(v("a"), v("b"))))

fn ringSchema(id: String) -> Option<Schema>
    ? "Ring laws of Int."
    match id
        "int.add_comm" -> plain(["a", "b"], Term.TOp("+", v("a"), v("b")), Term.TOp("+", v("b"), v("a")))
        "int.mul_comm" -> plain(["a", "b"], Term.TOp("*", v("a"), v("b")), Term.TOp("*", v("b"), v("a")))
        "int.add_assoc" -> plain(["a", "b", "c"], Term.TOp("+", Term.TOp("+", v("a"), v("b")), v("c")), Term.TOp("+", v("a"), Term.TOp("+", v("b"), v("c"))))
        "int.mul_assoc" -> plain(["a", "b", "c"], Term.TOp("*", Term.TOp("*", v("a"), v("b")), v("c")), Term.TOp("*", v("a"), Term.TOp("*", v("b"), v("c"))))
        "int.add_zero" -> plain(["a"], Term.TOp("+", v("a"), Term.TInt(0)), v("a"))
        "int.zero_add" -> plain(["a"], Term.TOp("+", Term.TInt(0), v("a")), v("a"))
        "int.mul_one" -> plain(["a"], Term.TOp("*", v("a"), Term.TInt(1)), v("a"))
        "int.one_mul" -> plain(["a"], Term.TOp("*", Term.TInt(1), v("a")), v("a"))
        "int.sub_zero" -> plain(["a"], Term.TOp("-", v("a"), Term.TInt(0)), v("a"))
        _ -> divisionSchema(id)

verify ringSchema
    ringSchema("int.add_zero") => plain(["a"], Term.TOp("+", v("a"), Term.TInt(0)), v("a"))

fn divE(a: Term, k: Term) -> Term
    ? "Euclidean division by a literal, as the compiler writes it."
    Term.TBi("__int_div_euclid", [a, k])

verify divE
    divE(v("a"), Term.TInt(2)) => Term.TBi("__int_div_euclid", [v("a"), Term.TInt(2)])

fn modE(a: Term, k: Term) -> Term
    ? "Euclidean remainder by a literal."
    Term.TBi("__int_mod_euclid", [a, k])

verify modE
    modE(v("a"), Term.TInt(2)) => Term.TBi("__int_mod_euclid", [v("a"), Term.TInt(2)])

fn range(t: Term, bound: Term) -> Term
    ? "0 <= t and t < bound."
    conn("Bool.and", Term.TOp("<=", Term.TInt(0), t), Term.TOp("<", t, bound))

verify range
    range(v("a"), v("m")) => conn("Bool.and", Term.TOp("<=", Term.TInt(0), v("a")), Term.TOp("<", v("a"), v("m")))

fn divisionSchema(id: String) -> Option<Schema>
    ? "Euclidean division by a positive divisor."
    match id
        "int.div_mod_recompose" -> Option.Some(Schema(binders = ["a", "k"], premises = [is(Term.TOp(">", v("k"), Term.TInt(0)), true)], concl = eq(Term.TOp("+", Term.TOp("*", divE(v("a"), v("k")), v("k")), modE(v("a"), v("k"))), v("a"))))
        "int.div_range" -> Option.Some(Schema(binders = ["a", "k", "m", "n"], premises = [is(range(v("a"), v("m")), true), is(conn("Bool.and", Term.TOp(">", v("k"), Term.TInt(0)), Term.TOp("==", v("m"), Term.TOp("*", v("n"), v("k")))), true)], concl = is(range(divE(v("a"), v("k")), v("n")), true)))
        _ -> listSchema(id)

verify divisionSchema
    divisionSchema("int.div_range") == Option.None => false

fn cons(x: Term, xs: Term) -> Term
    ? "An element in front of a list."
    Term.TBi("List.prepend", [x, xs])

verify cons
    cons(v("x"), Term.TList([])) => Term.TBi("List.prepend", [v("x"), Term.TList([])])

fn lb(name: String, args: List<Term>) -> Term
    ? "A list builtin applied to its arguments."
    Term.TBi("List.{name}", args)

verify lb
    lb("len", [v("a")]) => Term.TBi("List.len", [v("a")])

fn counted(binders: List<String>, positive: Bool, l: Term, r: Term) -> Option<Schema>
    ? "A rule on a count n that holds when n > 0 (positive) or when n <= 0."
    premise = match positive
        true -> is(Term.TOp(">", v("n"), Term.TInt(0)), true)
        false -> is(Term.TOp("<=", v("n"), Term.TInt(0)), true)
    Option.Some(Schema(binders = binders, premises = [premise], concl = eq(l, r)))

verify counted
    counted(["n"], false, Term.TUnit, Term.TUnit) => Option.Some(Schema(binders = ["n"], premises = [is(Term.TOp("<=", v("n"), Term.TInt(0)), true)], concl = eq(Term.TUnit, Term.TUnit)))

fn listSchema(id: String) -> Option<Schema>
    ? "Each list builtin on the empty list and on an element in front of a list."
    xa = cons(v("x"), v("a"))
    nil = Term.TList([])
    less = Term.TOp("-", v("n"), Term.TInt(1))
    match id
        "list.concat.nil" -> plain(["b"], lb("concat", [nil, v("b")]), v("b"))
        "list.concat.cons" -> plain(["x", "a", "b"], lb("concat", [xa, v("b")]), cons(v("x"), lb("concat", [v("a"), v("b")])))
        "list.len.nil" -> plain([], lb("len", [nil]), Term.TInt(0))
        "list.len.cons" -> plain(["x", "a"], lb("len", [xa]), Term.TOp("+", lb("len", [v("a")]), Term.TInt(1)))
        "list.take.nil" -> plain(["n"], lb("take", [nil, v("n")]), nil)
        "list.take.cons_le" -> counted(["x", "a", "n"], false, lb("take", [xa, v("n")]), nil)
        "list.take.cons_gt" -> counted(["x", "a", "n"], true, lb("take", [xa, v("n")]), cons(v("x"), lb("take", [v("a"), less])))
        "list.drop.nil" -> plain(["n"], lb("drop", [nil, v("n")]), nil)
        "list.drop.cons_le" -> counted(["x", "a", "n"], false, lb("drop", [xa, v("n")]), xa)
        "list.drop.cons_gt" -> counted(["x", "a", "n"], true, lb("drop", [xa, v("n")]), lb("drop", [v("a"), less]))
        "list.reverse.nil" -> plain([], lb("reverse", [nil]), nil)
        "list.reverse.cons" -> plain(["x", "a"], lb("reverse", [xa]), lb("concat", [lb("reverse", [v("a")]), cons(v("x"), nil)]))
        _ -> mapSchema(id)

verify listSchema
    listSchema("list.len.nil") => plain([], Term.TBi("List.len", [Term.TList([])]), Term.TInt(0))
    listSchema("list.len") => Option.None

fn mb(name: String, args: List<Term>) -> Term
    ? "A Map builtin applied to its arguments; the empty map is Map.empty()."
    Term.TBi("Map.{name}", args)

verify mb
    mb("empty", []) => Term.TBi("Map.empty", [])

fn mapSchema(id: String) -> Option<Schema>
    ? "Each Map read on the empty map and on a set: at the key set, at another key, and the size by membership."
    set = mb("set", [v("m"), v("k"), v("v")])
    empty = mb("empty", [])
    other = [is(Term.TOp("!=", v("k"), v("k2")), true)]
    match id
        "map.get.empty" -> plain(["k"], mb("get", [empty, v("k")]), Term.TCtor("Option.None", []))
        "map.get.set_same" -> plain(["m", "k", "v"], mb("get", [set, v("k")]), Term.TCtor("Option.Some", [v("v")]))
        "map.get.set_other" -> Option.Some(Schema(binders = ["m", "k", "v", "k2"], premises = other, concl = eq(mb("get", [set, v("k2")]), mb("get", [v("m"), v("k2")]))))
        "map.has.empty" -> plain(["k"], mb("has", [empty, v("k")]), Term.TBool(false))
        "map.has.set_same" -> plain(["m", "k", "v"], mb("has", [set, v("k")]), Term.TBool(true))
        "map.has.set_other" -> Option.Some(Schema(binders = ["m", "k", "v", "k2"], premises = other, concl = eq(mb("has", [set, v("k2")]), mb("has", [v("m"), v("k2")]))))
        "map.len.empty" -> plain([], mb("len", [empty]), Term.TInt(0))
        "map.len.set_present" -> Option.Some(Schema(binders = ["m", "k", "v"], premises = [is(mb("has", [v("m"), v("k")]), true)], concl = eq(mb("len", [set]), mb("len", [v("m")]))))
        "map.len.set_absent" -> Option.Some(Schema(binders = ["m", "k", "v"], premises = [is(mb("has", [v("m"), v("k")]), false)], concl = eq(mb("len", [set]), Term.TOp("+", mb("len", [v("m")]), Term.TInt(1)))))
        _ -> vectorSchema(id)

verify mapSchema
    mapSchema("map.len.empty") => plain([], Term.TBi("Map.len", [Term.TBi("Map.empty", [])]), Term.TInt(0))
    mapSchema("map.keys.set") => Option.None

fn vb(name: String, args: List<Term>) -> Term
    ? "A Vector builtin applied to its arguments."
    Term.TBi("Vector.{name}", args)

verify vb
    vb("len", [v("v")]) => Term.TBi("Vector.len", [v("v")])

fn inRange(at: Term, end: Term) -> Eqn
    ? "0 <= at and at < end, as a premise."
    is(conn("Bool.and", Term.TOp("<=", Term.TInt(0), at), Term.TOp("<", at, end)), true)

verify inRange
    inRange(v("i"), v("n")) => is(conn("Bool.and", Term.TOp("<=", Term.TInt(0), v("i")), Term.TOp("<", v("i"), v("n"))), true)

fn vectorSchema(id: String) -> Option<Schema>
    ? "A vector as the list it holds; reads out of range; a read and the length after a write; a literal-size Vector.new."
    len = vb("len", [v("v")])
    written = Term.TBi("Option.withDefault", [vb("set", [v("v"), v("i"), v("x")]), v("v")])
    made = Term.TBi("__vector_new", [v("n"), v("x")])
    match id
        "vector.to_list.of_list" -> plain(["l"], Term.TBi("List.fromVector", [vb("fromList", [v("l")])]), v("l"))
        "vector.of_list.to_list" -> plain(["v"], vb("fromList", [Term.TBi("List.fromVector", [v("v")])]), v("v"))
        "vector.len.to_list" -> plain(["v"], len, Term.TBi("List.len", [Term.TBi("List.fromVector", [v("v")])]))
        "vector.get.negative" -> Option.Some(Schema(binders = ["v", "i"], premises = [is(Term.TOp("<", v("i"), Term.TInt(0)), true)], concl = eq(vb("get", [v("v"), v("i")]), Term.TCtor("Option.None", []))))
        "vector.get.past_end" -> Option.Some(Schema(binders = ["v", "i"], premises = [is(Term.TOp(">=", v("i"), len), true)], concl = eq(vb("get", [v("v"), v("i")]), Term.TCtor("Option.None", []))))
        "vector.set.out_of_range" -> Option.Some(Schema(binders = ["v", "i", "x"], premises = [is(conn("Bool.or", Term.TOp("<", v("i"), Term.TInt(0)), Term.TOp(">=", v("i"), len)), true)], concl = eq(vb("set", [v("v"), v("i"), v("x")]), Term.TCtor("Option.None", []))))
        "vector.get.set_same" -> Option.Some(Schema(binders = ["v", "i", "x"], premises = [inRange(v("i"), len)], concl = eq(vb("get", [written, v("i")]), Term.TCtor("Option.Some", [v("x")]))))
        "vector.get.set_other" -> Option.Some(Schema(binders = ["v", "i", "x", "j"], premises = [inRange(v("i"), len), is(Term.TOp("!=", v("i"), v("j")), true)], concl = eq(vb("get", [written, v("j")]), vb("get", [v("v"), v("j")]))))
        "vector.len.set" -> plain(["v", "i", "x"], vb("len", [written]), len)
        "vector.len.new" -> Option.Some(Schema(binders = ["n", "x"], premises = [is(Term.TOp("<=", Term.TInt(0), v("n")), true)], concl = eq(vb("len", [made]), v("n"))))
        "vector.get.new" -> Option.Some(Schema(binders = ["n", "x", "i"], premises = [inRange(v("i"), v("n"))], concl = eq(vb("get", [made, v("i")]), Term.TCtor("Option.Some", [v("x")]))))
        _ -> Option.None

verify vectorSchema
    vectorSchema("vector.len.set") == Option.None => false
    vectorSchema("vector.keys") => Option.None
