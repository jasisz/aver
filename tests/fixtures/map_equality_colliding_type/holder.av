module Holder
    intent =
        "A record named Holder.Entry that carries no map at all."
        "The entry module declares its own Entry, holding a float-keyed map, so the two share a bare name and only the resolved type identity tells them apart."

record Entry
    label: String
    weight: Int

fn entryOf(label: String, weight: Int) -> Entry
    ? "Builds a map-free entry."
    Entry(label = label, weight = weight)
