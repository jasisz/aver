== Manifest.lean ==
-- The certificate's manifest: the subject (artifact identity, exports,
-- helper indices and the contracts it is conditional on), the plans and
-- the obligations, which are exactly the ones the wall derives.
import SchemaCore
import AcceptedArtifactCore
import Plans

namespace AverCert
open AverCert.Schema

def subject : Subject :=
  { artifactHash := "4b86ac5e745a7f0aeef0d24178a3f47ed09b4f98ffc36216aedf252c9cb20583"
    target := "wasm-gc", profile := "AverUserProfile/v1", abi := "aver-wasm-gc/0"
    artifactRoot := "AverCert.Artifact.certificate"
    exports := ["addOne"]
    declaredUncertified := [("_start", "module export is outside the claimed certification obligations"), ("__rt_string_from_lm", "module export is outside the claimed certification obligations"), ("__rt_string_to_lm", "module export is outside the claimed certification obligations"), ("__rt_memory_pages", "module export is outside the claimed certification obligations"), ("__rt_memory_grow", "module export is outside the claimed certification obligations"), ("__rt_aint_from_i64", "module export is outside the claimed certification obligations"), ("__rt_aint_to_i64_checked", "module export is outside the claimed certification obligations"), ("__aint_to_index", "module export is outside the claimed certification obligations"), ("memory", "module export is outside the claimed certification obligations"), ("__caller_fn_count", "module export is outside the claimed certification obligations"), ("__caller_fn_name", "module export is outside the claimed certification obligations")]
    capabilities := []
    start := none
    hostRoleTable := some ({ box := some 6, add := some 7, mul := some 9, sub := some 8, toIndex := some 18, cmp := none, eq := none, divmod := some 12 } : CertDecode.AddSub.Roles)
    arithParams := some ({ carrier := 2, limb := 1, decompose := 2, normalize := 3, strip := 4, umagCmp := 5 } : ArithTemplateDerisk.ArithHostParams)
    stringHostRoles := []
    contracts := ["__rt_aint_from_i64 (box i64 -> carrier)", "Int.add (carrier add = exact integer addition on represented values; result canonical)"] }

def manifest : Manifest :=
  { subject := subject, types := Plans.types, fnPlans := Plans.fnPlans,
    obligations := AverCert.AcceptedArtifact.obligationsOf subject Plans.types Plans.fnPlans }

end AverCert

== Plans.lean ==
-- The certificate's plans: every planned function's optimized MIR body,
-- printed 1:1 into the one plan grammar, and the declared type layout.
-- Producer data: the wall lowers each plan and pins the result to the
-- function's code entry, and confirms the layout against the bytes.
import SchemaCore

namespace AverCert.Plans
open AverCert.Schema AverCert.Grammar

def types : TypeTable :=
  { carrier := some 2, mag := some 1, str := some 0, strVec := none,
    records := [],
    sums := [],
    options := [], results := [],
    vecs := [], lists := [], opaques := [],
    strSegs := [] }

/-- `addOne` (function 1). -/
def fn1 : FnPlan :=
  { sig := ⟨[.int], .int⟩, nslots := 1, locals := [.int],
    body := (.binOp .add (.local 0) (.literal (.int 1))) }

def fnPlans : List FnEntry :=
  [⟨"addOne", true, 1, 0, fn1⟩]

end AverCert.Plans
