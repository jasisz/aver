fn entryEpsilonOk(i: Int) -> Bool
    ? "The paper's epsilon-ok property for bucket i (page 26): the entry <k, v> has"
      "0 < v, |k * v - 1| < 3/512, and |(k + 2^-7) * v - 1| < 3/512 -- the relative"
      "error is bounded at BOTH endpoints of [k, k + 2^-7). This is exactly the"
      "predicate the paper executes over Table 1 to confirm the seed bound."
    Bool.and(Bool.and(Domain.Rational.lessThan(Domain.Rational.zeroFraction(), lookup(i)), Domain.Rational.lessThan(relError(key(i), i), epsilon())), Domain.Rational.lessThan(relError(keyHi(i), i), epsilon()))

verify entryEpsilonOk
    entryEpsilonOk(0) => true
    entryEpsilonOk(6) => true
    entryEpsilonOk(64) => true
    entryEpsilonOk(96) => true
    entryEpsilonOk(127) => true

verify entryEpsilonOk law tableSeedBound
    given i: Int = [0, 64, 127]
    when 0 <= i
    when i < 128
    entryEpsilonOk(i) holds

fn bucketErrorOk(d: Fraction, i: Int) -> Bool
    ? "The Lemma 8.1.1 seed bound (page 26) at an arbitrary divisor d in bucket i:"
      "the relative error |d * lookup(i) - 1| of the reciprocal estimate is below"
      "epsilon = 3/512. At d = key(i) this is tableEntryOk(i); bucketMonotonicity"
      "lifts it to every d in the bucket interval [key(i), keyHi(i)]."
    Domain.Rational.lessThan(relError(d, i), epsilon())

verify bucketErrorOk
    bucketErrorOk(key(64), 64) => true
    bucketErrorOk(keyHi(64), 64) => true
    bucketErrorOk(Domain.Rational.Fraction(top = 3, bottom = 2), 64) => true

verify bucketErrorOk law bucketErrorIsSeed
    given d: Fraction = [Domain.Rational.Fraction(top = 3, bottom = 2), Domain.Rational.Fraction(top = 191, bottom = 128)]
    given i: Int = [64, 63]
    bucketErrorOk(d, i) => seedBelow(d, lookup(i), epsilon())

verify bucketErrorOk law bucketMonotonicity
    given d: Fraction = [Domain.Rational.Fraction(top = 3, bottom = 2), Domain.Rational.Fraction(top = 191, bottom = 128)]
    given i: Int = [64, 63]
    when 0 <= i
    when i < 128
    when Domain.Rational.isNonNeg(Domain.Rational.minus(d, key(i)))
    when Domain.Rational.isNonNeg(Domain.Rational.minus(keyHi(i), d))
    when d.bottom != 0
    bucketErrorOk(d, i) holds

fn allEpsilonOkFrom(i: Int) -> Bool
    ? "Conjunction of entryEpsilonOk over buckets i, i + 1, ..., 127."
    match i >= 128
        true -> true
        false -> Bool.and(entryEpsilonOk(i), allEpsilonOkFrom(i + 1))

fn tableIsEpsilonOk() -> Bool
    ? "Table 1 is epsilon-ok: every one of the 128 buckets satisfies entryEpsilonOk."
      "This is the whole-table property the paper confirms by execution (page 26)."
    allEpsilonOkFrom(0)

verify tableIsEpsilonOk
    tableIsEpsilonOk() => true

fn boolToInt(b: Bool) -> Int
    ? "1 for true, 0 for false; used to count passing buckets."
    match b
        true -> 1
        false -> 0

fn countEpsilonOkFrom(i: Int) -> Int
    ? "Number of epsilon-ok buckets among i, i + 1, ..., 127."
    match i >= 128
        true -> 0
        false -> boolToInt(entryEpsilonOk(i)) + countEpsilonOkFrom(i + 1)

fn bucketsEpsilonOk() -> Int
    ? "How many of the 128 table buckets are epsilon-ok; equals 128 exactly when the"
      "whole table satisfies the Lemma 8.1.1 seed bound across its full domain."
    countEpsilonOkFrom(0)

verify bucketsEpsilonOk
    bucketsEpsilonOk() => 128
