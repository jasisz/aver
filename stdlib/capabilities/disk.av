module Disk
    kind = capability
    semantics = effectful
    depends [Bytes]
    exposes [readText, writeText, appendText, readBytes, readBytesAt, writeBytes, appendBytes, size, exists, delete, deleteDir, listDir, makeDir, sync]

operation readText(file: String) -> Result<String, String>
    ? "Reads a whole file as UTF-8 text."
    oracle = generative
    replay = recorded
    hostile = [readTextNormal, readTextAlwaysErr, readTextEmptyOk]

operation writeText(file: String, content: String) -> Result<Unit, String>
    ? "Replaces a file's contents with UTF-8 text, creating it if absent."
    oracle = generativeOutput
    replay = recorded
    hostile = [writeTextNormalOk, writeTextAlwaysErr]

operation appendText(file: String, content: String) -> Result<Unit, String>
    ? "Appends UTF-8 text to a file, creating it if absent."
    oracle = generativeOutput
    replay = recorded
    hostile = [appendTextNormalOk, appendTextAlwaysErr]

operation readBytes(file: String) -> Result<Bytes, String>
    ? "Reads a whole file without interpreting its bytes as text."
    oracle = generative
    replay = recorded
    hostile = [readBytesNormal, readBytesAlwaysErr, readBytesEmptyOk]

operation readBytesAt(file: String, offset: Int, length: Int) -> Result<Bytes, String>
    ? "Reads at most length bytes from offset; EOF may return fewer bytes, including none."
    oracle = generative
    replay = recorded
    hostile = [readBytesAtNormal, readBytesAtAlwaysErr, readBytesAtShortOk]

operation writeBytes(file: String, content: Bytes) -> Result<Unit, String>
    ? "Replaces a file with the exact bytes supplied, creating it if absent."
    oracle = generativeOutput
    replay = recorded
    hostile = [writeBytesNormalOk, writeBytesAlwaysErr]

operation appendBytes(file: String, content: Bytes) -> Result<Unit, String>
    ? "Appends the exact bytes supplied, creating the file if absent."
    oracle = generativeOutput
    replay = recorded
    hostile = [appendBytesNormalOk, appendBytesAlwaysErr]

operation size(file: String) -> Result<Int, String>
    ? "Returns a file's length in bytes."
    oracle = generative
    replay = recorded
    hostile = [sizeNormal, sizeZero, sizeAlwaysErr]

operation exists(file: String) -> Bool
    ? "Reports whether a path is present."
    oracle = generative
    replay = recorded
    hostile = [existsNormal, existsNever, existsAlways]

operation delete(file: String) -> Result<Unit, String>
    ? "Removes one file."
    oracle = generativeOutput
    replay = recorded
    hostile = [deleteNormalOk, deleteAlwaysErr]

operation deleteDir(file: String) -> Result<Unit, String>
    ? "Removes one directory and everything under it."
    oracle = generativeOutput
    replay = recorded
    hostile = [deleteDirNormalOk, deleteDirAlwaysErr]

operation listDir(dir: String) -> Result<List<String>, String>
    ? "Lists the entries of a directory."
    oracle = generative
    replay = recorded
    hostile = [listDirNormal, listDirEmpty, listDirAlwaysErr]

operation makeDir(file: String) -> Result<Unit, String>
    ? "Creates a directory, and the directories above it."
    oracle = generativeOutput
    replay = recorded
    hostile = [makeDirNormalOk, makeDirAlwaysErr]

operation sync(file: String) -> Result<Unit, String>
    ? "Forces a file's or directory's bytes and metadata to stable storage; sync the parent directory too to make a new file's directory entry durable. On Windows a directory sync is a no-op that returns Ok, because there is no call that flushes a directory and NTFS journals the metadata instead."
    oracle = generativeOutput
    replay = recorded
    hostile = [syncNormalOk, syncAlwaysErr]

fn readTextNormal(branch: BranchPath, call: Int, file: String) -> Result<String, String>
    ? "honest: file reads back a plausible payload"
    Result.Ok("hello\n")

fn readTextAlwaysErr(branch: BranchPath, call: Int, file: String) -> Result<String, String>
    ? "hostile: every read fails — disk is on fire"
    Result.Err("hostile: disk read failed")

fn readTextEmptyOk(branch: BranchPath, call: Int, file: String) -> Result<String, String>
    ? "hostile: file exists but content is empty"
    Result.Ok("")

fn writeTextNormalOk(branch: BranchPath, call: Int, file: String, content: String) -> Result<Unit, String>
    ? "honest: write succeeds"
    Result.Ok(Unit)

fn writeTextAlwaysErr(branch: BranchPath, call: Int, file: String, content: String) -> Result<Unit, String>
    ? "hostile: write fails — disk full or permission denied"
    Result.Err("hostile: write failed")

fn appendTextNormalOk(branch: BranchPath, call: Int, file: String, content: String) -> Result<Unit, String>
    ? "honest: append succeeds"
    Result.Ok(Unit)

fn appendTextAlwaysErr(branch: BranchPath, call: Int, file: String, content: String) -> Result<Unit, String>
    ? "hostile: append fails — disk full or permission denied"
    Result.Err("hostile: write failed")

fn readBytesNormal(branch: BranchPath, call: Int, file: String) -> Result<Bytes, String>
    ? "honest: binary reads return a plausible non-UTF-8 payload"
    Result.Ok(Bytes.fromList([0, 127, 128, 255]))

fn readBytesAlwaysErr(branch: BranchPath, call: Int, file: String) -> Result<Bytes, String>
    ? "hostile: every binary read fails"
    Result.Err("hostile: disk byte read failed")

fn readBytesEmptyOk(branch: BranchPath, call: Int, file: String) -> Result<Bytes, String>
    ? "hostile: the file is present but empty"
    Result.Ok(Bytes.fromList([]))

fn readBytesAtNormal(branch: BranchPath, call: Int, file: String, offset: Int, length: Int) -> Result<Bytes, String>
    ? "honest: positional reads return a plausible binary slice"
    Result.Ok(Bytes.fromList([128, 255]))

fn readBytesAtAlwaysErr(branch: BranchPath, call: Int, file: String, offset: Int, length: Int) -> Result<Bytes, String>
    ? "hostile: every positional binary read fails"
    Result.Err("hostile: positional byte read failed")

fn readBytesAtShortOk(branch: BranchPath, call: Int, file: String, offset: Int, length: Int) -> Result<Bytes, String>
    ? "hostile: EOF is reached before the requested length"
    Result.Ok(Bytes.fromList([]))

fn writeBytesNormalOk(branch: BranchPath, call: Int, file: String, content: Bytes) -> Result<Unit, String>
    ? "honest: binary write succeeds"
    Result.Ok(Unit)

fn writeBytesAlwaysErr(branch: BranchPath, call: Int, file: String, content: Bytes) -> Result<Unit, String>
    ? "hostile: binary write fails"
    Result.Err("hostile: byte write failed")

fn appendBytesNormalOk(branch: BranchPath, call: Int, file: String, content: Bytes) -> Result<Unit, String>
    ? "honest: binary append succeeds"
    Result.Ok(Unit)

fn appendBytesAlwaysErr(branch: BranchPath, call: Int, file: String, content: Bytes) -> Result<Unit, String>
    ? "hostile: binary append fails"
    Result.Err("hostile: byte append failed")

fn sizeNormal(branch: BranchPath, call: Int, file: String) -> Result<Int, String>
    ? "honest: file metadata reports a plausible byte length"
    Result.Ok(4096)

fn sizeZero(branch: BranchPath, call: Int, file: String) -> Result<Int, String>
    ? "hostile: the file is empty"
    Result.Ok(0)

fn sizeAlwaysErr(branch: BranchPath, call: Int, file: String) -> Result<Int, String>
    ? "hostile: file metadata cannot be read"
    Result.Err("hostile: size failed")

fn existsNormal(branch: BranchPath, call: Int, file: String) -> Bool
    ? "honest: file exists"
    true

fn existsNever(branch: BranchPath, call: Int, file: String) -> Bool
    ? "hostile: nothing exists on the filesystem"
    false

fn existsAlways(branch: BranchPath, call: Int, file: String) -> Bool
    ? "hostile: every path exists — every cleanup deletes something"
    true

fn deleteNormalOk(branch: BranchPath, call: Int, file: String) -> Result<Unit, String>
    ? "honest: filesystem op succeeds"
    Result.Ok(Unit)

fn deleteAlwaysErr(branch: BranchPath, call: Int, file: String) -> Result<Unit, String>
    ? "hostile: filesystem op fails"
    Result.Err("hostile: op failed")

fn deleteDirNormalOk(branch: BranchPath, call: Int, file: String) -> Result<Unit, String>
    ? "honest: filesystem op succeeds"
    Result.Ok(Unit)

fn deleteDirAlwaysErr(branch: BranchPath, call: Int, file: String) -> Result<Unit, String>
    ? "hostile: filesystem op fails"
    Result.Err("hostile: op failed")

fn listDirNormal(branch: BranchPath, call: Int, dir: String) -> Result<List<String>, String>
    ? "honest: directory has a few entries"
    Result.Ok(["a.txt", "b.txt"])

fn listDirEmpty(branch: BranchPath, call: Int, dir: String) -> Result<List<String>, String>
    ? "hostile: directory is empty"
    Result.Ok([])

fn listDirAlwaysErr(branch: BranchPath, call: Int, dir: String) -> Result<List<String>, String>
    ? "hostile: directory listing fails"
    Result.Err("hostile: listdir failed")

fn makeDirNormalOk(branch: BranchPath, call: Int, file: String) -> Result<Unit, String>
    ? "honest: filesystem op succeeds"
    Result.Ok(Unit)

fn makeDirAlwaysErr(branch: BranchPath, call: Int, file: String) -> Result<Unit, String>
    ? "hostile: filesystem op fails"
    Result.Err("hostile: op failed")

fn syncNormalOk(branch: BranchPath, call: Int, file: String) -> Result<Unit, String>
    ? "honest: the flush reaches stable storage"
    Result.Ok(Unit)

fn syncAlwaysErr(branch: BranchPath, call: Int, file: String) -> Result<Unit, String>
    ? "hostile: the flush fails — the bytes are not durable"
    Result.Err("hostile: sync failed")
