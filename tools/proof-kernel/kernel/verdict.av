module Verdict
    intent =
        "One step script in, the law it proves or the refusal of its first wrong step out."
        "Pure: the CLI in main.av and the aver binary (src/proof_kernel, generated) both call it."
    exposes [verdict]
    depends [Kernel.Sexp, Kernel.Decode, Kernel.Check]
    effects []

fn verdict(text: String) -> Result<String, String>
    ? "Read one script and check it: the law it proves, or the refusal."
    sexp = Kernel.Sexp.readAll(text)?
    Kernel.Check.checkScript(Kernel.Decode.script(sexp)?)

verify verdict
    verdict("(steps 7 (obligation k () (none) (i 1) (i 1)) (defs) (consts) (laws) (proof (refl (i 1))))") => Result.Ok("k")
    verdict("(steps 7 (obligation k () (none) (i 1) (i 1)) (defs) (consts) (laws) (proof (hyp h)))") => Result.Err("step proof: hypothesis h is not in scope")
    verdict("(steps 7 (obligation k () (none) (v base) (i 40)) (defs) (consts (const base (i 40))) (laws) (proof (const base)))") => Result.Ok("k")
    verdict("(steps 7 (obligation k () (none) (v base) (i 41)) (defs) (consts (const base (i 40))) (laws) (proof (const base)))") => Result.Err("step proof: the proof ends at a different equation than the claim")
    verdict("(steps 7 (obligation k (a) (none) (call f (v a)) (op + (v a) (i 1))) (defs (def f (x) ((y (op + (v x) (i 1)))) (v y))) (consts) (laws) (proof (unfold f 0 ((v a)) ())))") => Result.Ok("k")
    verdict("(steps 7 (obligation k (a) (none) (call f (v a)) (v y)) (defs (def f (x) ((y (op + (v x) (i 1)))) (v y))) (consts) (laws) (proof (unfold f 0 ((v a)) ())))") => Result.Err("step proof: the proof ends at a different equation than the claim")
    verdict("(steps 7 (obligation k ((b (tbool))) (none) (op == (v b) (v b)) (b true)) (defs) (consts) (laws) (proof (enum b (op == (v b) (v b)) (b true) (compute (op == (b false) (b false)) (b true)) (compute (op == (b true) (b true)) (b true)))))") => Result.Ok("k")
    verdict("(steps 7 (obligation k ((b (tbool))) (none) (op == (v b) (v b)) (b true)) (defs) (consts) (laws) (proof (enum b (op == (v b) (v b)) (b true) (compute (op == (b false) (b false)) (b true)))))") => Result.Err("step proof: the cases do not match the values of b")
    verdict("(steps 7 (obligation k (b) (none) (op == (v b) (v b)) (b true)) (defs) (consts) (laws) (proof (enum b (op == (v b) (v b)) (b true) (compute (op == (b false) (b false)) (b true)) (compute (op == (b true) (b true)) (b true)))))") => Result.Err("step proof: b is not a given of finite type")
    verdict("(steps 7 (obligation k (c) (v c) (v c) (b true)) (defs) (consts) (laws) (proof (have h (v c) (hyp when) (hyp h))))") => Result.Ok("k")
    verdict("(steps 7 (obligation k (c d) (v c) (v c) (b true)) (defs) (consts) (laws) (proof (have h (v d) (hyp when) (hyp h))))") => Result.Err("step proof: the proof of h ends at a different equation than its fact")
    verdict("(steps 7 (obligation k (c) (v c) (v c) (b true)) (defs) (consts) (laws) (proof (have h (v c) (hyp h) (hyp h))))") => Result.Err("step proof/have.h: hypothesis h is not in scope")
    verdict("(steps 7 (obligation k ((n (tint))) (none) (op <= (v n) (v n)) (b true)) (defs) (consts) (laws) (proof (intinduct n (op <= (v n) (v n)) (b true) g (compute (b true) (b true)) () () ih (hyp ih))))") => Result.Err("step proof/base: the case proves a different equation")
    verdict("(steps 7 (obligation k (n) (none) (v n) (v n)) (defs) (consts) (laws) (proof (intinduct n (v n) (v n) g (refl (v n)) () () ih (refl (v n)))))") => Result.Err("step proof: n is not a given of type Int")
    verdict("(steps 7 (obligation k ((n (tint))) (op >= (v n) (i 0)) (call f (v n)) (call f (v n))) (defs) (consts) (laws) (proof (intinduct n (call f (v n)) (call f (v n)) g (refl (call f (v n))) (when) ((linear (op >= (op - (v n) (i 1)) (i 0)) true (g) (1 1))) ih (hyp ih))))") => Result.Err("step proof/step: the case proves a different equation")
    verdict("(steps 7 (obligation k ((n (tint))) (op >= (v n) (i 0)) (call f (v n)) (call f (v n))) (defs) (consts) (laws) (proof (intinduct n (call f (v n)) (call f (v n)) g (refl (call f (v n))) (when) ((linear (op >= (op - (v n) (i 1)) (i 0)) true (g) (1 1))) ih (refl (call f (v n))))))") => Result.Ok("k")
    verdict("(steps 7 (obligation k ((n (tint))) (op >= (v n) (i 0)) (call f (v n)) (call f (v n))) (defs) (consts) (laws) (proof (intinduct n (call f (v n)) (call f (v n)) g (refl (call f (v n))) (when) ((hyp when)) ih (refl (call f (v n))))))") => Result.Err("step proof/carry.when: the case proves a different equation")
    verdict("(steps 7 (obligation k ((a (tint)) b) (op == (v a) (v b)) (v a) (v b)) (defs) (consts) (laws) (proof (rule int.eq.of_beq ((a (v a)) (b (v b))) (hyp when))))") => Result.Ok("k")
    verdict("(steps 6 (obligation k () (none) (i 1) (i 1)) (defs) (consts) (laws) (proof (refl (i 1))))") => Result.Err("unsupported step format version 6")
    verdict("(steps 3)") => Result.Err("unsupported step format version 3")
