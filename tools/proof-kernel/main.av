module ProofKernel
    intent =
        "Replays proof-step scripts written by the Aver compiler and checks them without Lean."
        "Usage: aver run tools/proof-kernel/main.av --module-root tools/proof-kernel -- <script.steps>…"
        "Prints one line per script, `accepted <law>` or `refused <file>: step <path>: <reason>`,"
        "and fails when any script is refused. Lean decides proof credit; this replayer is the seed"
        "of a kernel written in Aver and is not trusted for verdicts yet."
    depends [Kernel.Verdict]
    effects [Args.get, Console.print, Disk.readText]

fn checkFiles(paths: List<String>, refused: Int) -> Int
    ? "Check every file, print a line for each, count the refusals."
    ! [Console.print, Disk.readText]
    match paths
        [] -> refused
        [path, ..rest] -> checkFiles(rest, refused + checkFile(path))

fn checkFile(path: String) -> Int
    ? "Check one file: 0 when accepted, 1 when refused or unreadable."
    ! [Console.print, Disk.readText]
    match Disk.readText(path)
        Result.Err(e) -> report("refused {path}: cannot read: {e}", 1)
        Result.Ok(text) -> match Kernel.Verdict.verdict(text)
            Result.Ok(key) -> report("accepted {key}", 0)
            Result.Err(why) -> report("refused {path}: {why}", 1)

fn report(line: String, count: Int) -> Int
    ? "Print a verdict line and pass its count on."
    ! [Console.print]
    Console.print(line)
    count

fn main() -> Result<Unit, String>
    ? "Check the scripts named on the command line."
    ! [Args.get, Console.print, Disk.readText]
    refused = checkFiles(Args.get(), 0)
    match refused == 0
        true -> Result.Ok(Unit)
        false -> Result.Err("{refused} script(s) refused")
