module VerifyLaw
    intent =
        "Seed corpus entry focused on the verify-law shape: `verify fn"
        "law lawName` with multiple `given` lines, an optional `when`"
        "guard, and the `=> expected` outcome line. Exercises the part"
        "of the grammar the property-test workflow most depends on."
    exposes [add, abs]
    effects []

fn add(a: Int, b: Int) -> Int
    ? "Plain Int addition — anchor for two commutativity laws."
    a + b

verify add
    add(1, 2)   => 3
    add(0, 0)   => 0
    add(-1, 1)  => 0

verify add law commutative
    given a: Int = [0, 1, -3, 100]
    given b: Int = [0, 1, -3, 100]
    add(a, b) => add(b, a)

verify add law associative
    given a: Int = [0, 1, -3]
    given b: Int = [0, 1, -3]
    given c: Int = [0, 1, -3]
    add(add(a, b), c) => add(a, add(b, c))

fn abs(x: Int) -> Int
    ? "Absolute value — covered by a verify law with a `when` guard so the seed exercises that clause."
    match x < 0
        true  -> -x
        false -> x

verify abs
    abs(0)  => 0
    abs(-7) => 7

verify abs law absIsNonNegative
    given x: Int = [-100, -1, 0, 1, 100]
    when x > -2147483648
    abs(x) >= 0 => true
