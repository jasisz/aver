module Types
    intent =
        "Shared data types for Braille Doom: the level grid, player, enemies,"
        "game state, ray hits, and small helpers on them."
    depends []
    effects []

type WallType
    Stone
    Brick
    Metal

type Face
    EastWest
    NorthSouth

type EnemyKind
    Imp
    Demon
    Ghost

type Status
    Playing
    Dead
    Cleared

record Grid
    width: Int
    height: Int
    cells: Vector<Int>

record Enemy
    x: Float
    y: Float
    kind: EnemyKind
    hp: Int
    cooldown: Int
    alert: Int
    seenX: Float
    seenY: Float

record Player
    x: Float
    y: Float
    angle: Float
    hp: Int

record GameState
    grid: Grid
    player: Player
    enemies: List<Enemy>
    seed: Int
    messages: List<String>
    status: Status
    turnCount: Int

record RayHit
    dist: Float
    face: Face
    wallType: WallType
    u: Float

fn maxHp() -> Int
    ? "Player health at the start of a level"
    100

verify maxHp
    maxHp() => 100

fn mkPlayer(px: Float, py: Float) -> Player
    ? "Create a player at a position, facing east, at full health"
    Player(x = px, y = py, angle = 0.0, hp = maxHp())

verify mkPlayer
    mkPlayer(5.0, 5.0).hp => 100
    mkPlayer(3.0, 4.0).x => 3.0

fn mkEnemy(ex: Float, ey: Float, kind: EnemyKind, hp: Int) -> Enemy
    ? "Create an idle enemy: it has not noticed the player yet"
    Enemy(x = ex, y = ey, kind = kind, hp = hp, cooldown = 0, alert = 0, seenX = ex, seenY = ey)

verify mkEnemy
    mkEnemy(2.0, 3.0, EnemyKind.Imp, 3).hp => 3
    mkEnemy(2.0, 3.0, EnemyKind.Demon, 8).kind => EnemyKind.Demon
    mkEnemy(2.0, 3.0, EnemyKind.Demon, 8).alert => 0

fn enemyName(kind: EnemyKind) -> String
    ? "Name of an enemy kind as used in messages"
    match kind
        EnemyKind.Imp -> "imp"
        EnemyKind.Demon -> "demon"
        EnemyKind.Ghost -> "ghost"

verify enemyName
    enemyName(EnemyKind.Imp) => "imp"
    enemyName(EnemyKind.Demon) => "demon"
    enemyName(EnemyKind.Ghost) => "ghost"

fn enemyColor(kind: EnemyKind) -> String
    ? "Terminal color for enemy kind"
    match kind
        EnemyKind.Imp -> "red"
        EnemyKind.Demon -> "magenta"
        EnemyKind.Ghost -> "white"

verify enemyColor
    enemyColor(EnemyKind.Imp) => "red"
    enemyColor(EnemyKind.Demon) => "magenta"
    enemyColor(EnemyKind.Ghost) => "white"

fn enemyMaxHp(kind: EnemyKind) -> Int
    ? "Default HP for enemy kind"
    match kind
        EnemyKind.Imp -> 3
        EnemyKind.Demon -> 8
        EnemyKind.Ghost -> 4

verify enemyMaxHp
    enemyMaxHp(EnemyKind.Imp) => 3
    enemyMaxHp(EnemyKind.Demon) => 8
    enemyMaxHp(EnemyKind.Ghost) => 4

fn dirArrow(angle: Float) -> String
    ? "Arrow for the minimap: one of 8 directions, the map's y axis pointing down"
    match Int.mod(Float.round(angle * 4.0 / Float.pi()), 8)
        0 -> "→"
        1 -> "↘"
        2 -> "↓"
        3 -> "↙"
        4 -> "←"
        5 -> "↖"
        6 -> "↑"
        _ -> "↗"

verify dirArrow
    dirArrow(0.0) => "→"
    dirArrow(Float.pi() / 2.0) => "↓"
    dirArrow(Float.pi()) => "←"
    dirArrow(Float.pi() * 1.5) => "↑"
    dirArrow(Float.pi() / 4.0) => "↘"
    dirArrow(Float.pi() * 1.75) => "↗"
    dirArrow(Float.pi() * 1.99) => "→"
