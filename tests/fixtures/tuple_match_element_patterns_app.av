module Main
    intent = "A match on a tuple literal whose arms carry list, literal, Option and user constructor patterns in the tuple's elements: a queue and a count, a flag and a count, a next task and a count, an operator and its argument, a shape and its tag."
    effects [Console.print]

fn queue(tasks: List<Int>, running: Int) -> String
    ? "What the queue and the count say together."
    match (tasks, running)
        ([], 0) -> "idle"
        ([next, ..rest], n) -> "next {next}, {List.len(rest)} queued, {n} running"
        (_, 1) -> "one running"
        _ -> "draining"

fn flag(armed: Bool, n: Int) -> String
    ? "What the flag and the count say together."
    match (armed, n)
        (true, 0) -> "armed idle"
        (false, _) -> "disarmed"
        _ -> "armed busy"

fn pick(next: Option<Int>, n: Int) -> String
    ? "What the next task and the count say together."
    match (next, n)
        (Option.Some(task), 0) -> "start {task}"
        (Option.None, _) -> "nothing"
        (Option.Some(_), _) -> "wait"

type Shape
    Circle(Int)
    Square(Int)

fn operator(op: String, arg: Option<String>) -> String
    ? "What an operator and its argument say together."
    match (op, arg)
        ("==", Option.Some(s)) -> "equals {s}"
        ("!=", Option.None) -> "differs from nothing"
        _ -> "unknown"

fn depth(p: Tuple<Int, Tuple<String, Bool>>) -> String
    ? "A string literal one tuple deeper, beside an Int literal."
    match p
        (0, ("zero", true)) -> "zero and true"
        (n, ("zero", _)) -> "zero at {n}"
        (_, (s, _)) -> s

fn shaped(shape: Shape, tag: String) -> String
    ? "A string literal beside a user constructor."
    match (shape, tag)
        (Shape.Circle(r), "big") -> "big circle {r}"
        (Shape.Circle(_), _) -> "circle"
        (Shape.Square(_), "big") -> "big square"
        (Shape.Square(_), _) -> "square"

fn both(a: Int, b: Int) -> String
    ? "What two counts say together, with no arm that tests an element."
    match (a, b)
        (x, y) -> "{x} and {y}"
        _ -> "never"

fn main() -> Unit
    ? "Prints every arm of each shape."
    ! [Console.print]
    Console.print(queue([], 0))
    Console.print(queue([1, 2, 3], 2))
    Console.print(queue([], 1))
    Console.print(queue([], 2))
    Console.print(flag(true, 0))
    Console.print(flag(false, 5))
    Console.print(flag(true, 5))
    Console.print(pick(Option.Some(7), 0))
    Console.print(pick(Option.None, 3))
    Console.print(pick(Option.Some(7), 3))
    Console.print(both(4, 5))
    Console.print(operator("==", Option.Some("x")))
    Console.print(operator("!=", Option.None))
    Console.print(operator("!=", Option.Some("y")))
    Console.print(depth((0, ("zero", true))))
    Console.print(depth((5, ("zero", false))))
    Console.print(depth((5, ("one", false))))
    Console.print(shaped(Shape.Circle(3), "big"))
    Console.print(shaped(Shape.Circle(3), "small"))
    Console.print(shaped(Shape.Square(2), "big"))
    Console.print(shaped(Shape.Square(2), "x"))
