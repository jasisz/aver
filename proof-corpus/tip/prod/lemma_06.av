module Lemma06
    intent =
        "TIP prod lemma_06: drop (S v) (drop w (drop x (cons y z))) = drop v (drop w (drop x z))."
    effects []

type Nat
    Z
    S(Nat)

fn drop(x: Nat, y: List<Int>) -> List<Int>
    match x
        Nat.Z -> y
        Nat.S(z) -> match y
            [] -> []
            [x2, ..x3] -> drop(z, x3)

verify drop law dropDropDrop
    given v: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given w: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.Z]
    given x: Nat = [Nat.Z, Nat.Z, Nat.S(Nat.Z)]
    given y: Int = [1, 2, 3]
    given z: List<Int> = [[], [1], [1, 2, 3]]
    drop(Nat.S(v), drop(w, drop(x, List.concat([y], z)))) => drop(v, drop(w, drop(x, z)))
