module Rle
    intent =
        "Run-length encoding: the simplest lossless compression algorithm."
        "Consecutive identical elements become (element, count) pairs."
        "Demonstrates fold with record accumulator and law roundtrip."

record Run
    char: String
    count: Int

record RleAcc
    runs: List<Run>
    current: String
    count: Int

fn encodeFold(acc: RleAcc, char: String) -> RleAcc
    ? "Accumulator step: extends current run or starts a new one."
    match acc.count == 0
        true -> RleAcc(runs = acc.runs, current = char, count = 1)
        false -> match acc.current == char
            true -> RleAcc(runs = acc.runs, current = acc.current, count = acc.count + 1)
            false -> RleAcc(runs = List.append(acc.runs, Run(char = acc.current, count = acc.count)), current = char, count = 1)

verify encodeFold
    encodeFold(RleAcc(runs = [], current = "", count = 0), "a") => RleAcc(runs = [], current = "a", count = 1)
    encodeFold(RleAcc(runs = [], current = "a", count = 1), "a") => RleAcc(runs = [], current = "a", count = 2)
    encodeFold(RleAcc(runs = [], current = "a", count = 2), "b") => RleAcc(runs = [Run(char = "a", count = 2)], current = "b", count = 1)

fn flushAcc(acc: RleAcc) -> List<Run>
    ? "Flushes the final run from the accumulator."
    match acc.count == 0
        true -> acc.runs
        false -> List.append(acc.runs, Run(char = acc.current, count = acc.count))

verify flushAcc
    flushAcc(RleAcc(runs = [], current = "", count = 0)) => []
    flushAcc(RleAcc(runs = [Run(char = "a", count = 2)], current = "b", count = 1)) => [Run(char = "a", count = 2), Run(char = "b", count = 1)]

fn encodeLoop(chars: List<String>, acc: RleAcc) -> List<Run>
    ? "Walks characters recursively, threading the run accumulator."
    match chars
        [] -> flushAcc(acc)
        [char, ..rest] -> encodeLoop(rest, encodeFold(acc, char))

verify encodeLoop
    encodeLoop([], RleAcc(runs = [], current = "", count = 0)) => []
    encodeLoop(["a", "a", "b"], RleAcc(runs = [], current = "", count = 0)) => [Run(char = "a", count = 2), Run(char = "b", count = 1)]

fn encode(xs: List<String>) -> List<Run>
    ? "Compresses a list of single characters into run-length pairs with recursive traversal."
    encodeLoop(xs, RleAcc(runs = [], current = "", count = 0))

verify encode
    encode([]) => []
    encode(["a"]) => [Run(char = "a", count = 1)]
    encode(["a", "a", "a"]) => [Run(char = "a", count = 3)]
    encode(["a", "a", "b", "c", "c"]) => [Run(char = "a", count = 2), Run(char = "b", count = 1), Run(char = "c", count = 2)]

fn repeat(char: String, n: Int) -> List<String>
    ? "Produces a list of n copies of char. Non-positive counts yield []."
    match n <= 0
        true -> []
        false -> List.append(repeat(char, n - 1), char)

verify repeat
    repeat("x", -1) => []
    repeat("x", 0) => []
    repeat("x", 1) => ["x"]
    repeat("x", 3) => ["x", "x", "x"]

fn expandRun(run: Run) -> List<String>
    ? "Expands a single run back into repeated characters."
    repeat(run.char, run.count)

verify expandRun
    expandRun(Run(char = "x", count = 0)) => []
    expandRun(Run(char = "x", count = 3)) => ["x", "x", "x"]

fn decode(runs: List<Run>) -> List<String>
    ? "Decompresses run-length pairs back into a character list."
    match runs
        [] -> []
        [run, ..rest] -> List.concat(expandRun(run), decode(rest))

verify decode
    decode([]) => []
    decode([Run(char = "a", count = 3)]) => ["a", "a", "a"]
    decode([Run(char = "a", count = 2), Run(char = "b", count = 1)]) => ["a", "a", "b"]

verify encode law roundtrip
    given xs: List<String> = [[], ["a"], ["a", "a", "b"], ["a", "b", "b", "a"]]
    decode(encode(xs)) => xs

fn encodeString(s: String) -> List<Run>
    ? "Compresses a string into run-length pairs."
    encode(String.chars(s))

fn decodeString(runs: List<Run>) -> String
    ? "Decompresses run-length pairs back into a string."
    String.join(decode(runs), "")

verify decodeString
    decodeString([]) => ""
    decodeString([Run(char = "a", count = 3), Run(char = "b", count = 2)]) => "aaabb"

fn showRun(run: Run) -> String
    ? "Formats a single run as char followed by count."
    "{run.char}{run.count}"

verify showRun
    showRun(Run(char = "a", count = 3)) => "a3"
    showRun(Run(char = "z", count = 1)) => "z1"

fn showRuns(runs: List<Run>) -> String
    ? "Formats encoded runs as a compact string like a3b2c1."
    match runs
        [] -> ""
        [run, ..rest] -> "{showRun(run)}{showRuns(rest)}"

verify showRuns
    showRuns(encodeString("aaabbc")) => "a3b2c1"
    showRuns(encodeString("x")) => "x1"

verify encodeString law string_roundtrip
    given s: String = ["", "a", "aab", "aaabbbcc", "abcd"]
    decodeString(encodeString(s)) => s

fn main()
    ! [Console.print]
    text = "aaabbbccdddddd"
    runs = encodeString(text)
    Console.print("Input:    {text}")
    Console.print("Encoded:  {showRuns(runs)}")
    Console.print("Decoded:  {decodeString(runs)}")
    Console.print("Runs:     {List.len(runs)}")
    Console.print("{String.len(text)} chars → {List.len(runs)} runs")
