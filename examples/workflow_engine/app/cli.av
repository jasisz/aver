    ? "Parses archive_task."
    taskId = field(parts, 1, "task_id")?
    Result.Ok(Input.RunCommand(Command.ArchiveTask(taskId)))

verify parseArchiveTask
    parseArchiveTask(["archive_task", "t1"]) => Result.Ok(Input.RunCommand(Command.ArchiveTask("t1")))

fn parseListTasks(parts: List<String>) -> Result<Input, String>
    ? "Parses list_tasks."
    Result.Ok(Input.RunQuery(Query.ListTasks(optionalField(parts, 1))))

verify parseListTasks
    parseListTasks(["list_tasks"]) => Result.Ok(Input.RunQuery(Query.ListTasks(Option.None)))
    parseListTasks(["list_tasks", "alpha"]) => Result.Ok(Input.RunQuery(Query.ListTasks(Option.Some("alpha"))))

