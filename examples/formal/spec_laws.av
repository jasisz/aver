module SpecLaws
    intent =
        "Demonstrates implementation-vs-spec laws in Aver."
        "Shows `verify foo law fooSpec` as a direct path from executable samples to Lean proof artifacts."

fn absVal(x: Int) -> Int
    ? "Returns the absolute value of x."
    match x < 0
        true -> 0 - x
        false -> x

verify absVal
    absVal(-2) => 2
    absVal(0) => 0
    absVal(3) => 3

verify absVal law absValSpec
    given x: Int = -3..3
    absVal(x) => absValSpec(x)

fn absValSpec(x: Int) -> Int
    ? "Simple spec function for absVal."
    match x < 0
        true -> 0 - x
        false -> x

fn clampNonNegative(x: Int) -> Int
    ? "Clamps negative integers to zero."
    match x < 0
        true -> 0
        false -> x

verify clampNonNegative
    clampNonNegative(-2) => 0
    clampNonNegative(0) => 0
    clampNonNegative(5) => 5

verify clampNonNegative law clampNonNegativeSpec
    given x: Int = -3..3
    clampNonNegative(x) => clampNonNegativeSpec(x)

fn clampNonNegativeSpec(x: Int) -> Int
    ? "Simple spec function for clampNonNegative."
    match x < 0
        true -> 0
        false -> x

fn main() -> Unit
    ! [Console.print]
    Console.print("SpecLaws: run `aver verify examples/formal/spec_laws.av`")
    Console.print("SpecLaws: proof with `aver proof examples/formal/spec_laws.av --verify-mode auto`")
