module Main
    intent = "A process calling a capability whose module lives in a subdirectory."
    depends [Lib.Clock, Lib.Ticks]
    effects [Console.print, Lib.Clock.tick]

fn ticker() -> Unit
    ? "Three ticks."
    ! [Console.print, Lib.Clock.tick]
    match Lib.Clock.tick() >= 3
        true -> Console.print("ticked")
        false -> ticker()
