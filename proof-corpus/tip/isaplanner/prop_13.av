module Prop13
    intent =
        "TIP isaplanner prop_13: drop (S n) (cons x xs) = drop n xs."
    effects []

type Nat
    Z
    S(Nat)

fn drop(n: Nat, xs: List<Int>) -> List<Int>
    match n
        Nat.Z -> xs
        Nat.S(z) -> match xs
            [] -> []
            [x2, ..x3] -> drop(z, x3)

verify drop law dropSuccCons
    given n: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given x: Int = [0, 1, 2]
    given xs: List<Int> = [[], [1], [1, 2, 3]]
    drop(Nat.S(n), List.concat([x], xs)) => drop(n, xs)
