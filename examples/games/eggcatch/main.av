module Main
    intent =
        "Egg Catch shell. Every effect the game performs lives in this file and"
        "is named in a signature: a non-blocking key read (Terminal.readKey), the"
        "terminal clear/cursor moves, and the tick clock (Time.sleep). All game"
        "logic is the pure Core engine — this shell only threads GameState through"
        "the tick loop. Deterministic replay needs no shell code: the toolchain's"
        "`aver run --record` / `aver replay` cover runs, and the engine-level"
        "property is Core.replay (a left fold of the pure step, with a proven"
        "law). The pure/effectful boundary is exactly the module boundary:"
        "Core has effects [], Main owns them all."
    depends [Core]
    effects [Args, Console, Terminal, Time]

fn main() -> Result<Unit, String>
    ? "Entry point: dispatch on CLI arguments (interactive play or file replay)."
    ! [
        Args.get,
        Console.print,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.sleep,
    ]
    dispatch(Args.get())

fn dispatch(args: List<String>) -> Result<Unit, String>
    ? "Route CLI args. No args or `<seed> [mode]` starts interactive play;"
      "`replay <seed> <mode> <path>` folds recorded keys through the pure engine."
    ! [
        Console.print,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.sleep,
    ]
    match args
        [] -> runInteractive(1, Core.Mode.ModeA)
        [head, ..rest] -> dispatchHead(head, rest)

fn dispatchHead(head: String, rest: List<String>) -> Result<Unit, String>
    ? "First argument selects the command: `replay` reads a file, anything else"
      "is treated as the seed for interactive play."
    ! [
        Console.print,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.sleep,
    ]
    match head
        "replay" -> Result.Ok(Console.print("Use the toolchain instead: `aver run --record` captures a run and `aver replay` re-plays it deterministically; the engine-level property (replay = a left fold of the pure `step`) is Core.replay with its proven leftFold law."))
        _ -> dispatchPlay(head, rest)

fn dispatchPlay(seedStr: String, rest: List<String>) -> Result<Unit, String>
    ? "Interactive play: seed from the first arg, mode from the second if present."
    ! [
        Console.print,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.sleep,
    ]
    match rest
        [] -> runInteractive(Core.parseSeed(seedStr), Core.Mode.ModeA)
        [modeStr, ..more] -> runInteractive(Core.parseSeed(seedStr), Core.parseMode(modeStr))

fn runInteractive(seed: Int, mode: Core.Mode) -> Result<Unit, String>
    ? "Set the terminal to raw mode, run the tick loop to game over, restore."
    ! [
        Console.print,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.sleep,
    ]
    Terminal.enableRawMode()?
    Terminal.hideCursor()?
    result = loop(Core.initialState(seed, mode))?
    Terminal.showCursor()?
    Terminal.disableRawMode()?
    Terminal.clear()?
    Console.print("Game over — final score: {String.fromInt(Core.finalScore(result))}")
    Result.Ok(Unit)

fn loop(gs: Core.GameState) -> Result<Core.GameState, String>
    ? "Draw the frame; stop at game over, otherwise wait one tick and advance."
    ! [
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.sleep,
    ]
    draw(gs)?
    match Core.isOver(gs)
        true -> Result.Ok(gs)
        false -> advance(gs)

fn advance(gs: Core.GameState) -> Result<Core.GameState, String>
    ? "One world tick, sliced: keys are polled every ~33ms and move the fox"
      "instantly (with a redraw), while the egg world advances only when the"
      "state's full tempo has elapsed. Splitting the two clocks is what makes"
      "the controls feel immediate on a 600ms tick."
    ! [
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.sleep,
    ]
    pollSlices(gs, Int.div(Core.tickDelay(gs), 33))

fn pollSlices(gs: Core.GameState, left: Int) -> Result<Core.GameState, String>
    ? "Poll-and-apply loop between world ticks: sleep one slice, apply any"
      "pressed key without ticking, redraw; when the slices run out, advance"
      "the world one tick and continue. Esc quits."
    ! [
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.sleep,
    ]
    match left <= 0
        true -> loop(Core.step(gs, Core.Input.Tick))
        false -> pollOne(gs, left, keyString(Terminal.readKey()?))

fn pollOne(gs: Core.GameState, left: Int, key: String) -> Result<Core.GameState, String>
    ? "Handle one polled key: esc quits, no key just sleeps the slice, a game"
      "key moves the fox instantly and redraws before the world catches up."
    ! [
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.sleep,
    ]
    match key
        "esc" -> Result.Ok(gs)
        "" -> sleepSlice(gs, left)
        _ -> applyAndRedraw(Core.applyToState(gs, Core.keyToInput(key)), left)

fn sleepSlice(gs: Core.GameState, left: Int) -> Result<Core.GameState, String>
    ? "Sleep one 33ms slice and keep polling."
    ! [
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.sleep,
    ]
    Time.sleep(33)
    pollSlices(gs, left - 1)

fn applyAndRedraw(gs: Core.GameState, left: Int) -> Result<Core.GameState, String>
    ? "The fox moved between ticks: show it immediately, then keep polling"
      "the remaining slices of this world tick."
    ! [
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.sleep,
    ]
    draw(gs)?
    pollSlices(gs, left - 1)

fn keyString(k: Option<String>) -> String
    ? "The polled key as a string, or empty when no key was pressed this tick."
    match k
        Option.Some(s) -> s
        Option.None -> ""

verify keyString
    keyString(Option.Some("q")) => "q"
    keyString(Option.None) => ""

fn draw(gs: Core.GameState) -> Result<Unit, String>
    ? "Clear and paint the fixed-size frame, one Core.render row per terminal row."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print]
    Terminal.clear()?
    drawRows(String.split(Core.render(gs), "\n"), 0)?
    Terminal.flush()?
    Result.Ok(Unit)

fn drawRows(rows: List<String>, y: Int) -> Result<Unit, String>
    ? "Paint each rendered row at its own terminal line."
    ! [Terminal.moveTo, Terminal.print]
    match rows
        [] -> Result.Ok(Unit)
        [row, ..rest] -> drawRow(row, rest, y)

fn drawRow(row: String, rest: List<String>, y: Int) -> Result<Unit, String>
    ? "Paint one row at column 0, line y, then continue with the rest."
    ! [Terminal.moveTo, Terminal.print]
    Terminal.moveTo(0, y)?
    Terminal.print(row)?
    drawRows(rest, y + 1)
