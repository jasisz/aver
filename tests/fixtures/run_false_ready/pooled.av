module Pooled
    intent = "Fixture answer module: each score is a Validation job this module begins itself. The first ask begins the job and takes it at once, which is exactly what a wait is allowed to report ready before the job has finished; that take finds nothing, the handle stays in the state, and the request waits on the job."
    depends [Pool, Validation, Wait, Work]
    exposes [State, fresh, scored, early, score]
    effects [Validation.begin, Validation.take]
    answers [Pool]

record State
    jobs: Map<Int, Work.Job>
    early: Int

fn fresh() -> State
    ? "No job running, and no early take seen yet."
    State(jobs = {}, early = 0)

fn scored(state: State, task: Int) -> Tuple<State, Result<Result<Int, String>, Run.Wake>>
    ? "The first ask begins the job and takes it at once; every ask takes it again. A take that finds the job still running keeps the handle and waits on the job."
    ! [Validation.begin, Validation.take]
    match Map.get(state.jobs, task)
        Option.Some(job) -> taken(state, task, job)
        Option.None -> match Validation.begin(task)
            Result.Err(reason) -> (state, Result.Ok(Result.Err(reason)))
            Result.Ok(job) -> taken(State.update(state, jobs = Map.set(state.jobs, task, job)), task, job)

fn taken(state: State, task: Int, job: Work.Job) -> Tuple<State, Result<Result<Int, String>, Run.Wake>>
    ? "One take: nothing yet keeps the handle and waits on the job, a score or a failure answers and lets the handle go."
    ! [Validation.take]
    match Validation.take(job)
        Result.Err(reason) -> (State.update(state, jobs = Map.remove(state.jobs, task)), Result.Ok(Result.Err(reason)))
        Result.Ok(found) -> match found
            Option.None -> (State.update(state, early = state.early + 1), Result.Err(Run.Wake.Until([Wait.Item.Job(job)], Option.None)))
            Option.Some(points) -> (State.update(state, jobs = Map.remove(state.jobs, task)), Result.Ok(Result.Ok(points)))

fn early(state: State) -> Tuple<State, Result<Int, Run.Wake>>
    ? "How many takes found their job still running."
    (state, Result.Ok(state.early))

verify early
    early(fresh()) => (fresh(), Result.Ok(0))

fn spin(n: Int, acc: Int) -> Int
    ? "Counts n down, carrying acc; this is the work a job does."
    match n < 1
        true -> acc
        false -> spin(n - 1, acc)

verify spin
    spin(0, 3) => 3
    spin(2, 3) => 3

fn score(task: Int) -> Int
    ? "What one job computes off the turn. Slow on purpose: a take taken right after the job began must find it still running."
    spin(5000000, task + 1)

verify score
    score(0) => 1
