module Board
    intent =
        "Board representation and manipulation for Tetris."
        "Immutable 2D grid as List<List<Option<PieceKind>>>, with cell access,"
        "line clearing, and row counting."
    depends []

type PieceKind
    I
    O
    T
    S
    Z
    J
    L

record Point
    x: Int
    y: Int

fn pt(x: Int, y: Int) -> Point
    ? "Shorthand Point constructor"
    Point(x = x, y = y)

verify pt
    pt(3, 4).x => 3
    pt(3, 4).y => 4

fn emptyRow() -> List<Option<PieceKind>>
    ? "A row of 10 Nones"
    [Option.None, Option.None, Option.None, Option.None, Option.None, Option.None, Option.None, Option.None, Option.None, Option.None]

verify emptyRow
    List.len(emptyRow()) => 10

fn buildBoard(n: Int) -> List<List<Option<PieceKind>>>
    ? "Build n empty rows"
    match n == 0
        true -> []
        false -> List.prepend(emptyRow(), buildBoard(n - 1))

verify buildBoard
    List.len(buildBoard(3)) => 3

fn emptyBoard() -> List<List<Option<PieceKind>>>
    ? "Standard 20-row empty board"
    buildBoard(20)

verify emptyBoard
    List.len(emptyBoard()) => 20

fn getCell(board: List<List<Option<PieceKind>>>, x: Int, y: Int) -> Option<PieceKind>
    ? "Get cell value at (x,y), Option.None if out of bounds"
    match board
        [] -> Option.None
        [row, ..rest] -> match y == 0
            true -> getCellInRow(row, x)
            false -> getCell(rest, x, y - 1)

verify getCell
    getCell(emptyBoard(), 0, 0) => Option.None
    getCell(emptyBoard(), 9, 19) => Option.None

fn getCellInRow(row: List<Option<PieceKind>>, x: Int) -> Option<PieceKind>
    ? "Get cell value from one row, Option.None if out of bounds or empty."
    match row
        [] -> Option.None
        [cell, ..rest] -> match x == 0
            true -> cell
            false -> getCellInRow(rest, x - 1)

verify getCellInRow
    getCellInRow([Option.Some(PieceKind.I), Option.None], 0) => Option.Some(PieceKind.I)
    getCellInRow([Option.Some(PieceKind.I), Option.None], 1) => Option.None

fn setCellCols(r: List<Option<PieceKind>>, x: Int, val: Option<PieceKind>) -> List<Option<PieceKind>>
    ? "Rebuild a row replacing column x"
    match r
        [] -> []
        [cell, ..rest] -> match x == 0
            true -> List.prepend(val, rest)
            false -> List.prepend(cell, setCellCols(rest, x - 1, val))

verify setCellCols
    List.len(setCellCols(emptyRow(), 3, Option.Some(PieceKind.T))) => 10

fn setCellRows(board: List<List<Option<PieceKind>>>, x: Int, y: Int, val: Option<PieceKind>) -> List<List<Option<PieceKind>>>
    ? "Rebuild rows replacing cell at (x,y)"
    match board
        [] -> []
        [row, ..rest] -> match y == 0
            true -> List.prepend(setCellCols(row, x, val), rest)
            false -> List.prepend(row, setCellRows(rest, x, y - 1, val))

verify setCellRows
    List.len(setCellRows(emptyBoard(), 3, 5, Option.Some(PieceKind.T))) => 20

fn setCell(board: List<List<Option<PieceKind>>>, x: Int, y: Int, val: PieceKind) -> List<List<Option<PieceKind>>>
    ? "Return board with cell (x,y) set to Option.Some(val)"
    setCellRows(board, x, y, Option.Some(val))

verify setCell
    getCell(setCell(emptyBoard(), 3, 5, PieceKind.T), 3, 5) => Option.Some(PieceKind.T)
    getCell(setCell(emptyBoard(), 3, 5, PieceKind.T), 4, 5) => Option.None

fn isFullRow(row: List<Option<PieceKind>>) -> Bool
    ? "True if row has no empty cells"
    match row
        [] -> true
        [cell, ..rest] -> match cell
            Option.None -> false
            Option.Some(_) -> isFullRow(rest)

verify isFullRow
    isFullRow([Option.Some(PieceKind.I), Option.Some(PieceKind.O), Option.Some(PieceKind.T), Option.Some(PieceKind.S), Option.Some(PieceKind.Z), Option.Some(PieceKind.J), Option.Some(PieceKind.L), Option.Some(PieceKind.I), Option.Some(PieceKind.O), Option.Some(PieceKind.T)]) => true
    isFullRow([Option.Some(PieceKind.I), Option.None, Option.Some(PieceKind.T), Option.Some(PieceKind.S), Option.Some(PieceKind.Z), Option.Some(PieceKind.J), Option.Some(PieceKind.L), Option.Some(PieceKind.I), Option.Some(PieceKind.O), Option.Some(PieceKind.T)]) => false
    isFullRow(emptyRow()) => false

fn filterRows(board: List<List<Option<PieceKind>>>) -> List<List<Option<PieceKind>>>
    ? "Keep only non-full rows"
    match board
        [] -> []
        [row, ..rest] -> match isFullRow(row)
            true -> filterRows(rest)
            false -> List.prepend(row, filterRows(rest))

verify filterRows
    List.len(filterRows(emptyBoard())) => 20

fn prependEmpty(board: List<List<Option<PieceKind>>>, n: Int) -> List<List<Option<PieceKind>>>
    ? "Prepend n empty rows"
    match n == 0
        true -> board
        false -> prependEmpty(List.prepend(emptyRow(), board), n - 1)

verify prependEmpty
    List.len(prependEmpty([], 3)) => 3

fn clearLines(board: List<List<Option<PieceKind>>>) -> List<List<Option<PieceKind>>>
    ? "Remove full rows and prepend empty rows at top"
    filtered = filterRows(board)
    prependEmpty(filtered, 20 - List.len(filtered))

verify clearLines
    List.len(clearLines(emptyBoard())) => 20

fn countFullRows(board: List<List<Option<PieceKind>>>) -> Int
    ? "Count full rows in board"
    match board
        [] -> 0
        [row, ..rest] -> match isFullRow(row)
            true -> 1 + countFullRows(rest)
            false -> countFullRows(rest)

verify countFullRows
    countFullRows(emptyBoard()) => 0

fn countCleared(board: List<List<Option<PieceKind>>>) -> Int
    ? "Count full rows in board"
    countFullRows(board)

verify countCleared
    countCleared(emptyBoard()) => 0

fn fullRow() -> List<Option<PieceKind>>
    ? "Test helper: a full row"
    [Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I), Option.Some(PieceKind.I)]

verify fullRow
    isFullRow(fullRow()) => true
