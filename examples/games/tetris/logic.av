module Logic
    intent =
        "Tetris game logic: collision detection, piece movement,"
        "placement, line scoring, and spawn mechanics."
    depends [Board, Pieces]

record GameState
    board: List<List<Option<PieceKind>>>
    piece: Piece
    px: Int
    py: Int
    score: Int
    level: Int
    lines: Int
    gameOver: Bool
    tickMs: Int

fn mkState(board: List<List<Option<PieceKind>>>, piece: Piece, px: Int, py: Int) -> GameState
    ? "Test helper: game state with defaults"
    GameState(board = board, piece = piece, px = px, py = py, score = 0, level = 0, lines = 0, gameOver = false, tickMs = 500)

verify mkState
    mkState(Board.emptyBoard(), Piece(kind = PieceKind.I, rotation = 0), 3, 0).px => 3

fn checkPoints(board: List<List<Option<PieceKind>>>, points: List<Point>, i: Int) -> Bool
    ? "Check each point for collision"
    match i == List.len(points)
        true -> false
        false -> match List.get(points, i)
            Option.Some(p) -> match Bool.or(Bool.or(p.x < 0, p.x > 9), Bool.or(p.y < 0, p.y > 19))
                true -> true
                false -> match Board.getCell(board, p.x, p.y)
                    Option.None -> checkPoints(board, points, i + 1)
                    Option.Some(_) -> true
            Option.None -> false

verify checkPoints
    checkPoints(Board.emptyBoard(), [Board.pt(5, 5)], 0) => false

fn checkCollision(board: List<List<Option<PieceKind>>>, piece: Piece, px: Int, py: Int) -> Bool
    ? "True if piece at (px,py) collides with walls or cells"
    checkPoints(board, Pieces.absolutePoints(piece, px, py), 0)

verify checkCollision
    checkCollision(Board.emptyBoard(), Piece(kind = PieceKind.I, rotation = 0), 3, 0) => false
    checkCollision(Board.emptyBoard(), Piece(kind = PieceKind.I, rotation = 0), 0 - 1, 0) => true
    checkCollision(Board.emptyBoard(), Piece(kind = PieceKind.I, rotation = 0), 8, 0) => true
    checkCollision(Board.emptyBoard(), Piece(kind = PieceKind.I, rotation = 0), 3, 19) => true

fn rotatePiece(state: GameState) -> GameState
    ? "Rotate piece clockwise if no collision"
    match checkCollision(state.board, Piece(kind = state.piece.kind, rotation = Result.withDefault(Int.mod(state.piece.rotation + 1, 4), 0)), state.px, state.py)
        true -> state
        false -> GameState.update(state, piece = Piece(kind = state.piece.kind, rotation = Result.withDefault(Int.mod(state.piece.rotation + 1, 4), 0)))

verify rotatePiece
    rotatePiece(mkState(Board.emptyBoard(), Piece(kind = PieceKind.I, rotation = 0), 3, 0)).piece.rotation => 1
    rotatePiece(mkState(Board.emptyBoard(), Piece(kind = PieceKind.I, rotation = 3), 3, 0)).piece.rotation => 0

fn moveLeft(state: GameState) -> GameState
    ? "Move piece left if no collision"
    match checkCollision(state.board, state.piece, state.px - 1, state.py)
        true -> state
        false -> GameState.update(state, px = state.px - 1)

verify moveLeft
    moveLeft(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 5, 5)).px => 4
    moveLeft(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 0, 5)).px => 0

fn moveRight(state: GameState) -> GameState
    ? "Move piece right if no collision"
    match checkCollision(state.board, state.piece, state.px + 1, state.py)
        true -> state
        false -> GameState.update(state, px = state.px + 1)

verify moveRight
    moveRight(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 5, 5)).px => 6
    moveRight(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 8, 5)).px => 8

fn moveDown(state: GameState) -> GameState
    ? "Move piece down if no collision"
    match checkCollision(state.board, state.piece, state.px, state.py + 1)
        true -> state
        false -> GameState.update(state, py = state.py + 1)

verify moveDown
    moveDown(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 5, 5)).py => 6
    moveDown(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 5, 18)).py => 18

fn placePoints(board: List<List<Option<PieceKind>>>, points: List<Point>, kind: PieceKind, i: Int) -> List<List<Option<PieceKind>>>
    ? "Set each point on the board"
    match i == List.len(points)
        true -> board
        false -> match List.get(points, i)
            Option.Some(p) -> placePoints(Board.setCell(board, p.x, p.y, kind), points, kind, i + 1)
            Option.None -> board

verify placePoints
    Board.getCell(placePoints(Board.emptyBoard(), [Board.pt(3, 3)], PieceKind.Z, 0), 3, 3) => Option.Some(PieceKind.Z)

fn placePiece(board: List<List<Option<PieceKind>>>, piece: Piece, px: Int, py: Int) -> List<List<Option<PieceKind>>>
    ? "Place piece cells on board"
    placePoints(board, Pieces.absolutePoints(piece, px, py), piece.kind, 0)

verify placePiece
    Board.getCell(placePiece(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 4, 4), 4, 4) => Option.Some(PieceKind.O)
    Board.getCell(placePiece(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 4, 4), 5, 4) => Option.Some(PieceKind.O)
    Board.getCell(placePiece(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 4, 4), 3, 4) => Option.None

fn hardDrop(state: GameState) -> GameState
    ? "Drop piece as far down as possible"
    match checkCollision(state.board, state.piece, state.px, state.py + 1)
        true -> state
        false -> hardDrop(GameState.update(state, py = state.py + 1))

verify hardDrop
    hardDrop(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 4, 0)).py => 18

fn computeScore(cleared: Int, level: Int) -> Int
    ? "Score based on lines cleared and level"
    match cleared
        0 -> 0
        1 -> 100 * (level + 1)
        2 -> 300 * (level + 1)
        3 -> 500 * (level + 1)
        _ -> 800 * (level + 1)

verify computeScore
    computeScore(0, 0) => 0
    computeScore(1, 0) => 100
    computeScore(4, 0) => 800
    computeScore(1, 1) => 200
    computeScore(4, 1) => 1600

fn lockSpawn(spawned: GameState) -> GameState
    ? "Check if spawned piece collides (game over)"
    match checkCollision(spawned.board, spawned.piece, spawned.px, spawned.py)
        true -> GameState.update(spawned, gameOver = true)
        false -> spawned

verify lockSpawn
    lockSpawn(mkState(Board.emptyBoard(), Piece(kind = PieceKind.I, rotation = 0), 3, 0)).gameOver => false

fn handleKey(state: GameState, key: String) -> GameState
    ? "Handle a single key press"
    match key
        "left" -> moveLeft(state)
        "right" -> moveRight(state)
        "up" -> rotatePiece(state)
        "down" -> moveDown(state)
        " " -> hardDrop(state)
        "q" -> GameState.update(state, gameOver = true)
        "esc" -> GameState.update(state, gameOver = true)
        _ -> state

verify handleKey
    handleKey(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 5, 5), "left").px => 4
    handleKey(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 5, 5), "right").px => 6
    handleKey(mkState(Board.emptyBoard(), Piece(kind = PieceKind.O, rotation = 0), 5, 5), "q").gameOver => true
