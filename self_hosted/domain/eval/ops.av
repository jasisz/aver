module Ops
    depends [Domain.Ast, Domain.Value]
    intent =
        "Pure value-level operations used by the self-hosted evaluator."
        "Keeps arithmetic, comparison, and Vector.get/set default helpers outside the main eval loop."
    exposes [evalBinopVals, evalCmpVals, evalVectorGetOrIntVals, evalIntModOrIntVals, evalVectorSetMaybeDefault, evalVectorGetMaybeDefault]
    effects []

fn applyBinop(x: Int, y: Int, op: BinOp) -> Result<Val, String>
    ? "Apply a binary operation to two integers."
    match op
        BinOp.OpAdd -> Result.Ok(Val.ValInt(x + y))
        BinOp.OpSub -> Result.Ok(Val.ValInt(x - y))
        BinOp.OpMul -> Result.Ok(Val.ValInt(x * y))
        BinOp.OpDiv -> match y == 0
            true -> Result.Err("division by zero")
            false -> Result.Ok(Val.ValInt(x / y))

verify applyBinop
    applyBinop(3, 4, BinOp.OpAdd) => Result.Ok(Val.ValInt(7))
    applyBinop(10, 3, BinOp.OpSub) => Result.Ok(Val.ValInt(7))
    applyBinop(3, 4, BinOp.OpMul) => Result.Ok(Val.ValInt(12))
    applyBinop(10, 2, BinOp.OpDiv) => Result.Ok(Val.ValInt(5))
    applyBinop(10, 0, BinOp.OpDiv) => Result.Err("division by zero")

fn applyBinopFloat(x: Float, y: Float, op: BinOp) -> Result<Val, String>
    ? "Apply a binary operation to two floats."
    match op
        BinOp.OpAdd -> Result.Ok(Val.ValFloat(x + y))
        BinOp.OpSub -> Result.Ok(Val.ValFloat(x - y))
        BinOp.OpMul -> Result.Ok(Val.ValFloat(x * y))
        BinOp.OpDiv -> match y == 0.0
            true -> Result.Err("float division by zero")
            false -> Result.Ok(Val.ValFloat(x / y))

verify applyBinopFloat
    applyBinopFloat(1.5, 2.5, BinOp.OpAdd) => Result.Ok(Val.ValFloat(4.0))
    applyBinopFloat(5.0, 3.0, BinOp.OpSub) => Result.Ok(Val.ValFloat(2.0))
    applyBinopFloat(2.0, 3.0, BinOp.OpMul) => Result.Ok(Val.ValFloat(6.0))
    applyBinopFloat(10.0, 4.0, BinOp.OpDiv) => Result.Ok(Val.ValFloat(2.5))
    applyBinopFloat(1.0, 0.0, BinOp.OpDiv) => Result.Err("float division by zero")

fn applyCmp(x: Int, y: Int, op: CmpOp) -> Val
    ? "Apply a comparison operation to two integers."
    match op
        CmpOp.CmpEq -> Val.ValBool(x == y)
        CmpOp.CmpNeq -> Val.ValBool(x != y)
        CmpOp.CmpLt -> Val.ValBool(x < y)
        CmpOp.CmpGt -> Val.ValBool(x > y)
        CmpOp.CmpLte -> Val.ValBool(x <= y)
        CmpOp.CmpGte -> Val.ValBool(x >= y)

verify applyCmp
    applyCmp(1, 1, CmpOp.CmpEq) => Val.ValBool(true)
    applyCmp(1, 2, CmpOp.CmpEq) => Val.ValBool(false)
    applyCmp(1, 2, CmpOp.CmpNeq) => Val.ValBool(true)
    applyCmp(1, 2, CmpOp.CmpLt) => Val.ValBool(true)
    applyCmp(2, 1, CmpOp.CmpGt) => Val.ValBool(true)
    applyCmp(1, 2, CmpOp.CmpLte) => Val.ValBool(true)
    applyCmp(2, 1, CmpOp.CmpGte) => Val.ValBool(true)

fn applyCmpFloat(x: Float, y: Float, op: CmpOp) -> Val
    ? "Apply a comparison to two floats."
    match op
        CmpOp.CmpEq -> Val.ValBool(x == y)
        CmpOp.CmpNeq -> Val.ValBool(x != y)
        CmpOp.CmpLt -> Val.ValBool(x < y)
        CmpOp.CmpGt -> Val.ValBool(x > y)
        CmpOp.CmpLte -> Val.ValBool(x <= y)
        CmpOp.CmpGte -> Val.ValBool(x >= y)

verify applyCmpFloat
    applyCmpFloat(1.0, 1.0, CmpOp.CmpEq) => Val.ValBool(true)
    applyCmpFloat(1.0, 2.0, CmpOp.CmpLt) => Val.ValBool(true)
    applyCmpFloat(3.0, 2.0, CmpOp.CmpGt) => Val.ValBool(true)
    applyCmpFloat(1.0, 1.0, CmpOp.CmpLte) => Val.ValBool(true)
    applyCmpFloat(1.0, 2.0, CmpOp.CmpNeq) => Val.ValBool(true)
    applyCmpFloat(1.0, 1.0, CmpOp.CmpGte) => Val.ValBool(true)

fn evalBinopVals(va: Val, vb: Val, op: BinOp) -> Result<Val, String>
    ? "Apply binary op to two evaluated values."
    match (va, vb)
        (Val.ValInt(x), Val.ValInt(y)) -> applyBinop(x, y, op)
        (Val.ValFloat(x), Val.ValFloat(y)) -> applyBinopFloat(x, y, op)
        (Val.ValInt(x), Val.ValFloat(y)) -> applyBinopFloat(Float.fromInt(x), y, op)
        (Val.ValFloat(x), Val.ValInt(y)) -> applyBinopFloat(x, Float.fromInt(y), op)
        (Val.ValStr(x), Val.ValStr(y)) -> match op
            BinOp.OpAdd -> Result.Ok(Val.ValStr(x + y))
            _ -> Result.Err("strings only support +")
        _ -> Result.Err("binop type mismatch")

verify evalBinopVals
    evalBinopVals(Val.ValInt(2), Val.ValInt(3), BinOp.OpAdd) => Result.Ok(Val.ValInt(5))
    evalBinopVals(Val.ValFloat(1.5), Val.ValFloat(2.5), BinOp.OpAdd) => Result.Ok(Val.ValFloat(4.0))
    evalBinopVals(Val.ValInt(1), Val.ValFloat(2.5), BinOp.OpAdd) => Result.Ok(Val.ValFloat(3.5))
    evalBinopVals(Val.ValFloat(3.0), Val.ValInt(2), BinOp.OpMul) => Result.Ok(Val.ValFloat(6.0))
    evalBinopVals(Val.ValStr("a"), Val.ValStr("b"), BinOp.OpAdd) => Result.Ok(Val.ValStr("ab"))
    evalBinopVals(Val.ValBool(true), Val.ValInt(1), BinOp.OpAdd) => Result.Err("binop type mismatch")

fn evalCmpVals(va: Val, vb: Val, op: CmpOp) -> Result<Val, String>
    ? "Apply comparison to two evaluated values (Int, Float, or String)."
    match (va, vb)
        (Val.ValInt(x), Val.ValInt(y)) -> Result.Ok(applyCmp(x, y, op))
        (Val.ValFloat(x), Val.ValFloat(y)) -> Result.Ok(applyCmpFloat(x, y, op))
        (Val.ValInt(x), Val.ValFloat(y)) -> Result.Ok(applyCmpFloat(Float.fromInt(x), y, op))
        (Val.ValFloat(x), Val.ValInt(y)) -> Result.Ok(applyCmpFloat(x, Float.fromInt(y), op))
        (Val.ValStr(x), Val.ValStr(y)) -> Result.Ok(applyStrCmp(x, y, op))
        (Val.ValBool(x), Val.ValBool(y)) -> applyBoolCmp(x, y, op)
        (a, b) -> evalCmpRepr(a, b, op)

verify evalCmpVals
    evalCmpVals(Val.ValInt(1), Val.ValInt(1), CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValFloat(1.5), Val.ValFloat(1.5), CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValFloat(1.0), Val.ValFloat(2.0), CmpOp.CmpLt) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValInt(1), Val.ValFloat(1.0), CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValStr("a"), Val.ValStr("a"), CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpVals(Val.ValBool(true), Val.ValBool(false), CmpOp.CmpEq) => Result.Ok(Val.ValBool(false))
    evalCmpVals(Val.ValBool(true), Val.ValBool(false), CmpOp.CmpLt) => Result.Err("bools only support == and !=")

fn applyStrCmp(x: String, y: String, op: CmpOp) -> Val
    ? "String comparison: all operators supported."
    match op
        CmpOp.CmpEq -> Val.ValBool(x == y)
        CmpOp.CmpNeq -> Val.ValBool(x != y)
        CmpOp.CmpLt -> Val.ValBool(x < y)
        CmpOp.CmpGt -> Val.ValBool(x > y)
        CmpOp.CmpLte -> Val.ValBool(x <= y)
        CmpOp.CmpGte -> Val.ValBool(x >= y)

verify applyStrCmp
    applyStrCmp("a", "a", CmpOp.CmpEq) => Val.ValBool(true)
    applyStrCmp("a", "b", CmpOp.CmpNeq) => Val.ValBool(true)
    applyStrCmp("a", "b", CmpOp.CmpLt) => Val.ValBool(true)
    applyStrCmp("b", "a", CmpOp.CmpGt) => Val.ValBool(true)
    applyStrCmp("a", "b", CmpOp.CmpLte) => Val.ValBool(true)
    applyStrCmp("b", "a", CmpOp.CmpGte) => Val.ValBool(true)

fn applyBoolCmp(x: Bool, y: Bool, op: CmpOp) -> Result<Val, String>
    ? "Bool comparison: eq and neq."
    match op
        CmpOp.CmpEq -> Result.Ok(Val.ValBool(x == y))
        CmpOp.CmpNeq -> Result.Ok(Val.ValBool(x != y))
        _ -> Result.Err("bools only support == and !=")

verify applyBoolCmp
    applyBoolCmp(true, true, CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    applyBoolCmp(true, false, CmpOp.CmpNeq) => Result.Ok(Val.ValBool(true))
    applyBoolCmp(true, false, CmpOp.CmpLt) => Result.Err("bools only support == and !=")

fn evalCmpRepr(va: Val, vb: Val, op: CmpOp) -> Result<Val, String>
    ? "Fallback comparison using repr (for variants, lists, etc)."
    match op
        CmpOp.CmpEq -> Result.Ok(Val.ValBool(Domain.Value.valRepr(va) == Domain.Value.valRepr(vb)))
        CmpOp.CmpNeq -> Result.Ok(Val.ValBool(Domain.Value.valRepr(va) != Domain.Value.valRepr(vb)))
        _ -> Result.Err("comparison {cmpOpName(op)} not supported for {Domain.Value.valRepr(va)} and {Domain.Value.valRepr(vb)}")

verify evalCmpRepr
    evalCmpRepr(Val.ValNone, Val.ValNone, CmpOp.CmpEq) => Result.Ok(Val.ValBool(true))
    evalCmpRepr(Val.ValNone, Val.ValNone, CmpOp.CmpNeq) => Result.Ok(Val.ValBool(false))
    evalCmpRepr(Val.ValNone, Val.ValNone, CmpOp.CmpLt) => Result.Err("comparison < not supported for Option.None and Option.None")

fn cmpOpName(op: CmpOp) -> String
    ? "Human-readable comparison operator."
    match op
        CmpOp.CmpEq -> "=="
        CmpOp.CmpNeq -> "!="
        CmpOp.CmpLt -> "<"
        CmpOp.CmpGt -> ">"
        CmpOp.CmpLte -> "<="
        CmpOp.CmpGte -> ">="

verify cmpOpName
    cmpOpName(CmpOp.CmpEq) => "=="
    cmpOpName(CmpOp.CmpLt) => "<"
    cmpOpName(CmpOp.CmpGte) => ">="

fn evalVectorGetOrIntVals(vecV: Val, idxV: Val, defaultValue: Int) -> Result<Val, String>
    ? "Read a vector cell and return an integer fallback when the index misses."
    match evalVectorGetMaybeDefault(vecV, idxV)
        Result.Ok(maybeV) -> match maybeV
            Option.Some(v) -> Result.Ok(v)
            Option.None -> Result.Ok(Val.ValInt(defaultValue))
        Result.Err(err) -> Result.Err(err)

verify evalVectorGetOrIntVals
    evalVectorGetOrIntVals(Val.ValVector(Vector.fromList([Val.ValInt(10)])), Val.ValInt(0), 0) => Result.Ok(Val.ValInt(10))
    evalVectorGetOrIntVals(Val.ValVector(Vector.fromList([Val.ValInt(10)])), Val.ValInt(5), 99) => Result.Ok(Val.ValInt(99))
    evalVectorGetOrIntVals(Val.ValInt(1), Val.ValInt(0), 0) => Result.Err("Vector.get: expected (Vector, Int)")

fn evalIntModOrIntVals(aV: Val, bV: Val, defaultValue: Int) -> Result<Val, String>
    ? "Apply Int.mod and return an integer fallback when the result would be Err."
    match aV
        Val.ValInt(a) -> match bV
            Val.ValInt(b) -> match b == 0
                true -> Result.Ok(Val.ValInt(defaultValue))
                false -> Result.Ok(Val.ValInt(Result.withDefault(Int.mod(a, b), defaultValue)))
            _ -> Result.Err("expected int argument")
        _ -> Result.Err("expected int argument")

verify evalIntModOrIntVals
    evalIntModOrIntVals(Val.ValInt(10), Val.ValInt(3), 0) => Result.Ok(Val.ValInt(1))
    evalIntModOrIntVals(Val.ValInt(10), Val.ValInt(0), 99) => Result.Ok(Val.ValInt(99))
    evalIntModOrIntVals(Val.ValStr("x"), Val.ValInt(1), 0) => Result.Err("expected int argument")

fn evalVectorSetMaybeDefault(vecV: Val, idxV: Val, valueV: Val) -> Result<Option<Val>, String>
    ? "Apply Vector.set and return None when the caller should fall back to its default expression."
    match vecV
        Val.ValVector(vec) -> match idxV
            Val.ValInt(idx) -> match idx < 0
                true -> Result.Ok(Option.None)
                false -> match idx < Vector.len(vec)
                    true -> Result.Ok(Option.Some(Val.ValVector(Option.withDefault(Vector.set(vec, idx, valueV), vec))))
                    false -> Result.Ok(Option.None)
            _ -> Result.Err("Vector.set: second arg must be Int")
        _ -> Result.Err("Vector.set: first arg must be Vector")

verify evalVectorSetMaybeDefault
    evalVectorSetMaybeDefault(Val.ValVector(Vector.fromList([Val.ValInt(0)])), Val.ValInt(0), Val.ValInt(5)) => Result.Ok(Option.Some(Val.ValVector(Vector.fromList([Val.ValInt(5)]))))
    evalVectorSetMaybeDefault(Val.ValVector(Vector.fromList([Val.ValInt(0)])), Val.ValInt(9), Val.ValInt(5)) => Result.Ok(Option.None)
    evalVectorSetMaybeDefault(Val.ValInt(1), Val.ValInt(0), Val.ValInt(5)) => Result.Err("Vector.set: first arg must be Vector")

fn evalVectorGetMaybeDefault(vecV: Val, idxV: Val) -> Result<Option<Val>, String>
    ? "Apply Vector.get and return None when the caller should fall back to its default expression."
    match vecV
        Val.ValVector(vec) -> match idxV
            Val.ValInt(idx) -> match Vector.get(vec, idx)
                Option.Some(v) -> Result.Ok(Option.Some(v))
                Option.None -> Result.Ok(Option.None)
            _ -> Result.Err("Vector.get: expected (Vector, Int)")
        _ -> Result.Err("Vector.get: expected (Vector, Int)")

verify evalVectorGetMaybeDefault
    evalVectorGetMaybeDefault(Val.ValVector(Vector.fromList([Val.ValInt(7)])), Val.ValInt(0)) => Result.Ok(Option.Some(Val.ValInt(7)))
    evalVectorGetMaybeDefault(Val.ValVector(Vector.fromList([])), Val.ValInt(0)) => Result.Ok(Option.None)
    evalVectorGetMaybeDefault(Val.ValInt(1), Val.ValInt(0)) => Result.Err("Vector.get: expected (Vector, Int)")
