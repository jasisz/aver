    Result.Ok(Input.RunCommand(Command.AddTag(taskId, tag)))

verify parseAddTag
    parseAddTag(["add_tag", "t1", "ops"]) => Result.Ok(Input.RunCommand(Command.AddTag("t1", "ops")))

fn parseRemoveTag(parts: List<String>) -> Result<Input, String>
    ? "Parses remove_tag."
