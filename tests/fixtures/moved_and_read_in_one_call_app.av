module MovedAndReadInOneCall
    intent =
        "Fixture: a record holding a Vector is handed to a function that sets it while a later argument of the same call still reads it, behind `?`; as many lines as the first argument says."
    effects [Console.print, Args.get]

record Tables
    chunk: Vector<String>
    n: Int

fn addExpr(t: Tables, i: Int, x: String) -> Tables
    ? "x written at slot i."
    Tables(chunk = Option.withDefault(Vector.set(t.chunk, i, x), t.chunk), n = t.n + 1)

fn lenBack(t: Tables, k: Int, acc: Int) -> Int
    ? "The lengths of the texts at slots k, k - 4, ... added up, past 6 at most."
    match k < 0
        true -> acc
        false -> match acc > 6
            true -> acc
            false -> lenBack(t, k - 4, acc + String.len(Option.withDefault(Vector.get(t.chunk, k), "")))

fn exprOf(t: Tables, k: Int) -> Result<String, String>
    ? "A value made from an earlier slot; fails past the end."
    match k >= Vector.len(t.chunk)
        true -> Result.Err("slot {k} is past the end")
        false -> Result.Ok("x{Int.mod(lenBack(t, k, 0), 7)}")

fn exprLine(t: Tables, i: Int) -> Result<Tables, String>
    ? "Writes slot i from the slot before it."
    Result.Ok(addExpr(t, i, exprOf(t, Int.max(i - 1, 0))?))

fn lines(t: Tables, i: Int, n: Int) -> Result<Tables, String>
    ? "n lines."
    match i >= n
        true -> Result.Ok(t)
        false -> lines(exprLine(t, i)?, i + 1, n)

fn sizeArg() -> Int
    ? "The first argument as a number, 1000 without one."
    ! [Args.get]
    match Vector.get(Vector.fromList(Args.get()), 0)
        Option.Some(text) -> Result.withDefault(Int.fromString(text), 1000)
        Option.None -> 1000

fn report(r: Result<Tables, String>) -> String
    ? "The count and the last value, or the error."
    match r
        Result.Ok(t) -> "n {t.n} last {Option.withDefault(Vector.get(t.chunk, t.n - 1), "-")}"
        Result.Err(e) -> e

fn main()
    ! [Console.print, Args.get]
    n = sizeArg()
    t = Tables(chunk = Result.withDefault(Vector.new(n, ""), Vector.fromList([])), n = 0)
    Console.print("{report(lines(t, 0, n))} {report(lines(t, 0, n + 1))}")
