    Result.Ok(Input.RunCommand(Command.SetDeadline(taskId, deadline)))

verify parseSetDeadline
    parseSetDeadline(["set_deadline", "t1", "2026-03-10T12:00:00Z"]) => Result.Ok(Input.RunCommand(Command.SetDeadline("t1", "2026-03-10T12:00:00Z")))

fn parseClearDeadline(parts: List<String>) -> Result<Input, String>
    ? "Parses clear_deadline."
    taskId = field(parts, 1, "task_id")?
    Result.Ok(Input.RunCommand(Command.ClearDeadline(taskId)))

verify parseClearDeadline
    parseClearDeadline(["clear_deadline", "t1"]) => Result.Ok(Input.RunCommand(Command.ClearDeadline("t1")))

