module Check
    intent =
        "The replayer: recompute the equation each step proves, from the step's own data, the"
        "definitions and the hypotheses in scope, and compare the last one with the claim."
        "A refused step is named by its path from the root of the proof."
    exposes [Env, conclude, checkScript, emptyEnv]
    depends [Kernel.Term, Kernel.Subst, Kernel.Proof, Kernel.Rules, Kernel.Eval, Kernel.Finite, Kernel.Induct, Kernel.Ring]
    effects []

record Env
    defs: List<Def>
    consts: List<Const>
    laws: List<Law>
    hyps: List<Hyp>
    finite: List<Given>
    lists: List<String>
    ints: List<String>
    givens: List<String>

fn emptyEnv() -> Env
    ? "No definitions, laws or hypotheses."
    Env(defs = [], consts = [], laws = [], hyps = [], finite = [], lists = [], ints = [], givens = [])

verify emptyEnv
    emptyEnv().hyps => []

fn refuse(path: String, why: String) -> Result<Eqn, String>
    ? "A refusal that names the step."
    Result.Err("step {path}: {why}")

verify refuse
    refuse("proof", "no") => Result.Err("step proof: no")

fn conclude(p: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "The equation a step proves, or the refusal of the first wrong step under it."
    match p
        Proof.PRefl(t) -> Result.Ok(Eqn(lhs = t, rhs = t))
        Proof.PSymm(q) -> flip(conclude(q, env, path + "/symm")?)
        Proof.PTrans(ts, ps) -> trans(ts, ps, env, path)
        Proof.PCongr(c, q) -> congr(c, q, env, path)
        Proof.PUnfold(f, k, xs, ys, pre) -> unfold(f, k, xs, ys, pre, env, path)
        Proof.PConst(n) -> constant(n, env.consts, path)
        Proof.PArm(k, ys, t, q) -> armStep(k, ys, t, q, env, path)
        Proof.PProj(t) -> proj(t, path)
        Proof.PCell(t) -> cell(t, path)
        Proof.PHyp(h) -> hyp(h, env.hyps, path)
        Proof.PRule(id, bs, ps) -> rule(id, bs, ps, env, path)
        Proof.PLaw(k, bs, ps) -> lawStep(k, bs, ps, env, path)
        Proof.PCompute(a, b) -> compute(a, b, path)
        Proof.PCases(on, h, t, f) -> cases(on, h, t, f, env, path)
        Proof.PHave(h, fact, q, body) -> have(h, fact, q, body, env, path)
        Proof.PEnum(v, l, r, cs) -> enumStep(v, l, r, cs, env, path)
        Proof.PAbsurd(q, l, r) -> absurd(conclude(q, env, "{path}/absurd")?, l, r, path)
        Proof.PInduct(f, xs, l, r, carry, cs) -> induct(f, xs, Eqn(lhs = l, rhs = r), carry, cs, env, path)
        Proof.PListInduct(v, l, r, n, h, t, general, ihs, c) -> listInduct(v, Eqn(lhs = l, rhs = r), n, h, t, general, ihs, c, env, path)
        Proof.PIntInduct(v, l, r, g, b, names, general, ihs, st) -> intInduct(v, Eqn(lhs = l, rhs = r), g, b, names, general, ihs, st, env, path)
        Proof.PRing(l, r) -> ring(l, r, path)
        Proof.PLinear(g, v, hs, ws) -> linear(g, v, hs, ws, env, path)

verify conclude
    conclude(Proof.PRefl(Term.TInt(1)), emptyEnv(), "proof") => Result.Ok(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(1)))
    conclude(Proof.PHyp("h"), emptyEnv(), "proof") => Result.Err("step proof: hypothesis h is not in scope")
    conclude(Proof.PRule("simp", [], []), emptyEnv(), "proof/trans.2") => Result.Err("step proof/trans.2: unknown rule simp")

verify conclude law refusalNamesTheStep
    given name: String = ["h", "when", "h_steps1"]
    given path: String = ["proof", "proof/trans.0", "proof/cases.true/congr"]
    namesStep(conclude(Proof.PHyp(name), emptyEnv(), path), path) => true

fn namesStep(r: Result<Eqn, String>, path: String) -> Bool
    ? "Whether a result is a refusal that begins with the step it names."
    match r
        Result.Ok(e) -> false
        Result.Err(why) -> String.startsWith(why, "step {path}: ")

verify namesStep
    namesStep(Result.Err("step p: x"), "p") => true
    namesStep(Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TUnit)), "p") => false

fn flip(e: Eqn) -> Result<Eqn, String>
    ? "Symmetry."
    Result.Ok(Eqn(lhs = e.rhs, rhs = e.lhs))

verify flip
    flip(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(2))) => Result.Ok(Eqn(lhs = Term.TInt(2), rhs = Term.TInt(1)))

fn trans(ts: List<Term>, ps: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "A chain t0 = t1 = … = tn, each link proved by its step."
    match List.len(ts) == List.len(ps) + 1
        false -> refuse(path, "trans needs one more term than steps")
        true -> transFrom(ts, ps, env, path, 0)

verify trans
    trans([Term.TInt(1)], [Proof.PRefl(Term.TInt(1))], emptyEnv(), "p") => Result.Err("step p: trans needs one more term than steps")

fn transFrom(ts: List<Term>, ps: List<Proof>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "Check link i and those after it; the result spans the whole chain."
    match (ts, ps)
        ([a, b, ..moreTerms], [p, ..moreSteps]) -> transLink(a, b, p, List.prepend(b, moreTerms), moreSteps, env, path, i)
        ([a], []) -> Result.Ok(Eqn(lhs = a, rhs = a))
        _ -> refuse(path, "trans needs at least one step")

verify transFrom
    transFrom([Term.TInt(1)], [], emptyEnv(), "p", 0) => Result.Ok(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(1)))

fn transLink(a: Term, b: Term, p: Proof, rest: List<Term>, steps: List<Proof>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "One link of a chain, then the rest."
    here = "{path}/trans.{i}"
    e = conclude(p, env, here)?
    match e == Eqn(lhs = a, rhs = b)
        false -> refuse(here, "the step does not join the written terms")
        true -> joinRest(a, transFrom(rest, steps, env, path, i + 1)?)

verify transLink
    transLink(Term.TInt(1), Term.TInt(2), Proof.PRefl(Term.TInt(1)), [Term.TInt(2)], [], emptyEnv(), "p", 0) => Result.Err("step p/trans.0: the step does not join the written terms")

fn joinRest(a: Term, rest: Eqn) -> Result<Eqn, String>
    ? "The chain from a to the end of the rest."
    Result.Ok(Eqn(lhs = a, rhs = rest.rhs))

verify joinRest
    joinRest(Term.TInt(1), Eqn(lhs = Term.TInt(2), rhs = Term.TInt(3))) => Result.Ok(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(3)))

fn congr(c: Term, q: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "From a = b, c[a] = c[b]; the context holds exactly one hole."
    match Kernel.Subst.holeCount(c) == 1
        false -> refuse(path, "a congruence context needs exactly one hole")
        true -> plugBoth(c, conclude(q, env, "{path}/congr")?, path)

verify congr
    congr(Term.TVar("x"), Proof.PRefl(Term.TInt(1)), emptyEnv(), "p") => Result.Err("step p: a congruence context needs exactly one hole")

fn plugBoth(c: Term, e: Eqn, path: String) -> Result<Eqn, String>
    ? "Put both sides of an equation into the hole."
    match (Kernel.Subst.subst(c, [Kernel.Term.bind("□", e.lhs)]), Kernel.Subst.subst(c, [Kernel.Term.bind("□", e.rhs)]))
        (Result.Ok(l), Result.Ok(r)) -> Result.Ok(Eqn(lhs = l, rhs = r))
        (Result.Err(why), _) -> refuse(path, why)
        (_, Result.Err(why)) -> refuse(path, why)

verify plugBoth
    plugBoth(Term.TNeg(Term.THole), Eqn(lhs = Term.TVar("a"), rhs = Term.TVar("b")), "p") => Result.Ok(Eqn(lhs = Term.TNeg(Term.TVar("a")), rhs = Term.TNeg(Term.TVar("b"))))

fn proj(t: Term, path: String) -> Result<Eqn, String>
    ? "A record literal's field."
    match t
        Term.TGet(Term.TRec(ty, fs), f) -> projField(t, fs, f, path)
        _ -> refuse(path, "a projection must read a field of a record literal")

verify proj
    proj(Term.TGet(Term.TRec("R", [Field(name = "a", value = Term.TInt(3))]), "a"), "p") => Result.Ok(Eqn(lhs = Term.TGet(Term.TRec("R", [Field(name = "a", value = Term.TInt(3))]), "a"), rhs = Term.TInt(3)))
    proj(Term.TGet(Term.TVar("r"), "a"), "p") => Result.Err("step p: a projection must read a field of a record literal")

fn cell(t: Term, path: String) -> Result<Eqn, String>
    ? "A list literal with an element is that element in front of the rest."
    match t
        Term.TList([x, ..rest]) -> Result.Ok(Eqn(lhs = t, rhs = Term.TBi("List.prepend", [x, Term.TList(rest)])))
        _ -> refuse(path, "a cell step needs a list literal with an element")

verify cell
    cell(Term.TList([Term.TVar("y")]), "p") => Result.Ok(Eqn(lhs = Term.TList([Term.TVar("y")]), rhs = Term.TBi("List.prepend", [Term.TVar("y"), Term.TList([])])))
    cell(Term.TList([]), "p") => Result.Err("step p: a cell step needs a list literal with an element")

fn projField(t: Term, fs: List<Field>, f: String, path: String) -> Result<Eqn, String>
    ? "Find the field among the literal's fields."
    match fs
        [] -> refuse(path, "the record has no field {f}")
        [x, ..rest] -> match x.name == f
            true -> Result.Ok(Eqn(lhs = t, rhs = x.value))
            false -> projField(t, rest, f, path)

verify projField
    projField(Term.TUnit, [], "a", "p") => Result.Err("step p: the record has no field a")

fn hyp(h: String, hs: List<Hyp>, path: String) -> Result<Eqn, String>
    ? "A hypothesis in scope; the innermost one of a name wins."
    match hs
        [] -> refuse(path, "hypothesis {h} is not in scope")
        [x, ..rest] -> match x.name == h
            true -> Result.Ok(x.eqn)
            false -> hyp(h, rest, path)

verify hyp
    hyp("h", [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))], "p") => Result.Ok(Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))

fn compute(a: Term, b: Term, path: String) -> Result<Eqn, String>
    ? "Two closed terms with the same value."
    match (Kernel.Eval.evalClosed(a), Kernel.Eval.evalClosed(b))
        (Option.Some(x), Option.Some(y)) -> match x == y
            true -> Result.Ok(Eqn(lhs = a, rhs = b))
            false -> refuse(path, "the two sides compute to different values")
        _ -> refuse(path, "compute needs closed terms")

verify compute
    compute(Term.TOp("-", Term.TInt(8), Term.TInt(1)), Term.TInt(7), "p") => Result.Ok(Eqn(lhs = Term.TOp("-", Term.TInt(8), Term.TInt(1)), rhs = Term.TInt(7)))
    compute(Term.TOp("-", Term.TInt(8), Term.TInt(1)), Term.TInt(6), "p") => Result.Err("step p: the two sides compute to different values")
    compute(Term.TVar("x"), Term.TInt(6), "p") => Result.Err("step p: compute needs closed terms")

fn cases(on: Term, h: String, t: Proof, f: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "Both branches of a Bool split must prove the same equation; the term split on must be a Bool."
    match isBool(on, env)
        true -> casesOfBool(on, h, t, f, env, path)
        false -> refuse(path, "the term split on is not a Bool")

verify cases
    cases(Term.TVar("c"), "h", Proof.PHyp("h"), Proof.PHyp("h"), emptyEnv(), "p") => Result.Err("step p: the term split on is not a Bool")
    cases(Term.TOp("<", Term.TVar("x"), Term.TInt(0)), "h", Proof.PHyp("h"), Proof.PHyp("h"), emptyEnv(), "p") => Result.Err("step p: the two branches prove different equations")

fn isBool(t: Term, env: Env) -> Bool
    ? "Whether a term is a Bool by its shape: a literal, a comparison, a Bool connective, a call of a definition that returns a Bool, or a given of type Bool or a Bool field of one."
    match t
        Term.TBool(b) -> true
        Term.TOp(o, a, b) -> List.contains(["==", "!=", "<", "<=", ">", ">=", "==.", "!=.", "<.", "<=.", ">.", ">=."], o)
        Term.TBi(n, xs) -> List.contains(["Bool.and", "Bool.or", "Bool.not"], n)
        Term.TCall(f, xs) -> returnsBool(f, env.defs)
        _ -> finOf(t, env.finite) == Option.Some(Fin.FBool)

verify isBool
    isBool(Term.TOp("<=", Term.TVar("x"), Term.TInt(0)), emptyEnv()) => true
    isBool(Term.TOp("+", Term.TVar("x"), Term.TInt(0)), emptyEnv()) => false
    isBool(Term.TVar("b"), emptyEnv()) => false
    isBool(Term.TCall("f", []), emptyEnv()) => false

fn finOf(t: Term, gs: List<Given>) -> Option<Fin>
    ? "The finite type of a given, or of a field of one."
    match t
        Term.TVar(v) -> findGiven(v, gs)
        Term.TGet(r, f) -> match finOf(r, gs)
            Option.Some(Fin.FRec(n, fs)) -> fieldFin(f, fs)
            _ -> Option.None
        _ -> Option.None

verify finOf
    finOf(Term.TGet(Term.TVar("r"), "on"), [Given(name = "r", fin = Fin.FRec("Lamp", [FinField(name = "on", fin = Fin.FBool)]))]) => Option.Some(Fin.FBool)
    finOf(Term.TGet(Term.TVar("r"), "off"), [Given(name = "r", fin = Fin.FRec("Lamp", [FinField(name = "on", fin = Fin.FBool)]))]) => Option.None
    finOf(Term.TVar("b"), []) => Option.None

fn fieldFin(f: String, fs: List<FinField>) -> Option<Fin>
    ? "The finite type of a named field."
    match fs
        [] -> Option.None
        [x, ..rest] -> match x.name == f
            true -> Option.Some(x.fin)
            false -> fieldFin(f, rest)

verify fieldFin
    fieldFin("on", [FinField(name = "on", fin = Fin.FBool)]) => Option.Some(Fin.FBool)
    fieldFin("x", []) => Option.None

fn returnsBool(f: String, ds: List<Def>) -> Bool
    ? "Whether f is a definition in scope marked as returning a Bool."
    match ds
        [] -> false
        [d, ..rest] -> match d.name == f
            true -> d.returnsBool
            false -> returnsBool(f, rest)

verify returnsBool
    returnsBool("p", [Def(name = "p", returnsBool = true, params = [], lets = [], body = Term.TBool(true))]) => true
    returnsBool("p", [Def(name = "p", returnsBool = false, params = [], lets = [], body = Term.TInt(1))]) => false
    returnsBool("q", [Def(name = "p", returnsBool = true, params = [], lets = [], body = Term.TBool(true))]) => false

fn casesOfBool(on: Term, h: String, t: Proof, f: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "The two branches of a split on a Bool."
    whenTrue = conclude(t, withHyp(env, h, on, true), "{path}/cases.true")?
    whenFalse = conclude(f, withHyp(env, h, on, false), "{path}/cases.false")?
    match whenTrue == whenFalse
        true -> Result.Ok(whenTrue)
        false -> refuse(path, "the two branches prove different equations")

verify casesOfBool
    casesOfBool(Term.TVar("c"), "h", Proof.PHyp("h"), Proof.PHyp("h"), emptyEnv(), "p") => Result.Err("step p: the two branches prove different equations")

fn have(h: String, fact: Term, q: Proof, body: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "A cut: q proves fact = true in the current scope, then body is checked with it as hypothesis h."
    proved = conclude(q, env, "{path}/have.{h}")?
    match proved == Eqn(lhs = fact, rhs = Term.TBool(true))
        true -> conclude(body, withHyp(env, h, fact, true), path)
        false -> refuse(path, "the proof of {h} ends at a different equation than its fact")

verify have
    have("h", Term.TVar("c"), Proof.PHyp("g"), Proof.PHyp("h"), withHyp(emptyEnv(), "g", Term.TVar("c"), true), "p") => Result.Ok(Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))
    have("h", Term.TVar("c"), Proof.PHyp("g"), Proof.PHyp("h"), withHyp(emptyEnv(), "g", Term.TVar("c"), false), "p") => Result.Err("step p: the proof of h ends at a different equation than its fact")
    have("h", Term.TVar("c"), Proof.PHyp("h"), Proof.PHyp("h"), emptyEnv(), "p") => Result.Err("step p/have.h: hypothesis h is not in scope")

fn withHyp(env: Env, h: String, on: Term, value: Bool) -> Env
    ? "The environment with one more hypothesis in front."
    Env(defs = env.defs, consts = env.consts, laws = env.laws, hyps = List.prepend(Hyp(name = h, eqn = Eqn(lhs = on, rhs = Term.TBool(value))), env.hyps), finite = env.finite, lists = env.lists, ints = env.ints, givens = env.givens)

verify withHyp
    List.len(withHyp(emptyEnv(), "h", Term.TVar("c"), true).hyps) => 1

fn linear(g: Term, v: Bool, hs: List<String>, ws: List<Int>, env: Env, path: String) -> Result<Eqn, String>
    ? "A comparison decided by linear arithmetic: its opposite and the named hypotheses, weighted, add up to a negative constant."
    match hypEqns(hs, env.hyps, path)
        Result.Err(why) -> Result.Err(why)
        Result.Ok(facts) -> match Kernel.Ring.linearContradiction(List.prepend(Eqn(lhs = g, rhs = Term.TBool(Bool.not(v))), facts), ws)
            true -> Result.Ok(Eqn(lhs = g, rhs = Term.TBool(v)))
            false -> refuse(path, "the weights do not add up to a contradiction")

verify linear
    linear(Term.TOp(">", Term.TOp("+", Term.TVar("x"), Term.TInt(1)), Term.TInt(1)), true, ["h"], [1, 1], withHyp(emptyEnv(), "h", Term.TOp(">", Term.TVar("x"), Term.TInt(0)), true), "p") => Result.Ok(Eqn(lhs = Term.TOp(">", Term.TOp("+", Term.TVar("x"), Term.TInt(1)), Term.TInt(1)), rhs = Term.TBool(true)))
    linear(Term.TOp(">", Term.TVar("x"), Term.TInt(1)), true, ["h"], [1, 1], withHyp(emptyEnv(), "h", Term.TOp(">", Term.TVar("x"), Term.TInt(0)), true), "p") => Result.Err("step p: the weights do not add up to a contradiction")

fn hypEqns(hs: List<String>, scope: List<Hyp>, path: String) -> Result<List<Eqn>, String>
    ? "The equations of the named hypotheses."
    match hs
        [] -> Result.Ok([])
        [h, ..rest] -> Result.Ok(List.prepend(hyp(h, scope, path)?, hypEqns(rest, scope, path)?))

verify hypEqns
    hypEqns(["h"], [], "p") => Result.Err("step p: hypothesis h is not in scope")

fn ring(l: Term, r: Term, path: String) -> Result<Eqn, String>
    ? "Two Int terms that are the same polynomial over their atoms."
    match Kernel.Ring.samePolynomial(l, r)
        true -> Result.Ok(Eqn(lhs = l, rhs = r))
        false -> refuse(path, "the two sides are different polynomials")

verify ring
    ring(Term.TOp("*", Term.TVar("a"), Term.TInt(2)), Term.TOp("+", Term.TVar("a"), Term.TVar("a")), "p") => Result.Ok(Eqn(lhs = Term.TOp("*", Term.TVar("a"), Term.TInt(2)), rhs = Term.TOp("+", Term.TVar("a"), Term.TVar("a"))))
    ring(Term.TVar("a"), Term.TInt(0), "p") => Result.Err("step p: the two sides are different polynomials")

fn absurd(e: Eqn, l: Term, r: Term, path: String) -> Result<Eqn, String>
    ? "Any equation, once true has been shown equal to false: the case cannot happen."
    match (e.lhs, e.rhs)
        (Term.TBool(a), Term.TBool(b)) -> match a != b
            true -> Result.Ok(Eqn(lhs = l, rhs = r))
            false -> refuse(path, "absurd needs true equal to false")
        _ -> refuse(path, "absurd needs true equal to false")

verify absurd
    absurd(Eqn(lhs = Term.TBool(false), rhs = Term.TBool(true)), Term.TInt(1), Term.TInt(2), "p") => Result.Ok(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(2)))
    absurd(Eqn(lhs = Term.TBool(true), rhs = Term.TBool(true)), Term.TInt(1), Term.TInt(2), "p") => Result.Err("step p: absurd needs true equal to false")

fn enumStep(v: String, l: Term, r: Term, cs: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "A split of a given of finite type into all its values: case i proves the claim at value i."
    match findGiven(v, env.finite)
        Option.None -> refuse(path, "{v} is not a given of finite type")
        Option.Some(f) -> enumCases(v, Eqn(lhs = l, rhs = r), Kernel.Finite.values(f), cs, env, path, 0)

verify enumStep
    enumStep("b", Term.TVar("b"), Term.TVar("b"), [], emptyEnv(), "p") => Result.Err("step p: b is not a given of finite type")

fn findGiven(v: String, gs: List<Given>) -> Option<Fin>
    ? "The finite type of a given."
    match gs
        [] -> Option.None
        [g, ..rest] -> match g.name == v
            true -> Option.Some(g.fin)
            false -> findGiven(v, rest)

verify findGiven
    findGiven("b", [Given(name = "b", fin = Fin.FBool)]) => Option.Some(Fin.FBool)

fn enumCases(v: String, claim: Eqn, vals: List<Term>, cs: List<Proof>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "One case per value, in order, and nothing else."
    match (vals, cs)
        ([], []) -> Result.Ok(claim)
        ([x, ..xs], [c, ..rest]) -> enumCase(v, claim, x, c, xs, rest, env, path, i)
        _ -> refuse(path, "the cases do not match the values of {v}")

verify enumCases
    enumCases("b", Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [Term.TBool(true)], [], emptyEnv(), "p", 0) => Result.Err("step p: the cases do not match the values of b")

fn enumCase(v: String, claim: Eqn, x: Term, c: Proof, xs: List<Term>, rest: List<Proof>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "The claim at one value, under the hypotheses at that value."
    at = [Kernel.Term.bind(v, x)]
    here = "{path}/enum.{i}"
    got = conclude(c, withHyps(env, substHyps(env.hyps, at, path)?), here)?
    want = instantiate(claim, at, path)?
    match got == want
        false -> refuse(here, "the case proves a different equation")
        true -> enumCases(v, claim, xs, rest, env, path, i + 1)

verify enumCase
    enumCase("b", Eqn(lhs = Term.TVar("b"), rhs = Term.TBool(true)), Term.TBool(false), Proof.PRefl(Term.TBool(true)), [], [], emptyEnv(), "p", 0) => Result.Err("step p/enum.0: the case proves a different equation")

fn substHyps(hs: List<Hyp>, at: List<Binding>, path: String) -> Result<List<Hyp>, String>
    ? "Every hypothesis at a substitution."
    match hs
        [] -> Result.Ok([])
        [h, ..rest] -> Result.Ok(List.prepend(Hyp(name = h.name, eqn = instantiate(h.eqn, at, path)?), substHyps(rest, at, path)?))

verify substHyps
    substHyps([], [], "p") => Result.Ok([])

fn withHyps(env: Env, hs: List<Hyp>) -> Env
    ? "The environment with its hypotheses replaced."
    Env(defs = env.defs, consts = env.consts, laws = env.laws, hyps = hs, finite = env.finite, lists = env.lists, ints = env.ints, givens = env.givens)

verify withHyps
    withHyps(emptyEnv(), []).hyps => []

fn findDef(name: String, ds: List<Def>) -> Option<Def>
    ? "A definition by name."
    match ds
        [] -> Option.None
        [d, ..rest] -> match d.name == name
            true -> Option.Some(d)
            false -> findDef(name, rest)

verify findDef
    findDef("f", []) => Option.None

fn constant(n: String, cs: List<Const>, path: String) -> Result<Eqn, String>
    ? "A module-level binding's value: the variable that reads it equals the value the script carries."
    match cs
        [] -> refuse(path, "no module-level binding {n}")
        [c, ..rest] -> match c.name == n
            true -> Result.Ok(Eqn(lhs = Term.TVar(n), rhs = c.value))
            false -> constant(n, rest, path)

verify constant
    constant("base", [Const(name = "base", value = Term.TInt(40))], "p") => Result.Ok(Eqn(lhs = Term.TVar("base"), rhs = Term.TInt(40)))
    constant("Lib.base", [Const(name = "base", value = Term.TInt(40))], "p") => Result.Err("step p: no module-level binding Lib.base")

fn zipBind(names: List<String>, values: List<Term>) -> List<Binding>
    ? "Pair names with terms, as far as both go."
    match (names, values)
        ([n, ..ns], [v, ..vs]) -> List.prepend(Kernel.Term.bind(n, v), zipBind(ns, vs))
        _ -> []

verify zipBind
    zipBind(["a"], [Term.TInt(1)]) => [Kernel.Term.bind("a", Term.TInt(1))]

fn unfold(f: String, k: Int, xs: List<Term>, ys: List<Term>, pre: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "Equation k of a definition at explicit arguments: 0 is the whole body, k is arm k of its match."
    match findDef(f, env.defs)
        Option.None -> refuse(path, "no definition of {f}")
        Option.Some(d) -> match (List.len(d.params) == List.len(xs), Kernel.Induct.openGate(d))
            (_, Result.Err(why)) -> refuse(path, why)
            (false, _) -> refuse(path, "{f} takes {List.len(d.params)} arguments")
            (true, _) -> unfoldArm(d, k, xs, ys, pre, env, path)

verify unfold
    unfold("f", 0, [], [], [], emptyEnv(), "p") => Result.Err("step p: no definition of f")

fn unfoldArm(d: Def, k: Int, xs: List<Term>, ys: List<Term>, pre: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "The whole body, or one arm under its premise; the local bindings are substituted first, in order."
    outer = bindLets(d.lets, List.reverse(zipBind(d.params, xs)))?
    lhs = Term.TCall(d.name, xs)
    match (k, ys, pre)
        (0, [], []) -> Result.Ok(Eqn(lhs = lhs, rhs = Kernel.Subst.subst(d.body, outer)?))
        (0, _, _) -> refuse(path, "equation 0 takes no binders and no premise")
        _ -> unfoldMatch(d.body, k, outer, ys, pre, lhs, env, path)

verify unfoldArm
    unfoldArm(Def(name = "one", returnsBool = false, params = [], lets = [], body = Term.TInt(1)), 0, [], [], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TCall("one", []), rhs = Term.TInt(1)))
    unfoldArm(Def(name = "one", returnsBool = false, params = [], lets = [], body = Term.TInt(1)), 1, [], [], [], emptyEnv(), "p") => Result.Err("step p: the body is not a match")
    unfoldArm(Def(name = "f", returnsBool = false, params = ["x"], lets = [Kernel.Term.bind("y", Term.TOp("+", Term.TVar("x"), Term.TInt(1))), Kernel.Term.bind("z", Term.TOp("*", Term.TVar("y"), Term.TVar("x")))], body = Term.TVar("z")), 0, [Term.TVar("a")], [], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TCall("f", [Term.TVar("a")]), rhs = Term.TOp("*", Term.TOp("+", Term.TVar("a"), Term.TInt(1)), Term.TVar("a"))))
    unfoldArm(Def(name = "f", returnsBool = false, params = ["x"], lets = [Kernel.Term.bind("x", Term.TOp("+", Term.TVar("x"), Term.TInt(1)))], body = Term.TVar("x")), 0, [Term.TVar("a")], [], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TCall("f", [Term.TVar("a")]), rhs = Term.TOp("+", Term.TVar("a"), Term.TInt(1))))

fn bindLets(lets: List<Binding>, outer: List<Binding>) -> Result<List<Binding>, String>
    ? "Each local binding, in order, bound to its value under everything before it; the latest name comes first."
    match lets
        [] -> Result.Ok(outer)
        [b, ..rest] -> bindLets(rest, List.prepend(Kernel.Term.bind(b.name, Kernel.Subst.subst(b.value, outer)?), outer))

verify bindLets
    bindLets([], []) => Result.Ok([])
    bindLets([Kernel.Term.bind("y", Term.TVar("x"))], [Kernel.Term.bind("x", Term.TInt(2))]) => Result.Ok([Kernel.Term.bind("y", Term.TInt(2)), Kernel.Term.bind("x", Term.TInt(2))])

fn unfoldMatch(body: Term, k: Int, outer: List<Binding>, ys: List<Term>, pre: List<Proof>, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "Arm k of the body's match."
    match body
        Term.TMatch(s, arms) -> selected(s, arms, k, outer, ys, pre, lhs, env, path)
        _ -> refuse(path, "the body is not a match")

verify unfoldMatch
    unfoldMatch(Term.TUnit, 1, [], [], [], Term.TUnit, emptyEnv(), "p") => Result.Err("step p: the body is not a match")

fn armStep(k: Int, ys: List<Term>, t: Term, q: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "Arm k of an explicit match term, under its premise."
    match t
        Term.TMatch(s, arms) -> selected(s, arms, k, [], ys, [q], t, env, path)
        _ -> refuse(path, "not a match")

verify armStep
    armStep(1, [], Term.TUnit, Proof.PRefl(Term.TUnit), emptyEnv(), "p") => Result.Err("step p: not a match")

fn selected(s: Term, arms: List<Arm>, k: Int, outer: List<Binding>, ys: List<Term>, pre: List<Proof>, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "lhs = arm k, once the premise shows the subject has arm k's pattern."
    match (armAt(arms, k), pre)
        (Option.None, _) -> refuse(path, "there is no arm {k}")
        (_, [q]) -> selectedWith(s, arms, k, outer, ys, q, lhs, env, path)
        _ -> refuse(path, "an arm needs exactly one premise")

verify selected
    selected(Term.TVar("s"), [], 1, [], [], [], Term.TUnit, emptyEnv(), "p") => Result.Err("step p: there is no arm 1")

fn selectedWith(s: Term, arms: List<Arm>, k: Int, outer: List<Binding>, ys: List<Term>, q: Proof, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "Check the arm is the first that can match, then the premise."
    chosen = Option.withDefault(armAt(arms, k), Arm(pattern = Pat.PWild, body = Term.TUnit))
    match (isCatchAll(chosen.pattern), ys)
        (true, [v]) -> catchAllArm(s, arms, k, chosen, outer, v, q, lhs, env, path)
        (true, _) -> refuse(path, "a catch-all arm takes the value it is chosen for")
        (false, _) -> match earlierExclude(arms, k, chosen.pattern)
            false -> refuse(path, "an earlier arm can also match arm {k}")
            true -> armEquation(s, chosen, outer, ys, q, lhs, env, path)

verify selectedWith
    selectedWith(Term.TVar("s"), [Arm(pattern = Pat.PWild, body = Term.TUnit), Arm(pattern = Pat.PNil, body = Term.TUnit)], 2, [], [], Proof.PRefl(Term.TUnit), Term.TUnit, emptyEnv(), "p") => Result.Err("step p: an earlier arm can also match arm 2")

fn isCatchAll(p: Pat) -> Bool
    ? "A pattern every value matches: the wildcard or a bare name."
    match p
        Pat.PWild -> true
        Pat.PVar(n) -> true
        _ -> false

verify isCatchAll
    isCatchAll(Pat.PVar("x")) => true
    isCatchAll(Pat.PNil) => false

fn catchAllArm(s: Term, arms: List<Arm>, k: Int, chosen: Arm, outer: List<Binding>, v: Term, q: Proof, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "A catch-all arm chosen for one value: every earlier arm excludes it, the premise shows the subject is it, and a named catch-all binds it."
    match earlierExcludeValue(arms, k, v)
        false -> refuse(path, "an earlier arm can also match arm {k}")
        true -> catchAllBody(chosen, List.concat(zipBind(Kernel.Subst.patNames(chosen.pattern), [v]), outer), Eqn(lhs = Kernel.Subst.subst(s, outer)?, rhs = v), conclude(q, env, "{path}/premise")?, lhs, path)

verify catchAllArm
    catchAllArm(Term.TVar("c"), [Arm(pattern = Pat.PLit(Term.TInt(0)), body = Term.TInt(1)), Arm(pattern = Pat.PWild, body = Term.TInt(2))], 2, Arm(pattern = Pat.PWild, body = Term.TInt(2)), [], Term.TInt(0), Proof.PRefl(Term.TInt(0)), Term.TUnit, emptyEnv(), "p") => Result.Err("step p: an earlier arm can also match arm 2")
    catchAllArm(Term.TInt(5), [Arm(pattern = Pat.PLit(Term.TInt(0)), body = Term.TInt(1)), Arm(pattern = Pat.PVar("n"), body = Term.TVar("n"))], 2, Arm(pattern = Pat.PVar("n"), body = Term.TVar("n")), [], Term.TInt(5), Proof.PRefl(Term.TInt(5)), Term.TUnit, emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TInt(5)))

fn catchAllBody(chosen: Arm, inner: List<Binding>, needed: Eqn, got: Eqn, lhs: Term, path: String) -> Result<Eqn, String>
    ? "The arm's body once the premise is the one it needs."
    match got == needed
        false -> refuse(path, "the premise does not select this arm")
        true -> Result.Ok(Eqn(lhs = lhs, rhs = Kernel.Subst.subst(chosen.body, inner)?))

verify catchAllBody
    catchAllBody(Arm(pattern = Pat.PWild, body = Term.TInt(2)), [], Eqn(lhs = Term.TInt(1), rhs = Term.TInt(1)), Eqn(lhs = Term.TInt(1), rhs = Term.TInt(2)), Term.TUnit, "p") => Result.Err("step p: the premise does not select this arm")

fn earlierExcludeValue(arms: List<Arm>, k: Int, v: Term) -> Bool
    ? "Every arm before arm k certainly does not match the value."
    match (arms, k > 1)
        ([a, ..rest], true) -> Bool.and(excludes(a.pattern, v), earlierExcludeValue(rest, k - 1, v))
        _ -> true

verify earlierExcludeValue
    earlierExcludeValue([Arm(pattern = Pat.PCtor("C.A", []), body = Term.TUnit)], 2, Term.TCtor("C.B", [])) => true

fn excludes(p: Pat, v: Term) -> Bool
    ? "Whether a pattern certainly does not match a value: another literal, another constructor, the other list shape."
    match (p, v)
        (Pat.PLit(x), _) -> Bool.and(isLiteral(v), Bool.and(sameKind(x, v), x != v))
        (Pat.PCtor(c, xs), Term.TCtor(d, ys)) -> c != d
        (Pat.PNil, Term.TBi("List.prepend", [h, t])) -> true
        (Pat.PCons(h, t), Term.TList([])) -> true
        _ -> false

verify excludes
    excludes(Pat.PLit(Term.TInt(0)), Term.TInt(3)) => true
    excludes(Pat.PLit(Term.TInt(0)), Term.TVar("x")) => false
    excludes(Pat.PLit(Term.TInt(0)), Term.TStr("0")) => false
    excludes(Pat.PNil, Term.TList([Term.TInt(1)])) => false
    excludes(Pat.PWild, Term.TInt(1)) => false

fn isLiteral(t: Term) -> Bool
    ? "An Int, Bool, text or unit literal."
    match t
        Term.TInt(n) -> true
        Term.TBool(b) -> true
        Term.TStr(s) -> true
        Term.TUnit -> true
        _ -> false

verify isLiteral
    isLiteral(Term.TVar("x")) => false

fn sameKind(a: Term, b: Term) -> Bool
    ? "Two literals of the same type."
    match (a, b)
        (Term.TInt(x), Term.TInt(y)) -> true
        (Term.TBool(x), Term.TBool(y)) -> true
        (Term.TStr(x), Term.TStr(y)) -> true
        (Term.TUnit, Term.TUnit) -> true
        _ -> false

verify sameKind
    sameKind(Term.TInt(1), Term.TBool(true)) => false

fn armEquation(s: Term, chosen: Arm, outer: List<Binding>, ys: List<Term>, q: Proof, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "subject = pattern must be what the premise proves; then lhs equals the arm's body."
    shape = patTerm(chosen.pattern, ys, path)?
    names = Kernel.Subst.patNames(chosen.pattern)
    inner = List.concat(zipBind(names, ys), outer)
    needed = Eqn(lhs = Kernel.Subst.subst(s, outer)?, rhs = shape)
    got = conclude(q, env, "{path}/premise")?
    match got == needed
        false -> refuse(path, "the premise does not select this arm")
        true -> Result.Ok(Eqn(lhs = lhs, rhs = Kernel.Subst.subst(chosen.body, inner)?))

verify armEquation
    armEquation(Term.TVar("c"), Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(1)), [], [], Proof.PHyp("h"), Term.TUnit, withHyp(emptyEnv(), "h", Term.TVar("c"), false), "p") => Result.Err("step p: the premise does not select this arm")

fn armAt(arms: List<Arm>, k: Int) -> Option<Arm>
    ? "Arm k, counting from 1."
    match (arms, k)
        ([a, ..rest], 1) -> Option.Some(a)
        ([a, ..rest], _) -> match k > 1
            true -> armAt(rest, k - 1)
            false -> Option.None
        _ -> Option.None

verify armAt
    armAt([], 1) => Option.None
    armAt([Arm(pattern = Pat.PWild, body = Term.TUnit)], 0) => Option.None

fn earlierExclude(arms: List<Arm>, k: Int, p: Pat) -> Bool
    ? "Every arm before arm k has a head pattern p cannot share."
    match (arms, k > 1)
        ([a, ..rest], true) -> Bool.and(headsDiffer(a.pattern, p), earlierExclude(rest, k - 1, p))
        _ -> true

verify earlierExclude
    earlierExclude([Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TUnit)], 2, Pat.PLit(Term.TBool(true))) => true

fn headsDiffer(a: Pat, b: Pat) -> Bool
    ? "Two patterns no value can both match."
    match (a, b)
        (Pat.PLit(x), Pat.PLit(y)) -> x != y
        (Pat.PNil, Pat.PCons(h, t)) -> true
        (Pat.PCons(h, t), Pat.PNil) -> true
        (Pat.PCtor(c, xs), Pat.PCtor(d, ys)) -> c != d
        _ -> false

verify headsDiffer
    headsDiffer(Pat.PWild, Pat.PNil) => false
    headsDiffer(Pat.PCtor("A", []), Pat.PCtor("B", [])) => true

fn patTerm(p: Pat, ys: List<Term>, path: String) -> Result<Term, String>
    ? "The value a pattern denotes once its names are bound to ys."
    match (p, ys)
        (Pat.PLit(t), []) -> Result.Ok(t)
        (Pat.PNil, []) -> Result.Ok(Term.TList([]))
        (Pat.PCons(h, t), [x, y]) -> consTerm(h, t, x, y, path)
        (Pat.PCtor(c, names), _) -> ctorTerm(c, names, ys, path)
        _ -> Result.Err("step {path}: this pattern has no term to equate the subject with")

verify patTerm
    patTerm(Pat.PWild, [], "p") => Result.Err("step p: this pattern has no term to equate the subject with")

fn consTerm(h: String, t: String, x: Term, y: Term, path: String) -> Result<Term, String>
    ? "A cons pattern with both parts named."
    match Bool.or(h == "_", t == "_")
        true -> Result.Err("step {path}: a wildcard part has no term")
        false -> Result.Ok(Term.TBi("List.prepend", [x, y]))

verify consTerm
    consTerm("h", "_", Term.TInt(1), Term.TList([]), "p") => Result.Err("step p: a wildcard part has no term")

fn ctorTerm(c: String, names: List<String>, ys: List<Term>, path: String) -> Result<Term, String>
    ? "A constructor pattern with every field named."
    match Bool.and(List.len(names) == List.len(ys), Bool.not(List.contains(names, "_")))
        true -> Result.Ok(Term.TCtor(c, ys))
        false -> Result.Err("step {path}: the binders do not fit the constructor pattern")

verify ctorTerm
    ctorTerm("Option.Some", ["x"], [Term.TInt(1)], "p") => Result.Ok(Term.TCtor("Option.Some", [Term.TInt(1)]))
    ctorTerm("Option.Some", ["x"], [], "p") => Result.Err("step p: the binders do not fit the constructor pattern")

fn boundNames(bs: List<Binding>) -> List<String>
    ? "The names a substitution binds, in order."
    match bs
        [] -> []
        [b, ..rest] -> List.prepend(b.name, boundNames(rest))

verify boundNames
    boundNames([Kernel.Term.bind("a", Term.TUnit)]) => ["a"]

fn instantiate(e: Eqn, bs: List<Binding>, path: String) -> Result<Eqn, String>
    ? "An equation at a substitution."
    match (Kernel.Subst.subst(e.lhs, bs), Kernel.Subst.subst(e.rhs, bs))
        (Result.Ok(l), Result.Ok(r)) -> Result.Ok(Eqn(lhs = l, rhs = r))
        _ -> refuse(path, "the substitution captures a bound name")

verify instantiate
    instantiate(Eqn(lhs = Term.TVar("a"), rhs = Term.TVar("a")), [Kernel.Term.bind("a", Term.TInt(2))], "p") => Result.Ok(Eqn(lhs = Term.TInt(2), rhs = Term.TInt(2)))

fn premisesHold(wanted: List<Eqn>, ps: List<Proof>, bs: List<Binding>, env: Env, path: String, i: Int) -> Result<Unit, String>
    ? "Each premise proof proves its premise at the substitution."
    match (wanted, ps)
        ([], []) -> Result.Ok(Unit)
        ([w, ..ws], [p, ..rest]) -> premiseHolds(w, p, ws, rest, bs, env, path, i)
        _ -> Result.Err("step {path}: wrong number of premises")

verify premisesHold
    premisesHold([], [Proof.PHyp("h")], [], emptyEnv(), "p", 0) => Result.Err("step p: wrong number of premises")

fn premiseHolds(w: Eqn, p: Proof, ws: List<Eqn>, rest: List<Proof>, bs: List<Binding>, env: Env, path: String, i: Int) -> Result<Unit, String>
    ? "One premise, then the rest."
    want = instantiate(w, bs, path)?
    got = conclude(p, env, "{path}/premise.{i}")?
    match got == want
        false -> Result.Err("step {path}: premise {i} does not match")
        true -> premisesHold(ws, rest, bs, env, path, i + 1)

verify premiseHolds
    premiseHolds(Eqn(lhs = Term.TVar("a"), rhs = Term.TBool(true)), Proof.PRefl(Term.TInt(1)), [], [], [], emptyEnv(), "p", 0) => Result.Err("step p: premise 0 does not match")

fn rule(id: String, bs: List<Binding>, ps: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "A wall rule at an explicit substitution of all its binders."
    match Kernel.Rules.schema(id)
        Option.None -> refuse(path, "unknown rule {id}")
        Option.Some(s) -> match boundNames(bs) == s.binders
            false -> refuse(path, "rule {id} binds {commaJoined(s.binders)}")
            true -> ruleConclusion(s.premises, s.concl, bs, ps, env, path)

verify rule
    rule("int.add_comm", [Kernel.Term.bind("a", Term.TInt(1))], [], emptyEnv(), "p") => Result.Err("step p: rule int.add_comm binds a,b")
    rule("int.add_comm", [Kernel.Term.bind("a", Term.TInt(1)), Kernel.Term.bind("b", Term.TInt(2))], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TOp("+", Term.TInt(1), Term.TInt(2)), rhs = Term.TOp("+", Term.TInt(2), Term.TInt(1))))

fn ruleConclusion(wanted: List<Eqn>, concl: Eqn, bs: List<Binding>, ps: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "Premises first, then the conclusion."
    premisesHold(wanted, ps, bs, env, path, 0)?
    instantiate(concl, bs, path)

verify ruleConclusion
    ruleConclusion([], Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TUnit))

fn findLaw(key: String, ls: List<Law>) -> Option<Law>
    ? "A cited law by key."
    match ls
        [] -> Option.None
        [l, ..rest] -> match l.key == key
            true -> Option.Some(l)
            false -> findLaw(key, rest)

verify findLaw
    findLaw("k", []) => Option.None

fn lawStep(key: String, bs: List<Binding>, ps: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "An earlier law at an explicit substitution of all its givens, its when proved."
    match findLaw(key, env.laws)
        Option.None -> refuse(path, "law {key} is not cited")
        Option.Some(l) -> match boundNames(bs) == l.givens
            false -> refuse(path, "law {key} quantifies {commaJoined(l.givens)}")
            true -> ruleConclusion(lawPremises(l), Eqn(lhs = l.lhs, rhs = l.rhs), bs, ps, env, path)

verify lawStep
    lawStep("k", [], [], emptyEnv(), "p") => Result.Err("step p: law k is not cited")

fn lawPremises(l: Law) -> List<Eqn>
    ? "A law's when as a premise equation."
    match l.premise
        [p, ..rest] -> [Eqn(lhs = p, rhs = Term.TBool(true))]
        [] -> []

verify lawPremises
    lawPremises(Law(key = "k", givens = [], premise = [], lhs = Term.TUnit, rhs = Term.TUnit)) => []

fn checkScript(s: Script) -> Result<String, String>
    ? "The proof must prove exactly the obligation, under its when; every cited builtin fact is checked first."
    Kernel.Induct.refuseMutualRecursion(s.defs)?
    checkFacts(s.facts, [])?
    env = Env(defs = s.defs, consts = s.consts, laws = List.concat(s.laws, factLaws(s.facts)), hyps = lawHyps(s.obligation), finite = s.finite, lists = s.lists, ints = s.ints, givens = s.obligation.givens)
    e = conclude(s.proof, env, "proof")?
    match e == Eqn(lhs = s.obligation.lhs, rhs = s.obligation.rhs)
        true -> Result.Ok(s.obligation.key)
        false -> Result.Err("step proof: the proof ends at a different equation than the claim")

verify checkScript
    checkScript(Script(obligation = Law(key = "k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(1)), finite = [], lists = [], ints = [], defs = [], consts = [], laws = [], facts = [], proof = Proof.PRefl(Term.TInt(1)))) => Result.Ok("k")
    checkScript(Script(obligation = Law(key = "k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(2)), finite = [], lists = [], ints = [], defs = [], consts = [], laws = [], facts = [], proof = Proof.PRefl(Term.TInt(1)))) => Result.Err("step proof: the proof ends at a different equation than the claim")

fn lawHyps(ob: Law) -> List<Hyp>
    ? "The obligation's when, as hypothesis `when`."
    match ob.premise
        [p, ..rest] -> [Hyp(name = "when", eqn = Eqn(lhs = p, rhs = Term.TBool(true)))]
        [] -> []

verify lawHyps
    lawHyps(Law(key = "k", givens = [], premise = [Term.TVar("c")], lhs = Term.TUnit, rhs = Term.TUnit)) => [Hyp(name = "when", eqn = Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))]

fn commaJoined(ns: List<String>) -> String
    ? "Names separated by commas."
    String.join(ns, ",")

verify commaJoined
    commaJoined(["a", "b"]) => "a,b"

fn induct(f: String, xs: List<Term>, claim: Eqn, carry: List<String>, cs: List<Case>, env: Env, path: String) -> Result<Eqn, String>
    ? "Induction along the recursion of f at arguments xs: one case per arm of its match, each with one hypothesis per recursive call in the arm. The hypotheses named in carry hold at each case's pattern; a call's hypothesis holds once they are proved at the call's arguments."
    match findDef(f, env.defs)
        Option.None -> refuse(path, "no definition of {f}")
        Option.Some(d) -> match (Kernel.Induct.structuralParam(d), d.body)
            (Result.Err(why), _) -> refuse(path, why)
            (Result.Ok(Option.None), _) -> refuse(path, "{f} does not recurse")
            (Result.Ok(Option.Some(j)), Term.TMatch(s, arms)) -> inductOn(d, j, arms, xs, claim, carry, cs, env, path)
            _ -> refuse(path, "the body of {f} is not a match")

verify induct
    induct("f", [], Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [], [], emptyEnv(), "p") => Result.Err("step p: no definition of f")

fn inductOn(d: Def, j: Int, arms: List<Arm>, xs: List<Term>, claim: Eqn, carry: List<String>, cs: List<Case>, env: Env, path: String) -> Result<Eqn, String>
    ? "The arguments, the varied givens and the shape of the arms, then every case."
    match (List.len(xs) == List.len(d.params), Kernel.Induct.varied(xs, j, env.givens))
        (false, _) -> refuse(path, "{d.name} takes {List.len(d.params)} arguments")
        (_, Result.Err(why)) -> refuse(path, why)
        (true, Result.Ok(vr)) -> inductChecked(d, j, arms, xs, claim, namedHyps(carry, env.hyps, path)?, cs, vr, env, path)

verify inductOn
    inductOn(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TUnit), 0, [], [], Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [], [], emptyEnv(), "p") => Result.Err("step p: f takes 1 arguments")

fn inductChecked(d: Def, j: Int, arms: List<Arm>, xs: List<Term>, claim: Eqn, carried: List<Hyp>, cs: List<Case>, vr: Varied, env: Env, path: String) -> Result<Eqn, String>
    ? "One case per arm; the arms are one per constructor. The cases see the carried hypotheses and those that mention nothing the induction varies."
    varying = List.prepend(vr.v, placeNames(vr.general))
    match (List.len(arms) == List.len(cs), armsAreConstructors(arms))
        (false, _) -> refuse(path, "{List.len(arms)} arms, {List.len(cs)} cases")
        (_, false) -> refuse(path, "the arms are not one per constructor")
        _ -> inductCases(d, j, arms, cs, Kernel.Induct.Call(args = xs, inner = []), claim, vr, takenNames(claim, env.hyps), carried, withHyps(env, notMentioningAny(env.hyps, varying)), path, 0)

verify inductChecked
    inductChecked(Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), 0, [], [], Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("x")), [], [Case(binders = [], ihs = [], carry = [], more = [], proof = Proof.PRefl(Term.TUnit))], Varied(v = "x", general = []), emptyEnv(), "p") => Result.Err("step p: 0 arms, 1 cases")

fn notMentioningAny(hs: List<Hyp>, names: List<String>) -> List<Hyp>
    ? "The hypotheses that mention none of the names."
    match hs
        [] -> []
        [h, ..rest] -> match hypsMention([h], names)
            true -> notMentioningAny(rest, names)
            false -> List.prepend(h, notMentioningAny(rest, names))

verify notMentioningAny
    notMentioningAny([Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("n"), rhs = Term.TBool(true))), Hyp(name = "k", eqn = Eqn(lhs = Term.TVar("m"), rhs = Term.TBool(true)))], ["m", "z"]) => [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("n"), rhs = Term.TBool(true)))]

fn placeNames(ps: List<Place>) -> List<String>
    ? "The names of the varied places."
    match ps
        [] -> []
        [p, ..rest] -> List.prepend(p.name, placeNames(rest))

verify placeNames
    placeNames([Place(at = 1, name = "acc")]) => ["acc"]

fn hypsMention(hs: List<Hyp>, names: List<String>) -> Bool
    ? "Whether some hypothesis mentions one of the names."
    match hs
        [] -> false
        [h, ..rest] -> Bool.or(anyIn(List.concat(Kernel.Subst.freeVars(h.eqn.lhs), Kernel.Subst.freeVars(h.eqn.rhs)), names), hypsMention(rest, names))

verify hypsMention
    hypsMention([], ["x"]) => false

fn anyIn(ns: List<String>, names: List<String>) -> Bool
    ? "Whether one of ns is among names."
    match ns
        [] -> false
        [n, ..rest] -> Bool.or(List.contains(names, n), anyIn(rest, names))

verify anyIn
    anyIn(["a", "b"], ["b"]) => true

fn takenNames(claim: Eqn, hs: List<Hyp>) -> List<String>
    ? "Names a case may not take for its pattern variables: those of the claim and of the hypotheses."
    List.concat(List.concat(Kernel.Subst.freeVars(claim.lhs), Kernel.Subst.freeVars(claim.rhs)), hypNames(hs))

verify takenNames
    takenNames(Eqn(lhs = Term.TVar("a"), rhs = Term.TInt(1)), []) => ["a"]

fn hypNames(hs: List<Hyp>) -> List<String>
    ? "Variables the hypotheses mention."
    match hs
        [] -> []
        [h, ..rest] -> List.concat(List.concat(Kernel.Subst.freeVars(h.eqn.lhs), Kernel.Subst.freeVars(h.eqn.rhs)), hypNames(rest))

verify hypNames
    hypNames([]) => []

fn armsAreConstructors(arms: List<Arm>) -> Bool
    ? "Every pattern is [], [h, ..t] or a constructor, and [] comes with [h, ..t]."
    Bool.and(allConstructorPatterns(arms), hasNil(arms) == hasCons(arms))

verify armsAreConstructors
    armsAreConstructors([Arm(pattern = Pat.PNil, body = Term.TUnit)]) => false
    armsAreConstructors([Arm(pattern = Pat.PCtor("N.Z", []), body = Term.TUnit)]) => true

fn allConstructorPatterns(arms: List<Arm>) -> Bool
    ? "No literal, wildcard or name pattern."
    match arms
        [] -> true
        [a, ..rest] -> Bool.and(isConstructorPattern(a.pattern), allConstructorPatterns(rest))

verify allConstructorPatterns
    allConstructorPatterns([Arm(pattern = Pat.PWild, body = Term.TUnit)]) => false

fn isConstructorPattern(p: Pat) -> Bool
    ? "[], [h, ..t] or a constructor."
    match p
        Pat.PNil -> true
        Pat.PCons(h, t) -> true
        Pat.PCtor(c, ns) -> true
        _ -> false

verify isConstructorPattern
    isConstructorPattern(Pat.PLit(Term.TInt(0))) => false

fn hasNil(arms: List<Arm>) -> Bool
    ? "An arm for the empty list."
    match arms
        [] -> false
        [a, ..rest] -> Bool.or(a.pattern == Pat.PNil, hasNil(rest))

verify hasNil
    hasNil([]) => false

fn hasCons(arms: List<Arm>) -> Bool
    ? "An arm for a nonempty list."
    match arms
        [] -> false
        [a, ..rest] -> Bool.or(isCons(a.pattern), hasCons(rest))

verify hasCons
    hasCons([Arm(pattern = Pat.PCons("h", "t"), body = Term.TUnit)]) => true

fn isCons(p: Pat) -> Bool
    ? "A [h, ..t] pattern."
    match p
        Pat.PCons(h, t) -> true
        _ -> false

verify isCons
    isCons(Pat.PNil) => false

fn inductCases(d: Def, j: Int, arms: List<Arm>, cs: List<Case>, at: Call, claim: Eqn, vr: Varied, taken: List<String>, carried: List<Hyp>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "Each arm with its case, in order; the result is the claim."
    match (arms, cs)
        ([a, ..moreArms], [c, ..moreCases]) -> inductNext(inductCase(d, j, a, c, at, claim, vr, taken, carried, env, "{path}/case.{i}"), d, j, moreArms, moreCases, at, claim, vr, taken, carried, env, path, i + 1)
        _ -> Result.Ok(claim)

verify inductCases
    inductCases(Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), 0, [], [], Kernel.Induct.Call(args = [], inner = []), Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], [], emptyEnv(), "p", 0) => Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TUnit))

fn inductNext(done: Result<Unit, String>, d: Def, j: Int, arms: List<Arm>, cs: List<Case>, at: Call, claim: Eqn, vr: Varied, taken: List<String>, carried: List<Hyp>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "The rest of the cases, once this one checked."
    done?
    inductCases(d, j, arms, cs, at, claim, vr, taken, carried, env, path, i)

verify inductNext
    inductNext(Result.Err("no"), Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), 0, [], [], Kernel.Induct.Call(args = [], inner = []), Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], [], emptyEnv(), "p", 0) => Result.Err("no")

fn inductCase(d: Def, j: Int, a: Arm, c: Case, at: Call, claim: Eqn, vr: Varied, taken: List<String>, carried: List<Hyp>, env: Env, path: String) -> Result<Unit, String>
    ? "Fresh names for the arm's pattern; the claim at the pattern, under one hypothesis per recursive call at that call's arguments."
    names = Kernel.Subst.patNames(a.pattern)
    match (List.len(names) == List.len(c.binders), freshAll(c.binders, taken, env, []))
        (false, _) -> refuseCase(path, "wrong number of names")
        (_, false) -> refuseCase(path, "the names are not fresh")
        _ -> inductCaseNamed(d, j, a, c, namesToVars(c.binders), at, claim, vr, carried, env, path)

verify inductCase
    inductCase(Def(name = "f", returnsBool = false, params = [], lets = [], body = Term.TUnit), 0, Arm(pattern = Pat.PNil, body = Term.TUnit), Case(binders = ["y"], ihs = [], carry = [], more = [], proof = Proof.PRefl(Term.TUnit)), Kernel.Induct.Call(args = [], inner = []), Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], [], emptyEnv(), "p") => Result.Err("step p: wrong number of names")

fn refuseCase(path: String, why: String) -> Result<Unit, String>
    ? "A refusal of an induction case, naming it."
    Result.Err("step {path}: {why}")

verify refuseCase
    refuseCase("p", "no") => Result.Err("step p: no")

fn freshAll(bs: List<String>, taken: List<String>, env: Env, before: List<String>) -> Bool
    ? "No name is taken, a given, a module-level binding, or repeated."
    match bs
        [] -> true
        [b, ..rest] -> Bool.and(Bool.not(Bool.or(Bool.or(List.contains(taken, b), List.contains(env.givens, b)), Bool.or(isConst(b, env.consts), List.contains(before, b)))), freshAll(rest, taken, env, List.prepend(b, before)))

verify freshAll
    freshAll(["y", "y"], [], emptyEnv(), []) => false
    freshAll(["y"], ["x"], emptyEnv(), []) => true

fn isConst(n: String, cs: List<Const>) -> Bool
    ? "Whether n names a module-level binding."
    match cs
        [] -> false
        [c, ..rest] -> Bool.or(c.name == n, isConst(n, rest))

verify isConst
    isConst("a", []) => false

fn namesToVars(ns: List<String>) -> List<Term>
    ? "Each name as a variable."
    match ns
        [] -> []
        [n, ..rest] -> List.prepend(Term.TVar(n), namesToVars(rest))

verify namesToVars
    namesToVars(["a"]) => [Term.TVar("a")]

fn inductCaseNamed(d: Def, j: Int, a: Arm, c: Case, ys: List<Term>, at: Call, claim: Eqn, vr: Varied, carried: List<Hyp>, env: Env, path: String) -> Result<Unit, String>
    ? "The goal and the carried hypotheses at the arm's pattern, and the hypotheses of its recursive calls; then the case's proof must prove the goal."
    value = patTerm(a.pattern, ys, path)?
    here = [Kernel.Term.bind(vr.v, value)]
    goal = instantiate(claim, here, path)?
    scope = withHyps(env, List.concat(hypsAt(carried, here, path)?, env.hyps))
    names = Kernel.Subst.patNames(a.pattern)
    rename = List.concat(zipBind(names, ys), withoutNames(zipBind(d.params, at.args), names))
    calls = Kernel.Induct.selfCalls(a.body, d.name, [])
    match (List.len(calls) == List.len(c.ihs), List.len(c.carry) == List.len(c.ihs))
        (false, _) -> refuseCase(path, "{List.len(calls)} recursive calls, {List.len(c.ihs)} hypotheses")
        (_, false) -> refuseCase(path, "one list of carried proofs per hypothesis")
        _ -> caseProves(c.proof, goal, withHyps(scope, List.concat(moreHyps(c.more, calls, rename, j, claim, vr, carried, scope, path)?, List.concat(ihHyps(calls, c.ihs, c.carry, rename, j, claim, vr, carried, scope, path)?, scope.hyps))), path)

verify inductCaseNamed
    inductCaseNamed(Def(name = "f", returnsBool = false, params = ["x"], lets = [], body = Term.TUnit), 0, Arm(pattern = Pat.PNil, body = Term.TInt(0)), Case(binders = [], ihs = ["ih"], carry = [[]], more = [], proof = Proof.PRefl(Term.TUnit)), [], Kernel.Induct.Call(args = [Term.TVar("x")], inner = []), Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("x")), Varied(v = "x", general = []), [], emptyEnv(), "p") => Result.Err("step p: 0 recursive calls, 1 hypotheses")

fn hypsAt(hs: List<Hyp>, bs: List<Binding>, path: String) -> Result<List<Hyp>, String>
    ? "Each hypothesis at a substitution, under its own name."
    match hs
        [] -> Result.Ok([])
        [h, ..rest] -> Result.Ok(List.prepend(Hyp(name = h.name, eqn = instantiate(h.eqn, bs, path)?), hypsAt(rest, bs, path)?))

verify hypsAt
    hypsAt([Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TBool(true)))], [Kernel.Term.bind("x", Term.TInt(1))], "p") => Result.Ok([Hyp(name = "h", eqn = Eqn(lhs = Term.TInt(1), rhs = Term.TBool(true)))])

fn withoutNames(bs: List<Binding>, names: List<String>) -> List<Binding>
    ? "Bindings for names a pattern does not shadow."
    match bs
        [] -> []
        [b, ..rest] -> match List.contains(names, b.name)
            true -> withoutNames(rest, names)
            false -> List.prepend(b, withoutNames(rest, names))

verify withoutNames
    withoutNames([Kernel.Term.bind("t", Term.TUnit)], ["t"]) => []

fn ihHyps(calls: List<Kernel.Induct.Call>, ihs: List<String>, carry: List<List<Proof>>, rename: List<Binding>, j: Int, claim: Eqn, vr: Varied, carried: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "One hypothesis per recursive call, later ones in front: the claim at that call's arguments, once each carried hypothesis is proved there. A call named _ gives none."
    match (calls, ihs, carry)
        ([c, ..moreCalls], [h, ..moreNames], [ps, ..moreProofs]) -> Result.Ok(List.concat(ihHyps(moreCalls, moreNames, moreProofs, rename, j, claim, vr, carried, scope, path)?, ihTaken(c, h, ps, rename, j, claim, vr, carried, scope, path)?))
        _ -> Result.Ok([])

verify ihHyps
    ihHyps([], [], [], [], 0, Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], emptyEnv(), "p") => Result.Ok([])

fn moreHyps(ms: List<More>, calls: List<Kernel.Induct.Call>, rename: List<Binding>, j: Int, claim: Eqn, vr: Varied, carried: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "One hypothesis per entry, later ones in front: the claim at the part recursive call K recurses on and at the entry's values of the varied givens, once each carried hypothesis is proved there."
    match ms
        [] -> Result.Ok([])
        [m, ..rest] -> match (callAt(calls, m.call), List.len(m.ih.at) == List.len(vr.general), List.len(m.ih.carry) == List.len(carried))
            (Option.None, _, _) -> Result.Err("step {path}: no recursive call {m.call}")
            (_, false, _) -> Result.Err("step {path}: {m.ih.name} gives {List.len(m.ih.at)} values for {List.len(vr.general)} varied givens")
            (_, _, false) -> Result.Err("step {path}: one proof per carried hypothesis")
            (Option.Some(c), true, true) -> Result.Ok(List.concat(moreHyps(rest, calls, rename, j, claim, vr, carried, scope, path)?, ihHolds(List.prepend(partBinding(ihAt(c, rename, j, vr, path)?, path)?, zipBind(placeNames(vr.general), m.ih.at)), m.ih.name, m.ih.carry, claim, carried, scope, path)?))

verify moreHyps
    moreHyps([More(call = 1, ih = IhAt(name = "ih", at = [], carry = []))], [Kernel.Induct.Call(args = [Term.TVar("t")], inner = [])], [], 0, Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("x")), Varied(v = "x", general = []), [], emptyEnv(), "p") => Result.Err("step p: no recursive call 1")
    moreHyps([More(call = 0, ih = IhAt(name = "ih", at = [], carry = []))], [Kernel.Induct.Call(args = [Term.TVar("t"), Term.TVar("a")], inner = [])], [], 0, Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("acc")), Varied(v = "x", general = [Place(at = 1, name = "acc")]), [], emptyEnv(), "p") => Result.Err("step p: ih gives 0 values for 1 varied givens")
    moreHyps([More(call = 0, ih = IhAt(name = "ih", at = [Term.TInt(5)], carry = []))], [Kernel.Induct.Call(args = [Term.TVar("t"), Term.TVar("a")], inner = [])], [], 0, Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("acc")), Varied(v = "x", general = [Place(at = 1, name = "acc")]), [], emptyEnv(), "p") => Result.Ok([Hyp(name = "ih", eqn = Eqn(lhs = Term.TVar("t"), rhs = Term.TInt(5)))])

fn callAt(calls: List<Kernel.Induct.Call>, k: Int) -> Option<Kernel.Induct.Call>
    ? "The recursive call at place k."
    match calls
        [] -> Option.None
        [c, ..rest] -> match k == 0
            true -> Option.Some(c)
            false -> callAt(rest, k - 1)

verify callAt
    callAt([], 0) => Option.None

fn partBinding(bs: List<Binding>, path: String) -> Result<Binding, String>
    ? "The binding of the given inducted on, which ihAt puts first."
    match bs
        [b, ..rest] -> Result.Ok(b)
        [] -> Result.Err("step {path}: a recursive call binds nothing")

verify partBinding
    partBinding([Kernel.Term.bind("x", Term.TVar("t"))], "p") => Result.Ok(Kernel.Term.bind("x", Term.TVar("t")))
    partBinding([], "p") => Result.Err("step p: a recursive call binds nothing")

fn ihTaken(c: Kernel.Induct.Call, h: String, ps: List<Proof>, rename: List<Binding>, j: Int, claim: Eqn, vr: Varied, carried: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "The hypothesis of one call, unless it is named _."
    match (h == "_", List.len(ps) == List.len(carried))
        (true, _) -> Result.Ok([])
        (_, false) -> Result.Err("step {path}: one proof per carried hypothesis")
        _ -> ihHolds(ihAt(c, rename, j, vr, path)?, h, ps, claim, carried, scope, path)

verify ihTaken
    ihTaken(Kernel.Induct.Call(args = [Term.TVar("t")], inner = []), "_", [], [], 0, Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], emptyEnv(), "p") => Result.Ok([])
    ihTaken(Kernel.Induct.Call(args = [Term.TVar("t")], inner = []), "ih", [], [], 0, Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TBool(true)))], emptyEnv(), "p") => Result.Err("step p: one proof per carried hypothesis")

fn ihHolds(bs: List<Binding>, h: String, ps: List<Proof>, claim: Eqn, carried: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "Each carried hypothesis proved at the call's arguments; then the claim there."
    carriedHold(carried, ps, bs, scope, "{path}/{h}")?
    Result.Ok([Hyp(name = h, eqn = instantiate(claim, bs, path)?)])

verify ihHolds
    ihHolds([Kernel.Term.bind("x", Term.TVar("t"))], "ih", [Proof.PHyp("h")], Eqn(lhs = Term.TVar("x"), rhs = Term.TInt(1)), [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TBool(true)))], withHyp(emptyEnv(), "h", Term.TVar("x"), true), "p") => Result.Err("step p/ih/carry.h: the case proves a different equation")
    ihHolds([Kernel.Term.bind("x", Term.TVar("t"))], "ih", [Proof.PHyp("h")], Eqn(lhs = Term.TVar("x"), rhs = Term.TInt(1)), [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TBool(true)))], withHyp(emptyEnv(), "h", Term.TVar("t"), true), "p") => Result.Ok([Hyp(name = "ih", eqn = Eqn(lhs = Term.TVar("t"), rhs = Term.TInt(1)))])

fn ihAt(c: Kernel.Induct.Call, rename: List<Binding>, j: Int, vr: Varied, path: String) -> Result<List<Binding>, String>
    ? "The varied givens bound to the call's arguments."
    match anyIn(Kernel.Subst.freeVarsAll(readArgs(c.args, j, vr.general, 0)), c.inner)
        true -> Result.Err("step {path}: a recursive call reads a name an inner match binds")
        false -> ihBindings(Kernel.Subst.substAll(c.args, rename)?, j, vr, path)

verify ihAt
    ihAt(Kernel.Induct.Call(args = [Term.TVar("t")], inner = ["t"]), [], 0, Varied(v = "x", general = []), "p") => Result.Err("step p: a recursive call reads a name an inner match binds")
    ihAt(Kernel.Induct.Call(args = [Term.TVar("t"), Term.TVar("y")], inner = ["y"]), [], 0, Varied(v = "x", general = []), "p") => Result.Ok([Kernel.Term.bind("x", Term.TVar("t"))])
    ihAt(Kernel.Induct.Call(args = [Term.TVar("t"), Term.TVar("y")], inner = ["y"]), [], 0, Varied(v = "x", general = [Place(at = 1, name = "ys")]), "p") => Result.Err("step p: a recursive call reads a name an inner match binds")

fn readArgs(xs: List<Term>, j: Int, ps: List<Place>, k: Int) -> List<Term>
    ? "The arguments a hypothesis reads: the one at place j and those at the varied places."
    match xs
        [] -> []
        [x, ..rest] -> match Bool.or(k == j, atPlace(ps, k))
            true -> List.prepend(x, readArgs(rest, j, ps, k + 1))
            false -> readArgs(rest, j, ps, k + 1)

verify readArgs
    readArgs([Term.TVar("t"), Term.TVar("y")], 0, [], 0) => [Term.TVar("t")]
    readArgs([Term.TVar("t"), Term.TVar("y")], 0, [Place(at = 1, name = "ys")], 0) => [Term.TVar("t"), Term.TVar("y")]

fn atPlace(ps: List<Place>, k: Int) -> Bool
    ? "Whether a varied given sits at place k."
    match ps
        [] -> false
        [p, ..rest] -> Bool.or(p.at == k, atPlace(rest, k))

verify atPlace
    atPlace([Place(at = 1, name = "ys")], 1) => true
    atPlace([], 0) => false

fn ihBindings(args: List<Term>, j: Int, vr: Varied, path: String) -> Result<List<Binding>, String>
    ? "The given at the matched place and the varied givens, each bound to the call's argument at its place."
    match Kernel.Induct.nthTerm(args, j)
        Option.None -> Result.Err("step {path}: a recursive call has too few arguments")
        Option.Some(at) -> Result.Ok(List.prepend(Kernel.Term.bind(vr.v, at), placeBindings(vr.general, args)))

verify ihBindings
    ihBindings([Term.TVar("t")], 0, Varied(v = "x", general = []), "p") => Result.Ok([Kernel.Term.bind("x", Term.TVar("t"))])

fn placeBindings(ps: List<Place>, args: List<Term>) -> List<Binding>
    ? "Each varied given bound to the call's argument at its place."
    match ps
        [] -> []
        [p, ..rest] -> List.prepend(Kernel.Term.bind(p.name, Option.withDefault(Kernel.Induct.nthTerm(args, p.at), Term.TVar(p.name))), placeBindings(rest, args))

verify placeBindings
    placeBindings([Place(at = 1, name = "acc")], [Term.TVar("t"), Term.TInt(3)]) => [Kernel.Term.bind("acc", Term.TInt(3))]

fn caseProves(p: Proof, goal: Eqn, env: Env, path: String) -> Result<Unit, String>
    ? "The case's proof proves exactly the goal."
    got = conclude(p, env, path)?
    match got == goal
        true -> Result.Ok(Unit)
        false -> Result.Err("step {path}: the case proves a different equation")

verify caseProves
    caseProves(Proof.PRefl(Term.TInt(1)), Eqn(lhs = Term.TInt(1), rhs = Term.TInt(2)), emptyEnv(), "p") => Result.Err("step p: the case proves a different equation")

fn listInduct(v: String, claim: Eqn, n: Proof, h: String, t: String, general: List<String>, ihs: List<IhAt>, c: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "Induction on a given of list type, for every value of the names in general: the claim at [], and at List.prepend(h, t) under one hypothesis per entry of ihs, the claim at t and that entry's values of general."
    match (List.contains(env.lists, v), hypsMention(env.hyps, List.prepend(v, general)), List.contains(general, v))
        (false, _, _) -> refuse(path, "{v} is not a given of list type")
        (_, true, _) -> refuse(path, "a hypothesis in scope mentions {v} or what it generalises")
        (_, _, true) -> refuse(path, "{v} is both inducted on and generalised")
        _ -> match freshAll([h, t], takenNames(claim, env.hyps), env, [])
            false -> refuse(path, "the names are not fresh")
            true -> listCases(v, claim, n, h, t, general, ihs, c, env, path)

verify listInduct
    listInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), Proof.PRefl(Term.TList([])), "h", "t", [], [], Proof.PRefl(Term.TUnit), emptyEnv(), "p") => Result.Err("step p: xs is not a given of list type")
    listInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("n")), Proof.PRefl(Term.TList([])), "h", "t", ["n"], [], Proof.PRefl(Term.TUnit), withHyp(listsEnv(["xs"]), "k", Term.TVar("n"), true), "p") => Result.Err("step p: a hypothesis in scope mentions xs or what it generalises")

fn listsEnv(ns: List<String>) -> Env
    ? "No definitions, laws or hypotheses, and these givens of list type."
    Env(defs = [], consts = [], laws = [], hyps = [], finite = [], lists = ns, ints = [], givens = ns)

verify listsEnv
    listsEnv(["xs"]).lists => ["xs"]

fn listCases(v: String, claim: Eqn, n: Proof, h: String, t: String, general: List<String>, ihs: List<IhAt>, c: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "The empty-list case, then the cell case under the claim at the tail."
    caseProves(n, instantiate(claim, [Kernel.Term.bind(v, Term.TList([]))], path)?, env, "{path}/nil")?
    goal = instantiate(claim, [Kernel.Term.bind(v, Term.TBi("List.prepend", [Term.TVar(h), Term.TVar(t)]))], path)?
    caseProves(c, goal, withHyps(env, List.concat(smallerHyps(v, Term.TVar(t), general, ihs, claim, [], env, path)?, env.hyps)), "{path}/cons")?
    Result.Ok(claim)

verify listCases
    listCases("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), Proof.PRefl(Term.TList([])), "h", "t", [], [IhAt(name = "ih", at = [], carry = [])], Proof.PRefl(Term.TBi("List.prepend", [Term.TVar("h"), Term.TVar("t")])), emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")))
    listCases("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), Proof.PRefl(Term.TList([])), "h", "t", [], [IhAt(name = "ih", at = [], carry = [])], Proof.PHyp("ih"), emptyEnv(), "p") => Result.Err("step p/cons: the case proves a different equation")
    listCases("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("n")), Proof.PRefl(Term.TList([])), "h", "t", ["n"], [IhAt(name = "ih", at = [Term.TInt(3)], carry = [])], Proof.PHyp("ih"), emptyEnv(), "p") => Result.Err("step p/nil: the case proves a different equation")

fn intInduct(v: String, claim: Eqn, g: String, base: Proof, names: List<String>, general: List<String>, ihs: List<IhAt>, step: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "Induction on a given of type Int down to zero, for every value of the names in general: the claim where v <= 0 (hypothesis g), and where v > 0 under one hypothesis per entry of ihs, the claim at v - 1 and that entry's values of general. The hypotheses carried hold there first; any other one that mentions v or general is out of scope."
    match (List.contains(env.ints, v), List.contains(general, v))
        (false, _) -> refuse(path, "{v} is not a given of type Int")
        (_, true) -> refuse(path, "{v} is both inducted on and generalised")
        _ -> intCases(v, claim, g, base, namedHyps(names, env.hyps, path)?, general, ihs, step, env, path)

verify intInduct
    intInduct("n", Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), "g", Proof.PRefl(Term.TVar("n")), [], [], [IhAt(name = "ih", at = [], carry = [])], Proof.PRefl(Term.TVar("n")), emptyEnv(), "p") => Result.Err("step p: n is not a given of type Int")
    intInduct("n", Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), "g", Proof.PRefl(Term.TVar("n")), [], ["n"], [], Proof.PRefl(Term.TVar("n")), intsEnv(["n"]), "p") => Result.Err("step p: n is both inducted on and generalised")
    intInduct("n", Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), "g", Proof.PRefl(Term.TVar("n")), [], [], [IhAt(name = "ih", at = [], carry = [])], Proof.PRefl(Term.TVar("n")), intsEnv(["n"]), "p") => Result.Ok(Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")))

fn intsEnv(ns: List<String>) -> Env
    ? "No definitions, laws or hypotheses, and these givens of type Int."
    Env(defs = [], consts = [], laws = [], hyps = [], finite = [], lists = [], ints = ns, givens = ns)

verify intsEnv
    intsEnv(["n"]).ints => ["n"]

fn intCases(v: String, claim: Eqn, g: String, base: Proof, cs: List<Hyp>, general: List<String>, ihs: List<IhAt>, step: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "The case v <= 0; then, where v > 0, the claim under its hypotheses. A case sees the carried hypotheses (the last named innermost), then g, then those that mention neither v nor general."
    guard = Term.TOp("<=", Term.TVar(v), Term.TInt(0))
    kept = notMentioningAny(env.hyps, List.prepend(v, general))
    inner = List.reverse(cs)
    caseProves(base, claim, withHyps(env, List.concat(inner, List.prepend(Hyp(name = g, eqn = Eqn(lhs = guard, rhs = Term.TBool(true))), kept))), "{path}/base")?
    above = withHyps(env, List.concat(inner, List.prepend(Hyp(name = g, eqn = Eqn(lhs = guard, rhs = Term.TBool(false))), kept)))
    caseProves(step, claim, withHyps(above, List.concat(smallerHyps(v, Term.TOp("-", Term.TVar(v), Term.TInt(1)), general, ihs, claim, cs, above, path)?, above.hyps)), "{path}/step")?
    Result.Ok(claim)

verify intCases
    intCases("n", Eqn(lhs = Term.TVar("n"), rhs = Term.TInt(0)), "g", Proof.PRefl(Term.TVar("n")), [], [], [], Proof.PRefl(Term.TVar("n")), intsEnv(["n"]), "p") => Result.Err("step p/base: the case proves a different equation")
    intCases("n", Eqn(lhs = Term.TOp("<=", Term.TVar("n"), Term.TInt(0)), rhs = Term.TBool(true)), "g", Proof.PHyp("g"), [], [], [], Proof.PHyp("g"), intsEnv(["n"]), "p") => Result.Err("step p/step: the case proves a different equation")
    intCases("n", Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), "g", Proof.PHyp("h"), [], [], [], Proof.PRefl(Term.TVar("n")), withHyp(intsEnv(["n"]), "h", Term.TVar("n"), true), "p") => Result.Err("step p/base: hypothesis h is not in scope")
    intCases("n", Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), "g", Proof.PRefl(Term.TVar("n")), [], ["a"], [], Proof.PHyp("h"), withHyp(intsEnv(["n"]), "h", Term.TVar("a"), true), "p") => Result.Err("step p/step: hypothesis h is not in scope")

fn smallerHyps(v: String, smaller: Term, general: List<String>, ihs: List<IhAt>, claim: Eqn, cs: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "One hypothesis per entry, later ones in front: the claim with v at the smaller value and general at the entry's values, once each carried hypothesis is proved there."
    match ihs
        [] -> Result.Ok([])
        [i, ..rest] -> match (List.len(i.at) == List.len(general), List.len(i.carry) == List.len(cs))
            (false, _) -> Result.Err("step {path}: {i.name} gives {List.len(i.at)} values for {List.len(general)} generalised givens")
            (_, false) -> Result.Err("step {path}: one proof per carried hypothesis")
            _ -> Result.Ok(List.concat(smallerHyps(v, smaller, general, rest, claim, cs, scope, path)?, ihHolds(List.prepend(Kernel.Term.bind(v, smaller), zipBind(general, i.at)), i.name, i.carry, claim, cs, scope, path)?))

verify smallerHyps
    smallerHyps("n", Term.TVar("m"), ["a"], [IhAt(name = "ih", at = [], carry = [])], Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("a")), [], intsEnv(["n"]), "p") => Result.Err("step p: ih gives 0 values for 1 generalised givens")
    smallerHyps("n", Term.TVar("m"), ["a"], [IhAt(name = "ih", at = [Term.TInt(7)], carry = [])], Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("a")), [], intsEnv(["n"]), "p") => Result.Ok([Hyp(name = "ih", eqn = Eqn(lhs = Term.TVar("m"), rhs = Term.TInt(7)))])
    smallerHyps("n", Term.TVar("m"), [], [IhAt(name = "ih", at = [], carry = [])], Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("n"), rhs = Term.TBool(true)))], intsEnv(["n"]), "p") => Result.Err("step p: one proof per carried hypothesis")

fn namedHyps(names: List<String>, scope: List<Hyp>, path: String) -> Result<List<Hyp>, String>
    ? "The hypotheses of these names, as they stand in scope."
    match names
        [] -> Result.Ok([])
        [n, ..rest] -> Result.Ok(List.prepend(Hyp(name = n, eqn = hyp(n, scope, path)?), namedHyps(rest, scope, path)?))

verify namedHyps
    namedHyps(["h"], [], "p") => Result.Err("step p: hypothesis h is not in scope")

fn carriedHold(cs: List<Hyp>, proofs: List<Proof>, down: List<Binding>, env: Env, path: String) -> Result<Unit, String>
    ? "Each carried hypothesis, at v - 1, proved by its proof."
    match (cs, proofs)
        ([c, ..more], [q, ..qs]) -> carriedThen(caseProves(q, instantiate(c.eqn, down, path)?, env, "{path}/carry.{c.name}"), more, qs, down, env, path)
        _ -> Result.Ok(Unit)

verify carriedHold
    carriedHold([], [], [], emptyEnv(), "p") => Result.Ok(Unit)
    carriedHold([Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("n"), rhs = Term.TBool(true)))], [Proof.PHyp("h")], [Kernel.Term.bind("n", Term.TInt(0))], withHyp(emptyEnv(), "h", Term.TVar("n"), true), "p") => Result.Err("step p/carry.h: the case proves a different equation")

fn carriedThen(done: Result<Unit, String>, cs: List<Hyp>, proofs: List<Proof>, down: List<Binding>, env: Env, path: String) -> Result<Unit, String>
    ? "The rest of the carried hypotheses, once this one held."
    done?
    carriedHold(cs, proofs, down, env, path)

verify carriedThen
    carriedThen(Result.Err("no"), [], [], [], emptyEnv(), "p") => Result.Err("no")

fn checkFacts(fs: List<Fact>, earlier: List<Law>) -> Result<Unit, String>
    ? "Each builtin fact proves its statement over builtins and the facts before it: no definitions, no other laws, no when."
    match fs
        [] -> Result.Ok(Unit)
        [f, ..rest] -> checkFactThen(checkScript(Script(obligation = f.law, finite = [], lists = f.lists, ints = [], defs = [], consts = [], laws = earlier, facts = [], proof = f.proof)), f.law, rest, earlier)

verify checkFacts
    checkFacts([], []) => Result.Ok(Unit)
    checkFacts([Fact(law = Law(key = "List.k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(2)), lists = [], proof = Proof.PRefl(Term.TInt(1)))], []) => Result.Err("fact List.k: step proof: the proof ends at a different equation than the claim")
    checkFacts([Fact(law = Law(key = "List.k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(2)), lists = [], proof = Proof.PLaw("List.j", [], []))], []) => Result.Err("fact List.k: step proof: law List.j is not cited")

fn checkFactThen(done: Result<String, String>, law: Law, rest: List<Fact>, earlier: List<Law>) -> Result<Unit, String>
    ? "The rest of the facts, once this one checked; they may cite it."
    match done
        Result.Ok(k) -> checkFacts(rest, List.concat(earlier, [law]))
        Result.Err(why) -> Result.Err("fact {law.key}: {why}")

verify checkFactThen
    checkFactThen(Result.Err("no"), Law(key = "List.k", givens = [], premise = [], lhs = Term.TUnit, rhs = Term.TUnit), [], []) => Result.Err("fact List.k: no")

fn factLaws(fs: List<Fact>) -> List<Law>
    ? "The statements of checked facts, as laws a step may cite."
    match fs
        [] -> []
        [f, ..rest] -> List.prepend(f.law, factLaws(rest))

verify factLaws
    factLaws([]) => []
