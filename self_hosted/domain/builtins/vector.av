module Vector
    depends [Domain.Value, Domain.Builtins.Helpers]
    intent = "Vector namespace builtins for the self-hosted evaluator."
    exposes [call]

fn call(name: String, args: List<Val>) -> Result<Val, String>
    ? "Dispatch Vector.* builtins."
    match name
        "Vector.new" -> builtinVectorNew(args)
        "Vector.get" -> builtinVectorGet(args)
        "Vector.set" -> builtinVectorSet(args)
        "Vector.len" -> builtinVectorLen(args)
        "Vector.fromList" -> builtinVectorFromList(args)
        "Vector.toList" -> builtinVectorToList(args)
        _ -> Result.Err("unknown vector builtin: {name}")

verify call
    call("Vector.len", [Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(2)]))]) => Result.Ok(Val.ValInt(2))
    call("Vector.bogus", [Val.ValInt(1)]) => Result.Err("unknown vector builtin: Vector.bogus")

fn builtinVectorNew(args: List<Val>) -> Result<Val, String>
    ? "Vector.new(size, default) -> Vector<T>."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (Val.ValInt(size), defaultVal) -> Result.Ok(Val.ValVector(Vector.new(size, defaultVal)))
        _ -> Result.Err("Vector.new: first arg must be Int")

verify builtinVectorNew
    builtinVectorNew([Val.ValInt(2), Val.ValInt(0)]) => Result.Ok(Val.ValVector(Vector.new(2, Val.ValInt(0))))
    builtinVectorNew([Val.ValStr("x"), Val.ValInt(0)]) => Result.Err("Vector.new: first arg must be Int")

fn builtinVectorGet(args: List<Val>) -> Result<Val, String>
    ? "Vector.get(vec, idx) -> Option<T>."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (Val.ValVector(vec), Val.ValInt(idx)) -> match Vector.get(vec, idx)
            Option.Some(v) -> Result.Ok(Val.ValSome(v))
            Option.None -> Result.Ok(Val.ValNone)
        _ -> Result.Err("Vector.get: expected (Vector, Int)")

verify builtinVectorGet
    builtinVectorGet([Val.ValVector(Vector.fromList([Val.ValInt(10), Val.ValInt(20)])), Val.ValInt(0)]) => Result.Ok(Val.ValSome(Val.ValInt(10)))
    builtinVectorGet([Val.ValVector(Vector.fromList([Val.ValInt(10)])), Val.ValInt(5)]) => Result.Ok(Val.ValNone)
    builtinVectorGet([Val.ValInt(1), Val.ValInt(0)]) => Result.Err("Vector.get: expected (Vector, Int)")

fn builtinVectorSet(args: List<Val>) -> Result<Val, String>
    ? "Vector.set(vec, idx, val) -> Option<Vector<T>>."
    match args
        [vecV, ..rest] -> match rest
            [idxV, ..rest2] -> match rest2
                [valV, ..ignored] -> builtinVectorSetInner(vecV, idxV, valV)
                _ -> Result.Err("Vector.set: expected 3 args")
            _ -> Result.Err("Vector.set: expected 3 args")
        _ -> Result.Err("Vector.set: expected 3 args")

verify builtinVectorSet
    builtinVectorSet([Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(2)])), Val.ValInt(1), Val.ValInt(9)]) => Result.Ok(Val.ValSome(Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(9)]))))
    builtinVectorSet([Val.ValInt(1)]) => Result.Err("Vector.set: expected 3 args")
    builtinVectorSet([]) => Result.Err("Vector.set: expected 3 args")

fn builtinVectorSetInner(vecV: Val, idxV: Val, valV: Val) -> Result<Val, String>
    ? "Validate types and bounds before delegating to builtinVectorSetInBounds."
    match vecV
        Val.ValVector(vec) -> match idxV
            Val.ValInt(idx) -> match idx < 0
                true -> Result.Ok(Val.ValNone)
                false -> match idx < Vector.len(vec)
                    true -> builtinVectorSetInBounds(vec, idx, valV)
                    false -> Result.Ok(Val.ValNone)
            _ -> Result.Err("Vector.set: second arg must be Int")
        _ -> Result.Err("Vector.set: first arg must be Vector")

verify builtinVectorSetInner
    builtinVectorSetInner(Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(2)])), Val.ValInt(1), Val.ValInt(9)) => Result.Ok(Val.ValSome(Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(9)]))))
    builtinVectorSetInner(Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(2)])), Val.ValInt(5), Val.ValInt(9)) => Result.Ok(Val.ValNone)
    builtinVectorSetInner(Val.ValInt(1), Val.ValInt(0), Val.ValInt(9)) => Result.Err("Vector.set: first arg must be Vector")

fn builtinVectorSetInBounds(vec: Vector<Val>, idx: Int, valV: Val) -> Result<Val, String>
    ? "Set a vector element when bounds have already been checked."
    match Vector.set(vec, idx, valV)
        Option.Some(newVec) -> Result.Ok(Val.ValSome(Val.ValVector(newVec)))
        Option.None -> Result.Err("Vector.set: index out of bounds")

verify builtinVectorSetInBounds
    builtinVectorSetInBounds(Vector.fromList([Val.ValInt(1), Val.ValInt(2)]), 0, Val.ValInt(9)) => Result.Ok(Val.ValSome(Val.ValVector(Vector.fromList([Val.ValInt(9), Val.ValInt(2)]))))
    builtinVectorSetInBounds(Vector.fromList([Val.ValInt(1)]), 5, Val.ValStr("x")) => Result.Err("Vector.set: index out of bounds")

fn builtinVectorLen(args: List<Val>) -> Result<Val, String>
    ? "Vector.len(vec) -> Int."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValVector(vec) -> Result.Ok(Val.ValInt(Vector.len(vec)))
        _ -> Result.Err("Vector.len: expected Vector")

verify builtinVectorLen
    builtinVectorLen([Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(2), Val.ValInt(3)]))]) => Result.Ok(Val.ValInt(3))
    builtinVectorLen([Val.ValInt(1)]) => Result.Err("Vector.len: expected Vector")

fn builtinVectorFromList(args: List<Val>) -> Result<Val, String>
    ? "Vector.fromList(list) -> Vector<T>."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValList(items) -> Result.Ok(Val.ValVector(Vector.fromList(items)))
        _ -> Result.Err("Vector.fromList: expected List")

verify builtinVectorFromList
    builtinVectorFromList([Val.ValList([Val.ValInt(1), Val.ValInt(2)])]) => Result.Ok(Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(2)])))
    builtinVectorFromList([Val.ValInt(1)]) => Result.Err("Vector.fromList: expected List")

fn builtinVectorToList(args: List<Val>) -> Result<Val, String>
    ? "Vector.toList(vec) -> List<T>."
    v = Domain.Builtins.Helpers.oneArg(args)?
    match v
        Val.ValVector(vec) -> Result.Ok(Val.ValList(Vector.toList(vec)))
        _ -> Result.Err("Vector.toList: expected Vector")

verify builtinVectorToList
    builtinVectorToList([Val.ValVector(Vector.fromList([Val.ValInt(1), Val.ValInt(2)]))]) => Result.Ok(Val.ValList([Val.ValInt(1), Val.ValInt(2)]))
    builtinVectorToList([Val.ValStr("x")]) => Result.Err("Vector.toList: expected Vector")
