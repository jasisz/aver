module Clock
    kind = capability
    semantics = effectful
    intent = "What the ticker asks for: a tick, and the score of one task."
    exposes [Tick, tick, score]

type Tick
    Tock

operation tick() -> Clock.Tick
    ? "The next tick."
    oracle = generative
    replay = recorded

operation score(task: Int) -> Int
    ? "What one task scores, or 0 when it could not be scored."
    oracle = generative
    replay = recorded
