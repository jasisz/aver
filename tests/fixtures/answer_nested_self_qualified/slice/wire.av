module Wire
    kind = capability
    semantics = effectful
    depends [Wait]
    intent = "Fixture capability under slice/: one frame at a time; its reply sum names its own type as Wire.Heard."
    exposes [Heard, FrameReply, frame]

type Heard
    Message(String)
    Gone(String)

type FrameReply
    Now(Wire.Heard)
    Later(Wait.Wake)
    Then(Wait.Wake, Heard)

operation frame() -> Heard
    ? "The next frame."
    oracle = generative
    replay = recorded
