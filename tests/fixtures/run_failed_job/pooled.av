module Pooled
    intent = "Fixture answer module: the answer this program gives to Pool, both ends of the job seam, and the ledger of what never landed."
    depends [Pool, Wait]
    exposes [State, fresh, claim, score, nextTask, landed]
    effects []

record State
    left: Int
    scored: Int
    rejected: List<String>

fn fresh() -> State
    ? "One handle to give out, nothing scored and nothing rejected."
    State(left = 1, scored = 0, rejected = [])

fn claim(state: State) -> Tuple<State, Pool.__ClaimReply>
    ? "One handle, until there are none."
    match state.left == 0
        true -> (state, Pool.__ClaimReply.Now(Option.None))
        false -> (State.update(state, left = state.left - 1), Pool.__ClaimReply.Now(Option.Some(state.left)))

fn score(task: Int) -> Int
    ? "What one job computes off the turn."
    task + 1

fn nextTask(state: State) -> Option<Int>
    ? "One task, and only out of the state a run starts from."
    match state.left == 1
        true -> Option.Some(state.left)
        false -> Option.None

fn landed(state: State, outcome: Result<Int, String>) -> State
    ? "Where a job that is over goes: its score, or the reason it will never have one. A run whose job was cancelled records the rejection and carries on."
    match outcome
        Result.Err(reason) -> State.update(state, rejected = List.concat(state.rejected, [reason]))
        Result.Ok(points) -> State.update(state, scored = state.scored + points)

verify claim
    claim(fresh()) => (State.update(fresh(), left = 0), Pool.__ClaimReply.Now(Option.Some(1)))

verify score
    score(1) => 2

verify nextTask
    nextTask(fresh()) => Option.Some(1)
    nextTask(State(left = 0, scored = 0, rejected = [])) => Option.None

verify landed
    landed(fresh(), Result.Ok(4)) => State.update(fresh(), scored = 4)
    landed(fresh(), Result.Err("work: job cancelled")) => State.update(fresh(), rejected = ["work: job cancelled"])
