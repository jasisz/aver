module Ledger
    intent = "An answer module that answers with the operation's own type."
    depends [Pool]
    exposes [State, claim, gone]
    effects []

record State
    free: List<Int>
    stopping: Bool

fn claim(state: State, key: Int) -> Pool.Assignment
    ? "The next height for this peer."
    Pool.Assignment.Idle

fn gone(state: State, key: Int) -> Unit
    ? "A peer that left gives its height back."
    Unit
