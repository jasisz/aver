module Chain
    kind = capability
    semantics = effectful
    intent = "Chain selection and the commit point."
    exposes [Landed, nextTarget, commit]

type Landed
    Connected
    Rejected(String)

operation nextTarget() -> Option<Int>
    ? "Which height is next to connect on the chain now chosen, or None once the chain is complete."
    oracle = generative
    replay = recorded

operation commit(height: Int, summary: String) -> Chain.Landed
    ? "Records that this height is connected."
    oracle = generative
    replay = recorded
