module Prop27
    intent =
        "TIP isaplanner prop_27: elem x ys implies elem x (xs ++ ys)."
    effects []

type Nat
    Z
    S(Nat)

fn eqNat(x: Nat, y: Nat) -> Bool
    match x
        Nat.Z -> match y
            Nat.Z -> true
            Nat.S(z) -> false
        Nat.S(x2) -> match y
            Nat.Z -> false
            Nat.S(y2) -> eqNat(x2, y2)

fn append(x: List<Nat>, y: List<Nat>) -> List<Nat>
    match x
        [] -> y
        [z, ..xs] -> List.concat([z], append(xs, y))

fn elem(x: Nat, y: List<Nat>) -> Bool
    match y
        [] -> false
        [z, ..xs] -> match eqNat(x, z)
            true -> true
            false -> elem(x, xs)

fn implies(a: Bool, b: Bool) -> Bool
    match a
        true -> b
        false -> true

verify elem law elemAppend
    given x: Nat = [Nat.Z, Nat.S(Nat.Z), Nat.S(Nat.S(Nat.Z))]
    given xs: List<Nat> = [[], [Nat.Z], [Nat.S(Nat.Z), Nat.Z]]
    given ys: List<Nat> = [[], [Nat.Z], [Nat.S(Nat.Z)]]
    implies(elem(x, ys), elem(x, append(xs, ys))) => true
