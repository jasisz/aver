module Records
    depends [Domain.Value]
    intent =
        "Record-update helpers for the self-hosted evaluator."
        "Keeps update-specific list munging out of the main call dispatch."
    exposes [isRecordUpdate, doRecordUpdate]

fn isRecordUpdate(name: String, args: List<Val>) -> Bool
    ? "Check if this is a Type.update(record, _named(...)) call."
    match String.contains(name, ".update")
        true -> hasNamedRecord(args)
        false -> false

verify isRecordUpdate
    isRecordUpdate("User.update", [Val.ValRecord("User", [("name", Val.ValStr("a"))]), Val.ValRecord("_named", [("name", Val.ValStr("b"))])]) => true
    isRecordUpdate("User.update", [Val.ValInt(1)]) => false
    isRecordUpdate("foo", [Val.ValRecord("_named", [])]) => false

fn hasNamedRecord(args: List<Val>) -> Bool
    ? "Check if last arg is a _named record sentinel."
    match List.len(args) == 2
        true -> isNamedSentinel(args)
        false -> false

verify hasNamedRecord
    hasNamedRecord([Val.ValInt(1), Val.ValRecord("_named", [])]) => true
    hasNamedRecord([Val.ValInt(1)]) => false
    hasNamedRecord([]) => false

fn isNamedSentinel(args: List<Val>) -> Bool
    ? "Check second element is ValRecord with _named tag."
    match args
        [_, ..rest] -> isNamedSentinelInner(rest)
        [] -> false

verify isNamedSentinel
    isNamedSentinel([Val.ValInt(1), Val.ValRecord("_named", [])]) => true
    isNamedSentinel([Val.ValInt(1), Val.ValInt(2)]) => false
    isNamedSentinel([]) => false

fn isNamedSentinelInner(rest: List<Val>) -> Bool
    ? "Check first element of rest is a _named record."
    match rest
        [v, ..ignored] -> match v
            Val.ValRecord(typeName, _) -> typeName == "_named"
            _ -> false
        [] -> false

verify isNamedSentinelInner
    isNamedSentinelInner([Val.ValRecord("_named", [])]) => true
    isNamedSentinelInner([Val.ValInt(1)]) => false
    isNamedSentinelInner([]) => false

fn doRecordUpdate(args: List<Val>) -> Result<Val, String>
    ? "Perform record update: merge named fields into base record."
    match args
        [baseVal, ..rest] -> doRecordUpdateInner(baseVal, rest)
        [] -> Result.Err("record update requires (record, named fields)")

verify doRecordUpdate
    doRecordUpdate([Val.ValRecord("User", [("x", Val.ValInt(1))]), Val.ValRecord("_named", [("x", Val.ValInt(2))])]) => Result.Ok(Val.ValRecord("User", [("x", Val.ValInt(2))]))
    doRecordUpdate([]) => Result.Err("record update requires (record, named fields)")

fn doRecordUpdateInner(baseVal: Val, rest: List<Val>) -> Result<Val, String>
    ? "Extract named fields from rest and apply update."
    match rest
        [namedVal, ..ignored] -> match namedVal
            Val.ValRecord(_, namedFields) -> applyRecordUpdate(baseVal, namedFields)
            _ -> Result.Err("record update requires named fields")
        [] -> Result.Err("record update requires named fields")

verify doRecordUpdateInner
    doRecordUpdateInner(Val.ValRecord("R", [("a", Val.ValInt(1))]), [Val.ValRecord("_named", [("a", Val.ValInt(9))])]) => Result.Ok(Val.ValRecord("R", [("a", Val.ValInt(9))]))
    doRecordUpdateInner(Val.ValRecord("R", []), [Val.ValInt(1)]) => Result.Err("record update requires named fields")
    doRecordUpdateInner(Val.ValRecord("R", []), []) => Result.Err("record update requires named fields")

fn applyRecordUpdate(baseVal: Val, namedFields: List<(String, Val)>) -> Result<Val, String>
    ? "Override fields in a record value."
    match baseVal
        Val.ValRecord(typeName, existingFields) -> Result.Ok(Val.ValRecord(typeName, mergeRecordFields(existingFields, namedFields)))
        _ -> Result.Err("update requires a record value")

verify applyRecordUpdate
    applyRecordUpdate(Val.ValRecord("R", [("x", Val.ValInt(1))]), [("x", Val.ValInt(2))]) => Result.Ok(Val.ValRecord("R", [("x", Val.ValInt(2))]))
    applyRecordUpdate(Val.ValInt(1), []) => Result.Err("update requires a record value")

fn mergeRecordFields(existing: List<(String, Val)>, overrides: List<(String, Val)>) -> List<(String, Val)>
    ? "For each field in existing: use override if present, otherwise keep."
    match existing
        [] -> overrides
        [pair, ..rest] -> match pair
            (k, v) -> mergeOneField(k, v, rest, overrides)

verify mergeRecordFields
    mergeRecordFields([], [("a", Val.ValInt(1))]) => [("a", Val.ValInt(1))]
    mergeRecordFields([("x", Val.ValInt(1))], [("x", Val.ValInt(9))]) => [("x", Val.ValInt(9))]

fn mergeOneField(k: String, v: Val, rest: List<(String, Val)>, overrides: List<(String, Val)>) -> List<(String, Val)>
    ? "Check if field k has an override."
    match findOverride(k, overrides)
        Option.Some(newV) -> List.prepend((k, newV), mergeRecordFields(rest, removeOverride(k, overrides)))
        Option.None -> List.prepend((k, v), mergeRecordFields(rest, overrides))

verify mergeOneField
    mergeOneField("x", Val.ValInt(1), [], [("x", Val.ValInt(9))]) => [("x", Val.ValInt(9))]
    mergeOneField("x", Val.ValInt(1), [], []) => [("x", Val.ValInt(1))]

fn findOverride(k: String, overrides: List<(String, Val)>) -> Option<Val>
    ? "Find a field value in the overrides list."
    match overrides
        [] -> Option.None
        [pair, ..rest] -> match pair
            (ok, ov) -> match ok == k
                true -> Option.Some(ov)
                false -> findOverride(k, rest)

verify findOverride
    findOverride("x", [("x", Val.ValInt(1))]) => Option.Some(Val.ValInt(1))
    findOverride("y", [("x", Val.ValInt(1))]) => Option.None
    findOverride("x", []) => Option.None

fn removeOverride(k: String, overrides: List<(String, Val)>) -> List<(String, Val)>
    ? "Remove a field from overrides list."
    match overrides
        [] -> []
        [pair, ..rest] -> match pair
            (ok, ov) -> match ok == k
                true -> rest
                false -> List.prepend((ok, ov), removeOverride(k, rest))

verify removeOverride
    removeOverride("x", [("x", Val.ValInt(1)), ("y", Val.ValInt(2))]) => [("y", Val.ValInt(2))]
    removeOverride("z", [("x", Val.ValInt(1))]) => [("x", Val.ValInt(1))]
    removeOverride("x", []) => []
