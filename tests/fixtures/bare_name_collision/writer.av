module Writer
    intent = "A minimal little-endian writer and its reader, with the countdown laws."
    exposes [littleEndian, bigEndian]
    depends []
    effects []

fn bigEndian(bytes: List<Int>, acc: Int) -> Int
    ? "Most significant digit first, which is what reversing the digits gives."
    match bytes
        [] -> acc
        [head, ..tail] -> bigEndian(tail, acc * 256 + head)

verify bigEndian
    bigEndian([], 0) => 0
    bigEndian([1, 2], 0) => 258

verify bigEndian law readsTheLastByteLast
    given bytes: List<Int> = [[], [1], [1, 2]]
    given b: Int = [0, 1, 255]
    given acc: Int = [0, 1, 300]
    bigEndian(List.concat(bytes, [b]), acc) => bigEndian(bytes, acc) * 256 + b

fn littleEndian(value: Int, acc: List<Int>) -> List<Int>
    ? "Least significant byte first, with no leading zero."
    match value > 0
        true -> littleEndian(Int.div(value, 256), List.prepend(Int.mod(value, 256), acc))
        false -> List.reverse(acc)

verify littleEndian
    littleEndian(0, []) => []
    littleEndian(258, []) => [2, 1]

verify littleEndian law accumulatorComesFirst
    given value: Int = [-1, 0, 1, 255, 256, 65536]
    given acc: List<Int> = [[], [9], [1, 2]]
    littleEndian(value, acc) => List.concat(List.reverse(acc), littleEndian(value, []))

verify littleEndian law readsBackBigEndian
    given m: Int = [0, 1, 127, 128, 255, 256, 65535, 65536, 2147483647]
    when m >= 0
    bigEndian(List.reverse(littleEndian(m, [])), 0) => m
