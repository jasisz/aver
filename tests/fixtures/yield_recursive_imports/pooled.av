module Pooled
    intent = "A live answer distinct from every test stub."
    depends [Pool]
    exposes [State, claim, finish, notice]

record State
    calls: Int

fn claim(state: State, peer: Int) -> Tuple<State, Pool.ClaimReply>
    ? "The live answer must never supply a test request."
    (State(calls = state.calls + 1), Pool.ClaimReply.Now(Option.Some(999)))

fn finish(state: State, value: Int) -> Tuple<State, Pool.FinishReply>
    ? "The live finish answer is deliberately different from the test stub."
    (state, Pool.FinishReply.Now(Result.Err("live provider")))

fn notice(state: State, id: Int) -> Tuple<State, Pool.NoticeReply>
    (state, Pool.NoticeReply.Now(Unit))
