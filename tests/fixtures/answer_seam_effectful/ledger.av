module Ledger
    intent = "An answer module holding the state both ends of the job seam reach."
    depends [Pool]
    exposes [State, claim, gone, nextTask, taskStarted, validated]
    effects [Console]

record State
    free: List<Int>
    pending: List<String>
    stopping: Bool

fn claim(state: State, key: Int) -> Pool.Assignment
    ? "The next height for this peer."
    Pool.Assignment.Idle

fn gone(state: State, key: Int) -> Unit
    ? "A peer that left gives its height back."
    Unit

fn nextTask(state: State) -> Option<String>
    ? "What the turn should start a validation job on, announced as it goes."
    ! [Console.print]
    Console.print("next task")
    Option.None

fn taskStarted(state: State, task: String) -> State
    ? "A task whose job just began leaves the queue it was offered from. Named by aver.toml's started key."
    state

fn validated(state: State, outcome: Result<Int, String>) -> State
    ? "Where a job that is over lands, whether it produced a result or not."
    match outcome
        Result.Err(_) -> State.update(state, stopping = true)
        Result.Ok(score) -> State.update(state, stopping = score == 0)

