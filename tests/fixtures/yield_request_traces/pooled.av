module Pooled
    intent = "A live answer distinct from every test stub."
    depends [Pool]
    exposes [State, claim, finish, notice]
    answers [Pool]

record State
    calls: Int

fn claim(state: State, peer: Int) -> Tuple<State, Result<Option<Int>, Run.Wake>>
    ? "The live answer must never supply a test request."
    (state, Result.Ok(Option.Some(999)))

fn finish(state: State, value: Int) -> Tuple<State, Result<Result<Int, String>, Run.Wake>>
    ? "The live finish answer is deliberately different from the test stub."
    (state, Result.Ok(Result.Err("live provider")))

fn notice(state: State, id: Int) -> Tuple<State, Result<Unit, Run.Wake>>
    (state, Result.Ok(Unit))
