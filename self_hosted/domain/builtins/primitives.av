fn builtinFloatPi(args: List<Val>) -> Result<Val, String>
    ? "Float.pi() -> Float."
    match args
        [] -> Result.Ok(Val.ValFloat(Float.pi()))
        _ -> Result.Err("Float.pi takes 0 arguments")

verify builtinFloatPi
    builtinFloatPi([]) => Result.Ok(Val.ValFloat(Float.pi()))
    builtinFloatPi([Val.ValInt(1)]) => Result.Err("Float.pi takes 0 arguments")

fn builtinStringToUpper(args: List<Val>) -> Result<Val, String>
    ? "String.toUpper(s) -> uppercase string."
    v = Domain.Builtins.Helpers.oneArg(args)?
    s = Domain.Builtins.Helpers.expectStr(v)?
    Result.Ok(Val.ValStr(String.toUpper(s)))

verify builtinStringToUpper
    builtinStringToUpper([Val.ValStr("hello")]) => Result.Ok(Val.ValStr("HELLO"))
    builtinStringToUpper([Val.ValInt(1)]) => Result.Err("expected string argument")

fn builtinStringTrim(args: List<Val>) -> Result<Val, String>
    ? "String.trim(s) -> trimmed string."
    v = Domain.Builtins.Helpers.oneArg(args)?
    s = Domain.Builtins.Helpers.expectStr(v)?
    Result.Ok(Val.ValStr(String.trim(s)))

verify builtinStringTrim
    builtinStringTrim([Val.ValStr("  hello  ")]) => Result.Ok(Val.ValStr("hello"))
    builtinStringTrim([Val.ValInt(1)]) => Result.Err("expected string argument")

fn builtinStringEndsWith(args: List<Val>) -> Result<Val, String>
    ? "String.endsWith(s, suffix) -> Bool."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (sV, pV) -> builtinStringEndsWithInner(sV, pV)

verify builtinStringEndsWith
    builtinStringEndsWith([Val.ValStr("test.av"), Val.ValStr(".av")]) => Result.Ok(Val.ValBool(true))
    builtinStringEndsWith([Val.ValStr("a")]) => Result.Err("expected 2 arguments")

fn builtinStringEndsWithInner(sV: Val, pV: Val) -> Result<Val, String>
    ? "Inner String.endsWith."
    s = Domain.Builtins.Helpers.expectStr(sV)?
    p = Domain.Builtins.Helpers.expectStr(pV)?
    Result.Ok(Val.ValBool(String.endsWith(s, p)))

verify builtinStringEndsWithInner
    builtinStringEndsWithInner(Val.ValStr("hello"), Val.ValStr("lo")) => Result.Ok(Val.ValBool(true))
    builtinStringEndsWithInner(Val.ValStr("hello"), Val.ValStr("xx")) => Result.Ok(Val.ValBool(false))
    builtinStringEndsWithInner(Val.ValInt(1), Val.ValStr("lo")) => Result.Err("expected string argument")

fn builtinStringSplit(args: List<Val>) -> Result<Val, String>
    ? "String.split(s, sep) -> List<String>."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (sV, sepV) -> builtinStringSplitInner(sV, sepV)

verify builtinStringSplit
    builtinStringSplit([Val.ValStr("a-b"), Val.ValStr("-")]) => Result.Ok(Val.ValList([Val.ValStr("a"), Val.ValStr("b")]))
    builtinStringSplit([Val.ValStr("a")]) => Result.Err("expected 2 arguments")

fn builtinStringSplitInner(sV: Val, sepV: Val) -> Result<Val, String>
    ? "Inner String.split."
    s = Domain.Builtins.Helpers.expectStr(sV)?
    sep = Domain.Builtins.Helpers.expectStr(sepV)?
    parts = String.split(s, sep)
    Result.Ok(Val.ValList(strPartsToVals(parts, [])))

verify builtinStringSplitInner
    builtinStringSplitInner(Val.ValStr("a,b,c"), Val.ValStr(",")) => Result.Ok(Val.ValList([Val.ValStr("a"), Val.ValStr("b"), Val.ValStr("c")]))
    builtinStringSplitInner(Val.ValInt(1), Val.ValStr(",")) => Result.Err("expected string argument")

fn strPartsToVals(parts: List<String>, acc: List<Val>) -> List<Val>
    ? "Convert string list to ValStr list."
    match parts
        [] -> List.reverse(acc)
        [s, ..rest] -> strPartsToVals(rest, List.prepend(Val.ValStr(s), acc))

verify strPartsToVals
    strPartsToVals(["a", "b"], []) => [Val.ValStr("a"), Val.ValStr("b")]
    strPartsToVals([], []) => []

fn builtinStringRepeat(args: List<Val>) -> Result<Val, String>
    ? "String.repeat(s, n) -> repeated string."
    pair = Domain.Builtins.Helpers.twoArgs(args)?
    match pair
        (sV, nV) -> builtinStringRepeatInner(sV, nV)

verify builtinStringRepeat
    builtinStringRepeat([Val.ValStr("ab"), Val.ValInt(2)]) => Result.Ok(Val.ValStr("abab"))
    builtinStringRepeat([Val.ValStr("a")]) => Result.Err("expected 2 arguments")

fn builtinStringRepeatInner(sV: Val, nV: Val) -> Result<Val, String>
    ? "Inner String.repeat."
    s = Domain.Builtins.Helpers.expectStr(sV)?
    n = Domain.Builtins.Helpers.expectInt(nV)?
    Result.Ok(Val.ValStr(repeatStr(s, n, "")))

verify builtinStringRepeatInner
    builtinStringRepeatInner(Val.ValStr("ha"), Val.ValInt(3)) => Result.Ok(Val.ValStr("hahaha"))
    builtinStringRepeatInner(Val.ValInt(1), Val.ValInt(3)) => Result.Err("expected string argument")

fn repeatStr(s: String, n: Int, acc: String) -> String
    ? "Repeat string n times."
    match n <= 0
        true -> acc
        false -> repeatStr(s, n - 1, acc + s)

verify repeatStr
    repeatStr("ab", 3, "") => "ababab"
    repeatStr("x", 0, "") => ""

fn builtinStringReplaceAll(args: List<Val>) -> Result<Val, String>
    ? "String.replace(s, from, to) -> String with all occurrences replaced."
    match List.len(args) == 3
        true -> builtinStringReplaceAllExtract(args)
        false -> Result.Err("String.replace takes 3 arguments")

verify builtinStringReplaceAll
    builtinStringReplaceAll([Val.ValStr("aaa"), Val.ValStr("a"), Val.ValStr("b")]) => Result.Ok(Val.ValStr("bbb"))
    builtinStringReplaceAll([Val.ValStr("a")]) => Result.Err("String.replace takes 3 arguments")

fn builtinStringReplaceAllExtract(args: List<Val>) -> Result<Val, String>
    ? "Extract args for String.replace."
    match args
        [sV, ..r1] -> match r1
            [fromV, ..r2] -> match r2
                [toV, ..r3] -> builtinStringReplaceAllDo(sV, fromV, toV)
                [] -> Result.Err("String.replace takes 3 arguments")
            [] -> Result.Err("String.replace takes 3 arguments")
        [] -> Result.Err("String.replace takes 3 arguments")

verify builtinStringReplaceAllExtract
    builtinStringReplaceAllExtract([Val.ValStr("ab"), Val.ValStr("a"), Val.ValStr("x")]) => Result.Ok(Val.ValStr("xb"))
    builtinStringReplaceAllExtract([]) => Result.Err("String.replace takes 3 arguments")

fn builtinStringReplaceAllDo(sV: Val, fromV: Val, toV: Val) -> Result<Val, String>
    ? "Inner impl of String.replace."
    s = Domain.Builtins.Helpers.expectStr(sV)?
    from = Domain.Builtins.Helpers.expectStr(fromV)?
    to = Domain.Builtins.Helpers.expectStr(toV)?
    Result.Ok(Val.ValStr(String.replace(s, from, to)))

verify builtinStringReplaceAllDo
    builtinStringReplaceAllDo(Val.ValStr("hello world"), Val.ValStr("world"), Val.ValStr("aver")) => Result.Ok(Val.ValStr("hello aver"))
    builtinStringReplaceAllDo(Val.ValInt(1), Val.ValStr("world"), Val.ValStr("aver")) => Result.Err("expected string argument")
