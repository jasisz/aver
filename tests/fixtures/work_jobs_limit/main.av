module Main
    depends [Node, Validation, Wait, Work]
    intent = "Shows that a job begun at the limit is queued, not refused, and starts once the running one stops."
    exposes [main]
    effects [Console.print, Validation.begin, Validation.take, Wait.poll, Work.cancel]

fn main() -> Result<Unit, String>
    ? "Starts one long countdown, begins a second at a limit of one, cancels the first, and collects the second once it has started."
    ! [Console.print, Validation.begin, Validation.take, Wait.poll, Work.cancel]
    first = Validation.begin(20000000)?
    second = Validation.begin(7)?
    Console.print("the second job was queued, not refused")
    Work.cancel(first)
    value = collect(second)?
    Console.print("the second job gave {value}")
    Result.Ok(Unit)

fn collect(job: Work.Job) -> Result<Int, String>
    ? "Waits for one job and takes it, asking again while it is still queued or running."
    ! [Validation.take, Wait.poll]
    _ready = Wait.poll({1 => Wait.Item.Job(job)}, 60000)?
    match Validation.take(job)?
        Option.Some(value) -> Result.Ok(value)
        Option.None -> collect(job)
