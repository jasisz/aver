module Prop84
    intent =
        "TIP isaplanner prop_84: zip xs (ys ++ zs) = zip (take (len ys) xs) ys ++ zip (drop (len ys) xs) zs."
    effects []

type Nat
    Z
    S(Nat)

fn zip(x: List<Int>, y: List<Int>) -> List<Tuple<Int, Int>>
    match x
        [] -> []
        [z, ..x2] -> match y
            [] -> []
            [x3, ..x4] -> List.concat([(z, x3)], zip(x2, x4))

fn take(x: Nat, y: List<Int>) -> List<Int>
    match x
        Nat.Z -> []
        Nat.S(z) -> match y
            [] -> []
            [x2, ..x3] -> List.concat([x2], take(z, x3))

fn len(x: List<Int>) -> Nat
    match x
        [] -> Nat.Z
        [y, ..xs] -> Nat.S(len(xs))

fn drop(x: Nat, y: List<Int>) -> List<Int>
    match x
        Nat.Z -> y
        Nat.S(z) -> match y
            [] -> []
            [x2, ..x3] -> drop(z, x3)

fn appendInt(x: List<Int>, y: List<Int>) -> List<Int>
    match x
        [] -> y
        [z, ..xs] -> List.concat([z], appendInt(xs, y))

fn appendZip(a: List<Tuple<Int, Int>>, b: List<Tuple<Int, Int>>) -> List<Tuple<Int, Int>>
    List.concat(a, b)

verify zip law zipTakeDropAppend
    given xs: List<Int> = [[], [1], [1, 2, 3]]
    given ys: List<Int> = [[], [1], [1, 2]]
    given zs: List<Int> = [[], [2], [3, 4]]
    zip(xs, appendInt(ys, zs)) => appendZip(zip(take(len(ys), xs), ys), zip(drop(len(ys), xs), zs))
