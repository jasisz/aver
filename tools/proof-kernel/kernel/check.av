module Check
    intent =
        "The replayer: recompute the equation each step proves, from the step's own data, the"
        "definitions and the hypotheses in scope, and compare the last one with the claim."
        "A refused step is named by its path from the root of the proof."
    exposes [Env, conclude, checkScript, emptyEnv]
    depends [Kernel.Term, Kernel.Subst, Kernel.Proof, Kernel.Rules, Kernel.Eval, Kernel.Finite, Kernel.Induct, Kernel.Ring, Kernel.Types]
    effects []

record Env
    defs: List<Def>
    consts: List<Const>
    laws: List<Law>
    hyps: List<Hyp>
    vars: List<TypedVar>
    sums: List<Sum>
    recs: List<Rec>
    sigs: List<FnSig>

fn emptyEnv() -> Env
    ? "No definitions, laws or hypotheses."
    Env(defs = [], consts = [], laws = [], hyps = [], vars = [], sums = [], recs = [], sigs = [])

verify emptyEnv
    emptyEnv().hyps => []

fn tyEnv(env: Env) -> TyEnv
    ? "What typing a term needs from the environment."
    TyEnv(vars = env.vars, defs = env.defs, consts = env.consts, sums = env.sums, recs = env.recs, sigs = env.sigs)

verify tyEnv
    tyEnv(emptyEnv()).vars => []

fn withVars(env: Env, vs: List<TypedVar>) -> Env
    ? "The environment with these variables in front."
    Env(defs = env.defs, consts = env.consts, laws = env.laws, hyps = env.hyps, vars = List.concat(vs, env.vars), sums = env.sums, recs = env.recs, sigs = env.sigs)

verify withVars
    withVars(emptyEnv(), [Kernel.Term.typed("t", Ty.TyInt)]).vars => [Kernel.Term.typed("t", Ty.TyInt)]

fn typeOf(t: Term, env: Env, path: String) -> Result<Ty, String>
    ? "The type of a term, a refusal naming the step when it has none."
    match Kernel.Types.typeOf(t, tyEnv(env))
        Result.Ok(ty) -> Result.Ok(ty)
        Result.Err(why) -> Result.Err("step {path}: {why}")

verify typeOf
    typeOf(Term.TVar("x"), emptyEnv(), "p") => Result.Err("step p: x is not a variable in scope")

fn bound(bs: List<Binding>, declared: List<TypedVar>, env: Env, what: String, path: String) -> Result<Unit, String>
    ? "The one check of every substitution a proof writes: each term fits the declared type of the variable it stands for."
    match Kernel.Types.bindTyped(bs, declared, [], tyEnv(env), what)
        Result.Ok(b) -> Result.Ok(Unit)
        Result.Err(why) -> Result.Err("step {path}: {why}")

verify bound
    bound([Kernel.Term.bind("a", Term.TStr("x"))], [Kernel.Term.typed("a", Ty.TyInt)], emptyEnv(), "rule r", "p") => Result.Err("step p: rule r: a := String is not Int")

fn argsFit(d: Def, xs: List<Term>, env: Env, path: String) -> Result<Unit, String>
    ? "A definition's arguments: one per parameter, each of its parameter's type."
    match List.len(d.params) == List.len(xs)
        false -> Result.Err("step {path}: {d.name} takes {List.len(d.params)} arguments")
        true -> bound(zipBind(Kernel.Types.paramsOf(d), xs), d.params, env, d.name, path)

verify argsFit
    argsFit(Def(name = "f", params = [Kernel.Term.typed("x", Ty.TyInt)], ret = Ty.TyInt, lets = [], body = Term.TVar("x")), [], emptyEnv(), "p") => Result.Err("step p: f takes 1 arguments")
    argsFit(Def(name = "f", params = [Kernel.Term.typed("x", Ty.TyInt)], ret = Ty.TyInt, lets = [], body = Term.TVar("x")), [Term.TStr("a")], emptyEnv(), "p") => Result.Err("step p: f: x := String is not Int")

fn declarationsTyped(env: Env, path: String) -> Result<Unit, String>
    ? "Every definition body and constant value fits the type its declaration gives it; theorem givens are not in their scope."
    scope = Env(defs = env.defs, consts = env.consts, laws = [], hyps = [], vars = [], sums = env.sums, recs = env.recs, sigs = env.sigs)
    uniqueDefs(scope.defs, [], path)?
    uniqueConsts(scope.consts, [], path)?
    constsAcyclic(scope.consts, scope.consts, path)?
    uniqueTypeDecls(scope.sums, scope.recs, path)?
    defsTyped(scope.defs, scope, path)?
    constsTyped(scope.consts, scope, path)

verify declarationsTyped
    declarationsTyped(Env(defs = [Def(name = "cast", params = [Kernel.Term.typed("x", Ty.TyStr)], ret = Ty.TyInt, lets = [], body = Term.TVar("x"))], consts = [], laws = [], hyps = [], vars = [], sums = [], recs = [], sigs = []), "proof") => Result.Err("step proof: definition cast has type String, declared Int")

fn uniqueDefs(ds: List<Def>, seen: List<String>, path: String) -> Result<Unit, String>
    ? "No second definition may borrow the first one's identity, type or termination evidence."
    match ds
        [] -> Result.Ok(Unit)
        [d, ..rest] -> match List.contains(seen, d.name)
            true -> Result.Err("step {path}: duplicate definition {d.name}")
            false -> uniqueDefs(rest, List.prepend(d.name, seen), path)

verify uniqueDefs
    uniqueDefs([Def(name = "f", params = [], ret = Ty.TyInt, lets = [], body = Term.TInt(0)), Def(name = "f", params = [], ret = Ty.TyInt, lets = [], body = Term.TInt(1))], [], "proof") => Result.Err("step proof: duplicate definition f")

fn uniqueConsts(cs: List<Const>, seen: List<String>, path: String) -> Result<Unit, String>
    ? "Each module-level binding has one identity and one defining equation."
    match cs
        [] -> Result.Ok(Unit)
        [c, ..rest] -> match List.contains(seen, c.name)
            true -> Result.Err("step {path}: duplicate module-level binding {c.name}")
            false -> uniqueConsts(rest, List.prepend(c.name, seen), path)

verify uniqueConsts
    uniqueConsts([Const(name = "a", ty = Ty.TyInt, value = Term.TInt(0)), Const(name = "a", ty = Ty.TyInt, value = Term.TInt(1))], [], "proof") => Result.Err("step proof: duplicate module-level binding a")

fn constsAcyclic(todo: List<Const>, all: List<Const>, path: String) -> Result<Unit, String>
    ? "No module-level binding depends on itself, directly or through other bindings."
    match todo
        [] -> Result.Ok(Unit)
        [c, ..rest] -> match constCycle(constDeps(c.name, all, all), c.name, all, [], List.len(all))
            true -> Result.Err("step {path}: cyclic module-level binding {c.name}")
            false -> constsAcyclic(rest, all, path)

verify constsAcyclic
    constsAcyclic([Const(name = "a", ty = Ty.TyInt, value = Term.TOp("+", Term.TVar("a"), Term.TInt(1)))], [Const(name = "a", ty = Ty.TyInt, value = Term.TOp("+", Term.TVar("a"), Term.TInt(1)))], "proof") => Result.Err("step proof: cyclic module-level binding a")
    constsAcyclic([Const(name = "a", ty = Ty.TyInt, value = Term.TInt(1)), Const(name = "b", ty = Ty.TyInt, value = Term.TOp("+", Term.TVar("a"), Term.TInt(1)))], [Const(name = "a", ty = Ty.TyInt, value = Term.TInt(1)), Const(name = "b", ty = Ty.TyInt, value = Term.TOp("+", Term.TVar("a"), Term.TInt(1)))], "proof") => Result.Ok(Unit)

fn constCycle(frontier: List<String>, target: String, cs: List<Const>, seen: List<String>, fuel: Int) -> Bool
    ? "Whether following module-level binding references reaches target."
    match (frontier, fuel > 0)
        ([], _) -> false
        (_, false) -> false
        ([n, ..rest], true) -> match n == target
            true -> true
            false -> match List.contains(seen, n)
                true -> constCycle(rest, target, cs, seen, fuel)
                false -> constCycle(List.concat(rest, constDeps(n, cs, cs)), target, cs, List.prepend(n, seen), fuel - 1)

verify constCycle
    constCycle(["b"], "a", [Const(name = "a", ty = Ty.TyInt, value = Term.TVar("b")), Const(name = "b", ty = Ty.TyInt, value = Term.TVar("a"))], [], 2) => true

fn constDeps(name: String, todo: List<Const>, all: List<Const>) -> List<String>
    ? "The module-level bindings referenced by the binding named name."
    match todo
        [] -> []
        [c, ..rest] -> match c.name == name
            true -> constNames(Kernel.Subst.freeVars(c.value), all)
            false -> constDeps(name, rest, all)

verify constDeps
    constDeps("a", [Const(name = "a", ty = Ty.TyInt, value = Term.TOp("+", Term.TVar("b"), Term.TInt(1))), Const(name = "b", ty = Ty.TyInt, value = Term.TInt(0))], [Const(name = "a", ty = Ty.TyInt, value = Term.TOp("+", Term.TVar("b"), Term.TInt(1))), Const(name = "b", ty = Ty.TyInt, value = Term.TInt(0))]) => ["b"]

fn constNames(names: List<String>, cs: List<Const>) -> List<String>
    ? "Only names that denote module-level bindings."
    match names
        [] -> []
        [n, ..rest] -> match isConst(n, cs)
            true -> List.prepend(n, constNames(rest, cs))
            false -> constNames(rest, cs)

verify constNames
    constNames(["x", "a"], [Const(name = "a", ty = Ty.TyInt, value = Term.TInt(0))]) => ["a"]

fn uniqueTypeDecls(ss: List<Sum>, rs: List<Rec>, path: String) -> Result<Unit, String>
    ? "A named type has exactly one declaration: never two sums, two records, or one of each."
    uniqueRecNames(rs, uniqueSumNames(ss, [], path)?, path)

verify uniqueTypeDecls
    uniqueTypeDecls([Sum(name = "R", eq = true, variants = [])], [Rec(name = "R", eq = true, fields = [])], "proof") => Result.Err("step proof: duplicate type declaration R")

fn uniqueSumNames(ss: List<Sum>, seen: List<String>, path: String) -> Result<List<String>, String>
    ? "Collect distinct sum names."
    match ss
        [] -> Result.Ok(seen)
        [s, ..rest] -> match List.contains(seen, s.name)
            true -> Result.Err("step {path}: duplicate type declaration {s.name}")
            false -> uniqueSumNames(rest, List.prepend(s.name, seen), path)

verify uniqueSumNames
    uniqueSumNames([], [], "proof") => Result.Ok([])

fn uniqueRecNames(rs: List<Rec>, seen: List<String>, path: String) -> Result<Unit, String>
    ? "Every record name is distinct from earlier records and every sum."
    match rs
        [] -> Result.Ok(Unit)
        [r, ..rest] -> match List.contains(seen, r.name)
            true -> Result.Err("step {path}: duplicate type declaration {r.name}")
            false -> uniqueRecNames(rest, List.prepend(r.name, seen), path)

verify uniqueRecNames
    uniqueRecNames([], [], "proof") => Result.Ok(Unit)

fn defsTyped(ds: List<Def>, env: Env, path: String) -> Result<Unit, String>
    ? "Every definition in the script is well typed."
    match ds
        [] -> Result.Ok(Unit)
        [d, ..rest] -> match definitionTyped(d, env, path)
            Result.Err(why) -> Result.Err(why)
            Result.Ok(done) -> defsTyped(rest, env, path)

verify defsTyped
    defsTyped([], emptyEnv(), "proof") => Result.Ok(Unit)

fn definitionTyped(d: Def, env: Env, path: String) -> Result<Unit, String>
    ? "A definition body has its declared result type under its parameters and local bindings."
    uniqueParams(d.params, [], d.name, path)?
    scope = letsTyped(d.lets, withVars(env, d.params), path)?
    declaredFits(typeOf(d.body, scope, path)?, d.ret, "definition {d.name}", path)

verify definitionTyped
    definitionTyped(Def(name = "id", params = [Kernel.Term.typed("x", Ty.TyInt)], ret = Ty.TyInt, lets = [], body = Term.TVar("x")), emptyEnv(), "proof") => Result.Ok(Unit)

fn uniqueParams(ps: List<TypedVar>, seen: List<String>, owner: String, path: String) -> Result<Unit, String>
    ? "Each parameter of a definition has one identity for typing, substitution and termination."
    match ps
        [] -> Result.Ok(Unit)
        [p, ..rest] -> match List.contains(seen, p.name)
            true -> Result.Err("step {path}: definition {owner} has duplicate parameter {p.name}")
            false -> uniqueParams(rest, List.prepend(p.name, seen), owner, path)

verify uniqueParams
    uniqueParams([Kernel.Term.typed("n", Ty.TyInt), Kernel.Term.typed("n", Ty.TyInt)], [], "f", "proof") => Result.Err("step proof: definition f has duplicate parameter n")

fn letsTyped(bs: List<Binding>, env: Env, path: String) -> Result<Env, String>
    ? "Infer local bindings in source order, making each one visible to those after it and to the body."
    match bs
        [] -> Result.Ok(env)
        [b, ..rest] -> letsTyped(rest, withVars(env, [Kernel.Term.typed(b.name, typeOf(b.value, env, path)?)]), path)

verify letsTyped
    letsTyped([], emptyEnv(), "proof") => Result.Ok(emptyEnv())

fn constsTyped(cs: List<Const>, env: Env, path: String) -> Result<Unit, String>
    ? "Every module constant value has its declared type."
    match cs
        [] -> Result.Ok(Unit)
        [c, ..rest] -> match declaredFits(typeOf(c.value, env, path)?, c.ty, "constant {c.name}", path)
            Result.Err(why) -> Result.Err(why)
            Result.Ok(done) -> constsTyped(rest, env, path)

verify constsTyped
    constsTyped([Const(name = "n", ty = Ty.TyInt, value = Term.TStr("not an Int"))], emptyEnv(), "proof") => Result.Err("step proof: constant n has type String, declared Int")

fn declaredFits(actual: Ty, declared: Ty, what: String, path: String) -> Result<Unit, String>
    ? "A declaration's inferred type fits the type it announces."
    match Kernel.Types.fits(actual, declared)
        true -> Result.Ok(Unit)
        false -> Result.Err("step {path}: {what} has type {Kernel.Types.show(actual)}, declared {Kernel.Types.show(declared)}")

verify declaredFits
    declaredFits(Ty.TyBool, Ty.TyInt, "definition f", "proof") => Result.Err("step proof: definition f has type Bool, declared Int")

fn patTypes(p: Pat, subject: Ty, env: Env, path: String) -> Result<List<TypedVar>, String>
    ? "The variables a pattern binds over a subject of this type, a refusal naming the step when it does not fit."
    match Kernel.Types.patVars(p, subject, tyEnv(env))
        Result.Ok(vs) -> Result.Ok(vs)
        Result.Err(why) -> Result.Err("step {path}: {why}")

verify patTypes
    patTypes(Pat.PNil, Ty.TyInt, emptyEnv(), "p") => Result.Err("step p: the pattern does not fit Int")

fn listVar(v: String, env: Env) -> Option<Ty>
    ? "What a variable of list type holds, if it is one."
    match Kernel.Types.typeOf(Term.TVar(v), tyEnv(env))
        Result.Ok(t) -> Kernel.Types.elemOf(t)
        Result.Err(why) -> Option.None

verify listVar
    listVar("xs", listsEnv(["xs"])) => Option.Some(Ty.TyAny)
    listVar("n", intsEnv(["n"])) => Option.None

fn cellVars(h: String, t: String, e: Ty) -> List<TypedVar>
    ? "The head and the tail of a list of e."
    [Kernel.Term.typed(h, e), Kernel.Term.typed(t, Ty.TyList(e))]

verify cellVars
    cellVars("h", "t", Ty.TyInt) => [Kernel.Term.typed("h", Ty.TyInt), Kernel.Term.typed("t", Ty.TyList(Ty.TyInt))]

fn refuse(path: String, why: String) -> Result<Eqn, String>
    ? "A refusal that names the step."
    Result.Err("step {path}: {why}")

verify refuse
    refuse("proof", "no") => Result.Err("step proof: no")

fn conclude(p: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "The equation a step proves, or the refusal of the first wrong step under it."
    match p
        Proof.PRefl(t) -> Result.Ok(Eqn(lhs = t, rhs = t))
        Proof.PSymm(q) -> flip(conclude(q, env, path + "/symm")?)
        Proof.PTrans(ts, ps) -> trans(ts, ps, env, path)
        Proof.PCongr(c, q) -> congr(c, q, env, path)
        Proof.PUnfold(f, k, xs, ys, pre) -> unfold(f, k, xs, ys, pre, env, path)
        Proof.PConst(n) -> constant(n, env, path)
        Proof.PArm(k, ys, t, q) -> armStep(k, ys, t, q, env, path)
        Proof.PProj(t) -> proj(t, env, path)
        Proof.PCell(t) -> cell(t, path)
        Proof.PHyp(h) -> hyp(h, env.hyps, path)
        Proof.PRule(id, bs, ps) -> rule(id, bs, ps, env, path)
        Proof.PLaw(k, bs, ps) -> lawStep(k, bs, ps, env, path)
        Proof.PCompute(a, b) -> compute(a, b, path)
        Proof.PCases(on, h, t, f) -> cases(on, h, t, f, env, path)
        Proof.PSplit(on, h, lits, cs) -> split(on, h, lits, cs, env, path)
        Proof.PHave(h, fact, q, body) -> have(h, fact, q, body, env, path)
        Proof.PEnum(v, l, r, cs) -> enumStep(v, l, r, cs, env, path)
        Proof.PAbsurd(q, l, r) -> absurd(conclude(q, env, "{path}/absurd")?, l, r, path)
        Proof.PInduct(f, xs, l, r, carry, cs) -> induct(f, xs, Eqn(lhs = l, rhs = r), carry, cs, env, path)
        Proof.PListInduct(v, l, r, carry, n, h, t, general, ihs, c) -> listInduct(v, Eqn(lhs = l, rhs = r), carry, n, h, t, general, ihs, c, env, path)
        Proof.PListCases(v, l, r, n, h, t, c) -> splitList(v, Eqn(lhs = l, rhs = r), n, h, t, c, env, path)
        Proof.PLenInduct(v, l, r, carry, general, n, hn, ih, c) -> lenInduct(v, Eqn(lhs = l, rhs = r), carry, general, [n, hn, ih], c, env, path)
        Proof.PRing(l, r) -> ring(l, r, env, path)
        Proof.PLinear(g, v, hs, ws, cs) -> linear(g, v, hs, ws, cs, env, path)

verify conclude
    conclude(Proof.PRefl(Term.TInt(1)), emptyEnv(), "proof") => Result.Ok(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(1)))
    conclude(Proof.PHyp("h"), emptyEnv(), "proof") => Result.Err("step proof: hypothesis h is not in scope")
    conclude(Proof.PRule("simp", [], []), emptyEnv(), "proof/trans.2") => Result.Err("step proof/trans.2: unknown rule simp")

verify conclude law refusalNamesTheStep
    given name: String = ["h", "when", "h_steps1"]
    given path: String = ["proof", "proof/trans.0", "proof/cases.true/congr"]
    namesStep(conclude(Proof.PHyp(name), emptyEnv(), path), path) => true

fn namesStep(r: Result<Eqn, String>, path: String) -> Bool
    ? "Whether a result is a refusal that begins with the step it names."
    match r
        Result.Ok(e) -> false
        Result.Err(why) -> String.startsWith(why, "step {path}: ")

verify namesStep
    namesStep(Result.Err("step p: x"), "p") => true
    namesStep(Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TUnit)), "p") => false

fn flip(e: Eqn) -> Result<Eqn, String>
    ? "Symmetry."
    Result.Ok(Eqn(lhs = e.rhs, rhs = e.lhs))

verify flip
    flip(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(2))) => Result.Ok(Eqn(lhs = Term.TInt(2), rhs = Term.TInt(1)))

fn trans(ts: List<Term>, ps: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "A chain t0 = t1 = … = tn, each link proved by its step."
    match List.len(ts) == List.len(ps) + 1
        false -> refuse(path, "trans needs one more term than steps")
        true -> transFrom(ts, ps, env, path, 0)

verify trans
    trans([Term.TInt(1)], [Proof.PRefl(Term.TInt(1))], emptyEnv(), "p") => Result.Err("step p: trans needs one more term than steps")

fn transFrom(ts: List<Term>, ps: List<Proof>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "Check link i and those after it; the result spans the whole chain."
    match (ts, ps)
        ([a, b, ..moreTerms], [p, ..moreSteps]) -> transLink(a, b, p, List.prepend(b, moreTerms), moreSteps, env, path, i)
        ([a], []) -> Result.Ok(Eqn(lhs = a, rhs = a))
        _ -> refuse(path, "trans needs at least one step")

verify transFrom
    transFrom([Term.TInt(1)], [], emptyEnv(), "p", 0) => Result.Ok(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(1)))

fn transLink(a: Term, b: Term, p: Proof, rest: List<Term>, steps: List<Proof>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "One link of a chain, then the rest."
    here = "{path}/trans.{i}"
    e = conclude(p, env, here)?
    match e == Eqn(lhs = a, rhs = b)
        false -> refuse(here, "the step does not join the written terms")
        true -> joinRest(a, transFrom(rest, steps, env, path, i + 1)?)

verify transLink
    transLink(Term.TInt(1), Term.TInt(2), Proof.PRefl(Term.TInt(1)), [Term.TInt(2)], [], emptyEnv(), "p", 0) => Result.Err("step p/trans.0: the step does not join the written terms")

fn joinRest(a: Term, rest: Eqn) -> Result<Eqn, String>
    ? "The chain from a to the end of the rest."
    Result.Ok(Eqn(lhs = a, rhs = rest.rhs))

verify joinRest
    joinRest(Term.TInt(1), Eqn(lhs = Term.TInt(2), rhs = Term.TInt(3))) => Result.Ok(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(3)))

fn congr(c: Term, q: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "From a = b, c[a] = c[b]; the context holds exactly one hole."
    match Kernel.Subst.holeCount(c) == 1
        false -> refuse(path, "a congruence context needs exactly one hole")
        true -> plugBoth(c, conclude(q, env, "{path}/congr")?, path)

verify congr
    congr(Term.TVar("x"), Proof.PRefl(Term.TInt(1)), emptyEnv(), "p") => Result.Err("step p: a congruence context needs exactly one hole")

fn plugBoth(c: Term, e: Eqn, path: String) -> Result<Eqn, String>
    ? "Put both sides of an equation into the hole."
    match (Kernel.Subst.subst(c, [Kernel.Term.bind("□", e.lhs)]), Kernel.Subst.subst(c, [Kernel.Term.bind("□", e.rhs)]))
        (Result.Ok(l), Result.Ok(r)) -> Result.Ok(Eqn(lhs = l, rhs = r))
        (Result.Err(why), _) -> refuse(path, why)
        (_, Result.Err(why)) -> refuse(path, why)

verify plugBoth
    plugBoth(Term.TNeg(Term.THole), Eqn(lhs = Term.TVar("a"), rhs = Term.TVar("b")), "p") => Result.Ok(Eqn(lhs = Term.TNeg(Term.TVar("a")), rhs = Term.TNeg(Term.TVar("b"))))

fn proj(t: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "A record literal's field; a field of an update, which is the value written to it, or the base's field when the update does not write it."
    match t
        Term.TGet(Term.TRec(ty, fs), f) -> projField(t, fs, f, path)
        Term.TGet(Term.TUpd(ty, base, fs), f) -> projUpdate(t, typeOf(t, env, path), base, fs, f)
        _ -> refuse(path, "a projection must read a field of a record literal or of an update")

verify proj
    proj(Term.TGet(Term.TRec("R", [Field(name = "a", value = Term.TInt(3))]), "a"), emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TGet(Term.TRec("R", [Field(name = "a", value = Term.TInt(3))]), "a"), rhs = Term.TInt(3)))
    proj(Term.TGet(Term.TVar("r"), "a"), emptyEnv(), "p") => Result.Err("step p: a projection must read a field of a record literal or of an update")
    proj(Term.TGet(Term.TUpd("R", Term.TVar("r"), [Field(name = "a", value = Term.TInt(3))]), "b"), withRec(withVars(emptyEnv(), [Kernel.Term.typed("r", Ty.TyNamed("R"))])), "p") => Result.Ok(Eqn(lhs = Term.TGet(Term.TUpd("R", Term.TVar("r"), [Field(name = "a", value = Term.TInt(3))]), "b"), rhs = Term.TGet(Term.TVar("r"), "b")))
    proj(Term.TGet(Term.TUpd("R", Term.TVar("r"), [Field(name = "a", value = Term.TInt(3))]), "a"), withRec(withVars(emptyEnv(), [Kernel.Term.typed("r", Ty.TyNamed("R"))])), "p") => Result.Ok(Eqn(lhs = Term.TGet(Term.TUpd("R", Term.TVar("r"), [Field(name = "a", value = Term.TInt(3))]), "a"), rhs = Term.TInt(3)))
    proj(Term.TGet(Term.TUpd("R", Term.TVar("r"), [Field(name = "a", value = Term.TInt(3))]), "c"), withRec(withVars(emptyEnv(), [Kernel.Term.typed("r", Ty.TyNamed("R"))])), "p") => Result.Err("step p: R has no field c")

fn projUpdate(t: Term, ty: Result<Ty, String>, base: Term, fs: List<Field>, f: String) -> Result<Eqn, String>
    ? "Once the read has a type, so the base is of the updated record and f one of its fields: the value written to f, or the base's f."
    ty?
    match findField(fs, f)
        Option.Some(x) -> Result.Ok(Eqn(lhs = t, rhs = x))
        Option.None -> Result.Ok(Eqn(lhs = t, rhs = Term.TGet(base, f)))

verify projUpdate
    projUpdate(Term.TUnit, Result.Err("no"), Term.TVar("r"), [], "a") => Result.Err("no")
    projUpdate(Term.TUnit, Result.Ok(Ty.TyInt), Term.TVar("r"), [], "a") => Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TGet(Term.TVar("r"), "a")))

fn findField(fs: List<Field>, f: String) -> Option<Term>
    ? "The value the first field named f holds."
    match fs
        [] -> Option.None
        [x, ..rest] -> match x.name == f
            true -> Option.Some(x.value)
            false -> findField(rest, f)

verify findField
    findField([Field(name = "a", value = Term.TInt(1))], "a") => Option.Some(Term.TInt(1))
    findField([Field(name = "a", value = Term.TInt(1))], "b") => Option.None

fn cell(t: Term, path: String) -> Result<Eqn, String>
    ? "A list literal with an element is that element in front of the rest."
    match t
        Term.TList([x, ..rest]) -> Result.Ok(Eqn(lhs = t, rhs = Term.TBi("List.prepend", [x, Term.TList(rest)])))
        _ -> refuse(path, "a cell step needs a list literal with an element")

verify cell
    cell(Term.TList([Term.TVar("y")]), "p") => Result.Ok(Eqn(lhs = Term.TList([Term.TVar("y")]), rhs = Term.TBi("List.prepend", [Term.TVar("y"), Term.TList([])])))
    cell(Term.TList([]), "p") => Result.Err("step p: a cell step needs a list literal with an element")

fn projField(t: Term, fs: List<Field>, f: String, path: String) -> Result<Eqn, String>
    ? "Find the field among the literal's fields."
    match fs
        [] -> refuse(path, "the record has no field {f}")
        [x, ..rest] -> match x.name == f
            true -> Result.Ok(Eqn(lhs = t, rhs = x.value))
            false -> projField(t, rest, f, path)

verify projField
    projField(Term.TUnit, [], "a", "p") => Result.Err("step p: the record has no field a")

fn hyp(h: String, hs: List<Hyp>, path: String) -> Result<Eqn, String>
    ? "A hypothesis in scope; the innermost one of a name wins."
    match hs
        [] -> refuse(path, "hypothesis {h} is not in scope")
        [x, ..rest] -> match x.name == h
            true -> Result.Ok(x.eqn)
            false -> hyp(h, rest, path)

verify hyp
    hyp("h", [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))], "p") => Result.Ok(Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))

fn compute(a: Term, b: Term, path: String) -> Result<Eqn, String>
    ? "Two closed terms with the same value."
    match (Kernel.Eval.evalClosed(a), Kernel.Eval.evalClosed(b))
        (Option.Some(x), Option.Some(y)) -> match x == y
            true -> Result.Ok(Eqn(lhs = a, rhs = b))
            false -> refuse(path, "the two sides compute to different values")
        _ -> refuse(path, "compute needs closed terms")

verify compute
    compute(Term.TOp("-", Term.TInt(8), Term.TInt(1)), Term.TInt(7), "p") => Result.Ok(Eqn(lhs = Term.TOp("-", Term.TInt(8), Term.TInt(1)), rhs = Term.TInt(7)))
    compute(Term.TOp("-", Term.TInt(8), Term.TInt(1)), Term.TInt(6), "p") => Result.Err("step p: the two sides compute to different values")
    compute(Term.TVar("x"), Term.TInt(6), "p") => Result.Err("step p: compute needs closed terms")

fn cases(on: Term, h: String, t: Proof, f: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "Both branches of a Bool split must prove the same equation; the term split on must be a Bool."
    match typeOf(on, env, path)
        Result.Ok(Ty.TyBool) -> casesOfBool(on, h, t, f, env, path)
        _ -> refuse(path, "the term split on is not a Bool")

verify cases
    cases(Term.TVar("c"), "h", Proof.PHyp("h"), Proof.PHyp("h"), emptyEnv(), "p") => Result.Err("step p: the term split on is not a Bool")
    cases(Term.TOp("<", Term.TVar("x"), Term.TInt(0)), "h", Proof.PHyp("h"), Proof.PHyp("h"), intsEnv(["x"]), "p") => Result.Err("step p: the two branches prove different equations")

fn casesOfBool(on: Term, h: String, t: Proof, f: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "The two branches of a split on a Bool."
    whenTrue = conclude(t, withHyp(env, h, on, true), "{path}/cases.true")?
    whenFalse = conclude(f, withHyp(env, h, on, false), "{path}/cases.false")?
    match whenTrue == whenFalse
        true -> Result.Ok(whenTrue)
        false -> refuse(path, "the two branches prove different equations")

verify casesOfBool
    casesOfBool(Term.TVar("c"), "h", Proof.PHyp("h"), Proof.PHyp("h"), emptyEnv(), "p") => Result.Err("step p: the two branches prove different equations")

fn split(on: Term, h: String, lits: List<Term>, cs: List<SplitCase>, env: Env, path: String) -> Result<Eqn, String>
    ? "A split on any term: one case per constructor of its type ([] and [h, ..t] for a list, every constructor of a sum in order, each with one name per field); or, given literals of its type, one case per literal and a last one where it is none of them."
    match (typeOf(on, env, path), lits)
        (Result.Err(why), _) -> Result.Err(why)
        (Result.Ok(t), []) -> splitConstructors(t, on, h, cs, env, path)
        (Result.Ok(t), _) -> splitLiterals(t, lits, on, h, cs, env, path)

verify split
    split(Term.TVar("x"), "h", [], [], emptyEnv(), "p") => Result.Err("step p: x is not a variable in scope")
    split(Term.TVar("x"), "h", [Term.TStr("a")], [SplitCase(ctor = "lit", binders = [], proof = Proof.PRefl(Term.TInt(0))), SplitCase(ctor = "else", binders = ["n"], proof = Proof.PRefl(Term.TInt(0)))], intsEnv(["x"]), "p") => Result.Err("step p: the cases are not the literals and one more")
    split(Term.TVar("x"), "h", [Term.TInt(1)], [SplitCase(ctor = "lit", binders = [], proof = Proof.PRefl(Term.TInt(0))), SplitCase(ctor = "else", binders = ["n"], proof = Proof.PRefl(Term.TInt(0)))], intsEnv(["x"]), "p") => Result.Ok(Eqn(lhs = Term.TInt(0), rhs = Term.TInt(0)))
    split(Term.TVar("x"), "h", [Term.TInt(1)], [SplitCase(ctor = "lit", binders = [], proof = Proof.PHyp("h")), SplitCase(ctor = "else", binders = ["n"], proof = Proof.PHyp("n"))], intsEnv(["x"]), "p") => Result.Err("step p: the cases prove different equations")

fn splitLiterals(t: Ty, lits: List<Term>, on: Term, h: String, cs: List<SplitCase>, env: Env, path: String) -> Result<Eqn, String>
    ? "A split along literals of the term's type: one case per literal under h : on = k, then one naming one hypothesis per literal, (on == k) = false."
    match Bool.and(literalsOf(lits, t, env, path), Bool.and(splitCtors(cs) == litCtors(lits), binderCounts(cs) == litCounts(lits, 0)))
        true -> splitCases(cs, litHyps(lits, cs, on, h, []), noVars(cs), on, [], env, path)
        false -> refuse(path, "the cases are not the literals and one more")

verify splitLiterals
    splitLiterals(Ty.TyInt, [Term.TInt(1)], Term.TVar("x"), "h", [], intsEnv(["x"]), "p") => Result.Err("step p: the cases are not the literals and one more")

fn literalsOf(lits: List<Term>, t: Ty, env: Env, path: String) -> Bool
    ? "Every one an Int, Bool, text or unit literal of type t."
    match lits
        [] -> true
        [k, ..rest] -> Bool.and(Bool.and(isLiteral(k), typeOf(k, env, path) == Result.Ok(t)), literalsOf(rest, t, env, path))

verify literalsOf
    literalsOf([Term.TInt(1), Term.TStr("a")], Ty.TyInt, emptyEnv(), "p") => false
    literalsOf([Term.TInt(1)], Ty.TyInt, emptyEnv(), "p") => true

fn splitConstructors(t: Ty, on: Term, h: String, cs: List<SplitCase>, env: Env, path: String) -> Result<Eqn, String>
    ? "A split along the constructors of the subject's type: every one in order, each case naming one variable per field."
    match (Kernel.Types.ctorsOf(t, tyEnv(env)) == splitCtors(cs), caseVars(cs, t, env))
        (false, _) -> refuse(path, "the cases are not the constructors of {Kernel.Types.show(t)}")
        (_, Result.Err(why)) -> refuse(path, why)
        (true, Result.Ok(vss)) -> splitCases(cs, ctorHyps(cs, on, h), vss, on, [], env, path)

verify splitConstructors
    splitConstructors(Ty.TyInt, Term.TVar("x"), "h", [SplitCase(ctor = "nil", binders = [], proof = Proof.PRefl(Term.TUnit))], emptyEnv(), "p") => Result.Err("step p: the cases are not the constructors of Int")

fn sumEnv() -> Env
    ? "A given x of a declared sum C with bare constructors C.A and C.B."
    Env(defs = [], consts = [], laws = [], hyps = [], vars = [Kernel.Term.typed("x", Ty.TyNamed("C"))], sums = [Sum(name = "C", eq = false, variants = [Variant(name = "C.A", fields = []), Variant(name = "C.B", fields = [])])], recs = [], sigs = [])

verify sumEnv
    List.len(sumEnv().sums) => 1

fn caseVars(cs: List<SplitCase>, t: Ty, env: Env) -> Result<List<List<TypedVar>>, String>
    ? "For each case, its names with the types of its constructor's fields over the type split on."
    match cs
        [] -> Result.Ok([])
        [c, ..rest] -> match Kernel.Types.ctorFields(c.ctor, t, tyEnv(env))
            Result.Err(why) -> Result.Err(why)
            Result.Ok(fs) -> match List.len(fs) == List.len(c.binders)
                false -> Result.Err("case {c.ctor} binds {List.len(c.binders)} names for {List.len(fs)} fields")
                true -> Result.Ok(List.prepend(Kernel.Types.namedVars(c.binders, fs), caseVars(rest, t, env)?))

verify caseVars
    caseVars([SplitCase(ctor = "cons", binders = ["a", "b"], proof = Proof.PRefl(Term.TUnit))], Ty.TyList(Ty.TyInt), emptyEnv()) => Result.Ok([[Kernel.Term.typed("a", Ty.TyInt), Kernel.Term.typed("b", Ty.TyList(Ty.TyInt))]])

fn noVars(cs: List<SplitCase>) -> List<List<TypedVar>>
    ? "No variables for any case: a literal split names hypotheses, not values."
    match cs
        [] -> []
        [c, ..rest] -> List.prepend(firstVars([]), noVars(rest))

verify noVars
    noVars([]) => []

fn splitCtors(cs: List<SplitCase>) -> List<String>
    ? "The constructor of each case."
    match cs
        [] -> []
        [c, ..rest] -> List.prepend(c.ctor, splitCtors(rest))

verify splitCtors
    splitCtors([]) => []

fn binderCounts(cs: List<SplitCase>) -> List<Int>
    ? "How many names each case binds."
    match cs
        [] -> []
        [c, ..rest] -> List.prepend(List.len(c.binders), binderCounts(rest))

verify binderCounts
    binderCounts([]) => []

fn splitValue(c: SplitCase) -> Term
    ? "The constructor of a case applied to its names."
    match (c.ctor, c.binders)
        ("nil", _) -> Term.TList([])
        ("cons", [a, b]) -> Term.TBi("List.prepend", [Term.TVar(a), Term.TVar(b)])
        _ -> Term.TCtor(c.ctor, namesToVars(c.binders))

verify splitValue
    splitValue(SplitCase(ctor = "cons", binders = ["a", "b"], proof = Proof.PRefl(Term.TUnit))) => Term.TBi("List.prepend", [Term.TVar("a"), Term.TVar("b")])
    splitValue(SplitCase(ctor = "C.S", binders = ["a"], proof = Proof.PRefl(Term.TUnit))) => Term.TCtor("C.S", [Term.TVar("a")])

fn litCtors(lits: List<Term>) -> List<String>
    ? "The case of each literal, lit, then else for the last one."
    match lits
        [] -> ["else"]
        [k, ..rest] -> List.prepend("lit", litCtors(rest))

verify litCtors
    litCtors([Term.TInt(1)]) => ["lit", "else"]

fn litCounts(lits: List<Term>, n: Int) -> List<Int>
    ? "How many names each case of a literal split binds: none for a literal, one per literal for the last one."
    match lits
        [] -> [n]
        [k, ..rest] -> List.prepend(0, litCounts(rest, n + 1))

verify litCounts
    litCounts([Term.TInt(1), Term.TInt(2)], 0) => [0, 0, 2]

fn ctorHyps(cs: List<SplitCase>, on: Term, h: String) -> List<List<Hyp>>
    ? "For each case of a split on a constructor, h : on = the constructor at the case's names."
    match cs
        [] -> []
        [c, ..rest] -> List.prepend([Hyp(name = h, eqn = Eqn(lhs = on, rhs = splitValue(c)))], ctorHyps(rest, on, h))

verify ctorHyps
    ctorHyps([SplitCase(ctor = "nil", binders = [], proof = Proof.PRefl(Term.TUnit))], Term.TVar("x"), "h") => [[Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TList([])))]]

fn litHyps(lits: List<Term>, cs: List<SplitCase>, on: Term, h: String, seen: List<Term>) -> List<List<Hyp>>
    ? "Each case's hypotheses: h : on = k for a literal k, and for the last one (on == k) = false per literal, named by the case's names."
    match (lits, cs)
        ([k, ..ks], [c, ..more]) -> List.prepend([Hyp(name = h, eqn = Eqn(lhs = on, rhs = k))], litHyps(ks, more, on, h, List.concat(seen, [k])))
        ([], [c, ..more]) -> [unequal(c.binders, seen, on)]
        _ -> []

verify litHyps
    litHyps([Term.TInt(1)], [SplitCase(ctor = "lit", binders = [], proof = Proof.PRefl(Term.TUnit)), SplitCase(ctor = "else", binders = ["n"], proof = Proof.PRefl(Term.TUnit))], Term.TVar("x"), "h", []) => [[Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TInt(1)))], [Hyp(name = "n", eqn = Eqn(lhs = Term.TOp("==", Term.TVar("x"), Term.TInt(1)), rhs = Term.TBool(false)))]]

fn unequal(names: List<String>, lits: List<Term>, on: Term) -> List<Hyp>
    ? "Each name stating (on == k) = false for its literal k."
    match (names, lits)
        ([n, ..ns], [k, ..ks]) -> List.prepend(Hyp(name = n, eqn = Eqn(lhs = Term.TOp("==", on, k), rhs = Term.TBool(false))), unequal(ns, ks, on))
        _ -> []

verify unequal
    unequal([], [Term.TInt(1)], Term.TVar("x")) => []

fn splitCases(cs: List<SplitCase>, hss: List<List<Hyp>>, vss: List<List<TypedVar>>, on: Term, before: List<Eqn>, env: Env, path: String) -> Result<Eqn, String>
    ? "Each case under its hypotheses and its typed names, fresh for on, the hypotheses, the variables and the constants; every case proves the same equation, which names none of them."
    match cs
        [] -> splitDone(before, path)
        [c, ..rest] -> match freshAll(c.binders, List.concat(Kernel.Subst.freeVars(on), hypNames(env.hyps)), env, [])
            false -> refuse(path, "the names of case {c.ctor} are not fresh")
            true -> splitNext(conclude(c.proof, withVars(withHyps(env, List.concat(firstHyps(hss), env.hyps)), firstVars(vss)), "{path}/split.{c.ctor}")?, c, rest, List.drop(hss, 1), List.drop(vss, 1), on, before, env, path)

verify splitCases
    splitCases([], [], [], Term.TVar("x"), [], emptyEnv(), "p") => Result.Err("step p: a split with no cases")
    splitCases([SplitCase(ctor = "C.A", binders = ["x"], proof = Proof.PRefl(Term.TUnit))], [[]], [[]], Term.TVar("x"), [], emptyEnv(), "p") => Result.Err("step p: the names of case C.A are not fresh")

fn firstVars(vss: List<List<TypedVar>>) -> List<TypedVar>
    ? "The typed names of the first case."
    match vss
        [vs, ..rest] -> vs
        [] -> []

verify firstVars
    firstVars([]) => []

fn firstHyps(hss: List<List<Hyp>>) -> List<Hyp>
    ? "The hypotheses of the first case."
    match hss
        [hs, ..rest] -> hs
        [] -> []

verify firstHyps
    firstHyps([]) => []

fn splitDone(before: List<Eqn>, path: String) -> Result<Eqn, String>
    ? "The equation every case proved."
    match before
        [e, ..rest] -> Result.Ok(e)
        [] -> refuse(path, "a split with no cases")

verify splitDone
    splitDone([], "p") => Result.Err("step p: a split with no cases")

fn splitNext(e: Eqn, c: SplitCase, rest: List<SplitCase>, hss: List<List<Hyp>>, vss: List<List<TypedVar>>, on: Term, before: List<Eqn>, env: Env, path: String) -> Result<Eqn, String>
    ? "One case's equation: it names none of the case's names, and it is the one every earlier case proved."
    match (anyIn(List.concat(Kernel.Subst.freeVars(e.lhs), Kernel.Subst.freeVars(e.rhs)), c.binders), Bool.or(List.len(before) == 0, before == [e]))
        (true, _) -> refuse(path, "case {c.ctor} proves an equation about its own names")
        (_, false) -> refuse(path, "the cases prove different equations")
        _ -> splitCases(rest, hss, vss, on, [e], env, path)

verify splitNext
    splitNext(Eqn(lhs = Term.TVar("a"), rhs = Term.TVar("a")), SplitCase(ctor = "C.A", binders = ["a"], proof = Proof.PRefl(Term.TUnit)), [], [], [], Term.TVar("x"), [], emptyEnv(), "p") => Result.Err("step p: case C.A proves an equation about its own names")
    splitNext(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(1)), SplitCase(ctor = "C.A", binders = [], proof = Proof.PRefl(Term.TUnit)), [], [], [], Term.TVar("x"), [Eqn(lhs = Term.TInt(2), rhs = Term.TInt(2))], emptyEnv(), "p") => Result.Err("step p: the cases prove different equations")

fn have(h: String, fact: Term, q: Proof, body: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "A cut: q proves fact = true in the current scope, then body is checked with it as hypothesis h."
    proved = conclude(q, env, "{path}/have.{h}")?
    match proved == Eqn(lhs = fact, rhs = Term.TBool(true))
        true -> conclude(body, withHyp(env, h, fact, true), path)
        false -> refuse(path, "the proof of {h} ends at a different equation than its fact")

verify have
    have("h", Term.TVar("c"), Proof.PHyp("g"), Proof.PHyp("h"), withHyp(emptyEnv(), "g", Term.TVar("c"), true), "p") => Result.Ok(Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))
    have("h", Term.TVar("c"), Proof.PHyp("g"), Proof.PHyp("h"), withHyp(emptyEnv(), "g", Term.TVar("c"), false), "p") => Result.Err("step p: the proof of h ends at a different equation than its fact")
    have("h", Term.TVar("c"), Proof.PHyp("h"), Proof.PHyp("h"), emptyEnv(), "p") => Result.Err("step p/have.h: hypothesis h is not in scope")

fn withHyp(env: Env, h: String, on: Term, value: Bool) -> Env
    ? "The environment with one more hypothesis in front."
    Env(defs = env.defs, consts = env.consts, laws = env.laws, hyps = List.prepend(Hyp(name = h, eqn = Eqn(lhs = on, rhs = Term.TBool(value))), env.hyps), vars = env.vars, sums = env.sums, recs = env.recs, sigs = env.sigs)

verify withHyp
    List.len(withHyp(emptyEnv(), "h", Term.TVar("c"), true).hyps) => 1

fn linear(g: Term, v: Bool, hs: List<String>, ws: List<Int>, cs: List<Cut>, env: Env, path: String) -> Result<Eqn, String>
    ? "A comparison decided by linear arithmetic over the integers: its opposite and the named hypotheses, then the rows the cuts round from them, weighted, add up to a negative constant. Every row compares two Int terms."
    facts = hypEqns(hs, env.hyps, path)?
    intComparisons(List.prepend(g, lhsOf(facts)), env, path)?
    linearOver(g, v, facts, ws, cs, path)

fn intComparisons(ts: List<Term>, env: Env, path: String) -> Result<Unit, String>
    ? "Each term compares two Int terms: what linear arithmetic may read as a row."
    match ts
        [] -> Result.Ok(Unit)
        [Term.TOp(o, a, b), ..rest] -> match (typeOf(a, env, path)?, typeOf(b, env, path)?)
            (Ty.TyInt, Ty.TyInt) -> intComparisons(rest, env, path)
            _ -> Result.Err("step {path}: linear arithmetic reads comparisons of Int terms")
        _ -> Result.Err("step {path}: linear arithmetic reads comparisons of Int terms")

verify intComparisons
    intComparisons([Term.TOp("<", Term.TVar("a"), Term.TVar("a"))], withVars(emptyEnv(), [Kernel.Term.typed("a", Ty.TyFloat)]), "p") => Result.Err("step p: linear arithmetic reads comparisons of Int terms")
    intComparisons([Term.TOp("<", Term.TVar("a"), Term.TInt(1))], intsEnv(["a"]), "p") => Result.Ok(Unit)
    intComparisons([Term.TVar("b")], withVars(emptyEnv(), [Kernel.Term.typed("b", Ty.TyBool)]), "p") => Result.Err("step p: linear arithmetic reads comparisons of Int terms")

fn lhsOf(es: List<Eqn>) -> List<Term>
    ? "The left side of each equation."
    match es
        [] -> []
        [e, ..rest] -> List.prepend(e.lhs, lhsOf(rest))

verify lhsOf
    lhsOf([]) => []

fn linearOver(g: Term, v: Bool, facts: List<Eqn>, ws: List<Int>, cs: List<Cut>, path: String) -> Result<Eqn, String>
    ? "The contradiction the weights add up to."
    match Kernel.Ring.linearContradiction(List.prepend(Eqn(lhs = g, rhs = Term.TBool(Bool.not(v))), facts), cs, ws)
        true -> Result.Ok(Eqn(lhs = g, rhs = Term.TBool(v)))
        false -> refuse(path, "the weights do not add up to a contradiction")

verify linearOver
    linearOver(Term.TOp(">", Term.TVar("x"), Term.TInt(1)), true, [], [1], [], "p") => Result.Err("step p: the weights do not add up to a contradiction")

verify linear
    linear(Term.TOp(">", Term.TOp("+", Term.TVar("x"), Term.TInt(1)), Term.TInt(1)), true, ["h"], [1, 1], [], withHyp(intsEnv(["x"]), "h", Term.TOp(">", Term.TVar("x"), Term.TInt(0)), true), "p") => Result.Ok(Eqn(lhs = Term.TOp(">", Term.TOp("+", Term.TVar("x"), Term.TInt(1)), Term.TInt(1)), rhs = Term.TBool(true)))
    linear(Term.TOp(">", Term.TVar("x"), Term.TInt(1)), true, ["h"], [1, 1], [], withHyp(intsEnv(["x"]), "h", Term.TOp(">", Term.TVar("x"), Term.TInt(0)), true), "p") => Result.Err("step p: the weights do not add up to a contradiction")
    linear(Term.TOp(">=", Term.TOp("*", Term.TInt(2), Term.TVar("x")), Term.TInt(2)), true, ["h"], [1, 0, 2], [Cut(divisor = 2, weights = [0, 1])], withHyp(intsEnv(["x"]), "h", Term.TOp(">=", Term.TOp("*", Term.TInt(2), Term.TVar("x")), Term.TInt(1)), true), "p") => Result.Ok(Eqn(lhs = Term.TOp(">=", Term.TOp("*", Term.TInt(2), Term.TVar("x")), Term.TInt(2)), rhs = Term.TBool(true)))
    linear(Term.TOp(">=", Term.TOp("*", Term.TInt(2), Term.TVar("x")), Term.TInt(2)), true, ["h"], [1, 1], [], withHyp(intsEnv(["x"]), "h", Term.TOp(">=", Term.TOp("*", Term.TInt(2), Term.TVar("x")), Term.TInt(1)), true), "p") => Result.Err("step p: the weights do not add up to a contradiction")
    linear(Term.TOp(">=", Term.TOp("*", Term.TInt(2), Term.TVar("x")), Term.TInt(2)), true, ["h"], [1, 0, 2], [Cut(divisor = 3, weights = [0, 1])], withHyp(intsEnv(["x"]), "h", Term.TOp(">=", Term.TOp("*", Term.TInt(2), Term.TVar("x")), Term.TInt(1)), true), "p") => Result.Err("step p: the weights do not add up to a contradiction")

fn hypEqns(hs: List<String>, scope: List<Hyp>, path: String) -> Result<List<Eqn>, String>
    ? "The equations of the named hypotheses."
    match hs
        [] -> Result.Ok([])
        [h, ..rest] -> Result.Ok(List.prepend(hyp(h, scope, path)?, hypEqns(rest, scope, path)?))

verify hypEqns
    hypEqns(["h"], [], "p") => Result.Err("step p: hypothesis h is not in scope")

fn ring(l: Term, r: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "Two Int terms that are the same polynomial over their atoms."
    match (typeOf(l, env, path)?, typeOf(r, env, path)?, Kernel.Ring.samePolynomial(l, r))
        (Ty.TyInt, Ty.TyInt, true) -> Result.Ok(Eqn(lhs = l, rhs = r))
        (Ty.TyInt, Ty.TyInt, false) -> refuse(path, "the two sides are different polynomials")
        _ -> refuse(path, "ring needs two Int terms")

verify ring
    ring(Term.TOp("*", Term.TVar("a"), Term.TInt(2)), Term.TOp("+", Term.TVar("a"), Term.TVar("a")), intsEnv(["a"]), "p") => Result.Ok(Eqn(lhs = Term.TOp("*", Term.TVar("a"), Term.TInt(2)), rhs = Term.TOp("+", Term.TVar("a"), Term.TVar("a"))))
    ring(Term.TVar("a"), Term.TInt(0), intsEnv(["a"]), "p") => Result.Err("step p: the two sides are different polynomials")
    ring(Term.TVar("a"), Term.TVar("a"), listsEnv(["a"]), "p") => Result.Err("step p: ring needs two Int terms")

fn absurd(e: Eqn, l: Term, r: Term, path: String) -> Result<Eqn, String>
    ? "Any equation, once true has been shown equal to false: the case cannot happen."
    match (e.lhs, e.rhs)
        (Term.TBool(a), Term.TBool(b)) -> match a != b
            true -> Result.Ok(Eqn(lhs = l, rhs = r))
            false -> refuse(path, "absurd needs true equal to false")
        _ -> refuse(path, "absurd needs true equal to false")

verify absurd
    absurd(Eqn(lhs = Term.TBool(false), rhs = Term.TBool(true)), Term.TInt(1), Term.TInt(2), "p") => Result.Ok(Eqn(lhs = Term.TInt(1), rhs = Term.TInt(2)))
    absurd(Eqn(lhs = Term.TBool(true), rhs = Term.TBool(true)), Term.TInt(1), Term.TInt(2), "p") => Result.Err("step p: absurd needs true equal to false")

fn enumStep(v: String, l: Term, r: Term, cs: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "A split of a given of finite type into all its values: case i proves the claim at value i."
    match finOfVar(v, env)
        Option.None -> refuse(path, "{v} is not a given of finite type")
        Option.Some(f) -> enumCases(v, Eqn(lhs = l, rhs = r), Kernel.Finite.values(f), cs, env, path, 0)

verify enumStep
    enumStep("b", Term.TVar("b"), Term.TVar("b"), [], emptyEnv(), "p") => Result.Err("step p: b is not a given of finite type")

fn finOfVar(v: String, env: Env) -> Option<Fin>
    ? "The finite type of a variable, if its type is one."
    match Kernel.Types.typeOf(Term.TVar(v), tyEnv(env))
        Result.Ok(t) -> Kernel.Types.finOf(t, tyEnv(env), [])
        Result.Err(why) -> Option.None

verify finOfVar
    finOfVar("b", withVars(emptyEnv(), [Kernel.Term.typed("b", Ty.TyBool)])) => Option.Some(Fin.FBool)
    finOfVar("b", emptyEnv()) => Option.None

fn enumCases(v: String, claim: Eqn, vals: List<Term>, cs: List<Proof>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "One case per value, in order, and nothing else."
    match (vals, cs)
        ([], []) -> Result.Ok(claim)
        ([x, ..xs], [c, ..rest]) -> enumCase(v, claim, x, c, xs, rest, env, path, i)
        _ -> refuse(path, "the cases do not match the values of {v}")

verify enumCases
    enumCases("b", Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [Term.TBool(true)], [], emptyEnv(), "p", 0) => Result.Err("step p: the cases do not match the values of b")

fn enumCase(v: String, claim: Eqn, x: Term, c: Proof, xs: List<Term>, rest: List<Proof>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "The claim at one value, under the hypotheses at that value."
    at = [Kernel.Term.bind(v, x)]
    here = "{path}/enum.{i}"
    got = conclude(c, withHyps(env, substHyps(env.hyps, at, path)?), here)?
    want = instantiate(claim, at, path)?
    match got == want
        false -> refuse(here, "the case proves a different equation")
        true -> enumCases(v, claim, xs, rest, env, path, i + 1)

verify enumCase
    enumCase("b", Eqn(lhs = Term.TVar("b"), rhs = Term.TBool(true)), Term.TBool(false), Proof.PRefl(Term.TBool(true)), [], [], emptyEnv(), "p", 0) => Result.Err("step p/enum.0: the case proves a different equation")

fn substHyps(hs: List<Hyp>, at: List<Binding>, path: String) -> Result<List<Hyp>, String>
    ? "Every hypothesis at a substitution."
    match hs
        [] -> Result.Ok([])
        [h, ..rest] -> Result.Ok(List.prepend(Hyp(name = h.name, eqn = instantiate(h.eqn, at, path)?), substHyps(rest, at, path)?))

verify substHyps
    substHyps([], [], "p") => Result.Ok([])

fn withHyps(env: Env, hs: List<Hyp>) -> Env
    ? "The environment with its hypotheses replaced."
    Env(defs = env.defs, consts = env.consts, laws = env.laws, hyps = hs, vars = env.vars, sums = env.sums, recs = env.recs, sigs = env.sigs)

verify withHyps
    withHyps(emptyEnv(), []).hyps => []

fn constant(n: String, env: Env, path: String) -> Result<Eqn, String>
    ? "A module-level binding's value, unless a variable in the current proof scope shadows its name."
    match List.contains(Kernel.Proof.givenNames(env.vars), n)
        true -> refuse(path, "module-level binding {n} is shadowed by a variable")
        false -> constantIn(n, env.consts, path)

verify constant
    constant("n", Env(defs = [], consts = [Const(name = "n", ty = Ty.TyInt, value = Term.TInt(0))], laws = [], hyps = [], vars = [Kernel.Term.typed("n", Ty.TyInt)], sums = [], recs = [], sigs = []), "p") => Result.Err("step p: module-level binding n is shadowed by a variable")

fn constantIn(n: String, cs: List<Const>, path: String) -> Result<Eqn, String>
    ? "A module-level binding's declared value."
    match cs
        [] -> refuse(path, "no module-level binding {n}")
        [c, ..rest] -> match c.name == n
            true -> Result.Ok(Eqn(lhs = Term.TVar(n), rhs = c.value))
            false -> constantIn(n, rest, path)

verify constantIn
    constantIn("base", [Const(name = "base", ty = Ty.TyAny, value = Term.TInt(40))], "p") => Result.Ok(Eqn(lhs = Term.TVar("base"), rhs = Term.TInt(40)))
    constantIn("Lib.base", [Const(name = "base", ty = Ty.TyAny, value = Term.TInt(40))], "p") => Result.Err("step p: no module-level binding Lib.base")

fn zipBind(names: List<String>, values: List<Term>) -> List<Binding>
    ? "Pair names with terms, as far as both go."
    match (names, values)
        ([n, ..ns], [v, ..vs]) -> List.prepend(Kernel.Term.bind(n, v), zipBind(ns, vs))
        _ -> []

verify zipBind
    zipBind(["a"], [Term.TInt(1)]) => [Kernel.Term.bind("a", Term.TInt(1))]

fn unfold(f: String, k: Int, xs: List<Term>, ys: List<Term>, pre: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "Equation k of a definition at explicit arguments: 0 is the whole body, k is arm k of its match."
    match Kernel.Proof.findDef(f, env.defs)
        Option.None -> refuse(path, "no definition of {f}")
        Option.Some(d) -> match (argsFit(d, xs, env, path), Kernel.Induct.openGate(d, env.defs))
            (_, Result.Err(why)) -> refuse(path, why)
            (Result.Err(why), _) -> Result.Err(why)
            _ -> unfoldArm(d, k, xs, ys, pre, env, path)

verify unfold
    unfold("f", 0, [], [], [], emptyEnv(), "p") => Result.Err("step p: no definition of f")

fn unfoldArm(d: Def, k: Int, xs: List<Term>, ys: List<Term>, pre: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "The whole body, or one arm under its premise; the local bindings are substituted first, in order."
    outer = bindLets(d.lets, List.reverse(zipBind(Kernel.Types.paramsOf(d), xs)))?
    lhs = Term.TCall(d.name, xs)
    match (k, ys, pre)
        (0, [], []) -> Result.Ok(Eqn(lhs = lhs, rhs = Kernel.Subst.subst(d.body, outer)?))
        (0, _, _) -> refuse(path, "equation 0 takes no binders and no premise")
        _ -> unfoldMatch(d.body, k, outer, ys, pre, lhs, env, path)

verify unfoldArm
    unfoldArm(Def(name = "one", params = [], ret = Ty.TyAny, lets = [], body = Term.TInt(1)), 0, [], [], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TCall("one", []), rhs = Term.TInt(1)))
    unfoldArm(Def(name = "one", params = [], ret = Ty.TyAny, lets = [], body = Term.TInt(1)), 1, [], [], [], emptyEnv(), "p") => Result.Err("step p: the body is not a match")
    unfoldArm(Def(name = "f", params = [Kernel.Term.typed("x", Ty.TyAny)], ret = Ty.TyAny, lets = [Kernel.Term.bind("y", Term.TOp("+", Term.TVar("x"), Term.TInt(1))), Kernel.Term.bind("z", Term.TOp("*", Term.TVar("y"), Term.TVar("x")))], body = Term.TVar("z")), 0, [Term.TVar("a")], [], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TCall("f", [Term.TVar("a")]), rhs = Term.TOp("*", Term.TOp("+", Term.TVar("a"), Term.TInt(1)), Term.TVar("a"))))
    unfoldArm(Def(name = "f", params = [Kernel.Term.typed("x", Ty.TyAny)], ret = Ty.TyAny, lets = [Kernel.Term.bind("x", Term.TOp("+", Term.TVar("x"), Term.TInt(1)))], body = Term.TVar("x")), 0, [Term.TVar("a")], [], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TCall("f", [Term.TVar("a")]), rhs = Term.TOp("+", Term.TVar("a"), Term.TInt(1))))

fn bindLets(lets: List<Binding>, outer: List<Binding>) -> Result<List<Binding>, String>
    ? "Each local binding, in order, bound to its value under everything before it; the latest name comes first."
    match lets
        [] -> Result.Ok(outer)
        [b, ..rest] -> bindLets(rest, List.prepend(Kernel.Term.bind(b.name, Kernel.Subst.subst(b.value, outer)?), outer))

verify bindLets
    bindLets([], []) => Result.Ok([])
    bindLets([Kernel.Term.bind("y", Term.TVar("x"))], [Kernel.Term.bind("x", Term.TInt(2))]) => Result.Ok([Kernel.Term.bind("y", Term.TInt(2)), Kernel.Term.bind("x", Term.TInt(2))])

fn unfoldMatch(body: Term, k: Int, outer: List<Binding>, ys: List<Term>, pre: List<Proof>, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "Arm k of the body's match."
    match body
        Term.TMatch(s, arms) -> selected(s, arms, k, outer, ys, pre, lhs, env, path)
        _ -> refuse(path, "the body is not a match")

verify unfoldMatch
    unfoldMatch(Term.TUnit, 1, [], [], [], Term.TUnit, emptyEnv(), "p") => Result.Err("step p: the body is not a match")

fn armStep(k: Int, ys: List<Term>, t: Term, q: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "Arm k of an explicit match term, under its premise."
    match t
        Term.TMatch(s, arms) -> selected(s, arms, k, [], ys, [q], t, env, path)
        _ -> refuse(path, "not a match")

verify armStep
    armStep(1, [], Term.TUnit, Proof.PRefl(Term.TUnit), emptyEnv(), "p") => Result.Err("step p: not a match")

fn selected(s: Term, arms: List<Arm>, k: Int, outer: List<Binding>, ys: List<Term>, pre: List<Proof>, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "lhs = arm k, once the premise shows the subject has arm k's pattern."
    match (armAt(arms, k), pre)
        (Option.None, _) -> refuse(path, "there is no arm {k}")
        (_, [q]) -> selectedWith(s, arms, k, outer, ys, q, lhs, env, path)
        _ -> refuse(path, "an arm needs exactly one premise")

verify selected
    selected(Term.TVar("s"), [], 1, [], [], [], Term.TUnit, emptyEnv(), "p") => Result.Err("step p: there is no arm 1")

fn selectedWith(s: Term, arms: List<Arm>, k: Int, outer: List<Binding>, ys: List<Term>, q: Proof, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "Check the arm is the first that can match, then the premise."
    chosen = Option.withDefault(armAt(arms, k), Arm(pattern = Pat.PWild, body = Term.TUnit))
    match (isCatchAll(chosen.pattern), ys)
        (true, [v]) -> catchAllArm(s, arms, k, chosen, outer, v, q, lhs, env, path)
        (true, _) -> refuse(path, "a catch-all arm takes the value it is chosen for")
        (false, _) -> match earlierExclude(arms, k, chosen.pattern)
            false -> refuse(path, "an earlier arm can also match arm {k}")
            true -> armEquation(s, chosen, outer, ys, q, lhs, env, path)

verify selectedWith
    selectedWith(Term.TVar("s"), [Arm(pattern = Pat.PWild, body = Term.TUnit), Arm(pattern = Pat.PNil, body = Term.TUnit)], 2, [], [], Proof.PRefl(Term.TUnit), Term.TUnit, emptyEnv(), "p") => Result.Err("step p: an earlier arm can also match arm 2")

fn isCatchAll(p: Pat) -> Bool
    ? "A pattern every value matches: the wildcard or a bare name."
    match p
        Pat.PWild -> true
        Pat.PVar(n) -> true
        _ -> false

verify isCatchAll
    isCatchAll(Pat.PVar("x")) => true
    isCatchAll(Pat.PNil) => false

fn catchAllArm(s: Term, arms: List<Arm>, k: Int, chosen: Arm, outer: List<Binding>, v: Term, q: Proof, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "A catch-all arm chosen for one value: every earlier arm excludes it, the premise shows the subject is it, and a named catch-all binds it."
    subject = Kernel.Subst.subst(s, outer)?
    bound(zipBind(Kernel.Subst.patNames(chosen.pattern), [v]), Kernel.Types.namedVars(Kernel.Subst.patNames(chosen.pattern), [typeOf(subject, env, path)?]), env, "arm {k}", path)?
    match earlierExcludeValue(arms, k, v, env.hyps)
        false -> refuse(path, "an earlier arm can also match arm {k}")
        true -> catchAllBody(chosen, List.concat(zipBind(Kernel.Subst.patNames(chosen.pattern), [v]), outer), Eqn(lhs = subject, rhs = v), conclude(q, env, "{path}/premise")?, lhs, path)

verify catchAllArm
    catchAllArm(Term.TVar("c"), [Arm(pattern = Pat.PLit(Term.TInt(0)), body = Term.TInt(1)), Arm(pattern = Pat.PWild, body = Term.TInt(2))], 2, Arm(pattern = Pat.PWild, body = Term.TInt(2)), [], Term.TInt(0), Proof.PRefl(Term.TInt(0)), Term.TUnit, intsEnv(["c"]), "p") => Result.Err("step p: an earlier arm can also match arm 2")
    catchAllArm(Term.TInt(5), [Arm(pattern = Pat.PLit(Term.TInt(0)), body = Term.TInt(1)), Arm(pattern = Pat.PVar("n"), body = Term.TVar("n"))], 2, Arm(pattern = Pat.PVar("n"), body = Term.TVar("n")), [], Term.TInt(5), Proof.PRefl(Term.TInt(5)), Term.TUnit, emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TInt(5)))

fn catchAllBody(chosen: Arm, inner: List<Binding>, needed: Eqn, got: Eqn, lhs: Term, path: String) -> Result<Eqn, String>
    ? "The arm's body once the premise is the one it needs."
    match got == needed
        false -> refuse(path, "the premise does not select this arm")
        true -> Result.Ok(Eqn(lhs = lhs, rhs = Kernel.Subst.subst(chosen.body, inner)?))

verify catchAllBody
    catchAllBody(Arm(pattern = Pat.PWild, body = Term.TInt(2)), [], Eqn(lhs = Term.TInt(1), rhs = Term.TInt(1)), Eqn(lhs = Term.TInt(1), rhs = Term.TInt(2)), Term.TUnit, "p") => Result.Err("step p: the premise does not select this arm")

fn earlierExcludeValue(arms: List<Arm>, k: Int, v: Term, hs: List<Hyp>) -> Bool
    ? "Every arm before arm k certainly does not match the value: by its shape, or a literal arm by a hypothesis (v == k) = false in scope."
    match (arms, k > 1)
        ([a, ..rest], true) -> Bool.and(Bool.or(excludes(a.pattern, v), ruledOut(a.pattern, v, hs)), earlierExcludeValue(rest, k - 1, v, hs))
        _ -> true

verify earlierExcludeValue
    earlierExcludeValue([Arm(pattern = Pat.PCtor("C.A", []), body = Term.TUnit)], 2, Term.TCtor("C.B", []), []) => true
    earlierExcludeValue([Arm(pattern = Pat.PLit(Term.TInt(0)), body = Term.TUnit)], 2, Term.TVar("x"), []) => false
    earlierExcludeValue([Arm(pattern = Pat.PLit(Term.TInt(0)), body = Term.TUnit)], 2, Term.TVar("x"), [Hyp(name = "n", eqn = Eqn(lhs = Term.TOp("==", Term.TVar("x"), Term.TInt(0)), rhs = Term.TBool(false)))]) => true
    earlierExcludeValue([Arm(pattern = Pat.PLit(Term.TInt(0)), body = Term.TUnit)], 2, Term.TVar("x"), [Hyp(name = "n", eqn = Eqn(lhs = Term.TOp("==", Term.TVar("x"), Term.TInt(0)), rhs = Term.TBool(true)))]) => false

fn ruledOut(p: Pat, v: Term, hs: List<Hyp>) -> Bool
    ? "A literal pattern k that a hypothesis in scope states the value is not: (v == k) = false."
    match p
        Pat.PLit(k) -> Bool.and(isLiteral(k), stated(Eqn(lhs = Term.TOp("==", v, k), rhs = Term.TBool(false)), hs))
        _ -> false

verify ruledOut
    ruledOut(Pat.PWild, Term.TVar("x"), []) => false

fn stated(e: Eqn, hs: List<Hyp>) -> Bool
    ? "Some hypothesis in scope states exactly e."
    match hs
        [] -> false
        [h, ..rest] -> Bool.or(h.eqn == e, stated(e, rest))

verify stated
    stated(Eqn(lhs = Term.TUnit, rhs = Term.TUnit), []) => false

fn excludes(p: Pat, v: Term) -> Bool
    ? "Whether a pattern certainly does not match a value: another literal, another constructor, the other list shape."
    match (p, v)
        (Pat.PLit(x), _) -> Bool.and(isLiteral(v), x != v)
        (Pat.PCtor(c, xs), Term.TCtor(d, ys)) -> c != d
        (Pat.PNil, Term.TBi("List.prepend", [h, t])) -> true
        (Pat.PCons(h, t), Term.TList([])) -> true
        _ -> false

verify excludes
    excludes(Pat.PLit(Term.TInt(0)), Term.TInt(3)) => true
    excludes(Pat.PLit(Term.TInt(0)), Term.TVar("x")) => false
    excludes(Pat.PLit(Term.TInt(0)), Term.TStr("0")) => true
    excludes(Pat.PNil, Term.TList([Term.TInt(1)])) => false
    excludes(Pat.PWild, Term.TInt(1)) => false

fn isLiteral(t: Term) -> Bool
    ? "An Int, Bool, text or unit literal."
    match t
        Term.TInt(n) -> true
        Term.TBool(b) -> true
        Term.TStr(s) -> true
        Term.TUnit -> true
        _ -> false

verify isLiteral
    isLiteral(Term.TVar("x")) => false

fn armEquation(s: Term, chosen: Arm, outer: List<Binding>, ys: List<Term>, q: Proof, lhs: Term, env: Env, path: String) -> Result<Eqn, String>
    ? "subject = pattern must be what the premise proves; then lhs equals the arm's body."
    shape = patTerm(chosen.pattern, ys, path)?
    subject = Kernel.Subst.subst(s, outer)?
    parts = withoutNames(zipBind(patFields(chosen.pattern), ys), ["_"])
    bound(parts, patTypes(chosen.pattern, typeOf(subject, env, path)?, env, path)?, env, "the arm", path)?
    inner = List.concat(parts, outer)
    needed = Eqn(lhs = subject, rhs = shape)
    got = conclude(q, env, "{path}/premise")?
    match got == needed
        false -> refuse(path, "the premise does not select this arm")
        true -> Result.Ok(Eqn(lhs = lhs, rhs = Kernel.Subst.subst(chosen.body, inner)?))

verify armEquation
    armEquation(Term.TVar("c"), Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(1)), [], [], Proof.PHyp("h"), Term.TUnit, withHyp(withVars(emptyEnv(), [Kernel.Term.typed("c", Ty.TyBool)]), "h", Term.TVar("c"), false), "p") => Result.Err("step p: the premise does not select this arm")

fn armAt(arms: List<Arm>, k: Int) -> Option<Arm>
    ? "Arm k, counting from 1."
    match (arms, k)
        ([a, ..rest], 1) -> Option.Some(a)
        ([a, ..rest], _) -> match k > 1
            true -> armAt(rest, k - 1)
            false -> Option.None
        _ -> Option.None

verify armAt
    armAt([], 1) => Option.None
    armAt([Arm(pattern = Pat.PWild, body = Term.TUnit)], 0) => Option.None

fn earlierExclude(arms: List<Arm>, k: Int, p: Pat) -> Bool
    ? "Every arm before arm k has a head pattern p cannot share."
    match (arms, k > 1)
        ([a, ..rest], true) -> Bool.and(headsDiffer(a.pattern, p), earlierExclude(rest, k - 1, p))
        _ -> true

verify earlierExclude
    earlierExclude([Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TUnit)], 2, Pat.PLit(Term.TBool(true))) => true

fn headsDiffer(a: Pat, b: Pat) -> Bool
    ? "Two patterns no value can both match."
    match (a, b)
        (Pat.PLit(x), Pat.PLit(y)) -> x != y
        (Pat.PNil, Pat.PCons(h, t)) -> true
        (Pat.PCons(h, t), Pat.PNil) -> true
        (Pat.PCtor(c, xs), Pat.PCtor(d, ys)) -> c != d
        _ -> false

verify headsDiffer
    headsDiffer(Pat.PWild, Pat.PNil) => false
    headsDiffer(Pat.PCtor("A", []), Pat.PCtor("B", [])) => true

fn patTerm(p: Pat, ys: List<Term>, path: String) -> Result<Term, String>
    ? "The value a pattern denotes once its names are bound to ys."
    match (p, ys)
        (Pat.PLit(t), []) -> Result.Ok(t)
        (Pat.PNil, []) -> Result.Ok(Term.TList([]))
        (Pat.PCons(h, t), [x, y]) -> Result.Ok(Term.TBi("List.prepend", [x, y]))
        (Pat.PCtor(c, names), _) -> ctorTerm(c, names, ys, path)
        _ -> Result.Err("step {path}: this pattern has no term to equate the subject with")

verify patTerm
    patTerm(Pat.PWild, [], "p") => Result.Err("step p: this pattern has no term to equate the subject with")

fn ctorTerm(c: String, names: List<String>, ys: List<Term>, path: String) -> Result<Term, String>
    ? "A constructor pattern with one term per field, a wildcard field as well."
    match List.len(names) == List.len(ys)
        true -> Result.Ok(Term.TCtor(c, ys))
        false -> Result.Err("step {path}: the binders do not fit the constructor pattern")

verify ctorTerm
    ctorTerm("Option.Some", ["x"], [Term.TInt(1)], "p") => Result.Ok(Term.TCtor("Option.Some", [Term.TInt(1)]))
    ctorTerm("C.Pair", ["_", "x"], [Term.TVar("a"), Term.TVar("b")], "p") => Result.Ok(Term.TCtor("C.Pair", [Term.TVar("a"), Term.TVar("b")]))
    ctorTerm("Option.Some", ["x"], [], "p") => Result.Err("step p: the binders do not fit the constructor pattern")

fn patFields(p: Pat) -> List<String>
    ? "The names a pattern's parts take, in order, a wildcard part as _."
    match p
        Pat.PCons(h, t) -> [h, t]
        Pat.PCtor(c, names) -> names
        _ -> Kernel.Subst.patNames(p)

verify patFields
    patFields(Pat.PCtor("C.Pair", ["_", "x"])) => ["_", "x"]
    patFields(Pat.PLit(Term.TInt(1))) => []

fn boundNames(bs: List<Binding>) -> List<String>
    ? "The names a substitution binds, in order."
    match bs
        [] -> []
        [b, ..rest] -> List.prepend(b.name, boundNames(rest))

verify boundNames
    boundNames([Kernel.Term.bind("a", Term.TUnit)]) => ["a"]

fn instantiate(e: Eqn, bs: List<Binding>, path: String) -> Result<Eqn, String>
    ? "An equation at a substitution."
    match (Kernel.Subst.subst(e.lhs, bs), Kernel.Subst.subst(e.rhs, bs))
        (Result.Ok(l), Result.Ok(r)) -> Result.Ok(Eqn(lhs = l, rhs = r))
        _ -> refuse(path, "the substitution captures a bound name")

verify instantiate
    instantiate(Eqn(lhs = Term.TVar("a"), rhs = Term.TVar("a")), [Kernel.Term.bind("a", Term.TInt(2))], "p") => Result.Ok(Eqn(lhs = Term.TInt(2), rhs = Term.TInt(2)))

fn premisesHold(wanted: List<Eqn>, ps: List<Proof>, bs: List<Binding>, env: Env, path: String, i: Int) -> Result<Unit, String>
    ? "Each premise proof proves its premise at the substitution."
    match (wanted, ps)
        ([], []) -> Result.Ok(Unit)
        ([w, ..ws], [p, ..rest]) -> premiseHolds(w, p, ws, rest, bs, env, path, i)
        _ -> Result.Err("step {path}: wrong number of premises")

verify premisesHold
    premisesHold([], [Proof.PHyp("h")], [], emptyEnv(), "p", 0) => Result.Err("step p: wrong number of premises")

fn premiseHolds(w: Eqn, p: Proof, ws: List<Eqn>, rest: List<Proof>, bs: List<Binding>, env: Env, path: String, i: Int) -> Result<Unit, String>
    ? "One premise, then the rest."
    want = instantiate(w, bs, path)?
    got = conclude(p, env, "{path}/premise.{i}")?
    match got == want
        false -> Result.Err("step {path}: premise {i} does not match")
        true -> premisesHold(ws, rest, bs, env, path, i + 1)

verify premiseHolds
    premiseHolds(Eqn(lhs = Term.TVar("a"), rhs = Term.TBool(true)), Proof.PRefl(Term.TInt(1)), [], [], [], emptyEnv(), "p", 0) => Result.Err("step p: premise 0 does not match")

fn rule(id: String, bs: List<Binding>, ps: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "A wall rule at an explicit substitution of all its binders."
    match Kernel.Rules.schema(id)
        Option.None -> refuse(path, "unknown rule {id}")
        Option.Some(s) -> match boundNames(bs) == Kernel.Proof.givenNames(s.binders)
            false -> refuse(path, "rule {id} binds {commaJoined(Kernel.Proof.givenNames(s.binders))}")
            true -> ruleConclusion(bound(bs, s.binders, env, "rule {id}", path), s.premises, s.concl, bs, ps, env, path)

verify rule
    rule("int.ne.def", [Kernel.Term.bind("a", Term.TInt(1))], [], emptyEnv(), "p") => Result.Err("step p: rule int.ne.def binds a,b")
    rule("int.ne.def", [Kernel.Term.bind("a", Term.TInt(1)), Kernel.Term.bind("b", Term.TInt(2))], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TOp("!=", Term.TInt(1), Term.TInt(2)), rhs = Term.TBi("Bool.not", [Term.TOp("==", Term.TInt(1), Term.TInt(2))])))
    rule("int.ne.def", [Kernel.Term.bind("a", Term.TStr("a")), Kernel.Term.bind("b", Term.TStr("b"))], [], emptyEnv(), "p") => Result.Err("step p: rule int.ne.def: a := String is not Int")
    rule("int.ne.def", [Kernel.Term.bind("b", Term.TInt(1)), Kernel.Term.bind("a", Term.TInt(2))], [], emptyEnv(), "p") => Result.Err("step p: rule int.ne.def binds a,b")
    rule("int.add_comm", [Kernel.Term.bind("a", Term.TInt(1)), Kernel.Term.bind("b", Term.TInt(2))], [], emptyEnv(), "p") => Result.Err("step p: unknown rule int.add_comm")
    rule("bool.beq.refl", [Kernel.Term.bind("a", Term.TVar("f"))], [], withVars(emptyEnv(), [Kernel.Term.typed("f", Ty.TyFloat)]), "p") => Result.Err("step p: rule bool.beq.refl: a := == on Float is not equality")
    rule("bool.beq.symm", [Kernel.Term.bind("a", Term.TVar("f")), Kernel.Term.bind("b", Term.TVar("f"))], [], withVars(emptyEnv(), [Kernel.Term.typed("f", Ty.TyFloat)]), "p") => Result.Err("step p: rule bool.beq.symm: a := == on Float is not equality")

fn ruleConclusion(typed: Result<Unit, String>, wanted: List<Eqn>, concl: Eqn, bs: List<Binding>, ps: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "Once the binders are typed: premises first, then the conclusion."
    typed?
    premisesHold(wanted, ps, bs, env, path, 0)?
    instantiate(concl, bs, path)

verify ruleConclusion
    ruleConclusion(Result.Ok(Unit), [], Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [], [], emptyEnv(), "p") => Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TUnit))
    ruleConclusion(Result.Err("no"), [], Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [], [], emptyEnv(), "p") => Result.Err("no")

fn findLaw(key: String, ls: List<Law>) -> Option<Law>
    ? "A cited law by key."
    match ls
        [] -> Option.None
        [l, ..rest] -> match l.key == key
            true -> Option.Some(l)
            false -> findLaw(key, rest)

verify findLaw
    findLaw("k", []) => Option.None

fn lawStep(key: String, bs: List<Binding>, ps: List<Proof>, env: Env, path: String) -> Result<Eqn, String>
    ? "An earlier law at an explicit substitution of all its givens, its when proved."
    match findLaw(key, env.laws)
        Option.None -> refuse(path, "law {key} is not cited")
        Option.Some(l) -> match boundNames(bs) == Kernel.Proof.givenNames(l.givens)
            false -> refuse(path, "law {key} quantifies {commaJoined(Kernel.Proof.givenNames(l.givens))}")
            true -> ruleConclusion(bound(bs, l.givens, env, "law {key}", path), lawPremises(l), Eqn(lhs = l.lhs, rhs = l.rhs), bs, ps, env, path)

verify lawStep
    lawStep("k", [], [], emptyEnv(), "p") => Result.Err("step p: law k is not cited")
    lawStep("one.isOnly", [Kernel.Term.bind("x", Term.TInt(0))], [], Env(defs = [], consts = [], laws = [Law(key = "one.isOnly", givens = [Kernel.Term.typed("x", Ty.TyNamed("One"))], premise = [], lhs = Term.TVar("x"), rhs = Term.TCtor("One.Only", []))], hyps = [], vars = [], sums = [], recs = [], sigs = []), "p") => Result.Err("step p: law one.isOnly: x := Int is not One")

fn lawPremises(l: Law) -> List<Eqn>
    ? "A law's when as a premise equation."
    match l.premise
        [p, ..rest] -> [Eqn(lhs = p, rhs = Term.TBool(true))]
        [] -> []

verify lawPremises
    lawPremises(Law(key = "k", givens = [], premise = [], lhs = Term.TUnit, rhs = Term.TUnit)) => []

fn checkScript(s: Script) -> Result<String, String>
    ? "The proof must prove exactly the obligation, under its when; every cited builtin fact is checked first."
    Kernel.Induct.refuseMutualRecursion(s.defs)?
    checkFacts(s.facts, [])?
    env = Env(defs = s.defs, consts = s.consts, laws = List.concat(s.laws, factLaws(s.facts)), hyps = lawHyps(s.obligation), vars = Kernel.Types.rigidVars(s.obligation.givens), sums = s.sums, recs = s.recs, sigs = s.sigs)
    declarationsTyped(env, "proof")?
    statementTyped(s.obligation, env)?
    e = conclude(s.proof, env, "proof")?
    match e == Eqn(lhs = s.obligation.lhs, rhs = s.obligation.rhs)
        true -> Result.Ok(s.obligation.key)
        false -> Result.Err("step proof: the proof ends at a different equation than the claim")

verify checkScript
    checkScript(Script(obligation = Law(key = "k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(1)), defs = [], consts = [], sums = [], recs = [], sigs = [], laws = [], facts = [], proof = Proof.PRefl(Term.TInt(1)))) => Result.Ok("k")
    checkScript(Script(obligation = Law(key = "k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(2)), defs = [], consts = [], sums = [], recs = [], sigs = [], laws = [], facts = [], proof = Proof.PRefl(Term.TInt(1)))) => Result.Err("step proof: the proof ends at a different equation than the claim")

fn statementTyped(ob: Law, env: Env) -> Result<Unit, String>
    ? "The claim's two sides have one type and its when is a Bool: a statement written wrongly is refused before its proof is read."
    match (Kernel.Types.join(typeOf(ob.lhs, env, "proof")?, typeOf(ob.rhs, env, "proof")?), typesOf(ob.premise, env, "proof")?)
        (Result.Err(why), _) -> Result.Err("step proof: the claim compares {why}")
        (_, [Ty.TyBool]) -> Result.Ok(Unit)
        (_, []) -> Result.Ok(Unit)
        _ -> Result.Err("step proof: the when is not a Bool")

verify statementTyped
    statementTyped(Law(key = "k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TStr("a")), emptyEnv()) => Result.Err("step proof: the claim compares Int is not String")
    statementTyped(Law(key = "k", givens = [], premise = [Term.TInt(1)], lhs = Term.TInt(1), rhs = Term.TInt(1)), emptyEnv()) => Result.Err("step proof: the when is not a Bool")

fn typesOf(ts: List<Term>, env: Env, path: String) -> Result<List<Ty>, String>
    ? "The type of each term."
    match ts
        [] -> Result.Ok([])
        [t, ..rest] -> Result.Ok(List.prepend(typeOf(t, env, path)?, typesOf(rest, env, path)?))

verify typesOf
    typesOf([Term.TInt(1)], emptyEnv(), "p") => Result.Ok([Ty.TyInt])

fn lawHyps(ob: Law) -> List<Hyp>
    ? "The obligation's when, as hypothesis `when`."
    match ob.premise
        [p, ..rest] -> [Hyp(name = "when", eqn = Eqn(lhs = p, rhs = Term.TBool(true)))]
        [] -> []

verify lawHyps
    lawHyps(Law(key = "k", givens = [], premise = [Term.TVar("c")], lhs = Term.TUnit, rhs = Term.TUnit)) => [Hyp(name = "when", eqn = Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))]

fn commaJoined(ns: List<String>) -> String
    ? "Names separated by commas."
    String.join(ns, ",")

verify commaJoined
    commaJoined(["a", "b"]) => "a,b"

fn induct(f: String, xs: List<Term>, claim: Eqn, carry: List<String>, cs: List<Case>, env: Env, path: String) -> Result<Eqn, String>
    ? "Induction along the recursion of f at arguments xs, as its gate checked it: one case per arm of its match, each with one hypothesis per recursive call in the arm. The hypotheses named in carry hold in each case; a call's hypothesis holds once they are proved at the call's arguments."
    match Kernel.Proof.findDef(f, env.defs)
        Option.None -> refuse(path, "no definition of {f}")
        Option.Some(d) -> match Kernel.Induct.recursion(d, env.defs)
            Result.Err(why) -> refuse(path, why)
            Result.Ok(Option.None) -> refuse(path, "{f} does not recurse")
            Result.Ok(Option.Some(r)) -> inductOn(d, r, xs, claim, carry, cs, env, path)

verify induct
    induct("f", [], Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [], [], emptyEnv(), "p") => Result.Err("step p: no definition of f")
    induct("f", [Term.TVar("n")], Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), [], [], Env(defs = [Def(name = "f", params = [Kernel.Term.typed("n", Ty.TyAny)], ret = Ty.TyAny, lets = [], body = Term.TVar("n"))], consts = [], laws = [], hyps = [], vars = [Kernel.Term.typed("n", Ty.TyInt)], sums = [], recs = [], sigs = []), "p") => Result.Err("step p: f does not recurse")
    induct("f", [Term.TVar("n")], Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), [], [], Env(defs = [Def(name = "f", params = [Kernel.Term.typed("n", Ty.TyAny)], ret = Ty.TyAny, lets = [], body = Term.TMatch(Term.TOp(">", Term.TVar("n"), Term.TInt(0)), [Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TCall("f", [Term.TBi("__int_div_euclid", [Term.TVar("n"), Term.TInt(1)])])), Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0))]))], consts = [], laws = [], hyps = [], vars = [Kernel.Term.typed("n", Ty.TyInt)], sums = [], recs = [], sigs = []), "p") => Result.Err("step p: f does not count n down to zero")

fn inductOn(d: Def, r: Recursion, xs: List<Term>, claim: Eqn, carry: List<String>, cs: List<Case>, env: Env, path: String) -> Result<Eqn, String>
    ? "The arguments, the varied givens and the shape of the arms, then every case."
    match (argsFit(d, xs, env, path), Kernel.Induct.varied(xs, r.at, Kernel.Proof.givenNames(env.vars)))
        (Result.Err(why), _) -> Result.Err(why)
        (_, Result.Err(why)) -> refuse(path, why)
        (_, Result.Ok(vr)) -> inductChecked(d, r, xs, claim, namedHyps(carry, env.hyps, path)?, cs, vr, env, path)

verify inductOn
    inductOn(Def(name = "f", params = [Kernel.Term.typed("x", Ty.TyAny)], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.None, arms = []), [], Eqn(lhs = Term.TUnit, rhs = Term.TUnit), [], [], emptyEnv(), "p") => Result.Err("step p: f takes 1 arguments")

fn inductChecked(d: Def, r: Recursion, xs: List<Term>, claim: Eqn, carried: List<Hyp>, cs: List<Case>, vr: Varied, env: Env, path: String) -> Result<Eqn, String>
    ? "One case per arm, the arms of the shape the descent needs. The cases see the carried hypotheses and those that mention nothing the induction varies."
    varying = List.prepend(vr.v, placeNames(vr.general))
    match (List.len(r.arms) == List.len(cs), measured(r, vr.v, env))
        (false, _) -> refuse(path, "{List.len(r.arms)} arms, {List.len(cs)} cases")
        (_, Result.Err(why)) -> refuse(path, why)
        _ -> inductCases(d, r, r.arms, cs, Kernel.Induct.Call(args = xs, inner = []), claim, vr, takenNames(claim, env.hyps), carried, withHyps(env, notMentioningAny(env.hyps, varying)), path, 0)

verify inductChecked
    inductChecked(Def(name = "f", params = [], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.None, arms = []), [], Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("x")), [], [Case(binders = [], ihs = [], carry = [], more = [], proof = Proof.PRefl(Term.TUnit))], Varied(v = "x", general = []), emptyEnv(), "p") => Result.Err("step p: 0 arms, 1 cases")

fn measured(r: Recursion, v: String, env: Env) -> Result<Unit, String>
    ? "A match on the value itself needs exactly one well-shaped arm per constructor of v's type; a count toward zero needs v to be a given of type Int."
    match r.guard
        Option.None -> match Kernel.Types.typeOf(Term.TVar(v), tyEnv(env))
            Result.Ok(t) -> match constructorArmsFit(armsOf(r.arms), t, tyEnv(env))
                true -> Result.Ok(Unit)
                false -> Result.Err("the induction arms are not exactly the constructors of {Kernel.Types.show(t)}")
            Result.Err(why) -> Result.Err(why)
        Option.Some(g) -> match Kernel.Types.typeOf(Term.TVar(v), tyEnv(env))
            Result.Ok(Ty.TyInt) -> Result.Ok(Unit)
            _ -> Result.Err("{v} is not a given of type Int")

verify measured
    measured(Recursion(at = 0, guard = Option.Some(Term.TOp(">", Term.TVar("x"), Term.TInt(0))), arms = []), "n", intsEnv(["m"])) => Result.Err("n is not a given of type Int")
    measured(Recursion(at = 0, guard = Option.Some(Term.TOp(">", Term.TVar("x"), Term.TInt(0))), arms = []), "n", intsEnv(["n"])) => Result.Ok(Unit)
    measured(Recursion(at = 0, guard = Option.None, arms = [ArmCalls(arm = Arm(pattern = Pat.PWild, body = Term.TUnit), calls = [])]), "n", emptyEnv()) => Result.Err("n is not a variable in scope")
    measured(Recursion(at = 0, guard = Option.None, arms = [ArmCalls(arm = Arm(pattern = Pat.PCtor("C.A", []), body = Term.TUnit), calls = [])]), "x", sumEnv()) => Result.Err("the induction arms are not exactly the constructors of C")
    measured(Recursion(at = 0, guard = Option.None, arms = [ArmCalls(arm = Arm(pattern = Pat.PCtor("C.B", []), body = Term.TUnit), calls = []), ArmCalls(arm = Arm(pattern = Pat.PCtor("C.A", []), body = Term.TUnit), calls = [])]), "x", sumEnv()) => Result.Ok(Unit)

fn armsOf(acs: List<ArmCalls>) -> List<Arm>
    ? "The arms, without their calls."
    match acs
        [] -> []
        [a, ..rest] -> List.prepend(a.arm, armsOf(rest))

verify armsOf
    armsOf([ArmCalls(arm = Arm(pattern = Pat.PNil, body = Term.TUnit), calls = [])]) => [Arm(pattern = Pat.PNil, body = Term.TUnit)]

fn notMentioningAny(hs: List<Hyp>, names: List<String>) -> List<Hyp>
    ? "The hypotheses that mention none of the names."
    match hs
        [] -> []
        [h, ..rest] -> match hypsMention([h], names)
            true -> notMentioningAny(rest, names)
            false -> List.prepend(h, notMentioningAny(rest, names))

verify notMentioningAny
    notMentioningAny([Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("n"), rhs = Term.TBool(true))), Hyp(name = "k", eqn = Eqn(lhs = Term.TVar("m"), rhs = Term.TBool(true)))], ["m", "z"]) => [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("n"), rhs = Term.TBool(true)))]

fn placeNames(ps: List<Place>) -> List<String>
    ? "The names of the varied places."
    match ps
        [] -> []
        [p, ..rest] -> List.prepend(p.name, placeNames(rest))

verify placeNames
    placeNames([Place(at = 1, name = "acc")]) => ["acc"]

fn hypsMention(hs: List<Hyp>, names: List<String>) -> Bool
    ? "Whether some hypothesis mentions one of the names."
    match hs
        [] -> false
        [h, ..rest] -> Bool.or(anyIn(List.concat(Kernel.Subst.freeVars(h.eqn.lhs), Kernel.Subst.freeVars(h.eqn.rhs)), names), hypsMention(rest, names))

verify hypsMention
    hypsMention([], ["x"]) => false

fn anyIn(ns: List<String>, names: List<String>) -> Bool
    ? "Whether one of ns is among names."
    match ns
        [] -> false
        [n, ..rest] -> Bool.or(List.contains(names, n), anyIn(rest, names))

verify anyIn
    anyIn(["a", "b"], ["b"]) => true

fn takenNames(claim: Eqn, hs: List<Hyp>) -> List<String>
    ? "Names a case may not take for its pattern variables: those of the claim and of the hypotheses."
    List.concat(List.concat(Kernel.Subst.freeVars(claim.lhs), Kernel.Subst.freeVars(claim.rhs)), hypNames(hs))

verify takenNames
    takenNames(Eqn(lhs = Term.TVar("a"), rhs = Term.TInt(1)), []) => ["a"]

fn hypNames(hs: List<Hyp>) -> List<String>
    ? "Variables the hypotheses mention."
    match hs
        [] -> []
        [h, ..rest] -> List.concat(List.concat(Kernel.Subst.freeVars(h.eqn.lhs), Kernel.Subst.freeVars(h.eqn.rhs)), hypNames(rest))

verify hypNames
    hypNames([]) => []

fn constructorArmsFit(arms: List<Arm>, t: Ty, env: TyEnv) -> Bool
    ? "The arms are a permutation of every constructor of t, without duplicates, and each pattern names exactly the constructor's fields."
    Bool.and(sameNames(Kernel.Types.ctorsOf(t, env), armConstructorNames(arms)), constructorFieldsFit(arms, t, env))

verify constructorArmsFit
    constructorArmsFit([Arm(pattern = Pat.PCtor("C.A", []), body = Term.TUnit)], Ty.TyNamed("C"), tyEnv(sumEnv())) => false
    constructorArmsFit([Arm(pattern = Pat.PCtor("C.B", []), body = Term.TUnit), Arm(pattern = Pat.PCtor("C.A", []), body = Term.TUnit)], Ty.TyNamed("C"), tyEnv(sumEnv())) => true
    constructorArmsFit([Arm(pattern = Pat.PCtor("C.A", ["x"]), body = Term.TUnit), Arm(pattern = Pat.PCtor("C.B", []), body = Term.TUnit)], Ty.TyNamed("C"), tyEnv(sumEnv())) => false

fn sameNames(expected: List<String>, actual: List<String>) -> Bool
    ? "Two lists contain every name the same number of times, in any order."
    Bool.and(List.len(expected) == List.len(actual), sameNameCounts(expected, expected, actual))

verify sameNames
    sameNames(["A", "B"], ["B", "A"]) => true
    sameNames(["A", "B"], ["A", "A"]) => false

fn sameNameCounts(left: List<String>, allLeft: List<String>, right: List<String>) -> Bool
    ? "Every name occurring on the left occurs equally often on both sides."
    match left
        [] -> true
        [n, ..rest] -> Bool.and(countName(n, allLeft) == countName(n, right), sameNameCounts(rest, allLeft, right))

verify sameNameCounts
    sameNameCounts(["A"], ["A", "A"], ["A", "B"]) => false

fn countName(want: String, names: List<String>) -> Int
    ? "How often want occurs in names."
    match names
        [] -> 0
        [n, ..rest] -> match n == want
            true -> 1 + countName(want, rest)
            false -> countName(want, rest)

verify countName
    countName("A", ["A", "B", "A"]) => 2

fn armConstructorNames(arms: List<Arm>) -> List<String>
    ? "The constructor selected by each constructor-shaped arm."
    match arms
        [] -> []
        [a, ..rest] -> List.prepend(patternConstructorName(a.pattern), armConstructorNames(rest))

verify armConstructorNames
    armConstructorNames([Arm(pattern = Pat.PNil, body = Term.TUnit), Arm(pattern = Pat.PCons("h", "t"), body = Term.TUnit), Arm(pattern = Pat.PCtor("C.A", []), body = Term.TUnit)]) => ["nil", "cons", "C.A"]

fn patternConstructorName(p: Pat) -> String
    ? "The split name of a constructor-shaped pattern; an empty name for another pattern."
    match p
        Pat.PNil -> "nil"
        Pat.PCons(h, t) -> "cons"
        Pat.PCtor(c, ns) -> c
        _ -> ""

verify patternConstructorName
    patternConstructorName(Pat.PCtor("C.A", [])) => "C.A"

fn constructorFieldsFit(arms: List<Arm>, t: Ty, env: TyEnv) -> Bool
    ? "Every arm is constructor-shaped and binds exactly the number of fields that constructor carries."
    match arms
        [] -> true
        [a, ..rest] -> Bool.and(constructorFieldCountFits(a.pattern, t, env), constructorFieldsFit(rest, t, env))

verify constructorFieldsFit
    constructorFieldsFit([Arm(pattern = Pat.PCtor("C.A", ["x"]), body = Term.TUnit)], Ty.TyNamed("C"), tyEnv(sumEnv())) => false

fn constructorFieldCountFits(p: Pat, t: Ty, env: TyEnv) -> Bool
    ? "A constructor-shaped pattern has one name per declared field."
    match Kernel.Types.ctorFields(patternConstructorName(p), t, env)
        Result.Ok(fs) -> List.len(fs) == List.len(patFields(p))
        Result.Err(why) -> false

verify constructorFieldCountFits
    constructorFieldCountFits(Pat.PCons("h", "t"), Ty.TyList(Ty.TyInt), tyEnv(emptyEnv())) => true

fn inductCases(d: Def, r: Recursion, acs: List<ArmCalls>, cs: List<Case>, at: Call, claim: Eqn, vr: Varied, taken: List<String>, carried: List<Hyp>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "Each arm with its case, in order; the result is the claim."
    match (acs, cs)
        ([a, ..moreArms], [c, ..moreCases]) -> inductNext(inductCase(d, r, a, c, at, claim, vr, taken, carried, env, "{path}/case.{i}"), d, r, moreArms, moreCases, at, claim, vr, taken, carried, env, path, i + 1)
        _ -> Result.Ok(claim)

verify inductCases
    inductCases(Def(name = "f", params = [], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.None, arms = []), [], [], Kernel.Induct.Call(args = [], inner = []), Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], [], emptyEnv(), "p", 0) => Result.Ok(Eqn(lhs = Term.TUnit, rhs = Term.TUnit))

fn inductNext(done: Result<Unit, String>, d: Def, r: Recursion, acs: List<ArmCalls>, cs: List<Case>, at: Call, claim: Eqn, vr: Varied, taken: List<String>, carried: List<Hyp>, env: Env, path: String, i: Int) -> Result<Eqn, String>
    ? "The rest of the cases, once this one checked."
    done?
    inductCases(d, r, acs, cs, at, claim, vr, taken, carried, env, path, i)

verify inductNext
    inductNext(Result.Err("no"), Def(name = "f", params = [], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.None, arms = []), [], [], Kernel.Induct.Call(args = [], inner = []), Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], [], emptyEnv(), "p", 0) => Result.Err("no")

fn inductCase(d: Def, r: Recursion, a: ArmCalls, c: Case, at: Call, claim: Eqn, vr: Varied, taken: List<String>, carried: List<Hyp>, env: Env, path: String) -> Result<Unit, String>
    ? "Fresh names for what the case introduces: the arm's pattern variables, or in a count toward zero the hypothesis that the comparison has the arm's value. Then the claim in the case, under one hypothesis per recursive call at that call's arguments."
    match (List.len(c.binders) == caseNames(r, a.arm), freshAll(c.binders, taken, env, []))
        (false, _) -> refuseCase(path, "wrong number of names")
        (_, false) -> refuseCase(path, "the names are not fresh")
        _ -> inductCaseNamed(d, r, a, c, namesToVars(c.binders), at, claim, vr, carried, env, path)

verify inductCase
    inductCase(Def(name = "f", params = [], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.None, arms = []), ArmCalls(arm = Arm(pattern = Pat.PNil, body = Term.TUnit), calls = []), Case(binders = ["y"], ihs = [], carry = [], more = [], proof = Proof.PRefl(Term.TUnit)), Kernel.Induct.Call(args = [], inner = []), Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], [], emptyEnv(), "p") => Result.Err("step p: wrong number of names")
    inductCase(Def(name = "f", params = [], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.Some(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))), arms = []), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TUnit), calls = []), Case(binders = [], ihs = [], carry = [], more = [], proof = Proof.PRefl(Term.TUnit)), Kernel.Induct.Call(args = [], inner = []), Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], [], emptyEnv(), "p") => Result.Err("step p: wrong number of names")

fn caseNames(r: Recursion, a: Arm) -> Int
    ? "How many names a case introduces: one per part of the pattern, a wildcard part as well, or one hypothesis in a count toward zero."
    match r.guard
        Option.None -> List.len(patFields(a.pattern))
        Option.Some(g) -> 1

verify caseNames
    caseNames(Recursion(at = 0, guard = Option.None, arms = []), Arm(pattern = Pat.PCons("h", "t"), body = Term.TUnit)) => 2
    caseNames(Recursion(at = 0, guard = Option.None, arms = []), Arm(pattern = Pat.PCons("_", "t"), body = Term.TUnit)) => 2
    caseNames(Recursion(at = 0, guard = Option.Some(Term.TOp(">", Term.TVar("n"), Term.TInt(0))), arms = []), Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TUnit)) => 1

fn refuseCase(path: String, why: String) -> Result<Unit, String>
    ? "A refusal of an induction case, naming it."
    Result.Err("step {path}: {why}")

verify refuseCase
    refuseCase("p", "no") => Result.Err("step p: no")

fn freshAll(bs: List<String>, taken: List<String>, env: Env, before: List<String>) -> Bool
    ? "No name is taken, a variable in scope (a given, or a name an earlier case introduced), a module-level binding, or repeated."
    match bs
        [] -> true
        [b, ..rest] -> Bool.and(Bool.not(Bool.or(Bool.or(Bool.or(List.contains(taken, b), b == "_"), List.contains(Kernel.Proof.givenNames(env.vars), b)), Bool.or(isConst(b, env.consts), List.contains(before, b)))), freshAll(rest, taken, env, List.prepend(b, before)))

verify freshAll
    freshAll(["t"], [], withVars(emptyEnv(), [Kernel.Term.typed("t", Ty.TyList(Ty.TyAny))]), []) => false
    freshAll(["y", "y"], [], emptyEnv(), []) => false
    freshAll(["y"], ["x"], emptyEnv(), []) => true
    freshAll(["_"], [], emptyEnv(), []) => false

fn isConst(n: String, cs: List<Const>) -> Bool
    ? "Whether n names a module-level binding."
    match cs
        [] -> false
        [c, ..rest] -> Bool.or(c.name == n, isConst(n, rest))

verify isConst
    isConst("a", []) => false

fn namesToVars(ns: List<String>) -> List<Term>
    ? "Each name as a variable."
    match ns
        [] -> []
        [n, ..rest] -> List.prepend(Term.TVar(n), namesToVars(rest))

verify namesToVars
    namesToVars(["a"]) => [Term.TVar("a")]

fn inductCaseNamed(d: Def, r: Recursion, a: ArmCalls, c: Case, ys: List<Term>, at: Call, claim: Eqn, vr: Varied, carried: List<Hyp>, env: Env, path: String) -> Result<Unit, String>
    ? "The goal, the carried hypotheses and in a count toward zero the arm's value of the comparison, then the hypotheses of the arm's recursive calls, those the gate checked to descend; the case's proof must prove the goal."
    names = Kernel.Subst.patNames(a.arm.pattern)
    rename = List.concat(withoutNames(zipBind(patFields(a.arm.pattern), ys), ["_"]), withoutNames(zipBind(Kernel.Types.paramsOf(d), at.args), names))
    here = caseValue(r.guard, a.arm.pattern, vr.v, ys, path)?
    goal = instantiate(claim, here, path)?
    scope = withVars(withHyps(env, List.concat(caseGuard(r.guard, a.arm.pattern, c.binders, rename, path)?, List.concat(hypsAt(carried, here, path)?, env.hyps))), caseVarsOf(r.guard, a.arm.pattern, c.binders, vr.v, env, path)?)
    match (List.len(a.calls) == List.len(c.ihs), List.len(c.carry) == List.len(c.ihs))
        (false, _) -> refuseCase(path, "{List.len(a.calls)} recursive calls, {List.len(c.ihs)} hypotheses")
        (_, false) -> refuseCase(path, "one list of carried proofs per hypothesis")
        _ -> caseProves(c.proof, goal, withHyps(scope, List.concat(moreHyps(c.more, a.calls, rename, r.at, claim, vr, carried, scope, path)?, List.concat(ihHyps(a.calls, c.ihs, c.carry, rename, r.at, claim, vr, carried, scope, path)?, scope.hyps))), path)

verify inductCaseNamed
    inductCaseNamed(Def(name = "f", params = [Kernel.Term.typed("x", Ty.TyAny)], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.None, arms = []), ArmCalls(arm = Arm(pattern = Pat.PNil, body = Term.TInt(0)), calls = []), Case(binders = [], ihs = ["ih"], carry = [[]], more = [], proof = Proof.PRefl(Term.TUnit)), [], Kernel.Induct.Call(args = [Term.TVar("x")], inner = []), Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("x")), Varied(v = "x", general = []), [], listsEnv(["x"]), "p") => Result.Err("step p: 0 recursive calls, 1 hypotheses")
    inductCaseNamed(Def(name = "f", params = [Kernel.Term.typed("n", Ty.TyAny)], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.Some(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))), arms = []), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(0)), calls = []), Case(binders = ["g"], ihs = [], carry = [], more = [More(call = 0, ih = IhAt(name = "ih", at = [], carry = []))], proof = Proof.PHyp("ih")), [Term.TVar("g")], Kernel.Induct.Call(args = [Term.TVar("m")], inner = []), Eqn(lhs = Term.TVar("m"), rhs = Term.TVar("m")), Varied(v = "m", general = []), [], intsEnv(["m"]), "p") => Result.Err("step p: no recursive call 0")
    inductCaseNamed(Def(name = "f", params = [Kernel.Term.typed("n", Ty.TyAny)], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.Some(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))), arms = []), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(true)), body = Term.TInt(0)), calls = []), Case(binders = ["g"], ihs = [], carry = [], more = [], proof = Proof.PHyp("g")), [Term.TVar("g")], Kernel.Induct.Call(args = [Term.TVar("m")], inner = []), Eqn(lhs = Term.TOp("<=", Term.TVar("m"), Term.TInt(0)), rhs = Term.TBool(true)), Varied(v = "m", general = []), [], intsEnv(["m"]), "p") => Result.Ok(Unit)
    inductCaseNamed(Def(name = "f", params = [Kernel.Term.typed("n", Ty.TyAny)], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.Some(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))), arms = []), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0)), calls = [Kernel.Induct.Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])]), Case(binders = ["g"], ihs = ["ih"], carry = [[]], more = [], proof = Proof.PHyp("g")), [Term.TVar("g")], Kernel.Induct.Call(args = [Term.TVar("m")], inner = []), Eqn(lhs = Term.TOp("<=", Term.TVar("m"), Term.TInt(0)), rhs = Term.TBool(true)), Varied(v = "m", general = []), [], intsEnv(["m"]), "p") => Result.Err("step p: the case proves a different equation")
    inductCaseNamed(Def(name = "f", params = [Kernel.Term.typed("n", Ty.TyAny)], ret = Ty.TyAny, lets = [], body = Term.TUnit), Recursion(at = 0, guard = Option.Some(Term.TOp("<=", Term.TVar("n"), Term.TInt(0))), arms = []), ArmCalls(arm = Arm(pattern = Pat.PLit(Term.TBool(false)), body = Term.TInt(0)), calls = [Kernel.Induct.Call(args = [Term.TOp("-", Term.TVar("n"), Term.TInt(1))], inner = [])]), Case(binders = ["g"], ihs = ["ih"], carry = [[]], more = [], proof = Proof.PHyp("ih")), [Term.TVar("g")], Kernel.Induct.Call(args = [Term.TVar("m")], inner = []), Eqn(lhs = Term.TCall("q", [Term.TVar("m")]), rhs = Term.TInt(0)), Varied(v = "m", general = []), [], intsEnv(["m"]), "p") => Result.Err("step p: the case proves a different equation")

fn caseVarsOf(guard: Option<Term>, p: Pat, binders: List<String>, v: String, env: Env, path: String) -> Result<List<TypedVar>, String>
    ? "The case's names with the types of the pattern's parts over the given inducted on; none in a count toward zero, whose one name is a hypothesis."
    match guard
        Option.Some(g) -> Result.Ok([])
        Option.None -> patTypes(namedParts(p, binders), typeOf(Term.TVar(v), env, path)?, env, path)

verify caseVarsOf
    caseVarsOf(Option.None, Pat.PCons("h", "t"), ["a", "b"], "xs", listsEnv(["xs"]), "p") => Result.Ok([Kernel.Term.typed("a", Ty.TyAny), Kernel.Term.typed("b", Ty.TyList(Ty.TyAny))])
    caseVarsOf(Option.None, Pat.PCons("_", "t"), ["a", "b"], "xs", listsEnv(["xs"]), "p") => Result.Ok([Kernel.Term.typed("a", Ty.TyAny), Kernel.Term.typed("b", Ty.TyList(Ty.TyAny))])
    caseVarsOf(Option.Some(Term.TBool(true)), Pat.PWild, ["g"], "n", intsEnv(["n"]), "p") => Result.Ok([])

fn namedParts(p: Pat, names: List<String>) -> Pat
    ? "The pattern with its parts, a wildcard part as well, taking these names in order."
    match (p, names)
        (Pat.PCons(h, t), [x, y]) -> Pat.PCons(x, y)
        (Pat.PCtor(c, ns), _) -> Pat.PCtor(c, names)
        _ -> p

verify namedParts
    namedParts(Pat.PCons("_", "t"), ["a", "b"]) => Pat.PCons("a", "b")
    namedParts(Pat.PCtor("C.Pair", ["_", "x"]), ["a", "b"]) => Pat.PCtor("C.Pair", ["a", "b"])
    namedParts(Pat.PNil, []) => Pat.PNil

fn caseValue(guard: Option<Term>, p: Pat, v: String, ys: List<Term>, path: String) -> Result<List<Binding>, String>
    ? "Where the case puts the given inducted on: at the arm's pattern over the case's names; left as it is in a count toward zero."
    match guard
        Option.None -> Result.Ok([Kernel.Term.bind(v, patTerm(p, ys, path)?)])
        Option.Some(g) -> Result.Ok([])

verify caseValue
    caseValue(Option.None, Pat.PNil, "xs", [], "p") => Result.Ok([Kernel.Term.bind("xs", Term.TList([]))])
    caseValue(Option.Some(Term.TOp(">", Term.TVar("n"), Term.TInt(0))), Pat.PLit(Term.TBool(true)), "m", [Term.TVar("g")], "p") => Result.Ok([])

fn caseGuard(guard: Option<Term>, p: Pat, binders: List<String>, rename: List<Binding>, path: String) -> Result<List<Hyp>, String>
    ? "In a count toward zero, the hypothesis the case's one name stands for: the comparison at the claim's arguments has the value of the arm's pattern."
    match (guard, p, binders)
        (Option.None, _, _) -> Result.Ok([])
        (Option.Some(g), Pat.PLit(Term.TBool(b)), [h]) -> Result.Ok([Hyp(name = h, eqn = instantiate(Eqn(lhs = g, rhs = Term.TBool(b)), rename, path)?)])
        _ -> Result.Err("step {path}: the arm is not one value of the comparison")

verify caseGuard
    caseGuard(Option.Some(Term.TOp(">", Term.TVar("n"), Term.TInt(0))), Pat.PLit(Term.TBool(false)), ["g"], [Kernel.Term.bind("n", Term.TVar("m"))], "p") => Result.Ok([Hyp(name = "g", eqn = Eqn(lhs = Term.TOp(">", Term.TVar("m"), Term.TInt(0)), rhs = Term.TBool(false)))])
    caseGuard(Option.Some(Term.TOp(">", Term.TVar("n"), Term.TInt(0))), Pat.PWild, ["g"], [], "p") => Result.Err("step p: the arm is not one value of the comparison")
    caseGuard(Option.None, Pat.PNil, [], [], "p") => Result.Ok([])

fn hypsAt(hs: List<Hyp>, bs: List<Binding>, path: String) -> Result<List<Hyp>, String>
    ? "Each hypothesis at a substitution, under its own name."
    match hs
        [] -> Result.Ok([])
        [h, ..rest] -> Result.Ok(List.prepend(Hyp(name = h.name, eqn = instantiate(h.eqn, bs, path)?), hypsAt(rest, bs, path)?))

verify hypsAt
    hypsAt([Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TBool(true)))], [Kernel.Term.bind("x", Term.TInt(1))], "p") => Result.Ok([Hyp(name = "h", eqn = Eqn(lhs = Term.TInt(1), rhs = Term.TBool(true)))])

fn withoutNames(bs: List<Binding>, names: List<String>) -> List<Binding>
    ? "Bindings for names a pattern does not shadow."
    match bs
        [] -> []
        [b, ..rest] -> match List.contains(names, b.name)
            true -> withoutNames(rest, names)
            false -> List.prepend(b, withoutNames(rest, names))

verify withoutNames
    withoutNames([Kernel.Term.bind("t", Term.TUnit)], ["t"]) => []

fn ihHyps(calls: List<Kernel.Induct.Call>, ihs: List<String>, carry: List<List<Proof>>, rename: List<Binding>, j: Int, claim: Eqn, vr: Varied, carried: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "One hypothesis per recursive call, later ones in front: the claim at that call's arguments, once each carried hypothesis is proved there. A call named _ gives none."
    match (calls, ihs, carry)
        ([c, ..moreCalls], [h, ..moreNames], [ps, ..moreProofs]) -> Result.Ok(List.concat(ihHyps(moreCalls, moreNames, moreProofs, rename, j, claim, vr, carried, scope, path)?, ihTaken(c, h, ps, rename, j, claim, vr, carried, scope, path)?))
        _ -> Result.Ok([])

verify ihHyps
    ihHyps([], [], [], [], 0, Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], emptyEnv(), "p") => Result.Ok([])

fn moreHyps(ms: List<More>, calls: List<Kernel.Induct.Call>, rename: List<Binding>, j: Int, claim: Eqn, vr: Varied, carried: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "One hypothesis per entry, later ones in front: the claim at the part recursive call K recurses on and at the entry's values of the varied givens, once each carried hypothesis is proved there."
    match ms
        [] -> Result.Ok([])
        [m, ..rest] -> match (callAt(calls, m.call), List.len(m.ih.at) == List.len(vr.general), List.len(m.ih.carry) == List.len(carried))
            (Option.None, _, _) -> Result.Err("step {path}: no recursive call {m.call}")
            (_, false, _) -> Result.Err("step {path}: {m.ih.name} gives {List.len(m.ih.at)} values for {List.len(vr.general)} varied givens")
            (_, _, false) -> Result.Err("step {path}: one proof per carried hypothesis")
            (Option.Some(c), true, true) -> Result.Ok(List.concat(moreHyps(rest, calls, rename, j, claim, vr, carried, scope, path)?, ihHolds(List.prepend(partBinding(ihAt(c, rename, j, vr, path)?, path)?, zipBind(placeNames(vr.general), m.ih.at)), m.ih.name, m.ih.carry, claim, carried, scope, path)?))

verify moreHyps
    moreHyps([More(call = 1, ih = IhAt(name = "ih", at = [], carry = []))], [Kernel.Induct.Call(args = [Term.TVar("t")], inner = [])], [], 0, Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("x")), Varied(v = "x", general = []), [], emptyEnv(), "p") => Result.Err("step p: no recursive call 1")
    moreHyps([More(call = 0, ih = IhAt(name = "ih", at = [], carry = []))], [Kernel.Induct.Call(args = [Term.TVar("t"), Term.TVar("a")], inner = [])], [], 0, Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("acc")), Varied(v = "x", general = [Place(at = 1, name = "acc")]), [], emptyEnv(), "p") => Result.Err("step p: ih gives 0 values for 1 varied givens")
    moreHyps([More(call = 0, ih = IhAt(name = "ih", at = [Term.TInt(5)], carry = []))], [Kernel.Induct.Call(args = [Term.TVar("t"), Term.TVar("a")], inner = [])], [], 0, Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("acc")), Varied(v = "x", general = [Place(at = 1, name = "acc")]), [], withVars(emptyEnv(), [Kernel.Term.typed("x", Ty.TyAny), Kernel.Term.typed("acc", Ty.TyInt), Kernel.Term.typed("t", Ty.TyAny)]), "p") => Result.Ok([Hyp(name = "ih", eqn = Eqn(lhs = Term.TVar("t"), rhs = Term.TInt(5)))])

fn callAt(calls: List<Kernel.Induct.Call>, k: Int) -> Option<Kernel.Induct.Call>
    ? "The recursive call at place k."
    match calls
        [] -> Option.None
        [c, ..rest] -> match k == 0
            true -> Option.Some(c)
            false -> callAt(rest, k - 1)

verify callAt
    callAt([], 0) => Option.None

fn partBinding(bs: List<Binding>, path: String) -> Result<Binding, String>
    ? "The binding of the given inducted on, which ihAt puts first."
    match bs
        [b, ..rest] -> Result.Ok(b)
        [] -> Result.Err("step {path}: a recursive call binds nothing")

verify partBinding
    partBinding([Kernel.Term.bind("x", Term.TVar("t"))], "p") => Result.Ok(Kernel.Term.bind("x", Term.TVar("t")))
    partBinding([], "p") => Result.Err("step p: a recursive call binds nothing")

fn ihTaken(c: Kernel.Induct.Call, h: String, ps: List<Proof>, rename: List<Binding>, j: Int, claim: Eqn, vr: Varied, carried: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "The hypothesis of one call, unless it is named _."
    match (h == "_", List.len(ps) == List.len(carried))
        (true, _) -> Result.Ok([])
        (_, false) -> Result.Err("step {path}: one proof per carried hypothesis")
        _ -> ihHolds(ihAt(c, rename, j, vr, path)?, h, ps, claim, carried, scope, path)

verify ihTaken
    ihTaken(Kernel.Induct.Call(args = [Term.TVar("t")], inner = []), "_", [], [], 0, Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [], emptyEnv(), "p") => Result.Ok([])
    ihTaken(Kernel.Induct.Call(args = [Term.TVar("t")], inner = []), "ih", [], [], 0, Eqn(lhs = Term.TUnit, rhs = Term.TUnit), Varied(v = "x", general = []), [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TBool(true)))], emptyEnv(), "p") => Result.Err("step p: one proof per carried hypothesis")

fn ihHolds(bs: List<Binding>, h: String, ps: List<Proof>, claim: Eqn, carried: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "The call's arguments fit the types of the variables they stand for; each carried hypothesis is proved at them; then the claim there."
    bound(bs, scope.vars, scope, "hypothesis {h}", path)?
    carriedHold(carried, ps, bs, scope, "{path}/{h}")?
    Result.Ok([Hyp(name = h, eqn = instantiate(claim, bs, path)?)])

verify ihHolds
    ihHolds([Kernel.Term.bind("x", Term.TVar("t"))], "ih", [Proof.PHyp("h")], Eqn(lhs = Term.TVar("x"), rhs = Term.TInt(1)), [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TBool(true)))], withHyp(intsEnv(["x", "t"]), "h", Term.TVar("x"), true), "p") => Result.Err("step p/ih/carry.h: the case proves a different equation")
    ihHolds([Kernel.Term.bind("x", Term.TVar("t"))], "ih", [Proof.PHyp("h")], Eqn(lhs = Term.TVar("x"), rhs = Term.TInt(1)), [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("x"), rhs = Term.TBool(true)))], withHyp(intsEnv(["x", "t"]), "h", Term.TVar("t"), true), "p") => Result.Ok([Hyp(name = "ih", eqn = Eqn(lhs = Term.TVar("t"), rhs = Term.TInt(1)))])
    ihHolds([Kernel.Term.bind("x", Term.TInt(0))], "ih", [], Eqn(lhs = Term.TVar("x"), rhs = Term.TVar("x")), [], withVars(emptyEnv(), [Kernel.Term.typed("x", Ty.TyBool)]), "p") => Result.Err("step p: hypothesis ih: x := Int is not Bool")

fn ihAt(c: Kernel.Induct.Call, rename: List<Binding>, j: Int, vr: Varied, path: String) -> Result<List<Binding>, String>
    ? "The varied givens bound to the call's arguments."
    match anyIn(Kernel.Subst.freeVarsAll(readArgs(c.args, j, vr.general, 0)), c.inner)
        true -> Result.Err("step {path}: a recursive call reads a name an inner match binds")
        false -> ihBindings(Kernel.Subst.substAll(c.args, rename)?, j, vr, path)

verify ihAt
    ihAt(Kernel.Induct.Call(args = [Term.TVar("t")], inner = ["t"]), [], 0, Varied(v = "x", general = []), "p") => Result.Err("step p: a recursive call reads a name an inner match binds")
    ihAt(Kernel.Induct.Call(args = [Term.TVar("t"), Term.TVar("y")], inner = ["y"]), [], 0, Varied(v = "x", general = []), "p") => Result.Ok([Kernel.Term.bind("x", Term.TVar("t"))])
    ihAt(Kernel.Induct.Call(args = [Term.TVar("t"), Term.TVar("y")], inner = ["y"]), [], 0, Varied(v = "x", general = [Place(at = 1, name = "ys")]), "p") => Result.Err("step p: a recursive call reads a name an inner match binds")

fn readArgs(xs: List<Term>, j: Int, ps: List<Place>, k: Int) -> List<Term>
    ? "The arguments a hypothesis reads: the one at place j and those at the varied places."
    match xs
        [] -> []
        [x, ..rest] -> match Bool.or(k == j, atPlace(ps, k))
            true -> List.prepend(x, readArgs(rest, j, ps, k + 1))
            false -> readArgs(rest, j, ps, k + 1)

verify readArgs
    readArgs([Term.TVar("t"), Term.TVar("y")], 0, [], 0) => [Term.TVar("t")]
    readArgs([Term.TVar("t"), Term.TVar("y")], 0, [Place(at = 1, name = "ys")], 0) => [Term.TVar("t"), Term.TVar("y")]

fn atPlace(ps: List<Place>, k: Int) -> Bool
    ? "Whether a varied given sits at place k."
    match ps
        [] -> false
        [p, ..rest] -> Bool.or(p.at == k, atPlace(rest, k))

verify atPlace
    atPlace([Place(at = 1, name = "ys")], 1) => true
    atPlace([], 0) => false

fn ihBindings(args: List<Term>, j: Int, vr: Varied, path: String) -> Result<List<Binding>, String>
    ? "The given at the matched place and the varied givens, each bound to the call's argument at its place."
    match Kernel.Induct.nthTerm(args, j)
        Option.None -> Result.Err("step {path}: a recursive call has too few arguments")
        Option.Some(at) -> Result.Ok(List.prepend(Kernel.Term.bind(vr.v, at), placeBindings(vr.general, args)))

verify ihBindings
    ihBindings([Term.TVar("t")], 0, Varied(v = "x", general = []), "p") => Result.Ok([Kernel.Term.bind("x", Term.TVar("t"))])

fn placeBindings(ps: List<Place>, args: List<Term>) -> List<Binding>
    ? "Each varied given bound to the call's argument at its place."
    match ps
        [] -> []
        [p, ..rest] -> List.prepend(Kernel.Term.bind(p.name, Option.withDefault(Kernel.Induct.nthTerm(args, p.at), Term.TVar(p.name))), placeBindings(rest, args))

verify placeBindings
    placeBindings([Place(at = 1, name = "acc")], [Term.TVar("t"), Term.TInt(3)]) => [Kernel.Term.bind("acc", Term.TInt(3))]

fn caseProves(p: Proof, goal: Eqn, env: Env, path: String) -> Result<Unit, String>
    ? "The case's proof proves exactly the goal."
    got = conclude(p, env, path)?
    match got == goal
        true -> Result.Ok(Unit)
        false -> Result.Err("step {path}: the case proves a different equation")

verify caseProves
    caseProves(Proof.PRefl(Term.TInt(1)), Eqn(lhs = Term.TInt(1), rhs = Term.TInt(2)), emptyEnv(), "p") => Result.Err("step p: the case proves a different equation")

fn listInduct(v: String, claim: Eqn, carry: List<String>, n: Proof, h: String, t: String, general: List<String>, ihs: List<IhAt>, c: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "Induction on a given of list type, for every value of the names in general: the claim at [], and at List.prepend(h, t) under one hypothesis per entry of ihs, the claim at t and that entry's values of general. The hypotheses named in carry hold in each case; an entry's hypothesis holds once they are proved at its values. Any other hypothesis that mentions v or what it generalises is out of scope."
    carried = namedHyps(carry, env.hyps, path)?
    match (listVar(v, env), List.contains(general, v))
        (Option.None, _) -> refuse(path, "{v} is not a given of list type")
        (_, true) -> refuse(path, "{v} is both inducted on and generalised")
        (Option.Some(e), false) -> match freshAll([h, t], takenNames(claim, env.hyps), env, [])
            false -> refuse(path, "the names are not fresh")
            true -> listCases(v, e, claim, carried, n, h, t, general, ihs, c, withHyps(env, List.concat(carried, notMentioningAny(env.hyps, List.prepend(v, general)))), path)

verify listInduct
    listInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], Proof.PRefl(Term.TList([])), "h", "t", [], [], Proof.PRefl(Term.TUnit), emptyEnv(), "p") => Result.Err("step p: xs is not a given of list type")
    listInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), ["k"], Proof.PRefl(Term.TList([])), "h", "t", [], [], Proof.PRefl(Term.TUnit), listsEnv(["xs"]), "p") => Result.Err("step p: hypothesis k is not in scope")
    listInduct("xs", Eqn(lhs = Term.TOp("==", Term.TVar("xs"), Term.TList([])), rhs = Term.TBool(false)), [], Proof.PHyp("k"), "h", "t", [], [], Proof.PHyp("k"), withHyp(listsEnv(["xs"]), "k", Term.TOp("==", Term.TVar("xs"), Term.TList([])), false), "p") => Result.Err("step p/nil: hypothesis k is not in scope")
    listInduct("xs", Eqn(lhs = Term.TOp("==", Term.TVar("xs"), Term.TList([])), rhs = Term.TBool(false)), ["k"], Proof.PHyp("k"), "h", "t", [], [], Proof.PHyp("k"), withHyp(listsEnv(["xs"]), "k", Term.TOp("==", Term.TVar("xs"), Term.TList([])), false), "p") => Result.Ok(Eqn(lhs = Term.TOp("==", Term.TVar("xs"), Term.TList([])), rhs = Term.TBool(false)))

fn lenInduct(v: String, claim: Eqn, carry: List<String>, general: List<String>, names: List<String>, c: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "Induction on the length of a given v of list type, for every value of the names in general. With names [n, hn, ih] fresh for everything in scope, c proves the claim as it stands under the carried hypotheses, each a fact, those that mention neither v nor what it generalises, an Int n, hn saying v is at most n long, and the law ih: the claim at every v shorter than n and every value of general where the carried hypotheses hold. Then the claim holds whenever v is at most n long, for every n by induction on n, so for every v."
    carried = namedHyps(carry, env.hyps, path)?
    match (listVar(v, env), List.contains(general, v), names)
        (Option.None, _, _) -> refuse(path, "{v} is not a given of list type")
        (_, true, _) -> refuse(path, "{v} is both inducted on and generalised")
        (_, _, [n, hn, ih]) -> match freshAll(names, List.concat(takenNames(claim, env.hyps), hypLabels(env.hyps)), env, [])
            false -> refuse(path, "the names are not fresh")
            true -> lenCase(v, claim, carried, general, n, hn, Law(key = ih, givens = typedNames(List.prepend(v, general), env, path)?, premise = [conjoined(Term.TOp("<", Term.TBi("List.len", [Term.TVar(v)]), Term.TVar(n)), factsOf(carried, path)?)], lhs = claim.lhs, rhs = claim.rhs), c, env, path)
        _ -> refuse(path, "a length induction names a bound, its hypothesis and its law")

verify lenInduct
    lenInduct("n", Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), [], [], ["m", "hm", "ih"], Proof.PRefl(Term.TVar("n")), intsEnv(["n"]), "p") => Result.Err("step p: n is not a given of list type")
    lenInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], ["xs"], ["m", "hm", "ih"], Proof.PRefl(Term.TVar("xs")), listsEnv(["xs"]), "p") => Result.Err("step p: xs is both inducted on and generalised")
    lenInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], [], ["xs", "hm", "ih"], Proof.PRefl(Term.TVar("xs")), listsEnv(["xs"]), "p") => Result.Err("step p: the names are not fresh")
    lenInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], [], ["m", "hm"], Proof.PRefl(Term.TVar("xs")), listsEnv(["xs"]), "p") => Result.Err("step p: a length induction names a bound, its hypothesis and its law")
    lenInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], [], ["m", "hm", "ih"], Proof.PRefl(Term.TVar("xs")), listsEnv(["xs"]), "p") => Result.Ok(Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")))
    lenInduct("xs", Eqn(lhs = Term.TBi("List.len", [Term.TVar("xs")]), rhs = Term.TInt(0)), [], [], ["m", "hm", "ih"], Proof.PLaw("ih", [Kernel.Term.bind("xs", Term.TVar("xs"))], [Proof.PHyp("hm")]), listsEnv(["xs"]), "p") => Result.Err("step p/below: premise 0 does not match")
    lenInduct("xs", Eqn(lhs = Term.TBi("List.len", [Term.TVar("xs")]), rhs = Term.TInt(0)), ["k"], [], ["m", "hm", "ih"], Proof.PHyp("k"), withHyp(listsEnv(["xs"]), "k", Term.TVar("xs"), false), "p") => Result.Err("step p: k is not a fact")
    lenInduct("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], [], ["m", "hm", "ih"], Proof.PHyp("k"), withHyp(listsEnv(["xs"]), "k", Term.TOp("==", Term.TVar("xs"), Term.TList([])), true), "p") => Result.Err("step p/below: hypothesis k is not in scope")

fn lenCase(v: String, claim: Eqn, carried: List<Hyp>, general: List<String>, n: String, hn: String, ih: Law, c: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "The one case of a length induction: c proves the claim with the Int n and the hypothesis hn in scope, and the law ih cited as any other."
    bounded = Hyp(name = hn, eqn = Eqn(lhs = Term.TOp("<=", Term.TBi("List.len", [Term.TVar(v)]), Term.TVar(n)), rhs = Term.TBool(true)))
    hyps = List.prepend(bounded, List.concat(carried, notMentioningAny(env.hyps, List.prepend(v, general))))
    caseProves(c, claim, Env(defs = env.defs, consts = env.consts, laws = List.prepend(ih, env.laws), hyps = hyps, vars = List.prepend(Kernel.Term.typed(n, Ty.TyInt), env.vars), sums = env.sums, recs = env.recs, sigs = env.sigs), "{path}/below")?
    Result.Ok(claim)

verify lenCase
    lenCase("xs", Eqn(lhs = Term.TBool(true), rhs = Term.TBool(true)), [], [], "m", "hm", Law(key = "ih", givens = [], premise = [], lhs = Term.TBool(true), rhs = Term.TBool(true)), Proof.PLaw("ih", [], []), listsEnv(["xs"]), "p") => Result.Ok(Eqn(lhs = Term.TBool(true), rhs = Term.TBool(true)))

fn typedNames(ns: List<String>, env: Env, path: String) -> Result<List<TypedVar>, String>
    ? "Each name with the type it has in scope."
    match ns
        [] -> Result.Ok([])
        [x, ..rest] -> Result.Ok(List.prepend(Kernel.Term.typed(x, typeOf(Term.TVar(x), env, path)?), typedNames(rest, env, path)?))

verify typedNames
    typedNames(["xs"], listsEnv(["xs"]), "p") => Result.Ok([Kernel.Term.typed("xs", Ty.TyList(Ty.TyAny))])
    typedNames(["y"], emptyEnv(), "p") => Result.Err("step p: y is not a variable in scope")

fn factsOf(hs: List<Hyp>, path: String) -> Result<List<Term>, String>
    ? "What each hypothesis says is true; a refusal for one that is no such fact."
    match hs
        [] -> Result.Ok([])
        [h, ..rest] -> match h.eqn.rhs == Term.TBool(true)
            true -> Result.Ok(List.prepend(h.eqn.lhs, factsOf(rest, path)?))
            false -> Result.Err("step {path}: {h.name} is not a fact")

verify factsOf
    factsOf([Hyp(name = "k", eqn = Eqn(lhs = Term.TVar("c"), rhs = Term.TBool(true)))], "p") => Result.Ok([Term.TVar("c")])

fn conjoined(t: Term, rest: List<Term>) -> Term
    ? "t and each of rest, joined by Bool.and to the right."
    match rest
        [] -> t
        [x, ..more] -> Term.TBi("Bool.and", [t, conjoined(x, more)])

verify conjoined
    conjoined(Term.TVar("a"), []) => Term.TVar("a")
    conjoined(Term.TVar("a"), [Term.TVar("b"), Term.TVar("c")]) => Term.TBi("Bool.and", [Term.TVar("a"), Term.TBi("Bool.and", [Term.TVar("b"), Term.TVar("c")])])

fn withRec(env: Env) -> Env
    ? "The environment with a record R of two Int fields a and b declared."
    Env(defs = env.defs, consts = env.consts, laws = env.laws, hyps = env.hyps, vars = env.vars, sums = env.sums, recs = List.prepend(Rec(name = "R", eq = true, fields = [Kernel.Term.typed("a", Ty.TyInt), Kernel.Term.typed("b", Ty.TyInt)]), env.recs), sigs = env.sigs)

verify withRec
    List.len(withRec(emptyEnv()).recs) => 1

fn listsEnv(ns: List<String>) -> Env
    ? "No definitions, laws or hypotheses, and these givens of list type."
    withVars(emptyEnv(), typedAll(ns, Ty.TyList(Ty.TyAny)))

verify listsEnv
    listsEnv(["xs"]).vars => [Kernel.Term.typed("xs", Ty.TyList(Ty.TyAny))]

fn typedAll(ns: List<String>, t: Ty) -> List<TypedVar>
    ? "Each name with the one type."
    match ns
        [] -> []
        [n, ..rest] -> List.prepend(Kernel.Term.typed(n, t), typedAll(rest, t))

verify typedAll
    typedAll([], Ty.TyInt) => []

fn listCases(v: String, e: Ty, claim: Eqn, carried: List<Hyp>, n: Proof, h: String, t: String, general: List<String>, ihs: List<IhAt>, c: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "The empty-list case, then the cell case; each under the hypotheses in scope at its value of v, the head and the tail typed by what the list holds, and the cell case under one hypothesis per entry of ihs once the carried ones are proved there. A split is these cases with no entry."
    atNil = [Kernel.Term.bind(v, Term.TList([]))]
    caseProves(n, instantiate(claim, atNil, path)?, withHyps(env, hypsAt(env.hyps, atNil, path)?), "{path}/nil")?
    atCell = [Kernel.Term.bind(v, Term.TBi("List.prepend", [Term.TVar(h), Term.TVar(t)]))]
    inCell = withVars(withHyps(env, hypsAt(env.hyps, atCell, path)?), cellVars(h, t, e))
    caseProves(c, instantiate(claim, atCell, path)?, withHyps(inCell, List.concat(smallerHyps(v, Term.TVar(t), general, ihs, claim, carried, inCell, path)?, inCell.hyps)), "{path}/cons")?
    Result.Ok(claim)

verify listCases
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], Proof.PRefl(Term.TList([])), "h", "t", [], [IhAt(name = "ih", at = [], carry = [])], Proof.PRefl(Term.TBi("List.prepend", [Term.TVar("h"), Term.TVar("t")])), listsEnv(["xs"]), "p") => Result.Ok(Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")))
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], Proof.PRefl(Term.TList([])), "h", "t", [], [IhAt(name = "ih", at = [], carry = [])], Proof.PHyp("ih"), listsEnv(["xs"]), "p") => Result.Err("step p/cons: the case proves a different equation")
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("n")), [], Proof.PRefl(Term.TList([])), "h", "t", ["n"], [IhAt(name = "ih", at = [Term.TInt(3)], carry = [])], Proof.PHyp("ih"), emptyEnv(), "p") => Result.Err("step p/nil: the case proves a different equation")
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], Proof.PRefl(Term.TVar("xs")), "h", "t", [], [], Proof.PRefl(Term.TBi("List.prepend", [Term.TVar("h"), Term.TVar("t")])), listsEnv(["xs"]), "p") => Result.Err("step p/nil: the case proves a different equation")
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], Proof.PRefl(Term.TList([])), "h", "t", [], [], Proof.PRefl(Term.TVar("xs")), listsEnv(["xs"]), "p") => Result.Err("step p/cons: the case proves a different equation")
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], Proof.PRefl(Term.TList([])), "h", "t", [], [], Proof.PHyp("k"), withHyp(listsEnv(["xs"]), "k", Term.TOp("==", Term.TVar("xs"), Term.TList([])), false), "p") => Result.Err("step p/cons: the case proves a different equation")
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TOp("==", Term.TVar("xs"), Term.TList([])), rhs = Term.TBool(false)), [], Proof.PHyp("k"), "h", "t", [], [], Proof.PHyp("k"), withHyp(listsEnv(["xs"]), "k", Term.TOp("==", Term.TVar("xs"), Term.TList([])), false), "p") => Result.Ok(Eqn(lhs = Term.TOp("==", Term.TVar("xs"), Term.TList([])), rhs = Term.TBool(false)))
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [], Proof.PRefl(Term.TList([])), "h", "t", [], [], Proof.PListCases("t", Term.TBi("List.prepend", [Term.TVar("h"), Term.TVar("t")]), Term.TBi("List.prepend", [Term.TVar("h"), Term.TVar("t")]), Proof.PRefl(Term.TBi("List.prepend", [Term.TVar("h"), Term.TList([])])), "h2", "t2", Proof.PRefl(Term.TBi("List.prepend", [Term.TVar("h"), Term.TBi("List.prepend", [Term.TVar("h2"), Term.TVar("t2")])]))), listsEnv(["xs"]), "p") => Result.Ok(Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")))
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TOp("==", Term.TVar("xs"), Term.TList([])), rhs = Term.TBool(false)), [Hyp(name = "k", eqn = Eqn(lhs = Term.TOp("==", Term.TVar("xs"), Term.TList([])), rhs = Term.TBool(false)))], Proof.PHyp("k"), "h", "t", [], [IhAt(name = "ih", at = [], carry = [Proof.PHyp("k")])], Proof.PHyp("ih"), withHyp(listsEnv(["xs"]), "k", Term.TOp("==", Term.TVar("xs"), Term.TList([])), false), "p") => Result.Err("step p/ih/carry.k: the case proves a different equation")
    listCases("xs", Ty.TyAny, Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), [Hyp(name = "k", eqn = Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")))], Proof.PRefl(Term.TList([])), "h", "t", [], [IhAt(name = "ih", at = [], carry = [Proof.PRefl(Term.TVar("t"))])], Proof.PRefl(Term.TBi("List.prepend", [Term.TVar("h"), Term.TVar("t")])), withHyps(listsEnv(["xs"]), [Hyp(name = "k", eqn = Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")))]), "p") => Result.Ok(Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")))

fn splitList(v: String, claim: Eqn, n: Proof, h: String, t: String, c: Proof, env: Env, path: String) -> Result<Eqn, String>
    ? "A split of a list variable (a given of list type, or a tail an earlier split named) into [] and List.prepend(h, t), the names fresh for everything in scope: each case proves the claim with v replaced, in the hypotheses too, and the tail is a list variable in its case."
    match (listVar(v, env), freshAll([h, t], List.prepend(v, List.concat(takenNames(claim, env.hyps), hypLabels(env.hyps))), env, []))
        (Option.None, _) -> refuse(path, "{v} is not a variable of list type")
        (_, false) -> refuse(path, "the names are not fresh")
        (Option.Some(e), true) -> listCases(v, e, claim, [], n, h, t, [], [], c, env, path)

verify splitList
    splitList("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), Proof.PRefl(Term.TList([])), "h", "t", Proof.PRefl(Term.TUnit), emptyEnv(), "p") => Result.Err("step p: xs is not a variable of list type")
    splitList("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("t")), Proof.PRefl(Term.TList([])), "h", "t", Proof.PRefl(Term.TUnit), listsEnv(["xs"]), "p") => Result.Err("step p: the names are not fresh")
    splitList("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), Proof.PRefl(Term.TList([])), "k", "t", Proof.PRefl(Term.TUnit), withHyp(listsEnv(["xs"]), "k", Term.TBool(true), true), "p") => Result.Err("step p: the names are not fresh")
    splitList("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), Proof.PRefl(Term.TList([])), "xs", "t", Proof.PRefl(Term.TUnit), listsEnv(["xs"]), "p") => Result.Err("step p: the names are not fresh")
    splitList("xs", Eqn(lhs = Term.TBool(true), rhs = Term.TBool(true)), Proof.PRefl(Term.TBool(true)), "t", "u", Proof.PRefl(Term.TBool(true)), listsEnv(["xs", "t"]), "p") => Result.Err("step p: the names are not fresh")
    splitList("xs", Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")), Proof.PRefl(Term.TList([])), "h", "t", Proof.PRefl(Term.TBi("List.prepend", [Term.TVar("h"), Term.TVar("t")])), listsEnv(["xs"]), "p") => Result.Ok(Eqn(lhs = Term.TVar("xs"), rhs = Term.TVar("xs")))

fn hypLabels(hs: List<Hyp>) -> List<String>
    ? "The names of the hypotheses in scope."
    match hs
        [] -> []
        [x, ..rest] -> List.prepend(x.name, hypLabels(rest))

verify hypLabels
    hypLabels([Hyp(name = "when", eqn = Eqn(lhs = Term.TBool(true), rhs = Term.TBool(true)))]) => ["when"]

fn intsEnv(ns: List<String>) -> Env
    ? "No definitions, laws or hypotheses, and these givens of type Int."
    withVars(emptyEnv(), typedAll(ns, Ty.TyInt))

verify intsEnv
    intsEnv(["n"]).vars => [Kernel.Term.typed("n", Ty.TyInt)]

fn smallerHyps(v: String, smaller: Term, general: List<String>, ihs: List<IhAt>, claim: Eqn, cs: List<Hyp>, scope: Env, path: String) -> Result<List<Hyp>, String>
    ? "One hypothesis per entry, later ones in front: the claim with v at the smaller value and general at the entry's values, once each carried hypothesis is proved there."
    match ihs
        [] -> Result.Ok([])
        [i, ..rest] -> match (List.len(i.at) == List.len(general), List.len(i.carry) == List.len(cs))
            (false, _) -> Result.Err("step {path}: {i.name} gives {List.len(i.at)} values for {List.len(general)} generalised givens")
            (_, false) -> Result.Err("step {path}: one proof per carried hypothesis")
            _ -> Result.Ok(List.concat(smallerHyps(v, smaller, general, rest, claim, cs, scope, path)?, ihHolds(List.prepend(Kernel.Term.bind(v, smaller), zipBind(general, i.at)), i.name, i.carry, claim, cs, scope, path)?))

verify smallerHyps
    smallerHyps("n", Term.TVar("m"), ["a"], [IhAt(name = "ih", at = [], carry = [])], Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("a")), [], intsEnv(["n"]), "p") => Result.Err("step p: ih gives 0 values for 1 generalised givens")
    smallerHyps("n", Term.TVar("m"), ["a"], [IhAt(name = "ih", at = [Term.TInt(7)], carry = [])], Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("a")), [], intsEnv(["n", "m", "a"]), "p") => Result.Ok([Hyp(name = "ih", eqn = Eqn(lhs = Term.TVar("m"), rhs = Term.TInt(7)))])
    smallerHyps("n", Term.TVar("m"), [], [IhAt(name = "ih", at = [], carry = [])], Eqn(lhs = Term.TVar("n"), rhs = Term.TVar("n")), [Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("n"), rhs = Term.TBool(true)))], intsEnv(["n"]), "p") => Result.Err("step p: one proof per carried hypothesis")

fn namedHyps(names: List<String>, scope: List<Hyp>, path: String) -> Result<List<Hyp>, String>
    ? "The hypotheses of these names, as they stand in scope."
    match names
        [] -> Result.Ok([])
        [n, ..rest] -> Result.Ok(List.prepend(Hyp(name = n, eqn = hyp(n, scope, path)?), namedHyps(rest, scope, path)?))

verify namedHyps
    namedHyps(["h"], [], "p") => Result.Err("step p: hypothesis h is not in scope")

fn carriedHold(cs: List<Hyp>, proofs: List<Proof>, down: List<Binding>, env: Env, path: String) -> Result<Unit, String>
    ? "Each carried hypothesis, at v - 1, proved by its proof."
    match (cs, proofs)
        ([c, ..more], [q, ..qs]) -> carriedThen(caseProves(q, instantiate(c.eqn, down, path)?, env, "{path}/carry.{c.name}"), more, qs, down, env, path)
        _ -> Result.Ok(Unit)

verify carriedHold
    carriedHold([], [], [], emptyEnv(), "p") => Result.Ok(Unit)
    carriedHold([Hyp(name = "h", eqn = Eqn(lhs = Term.TVar("n"), rhs = Term.TBool(true)))], [Proof.PHyp("h")], [Kernel.Term.bind("n", Term.TInt(0))], withHyp(emptyEnv(), "h", Term.TVar("n"), true), "p") => Result.Err("step p/carry.h: the case proves a different equation")

fn carriedThen(done: Result<Unit, String>, cs: List<Hyp>, proofs: List<Proof>, down: List<Binding>, env: Env, path: String) -> Result<Unit, String>
    ? "The rest of the carried hypotheses, once this one held."
    done?
    carriedHold(cs, proofs, down, env, path)

verify carriedThen
    carriedThen(Result.Err("no"), [], [], [], emptyEnv(), "p") => Result.Err("no")

fn checkFacts(fs: List<Fact>, earlier: List<Law>) -> Result<Unit, String>
    ? "Each builtin fact proves its statement over builtins and the facts before it: no definitions, no other laws, no when."
    match fs
        [] -> Result.Ok(Unit)
        [f, ..rest] -> checkFactThen(checkScript(Script(obligation = f.law, defs = [], consts = [], sums = [], recs = [], sigs = [], laws = earlier, facts = [], proof = f.proof)), f.law, rest, earlier)

verify checkFacts
    checkFacts([], []) => Result.Ok(Unit)
    checkFacts([Fact(law = Law(key = "List.k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(2)), proof = Proof.PRefl(Term.TInt(1)))], []) => Result.Err("fact List.k: step proof: the proof ends at a different equation than the claim")
    checkFacts([Fact(law = Law(key = "List.k", givens = [], premise = [], lhs = Term.TInt(1), rhs = Term.TInt(2)), proof = Proof.PLaw("List.j", [], []))], []) => Result.Err("fact List.k: step proof: law List.j is not cited")

fn checkFactThen(done: Result<String, String>, law: Law, rest: List<Fact>, earlier: List<Law>) -> Result<Unit, String>
    ? "The rest of the facts, once this one checked; they may cite it."
    match done
        Result.Ok(k) -> checkFacts(rest, List.concat(earlier, [law]))
        Result.Err(why) -> Result.Err("fact {law.key}: {why}")

verify checkFactThen
    checkFactThen(Result.Err("no"), Law(key = "List.k", givens = [], premise = [], lhs = Term.TUnit, rhs = Term.TUnit), [], []) => Result.Err("fact List.k: no")

fn factLaws(fs: List<Fact>) -> List<Law>
    ? "The statements of checked facts, as laws a step may cite."
    match fs
        [] -> []
        [f, ..rest] -> List.prepend(f.law, factLaws(rest))

verify factLaws
    factLaws([]) => []
