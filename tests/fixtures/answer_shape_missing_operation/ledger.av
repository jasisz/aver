module Ledger
    intent = "An answer module missing one of the capability's operations."
    depends [Pool]
    exposes [State, claim]
    effects []
    answers [Pool]

record State
    free: List<Int>
    stopping: Bool

fn claim(state: State, key: Int) -> Tuple<State, Result<Pool.Assignment, Run.Wake>>
    ? "The next height for this peer."
    (state, Result.Ok(Pool.Assignment.Idle))
